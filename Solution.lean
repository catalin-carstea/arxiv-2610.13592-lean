      ContMDiffAt (𝓘(ℝ, E).prod J) 𝓘(ℝ, E →L[ℝ] ℝ) ∞
        (fun p : E × Y => fderiv ℝ (fun z => F z p.2) p.1) (z, y) :=
    contMDiffAt_joint_fderiv_fst (G := F) (hAt z hz y)
  have hD : ContinuousOn (fun p : E × Y => fderiv ℝ (fun z => F z p.2) p.1)
      (U ×ˢ univ) := fun p hp => (hDAt p.1 hp.1 p.2).continuousAt.continuousWithinAt
