    · exact ((contMDiff_const.sub hθ) z).mul
        (((G.row_smooth x) z hzx).contMDiffAt (isOpen_compl_singleton.mem_nhds hzx))
  refine ⟨θ, hθ, hθW, u, hu, ?_, ?_⟩
  · intro y
    simp only [u, G.boundary_second x y, mul_zero]
  · intro z hz
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hz] with w hw
