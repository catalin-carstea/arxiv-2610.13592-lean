      normalJet k (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) g)
        (EuclideanHalfSpace.boundaryParam n x) := by
  rw [normalJet_directional_comm_eqOn _ hS hf k (hWS hx),
    normalJet_directional_comm_eqOn _ hS hg k (hWS hx)]
  exact boundary_function_directional_eq hW he hx
    (((normalJet_analyticOn hS hf k) _ (hWS hx)).contMDiffAt (hS.mem_nhds (hWS hx)))
    (((normalJet_analyticOn hS hg k) _ (hWS hx)).contMDiffAt (hS.mem_nhds (hWS hx))) v
