ACTUAL native metric field and its actual face jets. No coefficient or
principal-root identity is accepted as a literature premise. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

structure BoundaryLayerCoefficients (ξ : Fin n → ℝ) (U : Set Y) where
  kappa : Y → ℝ
  inverse : ℕ → Fin n → Fin n → Y → ℂ
  normalDrift : ℕ → Y → ℂ
  tangentDrift : ℕ → Fin n → Y → ℂ
  kappa_smooth : ContDiffOn ℝ ∞ kappa U
  kappa_pos : ∀ y ∈ U, 0 < kappa y
  inverse_smooth : ∀ l i j, ContDiffOn ℝ ∞ (inverse l i j) U
  inverse_symm : ∀ l i j y, y ∈ U → inverse l i j y = inverse l j i y
  normalDrift_smooth : ∀ l, ContDiffOn ℝ ∞ (normalDrift l) U
  tangentDrift_smooth : ∀ l i, ContDiffOn ℝ ∞ (tangentDrift l i) U
  principal_squared : ∀ y ∈ U, (kappa y : ℂ) ^ 2 =
    ∑ i, ∑ j, inverse 0 i j y * (ξ i : ℂ) * (ξ j : ℂ)

def nativeBoundaryLayerCoefficients
    {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    {U : Set Y} (hUS : MapsTo (EuclideanHalfSpace.boundaryParam n) U S)
    (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) : BoundaryLayerCoefficients ξ U where
  kappa y := F.principal ξ (EuclideanHalfSpace.boundaryParam n y)
  inverse l i j := faceTaylor (fun z => F.inverse z i j) l
  normalDrift l := faceTaylor F.tau l
  tangentDrift l i := faceTaylor (metricTangentialDrift F i) l
  kappa_smooth := facePrincipal_contDiffOn F hA hUS ξ hξ
  kappa_pos y hy := F.principal_pos ξ hξ _ (hUS hy)
  inverse_smooth l i j := faceTaylor_contDiffOn
    ((normalMatrixEntry i j).contDiff.contMDiff.comp_contMDiffOn hA) hUS l
  inverse_symm l i j y hy := by
    unfold faceTaylor faceJet
    rw [normalJet_matrix_entry S.isOpen F.inverse_smooth l i j (hUS hy),
      normalJet_matrix_entry S.isOpen F.inverse_smooth l j i (hUS hy)]
    exact congrArg (fun r : ℝ => (r : ℂ) / (l.factorial : ℂ))
      ((F.inverse_normalJet_symmetric l (hUS hy)).apply j i)
  normalDrift_smooth l := faceTaylor_contDiffOn (F.tau_analyticOn hG hA) hUS l
  tangentDrift_smooth l i := faceTaylor_contDiffOn (metricTangentialDrift_analyticOn F hG hA i) hUS l
  principal_squared y hy := by
    let z := EuclideanHalfSpace.boundaryParam n y
    have hp : (F.principal ξ z) ^ 2 = normalMatrixQuadratic (F.inverse z) ξ :=
      normalPrincipal_sq _ (F.inverse_posDef z (hUS hy)) ξ hξ
    change (F.principal ξ z : ℂ) ^ 2 = _
    rw [← Complex.ofReal_pow, hp]
    simp only [faceTaylor, faceJet, normalJet_zero, Nat.factorial_zero, Nat.cast_one, div_one,
      normalMatrixQuadratic_eq_dot, dotProduct, Matrix.mulVec, Complex.ofReal_sum, Complex.ofReal_mul]
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    ring

end ConformalPoisson.LocalDN

