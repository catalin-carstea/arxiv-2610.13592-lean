    (U ⊓ positiveNormalHalfSpace ν).isOpen
    ((MeasureTheory.Lp.locallyIntegrableOn (W1p.gradient z) one_le_two).mono_set inter_subset_left) hzg hG
  refine ⟨L, ?_⟩
  intro x hx y hy
  rw [← heq hx.2, ← heq hy.2]
  exact hL x hx.1 y hy.1
end ConformalPoisson

