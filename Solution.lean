      (observedDomain (𝓡∂ (n + 1)) V₁) ∧
    ∀ b : (𝓡∂ (n + 1)).boundary M₁, (b : M₁) ∈ V₁ →
      normalDerivative D.normal₁ (nativeBoundaryMultiplier (n := n) A.multiplier) b = 0 := by
  have hboundary (b : (𝓡∂ (n + 1)).boundary M₁) (hb : (b : M₁) ∈ V₁) :
      IsLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
        (nativeBoundaryExtension D.boundaryIdentification A.map) (b : M₁) ∧
      ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (nativeBoundaryMultiplier (n := n) A.multiplier) (b : M₁) ∧
      normalDerivative D.normal₁ (nativeBoundaryMultiplier (n := n) A.multiplier) b = 0 := by
    obtain ⟨P⟩ := nonempty_boundaryGaugePair hBoundaryReg₁ hBoundaryReg₂ A₁ A₂ V₁ V₂ D b hb
    obtain ⟨C⟩ := P.exists_commonCharts
    obtain ⟨R⟩ := P.nonempty_localGaugedSeed hSymbol hReg₁ hReg₂ hcompact₁ hcompact₂
      hconnected₁ hconnected₂ hn C
    exact R.boundary_extension_regularity hSchauder hRunge₂ hcompact₂ (nativeInterior_connected hconnected₂) A hA
  have hlocal (z : M₁) (hz : z ∈ (𝓡∂ (n + 1)).interior M₁) :
      IsLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
        (nativeBoundaryExtension D.boundaryIdentification A.map) z := by
    apply isLocalDiffeomorphAt_of_eqOn (Φ := F) (by rw [hFs]; exact hz)
    intro a ha
    rw [nativeBoundaryExtension_of_interior D.boundaryIdentification A.map (hFs ▸ ha)]
    exact congrFun hFmap.symm a
  have hcases (z : M₁) (hz : z ∈ observedDomain (𝓡∂ (n + 1)) V₁)
      (hi : z ∉ (𝓡∂ (n + 1)).interior M₁) : z ∈ (𝓡∂ (n + 1)).boundary M₁ ∧ z ∈ V₁ := by
    refine ⟨?_, ?_⟩
    · rw [← (𝓡∂ (n + 1)).compl_interior]
      exact hi
    · exact hz.elim (fun h => False.elim (hi h)) (fun h => h)
  refine ⟨?_, ?_, fun b hb => (hboundary b hb).2.2⟩
  · intro z hz
    by_cases hi : z ∈ (𝓡∂ (n + 1)).interior M₁
    · exact hlocal z hi
    · obtain ⟨hb, hV⟩ := hcases z hz hi
      exact (hboundary ⟨z, hb⟩ hV).1
  · intro z hz
    by_cases hi : z ∈ (𝓡∂ (n + 1)).interior M₁
    · have hca := (hc z hi).contMDiffAt (((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).mem_nhds hi)
      exact (hca.congr_of_eventuallyEq (nativeBoundaryMultiplier_eventuallyEq_interior A.multiplier hi)).contMDiffWithinAt
    · obtain ⟨hb, hV⟩ := hcases z hz hi
      exact (hboundary ⟨z, hb⟩ hV).2.1.contMDiffWithinAt
end ConformalPoisson

end ProofPart_NativeObservedRegularity

/- Proof support: NativeSeedNormalization.lean, SHA256 e965057422bd040f893a0c3bc81e06ab45e8867fd147b60c3af004c9925b1590 -/
noncomputable section ProofPart_NativeSeedNormalization



/- Normalize the SAME recovered constant using an ACTUAL interior
seed point, full metric agreement, and one nonzero actual tangent vector. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

variable [T2Space M₁] [T2Space M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem LocalGaugedSeed.recovered_constant_eq_one
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (R : LocalGaugedSeed P hn C) {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun z : A.domain => A.map z))
    (hinv : ∀ z : A.domain, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : A.domain => A.map z) z).IsInvertible)
    (G : NativeGaugeRecovery (A₁.smoothMetric.restrictOpenTangentSpace A.domain)
      (nativePullbackMetric A₂.smoothMetric (fun z : A.domain => A.map z) hJ hinv)
      (fun z : A.domain => A₁.potential z) (fun z : A.domain => A₂.potential (A.map z))
      (fun z : A.domain => A.multiplier z)) : G.constant = 1 := by
  have hagree := R.agrees_global_candidate hSchauder hRunge₂ hcompact₂ hconnected₂ A hA
  obtain ⟨z, hz⟩ := R.interiorDomain_nonempty
  have hzA : z ∈ A.domain := by
    change z ∈ (A.domain : Set M₁)
    rw [hA]
    exact hz.2
  let J := normalChartTransition C.chart₁ C.chart₂
  have hevent : A.map =ᶠ[𝓝 z] J := eventuallyEq_of_mem (R.interiorDomain.isOpen.mem_nhds hz)
    (fun w hw => (hagree w hw).1)
  have hpoint : A.map z = J z := hevent.eq_of_nhds
  have hD : mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) A.map z =
      mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J z := hevent.mfderiv_eq
  have hJat := (J.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) (R.source_subset hz.1)).congr_of_eventuallyEq hevent
  let i : Fin (n + 1) := ⟨0, Nat.zero_lt_succ n⟩
  let v : EuclideanSpace ℝ (Fin (n + 1)) := EuclideanSpace.single i 1
  have hv : v ≠ 0 := by
    intro h
    have hi := congrArg (fun w : EuclideanSpace ℝ (Fin (n + 1)) => w i) h
    simpa [v] using hi
  have hκ := G.ambient_metric A₁.smoothMetric A₂.smoothMetric A.domain A.map A.multiplier hJ hinv hzA hJat v v
  rw [hD, hpoint, (hagree z hz).2] at hκ
  have hseed := R.original_metric z hz.1 v v
  have heq := hκ.symm.trans hseed
  let a := R.multiplier z ^ conformalGaugeExponent n * A₁.smoothMetric.inner z v v
  have ha : 0 < a := mul_pos (Real.rpow_pos_of_pos (R.multiplier_positive z) _) (A₁.smoothMetric.pos z v hv)
  have hscalar : G.constant * a = a := by simpa only [a, mul_assoc] using heq
  nlinarith
end ConformalPoisson

end ProofPart_NativeSeedNormalization

/- Proof support: NativeNormalizedRecovery.lean, SHA256 9d2b53a4247639aa785b67a318b532ef444589a2c91c7571a54c548b39d010e1 -/
noncomputable section ProofPart_NativeNormalizedRecovery



/- Actual coefficient recovery AND seed normalization for the SAME
global candidate. The returned potential identity shares its exact
multiplier and recovered metric, with constant PROVED equal to ONE. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

variable [T2Space M₁] [T2Space M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem LocalGaugedSeed.normalized_global_recovery
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hcompact₁ : IsCompact (univ : Set M₁))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (R : LocalGaugedSeed P hn C) {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁) :
    ∃ hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun z : A.domain => A.map z),
    ∃ hinv : ∀ z : A.domain, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : A.domain => A.map z) z).IsInvertible,
    ∃ G : NativeGaugeRecovery (A₁.smoothMetric.restrictOpenTangentSpace A.domain)
      (nativePullbackMetric A₂.smoothMetric (fun z : A.domain => A.map z) hJ hinv)
      (fun z : A.domain => A₁.potential z) (fun z : A.domain => A₂.potential (A.map z))
      (fun z : A.domain => A.multiplier z), G.constant = 1 := by
  letI : PreconnectedSpace A.domain := isPreconnected_iff_preconnectedSpace.mp A.connected.isPreconnected
  obtain ⟨z, hz⟩ := A.connected.nonempty
  obtain ⟨hJ, hinv, G⟩ := native_coefficient_recovery_of_scaled_solution_relation
    hSchauder hRunge₁ hRunge₂ hReg₁ hReg₂ hn hcompact₁ hcompact₂ hconnected₁ hconnected₂
    A₁ A₂ V₁ V₂ D A.domain ⟨z, hz⟩ A.inside A.map A.multiplier A.continuous A.image A.positive A.solutions
  obtain ⟨G⟩ := G
  exact ⟨hJ, hinv, G, R.recovered_constant_eq_one hSchauder hRunge₂ hcompact₂ hconnected₂ A hA hJ hinv G⟩
end ConformalPoisson

end ProofPart_NativeNormalizedRecovery

/- Proof support: NativeObservedMetric.lean, SHA256 804ff46c262e9f0571ef109ae4495dba30bc129f8e714e40fc8f46ca4f6a410d -/
noncomputable section ProofPart_NativeObservedMetric



/- The normalized actual interior metric and freshly produced seeds
supply the SAME ambient metric identity on ALL of the observed domain. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}


variable [SecondCountableTopology M₁] [SecondCountableTopology M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem native_observed_metric_of_normalized_recovery
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hBoundaryReg₁ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₁))
    (hBoundaryReg₂ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₂))
    (hSymbol : LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun z : A.domain => A.map z))
    (hinv : ∀ z : A.domain, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : A.domain => A.map z) z).IsInvertible)
    (G : NativeGaugeRecovery (A₁.smoothMetric.restrictOpenTangentSpace A.domain)
      (nativePullbackMetric A₂.smoothMetric (fun z : A.domain => A.map z) hJ hinv)
      (fun z : A.domain => A₁.potential z) (fun z : A.domain => A₂.potential (A.map z))
      (fun z : A.domain => A.multiplier z))
    (hG : G.constant = 1)
    (E : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hEs : E.source = (observedDomain (𝓡∂ (n + 1)) V₁ : Set M₁))
    (hEmap : (E : M₁ → M₂) = nativeBoundaryExtension D.boundaryIdentification A.map) :
    ∀ z ∈ observedDomain (𝓡∂ (n + 1)) V₁, ∀ v w : TangentSpace (𝓡∂ (n + 1)) z,
      A₂.smoothMetric.inner (E z) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E z v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E z w) =
      nativeBoundaryMultiplier (n := n) A.multiplier z ^ conformalGaugeExponent n * A₁.smoothMetric.inner z v w := by
  intro z hz v w
  by_cases hi : z ∈ (𝓡∂ (n + 1)).interior M₁
  · have hzA : z ∈ A.domain := by change z ∈ (A.domain : Set M₁); rw [hA]; exact hi
    have hzE : z ∈ E.source := hEs.symm ▸ hz
    have hevent : (E : M₁ → M₂) =ᶠ[𝓝 z] A.map := by
      rw [hEmap]
      exact nativeBoundaryExtension_eventuallyEq_interior D.boundaryIdentification A.map hi
    have hpoint : E z = A.map z := hevent.eq_of_nhds
    have hD : mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E z =
        mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) A.map z := hevent.mfderiv_eq
    have hAat := (E.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) hzE).congr_of_eventuallyEq hevent.symm
    have hmetric := G.ambient_metric A₁.smoothMetric A₂.smoothMetric A.domain A.map A.multiplier hJ hinv hzA hAat v w
    rw [hG, one_mul] at hmetric
    rw [hD, hpoint, nativeBoundaryMultiplier_of_interior A.multiplier hi]
    exact hmetric
  · have hb : z ∈ (𝓡∂ (n + 1)).boundary M₁ := by rw [← (𝓡∂ (n + 1)).compl_interior]; exact hi
    have hzV : z ∈ V₁ := hz.elim (fun h => False.elim (hi h)) (fun h => h)
    let b : (𝓡∂ (n + 1)).boundary M₁ := ⟨z, hb⟩
    obtain ⟨P⟩ := nonempty_boundaryGaugePair hBoundaryReg₁ hBoundaryReg₂ A₁ A₂ V₁ V₂ D b hzV
    obtain ⟨C⟩ := P.exists_commonCharts
    obtain ⟨R⟩ := P.nonempty_localGaugedSeed hSymbol hReg₁ hReg₂ hcompact₁ hcompact₂
      hconnected₁ hconnected₂ hn C
    have hagree := R.agrees_boundary_extension hSchauder hRunge₂ hcompact₂ (nativeInterior_connected hconnected₂) A hA
    let J := normalChartTransition C.chart₁ C.chart₂
    have hevent : (E : M₁ → M₂) =ᶠ[𝓝 z] J :=
      eventuallyEq_of_mem (R.domain.isOpen.mem_nhds R.point_mem)
        (fun y hy => (congrFun hEmap y).trans (hagree y hy).1)
    have hpoint : E z = J z := hevent.eq_of_nhds
    have hD : mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E z =
        mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J z := hevent.mfderiv_eq
    have hcseed : nativeBoundaryMultiplier (n := n) A.multiplier z = R.multiplier z :=
      (hagree b R.point_mem).2
    rw [hD, hpoint, hcseed]
    exact R.original_metric z R.point_mem v w
end ConformalPoisson

end ProofPart_NativeObservedMetric

/- Proof support: GaugeUniqueness.lean, SHA256 8c8945a6ce938d54c9b2964353bd2fb292627ddd249b9b7c38462fcb4f08ac82 -/
noncomputable section ProofPart_GaugeUniqueness





/- Uniqueness of the full geometric pair from the concrete partial-boundary solution family. -/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁]
  [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
/-- No separate separation hypothesis is needed to identify two candidate theorem pairs. -/
theorem GaugePair.eq_of_realizesTheorem
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M₂))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁))
    (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {P Q : GaugePair (n := n) V₁ V₂}
    (hP : P.RealizesTheorem V₁ V₂ D.boundaryIdentification
      A₁.smoothMetric A₂.smoothMetric A₁.potential A₂.potential D.solver₁ D.solver₂ D.normal₁)
    (hQ : Q.RealizesTheorem V₁ V₂ D.boundaryIdentification
      A₁.smoothMetric A₂.smoothMetric A₁.potential A₂.potential D.solver₁ D.solver₂ D.normal₁) :
    P = Q := by
  have hpatch : ∀ x, x ∈ observedPatch (n := n) V₁ ↔
      D.boundaryIdentification x ∈ observedPatch (n := n) V₂ := D.patches_match
  have hV₂ : (observedPatch (n := n) V₂).Nonempty := by
    obtain ⟨x, hx⟩ := D.patch_nonempty
    exact ⟨D.boundaryIdentification x, (hpatch x).mp hx⟩
  have hsep := separatesPointAndScale_observedDomain hSchauder (hRunge A₂) hdim hcompact
    hconnected (A₂.analytic_potential.of_le (by decide))
    A₂.nonresonant D.solver₂ V₂ hV₂
  let T := transportBoundaryDatumLinearEquiv D.boundaryIdentification hpatch
  have hsep' := hsep.precomp_surjective T T.surjective
  exact GaugePair.eq_of_solution_relations D.normal₁ hsep' hP hQ

without_proof_info in
/-- Once existence is constructed, the actual full target follows with the proved uniqueness. -/
theorem theoremOneOneResult_of_exists
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M₂))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁))
    (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (hex : ∃ P : GaugePair (n := n) V₁ V₂,
      P.RealizesTheorem V₁ V₂ D.boundaryIdentification A₁.smoothMetric A₂.smoothMetric
        A₁.potential A₂.potential D.solver₁ D.solver₂ D.normal₁) :
    TheoremOneOneResult A₁ A₂ V₁ V₂ D := by
  obtain ⟨P, hP⟩ := hex
  exact ⟨P, hP, fun Q hQ => GaugePair.eq_of_realizesTheorem
