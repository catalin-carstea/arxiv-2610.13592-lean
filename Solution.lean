set_option maxHeartbeats 600000 in
without_proof_info in
theorem lp_one_mem_negative_sobolev (u : Lp ℂ 1 (volume : Measure E))
    {t : ℝ} (ht : (Module.finrank ℝ E : ℝ) < 2 * t) :
    MemSobolev (-t) 2 (u : 𝓢'(E, ℂ)) := by
  let w : E → ℝ := fun x => (1 + ‖x‖ ^ 2) ^ (-t / 2)
  let F : E → ℂ := Real.Lp.fourierTransform u
  have hw : MemLp w 2 (volume : Measure E) := TauCeti.memLp_rpow_neg_one_add_norm_sq volume ht
  have hF : MemLp F ⊤ (volume : Measure E) := (Real.Lp.fourierTransform u).memLp_top
  have hmem : MemLp (w • F) 2 (volume : Measure E) := hw.smul hF
  let v : Lp ℂ 2 (volume : Measure E) := hmem.toLp (w • F)
  have hgrow : w.HasTemperateGrowth := Function.hasTemperateGrowth_one_add_norm_sq_rpow E (-t / 2)
  apply memSobolev_iff_exists_smulLeftCLM_fourier.mpr
  refine ⟨v, ?_⟩
  ext φ
  rw [TemperedDistribution.smulLeftCLM_apply_apply,
    Lp.fourier_toTemperedDistribution_apply u (L1.integrable_coeFn u) Filter.EventuallyEq.rfl,
    Lp.toTemperedDistribution_apply]
  change (∫ x, (SchwartzMap.smulLeftCLM ℂ (fun x => (w x : ℂ)) φ) x • F x) =
    ∫ x, φ x • v x
  have hcg : (fun x => (w x : ℂ)).HasTemperateGrowth :=
    Complex.hasTemperateGrowth_ofReal.comp hgrow
  apply integral_congr_ae
  filter_upwards [hmem.coeFn_toLp] with x hx
  rw [SchwartzMap.smulLeftCLM_apply_apply hcg, hx]
  change ((w x : ℂ) * φ x) * F x = φ x * ((w x : ℂ) * F x)
  ring

end ConformalPoisson

