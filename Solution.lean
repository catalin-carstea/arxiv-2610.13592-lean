noncomputable section ProofPart_GreenTrace_DenseValueLift



/- Extend linear readings from a dense family using a value-norm estimate.
The source needs only an algebraic module: its norm is supplied by the dense
value map. Intended caller: L2 closures of smooth native local solutions. -/
namespace ConformalPoisson
variable {E H Y Z : Type*}
  [AddCommGroup E] [Module ℝ E]
  [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_bounded_lift_of_dense_values [AddCommGroup Z] [Module ℝ Z]
    (e : E →ₗ[ℝ] H) (A : E →ₗ[ℝ] Z) (B : Y →ₗ[ℝ] Z)
    (hdense : DenseRange e) (hB : Function.Injective B)
    (C : ℝ) (hC : 0 ≤ C)
    (hex : ∀ x, ∃ y, B y = A x ∧ ‖y‖ ≤ C * ‖e x‖) :
    ∃ T : H →L[ℝ] Y, ‖T‖ ≤ C ∧ ∀ x, B (T (e x)) = A x := by
  classical
  let s : E → Y := fun x => Classical.choose (hex x)
  have hs : ∀ x, B (s x) = A x := fun x => (Classical.choose_spec (hex x)).1
  have hsNorm : ∀ x, ‖s x‖ ≤ C * ‖e x‖ := fun x => (Classical.choose_spec (hex x)).2
  let L : E →ₗ[ℝ] Y :=
    { toFun := s
      map_add' x y := hB (by rw [map_add, hs, hs, hs, map_add])
      map_smul' a x := hB (by simpa only [RingHom.id_apply] using
        (show B (s (a • x)) = B (a • s x) by rw [map_smul, hs, hs, map_smul])) }
  refine ⟨L.extendOfNorm e, LinearMap.opNorm_extendOfNorm_le hdense hC hsNorm, fun x => ?_⟩
  rw [LinearMap.extendOfNorm_eq hdense ⟨C, hsNorm⟩]
  exact hs x

section ContinuousReadback
variable [NormedAddCommGroup Z] [NormedSpace ℝ Z]

without_proof_info in
theorem exists_bounded_lift_of_dense_continuous_values
    (e : E →ₗ[ℝ] H) (A : H →L[ℝ] Z) (B : Y →L[ℝ] Z)
    (hdense : DenseRange e) (hB : Function.Injective B)
    (C : ℝ) (hC : 0 ≤ C)
    (hex : ∀ x, ∃ y, B y = A (e x) ∧ ‖y‖ ≤ C * ‖e x‖) :
    ∃ T : H →L[ℝ] Y, ‖T‖ ≤ C ∧ ∀ x, B (T x) = A x := by
  obtain ⟨T, hT, hread⟩ := exists_bounded_lift_of_dense_values e
    (A.toLinearMap.comp e) B.toLinearMap hdense hB C hC hex
  refine ⟨T, hT, fun x => ?_⟩
  exact hdense.induction (by rintro _ ⟨x, rfl⟩; exact hread x)
    (isClosed_eq (B.continuous.comp T.continuous) A.continuous) x

end ContinuousReadback

end ConformalPoisson

end ProofPart_GreenTrace_DenseValueLift

