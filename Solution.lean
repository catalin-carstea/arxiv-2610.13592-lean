    ContinuousOn (splitChartPrincipal g c) (splitBoundaryChartCap (n := n) c r) := by
  have hA : ContinuousOn (fun z : P => nativeChartPrincipal g c (euclideanNormalSplit n z))
      (splitBoundaryChartCap (n := n) c r) :=
    (continuousOn_nativeChartPrincipal_target g c).comp
      (euclideanNormalSplit n).continuous.continuousOn fun z hz =>
        hrt ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩
  exact continuousOn_const.clm_comp (hA.clm_comp continuousOn_const)

without_proof_info in
theorem exists_bound_splitChartPrincipal_cap (g : Metric (n := n) (M := M)) (c : M) {r : ℝ}
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) :
    ∃ Λ : ℝ, ∀ z ∈ (splitBoundaryChartCap (n := n) c r : Set P),
      ‖splitChartPrincipal g c z‖ ≤ Λ := by
  obtain ⟨Λ, hΛ⟩ := ((isCompact_closedBall _ _).inter_right (𝓡∂ (n + 1)).isClosed_range).exists_bound_of_continuousOn
