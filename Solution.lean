noncomputable section ProofPart_NativeScaledDiffeomorph




/-
The all-solution relation also gives global injectivity on its domain, by source
point-and-scale separation. Together with the derived local regularity this
packages the actual map as an analytic partial diffeomorphism onto its image.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂] [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁]
  [IsManifold (𝓡∂ (n + 1)) ω M₂]

omit [T2Space M₂] in
without_proof_info in
theorem native_scaled_solution_relation_injOn
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M₁))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (U : Set M₁) (hU : U ⊆ (𝓡∂ (n + 1)).interior M₁)
    (J : M₁ → M₂) (c : M₁ → ℝ) (hc : ∀ x ∈ U, c x ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x)) : InjOn J U := by
  let Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₁) :=
    ⟨observedPatch (n := n) V₁, V₁.isOpen.preimage continuous_subtype_val⟩
  have hsep := separatesPointAndScale_interior hSchauder (hRunge A₁) hdim hcompact
    hconnected (A₁.analytic_potential.of_le (by decide)) A₁.nonresonant
    D.solver₁ Γ D.patch_nonempty
  intro x hx y hy hxy
  have h := hsep ⟨x, hU hx⟩ ⟨y, hU hy⟩ (c y) (c x) (hc y hy) (hc x hx) (by
    intro f
    change c y * D.solver₁.solve f.val x = c x * D.solver₁.solve f.val y
    rw [hrel f x hx, hrel f y hy, hxy]
    ring)
  exact congrArg Subtype.val h.1

without_proof_info in
theorem exists_native_scaled_partialDiffeomorph
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hdim : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ (𝓡∂ (n + 1)).interior M₁)
    (J : M₁ → M₂) (c : M₁ → ℝ) (hJcont : ContinuousOn J U)
    (hJinterior : ∀ x ∈ U, J x ∈ (𝓡∂ (n + 1)).interior M₂)
    (hc : ∀ x ∈ U, c x ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x)) :
    ∃ F : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω,
      F.source = (U : Set M₁) ∧ F.target = J '' (U : Set M₁) ∧
      (F : M₁ → M₂) = J ∧ ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω c U := by
  obtain ⟨_, hcω, hlocal⟩ := native_scaled_solution_relation_regularity hSchauder
    hRunge₁ hRunge₂ hReg₁ hReg₂ hdim hcompact₁ hcompact₂ hconnected₁ hconnected₂
    A₁ A₂ V₁ V₂ D U hU J c hJcont hJinterior hc hrel
  have hinj := native_scaled_solution_relation_injOn hSchauder hRunge₁ hdim hcompact₁
    hconnected₁ A₁ A₂ V₁ V₂ D U hU J c hc hrel
  obtain ⟨z, _⟩ := D.patch_nonempty
  let : Nonempty M₁ := ⟨z.val⟩
  have hlocal' : IsLocalDiffeomorphOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J U :=
    fun x => hlocal x x.property
  exact ⟨hlocal'.partialDiffeomorphOfInjOn U.isOpen hinj,
    hlocal'.partialDiffeomorphOfInjOn_source U.isOpen hinj,
    hlocal'.partialDiffeomorphOfInjOn_target U.isOpen hinj,
    hlocal'.coe_partialDiffeomorphOfInjOn U.isOpen hinj, hcω⟩

end ConformalPoisson

end ProofPart_NativeScaledDiffeomorph

/- Proof support: NativeClosureContinuation.lean, SHA256 e241ee370c5d8c19a56dfb5bbbfb1b531e06af1bd551aae0521e5603f93cfe23 -/
noncomputable section ProofPart_NativeClosureContinuation





/- Discharge the local-closure extension obligation from compactness,
actual partial-map packaging, MAIN analytic no-escape, and the explicit
local quotient continuation. No local-extension premise is retained. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
