    (b (0 + (boundaryReflection n).toContinuousLinearEquiv x)) = _
  simp only [zero_add, LinearIsometryEquiv.coe_toContinuousLinearEquiv]
  exact boundaryReflection_symm_apply _

without_proof_info in
theorem boundaryReflection_projected_normal (v : V) (c : ℝ) :
    boundaryReflection n (boundaryTangentialProjection v + c • e) =
