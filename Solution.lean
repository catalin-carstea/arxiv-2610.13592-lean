/- Assignment268, /root. Only the uniform normal drift bound needed for the
normal cutoff commutator, for BOTH original coefficient fields. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN.NativeLayerCollar
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem normalDrift_bound {S : TopologicalSpace.Opens H} {F₁ F₂ : NormalMetricField S} {y : Y}
    (R : NativeLayerCollar F₁ F₂ y) :
    ∃ T : ℝ, 0 ≤ T ∧ ∀ z : H,
      (nativeNormalCoordinates z).1 ∈ R.cutoff.supportCap →
      (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) R.cutoff.normalCutoff.rOut →
      |F₁.tau z| ≤ T ∧ |F₂.tau z| ≤ T := by
  have hc := R.cutoff.isCompact_supportCap.prod (isCompact_Icc (a := (0 : ℝ)) (b := R.cutoff.normalCutoff.rOut))
  have h₁ : ContinuousOn R.extension₁ (R.cutoff.supportCap ×ˢ Icc (0 : ℝ) R.cutoff.normalCutoff.rOut) := by
    intro x hx
    exact (R.analytic₁ x (R.positive_cylinder_subset hx)).continuousAt.continuousWithinAt
  have h₂ : ContinuousOn R.extension₂ (R.cutoff.supportCap ×ˢ Icc (0 : ℝ) R.cutoff.normalCutoff.rOut) := by
    intro x hx
    exact (R.analytic₂ x (R.positive_cylinder_subset hx)).continuousAt.continuousWithinAt
  obtain ⟨T₁, hT₁⟩ := hc.exists_bound_of_continuousOn h₁
