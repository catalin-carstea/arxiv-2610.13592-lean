    (hT : ∀ x : closedBall (0 : V) 1, T x = (x : V) 0)
    (f : V → ℝ) (χ : V → ℝ) (hχ : ContDiff ℝ 1 χ)
    (hχfold : ∀ x : V, χ (boundaryFold x) = χ x)
    {W : Set V} (hW : IsOpen W) (hKW : closedBall (0 : V) 1 ⊆ W)
    (hf : AnalyticOnNhd ℝ f W) :
    ∃ (U : Set V) (G : V → TauCeti.HolderSpace α (closedBall (0 : V) 1) ℝ),
