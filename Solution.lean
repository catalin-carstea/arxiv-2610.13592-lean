noncomputable section ProofPart_BoundaryAnalytic_AnalyticCoordinateOperatorAlgebra



/- Analyticity of the actual finite scalar coordinate operator and its
product cross vector. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem analyticAt_clm_application
    {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G]
    [CompleteSpace F] [CompleteSpace G]
    {a : E → F →L[ℝ] G} {v : E → F} {x : E}
    (ha : AnalyticAt ℝ a x) (hv : AnalyticAt ℝ v x) :
    AnalyticAt ℝ (fun y => a y (v y)) x :=
  (ha.contDiffAt.clm_apply hv.contDiffAt).analyticAt

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem principalCrossVector_analyticAt
    {A : V → V →L[ℝ] V} {ξ : V → V →L[ℝ] ℝ} {x : V}
    (hA : AnalyticAt ℝ A x) (hξ : AnalyticAt ℝ ξ x) :
    AnalyticAt ℝ (fun y => principalCrossVector (A y) (ξ y)) x := by
  unfold principalCrossVector
  apply Finset.analyticAt_fun_sum
  intro i _
  exact ((analyticAt_clm_application hξ analyticAt_const).smul
    (analyticAt_clm_application hA analyticAt_const)).add
    ((analyticAt_clm_application hξ (analyticAt_clm_application hA analyticAt_const)).smul analyticAt_const)

without_proof_info in
theorem coordinateSchrodinger_analyticAt
    {A : V → V →L[ℝ] V} {b : V → V} {q f : V → ℝ} {x : V}
    (hA : AnalyticAt ℝ A x) (hb : AnalyticAt ℝ b x)
    (hq : AnalyticAt ℝ q x) (hf : AnalyticAt ℝ f x) :
    AnalyticAt ℝ (coordinateSchrodinger A b q f) x := by
  have hsum : AnalyticAt ℝ (fun y => ∑ i : Fin d,
      fderiv ℝ (fderiv ℝ f) y (EuclideanSpace.single i 1) (A y (EuclideanSpace.single i 1))) x := by
    apply Finset.analyticAt_fun_sum
    intro i _
    exact analyticAt_clm_application (analyticAt_clm_application hf.fderiv.fderiv analyticAt_const)
      (analyticAt_clm_application hA analyticAt_const)
  unfold coordinateSchrodinger
  simpa only [Pi.add_def, Pi.neg_def, Pi.mul_def] using
    (hsum.neg.add (analyticAt_clm_application hf.fderiv hb)).add (hq.mul hf)

end ConformalPoisson

