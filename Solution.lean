set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_wkp0_localization_of_compact_support
    (hK : IsCompact K) (hKU : K ⊆ U) (k : ℕ) (u : Wkp μ ⊤ 2 k)
    (hu : ∀ᵐ x ∂μ.restrict (⊤ : Opens E), x ∉ K → Wkp.value k u x = 0) :
