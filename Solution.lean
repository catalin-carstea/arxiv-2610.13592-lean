Adapted by /root from TauCeti.Geometry.Manifold.Riemannian.ChartCutoff,
revision 4d91513e4d30746eb1fa96658c18e051c772e55e.
The integrals here are restricted to the open interior cap, permitting
boundary charts without assuming the model is Boundaryless.
-/




open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
variable [MeasurableSpace E] [BorelSpace E]

without_proof_info in
/-- The actual gradient energy of a boundary-chart cutoff is bounded by
the native gradient and value energies. The density lower bound and
coordinate derivative bound are uniform in the original function. -/
theorem boundary_chart_cutoff_lintegral_gradient_rpow_le (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r C m G : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    (hm : 0 < m)
    (hρ : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      m ≤ chartVolumeDensity (I := I) c ((extChartAt I c).symm z))
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) 1 u)
    (hcmp : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      ‖fderiv ℝ (u ∘ (extChartAt I c).symm) z‖ ≤
        C * ‖mgradient I u ((extChartAt I c).symm z)‖)
    (hG : ∀ z, ‖fderiv ℝ b z‖ ≤ G) {p : ℝ} (hp : 1 ≤ p) :
    ∫⁻ z in (boundaryChartCap (I := I) c r : Set E),
        ‖∇ (fun z => b z * u ((extChartAt I c).symm z)) z‖ₑ ^ p
          ∂(Module.finBasis ℝ E).addHaar ≤
      2 ^ (p - 1) * ENNReal.ofReal m⁻¹ *
        (ENNReal.ofReal C ^ p * ∫⁻ x, ‖mgradient I u x‖ₑ ^ p ∂riemannianVolume I M +
          ENNReal.ofReal G ^ p * ∫⁻ x, ‖u x‖ₑ ^ p ∂riemannianVolume I M) := by
  let Ω := boundaryChartCap (I := I) c r
  let μ := (Module.finBasis ℝ E).addHaar
  have hΩt : (Ω : Set E) ⊆ (extChartAt I c).target :=
    (boundaryChartCap_subset_interior_target c hrt).trans interior_subset
  have hp0 : 0 ≤ p := zero_le_one.trans hp
  have hfin (a : ℝ) : ENNReal.ofReal a ^ p ≠ (⊤ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_nonneg hp0 ENNReal.ofReal_ne_top
  have hpt : ∀ z ∈ (Ω : Set E),
      ‖∇ (fun z => b z * u ((extChartAt I c).symm z)) z‖ₑ ^ p ≤
        2 ^ (p - 1) * (ENNReal.ofReal C ^ p * ‖mgradient I u ((extChartAt I c).symm z)‖ₑ ^ p +
          ENNReal.ofReal G ^ p * ‖u ((extChartAt I c).symm z)‖ₑ ^ p) := by
    intro z hz
    have hbd := (norm_fderiv_boundary_chart_cutoff_le c b hu hG
      (boundaryChartCap_subset_interior_target c hrt hz)).trans
        (add_le_add (hcmp z hz) le_rfl)
    rw [← ENNReal.mul_rpow_of_nonneg _ _ hp0, ← ENNReal.mul_rpow_of_nonneg _ _ hp0]
    refine (ENNReal.rpow_le_rpow ?_ hp0).trans
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hp)
    have hG0 : 0 ≤ G := (norm_nonneg _).trans (hG 0)
    rw [← ofReal_norm, norm_gradient_eq_norm_fderiv, ← ofReal_norm, ← ofReal_norm,
      ← ENNReal.ofReal_mul' (norm_nonneg _), ← ENNReal.ofReal_mul hG0,
      Real.norm_eq_abs (u _)]
    exact (ENNReal.ofReal_le_ofReal hbd).trans ENNReal.ofReal_add_le
  have hmeas : AEMeasurable (fun z => ENNReal.ofReal G ^ p *
      ‖u ((extChartAt I c).symm z)‖ₑ ^ p) (μ.restrict (Ω : Set E)) :=
    (((hu.continuous.comp_continuousOn ((continuousOn_extChartAt_symm c).mono hΩt)).aemeasurable
      Ω.isOpen.measurableSet).eNorm.pow_const p).const_mul _
  calc
    _ ≤ ∫⁻ z in (Ω : Set E), 2 ^ (p - 1) *
        (ENNReal.ofReal C ^ p * ‖mgradient I u ((extChartAt I c).symm z)‖ₑ ^ p +
          ENNReal.ofReal G ^ p * ‖u ((extChartAt I c).symm z)‖ₑ ^ p) ∂μ :=
      setLIntegral_mono' Ω.isOpen.measurableSet hpt
    _ = 2 ^ (p - 1) *
        (ENNReal.ofReal C ^ p * ∫⁻ z in (Ω : Set E), ‖mgradient I u ((extChartAt I c).symm z)‖ₑ ^ p ∂μ +
          ENNReal.ofReal G ^ p * ∫⁻ z in (Ω : Set E), ‖u ((extChartAt I c).symm z)‖ₑ ^ p ∂μ) := by
      rw [lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)),
        lintegral_add_right' _ hmeas, lintegral_const_mul' _ _ (hfin _),
        lintegral_const_mul' _ _ (hfin _)]
    _ ≤ 2 ^ (p - 1) *
        (ENNReal.ofReal C ^ p * (ENNReal.ofReal m⁻¹ *
          ∫⁻ x, ‖mgradient I u x‖ₑ ^ p ∂riemannianVolume I M) +
          ENNReal.ofReal G ^ p * (ENNReal.ofReal m⁻¹ *
            ∫⁻ x, ‖u x‖ₑ ^ p ∂riemannianVolume I M)) := by
      gcongr
      · exact setLIntegral_native_chart_symm_le c Ω.isOpen hΩt hm hρ
          (fun x => ‖mgradient I u x‖ₑ ^ p)
      · exact setLIntegral_native_chart_symm_le c Ω.isOpen hΩt hm hρ
          (fun x => ‖u x‖ₑ ^ p)
    _ = _ := by ring

without_proof_info in
/-- Norm form of the preceding energy comparison on the interior cap. -/
theorem boundary_chart_cutoff_eLpNorm_gradient_le (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r C m G : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    (hC : 0 ≤ C) (hm : 0 < m)
    (hρ : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      m ≤ chartVolumeDensity (I := I) c ((extChartAt I c).symm z))
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) 1 u)
    (hcmp : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      ‖fderiv ℝ (u ∘ (extChartAt I c).symm) z‖ ≤
        C * ‖mgradient I u ((extChartAt I c).symm z)‖)
    (hG : ∀ z, ‖fderiv ℝ b z‖ ≤ G) {p : ℝ≥0} (hp : 1 ≤ p) :
    eLpNorm (∇ (fun z => b z * u ((extChartAt I c).symm z))) p
        ((Module.finBasis ℝ E).addHaar.restrict (boundaryChartCap (I := I) c r : Set E)) ≤
      2 * ENNReal.ofReal (C + G) * ENNReal.ofReal m⁻¹ ^ (p : ℝ)⁻¹ *
        (eLpNorm (fun x => ‖mgradient I u x‖) p (riemannianVolume I M) +
          eLpNorm u p (riemannianVolume I M)) := by
  let X := eLpNorm (fun x => ‖mgradient I u x‖) p (riemannianVolume I M) +
    eLpNorm u p (riemannianVolume I M)
  have hp0 : p ≠ 0 := (zero_lt_one.trans_le hp).ne'
  have hpR : 0 < (p : ℝ) := NNReal.coe_pos.2 (zero_lt_one.trans_le hp)
  have hG0 : 0 ≤ G := (norm_nonneg _).trans (hG 0)
  have hgrad := lintegral_rpow_enorm_le_rpow_eLpNorm (μ := riemannianVolume I M) hp0
    (fun x => ‖mgradient I u x‖)
  simp only [eNorm_norm] at hgrad
  rw [← ENNReal.rpow_le_rpow_iff hpR,
    eLpNorm_nnreal_pow_eq_lintegral hp0 (measurable_gradient _).aestronglyMeasurable]
  calc
    _ ≤ 2 ^ ((p : ℝ) - 1) * ENNReal.ofReal m⁻¹ *
        (ENNReal.ofReal C ^ (p : ℝ) * ∫⁻ x, ‖mgradient I u x‖ₑ ^ (p : ℝ) ∂riemannianVolume I M +
          ENNReal.ofReal G ^ (p : ℝ) * ∫⁻ x, ‖u x‖ₑ ^ (p : ℝ) ∂riemannianVolume I M) :=
      boundary_chart_cutoff_lintegral_gradient_rpow_le c b hrt hm hρ hu hcmp hG (by exact_mod_cast hp)
    _ ≤ 2 ^ ((p : ℝ) - 1) * ENNReal.ofReal m⁻¹ *
        (ENNReal.ofReal (C + G) ^ (p : ℝ) * X ^ (p : ℝ) +
          ENNReal.ofReal (C + G) ^ (p : ℝ) * X ^ (p : ℝ)) := by
      gcongr
      · exact le_add_of_nonneg_right hG0
      · exact hgrad.trans (ENNReal.rpow_le_rpow le_self_add hpR.le)
      · exact le_add_of_nonneg_left hC
      · exact (lintegral_rpow_enorm_le_rpow_eLpNorm hp0 u).trans
          (ENNReal.rpow_le_rpow le_add_self hpR.le)
    _ = _ := by
      have h2 : (2 : ℝ≥0∞) ^ ((p : ℝ) - 1) * 2 ^ (1 : ℝ) = 2 ^ (p : ℝ) := by
        rw [← ENNReal.rpow_add _ _ two_ne_zero ENNReal.ofNat_ne_top, sub_add_cancel]
      rw [ENNReal.rpow_one] at h2
      rw [← two_mul, ENNReal.mul_rpow_of_nonneg _ _ hpR.le,
        ENNReal.mul_rpow_of_nonneg _ _ hpR.le, ENNReal.mul_rpow_of_nonneg _ _ hpR.le,
        ENNReal.rpow_inv_rpow hpR.ne', ← h2]
      ring

without_proof_info in
/-- The value part of a chart cutoff is controlled by the native value
norm with the same density lower bound. -/
theorem boundary_chart_cutoff_eLpNorm_value_le (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r m : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    (hm : 0 < m)
    (hρ : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      m ≤ chartVolumeDensity (I := I) c ((extChartAt I c).symm z))
    {u : M → ℝ} (hu : Continuous u) {p : ℝ≥0} (hp : 0 < p) :
    eLpNorm (fun z => b z * u ((extChartAt I c).symm z)) p
        ((Module.finBasis ℝ E).addHaar.restrict (boundaryChartCap (I := I) c r : Set E)) ≤
      ENNReal.ofReal m⁻¹ ^ (p : ℝ)⁻¹ * eLpNorm u p (riemannianVolume I M) := by
  let Ω := boundaryChartCap (I := I) c r
  have hΩt : (Ω : Set E) ⊆ (extChartAt I c).target :=
    (boundaryChartCap_subset_interior_target c hrt).trans interior_subset
  have hpR : 0 < (p : ℝ) := NNReal.coe_pos.2 hp
  have hw : ContinuousOn (fun z => b z * u ((extChartAt I c).symm z)) (Ω : Set E) :=
    b.continuous.continuousOn.mul
    (hu.comp_continuousOn ((continuousOn_extChartAt_symm c).mono hΩt))
  rw [← ENNReal.rpow_le_rpow_iff hpR,
    eLpNorm_nnreal_pow_eq_lintegral hp.ne' (hw.aestronglyMeasurable (μ := (Module.finBasis ℝ E).addHaar) Ω.isOpen.measurableSet)]
  calc
    _ ≤ ∫⁻ z in (Ω : Set E), ‖u ((extChartAt I c).symm z)‖ₑ ^ (p : ℝ)
        ∂(Module.finBasis ℝ E).addHaar := by
      apply setLIntegral_mono' Ω.isOpen.measurableSet
      intro z hz
      apply ENNReal.rpow_le_rpow _ hpR.le
      rw [← ofReal_norm, ← ofReal_norm]
      apply ENNReal.ofReal_le_ofReal
      rw [norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _)
        (by simpa only [Real.norm_eq_abs, abs_of_nonneg b.nonneg] using b.le_one (x := z))
    _ ≤ ENNReal.ofReal m⁻¹ * ∫⁻ x, ‖u x‖ₑ ^ (p : ℝ) ∂riemannianVolume I M :=
      setLIntegral_native_chart_symm_le c Ω.isOpen hΩt hm hρ
        (fun x => ‖u x‖ₑ ^ (p : ℝ))
    _ ≤ ENNReal.ofReal m⁻¹ * eLpNorm u p (riemannianVolume I M) ^ (p : ℝ) :=
      mul_le_mul_of_nonneg_left (lintegral_rpow_enorm_le_rpow_eLpNorm hp.ne' u) bot_le
    _ = _ := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hpR.le, ENNReal.rpow_inv_rpow hpR.ne']

end ConformalPoisson

end ProofPart_BoundaryChartL2Bounds

/- Proof support: DirichletSobolevSpace.lean, SHA256 9b548ecc97ee20b41b6de40494cff57a153a0af125d80b4846a008418ffe8906 -/
noncomputable section ProofPart_DirichletSobolevSpace




/- The native zero-trace energy space, using Tau Ceti's canonical H1
completion also on boundary models. No Boundaryless instance is assumed.
Compactness and weak-to-smooth boundary regularity remain separate bridges. -/
open Bundle MeasureTheory Set TauCeti
open scoped Manifold ContDiff InnerProductSpace
namespace ConformalPoisson.DirichletSobolev
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [CompactSpace M] [IsManifold I 1 M]
  [MeasurableSpace M] [BorelSpace M] [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]

/-- Smooth functions whose actual values vanish on the specified trace set. -/
def smoothZeroOn (B : Set M) : Submodule ℝ C^∞⟮I, M; ℝ⟯ where
  carrier := {u | ∀ x ∈ B, u x = 0}
  zero_mem' := by intro x _; rfl
  add_mem' := by intro u v hu hv x hx; simp [hu x hx, hv x hx]
  smul_mem' := by intro c u hu x hx; simp [hu x hx]

/-- Closure of the actual smooth zero-trace functions in the canonical
native H1 norm. For the paper B is the entire native boundary. -/
def zeroTraceSubmodule (B : Set M) : Submodule ℝ (Manifold.SobolevH1 I M) :=
  ((smoothZeroOn (I := I) B).map Manifold.SobolevH1.ofSmooth).topologicalClosure

instance (B : Set M) : CompleteSpace (zeroTraceSubmodule (I := I) B) := by
  unfold zeroTraceSubmodule
  infer_instance

without_proof_info in
/-- Every smooth function vanishing on B is a member of the zero-trace
energy space, without a separate boundary approximation hypothesis. -/
theorem ofSmooth_mem_zeroTraceSubmodule (B : Set M) (u : C^∞⟮I, M; ℝ⟯)
    (hu : ∀ x ∈ B, u x = 0) :
    Manifold.SobolevH1.ofSmooth u ∈ zeroTraceSubmodule (I := I) B := by
  apply Submodule.le_topologicalClosure
  exact ⟨u, hu, rfl⟩

/-- The actual native L2 value of a zero-trace H1 element. -/
def valueL (B : Set M) : zeroTraceSubmodule (I := I) B →L[ℝ] Lp ℝ 2 (riemannianVolume I M) :=
  Manifold.SobolevH1.toLp.comp (zeroTraceSubmodule (I := I) B).subtypeL

without_proof_info in
theorem norm_valueL_le (B : Set M) (u : zeroTraceSubmodule (I := I) B) :
    ‖valueL B u‖ ≤ ‖u‖ := Manifold.SobolevH1.norm_toLp_le u.val

/-- The native signed-potential energy form restricted to zero trace. -/
def schrodingerForm (B : Set M) (Q : Lp ℝ ⊤ (riemannianVolume I M)) :
    zeroTraceSubmodule (I := I) B →L[ℝ] zeroTraceSubmodule (I := I) B →L[ℝ] ℝ :=
  (Manifold.SobolevH1.dirichletForm + Manifold.SobolevH1.potentialForm Q).bilinearComp
    (zeroTraceSubmodule (I := I) B).subtypeL (zeroTraceSubmodule (I := I) B).subtypeL

without_proof_info in
theorem schrodingerForm_apply (B : Set M) (Q : Lp ℝ ⊤ (riemannianVolume I M))
    (u v : zeroTraceSubmodule (I := I) B) :
    schrodingerForm B Q u v = Manifold.SobolevH1.dirichletForm u.val v.val +
      Manifold.SobolevH1.potentialForm Q u.val v.val := rfl

without_proof_info in
theorem schrodingerForm_comm (B : Set M) (Q : Lp ℝ ⊤ (riemannianVolume I M))
    (u v : zeroTraceSubmodule (I := I) B) : schrodingerForm B Q u v = schrodingerForm B Q v u := by
  rw [schrodingerForm_apply, schrodingerForm_apply,
    Manifold.SobolevH1.dirichletForm_comm u.val v.val,
    Manifold.SobolevH1.potentialForm_comm Q u.val v.val]

without_proof_info in
/-- Signed potentials give a Gårding inequality after a fixed mass shift;
no nonnegativity hypothesis on Q is imposed. -/
theorem schrodingerForm_garding (B : Set M) (Q : Lp ℝ ⊤ (riemannianVolume I M))
    (u : zeroTraceSubmodule (I := I) B) :
    ‖u‖ ^ 2 ≤ schrodingerForm B Q u u + (‖Q‖ + 1) * ‖valueL B u‖ ^ 2 := by
  have hneg : Manifold.SobolevH1.potentialForm (-Q) u.val u.val =
      -Manifold.SobolevH1.potentialForm Q u.val u.val := by
    rw [Manifold.SobolevH1.potentialForm_apply, Manifold.SobolevH1.potentialForm_apply,
      ← integral_neg]
    apply integral_congr_ae
    filter_upwards [Lp.coeFn_neg Q] with x hx
    rw [hx]
    simp only [Pi.neg_apply]
    ring
  have hb := Manifold.SobolevH1.potentialForm_self_le (-Q) u.val
  rw [hneg, norm_neg] at hb
  have he := Manifold.SobolevH1.norm_sq_eq_dirichletForm_add u.val
  rw [schrodingerForm_apply]
  change ‖u.val‖ ^ 2 ≤ Manifold.SobolevH1.dirichletForm u.val u.val +
    Manifold.SobolevH1.potentialForm Q u.val u.val +
      (‖Q‖ + 1) * ‖Manifold.SobolevH1.toLp u.val‖ ^ 2
  nlinarith

without_proof_info in
/-- Checked conditional Fredholm caller: only native compactness and
weak kernel triviality remain at this functional-analytic interface.
The selected theorem does not assume these producer obligations. -/
theorem existsUnique_weakSolution_of_compact_value_of_trivial_kernel
    (B : Set M) (Q : Lp ℝ ⊤ (riemannianVolume I M))
    (hcompact : IsCompactOperator (valueL (I := I) B))
    (hker : ∀ u : zeroTraceSubmodule (I := I) B,
      (∀ v, schrodingerForm B Q u v = 0) → u = 0)
    (F : Lp ℝ 2 (riemannianVolume I M)) :
    ∃! u : zeroTraceSubmodule (I := I) B,
      ∀ v, schrodingerForm B Q u v = ⟪F, valueL B v⟫_ℝ := by
  let forcing : StrongDual ℝ (zeroTraceSubmodule (I := I) B) := (innerSL ℝ F).comp (valueL B)
  exact hcompact.existsUnique_forall_apply_eq_of_garding (B := schrodingerForm B Q)
    (C₀ := 1) (β := ‖Q‖ + 1) (by norm_num)
    (fun u => by simpa only [one_mul] using schrodingerForm_garding B Q u) hker forcing
end ConformalPoisson.DirichletSobolev

end ProofPart_DirichletSobolevSpace

/- Proof support: DirichletSobolevExtension.lean, SHA256 ee888cfbc569cadc87815888a1cec79a2ea983900297092412dc0e387fc95b74 -/
noncomputable section ProofPart_DirichletSobolevExtension



/- Extend bounded chart readings from actual smooth zero-trace functions
to the canonical native zero-trace H1 closure. The source smooth space needs
no private Sobolev norm and no injectivity premise. -/
open Bundle MeasureTheory Set TauCeti
open scoped Manifold ContDiff InnerProductSpace Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletSobolev
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [CompactSpace M] [IsManifold I 1 M]
  [MeasurableSpace M] [BorelSpace M] [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]

/-- Actual smooth zero-trace functions included in their H1 closure. -/
def smoothInclusion (B : Set M) : smoothZeroOn (I := I) B →ₗ[ℝ] zeroTraceSubmodule (I := I) B where
  toFun u := ⟨Manifold.SobolevH1.ofSmooth u.val, ofSmooth_mem_zeroTraceSubmodule B u.val u.property⟩
  map_add' _ _ := Subtype.ext (map_add _ _ _)
  map_smul' _ _ := Subtype.ext (map_smul _ _ _)

without_proof_info in
@[simp] theorem smoothInclusion_val (B : Set M) (u : smoothZeroOn (I := I) B) :
    (smoothInclusion B u).val = Manifold.SobolevH1.ofSmooth u.val := rfl

without_proof_info in
/-- Density is the defining closure property, not an unproved boundary
trace approximation theorem. -/
theorem denseRange_smoothInclusion (B : Set M) : DenseRange (smoothInclusion (I := I) B) := by
  rw [DenseRange, Subtype.dense_iff, ← Set.range_comp]
  have hr : Set.range (fun u : smoothZeroOn (I := I) B => Manifold.SobolevH1.ofSmooth u.val) =
      ((smoothZeroOn (I := I) B).map Manifold.SobolevH1.ofSmooth : Set (Manifold.SobolevH1 I M)) := by
    ext x
    constructor
    · rintro ⟨u, rfl⟩
      exact ⟨u.val, u.property, rfl⟩
    · rintro ⟨u, hu, rfl⟩
      exact ⟨⟨u, hu⟩, rfl⟩
  change (zeroTraceSubmodule (I := I) B : Set (Manifold.SobolevH1 I M)) ⊆
    closure (Set.range (fun u : smoothZeroOn (I := I) B => Manifold.SobolevH1.ofSmooth u.val))
  rw [hr]
  exact subset_rfl

variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

/-- Canonical bounded extension of a smooth chart reading. Correctness is
asserted only when the native H1 bound is supplied. -/
def extendSmoothReading (B : Set M) (T : smoothZeroOn (I := I) B →ₗ[ℝ] F) :
    zeroTraceSubmodule (I := I) B →L[ℝ] F := T.extendOfNorm (smoothInclusion B)

without_proof_info in
theorem extendSmoothReading_apply (B : Set M) (T : smoothZeroOn (I := I) B →ₗ[ℝ] F)
    {C : ℝ} (hbound : ∀ u, ‖T u‖ ≤ C * ‖Manifold.SobolevH1.ofSmooth u.val‖)
    (u : smoothZeroOn (I := I) B) :
    extendSmoothReading B T (smoothInclusion B u) = T u := by
  exact LinearMap.extendOfNorm_eq (f := T) (e := smoothInclusion B)
    (denseRange_smoothInclusion B) ⟨C, hbound⟩ u

without_proof_info in
theorem norm_extendSmoothReading_le (B : Set M) (T : smoothZeroOn (I := I) B →ₗ[ℝ] F)
    {C : ℝ} (hbound : ∀ u, ‖T u‖ ≤ C * ‖Manifold.SobolevH1.ofSmooth u.val‖)
    (u : zeroTraceSubmodule (I := I) B) :
    ‖extendSmoothReading B T u‖ ≤ C * ‖u‖ := by
  exact LinearMap.norm_extendOfNorm_apply_le (f := T) (e := smoothInclusion B)
    (denseRange_smoothInclusion B) C hbound u

omit [CompleteSpace F] in
without_proof_info in
/-- Equality on actual smooth zero-trace functions determines continuous
linear maps on the whole native energy space. -/
theorem clm_eq_of_smoothInclusion (B : Set M)
    (S T : zeroTraceSubmodule (I := I) B →L[ℝ] F)
    (h : ∀ u : smoothZeroOn (I := I) B, S (smoothInclusion B u) = T (smoothInclusion B u)) : S = T := by
  apply ContinuousLinearMap.ext
  intro u
  exact congrFun ((denseRange_smoothInclusion B).equalizer S.continuous T.continuous (funext h)) u
end ConformalPoisson.DirichletSobolev

end ProofPart_DirichletSobolevExtension

/- Proof support: BoundaryChartSobolev.lean, SHA256 7b0aef02fce17aa8378aa0f033be18b3401c151cf3cefc52663f155c7e045126 -/
noncomputable section ProofPart_BoundaryChartSobolev




/- Quantitative zero-trace Sobolev readings in actual boundary charts.
The intended downstream caller is native Rellich compactness. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [CompactSpace M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
variable [MeasurableSpace E] [BorelSpace E]

without_proof_info in
/-- Both actual native L2 readings of a smooth function are controlled
by its canonical H1 norm, in extended-norm form. -/
theorem native_smooth_eLpNorm_value_gradient_le (u : C^∞⟮I, M; ℝ⟯) :
    eLpNorm u 2 (riemannianVolume I M) ≤ ENNReal.ofReal ‖SobolevH1.ofSmooth u‖ ∧
    eLpNorm (fun x => ‖mgradient I u x‖) 2 (riemannianVolume I M) ≤
      ENNReal.ofReal ‖SobolevH1.ofSmooth u‖ := by
  have hv := SobolevH1.norm_toLp_le (SobolevH1.ofSmooth u)
  rw [SobolevH1.toLp_ofSmooth] at hv
  have hg := SobolevH1.norm_toLp_norm_mgradient_le u
  constructor
  · calc
      _ = eLpNorm (ContinuousMap.toLp 2 (riemannianVolume I M) ℝ (u : C(M, ℝ))) 2
          (riemannianVolume I M) :=
        eLpNorm_congr_ae (ContinuousMap.coeFn_toLp (p := 2) (μ := riemannianVolume I M) (𝕜 := ℝ) (u : C(M, ℝ))).symm
      _ = ENNReal.ofReal ‖ContinuousMap.toLp 2 (riemannianVolume I M) ℝ (u : C(M, ℝ))‖ :=
        (ENNReal.ofReal_toReal (Lp.eLpNorm_ne_top _)).symm
      _ ≤ _ := ENNReal.ofReal_le_ofReal hv
  · let g : C(M, ℝ) := ⟨fun x => ‖mgradient I u x‖,
      continuous_norm_mgradient (u.contMDiff.of_le (by simp))⟩
    calc
      _ = eLpNorm (ContinuousMap.toLp 2 (riemannianVolume I M) ℝ g) 2
          (riemannianVolume I M) :=
        eLpNorm_congr_ae (ContinuousMap.coeFn_toLp (p := 2) (μ := riemannianVolume I M) (𝕜 := ℝ) g).symm
      _ = ENNReal.ofReal ‖ContinuousMap.toLp 2 (riemannianVolume I M) ℝ g‖ :=
        (ENNReal.ofReal_toReal (Lp.eLpNorm_ne_top _)).symm
      _ ≤ _ := ENNReal.ofReal_le_ofReal hg

without_proof_info in
/-- The H1 norm bound for the actual chart reading, with constants
chosen before the smooth function or its Sobolev representative. -/
theorem norm_boundary_chart_W1p0_le (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r C m G : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    (hC : 0 ≤ C) (hm : 0 < m)
    (hρ : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      m ≤ chartVolumeDensity (I := I) c ((extChartAt I c).symm z))
    (hG : ∀ z, ‖fderiv ℝ b z‖ ≤ G)
    (u : C^∞⟮I, M; ℝ⟯)
    (hcmp : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E),
      ‖fderiv ℝ (u ∘ (extChartAt I c).symm) z‖ ≤
        C * ‖mgradient I u ((extChartAt I c).symm z)‖)
    (U : W1p0 (Module.finBasis ℝ E).addHaar (boundaryChartCap (I := I) c r) 2)
    (hUv : W1p.value (U : W1p (Module.finBasis ℝ E).addHaar (boundaryChartCap (I := I) c r) 2) =ᵐ[(Module.finBasis ℝ E).addHaar.restrict
      (boundaryChartCap (I := I) c r : Set E)]
      (fun z => b z * u ((extChartAt I c).symm z))) :
    ‖U‖ ≤ (ENNReal.ofReal m⁻¹ ^ (2 : ℝ)⁻¹).toReal * (1 + 4 * (C + G)) *
      ‖SobolevH1.ofSmooth u‖ := by
  let Ω := boundaryChartCap (I := I) c r
  let μ := (Module.finBasis ℝ E).addHaar
  let A : ℝ≥0∞ := ENNReal.ofReal m⁻¹ ^ (2 : ℝ)⁻¹
  let N := ‖SobolevH1.ofSmooth u‖
  have hN : 0 ≤ N := norm_nonneg _
  have hA : A ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top
  have hG0 : 0 ≤ G := (norm_nonneg _).trans (hG 0)
  have hnon : 0 ≤ C + G := add_nonneg hC hG0
  obtain ⟨hnv, hng⟩ := native_smooth_eLpNorm_value_gradient_le u
  have hv := boundary_chart_cutoff_eLpNorm_value_le c b hrt hm hρ u.contMDiff.continuous (p := 2) (by norm_num)
  have hg := boundary_chart_cutoff_eLpNorm_gradient_le c b hrt hC hm hρ
    (u.contMDiff.of_le (by simp)) hcmp hG (p := 2) (by norm_num)
  have hUg := W1p.gradient_ae_eq_of_contDiffOn (U : W1p μ Ω 2)
    (boundary_chart_cutoff_contDiffOn c b hrt (u.contMDiff.of_le (by simp))) hUv
  have hval : eLpNorm (W1p.value (U : W1p μ Ω 2)) 2 (μ.restrict (Ω : Set E)) ≤
      A * ENNReal.ofReal N := by
    rw [eLpNorm_congr_ae hUv]
    exact hv.trans (mul_le_mul_of_nonneg_left hnv bot_le)
  have hgrad : eLpNorm (W1p.gradient (U : W1p μ Ω 2)) 2 (μ.restrict (Ω : Set E)) ≤
      2 * ENNReal.ofReal (C + G) * A * (ENNReal.ofReal N + ENNReal.ofReal N) := by
    rw [eLpNorm_congr_ae hUg]
    exact hg.trans (mul_le_mul_of_nonneg_left (add_le_add hng hnv) bot_le)
  have hvalR : ‖W1p.value (U : W1p μ Ω 2)‖ ≤ A.toReal * N := by
    rw [Lp.norm_def]
    have h := ENNReal.toReal_mono (ENNReal.mul_ne_top hA ENNReal.ofReal_ne_top) hval
    simpa only [ENNReal.toReal_mul, ENNReal.toReal_ofReal hN] using h
  have hgradR : ‖W1p.gradient (U : W1p μ Ω 2)‖ ≤ 4 * (C + G) * A.toReal * N := by
    rw [Lp.norm_def]
    have hfin : 2 * ENNReal.ofReal (C + G) * A * (ENNReal.ofReal N + ENNReal.ofReal N) ≠ ⊤ := by
      finiteness
    have h := ENNReal.toReal_mono hfin hgrad
    simp only [ENNReal.toReal_mul, ENNReal.toReal_ofNat, ENNReal.toReal_ofReal hnon,
      ENNReal.toReal_add ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal hN] at h
    nlinarith [h]
  calc
    ‖U‖ ≤ ‖W1p.value (U : W1p μ Ω 2)‖ + ‖W1p.gradient (U : W1p μ Ω 2)‖ :=
      W1p.norm_le_norm_value_add_norm_gradient (U : W1p μ Ω 2)
    _ ≤ A.toReal * N + 4 * (C + G) * A.toReal * N := add_le_add hvalR hgradR
    _ = _ := by dsimp only [A, N]; ring
end ConformalPoisson

end ProofPart_BoundaryChartSobolev

/- Proof support: BoundaryChartLocalization.lean, SHA256 653f56eda28a1e4901e8baf7bf61a1ee7b7ea439c76b6039293203fd489a08cb -/
noncomputable section ProofPart_BoundaryChartLocalization


/- Uniform boundary-chart localization data and the actual canonical
Sobolev reading. Every data field below is constructed from the native
metric, chart and smooth bump; none is an additional analytical premise. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]

/-- Actual small chart-cap data; constants and cutoff are chosen before
any function to be localized. -/
structure BoundaryChartLocalization (c : M) where
  radius : ℝ
  radius_pos : 0 < radius
  C : ℝ
  C_nonneg : 0 ≤ C
  density : ℝ
  density_pos : 0 < density
  bump : ContDiffBump (extChartAt I c c)
  bump_lt : bump.rOut < radius
  target : closedBall (extChartAt I c c) radius ∩ range I ⊆ (extChartAt I c).target
  comparison : ∀ z ∈ (boundaryChartCap (I := I) c radius : Set E), ∀ f : M → ℝ,
    MDifferentiableAt I 𝓘(ℝ) f ((extChartAt I c).symm z) →
    ‖fderiv ℝ (f ∘ (extChartAt I c).symm) z‖ ≤ C * ‖mgradient I f ((extChartAt I c).symm z)‖
  density_lower : ∀ z ∈ (boundaryChartCap (I := I) c radius : Set E),
    density ≤ chartVolumeDensity (I := I) c ((extChartAt I c).symm z)
  densityUpper : ℝ
  densityUpper_pos : 0 < densityUpper
  density_upper : ∀ z ∈ (boundaryChartCap (I := I) c radius : Set E),
    chartVolumeDensity (I := I) c ((extChartAt I c).symm z) ≤ densityUpper
  G : ℝ
  gradient_bound : ∀ z, ‖fderiv ℝ bump z‖ ≤ G

without_proof_info in
/-- Construct the localization at every point, including boundary
points, without assuming a Euclidean ball crosses into the chart target. -/
theorem nonempty_boundaryChartLocalization (c : M) :
    Nonempty (BoundaryChartLocalization (I := I) c) := by
  obtain ⟨C, hC, R, hR, htarget, hbounds⟩ :=
    exists_relative_ball_coordinate_energy_bounds (I := I) c
  let b : ContDiffBump (extChartAt I c c) := ⟨R / 8, R / 4, by positivity, by linarith⟩
  obtain ⟨G, hG⟩ := (b.hasCompactSupport.fderiv (𝕜 := ℝ)).exists_bound_of_continuous
    ((b.contDiff (n := (⊤ : ℕ∞))).continuous_fderiv (𝕜 := ℝ) (by simp))
  have hρ : 0 < chartVolumeDensity (I := I) c c :=
    chartVolumeDensity_pos c (FiberBundle.mem_baseSet_trivializationAt' c)
  have hsub : (boundaryChartCap (I := I) c (R / 2) : Set E) ⊆
      ball (extChartAt I c c) R ∩ interior (range I) := by
    intro z hz
    exact ⟨ball_subset_ball (by linarith) hz.1, hz.2⟩
  refine ⟨{ radius := R / 2
            radius_pos := by positivity
            C := C
            C_nonneg := hC.le
            density := chartVolumeDensity (I := I) c c / 2
            density_pos := by positivity
            bump := b
            bump_lt := by dsimp [b]; linarith
            target := ?_
            comparison := ?_
            density_lower := ?_
            densityUpper := 2 * chartVolumeDensity (I := I) c c
            densityUpper_pos := by positivity
            density_upper := ?_
            G := G
            gradient_bound := hG }⟩
  · intro z hz
    exact htarget ⟨mem_ball.mpr ((mem_closedBall.mp hz.1).trans_lt (by linarith)), hz.2⟩
  · intro z hz f hf
    exact (hbounds z (hsub hz)).2.1 f hf
  · intro z hz
    exact (hbounds z (hsub hz)).2.2.1.le
  · intro z hz
    exact (hbounds z (hsub hz)).2.2.2.le

end ConformalPoisson

end ProofPart_BoundaryChartLocalization

/- Proof support: BoundaryChartReading.lean, SHA256 f6dfef315f11eb6e6fe8950eac8794f1a647c78412b0a753c320413fe6003041 -/
noncomputable section ProofPart_BoundaryChartReading


/- The bounded zero-trace chart reading extends by density to native H1.
Its Euclidean L2 value is compact by the pinned W1p0 Rellich theorem. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.BoundaryChartLocalization
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [CompactSpace M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
variable [MeasurableSpace E] [BorelSpace E]
open DirichletSobolev
variable {c : M} (L : BoundaryChartLocalization (I := I) c)

/-- The canonical Sobolev representative of the actual smooth cutoff. -/
def smoothReading (u : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    W1p0 (Module.finBasis ℝ E).addHaar (boundaryChartCap (I := I) c L.radius) 2 :=
  Classical.choose (exists_W1p0_boundary_chart_cutoff c L.bump L.bump_lt L.target L.C_nonneg
    L.comparison (u.val.contMDiff.of_le (by simp)) (fun x hx => u.property x hx))

without_proof_info in
theorem smoothReading_value_ae (u : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    W1p.value (L.smoothReading u : W1p (Module.finBasis ℝ E).addHaar
      (boundaryChartCap (I := I) c L.radius) 2) =ᵐ[(Module.finBasis ℝ E).addHaar.restrict
        (boundaryChartCap (I := I) c L.radius : Set E)]
        (fun z => L.bump z * u.val ((extChartAt I c).symm z)) :=
  (Classical.choose_spec (exists_W1p0_boundary_chart_cutoff c L.bump L.bump_lt L.target L.C_nonneg
    L.comparison (u.val.contMDiff.of_le (by simp)) (fun x hx => u.property x hx))).1

/-- Uniqueness of the Sobolev representative makes the smooth reading
linear; no compatibility law is added as a premise. -/
def smoothReadingLinear : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x} →ₗ[ℝ]
    W1p0 (Module.finBasis ℝ E).addHaar (boundaryChartCap (I := I) c L.radius) 2 where
  toFun := L.smoothReading
  map_add' u v := by
    apply Subtype.ext
    apply W1p.ext_value
    apply Lp.ext
    filter_upwards [L.smoothReading_value_ae (u + v), L.smoothReading_value_ae u,
      L.smoothReading_value_ae v,
      W1p.value_add_ae (L.smoothReading u).val (L.smoothReading v).val] with z hsum hu hv hadd
    change W1p.value (L.smoothReading (u + v)).val z =
      W1p.value ((L.smoothReading u).val + (L.smoothReading v).val) z
    rw [hsum, hadd, Pi.add_apply, hu, hv]
    change L.bump z * (u.val ((extChartAt I c).symm z) + v.val ((extChartAt I c).symm z)) = _
    ring
