theorem firstOrderSymbol_eqOn_of_gram_eqOn (F₁ F₂ : NormalMetricField S)
    (hG : EqOn F₁.gram F₂.gram S) (ξ : Fin n → ℝ) :
    EqOn (F₁.firstOrderSymbol ξ) (F₂.firstOrderSymbol ξ) S := by
  have hA := inverse_eqOn_of_gram_eqOn F₁ F₂ hG
  intro z hz
  have hDG (i : Fin n) : tangentialMatrixDeriv i F₁.gram z =
      tangentialMatrixDeriv i F₂.gram z :=
    modelDirectionalDeriv_eq_of_eventuallyEq _ _
      (Filter.eventuallyEq_of_mem (S.isOpen.mem_nhds hz) hG)
  have hDA (i : Fin n) : tangentialMatrixDeriv i F₁.inverse z =
      tangentialMatrixDeriv i F₂.inverse z :=
    modelDirectionalDeriv_eq_of_eventuallyEq _ _
      (Filter.eventuallyEq_of_mem (S.isOpen.mem_nhds hz) hA)
  simp only [NormalMetricField.firstOrderSymbol, hDG, hDA, hA hz]

def transferRawFamily (F₁ F₂ : NormalMetricField S)
    (hG : EqOn F₁.gram F₂.gram S) (B : NormalMetricField.RawSymbolFamily F₁) :
    NormalMetricField.RawSymbolFamily F₂ where
