theorem memLp_of_local_halfSpace_sobolev_gain
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U)
    (hpq : p ≤ q) (hgap : (p : ℝ)⁻¹ - (q : ℝ)⁻¹ < (finrank ℝ X : ℝ)⁻¹)
    (u : W1p μ Ω (p : ℝ≥0∞)) :
    MemLp (W1p.value u) (q : ℝ≥0∞) (μ.restrict (Ω ⊓ D : Opens X)) := by
  obtain ⟨Z, hae⟩ := exists_local_wholeSpace_extension_euclidean_halfSpace hΩH hHU hD hDU u
  obtain ⟨C, hC⟩ := W1p.exists_eLpNorm_value_le_of_subcritical_gain
    (μ := (volume : Measure X)) (Ω := (⊤ : Opens X)) (V := (D : Set X)) hpq hgap hD (by simp)
  have hm : MemLp (W1p.value Z) (q : ℝ≥0∞) ((volume : Measure X).restrict D) :=
    (hC Z).trans_lt (by finiteness)
  have hmμ := memLp_changeHaar (μ := volume) (ν := μ) hm
  have hmD : MemLp (W1p.value Z) (q : ℝ≥0∞) (μ.restrict (Ω ⊓ D : Opens X)) :=
    hmμ.mono_measure (Measure.restrict_mono_set μ
      (SetLike.coe_subset_coe.mpr (inf_le_right : Ω ⊓ D ≤ D)))
  exact (memLp_congr_ae hae).mp hmD

without_proof_info in
theorem exists_wkp_of_local_halfSpace_sobolev_gain
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U)
    (hpq : p ≤ q) (hgap : (p : ℝ)⁻¹ - (q : ℝ)⁻¹ < (finrank ℝ X : ℝ)⁻¹)
    (k : ℕ) (u : Wkp μ Ω (p : ℝ≥0∞) (k + 1)) :
    ∃ v : Wkp μ (Ω ⊓ D) (q : ℝ≥0∞) k,
