/- Actual Schwartz transposition for the native interior extension,
with the original differential operator as a continuous test map. -/
open TauCeti MeasureTheory LineDeriv
open scoped SchwartzMap ContDiff
namespace ConformalPoisson
variable {d : ℕ} {ι : Type*} [Fintype ι]

def scalarDifferentialTestCLM
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) :
    𝓢(CoordinateSpace d, ℂ) →L[ℂ] 𝓢(CoordinateSpace d, ℂ) :=
  ∑ i, SchwartzMap.smulLeftCLM ℂ (b i) ∘L iteratedLineDerivOpCLM ℂ 𝓢(CoordinateSpace d, ℂ) (v i)

without_proof_info in
theorem scalarDifferentialTestCLM_apply
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) (hb : ∀ i, (b i).HasTemperateGrowth)
    (u : 𝓢(CoordinateSpace d, ℂ)) (x : CoordinateSpace d) :
    scalarDifferentialTestCLM k v b u x = ∑ i, b i x * ∂^{v i} u x := by
  simp only [scalarDifferentialTestCLM, sum_apply, ContinuousLinearMap.comp_apply,
    iteratedLineDerivOpCLM_apply]
  apply Finset.sum_congr rfl
  intro i _
  exact SchwartzMap.smulLeftCLM_apply_apply (hb i) _ x

variable {A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d}
  {b : CoordinateSpace d → CoordinateSpace d} {q : CoordinateSpace d → ℝ} {z₀ : CoordinateSpace d}

without_proof_info in
theorem SmoothEllipticExtensionData.secondOrder_coefficient_temperate
    (E : SmoothEllipticExtensionData d A b q z₀) (i : SecondOrderTerm d) :
    (fun x => (secondOrderTermCoefficient E.principal E.drift E.potential i x : ℂ)).HasTemperateGrowth := by
  rcases i with ij | (i | u)
  · exact Complex.hasTemperateGrowth_ofReal.comp (E.principal_entry_temperate ij.1 ij.2).neg
  · exact Complex.hasTemperateGrowth_ofReal.comp (E.drift_entry_temperate i)
  · exact Complex.hasTemperateGrowth_ofReal.comp
      (E.potential_compact.hasTemperateGrowth E.potential_smooth)

def SmoothEllipticExtensionData.originalTestCLM
    (E : SmoothEllipticExtensionData d A b q z₀) :
    𝓢(CoordinateSpace d, ℂ) →L[ℂ] 𝓢(CoordinateSpace d, ℂ) :=
  scalarDifferentialTestCLM secondOrderTermOrder secondOrderTermDirections
    (fun i x => (secondOrderTermCoefficient E.principal E.drift E.potential i x : ℂ))

without_proof_info in
theorem SmoothEllipticExtensionData.originalTestCLM_quantize
    (E : SmoothEllipticExtensionData d A b q z₀)
    (u : 𝓢(CoordinateSpace d, ℂ)) (x : CoordinateSpace d) :
    E.originalTestCLM u x = quantizeSchwartzValue E.symbol.toSymbol.coefficient u x := by
  rw [SmoothEllipticExtensionData.originalTestCLM,
    scalarDifferentialTestCLM_apply _ _ _ E.secondOrder_coefficient_temperate,
    SmoothEllipticExtensionData.symbol, secondOrderScalarSymbol, realScalarDifferentialSymbol,
    ClassicalSymbol.quantizeSchwartzValue_ofDifferentialSymbol]
  simp only [smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]

without_proof_info in
theorem SmoothEllipticExtensionData.integral_original_transpose
    (E : SmoothEllipticExtensionData d A b q z₀)
    (u ψ : 𝓢(CoordinateSpace d, ℂ)) :
    (∫ x, ψ x * E.originalTestCLM u x) =
      ∫ x, realSecondOrderTransposeTestCLM E.principal E.drift E.potential ψ x * u x := by
  have h := integral_scalarDifferentialSymbol_transpose secondOrderTermOrder secondOrderTermDirections
    (fun i x => (secondOrderTermCoefficient E.principal E.drift E.potential i x : ℂ))
    E.secondOrder_coefficient_temperate secondOrderTermOrder_le_two u ψ
  simp only [scalarDifferentialSymbol_quantize] at h
  rw [SmoothEllipticExtensionData.originalTestCLM]
  simp_rw [scalarDifferentialTestCLM_apply _ _ _ E.secondOrder_coefficient_temperate]
  exact h

without_proof_info in
theorem SmoothEllipticExtensionData.formalTransposeSymbol_quantize_eq_test
    (E : SmoothEllipticExtensionData d A b q z₀)
    (u : 𝓢(CoordinateSpace d, ℂ)) (x : CoordinateSpace d) :
    quantizeSchwartzValue E.formalTransposeSymbol.toSymbol.coefficient u x =
      realSecondOrderTransposeTestCLM E.principal E.drift E.potential u x :=
  formalTransposeScalarSymbol_quantize_eq_test _ _ _ E.principal_smooth E.drift_smooth E.potential_smooth
    E.principal_entry_temperate E.drift_entry_temperate
    (E.potential_compact.hasTemperateGrowth E.potential_smooth) u x

without_proof_info in
theorem SmoothEllipticExtensionData.integral_formalTransposeSymbol
    (E : SmoothEllipticExtensionData d A b q z₀)
    (u ψ : 𝓢(CoordinateSpace d, ℂ)) :
    (∫ x, ψ x * quantizeSchwartzValue E.formalTransposeSymbol.toSymbol.coefficient u x) =
      ∫ x, E.originalTestCLM ψ x * u x := by
  calc
    _ = ∫ x, realSecondOrderTransposeTestCLM E.principal E.drift E.potential u x * ψ x := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => by
        dsimp only
        rw [E.formalTransposeSymbol_quantize_eq_test]
        ring
    _ = ∫ x, u x * E.originalTestCLM ψ x := (E.integral_original_transpose ψ u).symm
    _ = _ := by
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => mul_comm _ _

end ConformalPoisson

