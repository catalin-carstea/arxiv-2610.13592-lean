namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℝ

def contractedChristoffel (A : Mat) (DG : Fin n → Mat) (k : Fin n) : ℝ :=
  ∑ i, ∑ j, A i j * ((1 / 2 : ℝ) * ∑ l, A k l *
    (DG i j l + DG j i l - DG l i j))

