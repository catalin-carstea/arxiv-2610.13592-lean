noncomputable section ProofPart_BoundarySolutionGerm


/- A supported original solution has a zero boundary germ at each
unobserved point; closed support is used even on the frontier of Gamma. -/
open Set Filter
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem DirichletSolver.eventually_zero_at_unobserved_boundary
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (S : DirichletSolver g q)
    {Γ : Set ((𝓡∂ (n + 1)).boundary M)} (f : BoundaryDatum Γ)
    (y : (𝓡∂ (n + 1)).boundary M) (hy : y ∉ Γ) :
    ∀ᶠ z : (𝓡∂ (n + 1)).boundary M in 𝓝 y, S.solve f.val z = 0 := by
  have hyf : y ∉ tsupport f.val := fun h => hy (f.property.2.2 h)
  have hnear : f.val =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hyf
  filter_upwards [hnear] with z hz
  exact ((S.correct f.val f.property.1).2.2 z).trans hz

without_proof_info in
theorem BoundaryDatum.exists_unobserved_zero_boundary_neighborhood [T2Space M]
    {Γ : Set ((𝓡∂ (n + 1)).boundary M)} (f : BoundaryDatum Γ)
    (y : (𝓡∂ (n + 1)).boundary M) (hy : y ∉ Γ) :
    ∃ V : TopologicalSpace.Opens M, (y : M) ∈ V ∧
      EqOn f.val (fun _ => 0) (observedPatch (n := n) V) := by
  let K : Set M := Subtype.val '' tsupport f.val
  have hK : IsCompact K := f.property.2.1.image continuous_subtype_val
  let V : TopologicalSpace.Opens M := ⟨Kᶜ, hK.isClosed.isOpen_compl⟩
  refine ⟨V, ?_, ?_⟩
  · rintro ⟨z, hz, heq⟩
    have hzy : z = y := Subtype.ext heq
    exact hy (hzy ▸ f.property.2.2 hz)
  · intro z hz
    by_contra hne
    exact hz ⟨z, subset_tsupport f.val hne, rfl⟩
end ConformalPoisson

