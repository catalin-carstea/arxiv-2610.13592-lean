  [MeasurableSpace M₂] [BorelSpace M₂] [LindelofSpace M₂]

without_proof_info in
theorem traceCoefficients_eq
    (hM₁ : IsCompact (univ : Set M₁)) (hM₂ : IsCompact (univ : Set M₂)) (hn : 2 ≤ n)
    (W : NativePairedLayerSetup P C) (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) (j : ℕ) :
    EqOn ((W.coefficients₁ ξ hξ).traceCoefficient W.amplitude j)
      ((W.coefficients₂ ξ hξ).traceCoefficient W.amplitude j) W.collar.cutoff.tangentialDomain := by
  letI : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M₁) := TauCeti.isManifold_boundary (n := n) (k := ω) M₁ (by decide)
  letI : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M₂) := TauCeti.isManifold_boundary (n := n) (k := ω) M₂ (by decide)
  obtain ⟨fr, fi, hLayers⟩ := W.exists_actual_paired_boundary_layers hM₁ hM₂ ξ hξ
  have hq₁ : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ P.potential₁ :=
    contMDiff_conformalGaugePotential A₁.smoothMetric A₁.potential P.gauge₁.multiplier
      (A₁.analytic_potential.of_le le_top) P.gauge₁.smooth P.gauge₁.positive
  have hq₂ : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ P.potential₂ :=
    contMDiff_conformalGaugePotential A₂.smoothMetric A₂.potential P.gauge₂.multiplier
      (A₂.analytic_potential.of_le le_top) P.gauge₂.smooth P.gauge₂.positive
  have hNR₁ : Nonresonant P.metric₁ P.potential₁ := Nonresonant.conformalGauge hn A₁.smoothMetric A₁.potential
    P.gauge₁.multiplier P.gauge₁.smooth P.gauge₁.positive A₁.nonresonant
  have hNR₂ : Nonresonant P.metric₂ P.potential₂ := Nonresonant.conformalGauge hn A₂.smoothMetric A₂.potential
    P.gauge₂.multiplier P.gauge₂.smooth P.gauge₂.positive A₂.nonresonant
  intro y hy
