      ENNReal.ofReal L.densityUpper *
        ∫⁻ z in (boundaryChartCap (I := I) c L.radius : Set E),
          F (L.bump z * u ((extChartAt I c).symm z)) ∂(Module.finBasis ℝ E).addHaar := by
