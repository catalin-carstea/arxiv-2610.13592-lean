local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

def splitChartPrincipal (g : Metric (n := n) (M := M)) (c : M) (z : P) : P →L[ℝ] P :=
  ((euclideanNormalSplit n).symm : V →L[ℝ] P) ∘L
    nativeChartPrincipal g c (euclideanNormalSplit n z) ∘L (euclideanNormalSplit n : P →L[ℝ] V)

def splitChartTraceForcing (g : Metric (n := n) (M := M)) (c : M)
    (q F u : M → ℝ) (z : P) : ℝ :=
  fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (euclideanNormalSplit n z)
      (nativeChartDrift g c (euclideanNormalSplit n z)) +
    nativeChartPotential c q (euclideanNormalSplit n z) *
      u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) -
    F ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))

without_proof_info in
theorem continuousOn_splitChartPrincipal_cap (g : Metric (n := n) (M := M)) (c : M) {r : ℝ}
