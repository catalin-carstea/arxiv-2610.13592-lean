    intro heq
    exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary
      (heq ▸ hpoints i) y.property
  have hP (i : ι) : ContMDiffAt K 𝓘(ℝ) 2 (boundaryPoissonSection ν G.kernel y) (points i) :=
    ((G.poisson_section_smooth y (points i) (hp i)).contMDiffAt
      (isOpen_compl_singleton.mem_nhds (hp i))).of_le (by decide)
