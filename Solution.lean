section Metric
variable (D : Opens (EuclideanSpace ℝ (Fin (n + 1))))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) ∞ (EuclideanSpace ℝ (Fin (n + 1))) (fun x : D => TangentSpace 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) x)]


without_proof_info in
theorem contMDiff_ambientCarlemanWeight (p : D) (b : ℝ) :
    ContMDiff 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) 𝓘(ℝ) ∞ (ambientCarlemanWeight D p b) := by
  exact contMDiff_convexifiedWeight
    (((contMDiff_ambientBoundaryFunction D).of_le le_top).add (contMDiff_ambientSquaredRadius D p)).neg
    ((contMDiff_ambientBoundaryFunction D).of_le le_top) b


set_option maxHeartbeats 900000 in
without_proof_info in
theorem exists_ambient_carleman_weight_bounds (p : D) (hp : (p : (EuclideanSpace ℝ (Fin (n + 1)))) 0 = 0) :
    ∃ (b c h w : ℝ) (U : Opens D), p ∈ U ∧ 0 ≤ b ∧ 0 ≤ c ∧ 0 < h - c * w ∧
      ∀ x ∈ U,
        (∀ ξ : TangentSpace 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) x,
          -c * ‖ξ‖ ^ 2 ≤ hessian 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) (ambientCarlemanWeight D p b) x ξ ξ) ∧
        h ≤ hessian 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) (ambientCarlemanWeight D p b) x
          (mgradient 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) (ambientCarlemanWeight D p b) x)
          (mgradient 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) (ambientCarlemanWeight D p b) x) ∧
        ‖mgradient 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) (ambientCarlemanWeight D p b) x‖ ^ 2 ≤ w := by
  let ell := ambientBoundaryFunction D
  let r := ambientSquaredRadius D p
  let ψ := -(ell + r)
  have hell : ContMDiff 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) 𝓘(ℝ) ∞ ell := (contMDiff_ambientBoundaryFunction D).of_le le_top
  have hr : ContMDiff 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) 𝓘(ℝ) ∞ r := contMDiff_ambientSquaredRadius D p
  have hψ : ContMDiff 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) 𝓘(ℝ) ∞ ψ := (hell.add hr).neg
  have hellp : ell p = 0 := hp
  have hGr : mgradient 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) r p = 0 := by
    apply mgradient_eq_zero_iff.mpr
    exact (mvfderiv_norm_sq_sub_subtypeVal_eq_zero_iff D (p : (EuclideanSpace ℝ (Fin (n + 1)))) p).mpr rfl
  have hgrad : mgradient 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) ψ p = -mgradient 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) ell p := by
    dsimp only [ψ]
    rw [mgradient_neg, mgradient_add (hell.mdifferentiable (by simp)) (hr.mdifferentiable (by simp))]
    simp only [Pi.add_apply, hGr, add_zero]
  obtain ⟨b, c, h, w, hb, hc, hgap, hpos, hnormal, hgradbound⟩ :=
    exists_strict_convexified_weight_bounds_at hψ hell hellp hgrad (ambientBoundaryGradient_ne_zero D p)
  have hbound := eventually_carleman_weight_bounds (contMDiff_ambientCarlemanWeight D p b) hpos hnormal hgradbound
  obtain ⟨U, hUbound, hU, hpU⟩ := mem_nhds_iff.mp hbound
  exact ⟨b, c, h, w, ⟨U, hU⟩, hpU, hb, hc, hgap, fun x hx => hUbound hx⟩
end Metric
end ConformalPoisson

