noncomputable section ProofPart_CauchyCutoffExtension





/- Local zero traces of the first jets suffice for an H2 zero
extension of a cutoff product. The artificial chart edge is removed
by the same actual cutoff in the value and all first derivatives. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti LineDeriv
open scoped ContDiff ENNReal InnerProductSpace Distributions Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω U : Opens E}
  {ι : Type*} [Fintype ι]

set_option maxHeartbeats 700000 in
without_proof_info in
theorem exists_H2_cutoff_zeroExtension_of_local_zeroTrace_firstJets
    (b : OrthonormalBasis ι ℝ E) (u : W1p μ Ω 2) (d : ι → W1p μ Ω 2)
    (hd : ∀ i, W1p.value (d i) =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient u x, b i⟫_ℝ)
    (hu0 : ∀ ψ : 𝓓(U, ℝ), ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    (hd0 : ∀ i, ∀ ψ : 𝓓(U, ℝ), ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value (d i) x)
    (χ : 𝓓(U, ℝ)) :
    ∃ W : Wkp μ ⊤ 2 2,
      Wkp.value 2 W =ᵐ[μ.restrict (⊤ : Opens E)]
        (Ω : Set E).indicator (fun x => χ x * W1p.value u x) ∧
      Wkp.firstOrder 1 W ∈ w1p0Submodule μ ⊤ 2 := by
  obtain ⟨N, hN, hχN, hgχN⟩ := exists_compact_smooth_multiplier_bound χ.contDiff χ.hasCompactSupport
  let v := W1p.contDiffSMul χ χ.contDiff hN (fun x _ => hχN x) (fun x _ => hgχN x) u
  have hv : W1p.value v =ᵐ[μ.restrict Ω] fun x => χ x * W1p.value u x := by
    dsimp only [v]
    filter_upwards [W1p.value_contDiffSMul_ae χ.contDiff hN
      (fun x _ => hχN x) (fun x _ => hgχN x) u] with x hx
    exact hx
  obtain ⟨v0, hv0⟩ := hu0 χ
  have hv0v : v0.val = v := by
    apply W1p.ext_value
    apply Lp.ext
    exact hv0.trans hv.symm
  have hgrad : W1p.gradient v0.val =ᵐ[μ.restrict Ω]
      fun x => χ x • W1p.gradient u x + W1p.value u x • ∇ (χ : E → ℝ) x := by
    rw [hv0v]
    exact W1p.gradient_contDiffSMul_ae χ.contDiff hN (fun x _ => hχN x) (fun x _ => hgχN x) u
  have hjets : ∀ i, ∃ z : W1p0 μ Ω 2, W1p.value z.val =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient v0.val x, b i⟫_ℝ := by
    intro i
    obtain ⟨a, ha⟩ := hd0 i χ
    obtain ⟨c, hc⟩ := hu0 (∂_{b i} χ)
    refine ⟨a + c, ?_⟩
    have hadd : W1p.value (a + c).val = W1p.value a.val + W1p.value c.val := by
      change W1p.value (a.val + c.val) = _
      rw [← W1p.valueL_apply, map_add, W1p.valueL_apply, W1p.valueL_apply]
    rw [hadd]
    filter_upwards [Lp.coeFn_add (W1p.value a.val) (W1p.value c.val), ha, hc, hd i, hgrad]
      with x haddx hax hcx hdx hgx
    rw [haddx, Pi.add_apply, hax, hcx, hdx, hgx]
    rw [inner_add_left, real_inner_smul_left, real_inner_smul_left]
    rw [TestFunction.lineDerivOp_apply_eq_fderiv, ← inner_gradient_left]
    ring
  choose z hz using hjets
  obtain ⟨W, hfirst, hW⟩ := exists_H2_zeroExtension_of_zeroTrace_firstJets b
    (le_top : Ω ≤ ⊤) v0 z hz
  refine ⟨W, ?_, ?_⟩
  · have hv0' := (ae_restrict_iff' Ω.isOpen.measurableSet).1 hv0
    filter_upwards [hW, ae_restrict_of_ae hv0'] with x hx hvx
    rw [hx]
    by_cases hxΩ : x ∈ (Ω : Set E)
    · rw [indicator_of_mem hxΩ, indicator_of_mem hxΩ, hvx hxΩ]
    · rw [indicator_of_notMem hxΩ, indicator_of_notMem hxΩ]
  · rw [hfirst]
    exact (W1p0.extendByZeroL le_top v0).property

set_option maxHeartbeats 700000 in
without_proof_info in
theorem exists_local_H2_zeroExtension_of_local_zeroTrace_firstJets
    (b : OrthonormalBasis ι ℝ E) (u : W1p μ Ω 2) (d : ι → W1p μ Ω 2)
    (hd : ∀ i, W1p.value (d i) =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient u x, b i⟫_ℝ)
    (hu0 : ∀ ψ : 𝓓(U, ℝ), ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    (hd0 : ∀ i, ∀ ψ : 𝓓(U, ℝ), ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value (d i) x)
    (χ : 𝓓(U, ℝ)) :
    ∃ W : Wkp μ U 2 2, W ∈ wkp0Submodule μ U 2 2 ∧
      Wkp.value 2 W =ᵐ[μ.restrict U]
        (Ω : Set E).indicator (fun x => χ x * W1p.value u x) := by
  obtain ⟨W, hW, _⟩ := exists_H2_cutoff_zeroExtension_of_local_zeroTrace_firstJets
    b u d hd hu0 hd0 χ
  have hWzero : ∀ᵐ x ∂μ.restrict (⊤ : Opens E), x ∉ tsupport χ → Wkp.value 2 W x = 0 := by
    filter_upwards [hW] with x hx hχx
    rw [hx]
    by_cases hxΩ : x ∈ (Ω : Set E)
    · rw [indicator_of_mem hxΩ, image_eq_zero_of_notMem_tsupport hχx, zero_mul]
    · rw [indicator_of_notMem hxΩ]
  obtain ⟨V, hV0, hV⟩ := exists_wkp0_localization_of_compact_support
    χ.hasCompactSupport χ.tsupport_subset 2 W hWzero
  exact ⟨V, hV0, hV.trans
    (ae_restrict_of_ae_restrict_of_subset (Set.subset_univ (U : Set E)) hW)⟩

end ConformalPoisson

end ProofPart_CauchyCutoffExtension

