    (x 0 * (β (boundaryFold x)) 0) • e

without_proof_info in
theorem normalFactorReflectedDrift_eq_of_nonneg (β : V → V)
    {x : V} (hx : 0 ≤ x 0) :
    normalFactorReflectedDrift β x =
      boundaryTangentialProjection (β x) + (x 0 * (β x) 0) • e := by
