without_proof_info in
@[simp] theorem domainRead_of_mem {X Y : Type*} [Zero Y] (s : Set X)
    (f : s → Y) {x : X} (hx : x ∈ s) : domainRead s f x = f ⟨x, hx⟩ := by
  classical
  simp [domainRead, hx]

without_proof_info in
@[simp] theorem domainRead_zero {X Y : Type*} [Zero Y] (s : Set X) :
    domainRead s (0 : s → Y) = 0 := by
  classical
  funext x
  simp [domainRead]

without_proof_info in
@[simp] theorem domainRead_add {X Y : Type*} [AddZeroClass Y] (s : Set X)
    (f g : s → Y) : domainRead s (f + g) = domainRead s f + domainRead s g := by
  classical
  funext x
  by_cases hx : x ∈ s <;> simp [domainRead, hx]

without_proof_info in
@[simp] theorem domainRead_smul {X Y : Type*} [AddCommGroup Y] [Module ℝ Y]
    (s : Set X) (c : ℝ) (f : s → Y) :
    domainRead s (c • f) = c • domainRead s f := by
  classical
  funext x
  by_cases hx : x ∈ s <;> simp [domainRead, hx]

without_proof_info in
theorem tendstoUniformlyOn_domainRead {X Y A : Type*} [Zero Y] [UniformSpace Y]
    {s t : Set X} (hts : t ⊆ s) {l : Filter A} {f : A → s → Y} {g : s → Y}
    (h : TendstoUniformly f g l) :
    TendstoUniformlyOn (fun a => domainRead s (f a)) (domainRead s g) l t := by
  rw [tendstoUniformlyOn_iff_tendstoUniformly_comp_coe]
  convert h.comp (fun x : t => ⟨x.val, hts x.property⟩) using 1
  · funext n x
    exact domainRead_of_mem s (f n) (hts x.property)
  · funext x
    exact domainRead_of_mem s g (hts x.property)

without_proof_info in
/-- The derivative constraint on the interior of a domain is closed for
uniformly converging value and derivative fields on the whole domain. -/
theorem isClosed_domainDerivativeGraph {E Y Z : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y]
    [NormedAddCommGroup Z] [NormedSpace ℝ Z]
    (s : Set E) {U : Set E} (hU : IsOpen U) (hUs : U ⊆ s)
    (L : Z → E →L[ℝ] Y) (hL : UniformContinuous L) :
    IsClosed {J : (s →ᵇ Y) × (s →ᵇ Z) | ∀ x ∈ U,
      HasFDerivAt (domainRead s J.1) (L (domainRead s J.2 x)) x} := by
  rw [← isSeqClosed_iff_isClosed]
  intro J j hJ hjlim x hx
  have hv := tendstoUniformlyOn_domainRead hUs
    (BoundedContinuousFunction.tendsto_iff_tendstoUniformly.mp
      ((continuous_fst.tendsto j).comp hjlim))
  have hd := tendstoUniformlyOn_domainRead hUs
    (BoundedContinuousFunction.tendsto_iff_tendstoUniformly.mp
      ((continuous_snd.tendsto j).comp hjlim))
  exact hasFDerivAt_of_tendstoUniformlyOn hU (hL.comp_tendstoUniformlyOn hd)
    (fun n y hy => hJ n y hy) (fun y hy => hv.tendsto_at hy) hx

end ConformalPoisson.DirichletHolder

end ProofPart_ClosedDomainDerivativeGraph

