/- Proof support: MaximalExtensionCaller.lean, SHA256 f2a77261ceb3fd123cee1c8b0e513da9b3dd407b38b18f28612a291ed46a8c5d -/
noncomputable section ProofPart_MaximalExtensionCaller


/- Checked conditional consumer of the missing local continuation
producer. The local extension hypothesis is a PROJECT obligation to be
discharged from compactness, no-escape and analytic quotient continuation. -/
open Set
namespace ConformalPoisson
variable {D X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
  {u : D → X → ℝ} {v : D → Y → ℝ} {I : Set X} {T : Set Y} {B₀ : Set X}

without_proof_info in
theorem OpenScaledExtension.domain_eq_of_local_extension
    (A : OpenScaledExtension u v I T B₀)
    (hmax : ∀ B : OpenScaledExtension u v I T B₀, B.domain ≤ A.domain)
    (hI : IsPreconnected I)
    (hlocal : ∀ x ∈ closure (A.domain : Set X), x ∈ I →
      ∃ B : OpenScaledExtension u v I T B₀, x ∈ B.domain) :
    (A.domain : Set X) = I := by
  apply Subset.antisymm A.inside
  obtain ⟨x₀, hx₀⟩ := A.connected.nonempty
  apply hI.subset_of_closure_inter_subset A.domain.isOpen ⟨x₀, A.inside hx₀, hx₀⟩
  intro x hx
  obtain ⟨B, hxB⟩ := hlocal x hx.1 hx.2
  exact hmax B hxB

without_proof_info in
theorem exists_global_scaled_relation_of_local_extensions
    (hsep : SeparatesPointAndScale (fun f (y : T) => v f y))
    (hB₀ : B₀.Nonempty) (A₀ : OpenScaledExtension u v I T B₀) (hI : IsPreconnected I)
    (hlocal : ∀ A : OpenScaledExtension u v I T B₀,
      (∀ B : OpenScaledExtension u v I T B₀, B.domain ≤ A.domain) →
      ∀ x ∈ closure (A.domain : Set X), x ∈ I →
        ∃ B : OpenScaledExtension u v I T B₀, x ∈ B.domain) :
    ∃ A : OpenScaledExtension u v I T B₀, (A.domain : Set X) = I := by
  obtain ⟨A, hmax⟩ := exists_largest_openScaledExtension hsep hB₀ A₀
  exact ⟨A, A.domain_eq_of_local_extension hmax hI (hlocal A hmax)⟩
end ConformalPoisson

end ProofPart_MaximalExtensionCaller

