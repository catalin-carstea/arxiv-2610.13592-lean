    (G := (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ))
    ((h1.differentiableWithinAt (by simp)).hasFDerivWithinAt.prodMk
      (G := E →L[ℝ] E →L[ℝ] ℝ)
      (h2.differentiableWithinAt (by simp)).hasFDerivWithinAt)).fderivWithin (hs y hy)
