    have hfun : (-1 : ℝ) • boundaryPoissonSection ν G.kernel y =
        (fun x => normalDerivative ν (fun z => G.kernel x z) y) := by
      funext x
      change -1 * (-normalDerivative ν (fun z => G.kernel x z) y) = _
      ring
