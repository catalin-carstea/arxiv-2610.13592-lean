theorem rawComponent_homogeneous (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    (r : ℕ) : Homogeneous S (1 - (r : ℤ)) (rawComponent F r) := by
  have hκ2 : Homogeneous S 1 (fun ξ z => Complex.ofReal (2 * F.principal ξ z)) := by
    simpa only [Complex.ofReal_mul, Complex.ofReal_ofNat] using
      homogeneous_const_mul (principal_homogeneous F) (2 : ℂ)
  have hinv := homogeneous_inv hκ2
  have hE := homogeneous_coefficient (S := S) (fun z => Complex.ofReal (F.tau z / 2))
  induction r using Nat.strong_induction_on with
  | ind r ih =>
    cases r with
    | zero =>
      rw [rawComponent_zero]
      simpa only [Nat.cast_zero, sub_zero, neg_one_mul] using
        homogeneous_const_mul (principal_homogeneous F) (-1 : ℂ)
    | succ r =>
      have hb : ∀ p ≤ r, Homogeneous S (1 - (p : ℤ)) (rawComponent F p) :=
        fun p hp => ih p (Nat.lt_succ_of_le hp)
      have hN : Homogeneous S (1 - (r : ℤ)) (fun ξ z => normalDeriv (rawComponent F r ξ) z) :=
        modelDeriv_homogeneous (hb r le_rfl) (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1))
      have hEb : Homogeneous S (1 - (r : ℤ))
          (fun ξ z => Complex.ofReal (F.tau z / 2) * rawComponent F r ξ z) := by
        simpa only [zero_add] using homogeneous_mul hE (hb r le_rfl)
      have hR := remainder_homogeneous (rawComponent F) r
        (fun p _ => rawComponent_analytic F hG hA p) hb
      have hQ : Homogeneous S (1 - (r : ℤ))
          (fun ξ z => if r = 0 then F.firstOrderSymbol ξ z else 0) := by
        by_cases hr : r = 0
        · subst r
          simpa using firstOrder_homogeneous F
        · simpa only [ite_eq_right hr] using homogeneous_zero (n := n) (S := S) (1 - (r : ℤ))
      have hnum := homogeneous_sub (homogeneous_add (homogeneous_sub hN hEb) hR) hQ
      rw [rawComponent_succ]
      have h := homogeneous_mul hinv hnum
      have hdeg : -(1 : ℤ) + (1 - (r : ℤ)) = 1 - ((r + 1 : ℕ) : ℤ) := by omega
      rwa [hdeg] at h

def rawFamily (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S) :
    NormalMetricField.RawSymbolFamily F where
  component := rawComponent F
  smooth r := (rawComponent_analytic F hG hA r).of_le le_top
  homogeneous r z hz ξ hξ t ht := by
    simpa only [Complex.real_smul, Complex.ofReal_zpow] using
      rawComponent_homogeneous F hG hA r z hz ξ hξ t ht
  principal ξ hξ z hz := by
    rw [rawComponent_zero]
    simp only [Pi.smul_apply, Function.comp_apply, neg_one_smul]
  recurrence r ξ hξ z hz := rawComponent_recurrence F r hξ hz


def restrictFamily (F : NormalMetricField S) (B : NormalMetricField.RawSymbolFamily F)
    (U : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))) (hU : U ≤ S) :
    NormalMetricField.RawSymbolFamily (F.restrict U hU) where
  component := B.component
  smooth r := (B.smooth r).mono (Set.prod_mono hU (Subset.refl _))
  homogeneous r z hz ξ hξ t ht := B.homogeneous r z (hU hz) ξ hξ t ht
  principal ξ hξ _z hz := B.principal ξ hξ (hU hz)
  recurrence r ξ hξ z hz := B.recurrence r ξ hξ z (hU hz)

