theorem norm_mixedDerivativeWithin_tangent_direction_le
    {S : Set E} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) {x : E} (hx : x ∈ S)
    (P : E →L[ℝ] E) (e v : E) (hv : P v = v) (p q : ℕ) :
    ‖mixedDerivativeWithin S P e p q (fun y => fderivWithin ℝ f S y v) x‖ ≤
      ‖mixedDerivativeWithin S P e (p + 1) q f x‖ * ‖v‖ := by
  apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (norm_nonneg _) (norm_nonneg _))
  intro m
