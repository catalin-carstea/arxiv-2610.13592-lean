  have hSH : S ⊆ (normalHalfSpace (E := E) a : Set P) := by
    intro x hx
    have hxR : x ∈ (Ω : Set P) ∩ ball x₀ R := ⟨hx.1, ball_subset_ball (by linarith) hx.2⟩
