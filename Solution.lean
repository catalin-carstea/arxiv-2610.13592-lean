/- A native homogeneous value-exponent gain on actual boundary chart
caps. All coefficients, trace data and constants come from the native
metric and signed potential; constants precede the smooth solution. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem splitBoundaryChartCap_inter_smaller_ball (c : M) {r R : ℝ} (hrR : r ≤ R) :
    (splitBoundaryChartCap (n := n) c R : Set P) ∩
      ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) r =
        (splitBoundaryChartCap (n := n) c r : Set P) := by
  rw [splitBoundaryChartCap_eq, splitBoundaryChartCap_eq]
  ext z
  constructor
  · rintro ⟨⟨_, hH⟩, hr⟩
    exact ⟨hr, hH⟩
  · rintro ⟨hr, hH⟩
    exact ⟨⟨ball_subset_ball hrR hr, hH⟩, hr⟩

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_native_halfBall_value_exponent_gain_below
    (a b : ℝ≥0) [Fact (1 ≤ (a : ℝ≥0∞))] (ha : 1 < (a : ℝ≥0∞)) (hab : a ≤ b)
    (hgap : 1 / (a : ℝ) - 1 / (b : ℝ) < 1 / (Module.finrank ℝ P : ℝ))
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : Continuous q)
    (c : M) (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ R₀ > 0, R₀ ≤ rMax ∧
      (closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∀ R : ℝ, 0 < R → R ≤ R₀ →
      ∃ C ≥ 0, ∀ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ u →
      (∀ x, (𝓡∂ (n + 1)).IsBoundaryPoint x → u x = 0) →
      (∀ z ∈ (splitBoundaryChartCap (n := n) c R : Set P),
        schrodinger g q u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) = 0) →
      MemLp (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (b : ℝ≥0∞)
        (volume.restrict (splitBoundaryChartCap (n := n) c (R / 4) : Set P)) ∧
      lpNorm (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (b : ℝ≥0∞)
        (volume.restrict (splitBoundaryChartCap (n := n) c (R / 4) : Set P)) ≤
      C * lpNorm (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (a : ℝ≥0∞)
        (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) := by
  obtain ⟨R₀, hR₀, hRMax, htarget, hH⟩ := exists_native_halfBall_homogeneous_bound_below
    ha ENNReal.coe_ne_top g q hq c rMax hMax
  refine ⟨R₀, hR₀, hRMax, htarget, fun R hR hRR₀ => ?_⟩
  obtain ⟨D, hD, hDall⟩ := hH R hR hRR₀
  obtain ⟨C, hC, hgain⟩ := exists_halfBall_value_exponent_gain (E := EuclideanSpace ℝ (Fin n)) a b hab (by simpa only [one_div] using hgap) 0
    (splitBoundaryChartCap (n := n) c R)
    ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) R hR
    (splitBoundaryChartCap_inter_ball c R) D hD
  refine ⟨C, hC, fun u hu hu0 hLu => ?_⟩
  obtain ⟨U, hU, hzero, hHess⟩ := hDall u hu hu0 hLu
  obtain ⟨hmem, hnorm⟩ := hgain U hzero hHess
  rw [splitBoundaryChartCap_inter_smaller_ball c (by linarith : R / 4 ≤ R)] at hmem hnorm
  rw [splitBoundaryChartCap_inter_smaller_ball c le_rfl] at hnorm
  have hUinner : Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c (R / 4) : Set P)]
      fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) :=
    ae_restrict_of_ae_restrict_of_subset (splitBoundaryChartCap_mono c (by linarith : R / 4 ≤ R)) hU
  refine ⟨(memLp_congr_ae hUinner).mp hmem, ?_⟩
  rw [lpNorm_congr_ae hUinner, lpNorm_congr_ae hU] at hnorm
  exact hnorm

end ConformalPoisson

