without_proof_info in
theorem lp_norm_sq_le_ball_rpow {z : V} {r K : ℝ} {α : ℝ≥0}
    (hr : 0 < r) (_hK : 0 ≤ K) (G : Lp V 2 (volume.restrict (ball z r)))
    (hbound : ∀ᵐ x ∂volume.restrict (ball z r), ‖G x‖ ≤ K * r ^ (α : ℝ)) :
    ‖G‖ ^ 2 ≤ (volume.real (ball (0 : V) 1) * K ^ 2) *
      r ^ (((n : ℝ) + 1) + 2 * α) := by
  let : IsFiniteMeasure (volume.restrict (ball z r)) := isFiniteMeasure_restrict.2 measure_ball_lt_top.ne
  rw [← Lp.integral_norm_sq_eq_norm_sq]
  have hpow : (r ^ (α : ℝ)) ^ 2 = r ^ (2 * (α : ℝ)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hr.le]
    congr 1
    ring
  calc
    (∫ x, ‖G x‖ ^ 2 ∂volume.restrict (ball z r)) ≤
        ∫ _x : V, (K * r ^ (α : ℝ)) ^ 2 ∂volume.restrict (ball z r) :=
      integral_mono_ae ((Lp.memLp G).integrable_norm_pow two_ne_zero) (integrable_const _)
        (hbound.mono fun x hx => pow_le_pow_left₀ (norm_nonneg _) hx 2)
    _ = volume.real (ball z r) * (K * r ^ (α : ℝ)) ^ 2 := by
      rw [integral_const, smul_eq_mul, measureReal_restrict_apply_univ]
    _ = _ := by
      rw [Measure.addHaar_real_ball_of_pos _ z hr, finrank_euclideanSpace_fin,
        mul_pow, hpow, Real.rpow_add hr]
      rw [show (n : ℝ) + 1 = ((n + 1 : ℕ) : ℝ) by push_cast; rfl, Real.rpow_natCast]
      ring

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_holderOnWith_gradient_of_local_reference_error {Ω : Opens V}
    (u : W1p volume Ω 2) {S : Set V} {α : ℝ≥0} {R K : ℝ}
    (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R) (hK : 0 ≤ K) (hS : thickening R S ⊆ Ω)
    (href : ∀ z ∈ S, ∀ r, 0 < r → r ≤ R →
      ∀ hB : (⟨ball z r, isOpen_ball⟩ : Opens V) ≤ Ω,
        ∃ G C : Lp V 2 (volume.restrict (ball z r)),
          (∀ v : W1p0 volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2,
            energyFormH1 (fun _ => 1) 0 0 (W1p.restrictL hB u)
              (v : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2) =
                ⟪G, W1p.gradient (v : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2)⟫_ℝ) ∧
          SobolevDivergenceFree ⟨ball z r, isOpen_ball⟩ C ∧
          (∀ᵐ x ∂volume.restrict (ball z r), ‖G x - C x‖ ≤ K * r ^ (α : ℝ))) :
    ∃ L : ℝ≥0, HolderOnWith L α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient u : V → V)) S := by
  apply exists_holderOnWith_gradient_of_local_residuals u hα hαlt hR
    (M := volume.real (ball (0 : V) 1) * K ^ 2) (by positivity) hS
  intro z hz r hr hrR hB
  obtain ⟨G, C, hG, hC, herr⟩ := href z hz r hr hrR hB
  refine ⟨G - C, ?_, lp_norm_sq_le_ball_rpow hr hK (G - C) ?_⟩
  · intro v
    rw [inner_sub_left, hC v, sub_zero]
    exact hG v
  · filter_upwards [Lp.coeFn_sub G C, herr] with x hx herrx
    simpa only [hx, Pi.sub_apply] using herrx
end ConformalPoisson.Campanato

