    change closure (ball z 2) ⊆ ball z 3
    rw [closure_ball z (by norm_num : (2 : ℝ) ≠ 0)]
    exact closedBall_subset_ball (by norm_num)
  have hfix : hyperplaneReflection (firstCoordinateNormal n) 0 z = z := by
    apply hyperplaneReflection_eq_self_of_inner_eq
    simpa [firstCoordinateNormal, EuclideanSpace.inner_single_right] using hz
