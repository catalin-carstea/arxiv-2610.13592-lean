  intro x hx
  apply ((Ihalf).isInteriorPoint_iff_of_mem_atlas (n := ω) (by decide)
    (chart_mem_atlas (EuclideanHalfSpace (n + 1)) c)
    (by simpa only [extChartAt_source] using hx.1)).mpr
  change extChartAt Ihalf c x ∈ interior (extChartAt Ihalf c).target
  apply interior_mono hΩt
  rw [Ω.isOpen.interior_eq]
  exact hx.2

