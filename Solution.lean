        schrodinger g q u ((extChartAt Ihalf c).symm z) ∂(Module.finBasis ℝ V).addHaar) = u x := by
  have hF := (subset_tsupport (schrodinger g q u)).trans
    ((tsupport_schrodinger_subset g q u hu).trans hsupp)
  exact (integral_native_row_mul_eq_chart g c hΩ hΩt (K.row x) (schrodinger g q u) hF).symm.trans
    (K.weak_equation hq x u hu hu0).2

