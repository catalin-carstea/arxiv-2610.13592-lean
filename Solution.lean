/- Exact coordinate transposition moments of the actual native inverse rows.
The metric density is retained explicitly; coordinate Haar measure is not
silently identified with native volume. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff ENNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
