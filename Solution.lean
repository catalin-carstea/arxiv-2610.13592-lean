without_proof_info in
theorem principalTerm_regular {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U) (l : ℕ) {P : Y → ℂ[X]} (hP : CoeffContDiffOn P U) :
    CoeffContDiffOn (B.principalTerm l P) U := by
