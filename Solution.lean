noncomputable section ProofPart_DNSymbol_DNActualCoefficientTaylor


/- Assignment268, /root. The SAME actual native coefficients obey uniform
finite normal Taylor bounds on the previously chosen common physical collar. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Metric Filter Topology Finset TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

def nativeNormalTaylor (f : H → E) (y : Y) (N : ℕ) (t : ℝ) : E :=
  ∑ l ∈ range (N + 1), (t ^ l / (l.factorial : ℝ)) • normalJet l f (EuclideanHalfSpace.boundaryParam n y)

without_proof_info in
theorem exists_native_normal_taylor_bound
    {O : Set (Y × ℝ)} {f : H → E} {G : Y × ℝ → E}
    (hread : ∀ z, f z = G (nativeNormalCoordinates z)) (hG : AnalyticOnNhd ℝ G O)
    {K : Set Y} (hK : IsCompact K) {r : ℝ} (hr : 0 < r)
    (hrect : K ×ˢ Icc (0 : ℝ) r ⊆ O) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : H,
      (nativeNormalCoordinates z).1 ∈ K → (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) r →
      ‖f z - nativeNormalTaylor f (nativeNormalCoordinates z).1 N (nativeNormalCoordinates z).2‖ ≤
        C * (nativeNormalCoordinates z).2 ^ (N + 1) := by
  obtain ⟨C, hC, hb⟩ := exists_uniform_normal_taylor_bound hG hK hr hrect N
  refine ⟨C, hC, ?_⟩
  intro z hz ht
  have hface := hG ((nativeNormalCoordinates z).1, 0) (hrect ⟨hz, le_rfl, hr.le⟩)
  have hj (l : ℕ) := normalJet_of_product_representative hread (nativeNormalCoordinates z).1 hface l
  rw [hread z]
  simpa only [nativeNormalTaylor, hj] using hb (nativeNormalCoordinates z).1 hz (nativeNormalCoordinates z).2 ht

namespace NativeLayerCollar

without_proof_info in
theorem positive_cylinder_subset {S : TopologicalSpace.Opens H} {F₁ F₂ : NormalMetricField S} {y : Y}
    (R : NativeLayerCollar F₁ F₂ y) :
    R.cutoff.supportCap ×ˢ Icc (0 : ℝ) R.cutoff.normalCutoff.rOut ⊆ R.domain := by
  intro x hx
  apply R.cutoff.support_cylinder_subset
  refine ⟨hx.1, ?_⟩
  rw [R.cutoff.normalCutoff.tsupport_eq]
  simpa only [mem_closedBall, Real.dist_eq, sub_zero, abs_of_nonneg hx.2.1] using hx.2.2

without_proof_info in
theorem coefficientTaylorBounds {S : TopologicalSpace.Opens H} {F₁ F₂ : NormalMetricField S} {y : Y}
    (R : NativeLayerCollar F₁ F₂ y) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : H,
      (nativeNormalCoordinates z).1 ∈ R.cutoff.supportCap →
      (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) R.cutoff.normalCutoff.rOut →
      ‖normalCoefficientBundle F₁ z - nativeNormalTaylor (normalCoefficientBundle F₁)
        (nativeNormalCoordinates z).1 N (nativeNormalCoordinates z).2‖ ≤ C * (nativeNormalCoordinates z).2 ^ (N + 1) ∧
      ‖normalCoefficientBundle F₂ z - nativeNormalTaylor (normalCoefficientBundle F₂)
        (nativeNormalCoordinates z).1 N (nativeNormalCoordinates z).2‖ ≤ C * (nativeNormalCoordinates z).2 ^ (N + 1) := by
  obtain ⟨C₁, hC₁, hb₁⟩ := exists_native_normal_taylor_bound R.read₁ R.analytic₁
    R.cutoff.isCompact_supportCap R.cutoff.normalCutoff.rOut_pos R.positive_cylinder_subset N
  obtain ⟨C₂, hC₂, hb₂⟩ := exists_native_normal_taylor_bound R.read₂ R.analytic₂
    R.cutoff.isCompact_supportCap R.cutoff.normalCutoff.rOut_pos R.positive_cylinder_subset N
  refine ⟨max C₁ C₂, hC₁.trans (le_max_left _ _), ?_⟩
  intro z hz ht
  exact ⟨(hb₁ z hz ht).trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (pow_nonneg ht.1 _)),
    (hb₂ z hz ht).trans (mul_le_mul_of_nonneg_right (le_max_right _ _) (pow_nonneg ht.1 _))⟩

end NativeLayerCollar
end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNActualCoefficientTaylor

