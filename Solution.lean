local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem native_interior_compact_integral_derivative {U : Set M} (hU : IsOpen U)
    {F : M → Y → ℝ}
    (hF : ContMDiffOn ((𝓡∂ (n + 1)).prod J) 𝓘(ℝ) ∞ (uncurry F) (U ×ˢ univ))
    {u : M → ℝ} (hu : ContMDiffOn Ihalf 𝓘(ℝ) ∞ u U)
    (heq : ∀ z ∈ U, u z = ∫ y, F z y ∂μ)
    {x : M} (hx : x ∈ U) (hxi : x ∈ (Ihalf).interior M)
    (v : TangentSpace Ihalf x) :
    Integrable (fun y => mvfderiv Ihalf (fun z => F z y) x v) μ ∧
    mvfderiv Ihalf u x v = ∫ y, mvfderiv Ihalf (fun z => F z y) x v ∂μ := by
  let c := extChartAt Ihalf x
  let z₀ := c x
  have hxsrc : x ∈ c.source := mem_extChartAt_source x
  have hz : z₀ ∈ interior c.target := ModelWithCorners.isInteriorPoint_iff.mp hxi
  have hround : c.symm z₀ = x := c.left_inv hxsrc
  have hcinv : ContinuousAt c.symm z₀ :=
    (continuousOn_extChartAt_symm x z₀ (interior_subset hz)).continuousAt
      (mem_of_superset (isOpen_interior.mem_nhds hz) interior_subset)
  have hn : interior c.target ∩ c.symm ⁻¹' U ∈ 𝓝 z₀ :=
    inter_mem (isOpen_interior.mem_nhds hz)
      (hcinv.preimage_mem_nhds (by simpa only [hround] using hU.mem_nhds hx))
  obtain ⟨ε, hε, hεsub⟩ := Metric.mem_nhds_iff.mp hn
