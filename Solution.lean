  have hsol := S.correct f hf
  have hact := H.normalDerivative hz hz0 ν hν (S.solve f)
    (hsol.1.mdifferentiable (by decide : (∞ : ℕ∞ω) ≠ 0) (χ z))
  have happ := H.normalDerivative hz hz0 ν hν U
    (hU.mdifferentiable (by decide : (∞ : ℕ∞ω) ≠ 0) (χ z))
  change normalDerivative ν (S.solve f) y = -normalDeriv (S.solve f ∘ χ) z at hact
  change normalDerivative ν U y = -normalDeriv (U ∘ χ) z at happ
  rw [hact, happ] at h
  simpa only [neg_sub_neg, abs_sub_comm] using h

