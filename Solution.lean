  unfold polynomialPrimitive
  rw [Polynomial.sum, derivative_sum]
  simp_rw [derivative_monomial, Nat.add_sub_cancel_right]
  have h (j : ℕ) : (j + 1 : ℂ) ≠ 0 := by exact_mod_cast (Nat.succ_ne_zero j)
