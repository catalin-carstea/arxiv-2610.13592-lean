/- Checked conditional downstream caller for the remaining Green calculus
producer. No Runge-derived exact-jet or separation result is imported. -/
open Set Filter MeasureTheory
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenJetCallerBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local instance greenJetCallerBoundaryAnalytic : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M) :=
  TauCeti.isManifold_boundary (n := n) (k := ω) M (by decide)

without_proof_info in
theorem normal_zero_of_supported_moments
    (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (H : M → ℝ)
    (hH : ∀ y ∈ Γ, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ H (y : M))
    (hzero : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      (∫ y, normalDerivative ν H y * f.val y ∂nativeSurfaceMeasure g) = 0) :
    ∀ y ∈ Γ, normalDerivative ν H y = 0 := by
  let := nativeSurfaceMeasure_isLocallyFiniteMeasure g
  let := nativeSurfaceMeasure_isOpenPosMeasure g
  have hcont : ContinuousOn (normalDerivative ν H) (Γ : Set _) :=
    fun y hy => (continuousAt_normalDerivative g ν hν H y (hH y hy)).continuousWithinAt
  have hae : ∀ᵐ y ∂nativeSurfaceMeasure g, y ∈ Γ → normalDerivative ν H y = 0 := by
    apply Γ.isOpen.ae_eq_zero_of_integral_contMDiff_smul_eq_zero (𝓡 n)
      (hcont.locallyIntegrableOn Γ.isOpen.measurableSet)
    intro f hf hsupp hsub
    simpa only [smul_eq_mul, mul_comm] using hzero ⟨f, hf, hsupp, hsub⟩
  exact Measure.eqOn_open_of_ae_eq ((ae_restrict_iff' Γ.isOpen.measurableSet).mpr hae)
    Γ.isOpen hcont continuousOn_const

without_proof_info in
theorem exists_datum_with_local_jets_of_green_calculus
    (hReg : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (A : AnalyticProblem (n := n) (M := M)) (hdim : 2 ≤ n)
    (hconnected : IsPreconnected ((𝓡∂ (n + 1)).interior M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal A.smoothMetric y (ν y))
    (S : DirichletSolver A.smoothMetric A.potential)
    (G : DirichletGreenKernel A.smoothMetric A.potential ν S)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (U : Fin N → TopologicalSpace.Opens M) (hpointU : ∀ i, points i ∈ U i)
    (hU : ∀ i, (U i : Set M) ⊆ (𝓡∂ (n + 1)).interior M)
    (v : Fin N → M → ℝ)
    (hv : ∀ i, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (v i) (U i))
    (hLv : ∀ i, ∀ x ∈ U i, schrodinger A.smoothMetric A.potential (v i) x = 0)
    (hCalc : GreenJetCalculus A.smoothMetric A.potential ν S G points) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∀ i, secondJet A.smoothMetric (S.solve f.val) (points i) =
        secondJet A.smoothMetric (v i) (points i) := by
  apply exists_datum_with_jets_of_annihilator A.smoothMetric A.potential S A.nonresonant Γ points v
  intro ℓ hℓ
  let H := greenJetSection A.smoothMetric points ℓ G.kernel
  have hP : (range points).Finite := finite_range points
  have hPI : range points ⊆ (𝓡∂ (n + 1)).interior M := by
    rintro x ⟨i, rfl⟩
    exact hpoints i
  have hboundary (y : (𝓡∂ (n + 1)).boundary M) : (y : M) ∉ range points := by
    intro h
    exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary (hPI h) y.property
  have hnormal : ∀ y ∈ Γ, normalDerivative ν H y = 0 := by
    apply normal_zero_of_supported_moments A.smoothMetric ν hν Γ H
      (fun y _ => (hCalc.smooth ℓ y (hboundary y)).contMDiffAt
        (hP.isClosed.isOpen_compl.mem_nhds (hboundary y)))
    intro f
    have heq := (hCalc.normal_moment ℓ Γ f).2
    have hz := hℓ f
    rw [hz] at heq
    exact neg_eq_zero.mp heq.symm
  have hglobal : EqOn H 0 ((𝓡∂ (n + 1)).interior M \ range points) :=
    analytic_zero_off_finite_poles hReg A hdim hconnected ν hν
