/- Two constructed global candidates are actual inverse maps and have
reciprocal multipliers, by separation of the SAME original solution family. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

set_option maxHeartbeats 800000 in
without_proof_info in
theorem native_global_candidates_are_inverse
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁} {T₀ : Set M₂}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (B : OpenScaledExtension
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) => D.symm.solver₁.solve g.val)
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) =>
        D.symm.solver₂.solve (g.val ∘ D.symm.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₂) ((𝓡∂ (n + 1)).interior M₁) T₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
    (hB : (B.domain : Set M₂) = (𝓡∂ (n + 1)).interior M₂) :
    (∀ z ∈ (𝓡∂ (n + 1)).interior M₁,
      B.map (A.map z) = z ∧ A.multiplier z * B.multiplier (A.map z) = 1) ∧
    (∀ z ∈ (𝓡∂ (n + 1)).interior M₂,
      A.map (B.map z) = z ∧ B.multiplier z * A.multiplier (B.map z) = 1) := by
  let Γ₁ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₁) :=
    ⟨observedPatch (n := n) V₁, V₁.isOpen.preimage continuous_subtype_val⟩
  have hsep₁ := separatesPointAndScale_interior hSchauder (hRunge₁ A₁) hn hcompact₁ hconnected₁ (A₁.analytic_potential.of_le (by decide)) A₁.nonresonant
    D.solver₁ Γ₁ D.patch_nonempty
  have hsep₂ := D.separates_target_original_family hSchauder hRunge₂ hn hcompact₂ hconnected₂
  have hforward : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ (𝓡∂ (n + 1)).interior M₁,
      D.solver₁.solve f.val z = A.multiplier z *
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (A.map z) := by
    intro f z hz
    exact A.solutions f z (by change z ∈ (A.domain : Set M₁); rw [hA]; exact hz)
  have hrev := D.reverse_relation_on_original_data B.domain B.map B.multiplier B.solutions
  have hback : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ (𝓡∂ (n + 1)).interior M₂,
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) z = B.multiplier z * D.solver₁.solve f.val (B.map z) := by
    intro f z hz
    exact hrev f z (by change z ∈ (B.domain : Set M₂); rw [hB]; exact hz)
  exact inverse_maps_of_mutual_scaled_relations hsep₁ hsep₂ A.map B.map A.multiplier B.multiplier
    (fun z hz => A.image (by change z ∈ (A.domain : Set M₁); rw [hA]; exact hz))
    (fun z hz => B.image (by change z ∈ (B.domain : Set M₂); rw [hB]; exact hz))
    (fun z hz => A.positive z (by change z ∈ (A.domain : Set M₁); rw [hA]; exact hz))
    (fun z hz => B.positive z (by change z ∈ (B.domain : Set M₂); rw [hB]; exact hz)) hforward hback
end ConformalPoisson

end ProofPart_NativeMutualInverse

