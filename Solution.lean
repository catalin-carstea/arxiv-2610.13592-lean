set_option maxHeartbeats 1200000 in
without_proof_info in
theorem NativeMetricAmbientExtension.inverseChart_isometry
    (R : NativeMetricAmbientExtension g α) (O : TopologicalSpace.Opens R.domain)
    (hO : ∀ x : O, ((x : R.domain) : EuclideanSpace ℝ (Fin (n + 1))) ∈
      interior (extChartAt (𝓡∂ (n + 1)) α).target) :
    letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩;
    letI : RiemannianBundle (fun x : O =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x) :=
      ⟨(R.metric.restrictOpenTangentSpace O).toRiemannianMetric⟩;
    IsLocalRiemannianIsometry 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1))
      (fun x : O => (extChartAt (𝓡∂ (n + 1)) α).symm
        ((x : R.domain) : EuclideanSpace ℝ (Fin (n + 1)))) := by
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : RiemannianBundle (fun x : O =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x) :=
    ⟨(R.metric.restrictOpenTangentSpace O).toRiemannianMetric⟩
  let inc := fun x : O => ((x : R.domain) : EuclideanSpace ℝ (Fin (n + 1)))
  have hinc : ContMDiff 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
      𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ∞ inc :=
    contMDiff_subtype_val.comp contMDiff_subtype_val
  have hinv (x : O) : ContMDiffAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1)) ∞
      (extChartAt (𝓡∂ (n + 1)) α).symm (inc x) :=
    ((contMDiffOn_extChartAt_symm (I := 𝓡∂ (n + 1)) (n := ω) α)
      (inc x) (interior_subset (hO x))).contMDiffAt
        (Filter.mem_of_superset (isOpen_interior.mem_nhds (hO x)) interior_subset) |>.of_le (by decide)
  have hincD (x : O) : mfderiv 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
      𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) inc x =
      (tangentSpaceOpenEquiv (x : R.domain)).toContinuousLinearMap.comp
        (tangentSpaceOpenEquiv x).toContinuousLinearMap := by
    have hd₁ : MDifferentiableAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
        𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
        (Subtype.val : R.domain → EuclideanSpace ℝ (Fin (n + 1))) (x : R.domain) :=
      contMDiff_subtype_val.mdifferentiableAt (by decide : (∞ : ℕ∞ω) ≠ 0)
    have hd₂ : MDifferentiableAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
        𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (Subtype.val : O → R.domain) x :=
      contMDiff_subtype_val.mdifferentiableAt (by decide : (∞ : ℕ∞ω) ≠ 0)
    have hh := mfderiv_comp x hd₁ hd₂
    simpa only [inc, Function.comp_def, mfderiv_subtype_val] using hh
  have hJd (x : O) : mfderiv 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1))
      (fun x : O => (extChartAt (𝓡∂ (n + 1)) α).symm (inc x)) x =
      (mfderiv 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1))
        (extChartAt (𝓡∂ (n + 1)) α).symm (inc x)).comp
          ((tangentSpaceOpenEquiv (x : R.domain)).toContinuousLinearMap.comp
            (tangentSpaceOpenEquiv x).toContinuousLinearMap) := by
    have hh := mfderiv_comp x ((hinv x).mdifferentiableAt (by decide))
      (hinc.mdifferentiableAt (by decide))
    rw [hincD] at hh
    exact hh
  refine ⟨(fun x => (hinv x).comp x hinc.contMDiffAt), ?_, ?_⟩
  · intro x
    rw [hJd]
    have hx : inc x ∈ (extChartPartialDiffeomorph (𝓡∂ (n + 1)) ∞ α).symm.source := by
      change inc x ∈ (extChartPartialDiffeomorph (𝓡∂ (n + 1)) ∞ α).target
      rw [extChartPartialDiffeomorph_target]
      exact hO x
    have hi := (PartialDiffeomorph.isLocalDiffeomorphAt
      𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1)) ∞
      (extChartPartialDiffeomorph (𝓡∂ (n + 1)) ∞ α).symm hx).isInvertible_mfderiv (by decide)
    have he : ⇑(extChartPartialDiffeomorph (𝓡∂ (n + 1)) ∞ α).symm =
        (extChartAt (𝓡∂ (n + 1)) α).symm :=
      funext (extChartPartialDiffeomorph_symm_apply (𝓡∂ (n + 1)) ∞ α)
    rw [he] at hi
    exact hi.comp (ContinuousLinearMap.IsInvertible.comp
      ⟨tangentSpaceOpenEquiv (x : R.domain), rfl⟩ ⟨tangentSpaceOpenEquiv x, rfl⟩)
  · intro x v w
    rw [Bundle.ContMDiffRiemannianMetric.inner_riemannianBundle g,
      Bundle.ContMDiffRiemannianMetric.inner_riemannianBundle (R.metric.restrictOpenTangentSpace O),
      R.metric.restrictOpenTangentSpace_inner O, hJd]
    dsimp only [inc, ContinuousLinearMap.comp_apply]
    rw [mfderiv_inverseChart_of_interior α (hO x), mfderiv_inverseChart_of_interior α (hO x)]
    exact (R.inner_agrees (x : R.domain) (interior_subset (hO x)) _ _).symm

end ConformalPoisson

