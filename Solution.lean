        laplaceBeltrami 𝓘(ℝ, V) F (R.normalCoordinateMap A z) :=
    R.normalCoordinateMap_laplaceBeltrami A F z hF
  rw [coordinateSchrodinger_ambient_restriction_at (R.normalCoordinateDomain A) p z Qnormal hcoord,
    hLap, R.inverseChart_laplaceBeltrami (R.normalCoordinateMap A z) hz u hu, hQ]
