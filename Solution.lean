    simpa only [extChartAt_source] using (extChartAt I α).map_target (interior_subset hz)
  have hfn := hf.contMDiffAt ((chartAt H α).open_source.mem_nhds hsrc)
  have hinv : ContMDiffAt 𝓘(ℝ, E) I ∞ (extChartAt I α).symm z :=
    (contMDiffOn_extChartAt_symm α z (interior_subset hz)).contMDiffAt
      (Filter.mem_of_superset (isOpen_interior.mem_nhds hz) interior_subset)
  exact (hfn.comp z hinv).contDiffAt.contDiffWithinAt

end ReadChart

variable {d : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M] [IsManifold I ∞ M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

omit
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I] in
without_proof_info in
theorem contDiffOn_chartInverseMetric_entry (α : M)
    (i j : Fin (Module.finrank ℝ (EuclideanSpace ℝ (Fin d)))) :
    ContDiffOn ℝ ∞
      (fun z => Riemannian.Tensor.chartInvGramMatrix (I := I) α ((extChartAt I α).symm z) i j)
