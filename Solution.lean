  rw [hg]
  rw [← LinearIsometryEquiv.coe_toContinuousLinearEquiv e.symm,
    ContinuousLinearEquiv.comp_fderiv]
  rw [← LinearIsometryEquiv.coe_toContinuousLinearEquiv e,
    ContinuousLinearEquiv.comp_right_fderiv]

