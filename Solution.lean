            C * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal := by
  obtain ⟨R₀, hR₀, A₀, hA₀, _, hforcing, herror⟩ :=
    exists_native_split_error_absorption g q hq hNR hp c
  obtain ⟨R, hR, hRR₀, b, hb, htarget, A, hA, B, hB, D, hD, hlocal⟩ :=
    exists_native_boundary_local_c1_estimate hr g c q hq.continuous R₀ hR₀
  obtain ⟨K, hK, N, hcN, hread⟩ := exists_native_cutoff_c1_readback g c b hb htarget
  let M₀ := max B D
  have hM₀ : 0 ≤ M₀ := hB.trans (le_max_left _ _)
  let ε := 1 / (2 * (K * M₀ + 1))
  have hden : 0 < 2 * (K * M₀ + 1) := by positivity
  have hε : 0 < ε := one_div_pos.mpr hden
  have hcoef : K * M₀ * ε ≤ 1 / 2 := by
    change (K * M₀) * (1 / (2 * (K * M₀ + 1))) ≤ 1 / 2
    rw [mul_one_div]
    apply (div_le_iff₀ hden).mpr
    nlinarith only []
