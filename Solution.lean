    (fun x => φ x * u x) =ᵐ[volume] f := by
  obtain ⟨W, hW, _⟩ := Lp.exists_smulLeftCLM_toTemperedDistribution_eq_and_norm_le
    φ.hasTemperateGrowth hφ u
  have hWf : W =ᵐ[volume] f := by
    apply Lp.ae_eq_of_toTemperedDistribution_apply_eq W hf.continuous.locallyIntegrable
    intro ψ
    rw [← hW]
    exact hrep ψ
  have hφLp : MemLp (φ : CoordinateSpace d → ℂ) ⊤ volume :=
    memLp_top_of_bound φ.continuous.aestronglyMeasurable 1 (Filter.Eventually.of_forall hφ)
  have hraw : Integrable (fun x => φ x * u x) volume := by
    have h := (Lp.memLp u).integrable_mul hφLp
    exact h.congr (Filter.Eventually.of_forall fun x => mul_comm _ _)
  have hWr : W =ᵐ[volume] (fun x => φ x * u x) := by
    apply Lp.ae_eq_of_toTemperedDistribution_apply_eq W hraw.locallyIntegrable
    intro ψ
    rw [← hW, Lp.smulLeftCLM_toTemperedDistribution_apply φ.hasTemperateGrowth]
    simp only [smul_eq_mul, mul_assoc]
  exact hWr.symm.trans hWf

