smooth tangent field, so the checked interior equality determines the face. -/
open Bundle Set Filter MeasureTheory Function TauCeti TopologicalSpace
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  {E' H' Y : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
  [TopologicalSpace H'] {J : ModelWithCorners ℝ E' H'}
  [TopologicalSpace Y] [T2Space Y] [CompactSpace Y] [ChartedSpace H' Y] [IsManifold J 1 Y]
  [MeasurableSpace Y] [OpensMeasurableSpace Y]
  {μ : Measure Y} [IsFiniteMeasure μ]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem native_compact_integral_derivative (g : Metric (n := n) (M := M))
    {U : Set M} (hU : IsOpen U) {F : M → Y → ℝ}
    (hF : ContMDiffOn ((𝓡∂ (n + 1)).prod J) 𝓘(ℝ) ∞ (uncurry F) (U ×ˢ univ))
    {u : M → ℝ} (hu : ContMDiffOn Ihalf 𝓘(ℝ) ∞ u U)
    (heq : ∀ z ∈ U, u z = ∫ y, F z y ∂μ)
    {x : M} (hx : x ∈ U) (v : TangentSpace Ihalf x) :
    Integrable (fun y => mvfderiv Ihalf (fun z => F z y) x v) μ ∧
    mvfderiv Ihalf u x v = ∫ y, mvfderiv Ihalf (fun z => F z y) x v ∂μ := by
  let : SecondCountableTopology M := native_secondCountable_of_compact (n := n) isCompact_univ
  let : LocallyCompactSpace U := hU.locallyCompactSpace
