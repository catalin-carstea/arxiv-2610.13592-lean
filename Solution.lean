/- Actual transfer of the ambient Riemannian smooth-test estimate
to the coordinate H2_0 graph. Both integrals, support conditions and
the same native coefficient witnesses are supplied by proved readbacks. -/
open Bundle Set MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold Filter
open scoped Manifold ContDiff Topology ENNReal Distributions
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {d : ℕ} (D : Opens (EuclideanSpace ℝ (Fin d)))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) ∞
    (EuclideanSpace ℝ (Fin d)) (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [MeasurableSpace D] [BorelSpace D]

local instance : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d))
    (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle
    (IB := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) (n := ∞)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem ambient_h2_weighted_coercivity_of_smooth
    (p : D) {φ : D → ℝ} (hφ : Continuous φ) (q : D → ℝ)
    {U : Opens (EuclideanSpace ℝ (Fin d))} {K : Set (EuclideanSpace ℝ (Fin d))}
    (hK : IsCompact K) (hUK : (U : Set _) ⊆ K) (hKD : K ⊆ D)
    (C : H2CoordinateCoefficients
      (ν := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar) (U := U)
      (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q))
    (S : Set D) (hUS : ∀ x : D, (x : EuclideanSpace ℝ (Fin d)) ∈ U → x ∈ S)
    (τ c : ℝ)
    (hEstimate : ∀ v : D → ℝ, ContMDiff 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) 𝓘(ℝ) ∞ v →
      HasCompactSupport v → tsupport v ⊆ S →
      c * (∫ x : D, Real.exp (2 * τ * φ x) * v x ^ 2
        ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D) ≤
        ∫ x : D, Real.exp (2 * τ * φ x) *
          (laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) v x - q x * v x) ^ 2
            ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D)
    (u : Wkp (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar U 2 2)
    (hu : u ∈ wkp0Submodule (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar U 2 2) :
    c * (∫ z in (U : Set _), ambientDensityExponentialWeight D p φ τ z ^ 2 * Wkp.value 2 u z ^ 2
      ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar) ≤
      ∫ z in (U : Set _), ambientDensityExponentialWeight D p φ τ z ^ 2 * C.operator u z ^ 2
        ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar := by
  have hUD : U ≤ D := hUK.trans hKD
  obtain ⟨w, hw⟩ := exists_ambientDensityExponentialWeight_reading D
    (ν := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar) p hK hUK hKD hφ τ
  apply h2_weightedIntegral_coercivity_of_test_coercivity C w hw c ?_ u hu
  intro ψ
  let F : D → ℝ := fun x => ψ x
  have hF : ContMDiff 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) 𝓘(ℝ) ∞ F :=
    ψ.contDiff.contMDiff.comp contMDiff_subtype_val
  have hFc : HasCompactSupport F := hasCompactSupport_ambient_restriction D
    ψ.hasCompactSupport (ψ.tsupport_subset.trans hUD)
  have hFs : tsupport F ⊆ S := by
    intro x hx
    exact hUS x (ψ.tsupport_subset (tsupport_ambient_restriction_subset D ψ hx))
  have he := hEstimate F hF hFc hFs
  change c * (∫ x : D, Real.exp (2 * τ * φ x) * ψ x ^ 2
      ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D) ≤
    ∫ x : D, Real.exp (2 * τ * φ x) *
      (laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) (fun y : D => ψ y) x - q x * ψ x) ^ 2
        ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D at he
  rw [integral_ambient_weighted_value D p φ τ hUD ψ ψ.tsupport_subset,
    integral_ambient_weighted_operator D p φ τ hUD q
      (ψ.contDiff.of_le (by simp)) ψ.tsupport_subset] at he
  exact he
end ConformalPoisson

end ProofPart_AmbientH2CarlemanTransfer

/- Proof support: CarlemanHessianCalculus.lean, SHA256 f53b63e7bc5e2432853598ddf3b4002365bda4d373b3565e98ad72bb74ccae9e -/
noncomputable section ProofPart_CarlemanHessianCalculus



/- Pointwise Riemannian identities used in the Carleman commutator.
These are local identities for the actual metric and gradients;
no unique continuation or analyticity premise is involved. -/
open Bundle FiberBundle TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]

local instance carlemanHessianSmoothSucc : IsManifold I (∞ + 1) M := by
  simpa using (inferInstance : IsManifold I ∞ M)

without_proof_info in
theorem contMDiff_hessian_gradient_pair {f g h : M → ℝ}
    (hf : ContMDiff I 𝓘(ℝ) ∞ f) (hg : ContMDiff I 𝓘(ℝ) ∞ g)
    (hh : ContMDiff I 𝓘(ℝ) ∞ h) :
    ContMDiff I 𝓘(ℝ) ∞ (fun x => hessian I f x (mgradient I g x) (mgradient I h x)) := by
  have hGg : ContMDiff I I.tangent ∞ (T% (mgradient I g)) :=
    contMDiff_mgradient (n := ∞) (by simpa using hg)
  have hGh : ContMDiff I I.tangent ∞ (T% (mgradient I h)) :=
    contMDiff_mgradient (n := ∞) (by simpa using hh)
  intro x
  exact contMDiffAt_hessian_pair (I := I) (J := I) (m := ∞) (k := ∞) (n := ∞)
    (by simp) (by simp) isOpen_univ (hf.of_le (by simp)).contMDiffOn
    (γ := id) (Set.mem_univ x) (hGg x) (hGh x)

without_proof_info in
theorem mvfderiv_inner_gradients_eq_hessians {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v)
    (x : M) (w : TangentSpace I x) :
    mvfderiv I (fun y => ⟪mgradient I φ y, mgradient I v y⟫_ℝ) x w =
      hessian I φ x w (mgradient I v x) + hessian I v x w (mgradient I φ x) := by
  have hGφ : MDiffAt (T% (mgradient I φ)) x :=
    ((contMDiff_mgradient (n := ∞) (by simpa using hφ)) x).mdifferentiableAt (by simp)
  have hGv : MDiffAt (T% (mgradient I v)) x :=
    ((contMDiff_mgradient (n := ∞) (by simpa using hv)) x).mdifferentiableAt (by simp)
  have hh := (CovariantDerivative.isMetricCompatible_leviCivitaConnection I).mvfderiv_inner_eq
    (FiberBundle.extend E w) hGφ hGv
  simpa only [FiberBundle.extend_apply_self, hessian_def,
    real_inner_comm (mgradient I φ x)] using hh

without_proof_info in
theorem inner_gradient_inner_gradients_eq_hessians {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (x : M) :
    ⟪mgradient I v x,
      mgradient I (fun y => ⟪mgradient I φ y, mgradient I v y⟫_ℝ) x⟫_ℝ =
      hessian I φ x (mgradient I v x) (mgradient I v x) +
        hessian I v x (mgradient I v x) (mgradient I φ x) := by
  rw [inner_mgradient_right]
  exact mvfderiv_inner_gradients_eq_hessians hφ hv x _

without_proof_info in
theorem inner_gradient_normSq_gradient_eq_hessian {φ v : M → ℝ}
    (hv : ContMDiff I 𝓘(ℝ) ∞ v) (x : M) :
    ⟪mgradient I φ x, mgradient I (fun y => ‖mgradient I v y‖ ^ 2) x⟫_ℝ =
      2 * hessian I v x (mgradient I v x) (mgradient I φ x) := by
  rw [inner_mgradient_right]
  have hh := mvfderiv_inner_gradients_eq_hessians hv hv x (mgradient I φ x)
  simp only [real_inner_self_eq_norm_sq] at hh
  rw [hh, hessian_symm x (hv.of_le (by simp) x)]
  ring

without_proof_info in
theorem mgradient_square {v : M → ℝ} (hv : ContMDiff I 𝓘(ℝ) ∞ v) (x : M) :
    mgradient I (fun y => v y ^ 2) x = (2 * v x) • mgradient I v x := by
  have hfun : v * v = (fun y => v y ^ 2) := by ext y; simp only [Pi.mul_apply, pow_two]
  rw [← hfun, mgradient_mul (hv.mdifferentiable (by simp)) (hv.mdifferentiable (by simp))]
  simp only [two_mul, add_smul]

without_proof_info in
theorem inner_gradient_product {f g v : M → ℝ}
    (hf : ContMDiff I 𝓘(ℝ) ∞ f) (hg : ContMDiff I 𝓘(ℝ) ∞ g) (x : M) :
    ⟪mgradient I (fun y => f y * g y) x, mgradient I v x⟫_ℝ =
      f x * ⟪mgradient I g x, mgradient I v x⟫_ℝ +
        g x * ⟪mgradient I f x, mgradient I v x⟫_ℝ := by
  change ⟪mgradient I (f * g) x, mgradient I v x⟫_ℝ = _
  rw [mgradient_mul (hf.mdifferentiable (by simp)) (hg.mdifferentiable (by simp))]
  simp only [inner_add_left, real_inner_smul_left]
end ConformalPoisson

end ProofPart_CarlemanHessianCalculus

/- Proof support: CarlemanWeightJets.lean, SHA256 34af75432055d99084df41f31ac81b131fc25eca7e77ca6f7e866c34bc587280 -/
noncomputable section ProofPart_CarlemanWeightJets



/- Normal convexification of the boundary weight. At a point where
ell vanishes, adding b*ell^2 leaves the gradient unchanged and adds
the positive rank-one Hessian 2*b*dell tensor dell. This is the actual
Riemannian jet formula, with no coordinate-metric normalization. -/
open Bundle FiberBundle TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]

def carlemanConvexifiedWeight (ψ ell : M → ℝ) (b : ℝ) : M → ℝ :=
  ψ + b • (fun x => ell x ^ 2)

without_proof_info in
theorem contMDiff_scaled_square {ell : M → ℝ} (hell : ContMDiff I 𝓘(ℝ) ∞ ell) (b : ℝ) :
    ContMDiff I 𝓘(ℝ) ∞ (b • (fun x => ell x ^ 2)) := by
  have heq : b • (fun x => ell x ^ 2) = (fun _ : M => b) * (fun x => ell x ^ 2) := rfl
  rw [heq]
  exact (contMDiff_const (c := b)).mul (hell.pow 2)

without_proof_info in
theorem contMDiff_convexifiedWeight {ψ ell : M → ℝ}
    (hψ : ContMDiff I 𝓘(ℝ) ∞ ψ) (hell : ContMDiff I 𝓘(ℝ) ∞ ell) (b : ℝ) :
    ContMDiff I 𝓘(ℝ) ∞ (carlemanConvexifiedWeight ψ ell b) :=
  hψ.add (contMDiff_scaled_square hell b)

without_proof_info in
theorem mgradient_convexifiedWeight {ψ ell : M → ℝ}
    (hψ : ContMDiff I 𝓘(ℝ) ∞ ψ) (hell : ContMDiff I 𝓘(ℝ) ∞ ell)
    {p : M} (hp : ell p = 0) (b : ℝ) :
    mgradient I (carlemanConvexifiedWeight ψ ell b) p = mgradient I ψ p := by
  have hbs := contMDiff_scaled_square hell b
  rw [carlemanConvexifiedWeight, mgradient_add (hψ.mdifferentiable (by simp))
    (hbs.mdifferentiable (by simp)), mgradient_smul]
  simp only [Pi.add_apply, Pi.smul_apply, mgradient_square hell, hp, mul_zero, zero_smul, smul_zero, add_zero]

without_proof_info in
theorem hessian_convexifiedWeight {ψ ell : M → ℝ}
    (hψ : ContMDiff I 𝓘(ℝ) ∞ ψ) (hell : ContMDiff I 𝓘(ℝ) ∞ ell)
    {p : M} (hp : ell p = 0) (b : ℝ) (v w : TangentSpace I p) :
    hessian I (carlemanConvexifiedWeight ψ ell b) p v w = hessian I ψ p v w +
      2 * b * mvfderiv I ell p v * mvfderiv I ell p w := by
  have hbs := contMDiff_scaled_square hell b
  rw [carlemanConvexifiedWeight, hessian_add I (hψ.of_le (by simp))
    (hbs.of_le (by simp)), hessian_smul I b ((hell.pow 2).of_le (by simp)),
    hessian_sq (hell.of_le (by simp) p), hp]
  ring

without_proof_info in
theorem normal_hessian_convexifiedWeight {ψ ell : M → ℝ}
    (hψ : ContMDiff I 𝓘(ℝ) ∞ ψ) (hell : ContMDiff I 𝓘(ℝ) ∞ ell)
    {p : M} (hp : ell p = 0) (hgrad : mgradient I ψ p = -mgradient I ell p) (b : ℝ) :
    hessian I (carlemanConvexifiedWeight ψ ell b) p
        (mgradient I (carlemanConvexifiedWeight ψ ell b) p)
        (mgradient I (carlemanConvexifiedWeight ψ ell b) p) =
      hessian I ψ p (mgradient I ell p) (mgradient I ell p) + 2 * b * ‖mgradient I ell p‖ ^ 4 := by
  rw [mgradient_convexifiedWeight hψ hell hp, hgrad, hessian_convexifiedWeight hψ hell hp]
  have hd : mvfderiv I ell p (mgradient I ell p) = ‖mgradient I ell p‖ ^ 2 := by
    rw [← inner_mgradient, real_inner_self_eq_norm_sq]
  simp only [map_neg, hd]
  have hH : hessian I ψ p (-mgradient I ell p) (-mgradient I ell p) =
      hessian I ψ p (mgradient I ell p) (mgradient I ell p) := by
    rw [← neg_one_smul ℝ (mgradient I ell p), hessian_smul_left, hessian_smul_right]
    ring
  rw [hH]
  ring

without_proof_info in
theorem exists_normal_convexification_parameter {F : Type*} [NormedAddCommGroup F]
    {G : F} (hG : G ≠ 0) (c r : ℝ) :
    ∃ w h b : ℝ, ‖G‖ ^ 2 < w ∧ 0 ≤ b ∧ 0 < h - c * w ∧ h < r + 2 * b * ‖G‖ ^ 4 := by
  let w := ‖G‖ ^ 2 + 1
  let h := c * w + 1
  let b := max 0 ((h - r + 1) / (2 * ‖G‖ ^ 4))
  have hnorm : 0 < ‖G‖ := norm_pos_iff.mpr hG
  have hden : 0 < 2 * ‖G‖ ^ 4 := by positivity
  have hquot : (h - r + 1) / (2 * ‖G‖ ^ 4) ≤ b := le_max_right _ _
  have hbig := (div_le_iff₀ hden).mp hquot
  refine ⟨w, h, b, ?_, le_max_left _ _, ?_, ?_⟩
  · dsimp only [w]; linarith
  · dsimp only [h]; linarith
  · nlinarith
end ConformalPoisson

end ProofPart_CarlemanWeightJets

/- Proof support: NativeHessianSection.lean, SHA256 df4670bea7aac54946c54b3eac9593a320c2660d69eb460002c616063284636d -/
noncomputable section ProofPart_NativeHessianSection



/- The actual Riemannian Hessian as a smooth section of the bundle
of continuous bilinear forms. This permits the existing openness of
positive bilinear forms to propagate a strict Hessian lower bound. -/
open Bundle FiberBundle Set TauCeti TauCeti.Manifold CovariantDerivative
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
variable (I)

def nativeInnerBilinear (x : M) : TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ :=
  (inferInstance : IsContMDiffRiemannianBundle I ∞ E
    (fun x : M => TangentSpace I x)).exists_contMDiff.choose x

def nativeHessianBilinear (f : M → ℝ) (x : M) : TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ :=
  (nativeInnerBilinear I x).comp
    (leviCivitaConnection I M (mgradient I f) x)

variable {I}
without_proof_info in
theorem nativeInnerBilinear_apply (x : M) (v w : TangentSpace I x) :
    nativeInnerBilinear I x v w = ⟪v, w⟫_ℝ :=
  ((inferInstance : IsContMDiffRiemannianBundle I ∞ E
    (fun x : M => TangentSpace I x)).exists_contMDiff.choose_spec.2 x v w).symm

without_proof_info in
theorem nativeHessianBilinear_apply (f : M → ℝ) (x : M) (v w : TangentSpace I x) :
    nativeHessianBilinear I f x v w = hessian I f x v w := by
  rw [nativeHessianBilinear, ContinuousLinearMap.comp_apply, nativeInnerBilinear_apply, hessian_def]

without_proof_info in
theorem contMDiff_inner_bilinear_section :
    ContMDiff I (I.prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (fun x : M => TotalSpace.mk' (E →L[ℝ] E →L[ℝ] ℝ) x
        (nativeInnerBilinear I x)) :=
  (inferInstance : IsContMDiffRiemannianBundle I ∞ E
    (fun x : M => TangentSpace I x)).exists_contMDiff.choose_spec.1

without_proof_info in
theorem contMDiff_nativeHessianBilinear {f : M → ℝ} (hf : ContMDiff I 𝓘(ℝ) ∞ f) :
    ContMDiff I (I.prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (fun x : M => TotalSpace.mk' (E →L[ℝ] E →L[ℝ] ℝ) x (nativeHessianBilinear I f x)) := by
  letI : IsManifold I (∞ + 1) M := by simpa using (inferInstance : IsManifold I ∞ M)
  have hG : ContMDiff I I.tangent ∞ (T% (mgradient I f)) :=
    contMDiff_mgradient (n := ∞) (hf.of_le (by simp))
  have hC : ContMDiff I (I.prod 𝓘(ℝ, E →L[ℝ] E)) ∞
      (fun x : M => TotalSpace.mk' (E →L[ℝ] E) x (leviCivitaConnection I M (mgradient I f) x)) :=
    contMDiffOn_univ.mp (contMDiffOn_leviCivitaConnection (n := ∞) (m := ∞) (k := ∞)
      isOpen_univ (by simp) (by simp) (hG.of_le (by simp)).contMDiffOn)
  exact contMDiff_inner_bilinear_section.clm_bundle_comp hC
end ConformalPoisson

end ProofPart_NativeHessianSection

/- Proof support: NativeBilinearPositivity.lean, SHA256 a6a16cb60c332acc04d89dc3031721faf24c3fcb975b52f6557c95147a57c22b -/
noncomputable section ProofPart_NativeBilinearPositivity



/- Strict positivity of an actual smooth bilinear tensor persists
near a point. A fixed tangent-bundle trivialization reads the tensor
in the canonical finite-dimensional space, where positivity is open. -/
open Bundle FiberBundle Set Filter TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]

def nativeBilinearRead (A : (x : M) → TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ)
    (p y : M) : E →L[ℝ] E →L[ℝ] ℝ :=
  (trivializationAt (E →L[ℝ] E →L[ℝ] ℝ)
    (fun x : M => TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ) p
      (TotalSpace.mk' (E →L[ℝ] E →L[ℝ] ℝ) y (A y))).2

without_proof_info in
theorem nativeBilinearRead_apply
    (A : (x : M) → TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ) (p : M) {y : M}
    (hy : y ∈ (trivializationAt E (TangentSpace I) p).baseSet) (v w : E) :
    nativeBilinearRead A p y v w = A y
      ((trivializationAt E (TangentSpace I) p).symmL ℝ y v)
      ((trivializationAt E (TangentSpace I) p).symmL ℝ y w) := by
  simp only [nativeBilinearRead, hom_trivializationAt_apply]
  rw [inCoordinates_apply_eq₂ hy hy (by simp)]
  simp [Trivialization.symmL_apply _ hy]

set_option maxHeartbeats 700000 in
without_proof_info in
theorem eventually_positive_nativeBilinear
    {A : (x : M) → TangentSpace I x →L[ℝ] TangentSpace I x →L[ℝ] ℝ}
    (hA : ContMDiff I (I.prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (fun x : M => TotalSpace.mk' (E →L[ℝ] E →L[ℝ] ℝ) x (A x)))
    {p : M} (hp : ∀ v : TangentSpace I p, v ≠ 0 → 0 < A p v v) :
    ∀ᶠ y in 𝓝 p, ∀ v : TangentSpace I y, v ≠ 0 → 0 < A y v v := by
  let e := trivializationAt E (TangentSpace I) p
  have hbase : p ∈ e.baseSet := mem_baseSet_trivializationAt E (TangentSpace I) p
  have hread : ContinuousAt (nativeBilinearRead A p) p :=
    ((contMDiffAt_section_iff p).mp (hA p)).continuousAt
  have hpos : ∀ v : E, v ≠ 0 → 0 < nativeBilinearRead A p p v v := by
    intro v hv
    let C := e.continuousLinearEquivAt ℝ p hbase
    have heq : (C.symm : E → TangentSpace I p) = e.symmL ℝ p :=
      e.symm_continuousLinearEquivAt_eq hbase
    rw [nativeBilinearRead_apply A p hbase, ← heq]
    exact hp _ (C.symm.map_ne_zero_iff.mpr hv)
  have hposEv : ∀ᶠ y in 𝓝 p, ∀ v : E, v ≠ 0 → 0 < nativeBilinearRead A p y v v :=
    hread.preimage_mem_nhds (isOpen_setOf_positive_bilinearForm.mem_nhds hpos)
  filter_upwards [hposEv, e.open_baseSet.mem_nhds hbase] with y hy hybase
  intro v hv
  let C := e.continuousLinearEquivAt ℝ y hybase
  have heq : (C.symm : E → TangentSpace I y) = e.symmL ℝ y :=
    e.symm_continuousLinearEquivAt_eq hybase
  have h := hy (C v) (C.map_ne_zero_iff.mpr hv)
  rw [nativeBilinearRead_apply A p hybase, ← heq, C.symm_apply_apply] at h
  exact h
end ConformalPoisson

end ProofPart_NativeBilinearPositivity

/- Proof support: CarlemanSupport.lean, SHA256 dbb62ab0fec5b55343cef5ad4e2424dd9e8df2f19b157dcd6198614dfc3464a1 -/
noncomputable section ProofPart_CarlemanSupport



/- Compact support and integrability for the actual Riemannian
expressions in the Carleman calculation. Boundaryless is needed only
by the later ambient integration-by-parts argument, not these supports. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]

without_proof_info in
theorem hasCompactSupport_square {v : M → ℝ} (hc : HasCompactSupport v) :
    HasCompactSupport (fun x => v x ^ 2) := by
  apply hc.mono
  intro x hx hv
  exact hx (by simp only [hv, zero_pow (by decide : 2 ≠ 0)])

without_proof_info in
theorem hasCompactSupport_inner_mgradients_right {f v : M → ℝ} (hc : HasCompactSupport v) :
    HasCompactSupport (fun x => ⟪mgradient I f x, mgradient I v x⟫_ℝ) := by
  apply (hc.mgradient I).mono
  intro x hx hv
  exact hx (by simp only [hv, inner_zero_right])

without_proof_info in
theorem hasCompactSupport_normSq_mgradient {v : M → ℝ} (hc : HasCompactSupport v) :
    HasCompactSupport (fun x => ‖mgradient I v x‖ ^ 2) := by
  apply (hc.mgradient I).mono
  intro x hx hv
  exact hx (by simp only [hv, norm_zero, zero_pow (by decide : 2 ≠ 0)])

without_proof_info in
theorem hasCompactSupport_hessian_gradient_pair {f g h : M → ℝ} (hc : HasCompactSupport g) :
    HasCompactSupport (fun x => hessian I f x (mgradient I g x) (mgradient I h x)) := by
  apply (hc.mgradient I).mono
  intro x hx hg
  apply hx
  change hessian I f x (mgradient I g x) (mgradient I h x) = 0
  rw [hg, hessian_zero_left]

without_proof_info in
theorem smooth_laplaceBeltrami {v : M → ℝ} (hv : ContMDiff I 𝓘(ℝ) ∞ v) :
    ContMDiff I 𝓘(ℝ) ∞ (laplaceBeltrami I v) :=
  contMDiff_laplaceBeltrami (m := ∞) (k := ∞) (by simp) (by simp) (hv.of_le (by simp))

without_proof_info in
theorem smooth_inner_mgradients {f v : M → ℝ}
    (hf : ContMDiff I 𝓘(ℝ) ∞ f) (hv : ContMDiff I 𝓘(ℝ) ∞ v) :
    ContMDiff I 𝓘(ℝ) ∞ (fun x => ⟪mgradient I f x, mgradient I v x⟫_ℝ) := by
  letI : IsManifold I (∞ + 1) M := by simpa using (inferInstance : IsManifold I ∞ M)
  exact contMDiff_inner_mgradient (n := ∞) (hf.of_le (by simp)) (hv.of_le (by simp))

without_proof_info in
theorem smooth_normSq_mgradient {v : M → ℝ} (hv : ContMDiff I 𝓘(ℝ) ∞ v) :
    ContMDiff I 𝓘(ℝ) ∞ (fun x => ‖mgradient I v x‖ ^ 2) := by
  simpa only [real_inner_self_eq_norm_sq] using smooth_inner_mgradients hv hv
end ConformalPoisson

end ProofPart_CarlemanSupport

/- Proof support: CarlemanPointBounds.lean, SHA256 a7f677e4b5b4bacbf383f095b9cfb34cb67e36a9fbea5c8b3ba75ec4facd3e0d -/
noncomputable section ProofPart_CarlemanPointBounds




/- Construction of strict Carleman weight bounds at a point from
the actual nonzero conormal gradient. The negative Hessian bound is
chosen before the normal convexification parameter. -/
open Bundle FiberBundle Set Filter TopologicalSpace TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]

set_option maxHeartbeats 700000 in
without_proof_info in
theorem exists_strict_convexified_weight_bounds_at {ψ ell : M → ℝ}
    (hψ : ContMDiff I 𝓘(ℝ) ∞ ψ) (hell : ContMDiff I 𝓘(ℝ) ∞ ell)
    {p : M} (hp : ell p = 0) (hgrad : mgradient I ψ p = -mgradient I ell p)
    (hG : mgradient I ell p ≠ 0) :
    ∃ b c h w : ℝ, 0 ≤ b ∧ 0 ≤ c ∧ 0 < h - c * w ∧
      (∀ ξ : TangentSpace I p, ξ ≠ 0 →
        0 < hessian I (carlemanConvexifiedWeight ψ ell b) p ξ ξ + c * ‖ξ‖ ^ 2) ∧
      h < hessian I (carlemanConvexifiedWeight ψ ell b) p
        (mgradient I (carlemanConvexifiedWeight ψ ell b) p)
        (mgradient I (carlemanConvexifiedWeight ψ ell b) p) ∧
      ‖mgradient I (carlemanConvexifiedWeight ψ ell b) p‖ ^ 2 < w := by
  let : NormedAddCommGroup (TangentSpace I p →L[ℝ] TangentSpace I p →L[ℝ] ℝ) :=
    ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
      (E := TangentSpace I p) (F := TangentSpace I p →L[ℝ] ℝ)
  let B := nativeHessianBilinear I ψ p
  let c : ℝ := ‖B‖ + 1
  obtain ⟨w, h, b, hw, hb, hgap, hnormal⟩ := exists_normal_convexification_parameter hG c
    (hessian I ψ p (mgradient I ell p) (mgradient I ell p))
  refine ⟨b, c, h, w, hb, by dsimp only [c]; positivity, hgap, ?_, ?_, ?_⟩
  · intro ξ hξ
    have hnorm : 0 < ‖ξ‖ := norm_pos_iff.mpr hξ
    have hbound := B.le_opNorm₂ ξ ξ
    have hlow := neg_abs_le (B ξ ξ)
    have hrank : 0 ≤ 2 * b * mvfderiv I ell p ξ * mvfderiv I ell p ξ := by
      nlinarith [mul_nonneg hb (sq_nonneg (mvfderiv I ell p ξ))]
    rw [hessian_convexifiedWeight hψ hell hp]
    rw [← nativeHessianBilinear_apply ψ p ξ ξ]
    change 0 < B ξ ξ + 2 * b * mvfderiv I ell p ξ * mvfderiv I ell p ξ + c * ‖ξ‖ ^ 2
    rw [Real.norm_eq_abs] at hbound
    dsimp only [c]
    nlinarith [sq_pos_of_pos hnorm]
  · rw [normal_hessian_convexifiedWeight hψ hell hp hgrad]
    exact hnormal
  · rw [mgradient_convexifiedWeight hψ hell hp, hgrad, norm_neg]
    exact hw

set_option maxHeartbeats 700000 in
without_proof_info in
theorem eventually_carleman_weight_bounds {φ : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) {p : M} {c h w : ℝ}
    (hpos : ∀ ξ : TangentSpace I p, ξ ≠ 0 → 0 < hessian I φ p ξ ξ + c * ‖ξ‖ ^ 2)
    (hnormal : h < hessian I φ p (mgradient I φ p) (mgradient I φ p))
    (hgrad : ‖mgradient I φ p‖ ^ 2 < w) :
    ∀ᶠ y in 𝓝 p,
      (∀ ξ : TangentSpace I y, -c * ‖ξ‖ ^ 2 ≤ hessian I φ y ξ ξ) ∧
      h ≤ hessian I φ y (mgradient I φ y) (mgradient I φ y) ∧ ‖mgradient I φ y‖ ^ 2 ≤ w := by
  let A : (y : M) → TangentSpace I y →L[ℝ] TangentSpace I y →L[ℝ] ℝ :=
    fun y => nativeHessianBilinear I φ y + c • nativeInnerBilinear I y
  have hA : ContMDiff I (I.prod 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ)) ∞
      (fun y : M => TotalSpace.mk' (E →L[ℝ] E →L[ℝ] ℝ) y (A y)) :=
    (contMDiff_nativeHessianBilinear hφ).add_section
      (contMDiff_inner_bilinear_section.const_smul_section (a := c))
  have hAp : ∀ ξ : TangentSpace I p, ξ ≠ 0 → 0 < A p ξ ξ := by
    intro ξ hξ
    simpa only [A, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, nativeHessianBilinear_apply, nativeInnerBilinear_apply, real_inner_self_eq_norm_sq] using hpos ξ hξ
  have hposEv := eventually_positive_nativeBilinear hA hAp
  have hnormalEv := ((contMDiff_hessian_gradient_pair hφ hφ hφ).continuous.tendsto p).eventually_const_lt hnormal
  have hgradEv := ((smooth_normSq_mgradient hφ).continuous.tendsto p).eventually_lt_const hgrad
  filter_upwards [hposEv, hnormalEv, hgradEv] with y hy hny hgy
  refine ⟨?_, hny.le, hgy.le⟩
  intro ξ
  by_cases hξ : ξ = 0
  · simp only [hξ, norm_zero, zero_pow (by decide : 2 ≠ 0), mul_zero, hessian_zero_left, le_refl]
  · have hh := hy ξ hξ
    change 0 < (nativeHessianBilinear I φ y + c • nativeInnerBilinear I y) ξ ξ at hh
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul, nativeHessianBilinear_apply, nativeInnerBilinear_apply, real_inner_self_eq_norm_sq] at hh
    linarith
end ConformalPoisson

end ProofPart_CarlemanPointBounds

/- Proof support: AmbientCarlemanWeight.lean, SHA256 953b8691c9c3a4fd83f82cb3fd6d0f2afaab1360884dd3145bddb554352e64f6 -/
noncomputable section ProofPart_AmbientCarlemanWeight




/- A genuine Carleman weight in the actual ambient boundary chart.
The metric is arbitrary smooth positive Riemannian data on that open
chart. No normalization or existence of a weight is assumed. -/
open Bundle FiberBundle Set Filter TopologicalSpace TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {n : ℕ}

def ambientSquaredRadius (D : Opens (EuclideanSpace ℝ (Fin (n + 1)))) (p : D) : D → ℝ := fun x => ‖(x : (EuclideanSpace ℝ (Fin (n + 1)))) - (p : (EuclideanSpace ℝ (Fin (n + 1))))‖ ^ 2

def ambientCarlemanWeight (D : Opens (EuclideanSpace ℝ (Fin (n + 1)))) (p : D) (b : ℝ) : D → ℝ :=
  carlemanConvexifiedWeight (-(ambientBoundaryFunction D + ambientSquaredRadius D p))
    (ambientBoundaryFunction D) b

without_proof_info in
theorem contMDiff_ambientSquaredRadius (D : Opens (EuclideanSpace ℝ (Fin (n + 1)))) (p : D) :
    ContMDiff 𝓘(ℝ, (EuclideanSpace ℝ (Fin (n + 1)))) 𝓘(ℝ) ∞ (ambientSquaredRadius D p) := by
  have hC : ContDiff ℝ ∞ (fun y : (EuclideanSpace ℝ (Fin (n + 1))) => ‖y - (p : (EuclideanSpace ℝ (Fin (n + 1))))‖ ^ 2) :=
    (contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)
  exact hC.contMDiff.comp contMDiff_subtype_val

without_proof_info in
