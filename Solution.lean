/- Proof support: NativeInteriorDivergence.lean, SHA256 eb7e63b73d1d5addf8dbec5fa8abd1d11df9f24d270385d8441215a21fdd60e9 -/
noncomputable section ProofPart_NativeInteriorDivergence
/-
Copyright (c) 2026 The Tau Ceti contributors. All rights reserved.
Released under Apache 2.0 license as described in the file LICENSE.
Authors: The Tau Ceti contributors

The single-chart proof below is adapted from pinned Tau Ceti
Geometry/Manifold/Riemannian/DivergenceTheorem.lean. The support is
required to lie over the interior of the chart target. This replaces
its global Boundaryless assumption and applies to the paper's boundary
manifolds. The original library file and its declarations are unchanged.
-/





open Bundle FiberBundle MeasureTheory Riemannian.Tensor Set TauCeti TauCeti.Manifold
open scoped ContDiff Manifold Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I 2 M] [RiemannianBundle (fun x : M ↦ TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 E (fun x : M ↦ TangentSpace I x)]
  {α : M} {X : (x : M) → TangentSpace I x}
/-- The `k`-th coefficient of `ρ X` in the chart frame at `α`, read in coordinates and extended by
zero off the chart target. Here `ρ` is the chart volume density. -/
private def interiorChartFlux (α : M) (X : (x : M) → TangentSpace I x)
    (k : Fin (Module.finrank ℝ E)) : E → ℝ :=
  (interior (extChartAt I α).target).indicator fun z ↦
    chartVolumeDensity (I := I) α ((extChartAt I α).symm z) *
      (trivializationAt E (TangentSpace I) α).localFrameCoeff I (Module.finBasis ℝ E) k
        ((extChartAt I α).symm z) (X ((extChartAt I α).symm z))

omit [IsContMDiffRiemannianBundle I 1 E (fun x : M ↦ TangentSpace I x)] in
without_proof_info in
/-- The fluxes vanish off the coordinate image of the support of `X`. -/
private theorem interiorChartFlux_eq_zero (k : Fin (Module.finrank ℝ E)) {z : E}
    (hz : z ∉ extChartAt I α '' tsupport (α := E) X) : interiorChartFlux α X k z = 0 := by
  by_cases ht : z ∈ interior (extChartAt I α).target
  · have hX : X ((extChartAt I α).symm z) = 0 :=
      image_eq_zero_of_notMem_tsupport (α := E) fun h ↦
        hz ⟨_, h, (extChartAt I α).right_inv (interior_subset ht)⟩
    simp only [interiorChartFlux, indicator_of_mem ht, hX, map_zero, mul_zero]
  · exact indicator_of_notMem ht _

omit [IsContMDiffRiemannianBundle I 1 E (fun x : M ↦ TangentSpace I x)] in
without_proof_info in
/-- The fluxes vanish near every point off the compact coordinate image of the support of `X`. -/
private theorem interiorChartFlux_eventuallyEq_zero (hK : IsCompact (extChartAt I α '' tsupport (α := E) X))
    (k : Fin (Module.finrank ℝ E)) {z : E}
    (hz : z ∉ extChartAt I α '' tsupport (α := E) X) : interiorChartFlux α X k =ᶠ[𝓝 z] 0 :=
  Filter.eventually_of_mem (hK.isClosed.isOpen_compl.mem_nhds hz) fun _ h ↦ interiorChartFlux_eq_zero k h

without_proof_info in
/-- The product of the chart volume density and a frame coefficient of a `C¹` field is `C¹` on the
chart source. -/
private theorem contMDiffOn_chartVolumeDensity_mul_localFrameCoeff
    (hX : ContMDiff I I.tangent 1 (T% X)) (k : Fin (Module.finrank ℝ E)) :
    ContMDiffOn I 𝓘(ℝ) 1 (fun y ↦ chartVolumeDensity (I := I) α y *
      (trivializationAt E (TangentSpace I) α).localFrameCoeff I (Module.finBasis ℝ E) k y (X y))
      (chartAt H α).source := by
  have : IsManifold I (1 + 1) M := by norm_num; infer_instance
  have hs : (trivializationAt E (TangentSpace I) α).baseSet = (chartAt H α).source := by simp
  have h1 := contMDiffOn_chartVolumeDensity (I := I) (n := 1) α
  have h2 := contMDiffOn_baseSet_localFrameCoeff (I := I)
    (e := trivializationAt E (TangentSpace I) α) (Module.finBasis ℝ E) (k := 1) hX.contMDiffOn k
  rw [hs] at h1 h2
  exact h1.mul h2

without_proof_info in
/-- The fluxes of a `C¹` field whose support has compact coordinate image inside the chart target
are `C¹` on the model space. -/
private theorem contDiff_interiorChartFlux (hX : ContMDiff I I.tangent 1 (T% X))
    (hKc : IsCompact (extChartAt I α '' tsupport (α := E) X))
    (himage : extChartAt I α '' tsupport (α := E) X ⊆ interior (extChartAt I α).target)
    (k : Fin (Module.finrank ℝ E)) :
    ContDiff ℝ 1 (interiorChartFlux α X k) := by
  have hon : ContDiffOn ℝ 1 (interiorChartFlux α X k) (interior (extChartAt I α).target) := by
    have h := (contMDiffOn_chartVolumeDensity_mul_localFrameCoeff hX k).comp
      (contMDiffOn_extChartAt_symm (n := 1) α) fun z hz ↦ by
        rw [mem_preimage, ← extChartAt_source (I := I)]
        exact (extChartAt I α).map_target hz
    exact ((contMDiffOn_iff_contDiffOn.1 h).mono interior_subset).congr fun z hz ↦ indicator_of_mem hz _
  refine contDiff_iff_contDiffAt.2 fun z ↦ ?_
  by_cases hz : z ∈ interior (extChartAt I α).target
  · exact hon.contDiffAt (isOpen_interior.mem_nhds hz)
  · exact contDiffAt_const.congr_of_eventuallyEq
      (interiorChartFlux_eventuallyEq_zero hKc k fun h ↦ hz (himage h))

without_proof_info in
/-- On the chart target, the coordinate divergence of the fluxes is `ρ div X` read in the chart.
This is the coordinate formula `ρ div X = ∑ₖ ∂ₖ (ρ Xᵏ)` written in coordinates. -/
private theorem sum_fderiv_interiorChartFlux (hX : ContMDiff I I.tangent 1 (T% X)) {z : E}
    (hz : z ∈ interior (extChartAt I α).target) :
    ∑ k, fderiv ℝ (interiorChartFlux α X k) z (Module.finBasis ℝ E k) =
      chartVolumeDensity (I := I) α ((extChartAt I α).symm z) *
        divergence I X ((extChartAt I α).symm z) := by
  have hy : (extChartAt I α).symm z ∈ (chartAt H α).source := by
    rw [← extChartAt_source (I := I)]
    exact (extChartAt I α).map_target (interior_subset hz)
  rw [chartVolumeDensity_mul_divergence α (by simpa using hy)
    ((hX _).mdifferentiableAt one_ne_zero)]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [chartLocalFrame_eq_symmL, mvfderiv_inverseChart_vector α hy (by simpa only [(extChartAt I α).right_inv (interior_subset hz)] using hz)
    ((contMDiffOn_chartVolumeDensity_mul_localFrameCoeff hX k).contMDiffAt
      ((chartAt H α).open_source.mem_nhds hy) |>.mdifferentiableAt one_ne_zero),
    (extChartAt I α).right_inv (interior_subset hz)]
  have h : interiorChartFlux α X k =ᶠ[𝓝 z] _ :=
    Filter.eventually_of_mem (isOpen_interior.mem_nhds hz) fun z' hz' ↦
      indicator_of_mem hz' _
  rw [h.fderiv_eq, Function.comp_def]

variable [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
  [IsContinuousRiemannianBundle E (fun x : M ↦ TangentSpace I x)]

attribute [local instance] extChartAtMeasurableSpaceE extChartAtBorelSpaceE

without_proof_info in
/-- A compactly supported field with support inside one interior chart
has zero total divergence, even when the ambient manifold has boundary. -/
theorem integral_divergence_eq_zero_of_interior_chart
    (hX : ContMDiff I I.tangent 1 (T% X)) (hK : IsCompact (tsupport (α := E) X))
    (hKs : tsupport (α := E) X ⊆ (chartAt H α).source)
    (hKi : extChartAt I α '' tsupport (α := E) X ⊆ interior (extChartAt I α).target) :
    ∫ x, divergence I X x ∂riemannianVolume I M = 0 := by
  have hKs' : tsupport (α := E) X ⊆ (extChartAt I α).source := by rwa [extChartAt_source]
  have hKc := hK.image_of_continuousOn ((continuousOn_extChartAt α).mono hKs')
  have hflux (k : Fin (Module.finrank ℝ E)) := contDiff_interiorChartFlux hX hKc hKi k
  have hfluxc (k : Fin (Module.finrank ℝ E)) : HasCompactSupport (interiorChartFlux α X k) :=
    HasCompactSupport.intro hKc fun _ hz ↦ interiorChartFlux_eq_zero k hz
  have hint (k : Fin (Module.finrank ℝ E)) :
      Integrable (fun z ↦ fderiv ℝ (interiorChartFlux α X k) z (Module.finBasis ℝ E k))
        (Module.finBasis ℝ E).addHaar :=
    ((hflux k).continuous_fderiv one_ne_zero).clm_apply continuous_const
      |>.integrable_of_hasCompactSupport ((hfluxc k).fderiv_apply ℝ _)
  have heq : (∫ x, divergence I X x ∂riemannianVolume I M) =
      ∫ z in interior (extChartAt I α).target,
        chartVolumeDensity (I := I) α ((extChartAt I α).symm z) *
          divergence I X ((extChartAt I α).symm z) ∂(Module.finBasis ℝ E).addHaar := by
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero
      (s := (extChartAt I α).source ∩ extChartAt I α ⁻¹' interior (extChartAt I α).target) ?_]
    · exact setIntegral_native_chart_preimage α isOpen_interior interior_subset _
    · intro x hx
      apply divergence_eq_zero_of_notMem_tsupport I
      intro hxK
      exact hx ⟨hKs' hxK, hKi ⟨x, hxK, rfl⟩⟩
  rw [heq, setIntegral_congr_fun isOpen_interior.measurableSet fun z hz ↦
      (sum_fderiv_interiorChartFlux hX hz).symm,
    setIntegral_eq_integral_of_forall_compl_eq_zero fun z hz ↦ Finset.sum_eq_zero fun k _ ↦ by
      rw [(interiorChartFlux_eventuallyEq_zero hKc k fun h ↦ hz (hKi h)).fderiv_eq]
      simp,
    integral_finsetSum _ fun k _ ↦ hint k]
  exact Finset.sum_eq_zero fun k _ ↦ integral_apply_eq_zero_of_hasFDerivAt_off_countable
    countable_empty (hflux k).continuous (hfluxc k)
    (fun z _ ↦ ((hflux k).differentiable one_ne_zero z).hasFDerivAt) _

end ConformalPoisson

end ProofPart_NativeInteriorDivergence

