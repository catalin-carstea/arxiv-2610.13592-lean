/- Uniform actual pointwise coordinate value/gradient bounds for the SAME
Green row family in a boundary half-ball. The physical face remains part
of its closure; native boundary derivative readback is a later step. -/
open Bundle Set Metric MeasureTheory TauCeti Filter TopologicalSpace Module
open scoped Manifold ContDiff Topology ENNReal NNReal Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem NativeClassicalValueKernel.exists_uniform_boundary_c1_bound
    {g : Metric (n := n) (M := M)} {q : M → ℝ} (hq : Continuous q)
    {a : ℝ≥0} (ha : 1 < a) [Fact (1 ≤ (a : ℝ≥0∞))]
    {K : NativeInverseLpRowFamily g q (a : ℝ≥0∞)} (G : NativeClassicalValueKernel K)
    (c : M) (U : Opens M) (hc : c ∈ U) :
    ∃ r > 0, ∃ C ≥ 0,
      (closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      (nativeClosedChartCap (n := n) c r ⊆ U) ∧
      ∀ x : M, x ∉ (U : Set M) → ∀ z ∈ (splitBoundaryChartCap (n := n) c r : Set P),
        |G.kernel x ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| +
          ‖∇ (fun w : P => G.kernel x ((extChartAt Ihalf c).symm (euclideanNormalSplit n w))) z‖ ≤ C := by
  obtain ⟨b, hb, r₁, hr₁, B, hB, _, _, hBall⟩ :=
    G.exists_uniform_boundary_supercritical_bound hq ha c U hc
  have hdim : finrank ℝ P = n + 1 := by
    rw [(euclideanNormalSplit n).toLinearEquiv.finrank_eq]
    simp
  have hb1 : (1 : ℝ≥0) ≤ b := by
    have hdim1 : (1 : ℝ≥0) ≤ (finrank ℝ P : ℝ≥0) := by rw [hdim]; norm_cast; omega
    exact hdim1.trans hb.le
  letI : Fact (1 ≤ (b : ℝ≥0∞)) := ⟨by exact_mod_cast hb1⟩
  obtain ⟨R₀, hR₀, htarget, hKU, hbound⟩ := exists_native_local_boundary_c1_bound b hb g q hq c U hc
  let R := min r₁ R₀
  have hR : 0 < R := lt_min hr₁ hR₀
  have hRR₀ : R ≤ R₀ := min_le_right _ _
  have hRr₁ : R ≤ r₁ := min_le_left _ _
  obtain ⟨C, hC, hCall⟩ := hbound R hR hRR₀
  have hrR₀ : R / 4 ≤ R₀ := (by linarith : R / 4 ≤ R).trans hRR₀
  refine ⟨R / 4, by positivity, C * B, mul_nonneg hC hB,
    (fun z hz => htarget ⟨closedBall_subset_closedBall hrR₀ hz.1, hz.2⟩),
    (nativeClosedChartCap_mono (n := n) c hrR₀).trans hKU, fun x hx z hz => ?_⟩
  have hf : ContMDiffOn Ihalf 𝓘(ℝ) ∞ (G.kernel x) U :=
    (G.row_smooth x).mono (fun y hy hxy => hx (hxy ▸ hy))
  have hf0 : ∀ y ∈ (U : Set M), (𝓡∂ (n + 1)).IsBoundaryPoint y → G.kernel x y = 0 :=
    fun y _ hy => G.boundary_second x ⟨y, hy⟩
  have hfP : ∀ y ∈ (U : Set M), (𝓡∂ (n + 1)).IsInteriorPoint y → schrodinger g q (G.kernel x) y = 0 :=
    fun y hy hi => G.row_equation x y ⟨hi, fun hxy => hx (hxy ▸ hy)⟩
  have hsmall : lpNorm
      (fun z : P => G.kernel x ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (b : ℝ≥0∞)
      (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤ B :=
    (lpNorm_mono_measure (hBall x hx).1
      (Measure.restrict_mono (splitBoundaryChartCap_mono c hRr₁) le_rfl)).trans (hBall x hx).2
  exact (hCall (G.kernel x) hf hf0 hfP z hz).trans (mul_le_mul_of_nonneg_left hsmall hC)

