theorem coordinatePushforward_tsupport_target
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (f : H → F) (hf : HasCompactSupport f) (hs : tsupport f ⊆ χ.source) :
    tsupport (coordinatePushforward χ f) ⊆ χ.target := by
  intro x hx
  obtain ⟨z, hz, rfl⟩ := tsupport_coordinatePushforward_subset_image χ f hf hs hx
  exact χ.map_source (hs hz)

