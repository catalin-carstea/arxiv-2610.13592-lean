/- Proof support: NativeChartAE.lean, SHA256 c8d91a241adfa3e326c43d037f6cdddfa93b6901e1e4ec3e8a723b12b3dfbf81 -/
noncomputable section ProofPart_NativeChartAE



/- Transport actual almost-everywhere statements between native
Riemannian volume and the coordinate Haar measure on chart caps. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff Topology ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
  [MeasurableSpace E] [BorelSpace E]

without_proof_info in
theorem ae_native_chart_symm (c : M) {Ω : TopologicalSpace.Opens E}
    (hΩt : (Ω : Set E) ⊆ (extChartAt I c).target) {P : M → Prop}
    (hP : ∀ᵐ x ∂riemannianVolume I M, P x) :
    ∀ᵐ z ∂(Module.finBasis ℝ E).addHaar.restrict Ω, P ((extChartAt I c).symm z) := by
  classical
  let A := {x : M | ¬ P x} ∩ (extChartAt I c).source
  have hA : riemannianVolume I M A = 0 := measure_mono_null inter_subset_left (ae_iff.1 hP)
  have hnull : (Module.finBasis ℝ E).addHaar (extChartAt I c '' A) = 0 :=
    (riemannianVolume_eq_zero_iff_image_of_subset (I := I) (α := c)
      (show A ⊆ (extChartAt I c).source from inter_subset_right) (Module.finBasis ℝ E).addHaar).1 hA
  rw [ae_restrict_iff' Ω.isOpen.measurableSet]
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hnull] with z hz hzΩ
  by_contra h
  apply hz
  exact ⟨(extChartAt I c).symm z, ⟨h, (extChartAt I c).map_target (hΩt hzΩ)⟩,
    (extChartAt I c).right_inv (hΩt hzΩ)⟩

without_proof_info in
theorem ae_native_chart_preimage (c : M) {Ω : TopologicalSpace.Opens E}
    (hΩt : (Ω : Set E) ⊆ (extChartAt I c).target) {P : M → Prop}
    (hP : ∀ᵐ z ∂(Module.finBasis ℝ E).addHaar.restrict Ω, P ((extChartAt I c).symm z)) :
    ∀ᵐ x ∂(riemannianVolume I M).restrict
      ((extChartAt I c).source ∩ extChartAt I c ⁻¹' (Ω : Set E)), P x := by
  classical
  let S := (extChartAt I c).source ∩ extChartAt I c ⁻¹' (Ω : Set E)
  let A := S ∩ {x : M | ¬ P x}
  have hc := (ae_restrict_iff' Ω.isOpen.measurableSet).1 hP
  have hnull : (Module.finBasis ℝ E).addHaar (extChartAt I c '' A) = 0 := by
    apply measure_mono_null ?_ (ae_iff.1 hc)
    rintro z ⟨x, ⟨⟨hxs, hxΩ⟩, hxP⟩, rfl⟩ h
    apply hxP
    have hp := h hxΩ
    rwa [(extChartAt I c).left_inv hxs] at hp
  have hA : riemannianVolume I M A = 0 :=
    (riemannianVolume_eq_zero_iff_image_of_subset (I := I) (α := c)
      (show A ⊆ (extChartAt I c).source from fun x hx => hx.1.1) (Module.finBasis ℝ E).addHaar).2 hnull
  rw [ae_restrict_iff' (isOpen_extChartAt_preimage' c Ω.isOpen).measurableSet]
  filter_upwards [measure_eq_zero_iff_ae_notMem.1 hA] with x hx hxS
  by_contra h
  exact hx ⟨hxS, h⟩
end ConformalPoisson


end ProofPart_NativeChartAE

/- Proof support: NativeChartValueReadback.lean, SHA256 d21b4d11934f0b9087561604441d1a9b34d6a4046441b4b033aa2d8353e296af -/
noncomputable section ProofPart_NativeChartValueReadback





/- The completed chart value reading is the pullback of the actual
native L2 value. Smooth density, two a.e. subsequences and chart null-set
transport prove this without a separate H1 injectivity premise. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.BoundaryChartLocalization
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [CompactSpace M] [IsManifold I 2 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
  [MeasurableSpace M] [BorelSpace M]
local notation "V" => EuclideanSpace ℝ (Fin d)
local instance chartValueContinuousMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := 1)
open DirichletSobolev
variable {c : M} (L : BoundaryChartLocalization (I := I) c)

without_proof_info in
theorem innerReadingL_smooth_native_value_ae
    (v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    W1p.value (L.innerReadingL (smoothInclusion (I := I) {x : M | I.IsBoundaryPoint x} v))
      =ᵐ[(Module.finBasis ℝ V).addHaar.restrict L.innerCap]
        fun z => valueL (I := I) {x : M | I.IsBoundaryPoint x}
          (smoothInclusion (I := I) {x : M | I.IsBoundaryPoint x} v) ((extChartAt I c).symm z) := by
  have hn : (valueL (I := I) {x : M | I.IsBoundaryPoint x}
      (smoothInclusion (I := I) {x : M | I.IsBoundaryPoint x} v) : M → ℝ)
      =ᵐ[riemannianVolume I M] v.val := by
    change SobolevH1.toLp (SobolevH1.ofSmooth v.val) =ᵐ[riemannianVolume I M] v.val
    exact SobolevH1.toLp_ofSmooth_ae_eq v.val
  have hnc : (fun z => valueL (I := I) {x : M | I.IsBoundaryPoint x}
      (smoothInclusion (I := I) {x : M | I.IsBoundaryPoint x} v) ((extChartAt I c).symm z))
      =ᵐ[(Module.finBasis ℝ V).addHaar.restrict L.innerCap] fun z => v.val ((extChartAt I c).symm z) :=
    ae_native_chart_symm c (Ω := L.innerCap)
      (L.innerCap_subset_interior_target.trans interior_subset) hn
  exact (L.innerReadingL_smooth_value_ae v).trans hnc.symm

without_proof_info in
theorem innerReadingL_native_value_ae
    (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x}) :
    W1p.value (L.innerReadingL u) =ᵐ[(Module.finBasis ℝ V).addHaar.restrict L.innerCap]
      fun z => valueL (I := I) {x : M | I.IsBoundaryPoint x} u ((extChartAt I c).symm z) := by
  classical
  let B := {x : M | I.IsBoundaryPoint x}
  let μ := (Module.finBasis ℝ V).addHaar
  let T := (W1p.valueL (mu := μ) (Omega := L.innerCap) (p := 2)).comp L.innerReadingL
  have hT (v : zeroTraceSubmodule (I := I) B) : T v = W1p.value (L.innerReadingL v) :=
    W1p.valueL_apply _
  obtain ⟨s, hs, hsu⟩ := mem_closure_iff_seq_limit.1 ((denseRange_smoothInclusion (I := I) B) u)
  choose v hv using hs
  have hvu : Tendsto (fun j : ℕ => smoothInclusion (I := I) B (v j)) atTop (𝓝 u) := by
    have heq : (fun j : ℕ => smoothInclusion (I := I) B (v j)) = s := funext hv
    rw [heq]
    exact hsu
  have hn := ((valueL (I := I) B).continuous.tendsto u).comp hvu
  obtain ⟨ns, hns, hna⟩ := (tendstoInMeasure_of_tendsto_Lp hn).exists_seq_tendsto_ae
  have ht := (T.continuous.tendsto u).comp (hvu.comp hns.tendsto_atTop)
  obtain ⟨ms, hms, hta⟩ := (tendstoInMeasure_of_tendsto_Lp ht).exists_seq_tendsto_ae
  have hnc := ae_native_chart_symm c (Ω := L.innerCap)
    (L.innerCap_subset_interior_target.trans interior_subset) hna
  have hsm : ∀ᵐ z ∂μ.restrict L.innerCap, ∀ j : ℕ,
      T (smoothInclusion (I := I) B (v j)) z =
        valueL (I := I) B (smoothInclusion (I := I) B (v j)) ((extChartAt I c).symm z) := by
    refine ae_all_iff.2 fun j => ?_
    rw [hT]
    exact L.innerReadingL_smooth_native_value_ae (v j)
  have hAE : (T u : V → ℝ) =ᵐ[μ.restrict L.innerCap]
      fun z => valueL (I := I) B u ((extChartAt I c).symm z) := by
    filter_upwards [hta, hnc, hsm] with z hz hzn hzs
    apply tendsto_nhds_unique hz
    have hnz := hzn.comp hms.tendsto_atTop
    simpa only [Function.comp_def, hzs] using hnz
  rw [hT] at hAE
  exact hAE
end ConformalPoisson.BoundaryChartLocalization


end ProofPart_NativeChartValueReadback

