noncomputable section ProofPart_BoundaryAnalytic_BoundaryActualReflectionJets




/- C3 odd reflection of the same smooth one-sided function. The only
second-order face condition is its actual zero second normal trace, which
the normalized scalar equation and finite trace lift must supply. -/
open Set Metric
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem boundary_actual_three_jet_compatibility
    {S : Set V} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S)) {u : V → ℝ}
    (hu : ContDiffOn ℝ ∞ u S) {r : ℝ}
    (hcap : ball (0 : V) r ∩ {x : V | 0 ≤ x 0} ⊆ S)
    (hzero : ∀ x ∈ ball (0 : V) r, x 0 = 0 → u x = 0)
    (hnn : ∀ x ∈ ball (0 : V) r, x 0 = 0 →
      iteratedFDerivWithinAlong S [e, e] u x = 0)
    {x : V} (hx : x ∈ ball (0 : V) r) (hx0 : x 0 = 0)
    (k : ℕ) (hk : k ≤ 3) :
    iteratedFDerivWithin ℝ k u S x =
      -(iteratedFDerivWithin ℝ k u S x).compContinuousLinearMap
        (fun _ => (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap) := by
  have hxS : x ∈ S := hcap ⟨hx, le_of_eq hx0.symm⟩
  apply odd_reflection_three_jet_compatibility (ftaylorSeriesWithin ℝ u S x)
  · intro j _ m hm
    exact boundary_tangent_iteratedFDerivWithin_eq_zero hS hu hcap hzero hx hx0 m hm
  · change iteratedFDerivWithin ℝ 2 u S x ![e, e] = 0
    rw [← iteratedFDerivWithinAlong_ofFn hS hu ![e, e] hxS]
    simpa [List.ofFn_succ] using hnn x hx hx0
  · intro v hv
    change iteratedFDerivWithin ℝ 3 u S x ![v, e, e] = 0
    rw [← iteratedFDerivWithinAlong_ofFn hS hu ![v, e, e] hxS]
    simpa [List.ofFn_succ] using
      boundary_third_normal_normal_tangent_eq_zero hS hu hcap hnn hx hx0 hv
  · intro v hv
    change iteratedFDerivWithin ℝ 3 u S x ![e, v, e] = 0
    rw [← iteratedFDerivWithinAlong_ofFn hS hu ![e, v, e] hxS]
    have hperm : ([e, v, e] : List V).Perm [v, e, e] := List.Perm.swap v e [e]
    have heq := iteratedFDerivWithinAlong_eq_of_perm hS hclosure hu hperm hxS
    simpa [List.ofFn_succ] using heq.trans
      (boundary_third_normal_normal_tangent_eq_zero hS hu hcap hnn hx hx0 hv)
  · intro v hv
    change iteratedFDerivWithin ℝ 3 u S x ![e, e, v] = 0
    rw [← iteratedFDerivWithinAlong_ofFn hS hu ![e, e, v] hxS]
    have hperm : ([e, e, v] : List V).Perm [v, e, e] :=
      (List.Perm.cons e (List.Perm.swap v e [])).trans (List.Perm.swap v e [e])
    have heq := iteratedFDerivWithinAlong_eq_of_perm hS hclosure hu hperm hxS
    simpa [List.ofFn_succ] using heq.trans
      (boundary_third_normal_normal_tangent_eq_zero hS hu hcap hnn hx hx0 hv)
  · exact hk

without_proof_info in
theorem contDiffOn_boundaryOddReflection_of_zero_normal_second_trace
    {S : Set V} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S)) {u : V → ℝ}
    (hu : ContDiffOn ℝ ∞ u S) {R r : ℝ} (hr : r < R)
    (hcap : ball (0 : V) R ∩ {x : V | 0 ≤ x 0} ⊆ S)
    (hzero : ∀ x ∈ ball (0 : V) R, x 0 = 0 → u x = 0)
    (hnn : ∀ x ∈ ball (0 : V) R, x 0 = 0 →
      iteratedFDerivWithinAlong S [e, e] u x = 0) :
    ContDiffOn ℝ 3 (boundaryOddReflection u) (closedBall (0 : V) r) := by
  have hball : closedBall (0 : V) r ⊆ ball (0 : V) R := closedBall_subset_ball hr
  apply contDiffOn_boundaryOddReflection_of_matching_jets u (ftaylorSeriesWithin ℝ u S) r
  · exact ((hu.ftaylorSeriesWithin hS).of_le (by simp)).mono
      (fun x hx => hcap ⟨hball hx.1, hx.2⟩)
  · intro x hx hx0
    exact hzero x (hball hx) hx0
  · intro x hx hx0 k hk
    exact boundary_actual_three_jet_compatibility hS hclosure hu hcap hzero hnn
      (hball hx) hx0 k hk

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryActualReflectionJets

/- Boundary analytic support: RelativeBoundaryEquation.lean, SHA256 f2b590c367b75fa8713c8db1a9e809f29eabf63c2107b2ee3492359281396e46 -/
noncomputable section ProofPart_BoundaryAnalytic_RelativeBoundaryEquation



/- The SAME signed scalar equation extends to a physical face through its
relative jets. In normal form, zero trace and zero source force u_tt=0. -/
open Set Metric
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

def relativeCoordinateSchrodinger (S : Set V)
    (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ) (x : V) : ℝ :=
  -(∑ i, iteratedFDerivWithin ℝ 2 u S x
    ![EuclideanSpace.single i 1, A x (EuclideanSpace.single i 1)]) +
    fderivWithin ℝ u S x (b x) + q x * u x

without_proof_info in
theorem relativeCoordinateSchrodinger_eq_coordinateSchrodinger
    {S : Set V} (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ)
    {x : V} (hx : x ∈ interior S) :
    relativeCoordinateSchrodinger S A b q u x = coordinateSchrodinger A b q u x := by
  simp only [relativeCoordinateSchrodinger, coordinateSchrodinger,
    iteratedFDerivWithin_eq_of_mem_interior hx,
    iteratedFDeriv_two_apply, Matrix.cons_val_zero, Matrix.cons_val_one,
    fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp hx)]

without_proof_info in
theorem continuousOn_relativeCoordinateSchrodinger
    {S : Set V} (hS : UniqueDiffOn ℝ S)
    {A : V → V →L[ℝ] V} {b : V → V} {q u : V → ℝ}
    (hA : ContinuousOn A S) (hb : ContinuousOn b S) (hq : ContinuousOn q S)
    (hu : ContDiffOn ℝ 2 u S) :
    ContinuousOn (relativeCoordinateSchrodinger S A b q u) S := by
  have hD := hu.fderivWithin hS (m := 1) (by norm_num)
  have hDD := (hD.fderivWithin hS (m := 0) (by norm_num)).continuousOn
  have hsum : ContinuousOn (fun x => ∑ i : Fin (n + 1),
      fderivWithin ℝ (fderivWithin ℝ u S) S x
        (EuclideanSpace.single i 1) (A x (EuclideanSpace.single i 1))) S :=
    continuousOn_finsetSum _ (fun i _ =>
      (hDD.clm_apply continuousOn_const).clm_apply (hA.clm_apply continuousOn_const))
  have hresult := hsum.neg.add
    ((hD.continuousOn.clm_apply hb).add (hq.mul hu.continuousOn))
  apply hresult.congr
  intro x hx
  simp only [relativeCoordinateSchrodinger,
    iteratedFDerivWithin_two_apply' u hS hx, Pi.add_apply, Pi.neg_apply, Pi.mul_apply]
  ring

without_proof_info in
theorem relativeCoordinateSchrodinger_eq_source_on_closure
    {S : Set V} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {A : V → V →L[ℝ] V} {b : V → V} {q u source : V → ℝ}
    (hA : ContinuousOn A S) (hb : ContinuousOn b S) (hq : ContinuousOn q S)
    (hu : ContDiffOn ℝ ∞ u S) (hf : ContinuousOn source S)
    (hLu : ∀ x ∈ interior S, coordinateSchrodinger A b q u x = source x) :
    EqOn (relativeCoordinateSchrodinger S A b q u) source S := by
  have heq : EqOn (relativeCoordinateSchrodinger S A b q u) source (interior S) := by
    intro x hx
    rw [relativeCoordinateSchrodinger_eq_coordinateSchrodinger A b q u hx]
    exact hLu x hx
  exact heq.of_subset_closure
    (continuousOn_relativeCoordinateSchrodinger hS hA hb hq (hu.of_le (by simp)))
    hf interior_subset hclosure

without_proof_info in
theorem continuousOn_coordinateSchrodinger_of_c2
    {U : Set V} (hU : IsOpen U)
    {A : V → V →L[ℝ] V} {b : V → V} {q u : V → ℝ}
    (hA : ContinuousOn A U) (hb : ContinuousOn b U) (hq : ContinuousOn q U)
    (hu : ContDiffOn ℝ 2 u U) : ContinuousOn (coordinateSchrodinger A b q u) U := by
  apply (continuousOn_relativeCoordinateSchrodinger hU.uniqueDiffOn hA hb hq hu).congr
  intro x hx
  exact (relativeCoordinateSchrodinger_eq_coordinateSchrodinger A b q u
    (by rwa [hU.interior_eq])).symm

set_option maxHeartbeats 600000 in
without_proof_info in
theorem boundary_normal_second_trace_eq_zero_of_equation
    {S : Set V} (hS : UniqueDiffOn ℝ S) {u : V → ℝ}
    (hu : ContDiffOn ℝ ∞ u S) {r : ℝ}
    (hcap : ball (0 : V) r ∩ {x : V | 0 ≤ x 0} ⊆ S)
    (hzero : ∀ x ∈ ball (0 : V) r, x 0 = 0 → u x = 0)
    (A : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ)
    {x : V} (hx : x ∈ ball (0 : V) r) (hx0 : x 0 = 0)
    (hAn : A x e = e)
    (hAt : ∀ i : Fin (n + 1), i ≠ 0 → (A x (EuclideanSpace.single i 1)) 0 = 0)
    (hb : b x 0 = 0) (hLu : relativeCoordinateSchrodinger S A b q u x = 0) :
    iteratedFDerivWithinAlong S [e, e] u x = 0 := by
  classical
  have hxS : x ∈ S := hcap ⟨hx, le_of_eq hx0.symm⟩
  have hsum : (∑ i : Fin (n + 1), iteratedFDerivWithin ℝ 2 u S x
      ![EuclideanSpace.single i 1, A x (EuclideanSpace.single i 1)]) =
      iteratedFDerivWithin ℝ 2 u S x ![e, e] := by
    rw [Finset.sum_eq_single 0]
    · rw [hAn]
    · intro i _ hi
      apply boundary_tangent_iteratedFDerivWithin_eq_zero hS hu hcap hzero hx hx0
      intro j
      fin_cases j
      · simp [hi, Ne.symm hi]
      · exact hAt i hi
    · simp
  have hfirst := boundary_tangent_fderivWithin_eq_zero hS hu hcap hzero hx hx0 hb
  simp only [relativeCoordinateSchrodinger, hsum, hfirst, hzero x hx hx0,
    mul_zero, add_zero, neg_eq_zero] at hLu
  rw [← iteratedFDerivWithinAlong_ofFn hS hu ![e, e] hxS] at hLu
  simpa [List.ofFn_succ] using hLu

end ConformalPoisson

