        (fun i hi => hmono i (hi.trans (Nat.lt_succ_self N)))
        (fun i hi => hgap i (hi.trans (Nat.lt_succ_self N))) R₁ hR₁
      refine ⟨R₀, hR₀, hR₀₁.trans hR₁Max, htarget, fun R hR hRR₀ => ?_⟩
