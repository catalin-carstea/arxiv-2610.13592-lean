without_proof_info in
theorem denseRange_nativeSmoothValueLinearMap :
    DenseRange (nativeSmoothValueLinearMap (n := n) (M := M)) := by
  intro F
  apply Metric.mem_closure_iff.mpr
  intro ε hε
  obtain ⟨G, hG, -⟩ := F.continuous.exists_contMDiff_approx Ihalf (⊤ : ℕ∞)
