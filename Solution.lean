    ⟨fun z => (extChartAt Ihalf c).symm z,
      continuousOn_iff_continuous_restrict.mp ((continuousOn_extChartAt_symm c).mono hchart)⟩
  have hψU : ∀ z : closure (Ω : Set V), ψ z ∈ (U : Set M) :=
    fun z => hKU ⟨z, closure_boundaryChartCap_subset (I := Ihalf) c r z.property, rfl⟩
  have hmap : Continuous (fun t : A × closure (Ω : Set V) => (pole t.1, ψ t.2)) :=
    (pole.continuous.comp continuous_fst).prodMk (ψ.continuous.comp continuous_snd)
  let k : C(A × closure (Ω : Set V), ℝ) :=
    ⟨fun t => G.kernel (pole t.1) (ψ t.2), continuousOn_univ.mp
      (hG.comp hmap.continuousOn (by
        intro t _ ht
        have ht' : pole t.1 = ψ t.2 := ht
        exact hPole t.1 (ht'.symm ▸ hψU t.2)))⟩
  have hrow : ∀ a, continuousKernelLpSections (μ := μ) (p := 2) k a =ᵐ[μ.restrict (Ω : Set V)]
