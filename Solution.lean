/- The actual native divergence integral of a field compactly supported
in one chart equals its standard-coordinate physical-face flux. Nullity of
the model face is used only in the volume calculation. -/
open Bundle Module MeasureTheory Set Filter TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integral_native_divergence_chart (g : Metric (n := n) (M := M)) (α : M)
    (X : (x : M) → TangentSpace Ihalf x)
    (hX : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M)))
    (hK : IsCompact (tsupport (α := V) X))
    (hKs : tsupport (α := V) X ⊆ (extChartAt Ihalf α).source) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
      IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
    Integrable (fun y : EuclideanSpace ℝ (Fin n) =>
      supportedNativeCoordinateFlux g α X (euclideanHalfSpaceBoundaryParam n y) 0) ∧
    (∫ x, divergence Ihalf X x ∂nativeVolume g) =
      -(∫ y : EuclideanSpace ℝ (Fin n),
        supportedNativeCoordinateFlux g α X (euclideanHalfSpaceBoundaryParam n y) 0) := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let c := extChartAt Ihalf α
  let T := range Ihalf
  let Φ := supportedNativeCoordinateFlux g α X
  let f : V → ℝ := fun z => nativeStandardChartDensity g α (c.symm z) * divergence Ihalf X (c.symm z)
  have hT : MeasurableSet T := by
    dsimp only [T]
    rw [range_modelWithCornersEuclideanHalfSpace]
    exact isClosed_le continuous_const (EuclideanSpace.proj 0).continuous |>.measurableSet
  have hTarget : MeasurableSet c.target := by
    rw [← c.image_source_eq_target]
    exact measurableSet_image_native_chart α (isOpen_extChartAt_source α).measurableSet subset_rfl
  have hSourceInt : (∫ x, divergence Ihalf X x ∂nativeVolume g) = ∫ z in c.target, f z := by
    have hzero : ∀ x, x ∉ c.source → divergence Ihalf X x = 0 := by
      intro x hx
      exact divergence_eq_zero_of_notMem_tsupport Ihalf (fun h => hx (hKs h))
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
    have hsub : c.source ⊆ (chartAt (EuclideanHalfSpace (n + 1)) α).source := by
      simp only [c, extChartAt_source, subset_refl]
    have heq := setIntegral_nativeVolume_eq_standard (I := Ihalf) α
      (isOpen_extChartAt_source α).measurableSet hsub (fun x => divergence Ihalf X x)
    rw [c.image_source_eq_target] at heq
    exact heq
  have hAEInterior : ∀ᵐ z ∂volume.restrict T, z ∈ interior T := by
    have hAi := interior_ae_eq_of_null_frontier ((Ihalf).convex_range.addHaar_frontier (volume : Measure V))
    filter_upwards [ae_restrict_of_ae hAi, ae_restrict_mem hT] with z hz hzT
    exact hz.mpr hzT
  have hTrace (A : V →L[ℝ] V) : LinearMap.trace ℝ V A =
      ∑ i : Fin (n + 1), (A (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)) i := by
    rw [LinearMap.trace_eq_sum_inner _ (EuclideanSpace.basisFun (Fin (n + 1)) ℝ)]
    simp only [EuclideanSpace.basisFun_inner]
    apply Finset.sum_congr rfl
    intro i _
    rfl
  have hAE : (fun z => ∑ i : Fin (n + 1),
      (fderivWithin ℝ Φ T z (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)) i) =ᵐ[volume.restrict T]
      c.target.indicator f := by
    filter_upwards [hAEInterior] with z hz
    exact (hTrace _).symm.trans (supportedNativeCoordinateFlux_divergence g α X hX hK hKs hz)
  obtain ⟨hDi, hBi, hHalf⟩ := integral_divergence_euclideanHalfSpace
    (supportedNativeCoordinateFlux_contDiffOn g α X hX hK hKs)
    (supportedNativeCoordinateFlux_hasCompactSupport g α X hK hKs)
  refine ⟨hBi, hSourceInt.trans ?_⟩
  calc
    (∫ z in c.target, f z) = ∫ z in T, c.target.indicator f z := by
      rw [setIntegral_indicator hTarget, inter_eq_right.mpr (extChartAt_target_subset_range α)]
    _ = ∫ z in T, ∑ i : Fin (n + 1),
        (fderivWithin ℝ Φ T z (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)) i :=
      integral_congr_ae hAE.symm
    _ = _ := hHalf
end ConformalPoisson

