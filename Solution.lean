/- A smooth zero-boundary function with nonzero actual normal derivative. -/

open Set Filter
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
/-- A chart boundary coordinate times a smooth bump supplies the test function in Lemma 3.6. -/
theorem exists_zero_boundary_normal_ne_zero
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (y : (𝓡∂ (n + 1)).boundary M) (hν : TauCeti.IsOutwardPointing (y : M) (ν y)) :
    ∃ w : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w ∧
      (∀ z : (𝓡∂ (n + 1)).boundary M, w z = 0) ∧ normalDerivative ν w y ≠ 0 := by
  obtain ⟨b, _, _⟩ :=
    (SmoothBumpFunction.nhds_basis_tsupport (I := 𝓡∂ (n + 1)) (y : M)).mem_iff.mp
      (univ_mem : (univ : Set M) ∈ 𝓝 (y : M))
  let t : M → ℝ := EuclideanSpace.proj (0 : Fin (n + 1)) ∘
    extChartAt (𝓡∂ (n + 1)) (y : M)
  have ht : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ t
      (chartAt (EuclideanHalfSpace (n + 1)) (y : M)).source := by
    dsimp only [t]
    exact (EuclideanSpace.proj (0 : Fin (n + 1)) :
      EuclideanSpace ℝ (Fin (n + 1)) →L[ℝ] ℝ).contMDiff.comp_contMDiffOn
        (contMDiffOn_extChartAt (I := 𝓡∂ (n + 1)) (x := (y : M)))
  let w : M → ℝ := fun z => b z * t z
  have hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w := by
    simpa only [w, smul_eq_mul] using b.contMDiff_smul ht
  have htrace (z : (𝓡∂ (n + 1)).boundary M) : w z = 0 := by
    by_cases hbz : b z = 0
    · simp only [w, hbz, zero_mul]
    · have hzsource := b.support_subset_source hbz
      have htzero :=
        (TauCeti.ModelWithCorners.mem_boundary_euclideanHalfSpace_iff_of_mem_atlas
          (k := ω) (by decide) (chart_mem_atlas (EuclideanHalfSpace (n + 1)) (y : M))
          hzsource).mp z.property
      have htz : t z = 0 := by
        simpa only [t, Function.comp_apply, EuclideanSpace.coe_proj, extChartAt_coe,
          modelWithCornersEuclideanHalfSpace_toFun] using htzero
      simp only [w, htz, mul_zero]
  have hwt : w =ᶠ[𝓝 (y : M)] t := by
    filter_upwards [b.eventuallyEq_one] with z hz
    simp only [w, hz, Pi.one_apply, one_mul]
  have hchart : ∀ᶠ z in 𝓝 (y : M),
      (chartAt (EuclideanHalfSpace (n + 1)) (y : M) z).1 0 = 1 * (t z - 0) := by
    exact .of_forall fun z => by
      simp only [t, Function.comp_apply, EuclideanSpace.coe_proj, extChartAt_coe,
        modelWithCornersEuclideanHalfSpace_toFun, sub_zero, one_mul]
  have htν := (TauCeti.isOutwardPointing_iff_mul_mvfderiv_neg y.property one_ne_zero hchart
    (ν y)).mp hν
  refine ⟨w, hw, htrace, ?_⟩
  rw [normalDerivative_eq_of_eventuallyEq ν y hwt]
  exact ne_of_lt (by simpa only [normalDerivative, one_mul] using htν)

end ConformalPoisson

end ProofPart_BoundaryTestFunction

