    rw [Lp.norm_eq_lpNorm_of_ae_eq (Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 1 u)]
    have hhalf := hH (R / 2) (half_pos hR) (half_lt_self hR)
