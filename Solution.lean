    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (U : TopologicalSpace.Opens M) (h : Metric (n := n) (M := U)) (p c : U → ℝ)
    (hc : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ c) (hcpos : ∀ x, 0 < c x)
    (k : ℝ) (hk : 0 < k)
    (hmetric : h = (conformalGaugeMetric (g.restrictOpenTangentSpace U) c hc hcpos).rescale
      (fun _ => k) contMDiff_const (fun _ => hk))
    (x : U) (hx : (𝓡∂ (n + 1)).IsInteriorPoint (x : M))
    (hhom : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      schrodinger h p (fun y : U => S.solve f.val y / c y) x = 0) :
    p x = k⁻¹ * conformalGaugePotential (g.restrictOpenTangentSpace U) (fun y : U => q y) c x := by
