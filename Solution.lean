    hconnected hq hNR S Γ hΓ (x : M) hx a (ξ.comp e.symm.toContinuousLinearMap)
  refine ⟨f, hf, ?_⟩
  have hu := (S.correct f.val f.property.1).1.mdifferentiable (by decide)
  change mfderiv (𝓡∂ (n + 1)) 𝓘(ℝ) (S.solve f.val ∘ (Subtype.val : U → M)) x = ξ
  rw [mfderiv_comp x (hu x) (contMDiff_subtype_val.mdifferentiableAt (by decide : (∞ : ℕ∞ω) ≠ 0)),
    TauCeti.Manifold.mfderiv_subtype_val]
  change ((mvfderiv (𝓡∂ (n + 1)) (S.solve f.val) (x : M)).comp e.toContinuousLinearMap) = ξ
  rw [hD]
  ext v
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
    ContinuousLinearEquiv.symm_apply_apply]

end ConformalPoisson

