theorem norm_conjugate_principal_isometry (e : E ≃ₗᵢ[ℝ] F) (A : F →L[ℝ] F) :
    ‖(e.symm : F →L[ℝ] E) ∘L A ∘L (e : E →L[ℝ] F)‖ = ‖A‖ := by
  rw [ContinuousLinearMap.opNorm_linearIsometryEquiv_comp,
