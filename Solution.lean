without_proof_info in
theorem exists_native_residualLp_bound
    (hM : IsCompact (univ : Set M)) (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) :
    ∃ C ≥ 0, ∀ u : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u →
      ∀ B : ℝ, 0 ≤ B → (∀ x, |schrodinger g q u x| ≤ B) →
        (eLpNorm (schrodinger g q u) (ENNReal.ofReal (n + 2 : ℝ)) (nativeVolume g)).toReal ≤ C * B := by
  let : CompactSpace M := isCompact_univ_iff.mp hM
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  obtain ⟨C, hC, hbound⟩ := exists_eLpNorm_toReal_bound_of_uniform_bound
    (E := ℝ) (nativeVolume g) (ENNReal.ofReal (n + 2 : ℝ))
  refine ⟨C, hC, ?_⟩
  intro u hu B hB hb
  exact hbound (schrodinger g q u)
    (contMDiff_schrodinger g q u hq hu).continuous.stronglyMeasurable.aestronglyMeasurable
