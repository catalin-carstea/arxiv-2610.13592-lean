/- Assignment268, /root. Uniform finite normal Taylor remainders on ONE
fixed compact cylinder. Only the finite order needed by each residual is used. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Metric Finset
open scoped ContDiff
namespace ConformalPoisson.LocalDN
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

without_proof_info in
theorem iteratedDeriv_slice_eq_directionalJet {G : E × ℝ → F} (y : E) (t : ℝ)
    (hG : AnalyticAt ℝ G (y, t)) (j : ℕ) :
    iteratedDeriv j (fun s : ℝ => G (y, s)) t = ambientDirectionalJet ((0 : E), 1) j G (y, t) := by
  have hp : (y, (0 : ℝ)) + t • ((0 : E), (1 : ℝ)) = (y, t) := by simp
  have he : (fun s : ℝ => G ((y, (0 : ℝ)) + s • ((0 : E), (1 : ℝ)))) = fun s => G (y, s) := by
    funext s
    simp
  simpa only [he, hp] using ambientDirectionalJet_line ((0 : E), (1 : ℝ)) (G := G) (y, 0)
    (t := t) (hp.symm ▸ hG) j

without_proof_info in
theorem exists_uniform_normal_taylor_bound
    {O : Set (E × ℝ)} {G : E × ℝ → F} (hG : AnalyticOnNhd ℝ G O)
    {K : Set E} (hK : IsCompact K) {r : ℝ} (hr : 0 < r)
    (hrect : K ×ˢ Icc (0 : ℝ) r ⊆ O) (N : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y ∈ K, ∀ t ∈ Icc (0 : ℝ) r,
      ‖G (y, t) - ∑ j ∈ range (N + 1),
        (t ^ j / (j.factorial : ℝ)) • iteratedDeriv j (fun s : ℝ => G (y, s)) 0‖ ≤ C * t ^ (N + 1) := by
  have hjet : ContinuousOn (ambientDirectionalJet ((0 : E), 1) (N + 1) G) (K ×ˢ Icc (0 : ℝ) r) := by
    intro x hx
    exact (ambientDirectionalJet_analyticAt ((0 : E), 1) (hG x (hrect hx)) (N + 1)).continuousAt.continuousWithinAt
  obtain ⟨M, hM⟩ := (hK.prod isCompact_Icc).exists_bound_of_continuousOn hjet
  let B : ℝ := max 0 M
  have hB : 0 ≤ B := le_max_left _ _
  have hfac : 0 < (N.factorial : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos N)
  refine ⟨B / (N.factorial : ℝ), div_nonneg hB hfac.le, ?_⟩
  intro y hy t ht
  have hsmooth : ∀ s ∈ Icc (0 : ℝ) r, ContDiffAt ℝ ∞ (fun u : ℝ => G (y, u)) s := by
    intro s hs
    exact (hG (y, s) (hrect ⟨hy, hs⟩)).contDiffAt.comp s (contDiffAt_const.prodMk contDiffAt_id)
  have h0 : (0 : ℝ) ∈ Icc 0 r := ⟨le_rfl, hr.le⟩
  have huni : UniqueDiffOn ℝ (Icc (0 : ℝ) r) := uniqueDiffOn_Icc hr
  have hbound : ∀ s ∈ Icc (0 : ℝ) r,
      ‖iteratedDerivWithin (N + 1) (fun u : ℝ => G (y, u)) (Icc (0 : ℝ) r) s‖ ≤ B := by
    intro s hs
    rw [iteratedDerivWithin_eq_iteratedDeriv huni ((hsmooth s hs).of_le (by simp)) hs,
      iteratedDeriv_slice_eq_directionalJet y s (hG (y, s) (hrect ⟨hy, hs⟩)) (N + 1)]
    exact (hM (y, s) ⟨hy, hs⟩).trans (le_max_right _ _)
  have hp : taylorWithinEval (fun u : ℝ => G (y, u)) N (Icc (0 : ℝ) r) 0 t =
      ∑ j ∈ range (N + 1), (t ^ j / (j.factorial : ℝ)) • iteratedDeriv j (fun s : ℝ => G (y, s)) 0 := by
    rw [taylor_within_apply]
    apply sum_congr rfl
    intro j hj
    rw [iteratedDerivWithin_eq_iteratedDeriv huni ((hsmooth 0 h0).of_le (by simp)) h0]
    simp only [sub_zero, div_eq_mul_inv, mul_comm]
  have hb := taylor_mean_remainder_bound hr.le
    (fun s hs => ((hsmooth s hs).of_le (by simp)).contDiffWithinAt) ht hbound
  rw [hp] at hb
  simpa only [sub_zero, div_mul_eq_mul_div] using hb

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNNormalTaylorBound

