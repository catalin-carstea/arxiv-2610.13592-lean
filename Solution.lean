  coe_injective f g h := by
    obtain ⟨⟨_, _⟩, _⟩ := f
    obtain ⟨⟨_, _⟩, _⟩ := g
    congr

instance : HomotopyLike (Homotopy f₀ f₁) f₀ f₁ where
