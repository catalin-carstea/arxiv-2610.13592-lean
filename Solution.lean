local notation "P" => WithLp 2 (ℝ × E)
variable {r : ℝ≥0} [Fact (1 ≤ (r : ℝ≥0∞))]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_wholeSpace_classical_directional_bound
    (hr : (finrank ℝ P : ℝ≥0) < r) (v : P) :
    ∃ C ≥ 0, ∀ u : Wkp (volume : Measure P) ⊤ (r : ℝ≥0∞) 2,
      ∀ (U : Opens P), ∀ f : P → ℝ,
        ContDiffOn ℝ 2 f U →
        (Wkp.value 2 u
          =ᵐ[volume.restrict (U : Set P)] f) →
        ∀ x ∈ U, |⟪v, ∇ f x⟫_ℝ| ≤ C * ‖u‖ := by
  obtain ⟨T, hT⟩ := exists_w2p_directional_morrey (μ := (volume : Measure P)) hr v
  refine ⟨‖T‖, norm_nonneg _, fun u U f hf huv x hx => ?_⟩
  let w : Wkp (volume : Measure P) U (r : ℝ≥0∞) 2 :=
    Wkp.restrictL (mu := (volume : Measure P)) (Omega := (⊤ : Opens P))
      (U := U) (p := (r : ℝ≥0∞)) (le_top : U ≤ (⊤ : Opens P)) 2
      u
  have hw : Wkp.value 2 w =ᵐ[volume.restrict (U : Set P)] f :=
    (Wkp.value_restrictL_ae (mu := (volume : Measure P)) (Omega := (⊤ : Opens P))
      (U := U) (p := (r : ℝ≥0∞)) (le_top : U ≤ (⊤ : Opens P)) 2
      u).trans huv
  have hw1 : W1p.value (Wkp.lowerOrder 1 w) =ᵐ[volume.restrict (U : Set P)] f := by
    rw [Wkp.value_lowerOrder_one]
    exact hw
  have hgrad := W1p.gradient_ae_eq_of_contDiffOn (Wkp.lowerOrder 1 w)
    (hf.of_le (by norm_num)) hw1
  have hg := Wkp.iteratedGradient_restrictL_ae (le_top : U ≤ (⊤ : Opens P)) 0
    (Wkp.lowerOrder 1 u)
  rw [← Wkp.lowerOrder_restrictL (le_top : U ≤ (⊤ : Opens P)) 1] at hg
  have he : (T u : P → ℝ) =ᵐ[volume.restrict (U : Set P)] fun z => ⟪v, ∇ f z⟫_ℝ := by
    have ht : (T u : P → ℝ) =ᵐ[volume.restrict (U : Set P)] (fun z => ⟪v, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) z⟫_ℝ) := ae_restrict_of_ae (hT u)
    filter_upwards [ht, hg, hgrad] with z h1 h2 h3
    rw [h1, ← h2, Wkp.iteratedGradient_zero]
    exact congrArg (fun y : P => ⟪v, y⟫_ℝ) h3
  have he' : (T u : P → ℝ) =ᵐ[volume.restrict (U : Set P)]
      fun z => fderiv ℝ f z v := by
    filter_upwards [he] with z hz
    simpa only [inner_gradient_right, conj_trivial] using hz
  have hc : ContinuousOn (fun z => fderiv ℝ f z v) (U : Set P) :=
    (hf.continuousOn_fderiv_of_isOpen U.isOpen (by norm_num)).clm_apply continuousOn_const
  have heq := MeasureTheory.Measure.eqOn_open_of_ae_eq he' U.isOpen
    (T u).continuous.continuousOn hc
  have heqx : T u x = fderiv ℝ f x v := heq hx
  rw [inner_gradient_right, conj_trivial, ← heqx]
  exact (show |T u x| ≤ ‖T u‖ by
    simpa only [Real.norm_eq_abs] using HolderSpace.norm_apply_le (T u) x).trans
      (T.le_opNorm u)

without_proof_info in
/-- A sufficient full-gradient bound, assembled over one finite orthonormal basis. -/
theorem exists_wholeSpace_classical_gradient_bound
    (hr : (finrank ℝ P : ℝ≥0) < r) :
    ∃ C ≥ 0, ∀ u : Wkp (volume : Measure P) ⊤ (r : ℝ≥0∞) 2,
      ∀ (U : Opens P), ∀ f : P → ℝ,
        ContDiffOn ℝ 2 f U →
        (Wkp.value 2 u
          =ᵐ[volume.restrict (U : Set P)] f) →
        ∀ x ∈ U, ‖∇ f x‖ ≤ C * ‖u‖ := by
  classical
  let b := stdOrthonormalBasis ℝ P
  choose C hC hbound using fun i => exists_wholeSpace_classical_directional_bound hr (b i)
  refine ⟨∑ i, C i, Finset.sum_nonneg (fun i _ => hC i), fun u U f hf huf x hx => ?_⟩
  calc
    ‖∇ f x‖ = ‖∑ i, ⟪b i, ∇ f x⟫_ℝ • b i‖ := by rw [b.sum_repr']
    _ ≤ ∑ i, ‖⟪b i, ∇ f x⟫_ℝ • b i‖ := norm_sum_le _ _
    _ = ∑ i, |⟪b i, ∇ f x⟫_ℝ| := by
      apply Finset.sum_congr rfl
      intro i _
      rw [norm_smul, Real.norm_eq_abs, b.orthonormal.norm_eq_one, mul_one]
    _ ≤ ∑ i, C i * ‖u‖ := Finset.sum_le_sum fun i _ => hbound i u U f hf huf x hx
    _ = (∑ i, C i) * ‖u‖ := (Finset.sum_mul ..).symm


without_proof_info in
theorem exists_wholeSpace_classical_value_bound
    (hr : (finrank ℝ P : ℝ≥0) < r) :
    ∃ C ≥ 0, ∀ u : Wkp (volume : Measure P) ⊤ (r : ℝ≥0∞) 2,
      ∀ (U : Opens P), ∀ f : P → ℝ, ContinuousOn f U →
        (Wkp.value 2 u =ᵐ[volume.restrict (U : Set P)] f) →
        ∀ x ∈ U, |f x| ≤ C * ‖u‖ := by
  let T := W1p.morreyEmbedding (mu := (volume : Measure P)) hr
  refine ⟨‖T‖, norm_nonneg T, fun u U f hf huf x hx => ?_⟩
  let v := Wkp.firstOrder 1 u
  have hv : Wkp.value 2 u =ᵐ[volume] (T v : P → ℝ) := by
    have h := W1p.value_ae_eq_morreyEmbedding hr v
    rw [Wkp.value_firstOrder] at h
    exact h
  have hTUvalue : (T v : P → ℝ) =ᵐ[volume.restrict (U : Set P)] Wkp.value 2 u :=
    ae_restrict_of_ae hv.symm
  have hTU : (T v : P → ℝ) =ᵐ[volume.restrict (U : Set P)] f := hTUvalue.trans huf
  have heq := MeasureTheory.Measure.eqOn_open_of_ae_eq hTU U.isOpen
    (T v).continuous.continuousOn hf
  have hvnorm : ‖v‖ ≤ ‖u‖ := by
    dsimp only [v]
    rw [Wkp.firstOrder_succ, Wkp.firstOrder_zero]
    exact Wkp.norm_lowerOrder_le 1 u
  rw [← heq hx]
  exact (show |T v x| ≤ ‖T v‖ by
    simpa only [Real.norm_eq_abs] using HolderSpace.norm_apply_le (T v) x).trans
    ((T.le_opNorm v).trans (mul_le_mul_of_nonneg_left hvnorm (norm_nonneg T)))

end ConformalPoisson

end ProofPart_GreenTrace_WholeSpaceClassicalGradientBound

