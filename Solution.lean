    (hcompat : ∀ p ∈ U, ∀ x ∈ ball (0 : V) 1,
      HasFDerivAt (domainRead (closedBall 0 1) (v p))
        (domainRead (closedBall 0 1) (D p) x) x) :
    ∃ H : P → TauCeti.HolderSpace α (closedBall (0 : V) 1) F,
      AnalyticOnNhd ℝ H U ∧ ∀ p ∈ U, ∀ x, H p x = v p x := by
  classical
  let g (p : P) : c1BallGraph (V := V) (F := F) :=
    if hp : p ∈ U then ⟨(v p, D p), hcompat p hp⟩ else 0
  have hread (p : P) (hp : p ∈ U) : (g p).val = (v p, D p) := by simp [g, hp]
  have hg : AnalyticOnNhd ℂ (fun p => (g p).val) U := by
    intro p hp
    apply ((hv p hp).prod (hD p hp)).congr
    filter_upwards [hU.mem_nhds hp] with q hq
    exact (hread q hq).symm
  refine ⟨fun p => c1BallHolder hα (g p), fun p hp => ?_, fun p hp x => ?_⟩
  · exact analyticAt_c1BallHolder (V := V) (F := F) hα hU hg hp
  · rw [c1BallHolder_apply]
    exact congrArg (fun z => z.1 x) (hread p hp)

end ConformalPoisson

end ProofPart_InteriorAnalytic_AnalyticHolderFamily

/- Interior analytic support: LocalizedHolderCoefficients.lean, SHA256 f6576e4c8d61e70c47e0382cd3eadc20d8d122a1dd41c8300e552d4e74ef933d -/
noncomputable section ProofPart_InteriorAnalytic_LocalizedHolderCoefficients



/- Holomorphic scalar coefficients pulled back by a smooth localized
translation are analytic in the actual ball Holder norm.  The ball uses V's
original norm; complex coordinates enter only through the fixed map ι. -/
open Set Metric Filter Topology
open scoped BoundedContinuousFunction NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {V E : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [ProperSpace V]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [NormedSpace ℝ E]
  [IsScalarTower ℝ ℂ E] [FiniteDimensional ℂ E]

without_proof_info in
theorem exists_analytic_localized_holder_family {α : ℝ≥0} (hα : α ≤ 1)
    (ι : V →L[ℝ] E) (F : E → ℂ) (χ : V → ℝ) (hχ : ContDiff ℝ 1 χ)
    (hF : ∀ x : closedBall (0 : V) 1, AnalyticAt ℂ F (ι x)) :
    ∃ (U : Set E) (H : E → TauCeti.HolderSpace α (closedBall (0 : V) 1) ℂ),
      IsOpen U ∧ (0 : E) ∈ U ∧ AnalyticOnNhd ℝ H U ∧
        ∀ p ∈ U, ∀ x : closedBall (0 : V) 1, H p x = F (ι x + χ x • p) := by
  let K := closedBall (0 : V) 1
  let i : K → E := fun x => ι x
  let c : K → ℂ := fun x => (χ x : ℂ)
  let η : K → (V →L[ℝ] ℂ) := fun x => Complex.ofRealCLM.comp (fderiv ℝ χ x)
  have hi : Continuous i := ι.continuous.comp continuous_subtype_val
  have hc : Continuous c := Complex.continuous_ofReal.comp
    (hχ.continuous.comp continuous_subtype_val)
  have hη : Continuous η := continuous_const.clm_comp
    ((hχ.continuous_fderiv (by norm_num)).comp continuous_subtype_val)
  let v0 : E → C(K, ℂ) := fun p =>
    ContinuousMap.mkD (fun x => F (i x + c x • p)) 0
  let D0 : E → C(K, V →L[ℝ] ℂ) := embeddedTranslationDerivative ι F i c η
  let Lv : C(K, ℂ) →L[ℂ] (K →ᵇ ℂ) :=
    (ContinuousMap.linearIsometryBoundedOfCompact K ℂ ℂ).toLinearIsometry.toContinuousLinearMap
  let LD : C(K, V →L[ℝ] ℂ) →L[ℂ] (K →ᵇ (V →L[ℝ] ℂ)) :=
    (ContinuousMap.linearIsometryBoundedOfCompact K (V →L[ℝ] ℂ) ℂ).toLinearIsometry.toContinuousLinearMap
  let v : E → (K →ᵇ ℂ) := fun p => Lv (v0 p)
  let D : E → (K →ᵇ (V →L[ℝ] ℂ)) := fun p => LD (D0 p)
  have hv : AnalyticAt ℂ v 0 :=
    (ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := C(K, ℂ)) (F := K →ᵇ ℂ) Lv _).comp
      (analyticAt_uniform_localized_translation F i c hi hc hF)
  have hD0 : AnalyticAt ℂ D0 0 :=
    analyticAt_embeddedTranslationDerivative ι F i c η hi hc hη hF
  have hLD : AnalyticAt ℂ LD (D0 0) :=
    ContinuousLinearMap.analyticAt (𝕜 := ℂ) (E := C(K, V →L[ℝ] ℂ))
      (F := K →ᵇ (V →L[ℝ] ℂ)) LD _
  have hD : AnalyticAt ℂ D 0 := hLD.comp hD0
  have hnear : ∀ᶠ p in 𝓝 (0 : E), ∀ x : K,
      AnalyticAt ℂ F (i x + c x • p) := by
    have h := isCompact_univ.eventually_forall_of_forall_eventually
      (x₀ := (0 : E)) (P := fun p (x : K) => AnalyticAt ℂ F (i x + c x • p))
      fun x (_ : x ∈ (univ : Set K)) =>
        ((hi.comp continuous_snd).add
          ((hc.comp continuous_snd).smul continuous_fst)).continuousAt.eventually
          (by simpa using (hF x).eventually_analyticAt)
    simpa only [mem_univ, forall_true_left] using h
  obtain ⟨U, hU, hUopen, h0⟩ := _root_.eventually_nhds_iff.1
    (hv.eventually_analyticAt.and (hD.eventually_analyticAt.and hnear))
  have hvc (p : E) (hp : p ∈ U) : Continuous (fun x : K => F (i x + c x • p)) :=
    continuous_iff_continuousAt.2 fun x =>
      ((hU p hp).2.2 x).continuousAt.comp_of_eq
        (hi.add (hc.smul continuous_const)).continuousAt rfl
  have hDc (p : E) (hp : p ∈ U) : Continuous (fun x : K =>
      restrictPrecompL ι (fderiv ℂ F (i x + c x • p)) +
        fderiv ℂ F (i x + c x • p) p • η x) := by
    have hf : Continuous (fun x : K => fderiv ℂ F (i x + c x • p)) :=
      continuous_iff_continuousAt.2 fun x =>
        ((hU p hp).2.2 x).fderiv.continuousAt.comp_of_eq
          (hi.add (hc.smul continuous_const)).continuousAt rfl
    exact ((restrictPrecompL ι).continuous.comp hf).add
      ((hf.clm_apply continuous_const).smul hη)
  have hveq (p : E) (hp : p ∈ U) (x : K) : v p x = F (ι x + χ x • p) := by
    change ContinuousMap.mkD (fun x : K => F (i x + c x • p)) 0 x = _
    rw [ContinuousMap.mkD_apply_of_continuous (hvc p hp)]
    dsimp only [i, c]
    rw [show (χ x : ℂ) • p = χ x • p from algebraMap_smul ℂ (χ x) p]
  have hDeq (p : E) (hp : p ∈ U) (x : K) : D p x =
      restrictPrecompL ι (fderiv ℂ F (ι x + χ x • p)) +
        fderiv ℂ F (ι x + χ x • p) p •
          (Complex.ofRealCLM.comp (fderiv ℝ χ x)) := by
    change D0 p x = _
    change ContinuousMap.mkD _ 0 x = _
    rw [ContinuousMap.mkD_apply_of_continuous (hDc p hp)]
    dsimp only [i, c, η]
    rw [show (χ x : ℂ) • p = χ x • p from algebraMap_smul ℂ (χ x) p]
  obtain ⟨H, hH, hHeq⟩ := exists_analytic_holder_family_of_c1 hα v D hUopen
    (fun p hp => (hU p hp).1) (fun p hp => (hU p hp).2.1) (by
      intro p hp x hx
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx), hDeq p hp]
      have hFp : AnalyticAt ℂ F (ι x + χ x • p) := by
        have hh := (hU p hp).2.2 ⟨x, ball_subset_closedBall hx⟩
        change AnalyticAt ℂ F (ι x + (χ x : ℂ) • p) at hh
        rwa [show (χ x : ℂ) • p = χ x • p from algebraMap_smul ℂ (χ x) p] at hh
      apply (hasFDerivAt_embedded_localized_coefficient ι F χ p x
        (hχ.differentiable_one x) hFp).congr_of_eventuallyEq
      filter_upwards [isOpen_ball.mem_nhds hx] with y hy
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hy), hveq p hp])
  exact ⟨U, H, hUopen, h0, hH, fun p hp x => (hHeq p hp x).trans (hveq p hp x)⟩

end ConformalPoisson

end ProofPart_InteriorAnalytic_LocalizedHolderCoefficients

/- Interior analytic support: RealComplexCoordinates.lean, SHA256 1fd266186f3806882d64211ef67451a29e5ab9f0020415bff988bb5450c051ab -/
noncomputable section ProofPart_InteriorAnalytic_RealComplexCoordinates




/- Fixed coordinate readings for the actual real spatial derivative of
a holomorphic coefficient. All maps have their canonical finite-dimensional
norms; reconstruction uses the real coordinate basis. -/
open scoped BigOperators
namespace ConformalPoisson
variable {d : ℕ}
local notation "R" => Fin d → ℝ
local notation "C" => Fin d → ℂ

def realCoordinateCovector (i : Fin d) : R →L[ℝ] ℂ :=
  Complex.ofRealCLM.comp (ContinuousLinearMap.proj i)

def ofRealPiL : R →L[ℝ] C := ContinuousLinearMap.pi fun i => realCoordinateCovector i

without_proof_info in
@[simp] theorem ofRealPiL_apply (x : R) (i : Fin d) : ofRealPiL x i = (x i : ℂ) := rfl

without_proof_info in
@[simp] theorem ofRealPiL_single (j : Fin d) :
    ofRealPiL (Pi.single j (1 : ℝ)) = Pi.single j (1 : ℂ) := by
  classical
  ext i
  simp [Pi.single_apply, apply_ite]

def complexCovectorOfCoefficientsL : C →L[ℂ] (R →L[ℝ] ℂ) :=
  ∑ i : Fin d, (ContinuousLinearMap.proj i : C →L[ℂ] ℂ).smulRight (realCoordinateCovector i)

without_proof_info in
theorem complexCovectorOfCoefficientsL_apply (a : C) (x : R) :
    complexCovectorOfCoefficientsL a x = ∑ i : Fin d, a i * (x i : ℂ) := by
  simp [complexCovectorOfCoefficientsL, realCoordinateCovector, smul_eq_mul]

without_proof_info in
@[simp] theorem complexCovectorOfCoefficientsL_single (a : C) (j : Fin d) :
    complexCovectorOfCoefficientsL a (Pi.single j 1) = a j := by
  classical
  rw [complexCovectorOfCoefficientsL_apply]
  simp [Pi.single_apply, apply_ite]

without_proof_info in
theorem complexCovector_reconstruct (L : R →L[ℝ] ℂ) :
    complexCovectorOfCoefficientsL (fun i => L (Pi.single i 1)) = L := by
  have h : (complexCovectorOfCoefficientsL (fun i => L (Pi.single i 1))).toLinearMap =
      L.toLinearMap := by
    apply (Pi.basisFun ℝ (Fin d)).ext
    intro i
    simpa using complexCovectorOfCoefficientsL_single (fun j => L (Pi.single j 1)) i
  ext x
  exact congrArg (fun A : R →ₗ[ℝ] ℂ => A x) h

end ConformalPoisson

end ProofPart_InteriorAnalytic_RealComplexCoordinates

