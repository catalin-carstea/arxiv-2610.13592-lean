noncomputable section ProofPart_DNSymbol_DNLayerCollarRestriction


/- Assignment268, /root. Include both actual Gaussian-extension domains
(or other actual chart localization) BEFORE choosing the shared cutoffs.
The SAME actual coefficient extensions/readbacks are retained. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Metric TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN.NativeLayerCollar
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem exists_restrict {S : TopologicalSpace.Opens H} {F₁ F₂ : NormalMetricField S} {y : Y}
    (R : NativeLayerCollar F₁ F₂ y) (O : TopologicalSpace.Opens (Y × ℝ)) (hyO : (y, (0 : ℝ)) ∈ O) :
    ∃ R' : NativeLayerCollar F₁ F₂ y,
      (R'.domain : Set (Y × ℝ)) = (R.domain : Set (Y × ℝ)) ∩ O ∧
      R'.extension₁ = R.extension₁ ∧ R'.extension₂ = R.extension₂ := by
  have hyU : y ∈ R.cutoff.tangentialDomain :=
    mem_ball_self (mul_pos (by norm_num) R.cutoff.amplitude.rOut_pos)
  have hyR : (y, (0 : ℝ)) ∈ R.domain := R.cutoff.face_domain_subset hyU
  let D : TopologicalSpace.Opens (Y × ℝ) := R.domain ⊓ O
  obtain ⟨C⟩ := nonempty_compactLayerCollar D.isOpen y (show (y, (0 : ℝ)) ∈ D from ⟨hyR, hyO⟩)
  let R' : NativeLayerCollar F₁ F₂ y :=
    { extension₁ := R.extension₁
      extension₂ := R.extension₂
      domain := D
      analytic₁ := R.analytic₁.mono inter_subset_left
      analytic₂ := R.analytic₂.mono inter_subset_left
      read₁ := R.read₁
      read₂ := R.read₂
      within_field := fun _ hz => R.within_field hz.1
      cutoff := C }
  exact ⟨R', rfl, rfl, rfl⟩

end ConformalPoisson.LocalDN.NativeLayerCollar

end ProofPart_DNSymbol_DNLayerCollarRestriction

