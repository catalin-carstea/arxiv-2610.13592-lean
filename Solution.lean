  have hy₂ : EuclideanHalfSpace.boundaryParam n y ∈ C.chart₂.source := C.source_eq ▸ hy₁
  have hy0 : (EuclideanHalfSpace.boundaryParam n y).val 0 = 0 := rfl
  obtain ⟨ha₁, ha₂⟩ := hLayers y hy
  have he₁ := finiteExpansion_of_native_boundary_layers (by omega : 1 ≤ n) hM₁
    P.metric₁ P.potential₁ hq₁ hNR₁ (P.solver₁ hn) D.normal₁ P.normal_spec₁ C.chart₁ C.geometry₁
    (fun h => (fr h).val) (fun h => (fi h).val) (fun h => (fr h).property.1) (fun h => (fi h).property.1)
    ξ hy₁ hy0 _ ha₁
  have hfr₂ (h : ℝ) : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ ((fr h).val ∘ D.boundaryIdentification.symm) :=
    (fr h).property.1.comp (D.boundaryIdentification.symm.contMDiff.of_le le_top)
  have hfi₂ (h : ℝ) : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ ((fi h).val ∘ D.boundaryIdentification.symm) :=
    (fi h).property.1.comp (D.boundaryIdentification.symm.contMDiff.of_le le_top)
  have he₂ := finiteExpansion_of_native_boundary_layers (by omega : 1 ≤ n) hM₂
