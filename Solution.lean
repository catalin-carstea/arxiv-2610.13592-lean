          ‖G‖ ^ 2 ≤ M * r ^ (((n : ℝ) + 1) + 2 * α)) :
    ∃ K : ℝ≥0, HolderOnWith K α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient u : V → V)) S := by
  obtain ⟨A, hA, hdec⟩ := exists_oscillation_bound_of_local_gradient_residuals u hαlt hR hM hS hres
