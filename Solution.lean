    (hz : z ∈ interior (extChartAt I α).target)
    (v : TangentSpace 𝓘(ℝ, E) z) :
    mfderiv 𝓘(ℝ, E) I (extChartAt I α).symm z v =
      (trivializationAt E (TangentSpace I) α).symmL ℝ
        ((extChartAt I α).symm z) (NormedSpace.fromTangentSpace z v) := by
  have hy : (extChartAt I α).symm z ∈ (chartAt H α).source := by
    simpa only [extChartAt_source] using (extChartAt I α).map_target (interior_subset hz)
  have hrange : range I ∈ 𝓝 z := Filter.mem_of_superset (isOpen_interior.mem_nhds hz)
    (interior_subset.trans (extChartAt_target_subset_range α))
  rw [TangentBundle.symmL_trivializationAt hy,
    (extChartAt I α).right_inv (interior_subset hz), mfderivWithin_of_mem_nhds hrange]
  rfl

set_option maxHeartbeats 600000 in
without_proof_info in
/-- At boundary points the derivative is taken within the actual chart
target. It reads the native scalar differential in the same chart frame. -/
theorem fderivWithin_inverseChart_scalar (α : M) {z : E}
    (hz : z ∈ (extChartAt I α).target) {u : M → ℝ}
    (hu : MDifferentiableAt I 𝓘(ℝ) u ((extChartAt I α).symm z)) (v : E) :
    fderivWithin ℝ (u ∘ (extChartAt I α).symm) (extChartAt I α).target z v =
      mvfderiv I u ((extChartAt I α).symm z)
        ((trivializationAt E (TangentSpace I) α).symmL ℝ ((extChartAt I α).symm z) v) := by
  have hy : (extChartAt I α).symm z ∈ (chartAt H α).source := by
    simpa only [extChartAt_source] using (extChartAt I α).map_target hz
  have hsymm := mdifferentiableWithinAt_extChartAt_symm hz
  have huniq : UniqueMDiffWithinAt 𝓘(ℝ, E) (range I) z := by
    rw [uniqueMDiffWithinAt_iff_uniqueDiffWithinAt]
    exact I.uniqueDiffOn z (extChartAt_target_subset_range α hz)
  have hcomp := mfderiv_comp_mfderivWithin z hu hsymm huniq
  have hdiff : DifferentiableWithinAt ℝ (u ∘ (extChartAt I α).symm) (range I) z := by
    rw [← mdifferentiableWithinAt_iff_differentiableWithinAt]
    exact hu.comp_mdifferentiableWithinAt z hsymm
  rw [fderivWithin_subset (extChartAt_target_subset_range α)
    (uniqueDiffOn_extChartAt_target α z hz) hdiff]
  rw [TangentBundle.symmL_trivializationAt hy, (extChartAt I α).right_inv hz]
  have hh : mfderivWithin 𝓘(ℝ, E) 𝓘(ℝ) (u ∘ (extChartAt I α).symm) (range I) z v =
      mfderiv I 𝓘(ℝ) u ((extChartAt I α).symm z)
        (mfderivWithin 𝓘(ℝ, E) I (extChartAt I α).symm (range I) z v) :=
    congrArg (fun L => L v) hcomp
  rw [mfderivWithin_eq_fderivWithin] at hh
  dsimp only [ContinuousLinearMap.comp_apply] at hh
  have hv : (NormedSpace.fromTangentSpace (𝕜 := ℝ) z).toContinuousLinearMap v = v :=
    NormedSpace.fromTangentSpace_apply z v
  have hs (a : ℝ) : (NormedSpace.fromTangentSpace (𝕜 := ℝ)
      ((u ∘ (extChartAt I α).symm) z)).symm.toContinuousLinearMap a = a :=
    NormedSpace.fromTangentSpace_symm_apply _ a
  rw [hv, hs] at hh
  exact hh

end ConformalPoisson

end ProofPart_InteriorInverseChartDerivative

/- Proof support: NativeCauchyChart.lean, SHA256 b4b4ee8589aeb0bc69f2823e8b4556d27fc988989de5a251f7d8b68b552f91d1 -/
noncomputable section ProofPart_NativeCauchyChart



/- The original outward unit normal gives a transverse chart
vector, and its Cauchy derivative is exactly the relative coordinate
derivative of the pulled-back solution, including on the face. -/
open Bundle Set TauCeti
open scoped Manifold Topology ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem native_normal_chart_coordinate_neg
    (g : Metric (n := n) (M := M)) (α : M) (y : (𝓡∂ (n + 1)).boundary M)
    (hy : (y : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (v : TangentSpace (𝓡∂ (n + 1)) (y : M)) (hv : IsOutwardUnitNormal g y v) :
    (mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) α) y v) 0 < 0 := by
  obtain ⟨a, ha, hfactor⟩ := chartBoundaryFunction_normal_factor α y hy
  have hv0 := hv.1.coordinate_deriv_neg
  rw [mfderiv_extChartAt_self] at hv0
  have hneg : mvfderiv (𝓡∂ (n + 1)) (chartBoundaryFunction (n := n) α) y v < 0 := by
    rw [hfactor]
    exact mul_neg_of_pos_of_neg ha hv0
  rw [mvfderiv_chartBoundaryFunction α hy] at hneg
  have hcoord : mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) α) y v =
      tangentCoordChange (𝓡∂ (n + 1)) (y : M) α (y : M) v := by
    rw [mvfderiv_apply_eq_mfderiv_apply,
      (hasMFDerivAt_extChartAt (I := 𝓡∂ (n + 1)) hy).mfderiv,
      mfderiv_chartAt_eq_tangentCoordChange hy]
    rfl
  rw [hcoord]
  exact hneg

set_option maxHeartbeats 600000 in
without_proof_info in
theorem normalDerivative_eq_inverseChart_fderivWithin
    (α : M) (y : (𝓡∂ (n + 1)).boundary M)
    (hy : (y : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (ν : (x : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (x : M))
    {u : M → ℝ} (hu : MDifferentiableAt (𝓡∂ (n + 1)) 𝓘(ℝ) u (y : M)) :
    normalDerivative ν u y =
      fderivWithin ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
        (extChartAt (𝓡∂ (n + 1)) α).target (extChartAt (𝓡∂ (n + 1)) α y)
        (mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) α) y (ν y)) := by
  have hys : (y : M) ∈ (extChartAt (𝓡∂ (n + 1)) α).source := by rwa [extChartAt_source]
  have hz := (extChartAt (𝓡∂ (n + 1)) α).map_source hys
  have hround := (extChartAt (𝓡∂ (n + 1)) α).left_inv hys
  have hvround : (trivializationAt (EuclideanSpace ℝ (Fin (n + 1)))
      (TangentSpace (𝓡∂ (n + 1))) α).symmL ℝ (y : M)
      (mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) α) y (ν y)) = ν y := by
    rw [TangentBundle.symmL_trivializationAt hy]
    have hinv := mfderivWithin_extChartAt_symm_comp_mfderiv_extChartAt' hys
    have hh := congrArg (fun L => L (ν y)) hinv
    exact hh
  have hread := fderivWithin_inverseChart_scalar α hz
    (show MDifferentiableAt (𝓡∂ (n + 1)) 𝓘(ℝ) u
      ((extChartAt (𝓡∂ (n + 1)) α).symm (extChartAt (𝓡∂ (n + 1)) α y)) from hround.symm ▸ hu)
    (mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) α) y (ν y))
  rw [hround, hvround] at hread
  exact hread.symm

end ConformalPoisson

end ProofPart_NativeCauchyChart

/- Proof support: NativeCauchyLocalization.lean, SHA256 f3ef1d95b05f9db931b2041983a501691ee0dbc49eb764b502967e35a25b8138 -/
noncomputable section ProofPart_NativeCauchyLocalization



/- Localize the actual relative chart target to the original open
solution domain. It retains the unique differential property and
relative smoothness, and contains an actual closed half-ball. -/
open Bundle Set TauCeti TopologicalSpace Filter
open scoped Manifold Topology ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

def nativeCauchyChartTarget (α : M) (U : Opens M) : Set (EuclideanSpace ℝ (Fin (n + 1))) :=
  (extChartAt (𝓡∂ (n + 1)) α).target ∩ (extChartAt (𝓡∂ (n + 1)) α).symm ⁻¹' (U : Set M)

without_proof_info in
theorem uniqueDiffOn_nativeCauchyChartTarget (α : M) (U : Opens M) :
    UniqueDiffOn ℝ (nativeCauchyChartTarget (n := n) α U) :=
  (show UniqueMDiffOn (𝓡∂ (n + 1)) (U : Set M) from U.isOpen.uniqueMDiffOn).uniqueDiffOn_target_inter α

without_proof_info in
theorem contDiffOn_nativeCauchyChartTarget (α : M) (U : Opens M) {u : M → ℝ}
    (hu : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u U) :
    ContDiffOn ℝ ∞ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm) (nativeCauchyChartTarget (n := n) α U) := by
  have hh : ContMDiffOn 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) 𝓘(ℝ) ∞
      (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm) (nativeCauchyChartTarget (n := n) α U) :=
    hu.comp ((contMDiffOn_extChartAt_symm (I := 𝓡∂ (n + 1)) (n := ∞) α).mono inter_subset_left)
      (fun _ hz => hz.2)
  exact hh.contDiffOn

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_closed_halfBall_nativeCauchyChartTarget
    (α : M) (U : Opens M) (hα : α ∈ U) :
    ∃ r : ℝ, 0 < r ∧
      Metric.closedBall (extChartAt (𝓡∂ (n + 1)) α α) r ∩ range (𝓡∂ (n + 1)) ⊆
        nativeCauchyChartTarget (n := n) α U := by
  let c := extChartAt (𝓡∂ (n + 1)) α α
  have hc : c ∈ (extChartAt (𝓡∂ (n + 1)) α).target := mem_extChartAt_target α
  have htarget : (extChartAt (𝓡∂ (n + 1)) α).target ∈ 𝓝[range (𝓡∂ (n + 1))] c :=
    extChartAt_target_mem_nhdsWithin α
  have hcont : ContinuousWithinAt (extChartAt (𝓡∂ (n + 1)) α).symm
      (range (𝓡∂ (n + 1))) c :=
    ((continuousOn_extChartAt_symm (I := 𝓡∂ (n + 1)) α) c hc).mono_of_mem_nhdsWithin htarget
  have hpre : (extChartAt (𝓡∂ (n + 1)) α).symm ⁻¹' (U : Set M) ∈
      𝓝[range (𝓡∂ (n + 1))] c := by
    apply hcont.preimage_mem_nhdsWithin
    have he : (extChartAt (𝓡∂ (n + 1)) α).symm c = α :=
      (extChartAt (𝓡∂ (n + 1)) α).left_inv (mem_extChartAt_source α)
    rw [he]
    exact U.isOpen.mem_nhds hα
  obtain ⟨V, hV, hcV, hsub⟩ := mem_nhdsWithin.mp (inter_mem htarget hpre)
  obtain ⟨R, hR, hball⟩ := Metric.mem_nhds_iff.mp (hV.mem_nhds hcV)
  refine ⟨R / 2, by positivity, ?_⟩
  intro z hz
  apply hsub
  refine ⟨hball ?_, hz.2⟩
  exact Metric.mem_ball.mpr ((Metric.mem_closedBall.mp hz.1).trans_lt (by linarith))

set_option maxHeartbeats 600000 in
without_proof_info in
theorem normalDerivative_eq_inverseChart_fderivWithin_on
    (α : M) (U : Opens M) (y : (𝓡∂ (n + 1)).boundary M)
    (hy : (y : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source) (hyU : (y : M) ∈ U)
    (ν : (x : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (x : M))
    {u : M → ℝ} (hu : MDifferentiableAt (𝓡∂ (n + 1)) 𝓘(ℝ) u (y : M)) :
    normalDerivative ν u y =
      fderivWithin ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
        (nativeCauchyChartTarget (n := n) α U) (extChartAt (𝓡∂ (n + 1)) α y)
        (mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) α) y (ν y)) := by
  have hys : (y : M) ∈ (extChartAt (𝓡∂ (n + 1)) α).source := by rwa [extChartAt_source]
  have hz := (extChartAt (𝓡∂ (n + 1)) α).map_source hys
  have he := (extChartAt (𝓡∂ (n + 1)) α).left_inv hys
  have hzS : extChartAt (𝓡∂ (n + 1)) α y ∈ nativeCauchyChartTarget (n := n) α U := by
    refine ⟨hz, ?_⟩
    change (extChartAt (𝓡∂ (n + 1)) α).symm (extChartAt (𝓡∂ (n + 1)) α y) ∈ U
    rwa [he]
  have hdiff : DifferentiableWithinAt ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
      (extChartAt (𝓡∂ (n + 1)) α).target (extChartAt (𝓡∂ (n + 1)) α y) := by
    rw [← mdifferentiableWithinAt_iff_differentiableWithinAt]
    have hu' : MDifferentiableAt (𝓡∂ (n + 1)) 𝓘(ℝ) u
        ((extChartAt (𝓡∂ (n + 1)) α).symm (extChartAt (𝓡∂ (n + 1)) α y)) := he.symm ▸ hu
    exact hu'.comp_mdifferentiableWithinAt (extChartAt (𝓡∂ (n + 1)) α y)
      (mdifferentiableOn_extChartAt_symm (I := 𝓡∂ (n + 1)) _ hz)
  rw [fderivWithin_subset (show nativeCauchyChartTarget (n := n) α U ⊆
      (extChartAt (𝓡∂ (n + 1)) α).target from inter_subset_left)
    (uniqueDiffOn_nativeCauchyChartTarget (n := n) α U _ hzS) hdiff]
  exact normalDerivative_eq_inverseChart_fderivWithin α y hy ν hu

end ConformalPoisson

end ProofPart_NativeCauchyLocalization

/- Proof support: NativeAmbientIsometry.lean, SHA256 5980aaeaf60dc58ca230c5aac01813171e28be3032be6ab461d8c8936b051fcf -/
