theorem NativeClassicalValueKernel.mixed_normal_representation
    {g : Metric (n := n) (M := M)} {q : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    {a : ℝ≥0} (ha : 1 < a) [Fact (1 ≤ (a : ℝ≥0∞))]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] [(a : ℝ≥0∞).HolderConjugate p] (hp : p ≠ ⊤)
    {K : NativeInverseLpRowFamily g q (a : ℝ≥0∞)} (G : NativeClassicalValueKernel K)
    (S : DirichletSolver g q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (f : (𝓡∂ (n + 1)).boundary M → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f)
    (y : (𝓡∂ (n + 1)).boundary M) (hy : y ∉ tsupport f) :
    Integrable (fun z => normalDerivative ν (boundaryPoissonSection ν G.kernel y) z * f z)
      (nativeSurfaceMeasure g) ∧
    normalDerivative ν (S.solve f) y =
      ∫ z, normalDerivative ν (boundaryPoissonSection ν G.kernel y) z * f z ∂nativeSurfaceMeasure g := by
  let : IsLocallyFiniteMeasure (nativeSurfaceMeasure g) := nativeSurfaceMeasure_isLocallyFiniteMeasure g
  let : IsFiniteMeasure (nativeSurfaceMeasure g) := inferInstance
  let C : Set M := Subtype.val '' tsupport f
  have hC : IsCompact C := (isClosed_tsupport f).isCompact.image continuous_subtype_val
  have hyC : (y : M) ∉ C := by
    rintro ⟨z, hz, he⟩
    exact hy ((Subtype.val_injective he) ▸ hz)
  have hU : IsOpen Cᶜ := hC.isClosed.isOpen_compl
  let F : M → (Ihalf).boundary M → ℝ := fun x z => boundaryPoissonSection ν G.kernel z x * f z
  have hDopen : IsOpen {r : M × (Ihalf).boundary M | r.1 ≠ (r.2 : M)} :=
    isOpen_ne_fun continuous_fst (continuous_subtype_val.comp continuous_snd)
