open MeasureTheory Set TopologicalSpace Filter TauCeti Module
open scoped ENNReal InnerProductSpace ContDiff Gradient
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "P" => WithLp 2 (ℝ × E)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem boundary_cutoff_gradient_interpolation
    (hp : p ≠ (⊤ : ℝ≥0∞)) (a : ℝ) {Ω U : Opens P}
    (hΩU : (Ω : Set P) ∩ U = (normalHalfSpace (E := E) a : Set P) ∩ U)
    (u w : Wkp (volume : Measure P) Ω p 2)
    (η : P → ℝ) (hη : ContDiff ℝ ∞ η) (hηc : HasCompactSupport η) (hηU : tsupport η ⊆ U)
    (habs : ∀ x, |η x| ≤ 1) {c₁ c₂ : ℝ}
    (hg : ∀ x, ‖gradient η x‖ ≤ c₁) (hh : ∀ x, ‖fderiv ℝ (gradient η) x‖ ≤ c₂)
