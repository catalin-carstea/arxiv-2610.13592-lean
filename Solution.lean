  have ha : MemLp (fun _ : V => energyIntegrand (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) 0 0)
      ⊤ (volume.restrict (Ω : Set V)) := by
    simpa using memLp_top_const (μ := volume.restrict (Ω : Set V))
