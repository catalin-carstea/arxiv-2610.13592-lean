local notation "H" => EuclideanHalfSpace (n + 1)
local notation "Y" => EuclideanSpace ℝ (Fin n)

without_proof_info in
theorem analyticAt_boundary_restriction
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    {f : H → F} {y : Y}
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f (EuclideanHalfSpace.boundaryParam n y)) :
    AnalyticAt ℝ (f ∘ EuclideanHalfSpace.boundaryParam n) y := by
  obtain ⟨G, hG, he⟩ := model_exists_analytic_extension (𝓡∂ (n + 1)) hf
  have hpoint : (𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n y) =
      euclideanHalfSpaceBoundaryParam n y := rfl
  have hcomp : f ∘ EuclideanHalfSpace.boundaryParam n = G ∘ euclideanHalfSpaceBoundaryParam n := by
    rw [he]
    rfl
  rw [hcomp]
  exact (hpoint ▸ hG).comp ((euclideanHalfSpaceBoundaryParam n).analyticAt y)

def faceJet (f : H → ℝ) (l : ℕ) (y : Y) : ℝ :=
  normalJet l f (EuclideanHalfSpace.boundaryParam n y)

def faceTaylor (f : H → ℝ) (l : ℕ) (y : Y) : ℂ :=
  (faceJet f l y : ℂ) / (l.factorial : ℂ)

without_proof_info in
theorem faceJet_contDiffOn
    {S : TopologicalSpace.Opens H} {f : H → ℝ}
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω f S)
    {W : Set Y} (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S) (l : ℕ) :
    ContDiffOn ℝ ∞ (faceJet f l) W := by
  intro y hy
  have hω := analyticAt_boundary_restriction
    (((normalJet_analyticOn S.isOpen hf l) _ (hWS hy)).contMDiffAt (S.isOpen.mem_nhds (hWS hy)))
  have hc : ContDiffAt ℝ ∞ (normalJet l f ∘ EuclideanHalfSpace.boundaryParam n) y := hω.contDiffAt
  exact hc.contDiffWithinAt

without_proof_info in
theorem faceTaylor_contDiffOn
    {S : TopologicalSpace.Opens H} {f : H → ℝ}
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω f S)
    {W : Set Y} (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S) (l : ℕ) :
    ContDiffOn ℝ ∞ (faceTaylor f l) W :=
  (Complex.ofRealCLM.contDiff.comp_contDiffOn (faceJet_contDiffOn hf hWS l)).div_const _

def metricTangentialDrift {S : TopologicalSpace.Opens H} (F : NormalMetricField S) (a : Fin n) : H → ℝ :=
  fun z => ∑ b, (tangentialMatrixDeriv b F.inverse z b a +
    (1 / 2 : ℝ) * F.inverse z b a * metricJetTrace (F.inverse z) (tangentialMatrixDeriv b F.gram z))

without_proof_info in
theorem metricTangentialDrift_analyticOn {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S) (a : Fin n) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω (metricTangentialDrift F a) S := by
  have hdA := fun i => modelDirectionalDeriv_analyticOn (𝓡∂ (n + 1))
    (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1)) S.isOpen hA
  have hdG := fun i => modelDirectionalDeriv_analyticOn (𝓡∂ (n + 1))
    (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1)) S.isOpen hG
  unfold metricTangentialDrift
  apply contMDiffOn_finsetSum
  intro b hb
  exact ((normalMatrixEntry b a).contDiff.contMDiff.comp_contMDiffOn (hdA b)).add
    ((contMDiffOn_const.mul ((normalMatrixEntry b a).contDiff.contMDiff.comp_contMDiffOn hA)).mul
      ((normalMatrixTrace (n := n)).contDiff.contMDiff.comp_contMDiffOn
        (normalMatrix_mul_contMDiffOn hA (hdG b))))

without_proof_info in
theorem facePrincipal_contDiffOn {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    {W : Set Y} (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) :
    ContDiffOn ℝ ∞ (fun y => F.principal ξ (EuclideanHalfSpace.boundaryParam n y)) W := by
  exact faceJet_contDiffOn (F.principal_analyticOn ξ hξ hA) hWS 0

end ConformalPoisson.LocalDN

