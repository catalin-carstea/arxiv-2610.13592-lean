without_proof_info in
theorem complex_normalMatrixQuadratic_eq_sum (A : Matrix (Fin n) (Fin n) ℝ) (ξ : Fin n → ℝ) :
    (normalMatrixQuadratic A ξ : ℂ) = ∑ i, ∑ j, (A i j : ℂ) * (ξ i : ℂ) * (ξ j : ℂ) := by
  simp only [normalMatrixQuadratic_eq_dot, dotProduct, Matrix.mulVec, Complex.ofReal_sum,
    Complex.ofReal_mul, mul_sum]
  apply sum_congr rfl; intro i hi
  exact sum_congr rfl (fun j _ => by ring)

without_proof_info in
theorem native_inverseTaylor_quadratic {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    {U : Set Y} (hUS : MapsTo (EuclideanHalfSpace.boundaryParam n) U S)
    (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) (N : ℕ) {y : Y} (hy : y ∈ U) :
    (∑ i, ∑ j, (nativeBoundaryLayerCoefficients F hG hA hUS ξ hξ).inverse N i j y * (ξ i : ℂ) * (ξ j : ℂ)) =
      (normalMatrixQuadratic (normalJet N F.inverse (EuclideanHalfSpace.boundaryParam n y)) ξ : ℂ) / (N.factorial : ℂ) := by
  have he (i j : Fin n) : (nativeBoundaryLayerCoefficients F hG hA hUS ξ hξ).inverse N i j y =
      (normalJet N F.inverse (EuclideanHalfSpace.boundaryParam n y) i j : ℂ) / (N.factorial : ℂ) := by
    change faceTaylor (fun z => F.inverse z i j) N y = _
    unfold faceTaylor faceJet
    rw [normalJet_matrix_entry S.isOpen F.inverse_smooth N i j (hUS hy)]
  simp_rw [he]
  rw [complex_normalMatrixQuadratic_eq_sum]
  simp only [sum_div]
  apply sum_congr rfl; intro i hi
  exact sum_congr rfl (fun j _ => by ring)

without_proof_info in
theorem native_normalTaylor_reading {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
