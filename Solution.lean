set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_zeroExterior_extension_of_local_zeroTrace
    (hΩH : Ω ≤ H) (hΩU : Ω ≤ U) (hHU : (H : Set E) ∩ U ⊆ Ω)
    (d : W1p μ Ω 2)
    (hd0 : ∀ ψ : E → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value d x)
    (hB : IsCompact (closure (B : Set E))) (hBU : closure (B : Set E) ⊆ U) :
    ∃ w : W1p μ B 2,
      (∀ᵐ x ∂μ.restrict (B : Set E), x ∉ H → W1p.value w x = 0) ∧
      (W1p.value w : E → ℝ) =ᵐ[μ.restrict ((B ⊓ H : Opens E) : Set E)] (W1p.value d : E → ℝ) := by
  obtain ⟨χ, N, hχ, _, hχ1, hχc, hχU, _, _, _⟩ :=
    hB.exists_contDiff_cutoff_with_bounds U.isOpen hBU
  have hχB : ∀ x ∈ B, χ x = 1 := fun x hx => interior_subset (hχ1 (subset_closure hx))
  obtain ⟨v, hv⟩ := hd0 χ hχ hχc hχU
  let vext := W1p0.extendByZeroL hΩU v
  have hBsub : B ≤ U := fun x hx => hBU (subset_closure hx)
  let w := W1p.restrictL hBsub vext.val
  have hext : W1p.value vext.val =ᵐ[μ.restrict (U : Set E)] (Ω : Set E).indicator (W1p.value v.val) := by
    rw [W1p0.value_extendByZeroL]
    exact coeFn_extendByZeroLpₗᵢ ℝ Ω.isOpen.measurableSet hΩU (W1p.value v.val)
  have hw : W1p.value w =ᵐ[μ.restrict (B : Set E)] (Ω : Set E).indicator (W1p.value v.val) :=
    (W1p.value_restrictL_ae hBsub vext.val).trans (ae_restrict_of_ae_restrict_of_subset hBsub hext)
  refine ⟨w, ?_, ?_⟩
  · filter_upwards [hw] with x hx hxH
    rw [hx, indicator_of_notMem (show x ∉ (Ω : Set E) from fun h => hxH (hΩH h))]
  · have hv' := (ae_restrict_iff' Ω.isOpen.measurableSet).1 hv
    filter_upwards [ae_restrict_of_ae_restrict_of_subset inter_subset_left hw,
      ae_restrict_of_ae hv', ae_restrict_mem (B ⊓ H).isOpen.measurableSet] with x hx hvx hxBH
    have hxΩ : x ∈ Ω := hHU ⟨hxBH.2, hBsub hxBH.1⟩
    rw [hx, indicator_of_mem hxΩ, hvx hxΩ, hχB x hxBH.1, one_mul]
end ConformalPoisson

