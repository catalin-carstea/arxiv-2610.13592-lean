    apply Subtype.ext
    apply W1p.ext_value
    apply Lp.ext
    filter_upwards [L.smoothReading_value_ae (a • u), L.smoothReading_value_ae u,
      W1p.value_smul_ae a (L.smoothReading u).val] with z hsmul hu hmul
