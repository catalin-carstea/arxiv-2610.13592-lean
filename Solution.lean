/- Actual analytic partial local isometry for the SAME paired gauges,
fixing the actual beta boundary labels on an original-manifold open hood. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂] [SecondCountableTopology M₁] [SecondCountableTopology M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.exists_local_isometry
    (hSymbol : LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (hn : 2 ≤ n) (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    let J := normalChartTransition C.chart₁ C.chart₂
    ∃ U : TopologicalSpace.Opens M₁,
      (x : M₁) ∈ U ∧ (U : Set M₁) ⊆ J.source ∧ (U : Set M₁) ⊆ P.gauge₁.neighborhood ∧
      (∀ y ∈ U, J y ∈ P.gauge₂.neighborhood) ∧
      (∀ y ∈ U, ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
        P.metric₂.inner (J y) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y v)
          (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y w) = P.metric₁.inner y v w) ∧
      (∀ y : (𝓡∂ (n + 1)).boundary M₁, (y : M₁) ∈ U → J y = (D.boundaryIdentification y : M₂)) := by
  obtain ⟨S, hS, hbase, hgram⟩ := P.exists_equal_gram_neighborhood hSymbol
    hcompact₁ hcompact₂ hconnected₁ hconnected₂ hn C
  have hopen : IsOpen (C.chart₁ '' (S : Set _)) := by
    have h := C.chart₁.toOpenPartialHomeomorph.isOpen_image_of_subset_source S.isOpen
      (fun z hz => hS hz)
    exact h
  let U : TopologicalSpace.Opens M₁ := ⟨C.chart₁ '' (S : Set _), hopen⟩
  refine ⟨U, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · refine ⟨EuclideanHalfSpace.boundaryParam n C.boundaryBase, hbase, ?_⟩
    rw [C.boundaryBase_map, C.base₁]
  · rintro y ⟨z, hz, rfl⟩
    exact normalChartTransition_mem_source C.chart₁ C.chart₂ (hS hz) (C.source_eq ▸ hS hz)
  · rintro y ⟨z, hz, rfl⟩
    exact C.target₁ (C.chart₁.map_source (hS hz))
  · rintro y ⟨z, hz, rfl⟩
    rw [normalChartTransition_apply C.chart₁ C.chart₂ (hS hz)]
    exact C.target₂ (C.chart₂.map_source (C.source_eq ▸ hS hz))
  · rintro y ⟨z, hz, rfl⟩ v w
    exact normalChartTransition_inner C.chart₁ C.chart₂ P.metric₁ P.metric₂ C.geometry₁ C.geometry₂
      (hS hz) (C.source_eq ▸ hS hz) (hgram hz) v w
  · intro y hy
    obtain ⟨z, hz, hzy⟩ := hy
    have hyB : C.chart₁ z ∈ (𝓡∂ (n + 1)).boundary M₁ := hzy.symm ▸ y.property
    have hz0 := partialDiffeomorph_halfSpace_zero_of_boundary C.chart₁ (hS hz) hyB
    rw [← hzy, normalChartTransition_apply C.chart₁ C.chart₂ (hS hz)]
    exact (C.boundary z (hS hz) hz0 hyB).trans
      (congrArg (fun b : (𝓡∂ (n + 1)).boundary M₁ => (D.boundaryIdentification b : M₂)) (Subtype.ext hzy))
end ConformalPoisson

