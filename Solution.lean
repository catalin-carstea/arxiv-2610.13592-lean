/- Interior analytic support: LocalizedTranslationEquation.lean, SHA256 b7ed93cddd2a4ea6a29618330c76412761497c82c881e4c89b7552c0ab87867c -/
noncomputable section ProofPart_InteriorAnalytic_LocalizedTranslationEquation




/- The second-order conjugacy calculation for the SAME supplied scalar
function.  The positive first-order correction below follows from the
paper's negative principal-part convention. -/
open Set Filter TauCeti
open scoped Topology ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem secondFDeriv_localizedTranslation
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (χ : E → ℝ) (a x v w : E) (hχ : ContDiffAt ℝ 2 χ x) :
    fderiv ℝ (fderiv ℝ (localizedTranslation χ a)) x v w =
      fderiv ℝ (fderiv ℝ χ) x v w • a := by
  have hPhi : ContDiffAt ℝ 2 (localizedTranslation χ a) x :=
    contDiffAt_id.add (hχ.smul contDiffAt_const)
  have hnear : ∀ᶠ y in 𝓝 x, DifferentiableAt ℝ (localizedTranslation χ a) y :=
    (hPhi.eventually (by norm_num)).mono fun y hy => hy.differentiableAt (by norm_num)
  have hsub := fderiv_fderiv_sub_clm hnear (ContinuousLinearMap.id ℝ E)
  have heq : (fun y => localizedTranslation χ a y - (ContinuousLinearMap.id ℝ E) y) =
      (fun y => χ y • a) := by funext y; simp [localizedTranslation]
  rw [heq] at hsub
  rw [← hsub]
  exact fderiv_fderiv_smul_const_apply hχ a v w

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def pulledBackCoordinateExpression
    (A : V → V →L[ℝ] V) (b : V → V) (q χ : V → ℝ) (a : V)
    (K : V →L[ℝ] V) (v : V → ℝ) (x : V) : ℝ :=
  -(∑ i : Fin d, fderiv ℝ (fderiv ℝ v) x
      (K (EuclideanSpace.single i 1))
      (K (A (localizedTranslation χ a x) (EuclideanSpace.single i 1)))) +
    fderiv ℝ v x (K (b (localizedTranslation χ a x))) +
    (∑ i : Fin d, fderiv ℝ (fderiv ℝ χ) x
      (K (EuclideanSpace.single i 1))
      (K (A (localizedTranslation χ a x) (EuclideanSpace.single i 1)))) *
        fderiv ℝ v x (K a) + q (localizedTranslation χ a x) * v x

without_proof_info in
theorem pulledBackCoordinateExpression_comp
    (A : V → V →L[ℝ] V) (b : V → V) (q χ u : V → ℝ) (a x : V)
    (K : V →L[ℝ] V) (hχ : ContDiffAt ℝ 2 χ x)
    (hu : ContDiffAt ℝ 2 u (localizedTranslation χ a x))
    (hK : (fderiv ℝ (localizedTranslation χ a) x).comp K = ContinuousLinearMap.id ℝ V) :
    pulledBackCoordinateExpression A b q χ a K (u ∘ localizedTranslation χ a) x =
      coordinateSchrodinger A b q u (localizedTranslation χ a x) := by
  have hPhi : ContDiffAt ℝ 2 (localizedTranslation χ a) x :=
    contDiffAt_id.add (hχ.smul contDiffAt_const)
  have hKapply (v : V) : fderiv ℝ (localizedTranslation χ a) x (K v) = v :=
    congrArg (fun L : V →L[ℝ] V => L v) hK
  have hgrad (v : V) :
      fderiv ℝ (u ∘ localizedTranslation χ a) x (K v) =
        fderiv ℝ u (localizedTranslation χ a x) v := by
    rw [fderiv_comp x (hu.differentiableAt (by norm_num))
      (hPhi.differentiableAt (by norm_num)), ContinuousLinearMap.comp_apply, hKapply]
  have hhess (v w : V) :
      fderiv ℝ (fderiv ℝ (u ∘ localizedTranslation χ a)) x (K v) (K w) =
        fderiv ℝ (fderiv ℝ u) (localizedTranslation χ a x) v w +
          fderiv ℝ (fderiv ℝ χ) x (K v) (K w) *
            fderiv ℝ u (localizedTranslation χ a x) a := by
    rw [fderiv_fderiv_comp_apply hu hPhi, hKapply, hKapply,
      secondFDeriv_localizedTranslation χ a x (K v) (K w) hχ, map_smul, smul_eq_mul]
  unfold pulledBackCoordinateExpression coordinateSchrodinger
  simp_rw [hhess, hgrad]
  rw [Finset.sum_add_distrib, ← Finset.sum_mul]
  simp only [Function.comp_apply]
  ring

end ConformalPoisson

end ProofPart_InteriorAnalytic_LocalizedTranslationEquation

/- Interior analytic support: RealC1BallContinuity.lean, SHA256 240922ed8d5e56808cdf75781e7636d6c41fd00d52e9aa270bcea86b737fcaa9 -/
noncomputable section ProofPart_InteriorAnalytic_RealC1BallContinuity


/- Continuity in Holder norm from the actual uniform value and first
spatial derivative fields.  This real graph is used for the supplied smooth
solution, whose parameter dependence need only be continuous. -/
open Set Metric
open scoped BoundedContinuousFunction NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {V F : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

local notation "Fields" =>
  ((closedBall (0 : V) 1 →ᵇ F) × (closedBall (0 : V) 1 →ᵇ (V →L[ℝ] F)))

local instance : AddCommMonoid Fields :=
  (inferInstance : NormedAddCommGroup Fields).toAddCommGroup.toAddCommMonoid
local instance : Module ℝ Fields := (inferInstance : NormedSpace ℝ Fields).toModule

def realC1BallGraph : Submodule ℝ Fields where
  carrier := {J | ∀ x ∈ ball (0 : V) 1,
    HasFDerivAt (domainRead (closedBall 0 1) J.1)
      (domainRead (closedBall 0 1) J.2 x) x}
  zero_mem' := by
    intro x hx
    simpa using hasFDerivAt_zero (𝕜 := ℝ) (F := F) x
  add_mem' := by
    intro J K hJ hK x hx
    simpa using (hJ x hx).add (hK x hx)
  smul_mem' := by
    intro c J hJ x hx
    simpa only [Prod.smul_fst, Prod.smul_snd, BoundedContinuousFunction.coe_smul,
      domainRead_smul, Pi.smul_apply,
      domainRead_of_mem _ _ (ball_subset_closedBall hx)] using (hJ x hx).const_smul c

instance normedAddCommGroup_realC1BallGraph :
    NormedAddCommGroup (realC1BallGraph (V := V) (F := F)) := by
  unfold realC1BallGraph
  infer_instance

instance normedSpace_realC1BallGraph : NormedSpace ℝ (realC1BallGraph (V := V) (F := F)) :=
  Submodule.normedSpace (𝕜 := ℝ) (R := ℝ) (E := Fields)
    (realC1BallGraph (V := V) (F := F))

without_proof_info in
theorem realC1BallGraph_holderWith {α : ℝ≥0} (hα : α ≤ 1)
    (J : realC1BallGraph (V := V) (F := F)) :
    HolderWith (3 * ‖J‖₊) α J.val.1 := by
  apply holderWith_of_ball_derivative hα J.val.1 J.val.2
  · intro x hx
    simpa only [domainRead_of_mem _ _ (ball_subset_closedBall hx)] using J.property x hx
  · exact norm_fst_le J.val
  · exact norm_snd_le J.val

def realC1BallHolder {α : ℝ≥0} (hα : α ≤ 1)
    (J : realC1BallGraph (V := V) (F := F)) :
    TauCeti.HolderSpace α (closedBall (0 : V) 1) F :=
  TauCeti.HolderSpace.ofBoundedContinuousFunction J.val.1
    (realC1BallGraph_holderWith hα J).memHolder

without_proof_info in
@[simp] theorem realC1BallHolder_apply {α : ℝ≥0} (hα : α ≤ 1)
    (J : realC1BallGraph (V := V) (F := F)) (x : closedBall (0 : V) 1) :
    realC1BallHolder hα J x = J.val.1 x := by simp [realC1BallHolder]

without_proof_info in
theorem norm_realC1BallHolder_le {α : ℝ≥0} (hα : α ≤ 1)
    (J : realC1BallGraph (V := V) (F := F)) : ‖realC1BallHolder hα J‖ ≤ 4 * ‖J‖ := by
  have h := TauCeti.HolderSpace.norm_le_of_norm_le_of_holderWith
    (f := realC1BallHolder hα J) (M := ‖J‖) (norm_nonneg J)
    (fun x => by simpa using (J.val.1.norm_coe_le_norm x).trans (norm_fst_le J.val))
    (by simpa only [funext (realC1BallHolder_apply hα J)] using realC1BallGraph_holderWith hα J)
  convert h using 1
  push_cast
  ring

local instance : AddCommMonoid (realC1BallGraph (V := V) (F := F)) :=
  (inferInstance : NormedAddCommGroup (realC1BallGraph (V := V) (F := F))).toAddCommGroup.toAddCommMonoid
local instance : Module ℝ (realC1BallGraph (V := V) (F := F)) :=
  (inferInstance : NormedSpace ℝ (realC1BallGraph (V := V) (F := F))).toModule

def realC1BallHolderL {α : ℝ≥0} (hα : α ≤ 1) :
    realC1BallGraph (V := V) (F := F) →L[ℝ] TauCeti.HolderSpace α (closedBall (0 : V) 1) F :=
  LinearMap.mkContinuous
    { toFun := realC1BallHolder hα
      map_add' := fun J K => TauCeti.HolderSpace.ext fun x => by simp
      map_smul' := fun c J => TauCeti.HolderSpace.ext fun x => by
        simp [Prod.smul_fst, BoundedContinuousFunction.smul_apply] }
    4 (norm_realC1BallHolder_le hα)

without_proof_info in
theorem exists_continuous_holder_family_of_c1
    {P : Type*} [TopologicalSpace P] {U : Set P} {α : ℝ≥0} (hα : α ≤ 1)
    (v : P → (closedBall (0 : V) 1 →ᵇ F))
    (D : P → (closedBall (0 : V) 1 →ᵇ (V →L[ℝ] F)))
    (hv : ContinuousOn v U) (hD : ContinuousOn D U)
    (hcompat : ∀ p ∈ U, ∀ x ∈ ball (0 : V) 1,
      HasFDerivAt (domainRead (closedBall 0 1) (v p))
        (domainRead (closedBall 0 1) (D p) x) x) :
    ∃ H : P → TauCeti.HolderSpace α (closedBall (0 : V) 1) F,
      ContinuousOn H U ∧ ∀ p ∈ U, ∀ x, H p x = v p x := by
  classical
  let g (p : P) : realC1BallGraph (V := V) (F := F) :=
    if hp : p ∈ U then ⟨(v p, D p), hcompat p hp⟩ else 0
  have hread (p : P) (hp : p ∈ U) : (g p).val = (v p, D p) := by simp [g, hp]
  have hval : ContinuousOn (fun p => (g p).val) U :=
    (hv.prodMk hD).congr fun p hp => hread p hp
  have hg : ContinuousOn g U :=
    (Topology.IsInducing.subtypeVal.continuousOn_iff).mpr hval
  refine ⟨fun p => realC1BallHolder hα (g p), ?_, fun p hp x => ?_⟩
  · exact (realC1BallHolderL hα).continuous.comp_continuousOn hg
  · rw [realC1BallHolder_apply]
    exact congrArg (fun z => z.1 x) (hread p hp)

end ConformalPoisson

end ProofPart_InteriorAnalytic_RealC1BallContinuity

/- Interior analytic support: ContinuousBallJetFamily.lean, SHA256 2310eab084eebd2b3ca321856514105bfcc8da8652e1c7a455a6fbdf3109f68f -/
noncomputable section ProofPart_InteriorAnalytic_ContinuousBallJetFamily



/- A continuous family in the actual zero-Dirichlet C2-alpha graph,
constructed from the same compatible derivatives through order three.
No analyticity of the supplied smooth solution is assumed here. -/
open Set Metric
open scoped BoundedContinuousFunction NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [TopologicalSpace P]

local instance : NormedAddCommGroup (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := E →L[ℝ] E →L[ℝ] F)

without_proof_info in
theorem exists_continuous_ballJet_family {U : Set P} {α : ℝ≥0} (hα : α ≤ 1)
    (v : P → (closedBall (0 : E) 1 →ᵇ F))
    (D1 : P → (closedBall (0 : E) 1 →ᵇ (E →L[ℝ] F)))
    (D2 : P → (closedBall (0 : E) 1 →ᵇ (E →L[ℝ] E →L[ℝ] F)))
    (D3 : P → (closedBall (0 : E) 1 →ᵇ (E →L[ℝ] E →L[ℝ] E →L[ℝ] F)))
    (hv : ContinuousOn v U) (hD1 : ContinuousOn D1 U)
    (hD2 : ContinuousOn D2 U) (hD3 : ContinuousOn D3 U)
    (h1 : ∀ p ∈ U, ∀ x ∈ ball (0 : E) 1,
      HasFDerivAt (domainRead (closedBall 0 1) (v p))
        (domainRead (closedBall 0 1) (D1 p) x) x)
    (h2 : ∀ p ∈ U, ∀ x ∈ ball (0 : E) 1,
      HasFDerivAt (domainRead (closedBall 0 1) (D1 p))
        (domainRead (closedBall 0 1) (D2 p) x) x)
    (h3 : ∀ p ∈ U, ∀ x ∈ ball (0 : E) 1,
      HasFDerivAt (domainRead (closedBall 0 1) (D2 p))
        (domainRead (closedBall 0 1) (D3 p) x) x)
    (hboundary : ∀ p ∈ U, ∀ x : closedBall (0 : E) 1,
      (x : E) ∈ sphere 0 1 → v p x = 0) :
    ∃ J : P → BallSpace α E F, ContinuousOn J U ∧
      ∀ p ∈ U, (J p).val.1 = v p ∧ (J p).val.2.1 = D1 p ∧
        ∀ x, (J p).val.2.2 x = D2 p x := by
  classical
  obtain ⟨H2, hH2, hH2eq⟩ := exists_continuous_holder_family_of_c1
    (V := E) (F := E →L[ℝ] E →L[ℝ] F) hα D2 D3 hD2 hD3 h3
  have hH2field (p : P) (hp : p ∈ U) : (H2 p).toBoundedContinuousFunction = D2 p := by
    apply BoundedContinuousFunction.ext
    intro x
    simpa only [TauCeti.HolderSpace.toBoundedContinuousFunction_apply] using hH2eq p hp x
  let J (p : P) : BallSpace α E F := if hp : p ∈ U then
    ⟨(v p, D1 p, H2 p), h1 p hp,
      (by intro x hx; rw [hH2field p hp]; exact h2 p hp x hx), hboundary p hp⟩ else 0
  have hread (p : P) (hp : p ∈ U) : (J p).val = (v p, D1 p, H2 p) := by simp [J, hp]
  have hval : ContinuousOn (fun p => (J p).val) U :=
    (hv.prodMk (hD1.prodMk hH2)).congr fun p hp => hread p hp
  have hJ : ContinuousOn J U := (Topology.IsInducing.subtypeVal.continuousOn_iff).mpr hval
  refine ⟨J, hJ, fun p hp => ?_⟩
  rw [hread p hp]
  exact ⟨rfl, rfl, hH2eq p hp⟩

end ConformalPoisson.DirichletHolder

end ProofPart_InteriorAnalytic_ContinuousBallJetFamily

/- Interior analytic support: ParameterizedCompactFields.lean, SHA256 0c8d61224e560a05a7116ff50281bbe9feca9dac7208dc428654825bf97e3b12 -/
noncomputable section ProofPart_InteriorAnalytic_ParameterizedCompactFields



/- One uniform-norm field for an actual jointly continuous family on
a fixed compact spatial set.  Values outside the parameter set may default
to zero; every value inside it is the supplied function. -/
open Set
open scoped BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {P B K F : Type*} [TopologicalSpace P] [TopologicalSpace B]
  [TopologicalSpace K] [CompactSpace K] [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem exists_continuous_compact_field {U : Set P} {W : Set B}
    (f : P → B → F) (i : K → B) (hi : Continuous i) (hiW : ∀ x, i x ∈ W)
    (hf : ContinuousOn (Function.uncurry f) (U ×ˢ W)) :
    ∃ v : P → (K →ᵇ F), ContinuousOn v U ∧ ∀ p ∈ U, ∀ x, v p x = f p (i x) := by
  let v0 : P → C(K, F) := fun p => ContinuousMap.mkD (fun x => f p (i x)) 0
  let L : C(K, F) →L[ℝ] (K →ᵇ F) :=
    (ContinuousMap.linearIsometryBoundedOfCompact K F ℝ).toLinearIsometry.toContinuousLinearMap
  have hc : ContinuousOn v0 U := by
    apply ContinuousMap.continuousOn_mkD_of_uncurry
    exact hf.comp (continuous_fst.prodMk (hi.comp continuous_snd)).continuousOn
      (fun z hz => ⟨hz.1, hiW z.2⟩)
  refine ⟨fun p => L (v0 p), L.continuous.comp_continuousOn hc, ?_⟩
  intro p hp x
  change ContinuousMap.mkD (fun x => f p (i x)) 0 x = _
  apply ContinuousMap.mkD_apply_of_continuous
  exact hf.comp_continuous (continuous_const.prodMk hi) (fun x => ⟨hp, hiW x⟩)

end ConformalPoisson

end ProofPart_InteriorAnalytic_ParameterizedCompactFields

/- Interior analytic support: SmoothBallJetFamilies.lean, SHA256 da8eec20c49e0be4ffdcb0531405c5ec81b80c136adddeeddde965ae098aa4c9 -/
noncomputable section ProofPart_InteriorAnalytic_SmoothBallJetFamilies




/- Joint smoothness on a neighborhood of the fixed closed ball produces
the actual continuous zero-boundary C2-alpha family.  The third spatial
derivative is used only to control Holder continuity of the Hessian. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem hasFDerivAt_domainRead_of_ball_values
    (v : closedBall (0 : E) 1 →ᵇ F) (f : E → F)
    (hv : ∀ y, v y = f y) {x : E} (hx : x ∈ ball 0 1)
    (hf : DifferentiableAt ℝ f x) :
    HasFDerivAt (domainRead (closedBall 0 1) v) (fderiv ℝ f x) x := by
  apply hf.hasFDerivAt.congr_of_eventuallyEq
  filter_upwards [isOpen_ball.mem_nhds hx] with y hy
  rw [domainRead_of_mem _ _ (ball_subset_closedBall hy), hv]

variable [ProperSpace E] [NormedAddCommGroup P] [NormedSpace ℝ P]

local instance : NormedAddCommGroup (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := E →L[ℝ] E →L[ℝ] F)
local instance : NormedSpace ℝ (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedSpace (𝕜 := ℝ) (𝕜₂ := ℝ) (𝕜' := ℝ)
    (σ₁₂ := RingHom.id ℝ) (E := E) (F := E →L[ℝ] E →L[ℝ] F)

without_proof_info in
theorem exists_ballJets_of_smooth_joint_family {α : ℝ≥0} (hα : α ≤ 1)
    {U : Set P} {W : Set E} (hW : IsOpen W) (hKW : closedBall (0 : E) 1 ⊆ W)
    (f : P → E → F) (hf : ContDiffOn ℝ ∞ (Function.uncurry f) (U ×ˢ W))
    (hboundary : ∀ p ∈ U, ∀ x : E, x ∈ sphere 0 1 → f p x = 0) :
    ∃ J : P → BallSpace α E F, ContinuousOn J U ∧
      ∀ p ∈ U, ∀ x : closedBall (0 : E) 1,
        (J p).val.1 x = f p x ∧
        (J p).val.2.1 x = fderiv ℝ (f p) x ∧
        (J p).val.2.2 x = fderiv ℝ (fderiv ℝ (f p)) x := by
  let D1 : P → E → (E →L[ℝ] F) := fun p => fderiv ℝ (f p)
  let D2 : P → E → (E →L[ℝ] E →L[ℝ] F) := fun p => fderiv ℝ (D1 p)
  let D3 : P → E → (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) := fun p => fderiv ℝ (D2 p)
  have hf1 : ContDiffOn ℝ ∞ (Function.uncurry D1) (U ×ˢ W) :=
    ContDiffOn.fderiv_right (𝕜 := ℝ) (f := f) (n := ∞) hW hf
  have hf2 : ContDiffOn ℝ ∞ (Function.uncurry D2) (U ×ˢ W) :=
    ContDiffOn.fderiv_right (𝕜 := ℝ) (f := D1) (n := ∞) hW hf1
  have hf3 : ContDiffOn ℝ ∞ (Function.uncurry D3) (U ×ˢ W) :=
    ContDiffOn.fderiv_right (𝕜 := ℝ) (f := D2) (n := ∞) hW hf2
  obtain ⟨v, hv, hveq⟩ := exists_continuous_compact_field f
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf.continuousOn
  obtain ⟨v1, hv1, hv1eq⟩ := exists_continuous_compact_field D1
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf1.continuousOn
  obtain ⟨v2, hv2, hv2eq⟩ := exists_continuous_compact_field D2
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf2.continuousOn
  obtain ⟨v3, hv3, hv3eq⟩ := exists_continuous_compact_field D3
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf3.continuousOn
  have hslice {G : P → E → F} (hG : ContDiffOn ℝ ∞ (Function.uncurry G) (U ×ˢ W))
      (p : P) (hp : p ∈ U) {x : E} (hx : x ∈ W) : ContDiffAt ℝ ∞ (G p) x :=
    (hG.comp (contDiffOn_const.prodMk contDiffOn_id)
