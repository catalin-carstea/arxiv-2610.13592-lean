/-- Turn a proved weak/native smooth boundary regularity producer into
the exact forward inhomogeneous input used by Theorem 1.1. -/
theorem forwardInhomogeneous_of_weak_regularity [T2Space M]
    (hregularity : ∀ (g : Metric (n := n) (M := M)) (q : M → ℝ)
      (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q), NativeWeakDirichletRegularity g q hq) :
    ForwardInhomogeneousAssumption (n := n) (M := M) := by
