theorem homogeneous_multi_preserved
    (D : Fin n → NativeSymbol n → NativeSymbol n) {d : ℤ}
    (hD : ∀ i b, Homogeneous S d b → Homogeneous S d (D i b))
    (α : Fin n → ℕ) {b : NativeSymbol n} (hb : Homogeneous S d b) :
    Homogeneous S d (symbolMultiDeriv D α b) := by
  have hi : ∀ i m b, Homogeneous S d b → Homogeneous S d ((D i)^[m] b) := by
    intro i m
    induction m with
    | zero => intro b hb; exact hb
    | succ m ih =>
      intro b hb
      rw [Function.iterate_succ_apply']
      exact hD i _ (ih b hb)
