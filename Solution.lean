/- The actual closed-ball Schrodinger operator depends bounded-linearly
on its Holder coefficients. Therefore coefficient analyticity is genuinely
operator-norm analyticity on the SAME zero-Dirichlet graph. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "X" => BallSpace α V ℝ

def ballPrincipalOperatorL (i : Fin d) :
    (H (V →L[ℝ] V)) →L[ℝ] (X →L[ℝ] H ℝ) :=
  ((ContinuousLinearMap.compL ℝ X (H (V →L[ℝ] ℝ)) (H ℝ)).flip
    ((TauCeti.HolderSpace.compLeftL
      (ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) (EuclideanSpace.single i (1 : ℝ)))).comp
      ballSecondHolderL)).comp
    (((ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂).comp
      (TauCeti.HolderSpace.compLeftL
        (ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i (1 : ℝ)))))

without_proof_info in
@[simp] theorem ballPrincipalOperatorL_apply (i : Fin d) (a : H (V →L[ℝ] V)) :
    ballPrincipalOperatorL i a = ballPrincipalTerm a i := by
  simp [ballPrincipalOperatorL, ballPrincipalTerm]

def ballDriftOperatorL (hα : α ≤ 1) : (H V) →L[ℝ] (X →L[ℝ] H ℝ) :=
  ((ContinuousLinearMap.compL ℝ X (H (V →L[ℝ] ℝ)) (H ℝ)).flip
    (ballFirstHolderL hα)).comp
    (ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂

def ballPotentialOperatorL (hα : α ≤ 1) : (H ℝ) →L[ℝ] (X →L[ℝ] H ℝ) :=
  ((ContinuousLinearMap.compL ℝ X (H ℝ) (H ℝ)).flip (ballValueHolderL hα)).comp
    (ContinuousLinearMap.mul ℝ ℝ).compHolder₂

def ballCoefficientOperatorL (hα : α ≤ 1) :
    ((H (V →L[ℝ] V)) × (H V) × (H ℝ)) →L[ℝ] (X →L[ℝ] H ℝ) :=
  (-(∑ i : Fin d, ballPrincipalOperatorL i)).coprod
    ((ballDriftOperatorL hα).coprod (ballPotentialOperatorL hα))

without_proof_info in
@[simp] theorem ballCoefficientOperatorL_apply (hα : α ≤ 1)
    (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ) :
    ballCoefficientOperatorL hα (a, b, q) = ballSchrodinger hα a b q := by
  simp [ballCoefficientOperatorL, ballDriftOperatorL, ballPotentialOperatorL, ballSchrodinger,
    add_assoc]

variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P]

without_proof_info in
theorem analyticAt_ballSchrodinger (hα : α ≤ 1)
    {a : P → H (V →L[ℝ] V)} {b : P → H V} {q : P → H ℝ} {p : P}
    (ha : AnalyticAt ℝ a p) (hb : AnalyticAt ℝ b p) (hq : AnalyticAt ℝ q p) :
    AnalyticAt ℝ (fun z => ballSchrodinger hα (a z) (b z) (q z)) p := by
  have htuple : AnalyticAt ℝ (fun z => (a z, b z, q z)) p :=
    (ha.contDiffAt.prodMk (hb.contDiffAt.prodMk hq.contDiffAt)).analyticAt
  simpa only [Function.comp_def, ballCoefficientOperatorL_apply] using
    ((ballCoefficientOperatorL hα).analyticAt _).comp htuple

without_proof_info in
theorem analyticAt_preconditioned_ballSchrodinger (hα : α ≤ 1) (T : (H ℝ) →L[ℝ] X)
    {a : P → H (V →L[ℝ] V)} {b : P → H V} {q : P → H ℝ} {p : P}
    (ha : AnalyticAt ℝ a p) (hb : AnalyticAt ℝ b p) (hq : AnalyticAt ℝ q p) :
    AnalyticAt ℝ (fun z => T.comp (ballSchrodinger hα (a z) (b z) (q z))) p := by
  have hA := analyticAt_ballSchrodinger (d := d) (α := α) hα ha hb hq
  let C : (X →L[ℝ] H ℝ) →L[ℝ] (X →L[ℝ] X) :=
    (ContinuousLinearMap.compL ℝ X (H ℝ) X) T
  exact (C.analyticAt _).comp hA

end ConformalPoisson.DirichletHolder

end ProofPart_InteriorAnalytic_AnalyticBallOperator

