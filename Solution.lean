    (hK : IsCompact K) (hUK : (U : Set _) ⊆ K) (hKD : K ⊆ D)
    {q : D → ℝ} (hq : Continuous q) :
    Nonempty (H2CoordinateCoefficients (ν := ν) (U := U)
      (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q)) := by
  have hA : ContinuousOn (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (D : Set _) := by
    have hh := continuousOn_chartPrincipal_target (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p
    rw [ambient_extChartAt_target] at hh
    exact hh
  have hB : ContinuousOn (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (D : Set _) := by
    have hh := (contDiffOn_chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p).continuousOn
    rw [ambient_extChartAt_target, D.isOpen.interior_eq] at hh
    exact hh
  have hQ : ContinuousOn (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q)
