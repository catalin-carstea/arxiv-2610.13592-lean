/- Green/trace proof support: NativeNormalBound.lean, SHA256 0fa1b1c3114c1179cb371c8a4288d7c0224f72122a0e1a81c6e07cfcbdcaf58f -/
noncomputable section ProofPart_GreenTrace_NativeNormalBound




/-
Native normal readback for the commissioned normal-trace estimate.
The gradient interface below is discharged by NativeNormalTraceInverseProved.
This module provides the native unit-normal readback used by that producer.
-/
open Bundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
/-- The actual unit-normal trace is bounded by the actual Riemannian gradient.
No separate continuity or smoothness assumption on the supplied normal is needed. -/
theorem abs_normalDerivative_le_norm_mgradient
    (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y)) (u : M → ℝ)
    (y : (𝓡∂ (n + 1)).boundary M) :
    letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
      ⟨g.toRiemannianMetric⟩
    |normalDerivative ν u y| ≤ ‖mgradient (𝓡∂ (n + 1)) u (y : M)‖ := by
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨g.toRiemannianMetric⟩
  have hnorm : ‖ν y‖ = 1 := by
    rw [norm_eq_sqrt_real_inner]
    change Real.sqrt (g.inner y (ν y) (ν y)) = 1
    rw [(hν y).2.1, Real.sqrt_one]
  change |mvfderiv (𝓡∂ (n + 1)) u (y : M) (ν y)| ≤ _
  rw [← inner_mgradient (I := 𝓡∂ (n + 1)) (f := u) (x := (y : M)) (ν y)]
  simpa only [hnorm, mul_one] using
    abs_real_inner_le_norm (mgradient (𝓡∂ (n + 1)) u (y : M)) (ν y)

/-- Quantitative interface, proved by nativeBoundaryGradientInverseEstimate and
still exposed as a hypothesis in the earlier diagnostic callers.
One constant is fixed before every forcing, solution and boundary point, and before
any choice of outward normal. The selected five-input root may not assume it. -/
def BoundaryGradientInverseEstimate [T2Space M] [MeasurableSpace M] [BorelSpace M]
    [LindelofSpace M] : Prop :=
  IsCompact (univ : Set M) →
    ∀ (g : Metric (n := n) (M := M)) (q : M → ℝ),
      ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q → Nonresonant g q →
      ∀ r : ℝ, (n + 1 : ℝ) < r → ∃ C : ℝ≥0,
        letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
          ⟨g.toRiemannianMetric⟩
        ∀ F w : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F →
          IsZeroDirichletSolution g q F w →
          ∀ y : (𝓡∂ (n + 1)).boundary M,
            ‖mgradient (𝓡∂ (n + 1)) w (y : M)‖ ≤ (C : ℝ) *
              (eLpNorm F (ENNReal.ofReal r) (nativeVolume g)).toReal

without_proof_info in
/-- A proved quantitative gradient bound supplies the exact old trace interface. -/
theorem normalTraceInverseEstimate_of_boundaryGradient
    [T2Space M] [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
    (hGradient : BoundaryGradientInverseEstimate (n := n) (M := M)) :
    NormalTraceInverseEstimateAssumption (n := n) (M := M) := by
  intro hM g q hq hNR ν hν r hr
  obtain ⟨C, hC⟩ := hGradient hM g q hq hNR r hr
  refine ⟨C, fun F w hF hw y => ?_⟩
  exact (abs_normalDerivative_le_norm_mgradient g ν hν w y).trans (hC F w hF hw y)

end ConformalPoisson

end ProofPart_GreenTrace_NativeNormalBound

/- Green/trace proof support: NativeC1Size.lean, SHA256 aead68b058ab458d52023842e47202a8e7c58320edcda258cc3b3b9333b8c9b2 -/
noncomputable section ProofPart_GreenTrace_NativeC1Size



/- One actual native C1 supremum, used only to absorb local lower-order
errors. Its norm controls the same solution and native gradient everywhere. -/
open Bundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def nativeC1Function (g : Metric (n := n) (M := M)) (u : M → ℝ)
    (hu : ContMDiff Ihalf 𝓘(ℝ) 1 u) : C(M, ℝ) := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  exact ⟨fun x => |u x| + ‖mgradient Ihalf u x‖,
    hu.continuous.abs.add (continuous_norm_mgradient hu)⟩

without_proof_info in
theorem nativeC1Function_apply (g : Metric (n := n) (M := M)) (u : M → ℝ)
    (hu : ContMDiff Ihalf 𝓘(ℝ) 1 u) (x : M) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    nativeC1Function g u hu x = |u x| + ‖mgradient Ihalf u x‖ := by rfl

without_proof_info in
theorem nativeC1Function_nonneg (g : Metric (n := n) (M := M)) (u : M → ℝ)
    (hu : ContMDiff Ihalf 𝓘(ℝ) 1 u) (x : M) : 0 ≤ nativeC1Function g u hu x := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  rw [nativeC1Function_apply]
  exact add_nonneg (abs_nonneg _) (norm_nonneg _)

without_proof_info in
theorem native_value_gradient_le_c1_norm (g : Metric (n := n) (M := M)) (u : M → ℝ)
    (hu : ContMDiff Ihalf 𝓘(ℝ) 1 u) (x : M) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    |u x| + ‖mgradient Ihalf u x‖ ≤ ‖nativeC1Function g u hu‖ := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  rw [← nativeC1Function_apply g u hu x]
  have h := (nativeC1Function g u hu).norm_coe_le_norm x
  rwa [Real.norm_eq_abs, abs_of_nonneg (nativeC1Function_nonneg g u hu x)] at h

end ConformalPoisson

end ProofPart_GreenTrace_NativeC1Size

/- Green/trace proof support: BoundaryChartLpRepresentatives.lean, SHA256 7d67fca77531372adfd957894664eea9731016064efc0fd0768efe958808e3f2 -/
noncomputable section ProofPart_GreenTrace_BoundaryChartLpRepresentatives



/- Actual chart representatives at arbitrary Sobolev exponents. The compact
set includes the physical boundary; bounds come from derivatives within the
relative chart target, without an assumed ambient smooth extension. The
intended caller is the boundary W2p estimate for a native Dirichlet solution. -/
open Bundle Set Metric Filter MeasureTheory TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

without_proof_info in
/-- The existing relative derivative bounds supply a genuine Wkp element
at every exponent, with the exact chosen scalar representative. -/
theorem exists_wkp_of_relative_smooth_lp {S K : Set E} {Ω : TopologicalSpace.Opens E}
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set E) ⊆ K) (hΩS : (Ω : Set E) ⊆ interior S)
    {f : E → ℝ} (hf : ContDiffOn ℝ ∞ f S) (k : ℕ) :
    ∃ U : Wkp μ Ω p k, Wkp.value k U =ᵐ[μ.restrict Ω] f :=
  Wkp.exists_value_ae_eq_of_contDiffOn k
    ((hf.mono (hΩS.trans interior_subset)).of_le (by simp))
    (fun i _ => memLp_iteratedFDeriv_of_relative_smooth hS hK hKS hΩK hΩS hf i p)

without_proof_info in
/-- A smooth native scalar has a Wkp reading on the actual bounded chart cap,
even when the cap closure meets the native boundary. -/
theorem exists_Wkp_boundary_chart_reading (c : M) {r : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) ∞ u) (k : ℕ) :
    ∃ U : Wkp μ (boundaryChartCap (I := I) c r) p k,
      Wkp.value k U =ᵐ[μ.restrict (boundaryChartCap (I := I) c r : Set E)]
        (u ∘ (extChartAt I c).symm) := by
  have huS : ContMDiffOn I 𝓘(ℝ) ∞ u (extChartAt I c).source := hu.contMDiffOn
  have hs : ContDiffOn ℝ ∞ (u ∘ (extChartAt I c).symm) (extChartAt I c).target :=
    (huS.comp (contMDiffOn_extChartAt_symm c)
      (fun z hz => (extChartAt I c).map_target hz)).contDiffOn
  exact exists_wkp_of_relative_smooth_lp (uniqueDiffOn_extChartAt_target c)
    ((isCompact_closedBall _ _).inter_right I.isClosed_range) hrt
    (fun z (hz : z ∈ (boundaryChartCap (I := I) c r : Set E)) =>
      ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩)
    (boundaryChartCap_subset_interior_target c hrt) hs k

without_proof_info in
/-- The same exact cutoff has Wkp representatives at every order and exponent. -/
theorem exists_Wkp_boundary_chart_cutoff (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) ∞ u) (k : ℕ) :
    ∃ U : Wkp μ (boundaryChartCap (I := I) c r) p k,
      Wkp.value k U =ᵐ[μ.restrict (boundaryChartCap (I := I) c r : Set E)]
        (fun z => b z * u ((extChartAt I c).symm z)) := by
  have huS : ContMDiffOn I 𝓘(ℝ) ∞ u (extChartAt I c).source := hu.contMDiffOn
  have hs : ContDiffOn ℝ ∞ (u ∘ (extChartAt I c).symm) (extChartAt I c).target :=
    (huS.comp (contMDiffOn_extChartAt_symm c)
      (fun z hz => (extChartAt I c).map_target hz)).contDiffOn
  exact exists_wkp_of_relative_smooth_lp (uniqueDiffOn_extChartAt_target c)
    ((isCompact_closedBall _ _).inter_right I.isClosed_range) hrt
    (fun z (hz : z ∈ (boundaryChartCap (I := I) c r : Set E)) =>
      ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩)
    (boundaryChartCap_subset_interior_target c hrt) (b.contDiff.contDiffOn.mul hs) k

without_proof_info in
/-- The physical zero boundary value and the artificial cutoff boundary give
an actual W1p0 element for every finite p. No quantitative estimate or trace
assumption is added to the native solution. -/
theorem exists_W1p0_boundary_chart_cutoff_lp (hp : p ≠ ⊤) (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r : ℝ} (hbr : b.rOut < r)
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) ∞ u)
    (hu0 : ∀ x, I.IsBoundaryPoint x → u x = 0) :
    ∃ U : W1p0 μ (boundaryChartCap (I := I) c r) p,
      W1p.value (U : W1p μ (boundaryChartCap (I := I) c r) p) =ᵐ[μ.restrict
        (boundaryChartCap (I := I) c r : Set E)]
        (fun z => b z * u ((extChartAt I c).symm z)) := by
  obtain ⟨U, hU⟩ := exists_Wkp_boundary_chart_cutoff (μ := μ) (p := p) c b hrt hu 1
  have hUv : W1p.value U =ᵐ[μ.restrict (boundaryChartCap (I := I) c r : Set E)]
      (fun z => b z * u ((extChartAt I c).symm z)) := by
    simpa only [Wkp.value_one] using hU
  have htrace := boundary_chart_cutoff_continuous_zero_frontier c b hbr hrt hu.continuous hu0
  exact ⟨⟨U, W1p.mem_w1p0Submodule_of_continuousOn_closure hp
    (isBounded_ball.subset inter_subset_left) htrace.1 htrace.2 hUv⟩, hUv⟩

end ConformalPoisson

end ProofPart_GreenTrace_BoundaryChartLpRepresentatives

/- Green/trace proof support: SplitBoundaryChartLp.lean, SHA256 519b3bdd073b03a879cdbe9ab664ab8daee9b7263e57601539071a269409dd4e -/
noncomputable section ProofPart_GreenTrace_SplitBoundaryChartLp




/- Actual finite-p chart readings in the product coordinates used by the
pinned half-space Hessian estimate. The isometry preserves Euclidean volume
and the physical flat boundary. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ∞ M]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

def splitBoundaryChartCap (c : M) (r : ℝ) : Opens P :=
  ⟨euclideanNormalSplit n ⁻¹' (boundaryChartCap (I := Ihalf) c r : Set V),
    (euclideanNormalSplit n).continuous.isOpen_preimage _
      (boundaryChartCap (I := Ihalf) c r).isOpen⟩

without_proof_info in
theorem splitBoundaryChartCap_mono (c : M) {r R : ℝ} (h : r ≤ R) :
    splitBoundaryChartCap (n := n) c r ≤ splitBoundaryChartCap (n := n) c R := by
  intro z hz
  exact ⟨ball_subset_ball h hz.1, hz.2⟩

without_proof_info in
theorem contDiffOn_split_boundary_chart_reading (c : M) {r : ℝ}
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    {u : M → ℝ} (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) :
    ContDiffOn ℝ ∞ (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)))
      (splitBoundaryChartCap (n := n) c r) := by
  have hS : ContMDiffOn Ihalf 𝓘(ℝ) ∞ u (extChartAt Ihalf c).source := hu.contMDiffOn
  have hs : ContDiffOn ℝ ∞ (u ∘ (extChartAt Ihalf c).symm) (extChartAt Ihalf c).target :=
    (hS.comp (contMDiffOn_extChartAt_symm c)
      (fun z hz => (extChartAt Ihalf c).map_target hz)).contDiffOn
  exact hs.comp (euclideanNormalSplit n).contDiff.contDiffOn fun z hz =>
    hrt ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩

without_proof_info in
/-- The actual cap is exactly the standard half-space inside its ball. -/
theorem splitBoundaryChartCap_eq (c : M) (r : ℝ) :
    (splitBoundaryChartCap (n := n) c r : Set P) =
      ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) r ∩
        (normalHalfSpace (E := EuclideanSpace ℝ (Fin n)) 0 : Set P) := by
  ext z
  change (dist (euclideanNormalSplit n z) (extChartAt Ihalf c c) < r ∧
      euclideanNormalSplit n z ∈ interior (range Ihalf)) ↔ _
  rw [interior_range_modelWithCornersEuclideanHalfSpace]
  have hd : dist (euclideanNormalSplit n z) (extChartAt Ihalf c c) =
      dist z ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) := by
    rw [← (euclideanNormalSplit n).dist_map z
      ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)),
      LinearIsometryEquiv.apply_symm_apply]
  simp only [hd, mem_ofPred_eq, euclideanNormalSplit_zero, mem_inter_iff, mem_ball, SetLike.mem_coe,
    mem_normalHalfSpace, WithLp.ofLp_fst]

without_proof_info in
/-- A native scalar has a split Wkp reading at every order and exponent,
without a zero-boundary or finite-exponent restriction. -/
theorem exists_split_boundary_chart_reading (c : M) {r : ℝ}
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    {u : M → ℝ} (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) (k : ℕ) :
    ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c r) p k,
      Wkp.value k U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)]
        fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) := by
  let e := euclideanNormalSplit n
  have he : MeasurePreserving e (volume : Measure P) (volume : Measure V) := e.measurePreserving
  have hcap : (splitBoundaryChartCap (n := n) c r : Set P) =
      e ⁻¹' (boundaryChartCap (I := Ihalf) c r : Set V) := rfl
  have her := hcap ▸ he.restrict_preimage (boundaryChartCap (I := Ihalf) c r).isOpen.measurableSet
  obtain ⟨W, hW⟩ := exists_Wkp_boundary_chart_reading
    (μ := (volume : Measure V)) (p := p) c hrt hu k
  let U := Wkp.compLinearIsometryEquiv he hcap k W
  refine ⟨U, ?_⟩
  filter_upwards [Wkp.value_compLinearIsometryEquiv_ae he hcap k W,
    her.quasiMeasurePreserving.ae hW] with z h1 h2
  exact h1.trans h2

without_proof_info in
/-- The actual split reading and its first gradient lie in the same Lp. -/
theorem split_boundary_chart_value_gradient_memLp (c : M) {r : ℝ}
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    {u : M → ℝ} (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) :
    MemLp (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) p
        (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) ∧
      MemLp (∇ (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)))) p
        (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) := by
  obtain ⟨U, hU⟩ := exists_split_boundary_chart_reading (p := p) c hrt hu 2
  have hUv : W1p.value (Wkp.lowerOrder 1 U) =ᵐ[volume.restrict
      (splitBoundaryChartCap (n := n) c r : Set P)]
        fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) := by
    rw [Wkp.value_lowerOrder_one]
    exact hU
  have hg := W1p.gradient_ae_eq_of_contDiffOn (Wkp.lowerOrder 1 U)
    ((contDiffOn_split_boundary_chart_reading c hrt hu).of_le (by simp)) hUv
  exact ⟨(Lp.memLp (Wkp.value 2 U)).ae_eq hU,
    (Lp.memLp (W1p.gradient (Wkp.lowerOrder 1 U))).ae_eq hg⟩

without_proof_info in
/-- Transport the same native scalar and the same cutoff, with exact value
identities, to the half-space estimate's product model. -/
theorem exists_split_boundary_chart_readings (hp : p ≠ ⊤) (c : M)
    (b : ContDiffBump (extChartAt Ihalf c c)) {r : ℝ} (hbr : b.rOut < r)
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    {u : M → ℝ} (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hu0 : ∀ x, (𝓡∂ (n + 1)).IsBoundaryPoint x → u x = 0) :
    ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c r) p 2,
      Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)]
        (fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
      ∃ Z : W1p0 (volume : Measure P) (splitBoundaryChartCap (n := n) c r) p,
        W1p.value (Z : W1p volume (splitBoundaryChartCap (n := n) c r) p) =ᵐ[volume.restrict
          (splitBoundaryChartCap (n := n) c r : Set P)]
          (fun z => b (euclideanNormalSplit n z) * Wkp.value 2 U z) := by
  let e := euclideanNormalSplit n
  have he : MeasurePreserving e (volume : Measure P) (volume : Measure V) := e.measurePreserving
  have hcap : (splitBoundaryChartCap (n := n) c r : Set P) =
      e ⁻¹' (boundaryChartCap (I := Ihalf) c r : Set V) := rfl
  have her := hcap ▸ he.restrict_preimage (boundaryChartCap (I := Ihalf) c r).isOpen.measurableSet
  obtain ⟨U, hU⟩ := exists_split_boundary_chart_reading (p := p) c hrt hu 2
  obtain ⟨Z, hZ⟩ := exists_W1p0_boundary_chart_cutoff_lp
    (μ := (volume : Measure V)) (p := p) hp c b hbr hrt hu hu0
  let Q : W1p volume (splitBoundaryChartCap (n := n) c r) p :=
    Wkp.compLinearIsometryEquiv he hcap 1
      (Z : W1p volume (boundaryChartCap (I := Ihalf) c r) p)
  have hZ0 : (Z : W1p volume (boundaryChartCap (I := Ihalf) c r) p) ∈
      w1p0Submodule volume (boundaryChartCap (I := Ihalf) c r) p :=
    (ClosedSubmodule.mem_toSubmodule_iff _ _).mp Z.property
  have hQ0 : Q ∈ w1p0Submodule volume (splitBoundaryChartCap (n := n) c r) p := by
    have h := Wkp.compLinearIsometryEquiv_mem_wkp0Submodule he hcap 1
      (show (Z : W1p volume (boundaryChartCap (I := Ihalf) c r) p) ∈
          wkp0Submodule volume (boundaryChartCap (I := Ihalf) c r) p 1 by
        simpa only [wkp0Submodule_one] using hZ0)
    simpa only [wkp0Submodule_one] using h
  refine ⟨U, hU, ⟨Q, (ClosedSubmodule.mem_toSubmodule_iff _ _).mpr hQ0⟩, ?_⟩
  have hQ : W1p.value Q =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)]
      fun z => W1p.value (Z : W1p volume (boundaryChartCap (I := Ihalf) c r) p) (e z) := by
    simpa only [Wkp.value_one] using
      Wkp.value_compLinearIsometryEquiv_ae he hcap 1 (Z : W1p volume (boundaryChartCap (I := Ihalf) c r) p)
  filter_upwards [hQ, her.quasiMeasurePreserving.ae hZ, hU] with z h1 h2 h3
  exact h1.trans (h2.trans (congrArg (b (e z) * ·) h3.symm))

end ConformalPoisson

end ProofPart_GreenTrace_SplitBoundaryChartLp

