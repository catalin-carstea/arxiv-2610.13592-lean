    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (y : (𝓡∂ (n + 1)).boundary M) :
    ContMDiffOn Ihalf 𝓘(ℝ) ∞ (boundaryPoissonSection ν G.kernel y) ({(y : M)}ᶜ) := by
  letI : ContMDiffVectorBundle ∞ V (TangentSpace Ihalf : M → Type _) Ihalf :=
    TangentBundle.contMDiffVectorBundle
