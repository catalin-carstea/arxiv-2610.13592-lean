  rw [hrel f x hx, hpoint, ← mul_assoc, inv_mul_cancel₀ hc, one_mul]

without_proof_info in
theorem inverse_original_datum_polynomial_at
    (hn : 2 ≤ n)
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (U : Set M₁)
    (J : M₁ → M₂) (c : M₁ → ℝ)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x))
    (f₀ : BoundaryDatum (observedPatch (n := n) V₁)) {x : M₁} (hx : x ∈ U)
    (hc : 0 < c x) (y : M₂) (hpoint : J x = y) (rho k : ℝ)
    (hscale : rho = k⁻¹ * ((c x)⁻¹) ^ conformalGaugeExponent n) :
    rho ^ (n - 1) * D.solver₁.solve f₀.val x ^ 4 =
      (k⁻¹) ^ (n - 1) * D.solver₂.solve (f₀.val ∘ D.boundaryIdentification.symm) y ^ 4 := by
  have hdatum := inverse_original_solution_relation_at A₁ A₂ V₁ V₂ D U J c hrel f₀ hx hc.ne' y hpoint
  apply conformal_weighted_polynomial_identity rho k⁻¹ (c x)⁻¹ _ _ (n - 1) (by omega) (inv_pos.mpr hc)
  · simpa only [conformalGaugeExponent_eq_four_div_pred hn] using hscale
  · exact hdatum
end ConformalPoisson

end ProofPart_InverseScaledSolutions

