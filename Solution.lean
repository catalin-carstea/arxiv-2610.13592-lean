    hG.comp ((p, x), x) ((contMDiffAt_fst.comp _ contMDiffAt_fst).prodMk contMDiffAt_snd)
  have h := hG'.mfderiv G' Prod.snd contMDiffAt_snd (by simp : (∞ : ℕ∞ω) + 1 ≤ ∞)
  refine h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun r => ?_)
  ext v
  simp [inTangentCoordinates, ContinuousLinearMap.inCoordinates, mfderiv_eq_fderiv,
    NormedSpace.fromTangentSpace, G']
