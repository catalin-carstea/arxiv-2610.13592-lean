  have hsub : (Ω : Set P) ∩ ball x₀ (R / 4) ⊆ ball x₀ (R / 4) := inter_subset_right
  have hSinner : S U =ᵐ[(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ (R / 4))] Wkp.value 2 W :=
    ae_restrict_of_ae_restrict_of_subset hsub hSread
