theorem NativeClassicalValueKernel.poissonSection_eq_neg_normalRow
    {g : Metric (n := n) (M := M)} {q : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    {a : ℝ≥0} (ha : 1 < a) [Fact (1 ≤ (a : ℝ≥0∞))]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] [(a : ℝ≥0∞).HolderConjugate p] (hp : p ≠ ⊤)
    {K : NativeInverseLpRowFamily g q (a : ℝ≥0∞)} (G : NativeClassicalValueKernel K)
    {ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M)}
    {s : ℝ≥0∞} (L : NativeInverseNormalLpRowFamily g q ν s)
    (y : (𝓡∂ (n + 1)).boundary M) (N : M → ℝ)
    (hN : ContMDiffOn Ihalf 𝓘(ℝ) ∞ N ((Ihalf).interior M))
    (hNae : N =ᵐ[nativeVolume g] L.row y) :
    ∀ x ∈ (Ihalf).interior M, boundaryPoissonSection ν G.kernel y x = -N x := by
  let : SecondCountableTopology M := native_secondCountable_of_compact (n := n) isCompact_univ
  let : IsLocallyFiniteMeasure (nativeVolume g) := nativeVolume_isLocallyFiniteMeasure g
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
