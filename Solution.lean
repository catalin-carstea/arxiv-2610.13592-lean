noncomputable section ProofPart_GreenTrace_HaarIntegralComparison



/- Transfer integrability and zero moments between actual Haar normalizations. -/
open MeasureTheory MeasureTheory.Measure Set
open scoped NNReal ENNReal
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
  [LocallyCompactSpace E] [SecondCountableTopology E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem integrable_restrict_haar_iff (μ ν : Measure E)
    [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure] (S : Set E) (f : E → F) :
    Integrable f (μ.restrict S) ↔ Integrable f (ν.restrict S) := by
  let c := addHaarScalarFactor μ ν
  have hc : 0 < c := addHaarScalarFactor_pos_of_isAddHaarMeasure μ ν
  have hμ : μ = c • ν := isAddLeftInvariant_eq_smul μ ν
  rw [hμ, Measure.restrict_smul]
  change Integrable f ((c : ℝ≥0∞) • ν.restrict S) ↔ Integrable f (ν.restrict S)
  exact integrable_smul_measure (by exact_mod_cast hc.ne') (by finiteness)

without_proof_info in
theorem integral_restrict_haar_eq_zero_iff (μ ν : Measure E)
    [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure] (S : Set E) (f : E → F) :
    (∫ x in S, f x ∂μ) = 0 ↔ (∫ x in S, f x ∂ν) = 0 := by
  let c := addHaarScalarFactor μ ν
  have hc : 0 < c := addHaarScalarFactor_pos_of_isAddHaarMeasure μ ν
  have hμ : μ = c • ν := isAddLeftInvariant_eq_smul μ ν
  rw [hμ, Measure.restrict_smul, integral_smul_nnreal_measure]
  simp only [NNReal.smul_def, smul_eq_zero]
  simp only [NNReal.coe_eq_zero, hc.ne', false_or]

end ConformalPoisson

end ProofPart_GreenTrace_HaarIntegralComparison

