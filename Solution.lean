set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_native_boundary_finite_exponent_gain_below
    (s : ℕ → ℝ≥0) (N : ℕ)
    (hs : ∀ i ≤ N, 1 < (s i : ℝ≥0∞))
    (hmono : ∀ i < N, s i ≤ s (i + 1))
    (hgap : ∀ i < N, 1 / (s i : ℝ) - 1 / (s (i + 1) : ℝ) <
      1 / (Module.finrank ℝ P : ℝ))
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : Continuous q)
    (c : M) (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ R₀ > 0, R₀ ≤ rMax ∧
      (closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∀ R : ℝ, 0 < R → R ≤ R₀ →
      ∃ C ≥ 0, ∀ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ u →
      (∀ x, (𝓡∂ (n + 1)).IsBoundaryPoint x → u x = 0) →
      (∀ z ∈ (splitBoundaryChartCap (n := n) c R : Set P),
        schrodinger g q u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) = 0) →
      lpNorm (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (s N : ℝ≥0∞)
        (volume.restrict (splitBoundaryChartCap (n := n) c (R / 4 ^ N) : Set P)) ≤
      C * lpNorm (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (s 0 : ℝ≥0∞)
        (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) := by
