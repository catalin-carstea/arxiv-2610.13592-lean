/- Read the SAME local native homogeneous solution in one normalized
interior chart, apply the proved scalar theorem, and return analyticity to
that solution in the original manifold model with boundary. -/
open Bundle Set Metric Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin (n + 1))) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I 2 M] [IsManifold I ∞ M] [IsManifold I ω M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin (n + 1))) (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I ω (EuclideanSpace ℝ (Fin (n + 1))) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin (n + 1))) (TangentSpace I : M → Type _) I]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem contMDiffAt_of_native_analytic_homogeneous
    (q u : M → ℝ) (hq : ContMDiff I 𝓘(ℝ) ω q) (U : TopologicalSpace.Opens M)
    (hu : ContMDiffOn I 𝓘(ℝ) ∞ u U)
    (hLu : ∀ y ∈ U, -TauCeti.Manifold.laplaceBeltrami I u y + q y * u y = 0)
    {x : M} (hx : x ∈ U) (hxI : I.IsInteriorPoint x) : ContMDiffAt I 𝓘(ℝ) ω u x := by
  let e := extChartAt I x
  let z₀ : V := e x
  have hz₀ : z₀ ∈ interior e.target := ModelWithCorners.isInteriorPoint_iff.mp hxI
  have hround : e.symm z₀ = x := e.left_inv (mem_extChartAt_source x)
  obtain ⟨T, hT⟩ := exists_native_principal_normalization (I := I) x (mem_chart_source H x)
  let A := affinePrincipalCoefficient T z₀ (chartPrincipalCoefficient (I := I) x)
  let b := affineDriftCoefficient T z₀ (chartDriftCoefficient (I := I) x)
  let Q := affinePotentialCoefficient T z₀ (chartPotentialCoefficient (I := I) x q)
  let v : V → ℝ := affinePullback T z₀ (u ∘ e.symm)
  have hAffine : Continuous (fun z : V => z₀ + T z) := continuous_const.add T.continuous
  have hAffine0 : Tendsto (fun z : V => z₀ + T z) (𝓝 0) (𝓝 z₀) := by
    simpa only [map_zero, add_zero] using hAffine.tendsto 0
  have hInv : ContMDiffAt 𝓘(ℝ, V) I ∞ e.symm z₀ :=
    (contMDiffOn_extChartAt_symm (I := I) (n := ∞) x z₀ (interior_subset hz₀)).contMDiffAt
      (Filter.mem_of_superset (isOpen_interior.mem_nhds hz₀) interior_subset)
  have hnear1 : ∀ᶠ z in 𝓝 (0 : V), z₀ + T z ∈ interior e.target :=
    hAffine0.eventually (isOpen_interior.mem_nhds hz₀)
  have hnear2 : ∀ᶠ z in 𝓝 (0 : V), e.symm (z₀ + T z) ∈ U := by
    have hInvU : ∀ᶠ w in 𝓝 z₀, e.symm w ∈ U := by
      apply hInv.continuousAt.eventually
      change (U : Set M) ∈ 𝓝 (e.symm z₀)
      rw [hround]
      exact U.isOpen.mem_nhds hx
    exact hAffine0.eventually hInvU
  obtain ⟨R, hR, hgood⟩ := Metric.mem_nhds_iff.mp
    (show {z : V | z₀ + T z ∈ interior e.target ∧ e.symm (z₀ + T z) ∈ U} ∈ 𝓝 0 from
      hnear1.and hnear2)
  have hA : AnalyticOnNhd ℝ A (ball 0 R) :=
    (analyticOnNhd_affinePrincipalCoefficient T z₀ (analyticOnNhd_chartPrincipalCoefficient x)).mono
      (fun z hz => (hgood hz).1)
  have hb : AnalyticOnNhd ℝ b (ball 0 R) :=
    (analyticOnNhd_affineDriftCoefficient T z₀ (analyticOnNhd_chartDriftCoefficient x)).mono
      (fun z hz => (hgood hz).1)
  have hQ : AnalyticOnNhd ℝ Q (ball 0 R) :=
    (analyticOnNhd_affinePotentialCoefficient T z₀
      (analyticOnNhd_chartPotentialCoefficient x hq)).mono (fun z hz => (hgood hz).1)
  have huread (z : V) (hz : z ∈ ball 0 R) :
      ContDiffAt ℝ ∞ (u ∘ e.symm) (z₀ + T z) := by
    have hiy : ContMDiffAt 𝓘(ℝ, V) I ∞ e.symm (z₀ + T z) :=
      (contMDiffOn_extChartAt_symm (I := I) (n := ∞) x _ (interior_subset (hgood hz).1)).contMDiffAt
        (Filter.mem_of_superset (isOpen_interior.mem_nhds (hgood hz).1) interior_subset)
    have huy : ContMDiffAt I 𝓘(ℝ) ∞ u (e.symm (z₀ + T z)) :=
      hu.contMDiffAt (U.isOpen.mem_nhds (hgood hz).2)
    exact (huy.comp _ hiy).contDiffAt
  have hv : ContDiffOn ℝ ∞ v (ball 0 R) := by
    intro z hz
    exact ((huread z hz).comp z (contDiff_const.add T.contDiff).contDiffAt).contDiffWithinAt
  have hvL (z : V) (hz : z ∈ ball 0 R) : coordinateSchrodinger A b Q v z = 0 := by
    have hsrc : e.symm (z₀ + T z) ∈ (chartAt H x).source := by
      simpa only [e, extChartAt_source] using e.map_target (interior_subset (hgood hz).1)
    have hright : e (e.symm (z₀ + T z)) = z₀ + T z :=
      e.right_inv (interior_subset (hgood hz).1)
    have hint : e (e.symm (z₀ + T z)) ∈ interior e.target := by
      rw [hright]
      exact (hgood hz).1
    have huy : ContMDiffAt I 𝓘(ℝ) 2 u (e.symm (z₀ + T z)) :=
      (hu.contMDiffAt (U.isOpen.mem_nhds (hgood hz).2)).of_le (by decide)
    have hnative := coordinateSchrodinger_eq_native (I := I) x hsrc hint q huy
    rw [hright] at hnative
    have haff := coordinateSchrodinger_affinePullback T z₀
      (chartPrincipalCoefficient (I := I) x) (chartDriftCoefficient (I := I) x)
      (chartPotentialCoefficient (I := I) x q) (u ∘ e.symm) z
      ((huread z hz).of_le (by decide))
    exact haff.trans (hnative.trans (hLu _ (hgood hz).2))
  have hvAn : AnalyticAt ℝ v 0 := analyticAt_of_normalized_coordinate_equation A b Q v hR
    hA hb hQ hv hT hvL
  have hInvAn : AnalyticAt ℝ (inverseAffine T z₀) z₀ :=
    (T.symm.analyticAt _).comp (analyticAt_id.sub analyticAt_const)
  have hInv0 : inverseAffine T z₀ z₀ = 0 := by simp [inverseAffine]
  have hreadAn := hvAn.comp_of_eq hInvAn hInv0
  change AnalyticAt ℝ (fun z : V => u (e.symm (z₀ + T (inverseAffine T z₀ z)))) z₀ at hreadAn
  simp only [affine_apply_inverseAffine] at hreadAn
  apply contMDiffAt_iff_source.mpr
  rw [contMDiffWithinAt_iff_contDiffWithinAt]
  exact hreadAn.contDiffAt.contDiffWithinAt

end ConformalPoisson

end ProofPart_InteriorAnalytic_NativeInteriorAnalytic

