/- Proof support: NormalJetFiniteSums.lean, SHA256 e8213e42082eae97f5f68a0ea589d9b2b5e7b949da7e6f4dbabb17ce2e9477ea -/
noncomputable section ProofPart_NormalJetFiniteSums


/- Congruence of the actual native normal jet of a finite pointwise sum. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem normalJet_finsetSum_congr {ι : Type*} (t : Finset ι)
    (f g : ι → EuclideanHalfSpace (n + 1) → F)
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    (hf : ∀ i ∈ t, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ (f i) S)
    (hg : ∀ i ∈ t, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ (g i) S)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) (k : ℕ)
    (he : ∀ i ∈ t, normalJet k (f i) z = normalJet k (g i) z) :
    normalJet k (fun y => ∑ i ∈ t, f i y) z = normalJet k (fun y => ∑ i ∈ t, g i y) z := by
  have hff : (fun y => ∑ i ∈ t, f i y) = ∑ i ∈ t, f i := by
    funext y
    simp only [Finset.sum_apply]
  have hgg : (fun y => ∑ i ∈ t, g i y) = ∑ i ∈ t, g i := by
    funext y
    simp only [Finset.sum_apply]
  rw [hff, hgg, normalJet_finsetSum_eqOn t f hS hf k hz,
    normalJet_finsetSum_eqOn t g hS hg k hz]
  simp only [Finset.sum_apply]
  exact Finset.sum_congr rfl he
end ConformalPoisson

end ProofPart_NormalJetFiniteSums

/- Proof support: BoundaryJetComparison.lean, SHA256 095888c53aa42bcdedafa9bf29a51bfdb07fb0ceeb011e81d7fe6c74afb58ee5 -/
noncomputable section ProofPart_BoundaryJetComparison




/- Finite native boundary-jet comparison for arbitrary real normed
coefficient spaces, with actual linear/bilinear and tangential operations. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {S : Set (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}
  {F F' F'' : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup F'] [NormedSpace ℝ F'] [NormedAddCommGroup F''] [NormedSpace ℝ F'']

structure BoundaryJetComparison (S : Set (EuclideanHalfSpace (n + 1)))
    (W : Set (EuclideanSpace ℝ (Fin n))) (L : ℕ)
    (f g : EuclideanHalfSpace (n + 1) → F) : Prop where
  analytic_left : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f S
  analytic_right : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω g S
  jets : ∀ k ≤ L, EqOn (normalJet k f ∘ EuclideanHalfSpace.boundaryParam n)
    (normalJet k g ∘ EuclideanHalfSpace.boundaryParam n) W

namespace BoundaryJetComparison

without_proof_info in
theorem of_le {f g : EuclideanHalfSpace (n + 1) → F} (h : BoundaryJetComparison S W L f g)
    {K : ℕ} (hK : K ≤ L) : BoundaryJetComparison S W K f g :=
  ⟨h.analytic_left, h.analytic_right, fun k hk => h.jets k (hk.trans hK)⟩

without_proof_info in
theorem const (c : F) : BoundaryJetComparison S W L (fun _ => c) (fun _ => c) where
  analytic_left := contMDiffOn_const
  analytic_right := contMDiffOn_const
  jets := fun _ _ _ _ => rfl

without_proof_info in
theorem clm (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {f g : EuclideanHalfSpace (n + 1) → F} (h : BoundaryJetComparison S W L f g)
    (A : F →L[ℝ] F') : BoundaryJetComparison S W L (A ∘ f) (A ∘ g) where
  analytic_left := A.contDiff.contMDiff.comp_contMDiffOn h.analytic_left
  analytic_right := A.contDiff.contMDiff.comp_contMDiffOn h.analytic_right
  jets := by
    intro k hk x hx
    dsimp only [Function.comp_apply]
    rw [normalJet_clm_eqOn A hS (h.analytic_left.of_le le_top) k (hWS hx),
      normalJet_clm_eqOn A hS (h.analytic_right.of_le le_top) k (hWS hx)]
    exact congrArg A (h.jets k hk hx)

without_proof_info in
theorem bilinear (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {f₁ f₂ : EuclideanHalfSpace (n + 1) → F} {g₁ g₂ : EuclideanHalfSpace (n + 1) → F'}
    (hf : BoundaryJetComparison S W L f₁ f₂) (hg : BoundaryJetComparison S W L g₁ g₂)
    (B : F →L[ℝ] F' →L[ℝ] F'') :
    BoundaryJetComparison S W L (fun z => B (f₁ z) (g₁ z)) (fun z => B (f₂ z) (g₂ z)) where
  analytic_left := normalBilinear_contMDiffOn B hf.analytic_left hg.analytic_left
  analytic_right := normalBilinear_contMDiffOn B hf.analytic_right hg.analytic_right
  jets := by
    intro k hk x hx
    exact normalJet_bilinear_congr hS (hf.analytic_left.of_le le_top) (hf.analytic_right.of_le le_top)
      (hg.analytic_left.of_le le_top) (hg.analytic_right.of_le le_top) B (hWS hx) k
      (fun r hr => hf.jets r (hr.trans hk) hx) (fun r hr => hg.jets r (hr.trans hk) hx)

without_proof_info in
theorem add (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {f₁ f₂ g₁ g₂ : EuclideanHalfSpace (n + 1) → F}
    (hf : BoundaryJetComparison S W L f₁ f₂) (hg : BoundaryJetComparison S W L g₁ g₂) :
    BoundaryJetComparison S W L (f₁ + g₁) (f₂ + g₂) where
  analytic_left := hf.analytic_left.add hg.analytic_left
  analytic_right := hf.analytic_right.add hg.analytic_right
  jets := by
    intro k hk x hx
    dsimp only [Function.comp_apply]
    rw [normalJet_add_eqOn hS (hf.analytic_left.of_le le_top) (hg.analytic_left.of_le le_top) k (hWS hx),
      normalJet_add_eqOn hS (hf.analytic_right.of_le le_top) (hg.analytic_right.of_le le_top) k (hWS hx)]
    exact congrArg₂ (· + ·) (hf.jets k hk hx) (hg.jets k hk hx)

without_proof_info in
theorem sum {ι : Type*} (t : Finset ι) (hS : IsOpen S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {f g : ι → EuclideanHalfSpace (n + 1) → F}
    (h : ∀ i ∈ t, BoundaryJetComparison S W L (f i) (g i)) :
    BoundaryJetComparison S W L (fun z => ∑ i ∈ t, f i z) (fun z => ∑ i ∈ t, g i z) where
  analytic_left := contMDiffOn_finsetSum fun i hi => (h i hi).analytic_left
  analytic_right := contMDiffOn_finsetSum fun i hi => (h i hi).analytic_right
  jets := by
    intro k hk x hx
    exact normalJet_finsetSum_congr t f g hS
      (fun i hi => (h i hi).analytic_left.of_le le_top)
      (fun i hi => (h i hi).analytic_right.of_le le_top) (hWS hx) k
      (fun i hi => (h i hi).jets k hk hx)

without_proof_info in
theorem tangential [CompleteSpace F] (hS : IsOpen S) (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {f g : EuclideanHalfSpace (n + 1) → F} (h : BoundaryJetComparison S W L f g)
    (v : EuclideanSpace ℝ (Fin n)) :
    BoundaryJetComparison S W L
      (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f)
      (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) g) where
  analytic_left := modelDirectionalDeriv_analyticOn _ _ hS h.analytic_left
  analytic_right := modelDirectionalDeriv_analyticOn _ _ hS h.analytic_right
  jets := fun k hk _ hx => boundary_normalJet_directional_eq hS h.analytic_left h.analytic_right
    hW hWS k (h.jets k hk) hx v
end BoundaryJetComparison

def normalMatrixMultiplication : Matrix (Fin n) (Fin n) ℝ →L[ℝ]
    Matrix (Fin n) (Fin n) ℝ →L[ℝ] Matrix (Fin n) (Fin n) ℝ :=
  finiteBilinearToContinuous (LinearMap.mul ℝ (Matrix (Fin n) (Fin n) ℝ))

without_proof_info in
@[simp] theorem normalMatrixMultiplication_apply (A B : Matrix (Fin n) (Fin n) ℝ) :
    normalMatrixMultiplication A B = A * B := rfl
end ConformalPoisson

end ProofPart_BoundaryJetComparison

/- Proof support: ModelProductDerivatives.lean, SHA256 53d009d32e1759cbd2066f1b30e4b6574d5941fd25470ee331dd7605517538ba -/
noncomputable section ProofPart_ModelProductDerivatives



/- Actual slice derivatives on the self-charted product model, with an
explicit bridge to the product manifold chart. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E H E' H' F : Type*}
  [NormedAddCommGroup E] [NormedSpace ℝ E] [TopologicalSpace H]
  [NormedAddCommGroup E'] [NormedSpace ℝ E'] [TopologicalSpace H']
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  (I : ModelWithCorners ℝ E H) (J : ModelWithCorners ℝ E' H')

without_proof_info in
theorem modelDirectionalDeriv_prod_left (v : E)
    {f : ModelProd H H' → F} {x : H} {y : H'}
    (hf : ContMDiffAt (I.prod J) 𝓘(ℝ, F) 1 f (x, y)) :
    modelDirectionalDeriv I v (fun a => f (a, y)) x =
      modelDirectionalDeriv (I.prod J) (v, 0) f (x, y) := by
  have hf' : MDifferentiableAt (I.prod J) 𝓘(ℝ, F)
      (fun p : H × H' => f p) (x, y) := by
    rw [chartedSpaceSelf_prod]
    exact hf.mdifferentiableAt one_ne_zero
  have hd := mvfderiv_comp_of_eq hf'
    (mdifferentiableAt_id.prodMk mdifferentiableAt_const) (rfl : (x, y) = (x, y))
  dsimp only [id_eq] at hd
  rw [mfderiv_prod_left] at hd
  have he := DFunLike.congr_fun hd v
  change mvfderiv I (fun a => f (a, y)) x v = _ at he
  rw [chartedSpaceSelf_prod] at he
  exact he

without_proof_info in
theorem modelDirectionalDeriv_prod_right (v : E')
    {f : ModelProd H H' → F} {x : H} {y : H'}
    (hf : ContMDiffAt (I.prod J) 𝓘(ℝ, F) 1 f (x, y)) :
    modelDirectionalDeriv J v (fun a => f (x, a)) y =
      modelDirectionalDeriv (I.prod J) (0, v) f (x, y) := by
  have hf' : MDifferentiableAt (I.prod J) 𝓘(ℝ, F)
      (fun p : H × H' => f p) (x, y) := by
    rw [chartedSpaceSelf_prod]
    exact hf.mdifferentiableAt one_ne_zero
  have hd := mvfderiv_comp_of_eq hf'
    (mdifferentiableAt_const.prodMk mdifferentiableAt_id) (rfl : (x, y) = (x, y))
  dsimp only [id_eq] at hd
  rw [mfderiv_prod_right] at hd
  have he := DFunLike.congr_fun hd v
  change mvfderiv J (fun a => f (x, a)) y v = _ at he
  rw [chartedSpaceSelf_prod] at he
  exact he
end ConformalPoisson

end ProofPart_ModelProductDerivatives

/- Proof support: SymbolModelCalculus.lean, SHA256 bb9d182327fe489ddcb11726d74a6a1b1ed3b6b11f3656d6c528d4d0547fcaab -/
noncomputable section ProofPart_SymbolModelCalculus




/- Joint native symbol derivatives on the product model and their actual
base/frequency slices. The frequency derivative remains the real Frechet
derivative of the actual frequency function. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}

def symbolJoint (b : NativeSymbol n) :
    ModelProd (EuclideanHalfSpace (n + 1)) (Fin n → ℝ) → ℂ :=
  fun p => b p.2 p.1

def symbolJointDeriv (v : EuclideanSpace ℝ (Fin (n + 1)) × (Fin n → ℝ))
    (b : NativeSymbol n) : NativeSymbol n :=
  fun ξ z => modelDirectionalDeriv ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ))
    v (symbolJoint b) (z, ξ)

without_proof_info in
theorem symbol_domain_open {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S) :
    IsOpen (S ×ˢ {ξ : Fin n → ℝ | ξ ≠ 0}) :=
  hS.prod isOpen_ne

without_proof_info in
theorem symbolJointDeriv_contMDiffOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {k m : ℕ∞ω} {b : NativeSymbol n}
    (hb : SymbolContMDiffOn S k b) (hmk : m + 1 ≤ k)
    (v : EuclideanSpace ℝ (Fin (n + 1)) × (Fin n → ℝ)) :
    SymbolContMDiffOn S m (symbolJointDeriv v b) := by
  intro p hp
  exact (modelDirectionalDeriv_contMDiffAt _ v
    ((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)) hmk).contMDiffWithinAt

without_proof_info in
theorem symbolBaseDeriv_eq_joint (i : Fin n) {b : NativeSymbol n}
    {z : EuclideanHalfSpace (n + 1)} {ξ : Fin n → ℝ}
    (hb : ContMDiffAt ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) 𝓘(ℝ, ℂ)
      1 (symbolJoint b) (z, ξ)) :
    symbolBaseDeriv i b ξ z = symbolJointDeriv
      (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1), 0) b ξ z :=
  modelDirectionalDeriv_prod_left _ _ _ hb

without_proof_info in
theorem symbolNormalDeriv_eq_joint {b : NativeSymbol n}
    {z : EuclideanHalfSpace (n + 1)} {ξ : Fin n → ℝ}
    (hb : ContMDiffAt ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) 𝓘(ℝ, ℂ)
      1 (symbolJoint b) (z, ξ)) :
    normalDeriv (b ξ) z = symbolJointDeriv
      (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1), 0) b ξ z :=
  modelDirectionalDeriv_prod_left _ _ _ hb

without_proof_info in
theorem symbolFrequencyDeriv_eq_joint (i : Fin n) {b : NativeSymbol n}
    {z : EuclideanHalfSpace (n + 1)} {ξ : Fin n → ℝ}
    (hb : ContMDiffAt ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) 𝓘(ℝ, ℂ)
      1 (symbolJoint b) (z, ξ)) :
    symbolFrequencyDeriv i b ξ z = symbolJointDeriv (0, Pi.single i 1) b ξ z := by
  have h := modelDirectionalDeriv_prod_right (𝓡∂ (n + 1)) 𝓘(ℝ, Fin n → ℝ)
    (Pi.single i 1) hb
  simpa only [modelDirectionalDeriv, mvfderiv_eq_fderiv_apply, symbolJoint,
    symbolFrequencyDeriv, symbolJointDeriv] using h

without_proof_info in
theorem symbolBaseDeriv_contMDiffOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {k m : ℕ∞ω} {b : NativeSymbol n}
    (hb : SymbolContMDiffOn S k b) (hmk : m + 1 ≤ k) (i : Fin n) :
    SymbolContMDiffOn S m (symbolBaseDeriv i b) := by
  have h1 : (1 : ℕ∞ω) ≤ k := le_trans (by simp) hmk
  refine (symbolJointDeriv_contMDiffOn hS hb hmk
    (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1), 0)).congr ?_
  intro p hp
  exact (symbolBaseDeriv_eq_joint i
    (((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le h1))

without_proof_info in
theorem symbolFrequencyDeriv_contMDiffOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {k m : ℕ∞ω} {b : NativeSymbol n}
    (hb : SymbolContMDiffOn S k b) (hmk : m + 1 ≤ k) (i : Fin n) :
    SymbolContMDiffOn S m (symbolFrequencyDeriv i b) := by
  have h1 : (1 : ℕ∞ω) ≤ k := le_trans (by simp) hmk
  refine (symbolJointDeriv_contMDiffOn hS hb hmk (0, Pi.single i 1)).congr ?_
  intro p hp
  exact (symbolFrequencyDeriv_eq_joint i
    (((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le h1))

def symbolNormalDeriv (b : NativeSymbol n) : NativeSymbol n := fun ξ => normalDeriv (b ξ)

def symbolNormalJet (k : ℕ) (b : NativeSymbol n) : NativeSymbol n := fun ξ => normalJet k (b ξ)

without_proof_info in
theorem symbolNormalDeriv_contMDiffOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {k m : ℕ∞ω} {b : NativeSymbol n}
    (hb : SymbolContMDiffOn S k b) (hmk : m + 1 ≤ k) :
    SymbolContMDiffOn S m (symbolNormalDeriv b) := by
  have h1 : (1 : ℕ∞ω) ≤ k := le_trans (by simp) hmk
  refine (symbolJointDeriv_contMDiffOn hS hb hmk
    (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1), 0)).congr ?_
  intro p hp
  exact symbolNormalDeriv_eq_joint
    (((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le h1)

without_proof_info in
theorem symbolNormalJet_analyticOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (k : ℕ) :
    SymbolContMDiffOn S ω (symbolNormalJet k b) := by
  induction k with
  | zero => exact hb
  | succ k ih =>
    exact symbolNormalDeriv_contMDiffOn hS ih (le_top : (ω : ℕ∞ω) + 1 ≤ ω)

without_proof_info in
theorem symbolJointDeriv_eqOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {b c : NativeSymbol n}
    (he : EqOn (symbolJoint b) (symbolJoint c) (S ×ˢ {ξ | ξ ≠ 0}))
    (v : EuclideanSpace ℝ (Fin (n + 1)) × (Fin n → ℝ)) :
    EqOn (symbolJoint (symbolJointDeriv v b)) (symbolJoint (symbolJointDeriv v c))
      (S ×ˢ {ξ | ξ ≠ 0}) := by
  intro p hp
  exact modelDirectionalDeriv_eq_of_eventuallyEq _ v
    (Filter.eventuallyEq_of_mem ((symbol_domain_open hS).mem_nhds hp) he)

without_proof_info in
theorem symbolJointDeriv_comm_eqOn {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S) {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b)
    (u v : EuclideanSpace ℝ (Fin (n + 1)) × (Fin n → ℝ)) :
    EqOn (symbolJoint (symbolJointDeriv u (symbolJointDeriv v b)))
      (symbolJoint (symbolJointDeriv v (symbolJointDeriv u b))) (S ×ˢ {ξ | ξ ≠ 0}) := by
  intro p hp
  exact modelDirectionalDeriv_comm _ u v
    ((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp))

without_proof_info in
theorem symbol_slice_contMDiffAt {S : Set (EuclideanHalfSpace (n + 1))}
    {k : ℕ∞ω} {b : NativeSymbol n} (hb : SymbolContMDiffOn S k b)
    (hS : IsOpen S) {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S)
    {ξ : Fin n → ℝ} (hξ : ξ ≠ 0) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) k (b ξ) z := by
  have hp := (hb (z, ξ) ⟨hz, hξ⟩).contMDiffAt
    ((symbol_domain_open hS).mem_nhds ⟨hz, hξ⟩)
  have hp' : ContMDiffAt ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) 𝓘(ℝ, ℂ) k
      (fun p : EuclideanHalfSpace (n + 1) × (Fin n → ℝ) => b p.2 p.1) (z, ξ) := by
    rw [chartedSpaceSelf_prod]
    exact hp
  have hs : ContMDiffAt (𝓡∂ (n + 1))
      ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) k
      (fun a : EuclideanHalfSpace (n + 1) => (a, ξ)) z :=
    contMDiffAt_id.prodMk contMDiffAt_const
  have hc := hp'.comp z hs
  exact hc
end ConformalPoisson

end ProofPart_SymbolModelCalculus

/- Proof support: SymbolMixedJets.lean, SHA256 0fe44d36abf42af9c776547b517b04c27e37948518b1bdda1ff4d25d55040afd -/
noncomputable section ProofPart_SymbolMixedJets



/- Native normal jets commute with the ACTUAL real-frequency and spatial
symbol derivatives for analytic homogeneous components. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {S : Set (EuclideanHalfSpace (n + 1))}

without_proof_info in
theorem symbolNormalDeriv_eqOn (hS : IsOpen S) {b c : NativeSymbol n}
    (he : EqOn (symbolJoint b) (symbolJoint c) (S ×ˢ {ξ | ξ ≠ 0})) :
    EqOn (symbolJoint (symbolNormalDeriv b)) (symbolJoint (symbolNormalDeriv c))
      (S ×ˢ {ξ | ξ ≠ 0}) := by
  intro p hp
  exact normalDeriv_eq_of_eventuallyEq
    (Filter.eventuallyEq_of_mem (hS.mem_nhds hp.1) (fun z hz => @he (z, p.2) ⟨hz, hp.2⟩))

without_proof_info in
theorem symbolNormalDeriv_jointDeriv_comm_eqOn (hS : IsOpen S)
    {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b)
    (v : EuclideanSpace ℝ (Fin (n + 1)) × (Fin n → ℝ)) :
    EqOn (symbolJoint (symbolNormalDeriv (symbolJointDeriv v b)))
      (symbolJoint (symbolJointDeriv v (symbolNormalDeriv b))) (S ×ˢ {ξ | ξ ≠ 0}) := by
  let u := (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1), (0 : Fin n → ℝ))
  have hN : EqOn (symbolJoint (symbolNormalDeriv b)) (symbolJoint (symbolJointDeriv u b))
      (S ×ˢ {ξ | ξ ≠ 0}) := by
    intro p hp
    exact symbolNormalDeriv_eq_joint
      (((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le le_top)
  have hv := symbolJointDeriv_contMDiffOn hS hb (le_top : (ω : ℕ∞ω) + 1 ≤ ω) v
  intro p hp
  exact (symbolNormalDeriv_eq_joint
    (((hv p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le le_top)).trans
      ((symbolJointDeriv_comm_eqOn hS hb u v hp).trans
        (symbolJointDeriv_eqOn hS hN v hp).symm)

without_proof_info in
theorem symbolNormalDeriv_frequency_comm_eqOn (hS : IsOpen S)
    {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (i : Fin n) :
    EqOn (symbolJoint (symbolNormalDeriv (symbolFrequencyDeriv i b)))
      (symbolJoint (symbolFrequencyDeriv i (symbolNormalDeriv b))) (S ×ˢ {ξ | ξ ≠ 0}) := by
  have hF : EqOn (symbolJoint (symbolFrequencyDeriv i b))
      (symbolJoint (symbolJointDeriv (0, Pi.single i 1) b)) (S ×ˢ {ξ | ξ ≠ 0}) := by
    intro p hp
    exact symbolFrequencyDeriv_eq_joint i
      (((hb p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le le_top)
  have hN := symbolNormalDeriv_contMDiffOn hS hb (le_top : (ω : ℕ∞ω) + 1 ≤ ω)
  intro p hp
  exact (symbolNormalDeriv_eqOn hS hF hp).trans
    ((symbolNormalDeriv_jointDeriv_comm_eqOn hS hb (0, Pi.single i 1) hp).trans
      (symbolFrequencyDeriv_eq_joint i
        (((hN p hp).contMDiffAt ((symbol_domain_open hS).mem_nhds hp)).of_le le_top)).symm)

without_proof_info in
theorem symbolNormalJet_frequency_comm_eqOn (hS : IsOpen S)
    {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (i : Fin n) (k : ℕ) :
    EqOn (symbolJoint (symbolNormalJet k (symbolFrequencyDeriv i b)))
      (symbolJoint (symbolFrequencyDeriv i (symbolNormalJet k b))) (S ×ˢ {ξ | ξ ≠ 0}) := by
  induction k with
  | zero => intro p hp; rfl
  | succ k ih =>
    intro p hp
    exact (symbolNormalDeriv_eqOn hS ih hp).trans
      (symbolNormalDeriv_frequency_comm_eqOn hS (symbolNormalJet_analyticOn hS hb k) i hp)

without_proof_info in
theorem symbolNormalJet_base_comm_eqOn (hS : IsOpen S)
    {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (i : Fin n) (k : ℕ) :
    EqOn (symbolJoint (symbolNormalJet k (symbolBaseDeriv i b)))
      (symbolJoint (symbolBaseDeriv i (symbolNormalJet k b))) (S ×ˢ {ξ | ξ ≠ 0}) := by
  intro p hp
  have hs : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ω (b p.2) S :=
    fun z hz => (symbol_slice_contMDiffAt hb hS hz hp.2).contMDiffWithinAt
  exact normalJet_directional_comm_eqOn _ hS hs k hp.1
end ConformalPoisson

end ProofPart_SymbolMixedJets

/- Proof support: SymbolCompositionRegularity.lean, SHA256 9fc8746ed890deba838adfd1ce6cd4ffeba59c389e344229b3f218400df99ee4 -/
noncomputable section ProofPart_SymbolCompositionRegularity


/- Regularity of the actual finite left-symbol composition. Both smooth
and analytic orders are covered; no analyticity of a full asymptotic sum
is asserted. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {S : Set (EuclideanHalfSpace (n + 1))} {k : ℕ∞ω}

without_proof_info in
theorem symbolConst_contMDiffOn (c : ℂ) :
    SymbolContMDiffOn S k (fun _ _ => c) := contMDiffOn_const

without_proof_info in
theorem symbolMul_contMDiffOn {b c : NativeSymbol n}
    (hb : SymbolContMDiffOn S k b) (hc : SymbolContMDiffOn S k c) :
    SymbolContMDiffOn S k (fun ξ z => b ξ z * c ξ z) :=
  ((ContinuousLinearMap.mul ℝ ℂ).contDiff.contMDiff.comp_contMDiffOn hb).clm_apply hc

without_proof_info in
theorem symbolMultiDeriv_contMDiffOn
    (D : Fin n → NativeSymbol n → NativeSymbol n)
    (hD : ∀ i b, SymbolContMDiffOn S k b → SymbolContMDiffOn S k (D i b))
    (α : Fin n → ℕ) {b : NativeSymbol n} (hb : SymbolContMDiffOn S k b) :
    SymbolContMDiffOn S k (symbolMultiDeriv D α b) := by
  have hi : ∀ i m b, SymbolContMDiffOn S k b → SymbolContMDiffOn S k ((D i)^[m] b) := by
    intro i m
    induction m with
    | zero => intro b hb; exact hb
    | succ m ih =>
      intro b hb
      rw [Function.iterate_succ_apply']
      exact hD i _ (ih b hb)
  suffices ∀ (l : List (Fin n)) b, SymbolContMDiffOn S k b →
      SymbolContMDiffOn S k (l.foldl (fun f i => (D i)^[α i] f) b) from
    this (List.finRange n) b hb
  intro l
  induction l with
  | nil => intro b hb; exact hb
  | cons i l ih => intro b hb; exact ih _ (hi i (α i) b hb)

without_proof_info in
theorem symbolCompositionRemainder_contMDiffOn (hS : IsOpen S) (hkk : k + 1 ≤ k)
    (b : ℕ → NativeSymbol n) (r : ℕ)
    (hb : ∀ p ≤ r, SymbolContMDiffOn S k (b p)) :
    SymbolContMDiffOn S k (symbolCompositionRemainder b r) := by
  have hbase : ∀ i b, SymbolContMDiffOn S k b → SymbolContMDiffOn S k (symbolBaseDeriv i b) :=
    fun i b h => symbolBaseDeriv_contMDiffOn hS h hkk i
  have hfreq : ∀ i b, SymbolContMDiffOn S k b → SymbolContMDiffOn S k (symbolFrequencyDeriv i b) :=
    fun i b h => symbolFrequencyDeriv_contMDiffOn hS h hkk i
  unfold SymbolContMDiffOn symbolCompositionRemainder
  apply contMDiffOn_finsetSum
  intro p hp
  apply contMDiffOn_finsetSum
  intro q hq
  split_ifs with hpq
  · apply contMDiffOn_finsetSum
    intro α hα
    exact symbolMul_contMDiffOn
      (symbolMul_contMDiffOn (symbolConst_contMDiffOn _)
        (symbolMultiDeriv_contMDiffOn _ hfreq α (hb p (Nat.le_of_lt_succ (Finset.mem_range.mp hp)))))
      (symbolMultiDeriv_contMDiffOn _ hbase α (hb q (Nat.le_of_lt_succ (Finset.mem_range.mp hq))))
  · exact contMDiffOn_const
end ConformalPoisson

end ProofPart_SymbolCompositionRegularity

/- Proof support: SymbolBoundaryJetCongruence.lean, SHA256 6914a1ae582d304e34aece830fd29da14d8c2f69c5bbc02ea63629c7f6bc02ec -/
noncomputable section ProofPart_SymbolBoundaryJetCongruence



/- Equal native normal-jet FUNCTIONS on an open boundary patch can be
differentiated in the actual spatial/frequency variables. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}

def SymbolBoundaryJetEq (W : Set (EuclideanSpace ℝ (Fin n))) (k : ℕ)
    (b c : NativeSymbol n) : Prop :=
  ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ∀ x ∈ W,
    normalJet k (b ξ) (EuclideanHalfSpace.boundaryParam n x) =
      normalJet k (c ξ) (EuclideanHalfSpace.boundaryParam n x)

without_proof_info in
theorem SymbolBoundaryJetEq.base {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b c : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (hc : SymbolContMDiffOn S ω c)
    {k : ℕ} (he : SymbolBoundaryJetEq W k b c) (i : Fin n) :
    SymbolBoundaryJetEq W k (symbolBaseDeriv i b) (symbolBaseDeriv i c) := by
  intro ξ hξ x hx
  have hb' : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ω (b ξ) S :=
    fun z hz => (symbol_slice_contMDiffAt hb hS hz hξ).contMDiffWithinAt
  have hc' : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ω (c ξ) S :=
    fun z hz => (symbol_slice_contMDiffAt hc hS hz hξ).contMDiffWithinAt
  exact boundary_normalJet_directional_eq hS hb' hc' hW hWS k
    (fun y hy => he ξ hξ y hy) hx (EuclideanSpace.single i 1)

without_proof_info in
theorem SymbolBoundaryJetEq.frequency {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    {W : Set (EuclideanSpace ℝ (Fin n))}
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b c : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (hc : SymbolContMDiffOn S ω c)
    {k : ℕ} (he : SymbolBoundaryJetEq W k b c) (i : Fin n) :
    SymbolBoundaryJetEq W k (symbolFrequencyDeriv i b) (symbolFrequencyDeriv i c) := by
  intro ξ hξ x hx
  have hp : (EuclideanHalfSpace.boundaryParam n x, ξ) ∈ S ×ˢ {ξ | ξ ≠ 0} := ⟨hWS hx, hξ⟩
  have hb' := symbolNormalJet_frequency_comm_eqOn hS hb i k hp
  have hc' := symbolNormalJet_frequency_comm_eqOn hS hc i k hp
  change normalJet k (symbolFrequencyDeriv i b ξ) _ = _ at hb'
  change normalJet k (symbolFrequencyDeriv i c ξ) _ = _ at hc'
  rw [hb', hc']
  have hf : (fun η => normalJet k (b η) (EuclideanHalfSpace.boundaryParam n x)) =ᶠ[𝓝 ξ]
      (fun η => normalJet k (c η) (EuclideanHalfSpace.boundaryParam n x)) :=
    Filter.eventuallyEq_of_mem (isOpen_ne.mem_nhds hξ) (fun η hη => he η hη x hx)
  exact congrArg (fun A => A (Pi.single i 1)) (hf.fderiv_eq (𝕜 := ℝ))

without_proof_info in
theorem SymbolBoundaryJetEq.multi
    {S : Set (EuclideanHalfSpace (n + 1))}
    {W : Set (EuclideanSpace ℝ (Fin n))} {k : ℕ}
    (D : Fin n → NativeSymbol n → NativeSymbol n)
    (hD : ∀ i b, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω (D i b))
    (hE : ∀ i b c, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω c →
      SymbolBoundaryJetEq W k b c → SymbolBoundaryJetEq W k (D i b) (D i c))
    {b c : NativeSymbol n} (hb : SymbolContMDiffOn S ω b) (hc : SymbolContMDiffOn S ω c)
    (he : SymbolBoundaryJetEq W k b c) (α : Fin n → ℕ) :
    SymbolBoundaryJetEq W k (symbolMultiDeriv D α b) (symbolMultiDeriv D α c) := by
  have hi : ∀ i m b c, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω c →
      SymbolBoundaryJetEq W k b c → SymbolBoundaryJetEq W k ((D i)^[m] b) ((D i)^[m] c) := by
    intro i m
    induction m with
    | zero => intro b c hb hc he; exact he
    | succ m ih =>
      intro b c hb hc he
      rw [Function.iterate_succ_apply]
      rw [Function.iterate_succ_apply]
      exact ih _ _ (hD i b hb) (hD i c hc) (hE i b c hb hc he)
  have hreg : ∀ i m b, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω ((D i)^[m] b) := by
    intro i m
    induction m with
    | zero => intro b hb; exact hb
    | succ m ih =>
      intro b hb
      rw [Function.iterate_succ_apply']
      exact hD i _ (ih b hb)
  suffices ∀ (l : List (Fin n)) b c, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω c →
      SymbolBoundaryJetEq W k b c → SymbolBoundaryJetEq W k
        (l.foldl (fun f i => (D i)^[α i] f) b)
        (l.foldl (fun f i => (D i)^[α i] f) c) from this (List.finRange n) b c hb hc he
  intro l
  induction l with
  | nil => intro b c hb hc he; exact he
  | cons i l ih =>
    intro b c hb hc he
    exact ih _ _ (hreg i (α i) b hb) (hreg i (α i) c hc) (hi i (α i) b c hb hc he)
end ConformalPoisson

end ProofPart_SymbolBoundaryJetCongruence

/- Proof support: SymbolJetComparison.lean, SHA256 870ce81cdde48650a12d1163f87ad5b7c3d02d0227c4a45dbffcd51f7771865d -/
noncomputable section ProofPart_SymbolJetComparison



/- A proved relation for finite symbolic expressions: actual analytic
functions with equal normal jets through a finite order on ONE boundary
patch. Its algebra and derivative closures are project theorems. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {S : Set (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}

structure SymbolJetComparison (S : Set (EuclideanHalfSpace (n + 1)))
    (W : Set (EuclideanSpace ℝ (Fin n))) (L : ℕ) (b c : NativeSymbol n) : Prop where
  analytic_left : SymbolContMDiffOn S ω b
  analytic_right : SymbolContMDiffOn S ω c
  jets : ∀ k ≤ L, SymbolBoundaryJetEq W k b c

namespace SymbolJetComparison

without_proof_info in
theorem of_le {b c : NativeSymbol n} (h : SymbolJetComparison S W L b c)
    {K : ℕ} (hK : K ≤ L) : SymbolJetComparison S W K b c :=
  ⟨h.analytic_left, h.analytic_right, fun k hk => h.jets k (hk.trans hK)⟩

without_proof_info in
theorem congr (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b c b' c' : NativeSymbol n} (h : SymbolJetComparison S W L b c)
    (hb : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → EqOn (b' ξ) (b ξ) S)
    (hc : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → EqOn (c' ξ) (c ξ) S) :
    SymbolJetComparison S W L b' c' where
  analytic_left := h.analytic_left.congr (fun p hp => hb p.2 hp.2 hp.1)
  analytic_right := h.analytic_right.congr (fun p hp => hc p.2 hp.2 hp.1)
  jets := by
    intro k hk ξ hξ x hx
    exact (normalJet_eqOn hS (hb ξ hξ) k (hWS hx)).trans
      ((h.jets k hk ξ hξ x hx).trans (normalJet_eqOn hS (hc ξ hξ) k (hWS hx)).symm)

without_proof_info in
theorem add (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b₁ b₂ c₁ c₂ : NativeSymbol n} (hb : SymbolJetComparison S W L b₁ b₂)
    (hc : SymbolJetComparison S W L c₁ c₂) :
    SymbolJetComparison S W L (fun ξ z => b₁ ξ z + c₁ ξ z) (fun ξ z => b₂ ξ z + c₂ ξ z) where
  analytic_left := hb.analytic_left.add hc.analytic_left
  analytic_right := hb.analytic_right.add hc.analytic_right
  jets := by
    intro k hk ξ hξ x hx
    have hs (f : NativeSymbol n) (hf : SymbolContMDiffOn S ω f) :
        ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (f ξ) S :=
      fun z hz => ((symbol_slice_contMDiffAt hf hS hz hξ).of_le le_top).contMDiffWithinAt
    have h₁ := normalJet_add_eqOn hS (hs b₁ hb.analytic_left) (hs c₁ hc.analytic_left) k (hWS hx)
    have h₂ := normalJet_add_eqOn hS (hs b₂ hb.analytic_right) (hs c₂ hc.analytic_right) k (hWS hx)
    exact h₁.trans ((congrArg₂ (· + ·) (hb.jets k hk ξ hξ x hx) (hc.jets k hk ξ hξ x hx)).trans h₂.symm)

without_proof_info in
theorem sub (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b₁ b₂ c₁ c₂ : NativeSymbol n} (hb : SymbolJetComparison S W L b₁ b₂)
    (hc : SymbolJetComparison S W L c₁ c₂) :
    SymbolJetComparison S W L (fun ξ z => b₁ ξ z - c₁ ξ z) (fun ξ z => b₂ ξ z - c₂ ξ z) where
  analytic_left := hb.analytic_left.sub hc.analytic_left
  analytic_right := hb.analytic_right.sub hc.analytic_right
  jets := by
    intro k hk ξ hξ x hx
    have hs (f : NativeSymbol n) (hf : SymbolContMDiffOn S ω f) :
        ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (f ξ) S :=
      fun z hz => ((symbol_slice_contMDiffAt hf hS hz hξ).of_le le_top).contMDiffWithinAt
    have h₁ := normalJet_sub_eqOn hS (hs b₁ hb.analytic_left) (hs c₁ hc.analytic_left) k (hWS hx)
    have h₂ := normalJet_sub_eqOn hS (hs b₂ hb.analytic_right) (hs c₂ hc.analytic_right) k (hWS hx)
    exact h₁.trans ((congrArg₂ (· - ·) (hb.jets k hk ξ hξ x hx) (hc.jets k hk ξ hξ x hx)).trans h₂.symm)

without_proof_info in
theorem const (c : ℂ) : SymbolJetComparison S W L (fun _ _ => c) (fun _ _ => c) where
  analytic_left := symbolConst_contMDiffOn c
  analytic_right := symbolConst_contMDiffOn c
  jets := fun _ _ _ _ _ _ => rfl

without_proof_info in
theorem mul (hS : IsOpen S) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b₁ b₂ c₁ c₂ : NativeSymbol n} (hb : SymbolJetComparison S W L b₁ b₂)
    (hc : SymbolJetComparison S W L c₁ c₂) :
    SymbolJetComparison S W L (fun ξ z => b₁ ξ z * c₁ ξ z) (fun ξ z => b₂ ξ z * c₂ ξ z) where
  analytic_left := symbolMul_contMDiffOn hb.analytic_left hc.analytic_left
  analytic_right := symbolMul_contMDiffOn hb.analytic_right hc.analytic_right
  jets := by
    intro k hk ξ hξ x hx
    have hs (f : NativeSymbol n) (hf : SymbolContMDiffOn S ω f) :
        ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (f ξ) S :=
      fun z hz => ((symbol_slice_contMDiffAt hf hS hz hξ).of_le le_top).contMDiffWithinAt
    exact normalJet_bilinear_congr hS (hs b₁ hb.analytic_left) (hs b₂ hb.analytic_right)
      (hs c₁ hc.analytic_left) (hs c₂ hc.analytic_right) (ContinuousLinearMap.mul ℝ ℂ)
      (hWS hx) k (fun r hr => hb.jets r (hr.trans hk) ξ hξ x hx)
      (fun r hr => hc.jets r (hr.trans hk) ξ hξ x hx)

without_proof_info in
theorem sum {ι : Type*} (t : Finset ι) (hS : IsOpen S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b c : ι → NativeSymbol n} (h : ∀ i ∈ t, SymbolJetComparison S W L (b i) (c i)) :
    SymbolJetComparison S W L (fun ξ z => ∑ i ∈ t, b i ξ z) (fun ξ z => ∑ i ∈ t, c i ξ z) where
  analytic_left := contMDiffOn_finsetSum fun i hi => (h i hi).analytic_left
  analytic_right := contMDiffOn_finsetSum fun i hi => (h i hi).analytic_right
  jets := by
    intro k hk ξ hξ x hx
    exact normalJet_finsetSum_congr t (fun i => b i ξ) (fun i => c i ξ) hS
      (fun i hi z hz => ((symbol_slice_contMDiffAt (h i hi).analytic_left hS hz hξ).of_le le_top).contMDiffWithinAt)
      (fun i hi z hz => ((symbol_slice_contMDiffAt (h i hi).analytic_right hS hz hξ).of_le le_top).contMDiffWithinAt)
      (hWS hx) k (fun i hi => (h i hi).jets k hk ξ hξ x hx)

without_proof_info in
theorem multi (D : Fin n → NativeSymbol n → NativeSymbol n)
    (hD : ∀ i b, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω (D i b))
    (hE : ∀ k ≤ L, ∀ i b c, SymbolContMDiffOn S ω b → SymbolContMDiffOn S ω c →
      SymbolBoundaryJetEq W k b c → SymbolBoundaryJetEq W k (D i b) (D i c))
    {b c : NativeSymbol n} (h : SymbolJetComparison S W L b c) (α : Fin n → ℕ) :
    SymbolJetComparison S W L (symbolMultiDeriv D α b) (symbolMultiDeriv D α c) where
  analytic_left := symbolMultiDeriv_contMDiffOn D hD α h.analytic_left
  analytic_right := symbolMultiDeriv_contMDiffOn D hD α h.analytic_right
  jets := fun k hk => (h.jets k hk).multi D hD (hE k hk) h.analytic_left h.analytic_right α

without_proof_info in
theorem multiBase (hS : IsOpen S) (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b c : NativeSymbol n} (h : SymbolJetComparison S W L b c) (α : Fin n → ℕ) :
    SymbolJetComparison S W L (symbolMultiDeriv symbolBaseDeriv α b)
      (symbolMultiDeriv symbolBaseDeriv α c) :=
  h.multi symbolBaseDeriv
    (fun i _ hb => symbolBaseDeriv_contMDiffOn hS hb le_top i)
    (fun _ _ i _ _ hb hc he => he.base hS hW hWS hb hc i) α

without_proof_info in
theorem multiFrequency (hS : IsOpen S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {b c : NativeSymbol n} (h : SymbolJetComparison S W L b c) (α : Fin n → ℕ) :
    SymbolJetComparison S W L (symbolMultiDeriv symbolFrequencyDeriv α b)
      (symbolMultiDeriv symbolFrequencyDeriv α c) :=
  h.multi symbolFrequencyDeriv
    (fun i _ hb => symbolFrequencyDeriv_contMDiffOn hS hb le_top i)
    (fun _ _ i _ _ hb hc he => he.frequency hS hWS hb hc i) α

without_proof_info in
theorem composition (hS : IsOpen S) (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (b c : ℕ → NativeSymbol n) (r : ℕ)
    (h : ∀ p ≤ r, SymbolJetComparison S W L (b p) (c p)) :
    SymbolJetComparison S W L (symbolCompositionRemainder b r) (symbolCompositionRemainder c r) := by
  apply sum (Finset.range (r + 1)) hS hWS
  intro p hp
  apply sum (Finset.range (r + 1)) hS hWS
  intro q hq
  split_ifs with hpq
  · apply sum (Finset.Nat.antidiagonalTuple n (r + 1 - (p + q))) hS hWS
    intro α hα
    exact ((const _).mul hS hWS
      ((h p (Nat.le_of_lt_succ (Finset.mem_range.mp hp))).multiFrequency hS hWS α)).mul hS hWS
        ((h q (Nat.le_of_lt_succ (Finset.mem_range.mp hq))).multiBase hS hW hWS α)
  · exact const 0
end SymbolJetComparison
end ConformalPoisson

end ProofPart_SymbolJetComparison

/- Proof support: NormalSymbolCoefficientRegularity.lean, SHA256 d5af996329ee286ba8593606da92ef8331423e39b0bf332b684e55470fd3da15 -/
noncomputable section ProofPart_NormalSymbolCoefficientRegularity


/- Joint base/frequency regularity of the actual metric symbols. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
set_option quotPrecheck false
namespace ConformalPoisson
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
local notation "H₀" => EuclideanHalfSpace (n + 1)
local notation "X₀" => Fin n → ℝ
local notation "I₀" => (𝓡∂ (n + 1)).prod 𝓘(ℝ, X₀)
local notation "Ω" => ((S : Set H₀) ×ˢ {ξ : X₀ | ξ ≠ 0})

without_proof_info in
theorem symbol_coefficient_contMDiffOn {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : H₀ → F} {k : ℕ∞ω} (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) k f S) :
    ContMDiffOn I₀ 𝓘(ℝ, F) k (fun p : ModelProd H₀ X₀ => f p.1) Ω := by
  intro p hp
  have hfst : ContMDiffAt I₀ (𝓡∂ (n + 1)) k
      (Prod.fst : H₀ × X₀ → H₀) (p.1, p.2) := contMDiffAt_fst
  have h : ContMDiffAt I₀ 𝓘(ℝ, F) k (fun q : H₀ × X₀ => f q.1) (p.1, p.2) :=
    ((hf p.1 hp.1).contMDiffAt (S.isOpen.mem_nhds hp.1)).comp (p.1, p.2) hfst
  rw [chartedSpaceSelf_prod] at h
  exact ContMDiffAt.contMDiffWithinAt (M := ModelProd H₀ X₀) h

without_proof_info in
theorem symbol_frequency_contMDiff (k : ℕ∞ω) :
    ContMDiff I₀ 𝓘(ℝ, X₀) k (fun p : ModelProd H₀ X₀ => p.2) := by
  have h : ContMDiff I₀ 𝓘(ℝ, X₀) k (fun p : H₀ × X₀ => p.2) := contMDiff_snd
  rw [chartedSpaceSelf_prod] at h
  exact h

without_proof_info in
theorem symbol_frequency_entry_contMDiff (k : ℕ∞ω) (i : Fin n) :
    ContMDiff I₀ 𝓘(ℝ) k (fun p : ModelProd H₀ X₀ => p.2 i) :=
  (ContinuousLinearMap.proj i : X₀ →L[ℝ] ℝ).contDiff.contMDiff.comp
    (symbol_frequency_contMDiff k)

namespace NormalMetricField

without_proof_info in
theorem quadratic_joint_contMDiffOn (F : NormalMetricField S) {k : ℕ∞ω}
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) k F.inverse S) :
    ContMDiffOn I₀ 𝓘(ℝ) k (fun p : ModelProd H₀ X₀ => F.quadratic p.2 p.1) Ω := by
  have hentry : ∀ i j, ContMDiffOn I₀ 𝓘(ℝ) k
      (fun p : ModelProd H₀ X₀ => F.inverse p.1 i j) Ω := fun i j =>
    (normalMatrixEntry i j).contDiff.contMDiff.comp_contMDiffOn (symbol_coefficient_contMDiffOn hA)
  simp only [quadratic, normalMatrixQuadratic_eq_dot, dotProduct, Matrix.mulVec]
  exact contMDiffOn_finsetSum fun i _ =>
    (symbol_frequency_entry_contMDiff k i).contMDiffOn.mul
      (contMDiffOn_finsetSum fun j _ => (hentry i j).mul
        (symbol_frequency_entry_contMDiff k j).contMDiffOn)

without_proof_info in
theorem principal_joint_contMDiffOn (F : NormalMetricField S) {k : ℕ∞ω}
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) k F.inverse S) :
    ContMDiffOn I₀ 𝓘(ℝ) k (fun p : ModelProd H₀ X₀ => F.principal p.2 p.1) Ω :=
  (F.quadratic_joint_contMDiffOn hA).sqrt (fun p hp => (F.quadratic_pos p.2 hp.2 p.1 hp.1).ne')

without_proof_info in
theorem tau_analyticOn (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω F.tau S :=
  (normalMatrixTrace (n := n)).contDiff.contMDiff.comp_contMDiffOn
    (normalMatrix_mul_contMDiffOn hG (normalJet_analyticOn S.isOpen hA 1))

without_proof_info in
theorem firstOrderSymbol_analyticOn (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S) :
    SymbolContMDiffOn S ω F.firstOrderSymbol := by
  have hdA := fun i => modelDirectionalDeriv_analyticOn (𝓡∂ (n + 1))
    (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1)) S.isOpen hA
  have hdG := fun i => modelDirectionalDeriv_analyticOn (𝓡∂ (n + 1))
    (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1)) S.isOpen hG
  have hc : ∀ a b, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      (fun z => tangentialMatrixDeriv b F.inverse z b a +
        (1 / 2 : ℝ) * F.inverse z b a * metricJetTrace (F.inverse z) (tangentialMatrixDeriv b F.gram z)) S := by
    intro a b
    exact ((normalMatrixEntry b a).contDiff.contMDiff.comp_contMDiffOn (hdA b)).add
      ((contMDiffOn_const.mul ((normalMatrixEntry b a).contDiff.contMDiff.comp_contMDiffOn hA)).mul
        ((normalMatrixTrace (n := n)).contDiff.contMDiff.comp_contMDiffOn
          (normalMatrix_mul_contMDiffOn hA (hdG b))))
  have hsum : ContMDiffOn I₀ 𝓘(ℝ) ω
      (fun p : ModelProd H₀ X₀ => ∑ a, (∑ b,
        (tangentialMatrixDeriv b F.inverse p.1 b a + (1 / 2 : ℝ) * F.inverse p.1 b a *
          metricJetTrace (F.inverse p.1) (tangentialMatrixDeriv b F.gram p.1))) * p.2 a) Ω :=
    contMDiffOn_finsetSum fun a _ =>
      (symbol_coefficient_contMDiffOn (contMDiffOn_finsetSum fun b _ => hc a b)).mul
        (symbol_frequency_entry_contMDiff ω a).contMDiffOn
  exact symbolMul_contMDiffOn contMDiffOn_const
    (Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn hsum)
end NormalMetricField
end ConformalPoisson

end ProofPart_NormalSymbolCoefficientRegularity

/- Proof support: FirstOrderSymbolComparison.lean, SHA256 cbff52b4c13f2fce3acc772942e41acba85efeb1d740f920e26c8d178e944230 -/
noncomputable section ProofPart_FirstOrderSymbolComparison




/- Actual Q1 jets through L depend only on the actual inverse metric jets
through L as FUNCTIONS on one open boundary patch. No L+1 jet is used. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.NormalMetricField
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}

without_proof_info in
theorem firstOrderSymbol_jetComparison (F₁ F₂ : NormalMetricField S)
    (hW : IsOpen W) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L F₁.firstOrderSymbol F₂.firstOrderSymbol := by
  have hG : BoundaryJetComparison S W L F₁.gram F₂.gram := by
    refine ⟨hG₁, hG₂, ?_⟩
    intro k hk x hx
    exact inverse_jet_transfer F₁ F₂ (hWS hx) L
      (fun r hr => hA.jets r hr hx) k hk
  have hDA := fun i => hA.tangential S.isOpen hW hWS (EuclideanSpace.single i 1)
  have hDG := fun i => hG.tangential S.isOpen hW hWS (EuclideanSpace.single i 1)
  have htrace := fun i => (hA.bilinear S.isOpen hWS (hDG i) normalMatrixMultiplication).clm
    S.isOpen hWS (normalMatrixTrace (n := n))
  have hcoeff := fun a b =>
    ((hDA b).clm S.isOpen hWS (normalMatrixEntry b a)).add S.isOpen hWS
      (((BoundaryJetComparison.const (S := (S : Set _)) (W := W) (L := L) (1 / 2 : ℝ)).bilinear
        S.isOpen hWS (hA.clm S.isOpen hWS (normalMatrixEntry b a))
        (ContinuousLinearMap.mul ℝ ℝ)).bilinear S.isOpen hWS (htrace b) (ContinuousLinearMap.mul ℝ ℝ))
  have hreal (ξ : Fin n → ℝ) := BoundaryJetComparison.sum Finset.univ S.isOpen hWS
    (fun a _ => (BoundaryJetComparison.sum Finset.univ S.isOpen hWS (fun b _ => hcoeff a b)).bilinear
      S.isOpen hWS (BoundaryJetComparison.const (ξ a)) (ContinuousLinearMap.mul ℝ ℝ))
  refine ⟨F₁.firstOrderSymbol_analyticOn hG₁ hA.analytic_left,
    F₂.firstOrderSymbol_analyticOn hG₂ hA.analytic_right, ?_⟩
  intro k hk ξ hξ x hx
  have hcomplex := ((hreal ξ).clm S.isOpen hWS Complex.ofRealCLM).clm S.isOpen hWS
    (ContinuousLinearMap.mul ℝ ℂ (-Complex.I))
  exact hcomplex.jets k hk hx
end ConformalPoisson.NormalMetricField

end ProofPart_FirstOrderSymbolComparison

/- Proof support: RawSymbolAnalyticity.lean, SHA256 f8f2a67af3ca2f3e72635eebb454f19f290361eae29061ad2acf0f28fe43fdf7 -/
noncomputable section ProofPart_RawSymbolAnalyticity


/- PROJECT analyticity of each homogeneous component, obtained by finite
recursion. This does not assert analyticity of a Borel/asymptotic sum or
give a common analytic radius for infinitely many component indices. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.NormalMetricField
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {F : NormalMetricField S}

without_proof_info in
theorem RawSymbolFamily.component_analyticOn (B : RawSymbolFamily F)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    (r : ℕ) : SymbolContMDiffOn S ω (B.component r) := by
  have hp : ContMDiffOn ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) 𝓘(ℝ) ω
      (fun p : ModelProd (EuclideanHalfSpace (n + 1)) (Fin n → ℝ) => F.principal p.2 p.1)
      ((S : Set _) ×ˢ {ξ | ξ ≠ 0}) := F.principal_joint_contMDiffOn hA
  have hpC : SymbolContMDiffOn S ω (fun ξ z => Complex.ofReal (F.principal ξ z)) :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn hp
  have hE : SymbolContMDiffOn S ω (fun _ z => Complex.ofReal (F.tau z / 2)) :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn
      (symbol_coefficient_contMDiffOn ((F.tau_analyticOn hG hA).div_const 2))
  have hinv : SymbolContMDiffOn S ω (fun ξ z => Complex.ofReal ((2 * F.principal ξ z)⁻¹)) :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn
      ((contMDiffOn_const.mul hp).inv₀ (fun p hp =>
        mul_ne_zero (by norm_num) (F.principal_pos p.2 hp.2 p.1 hp.1).ne'))
  induction r using Nat.strong_induction_on with
  | ind r ih =>
    cases r with
    | zero =>
      refine (symbolMul_contMDiffOn (symbolConst_contMDiffOn (-1)) hpC).congr ?_
      intro p hp
      have h := B.principal p.2 hp.2 hp.1
      simpa only [Pi.smul_apply, Function.comp_apply, neg_one_smul, neg_one_mul] using h
    | succ r =>
      have hb : ∀ p ≤ r, SymbolContMDiffOn S ω (B.component p) :=
        fun p hp => ih p (Nat.lt_succ_of_le hp)
      have hN := symbolNormalDeriv_contMDiffOn S.isOpen (hb r le_rfl)
        (le_top : (ω : ℕ∞ω) + 1 ≤ ω)
      have hS := symbolCompositionRemainder_contMDiffOn S.isOpen
        (le_top : (ω : ℕ∞ω) + 1 ≤ ω) B.component r hb
      have hQ : SymbolContMDiffOn S ω (fun ξ z => if r = 0 then F.firstOrderSymbol ξ z else 0) := by
        by_cases hr : r = 0
        · simp only [hr, ite_true]
          exact F.firstOrderSymbol_analyticOn hG hA
        · simp only [hr, ite_false]
          exact symbolConst_contMDiffOn 0
      have hnum : SymbolContMDiffOn S ω (fun ξ z => normalDeriv (B.component r ξ) z -
          Complex.ofReal (F.tau z / 2) * B.component r ξ z +
          symbolCompositionRemainder B.component r ξ z -
          (if r = 0 then F.firstOrderSymbol ξ z else 0)) :=
        ((hN.sub (symbolMul_contMDiffOn hE (hb r le_rfl))).add hS).sub hQ
      refine (symbolMul_contMDiffOn hinv hnum).congr ?_
      intro p hp
      have hrec := B.recurrence r p.2 hp.2 p.1 hp.1
      dsimp only
      rw [← hrec]
      have hn : (Complex.ofReal (2 * F.principal p.2 p.1)) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (F.principal_pos p.2 hp.2 p.1 hp.1).ne')
      rw [Complex.ofReal_inv, ← mul_assoc, inv_mul_cancel₀ hn, one_mul]
end ConformalPoisson.NormalMetricField

end ProofPart_RawSymbolAnalyticity

/- Proof support: PrincipalSymbolComparison.lean, SHA256 daae5b721a67bb6fa43a74b94de3226057c22d0abb2b34abfeee73e55ea7c2e9 -/
noncomputable section ProofPart_PrincipalSymbolComparison




/- Concrete symbol coefficient comparisons for raw-recursion propagation:
the principal branch uses A jets through L; E jets through L use A jets
through L+1, with that extra order explicit. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}

without_proof_info in
theorem BoundaryJetComparison.toSymbol
    {f g : EuclideanHalfSpace (n + 1) → ℂ} (h : BoundaryJetComparison S W L f g) :
    SymbolJetComparison S W L (fun _ => f) (fun _ => g) where
  analytic_left := symbol_coefficient_contMDiffOn h.analytic_left
  analytic_right := symbol_coefficient_contMDiffOn h.analytic_right
  jets := fun k hk _ _ _ hx => h.jets k hk hx

namespace NormalMetricField

without_proof_info in
theorem principalSymbol_jetComparison (F₁ F₂ : NormalMetricField S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L (fun ξ z => Complex.ofReal (F₁.principal ξ z))
      (fun ξ z => Complex.ofReal (F₂.principal ξ z)) where
  analytic_left := Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn
    (F₁.principal_joint_contMDiffOn hA.analytic_left)
  analytic_right := Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn
    (F₂.principal_joint_contMDiffOn hA.analytic_right)
  jets := by
    intro k hk ξ hξ x hx
    rw [normalJet_ofReal_eqOn S.isOpen (F₁.principal_smooth ξ hξ) k (hWS hx),
      normalJet_ofReal_eqOn S.isOpen (F₂.principal_smooth ξ hξ) k (hWS hx)]
    exact congrArg Complex.ofReal (principal_jets_eq F₁ F₂ (hWS hx) ξ hξ L
      (fun r hr => hA.jets r hr hx) k hk)

without_proof_info in
theorem twicePrincipalSymbol_jetComparison (F₁ F₂ : NormalMetricField S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L (fun ξ z => Complex.ofReal (2 * F₁.principal ξ z))
      (fun ξ z => Complex.ofReal (2 * F₂.principal ξ z)) := by
  apply ((SymbolJetComparison.const 2).mul S.isOpen hWS
    (principalSymbol_jetComparison F₁ F₂ hWS hA)).congr S.isOpen hWS
  · intro ξ hξ z hz
    simp only [Complex.ofReal_mul, Complex.ofReal_ofNat]
  · intro ξ hξ z hz
    simp only [Complex.ofReal_mul, Complex.ofReal_ofNat]

without_proof_info in
theorem inverseTwicePrincipalSymbol_jetComparison (F₁ F₂ : NormalMetricField S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L (fun ξ z => Complex.ofReal (F₁.inverseTwicePrincipal ξ z))
      (fun ξ z => Complex.ofReal (F₂.inverseTwicePrincipal ξ z)) := by
  have ha (F : NormalMetricField S)
      (hF : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S) :
      SymbolContMDiffOn S ω (fun ξ z => Complex.ofReal (F.inverseTwicePrincipal ξ z)) := by
    have hp := F.principal_joint_contMDiffOn hF
    have hi := hp.inv₀ (fun p hp => (F.principal_pos p.2 hp.2 p.1 hp.1).ne')
    exact Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn (contMDiffOn_const.mul hi)
  refine ⟨ha F₁ hA.analytic_left, ha F₂ hA.analytic_right, ?_⟩
  intro k hk ξ hξ x hx
  rw [normalJet_ofReal_eqOn S.isOpen (F₁.inverseTwicePrincipal_smooth ξ hξ) k (hWS hx),
    normalJet_ofReal_eqOn S.isOpen (F₂.inverseTwicePrincipal_smooth ξ hξ) k (hWS hx)]
  exact congrArg Complex.ofReal (inverseTwicePrincipal_jets_eq F₁ F₂ (hWS hx) ξ hξ L
    (fun r hr => hA.jets r hr hx) k hk)

without_proof_info in
theorem normalFirstOrderSymbol_jetComparison (F₁ F₂ : NormalMetricField S)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA : BoundaryJetComparison S W (L + 1) F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L (fun _ z => Complex.ofReal (F₁.tau z / 2))
      (fun _ z => Complex.ofReal (F₂.tau z / 2)) := by
  have htau : BoundaryJetComparison S W L F₁.tau F₂.tau := by
    refine ⟨F₁.tau_analyticOn hG₁ hA.analytic_left, F₂.tau_analyticOn hG₂ hA.analytic_right, ?_⟩
    intro k hk x hx
    exact tau_jet_eq_of_inverse_jets F₁ F₂ (hWS hx) (L + 1)
      (fun r hr => hA.jets r hr hx) k (by omega)
  have h := ((htau.clm S.isOpen hWS ((ContinuousLinearMap.mul ℝ ℝ).flip (2⁻¹))).clm
    S.isOpen hWS Complex.ofRealCLM).toSymbol
  change SymbolJetComparison S W L (fun _ z => Complex.ofReal (F₁.tau z * 2⁻¹))
    (fun _ z => Complex.ofReal (F₂.tau z * 2⁻¹)) at h
  simpa only [div_eq_mul_inv] using h

without_proof_info in
theorem RawSymbolFamily.principal_jetComparison {F₁ F₂ : NormalMetricField S}
    (B₁ : RawSymbolFamily F₁) (B₂ : RawSymbolFamily F₂)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L (B₁.component 0) (B₂.component 0) := by
  apply ((SymbolJetComparison.const (-1)).mul S.isOpen hWS
    (principalSymbol_jetComparison F₁ F₂ hWS hA)).congr S.isOpen hWS
  · intro ξ hξ z hz
    simpa only [Pi.smul_apply, Function.comp_apply, neg_one_smul, neg_one_mul] using B₁.principal ξ hξ hz
  · intro ξ hξ z hz
    simpa only [Pi.smul_apply, Function.comp_apply, neg_one_smul, neg_one_mul] using B₂.principal ξ hξ hz
end NormalMetricField
end ConformalPoisson

end ProofPart_PrincipalSymbolComparison

/- Proof support: RawSymbolJetPropagation.lean, SHA256 79abb88792266460ae079c00bab93e742ffbaa9c8eab36deba03953a819560c3 -/
noncomputable section ProofPart_RawSymbolJetPropagation


/- PROJECT simultaneous propagation of normal jets of ALL nonprincipal
homogeneous components. The normal first-order coefficient at step k
uses metric jets only through k+1, explicitly bounded by L. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.NormalMetricField
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}
  {F₁ F₂ : NormalMetricField S}

without_proof_info in
theorem RawSymbolFamily.normalDeriv_relation {F : NormalMetricField S} (B : RawSymbolFamily F)
    (r : ℕ) (hr : 0 < r) (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) :
    EqOn (normalDeriv (B.component r ξ))
      (fun z => Complex.ofReal (2 * F.principal ξ z) * B.component (r + 1) ξ z +
        Complex.ofReal (F.tau z / 2) * B.component r ξ z -
        symbolCompositionRemainder B.component r ξ z) S := by
  intro z hz
  have h := B.recurrence r ξ hξ z hz
  simp only [Nat.ne_of_gt hr, ite_false, sub_zero] at h
  dsimp only
  rw [h]
  abel

without_proof_info in
theorem RawSymbolFamily.normalJets_eq (B₁ : RawSymbolFamily F₁) (B₂ : RawSymbolFamily F₂)
    (hW : IsOpen W) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse)
    (hboundary : ∀ r, SymbolBoundaryJetEq W 0 (B₁.component r) (B₂.component r)) :
    ∀ k ≤ L, ∀ r, 0 < r → SymbolBoundaryJetEq W k (B₁.component r) (B₂.component r) := by
  intro k
  induction k using Nat.strong_induction_on with
  | ind k ih =>
    intro hk r hr
    cases k with
    | zero => exact hboundary r
    | succ k =>
      have hkL : k ≤ L := (Nat.le_succ k).trans hk
      have hB (p : ℕ) : SymbolJetComparison S W k (B₁.component p) (B₂.component p) := by
        by_cases hp : p = 0
        · subst p
          exact B₁.principal_jetComparison B₂ hWS (hA.of_le hkL)
        · refine ⟨B₁.component_analyticOn hG₁ hA.analytic_left p,
            B₂.component_analyticOn hG₂ hA.analytic_right p, ?_⟩
          intro j hj
          exact ih j (Nat.lt_succ_of_le hj) (hj.trans hkL) p (Nat.pos_of_ne_zero hp)
      have hS := SymbolJetComparison.composition S.isOpen hW hWS B₁.component B₂.component r
        (fun p _ => hB p)
      have hP := twicePrincipalSymbol_jetComparison F₁ F₂ hWS (hA.of_le hkL)
      have hE := normalFirstOrderSymbol_jetComparison F₁ F₂ hWS hG₁ hG₂ (hA.of_le hk)
      have hR := ((hP.mul S.isOpen hWS (hB (r + 1))).add S.isOpen hWS
        (hE.mul S.isOpen hWS (hB r))).sub S.isOpen hWS hS
      intro ξ hξ x hx
      rw [normalJet_succ', normalJet_succ']
      exact (normalJet_eqOn S.isOpen (B₁.normalDeriv_relation r hr ξ hξ) k (hWS hx)).trans
        ((hR.jets k le_rfl ξ hξ x hx).trans
          (normalJet_eqOn S.isOpen (B₂.normalDeriv_relation r hr ξ hξ) k (hWS hx)).symm)
end ConformalPoisson.NormalMetricField

end ProofPart_RawSymbolJetPropagation

/- Proof support: DegreeZeroSymbolComparison.lean, SHA256 650205ec5aa096e40bf4244f966d056582772784340e584a00554927446d5910 -/
noncomputable section ProofPart_DegreeZeroSymbolComparison


/- Actual degree-zero tangential remainder comparison from metric jets
through the SAME order L. No extra normal coefficient jet is required. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.NormalMetricField
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}
  {F₁ F₂ : NormalMetricField S}

without_proof_info in
theorem RawSymbolFamily.degreeZeroRemainder_jetComparison
    (B₁ : RawSymbolFamily F₁) (B₂ : RawSymbolFamily F₂)
    (hW : IsOpen W) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) :
    SymbolJetComparison S W L
      (fun ξ => F₁.degreeZeroRemainder ξ (symbolCompositionRemainder B₁.component 0 ξ) (F₁.firstOrderSymbol ξ))
      (fun ξ => F₂.degreeZeroRemainder ξ (symbolCompositionRemainder B₂.component 0 ξ) (F₂.firstOrderSymbol ξ)) := by
  have h0 := B₁.principal_jetComparison B₂ hWS hA
  have hS := SymbolJetComparison.composition S.isOpen hW hWS B₁.component B₂.component 0
    (fun p hp => by have he : p = 0 := Nat.eq_zero_of_le_zero hp; subst p; exact h0)
  exact (inverseTwicePrincipalSymbol_jetComparison F₁ F₂ hWS hA).mul S.isOpen hWS
    (hS.sub S.isOpen hWS (firstOrderSymbol_jetComparison F₁ F₂ hW hWS hG₁ hG₂ hA))
end ConformalPoisson.NormalMetricField

end ProofPart_DegreeZeroSymbolComparison

/- Proof support: SymbolDegreeZeroExtraction.lean, SHA256 989f501191a4dddb4ea83ec2a195fdb5b9f9e59bf81ca35949f81b8b6ce7b0e5 -/
noncomputable section ProofPart_SymbolDegreeZeroExtraction



/- Checked native REAL-to-COMPLEX algebra of the degree-zero symbol
relation. The actual symbol identity and remainder jets remain explicit
producer obligations of the primitive recursion, not literature premises. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}

without_proof_info in
theorem normalJet_complex_affine_relation (c : ℝ)
    {b R : EuclideanHalfSpace (n + 1) → ℂ} {Q : EuclideanHalfSpace (n + 1) → ℝ}
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    (hQ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ Q S)
    (hR : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ R S)
    (hrelation : EqOn b (c • (Complex.ofReal ∘ Q) + R) S)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) (L : ℕ) :
    normalJet L b z = c • Complex.ofReal (normalJet L Q z) + normalJet L R z := by
  have hCQ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (Complex.ofReal ∘ Q) S :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn hQ
  let C : ℂ →L[ℝ] ℂ := c • ContinuousLinearMap.id ℝ ℂ
  have hscaled : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (c • (Complex.ofReal ∘ Q)) S :=
    C.contDiff.contMDiff.comp_contMDiffOn hCQ
  have ha := normalJet_add_eqOn hS hscaled hR L hz
  rw [normalJet_const_smul] at ha
  have hreal := normalJet_ofReal_eqOn hS hQ L hz
  exact (normalJet_eqOn hS hrelation L hz).trans
    (ha.trans (congrArg (fun v => c • v + normalJet L R z) hreal))

without_proof_info in
theorem normalJet_real_term_eq_of_complex_affine (c : ℝ) (hc : c ≠ 0)
    {b₁ b₂ R₁ R₂ : EuclideanHalfSpace (n + 1) → ℂ}
    {Q₁ Q₂ : EuclideanHalfSpace (n + 1) → ℝ}
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    (hQ₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ Q₁ S)
    (hQ₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ Q₂ S)
    (hR₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ R₁ S)
    (hR₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ R₂ S)
    (hrel₁ : EqOn b₁ (c • (Complex.ofReal ∘ Q₁) + R₁) S)
    (hrel₂ : EqOn b₂ (c • (Complex.ofReal ∘ Q₂) + R₂) S)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) (L : ℕ)
    (hb : normalJet L b₁ z = normalJet L b₂ z)
    (hR : normalJet L R₁ z = normalJet L R₂ z) : normalJet L Q₁ z = normalJet L Q₂ z := by
  have h₁ := normalJet_complex_affine_relation c hS hQ₁ hR₁ hrel₁ hz L
  have h₂ := normalJet_complex_affine_relation c hS hQ₂ hR₂ hrel₂ hz L
  have he := h₁.symm.trans (hb.trans h₂)
  rw [hR] at he
  have hs := add_right_cancel he
  exact Complex.ofReal_injective ((smul_right_injective ℂ hc) hs)

namespace NormalMetricField
variable {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}

without_proof_info in
theorem inverse_jet_step_of_degree_zero (F₁ F₂ : NormalMetricField S)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) (hn : 2 ≤ n) (L : ℕ)
    (hA : ∀ r ≤ L, normalJet r F₁.inverse z = normalJet r F₂.inverse z)
    (b₁ b₂ R₁ R₂ : (Fin n → ℝ) → EuclideanHalfSpace (n + 1) → ℂ)
    (hR₁ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (R₁ ξ) S)
    (hR₂ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (R₂ ξ) S)
    (hrel₁ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      EqOn (b₁ ξ) ((-1 / 4 : ℝ) • (Complex.ofReal ∘ F₁.KQuadratic ξ) + R₁ ξ) S)
    (hrel₂ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      EqOn (b₂ ξ) ((-1 / 4 : ℝ) • (Complex.ofReal ∘ F₂.KQuadratic ξ) + R₂ ξ) S)
    (hb : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → normalJet L (b₁ ξ) z = normalJet L (b₂ ξ) z)
    (hR : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → normalJet L (R₁ ξ) z = normalJet L (R₂ ξ) z) :
    normalJet (L + 1) F₁.inverse z = normalJet (L + 1) F₂.inverse z := by
  apply inverse_jet_step_of_quadratic_jet_eq F₁ F₂ hz hn L hA
  intro ξ hξ
  exact normalJet_real_term_eq_of_complex_affine (-1 / 4) (by norm_num) S.isOpen
    (F₁.KQuadratic_smooth ξ hξ) (F₂.KQuadratic_smooth ξ hξ) (hR₁ ξ hξ) (hR₂ ξ hξ)
    (hrel₁ ξ hξ) (hrel₂ ξ hξ) hz L (hb ξ hξ) (hR ξ hξ)
end NormalMetricField
end ConformalPoisson

end ProofPart_SymbolDegreeZeroExtraction

/- Proof support: SymbolMetricJetRecoveryCaller.lean, SHA256 1d70e3fb5881e5dcb041d66f1edc18a086998eaf6099517640843abab81375d8 -/
noncomputable section ProofPart_SymbolMetricJetRecoveryCaller


/- Checked CONDITIONAL consumer for the primitive symbol producer. Actual
symbol/remainder relations and their normal-jet comparisons are still open
project obligations; this is not an authorized boundary-recovery premise. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.NormalMetricField
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}

without_proof_info in
theorem all_normalJets_of_degree_zero (F₁ F₂ : NormalMetricField S)
    (B : Set (EuclideanHalfSpace (n + 1))) (hB : B ⊆ S) (hn : 2 ≤ n)
    (hprincipal : ∀ z ∈ B, ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      normalPrincipal (F₁.inverse z) ξ = normalPrincipal (F₂.inverse z) ξ)
    (b₁ b₂ R₁ R₂ : (Fin n → ℝ) → EuclideanHalfSpace (n + 1) → ℂ)
    (hR₁ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (R₁ ξ) S)
    (hR₂ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (R₂ ξ) S)
    (hrel₁ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      EqOn (b₁ ξ) ((-1 / 4 : ℝ) • (Complex.ofReal ∘ F₁.KQuadratic ξ) + R₁ ξ) S)
    (hrel₂ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      EqOn (b₂ ξ) ((-1 / 4 : ℝ) • (Complex.ofReal ∘ F₂.KQuadratic ξ) + R₂ ξ) S)
    (hcompare : ∀ L : ℕ,
      (∀ r ≤ L, EqOn (normalJet r F₁.inverse) (normalJet r F₂.inverse) B) →
      ∀ z ∈ B, ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
        normalJet L (b₁ ξ) z = normalJet L (b₂ ξ) z ∧
        normalJet L (R₁ ξ) z = normalJet L (R₂ ξ) z) :
    ∀ k : ℕ, EqOn (normalJet k F₁.inverse) (normalJet k F₂.inverse) B ∧
      EqOn (normalJet k F₁.gram) (normalJet k F₂.gram) B := by
  have hbase : EqOn F₁.inverse F₂.inverse B := by
    intro z hz
    exact normalMatrix_eq_of_principal_eq _ _ (F₁.inverse_posDef z (hB hz))
      (F₂.inverse_posDef z (hB hz)) (hprincipal z hz)
  apply all_normalJets_of_inverse_step F₁ F₂ B hB hbase
  intro L hA z hz
  exact inverse_jet_step_of_degree_zero F₁ F₂ (hB hz) hn L (fun r hr => hA r hr hz)
    b₁ b₂ R₁ R₂ hR₁ hR₂ hrel₁ hrel₂
    (fun ξ hξ => (hcompare L hA z hz ξ hξ).1) (fun ξ hξ => (hcompare L hA z hz ξ hξ).2)
end ConformalPoisson.NormalMetricField

end ProofPart_SymbolMetricJetRecoveryCaller

/- Proof support: RawSymbolMetricJets.lean, SHA256 e1625d7a76641357fd12b2ca6f84476e5076737a31bb03ec339508d9ed046df1 -/
noncomputable section ProofPart_RawSymbolMetricJets




/- PROJECT boundary determination of all native normal metric jets from
the primitive raw recurrence and homogeneous boundary symbol equality.
All formerly conditional degree-zero comparison producers are discharged.
Analytic germs/isometry/solution seed are separate subsequent obligations. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.NormalMetricField
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {F₁ F₂ : NormalMetricField S}

without_proof_info in
theorem RawSymbolFamily.all_metric_normalJets_eq (B₁ : RawSymbolFamily F₁) (B₂ : RawSymbolFamily F₂)
    (hn : 2 ≤ n) (hW : IsOpen W) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hA₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.inverse S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.inverse S)
    (hboundary : ∀ r, SymbolBoundaryJetEq W 0 (B₁.component r) (B₂.component r)) :
    ∀ k : ℕ,
      EqOn (normalJet k F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
        (normalJet k F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W ∧
      EqOn (normalJet k F₁.gram ∘ EuclideanHalfSpace.boundaryParam n)
        (normalJet k F₂.gram ∘ EuclideanHalfSpace.boundaryParam n) W := by
  let Z := EuclideanHalfSpace.boundaryParam n '' W
  have hZS : Z ⊆ S := by rintro z ⟨x, hx, rfl⟩; exact hWS hx
  have hp : ∀ z ∈ Z, ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      normalPrincipal (F₁.inverse z) ξ = normalPrincipal (F₂.inverse z) ξ := by
    rintro z ⟨x, hx, rfl⟩ ξ hξ
    have h₁ := B₁.principal ξ hξ (hWS hx)
    have h₂ := B₂.principal ξ hξ (hWS hx)
    simp only [Pi.smul_apply, Function.comp_apply, neg_one_smul] at h₁ h₂
    have he := h₁.symm.trans ((hboundary 0 ξ hξ x hx).trans h₂)
    exact Complex.ofReal_injective (neg_injective he)
  have hbase : EqOn F₁.inverse F₂.inverse Z := by
    intro z hz
    exact normalMatrix_eq_of_principal_eq _ _ (F₁.inverse_posDef z (hZS hz))
      (F₂.inverse_posDef z (hZS hz)) (hp z hz)
  have hA0 : BoundaryJetComparison S W 0 F₁.inverse F₂.inverse := by
    refine ⟨hA₁, hA₂, ?_⟩
    intro k hk x hx
    have he : k = 0 := Nat.eq_zero_of_le_zero hk
    subst k
    exact hbase ⟨x, hx, rfl⟩
  let R₁ : NativeSymbol n := fun ξ => F₁.degreeZeroRemainder ξ
    (symbolCompositionRemainder B₁.component 0 ξ) (F₁.firstOrderSymbol ξ)
  let R₂ : NativeSymbol n := fun ξ => F₂.degreeZeroRemainder ξ
    (symbolCompositionRemainder B₂.component 0 ξ) (F₂.firstOrderSymbol ξ)
  have hR0 := B₁.degreeZeroRemainder_jetComparison B₂ hW hWS hG₁ hG₂ hA0
  have hR₁ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (R₁ ξ) S := by
    intro ξ hξ z hz
    exact ((symbol_slice_contMDiffAt hR0.analytic_left S.isOpen hz hξ).of_le le_top).contMDiffWithinAt
  have hR₂ : ∀ ξ : Fin n → ℝ, ξ ≠ 0 →
      ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (R₂ ξ) S := by
    intro ξ hξ z hz
    exact ((symbol_slice_contMDiffAt hR0.analytic_right S.isOpen hz hξ).of_le le_top).contMDiffWithinAt
  have hall := all_normalJets_of_degree_zero F₁ F₂ Z hZS hn hp
    (B₁.component 1) (B₂.component 1) R₁ R₂ hR₁ hR₂
    B₁.degreeZero_relation B₂.degreeZero_relation
    (fun L hA => by
      have hpair : BoundaryJetComparison S W L F₁.inverse F₂.inverse := by
        refine ⟨hA₁, hA₂, ?_⟩
        intro r hr x hx
        exact hA r hr ⟨x, hx, rfl⟩
      have hb := B₁.normalJets_eq B₂ hW hWS hG₁ hG₂ hpair hboundary L le_rfl 1 (by decide)
      have hR := B₁.degreeZeroRemainder_jetComparison B₂ hW hWS hG₁ hG₂ hpair
      rintro z ⟨x, hx, rfl⟩ ξ hξ
      exact ⟨hb ξ hξ x hx, hR.jets L le_rfl ξ hξ x hx⟩)
  intro k
  exact ⟨fun x hx => (hall k).1 ⟨x, hx, rfl⟩,
    fun x hx => (hall k).2 ⟨x, hx, rfl⟩⟩
end ConformalPoisson.NormalMetricField

end ProofPart_RawSymbolMetricJets

/- Proof support: GaugedBoundaryMetricJets.lean, SHA256 21647b467f1372cfec716838198fe69bd1a2cab8b4286423987f6b6a3b46c10d -/
noncomputable section ProofPart_GaugedBoundaryMetricJets



/- Bind PROJECT metric normal-jet recovery to the actual original paired
gauges/common charts and the approved primitive localized DN input. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂] [SecondCountableTopology M₁] [SecondCountableTopology M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.exists_equal_metric_normalJets
    (hSymbol : LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (hn : 2 ≤ n) (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    ∃ (S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1)))
      (hS : S ≤ C.coefficientDomain),
      EuclideanHalfSpace.boundaryParam n C.boundaryBase ∈ S ∧
      ∀ k : ℕ,
        EqOn (normalJet k (C.metricField₁.restrict S hS).inverse ∘ EuclideanHalfSpace.boundaryParam n)
          (normalJet k (C.metricField₂.restrict S hS).inverse ∘ EuclideanHalfSpace.boundaryParam n)
          (EuclideanHalfSpace.boundaryParam n ⁻¹' (S : Set _)) ∧
        EqOn (normalJet k (C.metricField₁.restrict S hS).gram ∘ EuclideanHalfSpace.boundaryParam n)
          (normalJet k (C.metricField₂.restrict S hS).gram ∘ EuclideanHalfSpace.boundaryParam n)
          (EuclideanHalfSpace.boundaryParam n ⁻¹' (S : Set _)) := by
  obtain ⟨S, hS, hbase, B₁, B₂, hboundary⟩ :=
    hSymbol hcompact₁ hcompact₂ hconnected₁ hconnected₂ hn A₁ A₂ V₁ V₂ D x P C
  refine ⟨S, hS, hbase, ?_⟩
  let W := EuclideanHalfSpace.boundaryParam n ⁻¹' (S : Set _)
  have hW : IsOpen W := S.isOpen.preimage EuclideanHalfSpace.continuous_boundaryParam
  have hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S := fun _ hx => hx
  have hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω
      (C.metricField₁.restrict S hS).gram S := fun z hz =>
    ((C.metricField₁_analytic P.metricAnalyticOn₁ (hS hz)).1).contMDiffWithinAt
  have hA₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω
      (C.metricField₁.restrict S hS).inverse S := fun z hz =>
    ((C.metricField₁_analytic P.metricAnalyticOn₁ (hS hz)).2).contMDiffWithinAt
