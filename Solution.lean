noncomputable section ProofPart_GreenTrace_NativeInverseLpRows



/- Actual Lp-conjugate rows representing point evaluation of the native
Dirichlet inverse. These are measure classes, not yet the jointly smooth
off-diagonal representative required by DirichletGreenKernel. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_inverse_lp_rows
    {r : ℝ≥0} {s : ℝ≥0∞} [Fact (1 ≤ (r : ℝ≥0∞))] [Fact (1 ≤ s)]
    [s.HolderConjugate (r : ℝ≥0∞)]
    (hr : (n + 1 : ℝ≥0) < r) (hp : 2 < (r : ℝ≥0∞))
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) :
    ∃ C ≥ 0, ∀ x : M, ∃ k : Lp ℝ s (nativeVolume g), ‖k‖ ≤ C ∧
      ∀ F : C^∞⟮Ihalf, M; ℝ⟯, ∀ u : M → ℝ,
        IsZeroDirichletSolution g q F u →
          Integrable (fun z => k z * F z) (nativeVolume g) ∧
          u x = ∫ z, k z * F z ∂nativeVolume g := by
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  obtain ⟨C, hC, hL⟩ := exists_native_inverse_evaluation_functionals hr hp g q hq hNR
  refine ⟨C, hC, fun x => ?_⟩
  obtain ⟨L, hLC, hLF⟩ := hL x
  obtain ⟨k, hk, hrep⟩ := exists_lp_density_of_reading_bound
    (s := s) ((by norm_num : (1 : ℝ≥0∞) < 2).trans hp) (by finiteness)
    (LinearMap.id : Lp ℝ (r : ℝ≥0∞) (nativeVolume g) →ₗ[ℝ] _)
    L.toLinearMap (norm_nonneg L) (fun a => L.le_opNorm a)
  refine ⟨k, hk.trans hLC, fun F u hu => ?_⟩
  have hAE : (fun z => k z * nativeSmoothForcingToLp g r F z) =ᵐ[nativeVolume g]
      (fun z => k z * F z) := by
    filter_upwards [nativeSmoothForcingToLp_ae g r F] with z hz
    rw [hz]
  obtain ⟨hint, heq⟩ := hrep (nativeSmoothForcingToLp g r F)
  refine ⟨hint.congr hAE, ?_⟩
  have heq' : L (nativeSmoothForcingToLp g r F) =
      ∫ z, k z * nativeSmoothForcingToLp g r F z ∂nativeVolume g := heq
  exact (hLF F u hu).symm.trans (heq'.trans (integral_congr_ae hAE))

end ConformalPoisson

end ProofPart_GreenTrace_NativeInverseLpRows

/- Green/trace proof support: NativeLpRowUniqueness.lean, SHA256 45aa7c74e317ba830b450f4e0858d95bb400c7abf01319b5372607699ff6ee8c -/
noncomputable section ProofPart_GreenTrace_NativeLpRowUniqueness



/- Smooth native forcing moments uniquely determine an Lp-conjugate row.
In particular the point-evaluation inverse row is zero at physical boundary points. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  {p s : ℝ≥0∞} [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem native_lp_rows_eq_of_smooth_moments
    (g : Metric (n := n) (M := M)) (hp : p ≠ (⊤ : ℝ≥0∞))
    (k l : Lp ℝ s (nativeVolume g))
    (h : ∀ F : C^∞⟮Ihalf, M; ℝ⟯,
      (∫ z, k z * F z ∂nativeVolume g) = ∫ z, l z * F z ∂nativeVolume g) : k = l := by
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  apply (Lp.toDual ℝ (nativeVolume g) s p).injective
  apply DFunLike.coe_injective
  apply (denseRange_nativeSmoothForcingToLp g p hp).equalizer
    (ContinuousLinearMap.continuous _) (ContinuousLinearMap.continuous _)
  funext F
  rw [Function.comp_apply, Function.comp_apply, Lp.toDual_apply, Lp.toDual_apply]
  have hAE := nativeSmoothForcingToLp_ae g p F
  calc
    (∫ z, k z * nativeSmoothForcingToLp g p F z ∂nativeVolume g) =
        ∫ z, k z * F z ∂nativeVolume g := integral_congr_ae (hAE.mono fun z hz => congrArg (fun a => k z * a) hz)
    _ = ∫ z, l z * F z ∂nativeVolume g := h F
    _ = ∫ z, l z * nativeSmoothForcingToLp g p F z ∂nativeVolume g :=
      (integral_congr_ae (hAE.mono fun z hz => congrArg (fun a => l z * a) hz)).symm

without_proof_info in
theorem native_inverse_boundary_lp_row_eq_zero
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hp : p ≠ (⊤ : ℝ≥0∞)) (y : (Ihalf).boundary M) (k : Lp ℝ s (nativeVolume g))
    (hrow : ∀ F : C^∞⟮Ihalf, M; ℝ⟯, ∀ u : M → ℝ,
      IsZeroDirichletSolution g q F u → u y = ∫ z, k z * F z ∂nativeVolume g) : k = 0 := by
  apply native_lp_rows_eq_of_smooth_moments g hp k 0
  intro F
  obtain ⟨u, hu⟩ := exists_zeroDirichletSolution g q hq hNR F F.contMDiff
  have hk : (∫ z, k z * F z ∂nativeVolume g) = 0 := (hrow F u hu).symm.trans (hu.2.2 y)
  rw [hk]
  have hz : (fun z => (0 : Lp ℝ s (nativeVolume g)) z * F z) =ᵐ[nativeVolume g] 0 := by
    filter_upwards [Lp.coeFn_zero ℝ s (nativeVolume g)] with z hz
    simp only [hz, zero_mul, Pi.zero_apply]
  rw [integral_congr_ae hz]
  change 0 = ∫ _ : M, (0 : ℝ) ∂nativeVolume g
  rw [integral_zero]

end ConformalPoisson

end ProofPart_GreenTrace_NativeLpRowUniqueness

