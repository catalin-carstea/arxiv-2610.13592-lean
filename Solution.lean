theorem coordinateSchrodinger_schwartz_expansion
    (A : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) (φ : 𝓢(V, ℝ)) (x : V) :
    coordinateSchrodinger A b q φ x =
      -(∑ i, ∑ j, principalScalarEntry A i j x *
        ∂_{EuclideanSpace.single i (1 : ℝ)} (∂_{EuclideanSpace.single j (1 : ℝ)} φ) x) +
        (∑ i, b x i * ∂_{EuclideanSpace.single i (1 : ℝ)} φ x) + q x * φ x := by
  have hH : (∑ i, fderiv ℝ (fderiv ℝ (φ : V → ℝ)) x (EuclideanSpace.single i (1 : ℝ))
      (A x (EuclideanSpace.single i (1 : ℝ)))) =
      ∑ i, ∑ j, principalScalarEntry A i j x *
        ∂_{EuclideanSpace.single i (1 : ℝ)} (∂_{EuclideanSpace.single j (1 : ℝ)} φ) x := by
    apply Finset.sum_congr rfl
    intro i _
    rw [ContinuousLinearMap.apply_eq_sum_single]
    apply Finset.sum_congr rfl
    intro j _
    rw [schwartz_second_lineDeriv_eq_fderiv]
    rfl
  have hB : fderiv ℝ (φ : V → ℝ) x (b x) =
      ∑ i, b x i * ∂_{EuclideanSpace.single i (1 : ℝ)} φ x := by
    rw [ContinuousLinearMap.apply_eq_sum_single]
    apply Finset.sum_congr rfl
    intro i _
    rw [SchwartzMap.lineDerivOp_apply_eq_fderiv]
    rfl
  rw [coordinateSchrodinger, hH, hB]

