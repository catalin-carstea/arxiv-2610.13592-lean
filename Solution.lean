theorem principalTerm_zero_profile {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (P : Y → ℂ[X]) {y : Y} (hy : y ∈ U) (s : ℝ) :
