noncomputable section ProofPart_CarlemanConjugation




/- The actual exponentially conjugated Laplace--Beltrami operator,
split into its real symmetric and skew parts. The potential will be
absorbed separately by the proved Hilbert-space estimate. -/
open Bundle FiberBundle TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]

variable (I)
def carlemanSymmetricPart (φ : M → ℝ) (τ : ℝ) (v : M → ℝ) : M → ℝ :=
  fun x => laplaceBeltrami I v x + τ ^ 2 * ‖mgradient I φ x‖ ^ 2 * v x

def carlemanSkewPart (φ : M → ℝ) (τ : ℝ) (v : M → ℝ) : M → ℝ :=
  fun x => -2 * τ * ⟪mgradient I φ x, mgradient I v x⟫_ℝ - τ * laplaceBeltrami I φ x * v x

variable {I}

set_option maxHeartbeats 500000 in
without_proof_info in
theorem exponential_conjugation_laplaceBeltrami {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (τ : ℝ) (x : M) :
    Real.exp (τ * φ x) * laplaceBeltrami I (fun y => Real.exp (-τ * φ y) * v y) x =
      carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x := by
  let g : ℝ → ℝ := fun s => Real.exp (-τ * s)
  have hg : ∀ s, HasDerivAt g (-τ * g s) s := by
    intro s
    simpa only [g, Function.comp_def, mul_one, mul_comm] using
      (Real.hasDerivAt_exp (-τ * s)).comp s ((hasDerivAt_id s).const_mul (-τ))
  have hdg : deriv g = fun s => -τ * g s := funext fun s => (hg s).deriv
  have hddg (s : ℝ) : deriv (deriv g) s = τ ^ 2 * g s := by
    rw [hdg, ((hg s).const_mul (-τ)).deriv]
    ring
  have hgC : ContDiff ℝ ∞ g := by dsimp only [g]; fun_prop
  have hgφ : ContMDiff I 𝓘(ℝ) ∞ (g ∘ φ) := hgC.contMDiff.comp hφ
  have hgrad := mgradient_comp_hasDerivAt (hg (φ x))
    ((hφ x).mdifferentiableAt (by simp))
  have hlap := laplaceBeltrami_comp I isOpen_univ (hgC.of_le (by simp)).contDiffOn
    (hφ.of_le (by simp)) (fun _ => Set.mem_univ _) x
  rw [hddg, hdg] at hlap
  have hfun : (g ∘ φ) * v = (fun y => Real.exp (-τ * φ y) * v y) := rfl
  rw [← hfun, laplaceBeltrami_mul I (hgφ.of_le (by simp)) (hv.of_le (by simp)), hgrad, hlap,
    real_inner_smul_left]
  have hexp : Real.exp (τ * φ x) * g (φ x) = 1 := by
    change Real.exp (τ * φ x) * Real.exp (-τ * φ x) = 1
    rw [← Real.exp_add]
    convert Real.exp_zero using 1 <;> congr 1 <;> ring
  dsimp only [carlemanSymmetricPart, carlemanSkewPart]
  calc
    _ = (Real.exp (τ * φ x) * g (φ x)) *
        (laplaceBeltrami I v x + τ ^ 2 * ‖mgradient I φ x‖ ^ 2 * v x -
          2 * τ * ⟪mgradient I φ x, mgradient I v x⟫_ℝ - τ * laplaceBeltrami I φ x * v x) := by
      simp only [Function.comp_apply]; ring
    _ = _ := by rw [hexp, one_mul]; ring
end ConformalPoisson

