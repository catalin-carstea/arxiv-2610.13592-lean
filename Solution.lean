    (b.continuous.comp e.continuous).aestronglyMeasurable.mul hRhs.aestronglyMeasurable
  have hmultbound : ∀ᵐ z ∂μ, ‖b (e z) * splitChartTraceForcing g c q F u z‖ ≤
      (1 : ℝ) * ‖splitChartTraceForcing g c q F u z‖ := by
    apply Filter.Eventually.of_forall
    intro z
    rw [norm_mul]
    have hb1 : ‖b (e z)‖ ≤ 1 := by
