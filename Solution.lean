theorem NativeClassicalValueKernel.exists_uniform_boundary_h1_readings
    {g : Metric (n := n) (M := M)} {q : M → ℝ} (hq : Continuous q)
    {a : ℝ≥0} (ha : 1 < a) [Fact (1 ≤ (a : ℝ≥0∞))]
