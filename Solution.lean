noncomputable section ProofPart_DNSymbol_DNCompactLayerCollar




/- Assignment268, /root. A single compact cutoff/collar witness is chosen
before frequencies and truncation orders. Profiles inherit its support. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Metric Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)

structure CompactLayerCollar (y : Y) (O : Set (Y × ℝ)) where
  amplitude : ContDiffBump y
  normalCutoff : ContDiffBump (0 : ℝ)
  cylinder_subset : closedBall y (2 * amplitude.rOut) ×ˢ closedBall (0 : ℝ) normalCutoff.rOut ⊆ O

without_proof_info in
theorem nonempty_compactLayerCollar {O : Set (Y × ℝ)} (hO : IsOpen O) (y : Y)
    (hy : (y, (0 : ℝ)) ∈ O) : Nonempty (CompactLayerCollar y O) := by
  obtain ⟨ε, hε, hsub⟩ := Metric.mem_nhds_iff.mp (hO.mem_nhds hy)
  let a : ContDiffBump y := ⟨ε / 8, ε / 4, by positivity, by linarith⟩
  let η : ContDiffBump (0 : ℝ) := ⟨ε / 8, ε / 4, by positivity, by linarith⟩
  refine ⟨⟨a, η, ?_⟩⟩
  intro x hx
  apply hsub
  rw [mem_ball, Prod.dist_eq, max_lt_iff]
  constructor
  · exact hx.1.trans_lt (by dsimp [a]; linarith)
  · exact hx.2.trans_lt (by dsimp [η]; linarith)

namespace CompactLayerCollar

def tangentialDomain {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) : Set Y :=
  ball y (2 * C.amplitude.rOut)

def supportCap {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) : Set Y :=
  closedBall y C.amplitude.rOut

without_proof_info in
theorem isOpen_tangentialDomain {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) :
    IsOpen C.tangentialDomain := isOpen_ball

without_proof_info in
theorem isCompact_supportCap {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) :
    IsCompact C.supportCap := isCompact_closedBall _ _

without_proof_info in
theorem supportCap_subset_domain {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) :
    C.supportCap ⊆ C.tangentialDomain := by
  intro z hz
  change dist z y ≤ C.amplitude.rOut at hz
  change dist z y < 2 * C.amplitude.rOut
  exact hz.trans_lt (by have hp := C.amplitude.rOut_pos; linarith)

without_proof_info in
theorem amplitude_zero_outside {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O)
    {z : Y} (hz : z ∉ C.supportCap) : C.amplitude z = 0 :=
  image_eq_zero_of_notMem_tsupport (by simpa only [C.amplitude.tsupport_eq, supportCap] using hz)

without_proof_info in
theorem amplitude_one_on_inner {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O)
    {z : Y} (hz : z ∈ ball y C.amplitude.rIn) : C.amplitude z = 1 :=
  C.amplitude.one_of_mem_closedBall (ball_subset_closedBall hz)

without_proof_info in
theorem normalCutoff_zero {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) :
    C.normalCutoff 0 = 1 := C.normalCutoff.one_of_mem_closedBall (mem_closedBall_self C.normalCutoff.rIn_pos.le)

without_proof_info in
theorem normalCutoff_hasDerivAt {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) :
    HasDerivAt C.normalCutoff 0 0 :=
  (hasDerivAt_const (0 : ℝ) (1 : ℝ)).congr_of_eventuallyEq C.normalCutoff.eventuallyEq_one

without_proof_info in
theorem support_cylinder_subset {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O) :
    C.supportCap ×ˢ tsupport C.normalCutoff ⊆ O := by
  intro x hx
  apply C.cylinder_subset
  refine ⟨?_, by simpa only [C.normalCutoff.tsupport_eq] using hx.2⟩
  change dist x.1 y ≤ 2 * C.amplitude.rOut
  have hh : dist x.1 y ≤ C.amplitude.rOut := hx.1
  exact hh.trans (by have hp := C.amplitude.rOut_pos; linarith)

without_proof_info in
theorem face_domain_subset {y : Y} {O : Set (Y × ℝ)} (C : CompactLayerCollar y O)
    {z : Y} (hz : z ∈ C.tangentialDomain) : (z, (0 : ℝ)) ∈ O := by
  apply C.cylinder_subset
  refine ⟨?_, mem_closedBall_self C.normalCutoff.rOut_pos.le⟩
  change dist z y ≤ 2 * C.amplitude.rOut
  exact le_of_lt hz

end CompactLayerCollar
end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNCompactLayerCollar

