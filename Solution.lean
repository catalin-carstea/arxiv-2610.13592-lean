    (D : Opens V) (hD : IsCompact (closure (D : Set V)))
    (hDU : closure (D : Set V) ⊆ ball (extChartAt Ihalf c c) L.bump.rIn)
    (hconvD : Convex ℝ (D : Set V)) :
