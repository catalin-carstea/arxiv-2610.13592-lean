/- Assignment268, /root. The needed actual scalar coefficient readings are
contractive readings of the SAME finite native coefficient bundle. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)
local notation "A" => Matrix (Fin n) (Fin n) ℝ
local notation "Z" => A × ℝ × (Fin n → ℝ)

def coefficientInverseReading (i j : Fin n) : Z →L[ℝ] ℝ :=
  (normalMatrixEntry i j).comp (ContinuousLinearMap.fst ℝ A (ℝ × (Fin n → ℝ)))

def coefficientNormalReading : Z →L[ℝ] ℝ :=
  (ContinuousLinearMap.fst ℝ ℝ (Fin n → ℝ)).comp (ContinuousLinearMap.snd ℝ A (ℝ × (Fin n → ℝ)))

def coefficientTangentReading (i : Fin n) : Z →L[ℝ] ℝ :=
  (ContinuousLinearMap.proj i : (Fin n → ℝ) →L[ℝ] ℝ).comp
    ((ContinuousLinearMap.snd ℝ ℝ (Fin n → ℝ)).comp (ContinuousLinearMap.snd ℝ A (ℝ × (Fin n → ℝ))))

without_proof_info in
@[simp] theorem coefficientInverseReading_apply (i j : Fin n) (z : Z) : coefficientInverseReading i j z = z.1 i j := rfl
without_proof_info in
@[simp] theorem coefficientNormalReading_apply (z : Z) : coefficientNormalReading z = z.2.1 := rfl
without_proof_info in
@[simp] theorem coefficientTangentReading_apply (i : Fin n) (z : Z) : coefficientTangentReading i z = z.2.2 i := rfl

without_proof_info in
theorem coefficientInverseReading_contractive (i j : Fin n) (z : Z) : ‖coefficientInverseReading i j z‖ ≤ ‖z‖ :=
  ((norm_le_pi_norm (z.1 i) j).trans (norm_le_pi_norm z.1 i)).trans (norm_fst_le z)

without_proof_info in
theorem coefficientNormalReading_contractive (z : Z) : ‖coefficientNormalReading z‖ ≤ ‖z‖ :=
  (norm_fst_le z.2).trans (norm_snd_le z)

without_proof_info in
theorem coefficientTangentReading_contractive (i : Fin n) (z : Z) : ‖coefficientTangentReading i z‖ ≤ ‖z‖ :=
  ((norm_le_pi_norm z.2.2 i).trans (norm_snd_le z.2)).trans (norm_snd_le z)

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

without_proof_info in
theorem complexNormalTaylor_reading_bound_contractive (L : E →L[ℝ] ℝ)
    (hL : ∀ v : E, ‖L v‖ ≤ ‖v‖) {f : H → E} {S : Set H}
    (hS : IsOpen S) (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, E) ∞ f S)
    (y : Y) (hy : EuclideanHalfSpace.boundaryParam n y ∈ S) (N : ℕ) (t : ℝ)
    (z : H) {C : ℝ} (hb : ‖f z - nativeNormalTaylor f y N t‖ ≤ C * t ^ (N + 1)) :
    ‖(L (f z) : ℂ) - complexNormalTaylor (L ∘ f) y N t‖ ≤ C * t ^ (N + 1) := by
  rw [complexNormalTaylor_eq_ofReal, nativeNormalTaylor_clm L hS hf y hy N t,
    ← Complex.ofReal_sub, Complex.norm_real, ← map_sub]
  exact (hL (f z - nativeNormalTaylor f y N t)).trans hb

end ConformalPoisson.LocalDN

