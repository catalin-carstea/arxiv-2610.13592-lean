noncomputable section ProofPart_RelativeCoefficientBounds





/- Ordinary coefficient derivatives on an open cap are bounded by
continuous derivatives within the relative chart target. This uses no
smooth extension to an ambient open neighborhood of the physical face. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
section Bounds
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem iteratedFDerivWithin_eq_of_mem_interior {S : Set E} {f : E → F}
    {x : E} (hx : x ∈ interior S) (k : ℕ) :
    iteratedFDerivWithin ℝ k f S x = iteratedFDeriv ℝ k f x := by
  rw [← iteratedFDerivWithin_univ]
  exact iteratedFDerivWithin_congr_set
    (Filter.eventuallyEqSet_univ.mpr (mem_interior_iff_mem_nhds.mp hx)) k

without_proof_info in
theorem bound_iteratedFDeriv_of_relative_smooth {S K A : Set E}
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hAK : A ⊆ K) (hAS : A ⊆ interior S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S) (k : ℕ) :
    ∃ C : ℝ, ∀ x ∈ A, ‖iteratedFDeriv ℝ k f x‖ ≤ C := by
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
    ((hf.continuousOn_iteratedFDerivWithin (m := k) (by simp) hS).mono hKS)
  exact ⟨C, fun x hx => by
    rw [← iteratedFDerivWithin_eq_of_mem_interior (hAS hx) k]
    exact hC x (hAK hx)⟩

without_proof_info in
theorem relative_smooth_directional_derivative {S : Set E}
    (hS : UniqueDiffOn ℝ S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S) (v : E) :
    ContDiffOn ℝ ∞ (fun x => fderivWithin ℝ f S x v) S :=
  (hf.fderivWithin hS (by simp)).clm_apply contDiffOn_const

without_proof_info in
theorem relative_second_directional_derivative_eq_of_mem_interior
    {S : Set E} {f : E → F} {x : E} (hx : x ∈ interior S) (v w : E) :
    fderivWithin ℝ (fun y => fderivWithin ℝ f S y v) S x w =
      fderiv ℝ (fun y => fderiv ℝ f y v) x w := by
  rw [fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp hx)]
  have he : (fun y => fderivWithin ℝ f S y v) =ᶠ[𝓝 x] (fun y => fderiv ℝ f y v) := by
    filter_upwards [isOpen_interior.mem_nhds hx] with y hy
    rw [fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp hy)]
  rw [he.fderiv_eq]

section Measure
variable [MeasurableSpace E] [BorelSpace E] {μ : Measure E} [IsFiniteMeasureOnCompacts μ]

without_proof_info in
theorem memLp_iteratedFDeriv_of_relative_smooth {S K : Set E} {Ω : Opens E}
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set E) ⊆ K) (hΩS : (Ω : Set E) ⊆ interior S)
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) (k : ℕ) (p : ℝ≥0∞) :
    MemLp (iteratedFDeriv ℝ k f) p (μ.restrict Ω) := by
  have hc := (hf.continuousOn_iteratedFDerivWithin (m := k) (by simp) hS).mono hKS
  have h := hc.memLp_restrict_of_subset_isCompact (μ := μ) hK Ω.isOpen.measurableSet hΩK p
  refine (memLp_congr_ae (ae_restrict_of_forall_mem Ω.isOpen.measurableSet fun x hx => ?_)).mp h
  exact iteratedFDerivWithin_eq_of_mem_interior (hΩS hx) k
end Measure
end Bounds

section Sobolev
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace E] [BorelSpace E] {μ : Measure E} [μ.IsAddHaarMeasure]

without_proof_info in
/-- A scalar field smooth on the relative target has an actual Sobolev
representative of every order on a cap compactly contained in that target. -/
theorem exists_wkp_of_relative_smooth {S K : Set E} {Ω : Opens E}
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set E) ⊆ K) (hΩS : (Ω : Set E) ⊆ interior S)
    {f : E → ℝ} (hf : ContDiffOn ℝ ∞ f S) (k : ℕ) :
    ∃ w : Wkp μ Ω 2 k, Wkp.value k w =ᵐ[μ.restrict Ω] f :=
  Wkp.exists_value_ae_eq_of_contDiffOn k
    ((hf.mono (hΩS.trans interior_subset)).of_le (by simp))
