/- Green/trace proof support: LocalHomogeneousDirichletSpace.lean, SHA256 7850b5fbfa435d917d3aa53bccc9eddae10c08fc7a467c39f44df7b78e3f7448 -/
noncomputable section ProofPart_GreenTrace_LocalHomogeneousDirichletSpace




/- A complete local homogeneous zero-Dirichlet solution space. Local
cutoff trace constraints and the actual bounded weak energy equation are
closed linear conditions. Intended caller: the already-proved relative
boundary higher-regularity theorem, lifted by the closed-graph theorem. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti
open scoped ENNReal NNReal ContDiff Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω U : Opens E}
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

structure LocalDirichletCutoff (Ω U : Opens E) where
  cutoff : E → ℝ
  smooth : ContDiff ℝ ∞ cutoff
  compact : HasCompactSupport cutoff
  support_subset : tsupport cutoff ⊆ U
  bound : ℝ
  bound_nonneg : 0 ≤ bound
  value_bound : ∀ x ∈ Ω, |cutoff x| ≤ bound
  gradient_bound : ∀ x ∈ Ω, ‖∇ cutoff x‖ ≤ bound

def LocalDirichletCutoff.mulL (D : LocalDirichletCutoff Ω U) :
    W1p μ Ω p →L[ℝ] W1p μ Ω p :=
  W1p.contDiffSMulL D.cutoff D.smooth D.bound_nonneg D.value_bound D.gradient_bound

without_proof_info in
theorem exists_localDirichletCutoff (ψ : E → ℝ) (hψ : ContDiff ℝ ∞ ψ)
    (hψc : HasCompactSupport ψ) (hψU : tsupport ψ ⊆ U) :
    ∃ D : LocalDirichletCutoff Ω U, D.cutoff = ψ := by
  obtain ⟨B, hB⟩ := hψc.exists_bound_of_continuous hψ.continuous
  obtain ⟨G, hG⟩ := (hψc.fderiv (𝕜 := ℝ)).exists_bound_of_continuous
    (hψ.continuous_fderiv (𝕜 := ℝ) (by simp))
  refine ⟨⟨ψ, hψ, hψc, hψU, max 0 (max B G), le_max_left _ _, ?_, ?_⟩, rfl⟩
  · intro x _
    exact (hB x).trans (le_max_right 0 _ |>.trans' (le_max_left B G))
  · intro x _
    rw [norm_gradient_eq_norm_fderiv]
    exact (hG x).trans ((le_max_right B G).trans (le_max_right 0 _))

/-- Every compact local cutoff has zero trace on the same physical cap. -/
def localZeroDirichletSpace (μ : Measure E) [μ.IsAddHaarMeasure]
    (Ω U : Opens E) (p : ℝ≥0∞) [Fact (1 ≤ p)] : ClosedSubmodule ℝ (W1p μ Ω p) :=
  ⨅ D : LocalDirichletCutoff Ω U,
    (w1p0Submodule μ Ω p).comap (D.mulL (μ := μ) (p := p))

without_proof_info in
theorem mem_localZeroDirichletSpace_iff (u : W1p μ Ω p) :
    u ∈ localZeroDirichletSpace μ Ω U p ↔
      ∀ D : LocalDirichletCutoff Ω U, D.mulL (μ := μ) (p := p) u ∈ w1p0Submodule μ Ω p := by
  simp [localZeroDirichletSpace, ClosedSubmodule.mem_comap]

/-- The bounded weak energy form vanishes against every zero-trace test. -/
def localHomogeneousDirichletSpace
    (L : W1p μ Ω p →L[ℝ] W1p μ Ω p →L[ℝ] ℝ) (U : Opens E) :
    ClosedSubmodule ℝ (W1p μ Ω p) :=
  localZeroDirichletSpace μ Ω U p ⊓
    ⨅ v : W1p0 μ Ω p,
      (⟨(L.flip v.val).ker, (L.flip v.val).isClosed_ker⟩ : ClosedSubmodule ℝ (W1p μ Ω p))

without_proof_info in
theorem mem_localHomogeneousDirichletSpace_iff
    (L : W1p μ Ω p →L[ℝ] W1p μ Ω p →L[ℝ] ℝ) (u : W1p μ Ω p) :
    u ∈ localHomogeneousDirichletSpace L U ↔
      u ∈ localZeroDirichletSpace μ Ω U p ∧ ∀ v : W1p0 μ Ω p, L u v.val = 0 := by
  simp [localHomogeneousDirichletSpace, LinearMap.mem_ker]

without_proof_info in
/-- Recover the ordinary existential cutoff-trace interface used by the
relative boundary regularity proof, from the complete closed subspace. -/
theorem localZeroDirichletSpace.cutoff_zeroTrace
    (u : localZeroDirichletSpace μ Ω U p)
    (ψ : E → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ) (hψU : tsupport ψ ⊆ U) :
    ∃ v : W1p0 μ Ω p, W1p.value v.val =ᵐ[μ.restrict Ω]
      fun x => ψ x * W1p.value u.val x := by
  obtain ⟨D, hD⟩ := exists_localDirichletCutoff (Ω := Ω) ψ hψ hψc hψU
  have hmem := (mem_localZeroDirichletSpace_iff u.val).mp u.property D
  refine ⟨⟨D.mulL (μ := μ) (p := p) u.val, hmem⟩, ?_⟩
  have h := W1p.value_contDiffSMul_ae D.smooth D.bound_nonneg D.value_bound D.gradient_bound u.val
  filter_upwards [h] with x hx
  simpa only [LocalDirichletCutoff.mulL, W1p.contDiffSMulL_apply, hD, smul_eq_mul] using hx

end ConformalPoisson

end ProofPart_GreenTrace_LocalHomogeneousDirichletSpace

/- Green/trace proof support: BoundedLocalBoundaryRegularity.lean, SHA256 8ced899430fe5ab1c0e8643910c509515b74298828e4681048e94954f3105080 -/
noncomputable section ProofPart_GreenTrace_BoundedLocalBoundaryRegularity



/- Qualitative relative-boundary elliptic regularity yields a BOUNDED
higher-order reading on the complete local homogeneous zero-Dirichlet
space. The only analytical producer is the earlier proved relative
boundary theorem; this is its closed-graph quantitative consequence. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal NNReal InnerProductSpace Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
variable {Ω U V : Opens (EuclideanSpace ℝ (Fin (n + 1)))} {S K : Set (EuclideanSpace ℝ (Fin (n + 1)))}
  {a : (EuclideanSpace ℝ (Fin (n + 1))) → Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ}
  {b : (EuclideanSpace ℝ (Fin (n + 1))) → (EuclideanSpace ℝ (Fin (n + 1)))} {c : (EuclideanSpace ℝ (Fin (n + 1))) → ℝ} {lam Lam : ℝ} {C : ℝ≥0}

set_option autoImplicit false in
set_option maxHeartbeats 1000000 in
without_proof_info in
public theorem exists_bounded_relative_boundary_higher_reading
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ K) (hΩS : (Ω : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ interior S)
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set (EuclideanSpace ℝ (Fin (n + 1)))) ∩ U ⊆ Ω)
    (ha : UniformlyEllipticOn (Ω : Set (EuclideanSpace ℝ (Fin (n + 1)))) a lam Lam)
    (hLip : LipschitzOnWith C (fun x => matrixBilinearForm (a x)) Ω)
    (hsmooth : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S)
    (ha0 : ∀ x ∈ S, a x 0 0 ≠ 0)
    (hcoeff : MemLp (fun x => energyIntegrand (a x) (b x) (c x)) ⊤ (μ.restrict Ω))
    (hprincipal : MemLp (fun x => energyIntegrand (a x) 0 0) ⊤ (μ.restrict Ω))
    (hb : ContDiffOn ℝ ∞ b S) (hc : ContDiffOn ℝ ∞ c S)
    (k : ℕ) (hV : IsCompact (closure (V : Set (EuclideanSpace ℝ (Fin (n + 1)))))) (hVU : closure (V : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ U) :
    ∃ T : ↥(localHomogeneousDirichletSpace (energyFormH1L hcoeff) U) →L[ℝ]
        Wkp μ (Ω ⊓ V) 2 (k + 2),
      ∀ u : ↥(localHomogeneousDirichletSpace (energyFormH1L hcoeff) U),
        Wkp.value (k + 2) (T u) = W1p.value
        (W1p.restrictL (inf_le_left : Ω ⊓ V ≤ Ω) u.val) := by
  let X := localHomogeneousDirichletSpace (energyFormH1L hcoeff) U
  let sub : X →L[ℝ] W1p μ Ω 2 := X.toSubmodule.subtypeL
  let A : X →L[ℝ] Lp ℝ 2 (μ.restrict (Ω ⊓ V : Set (EuclideanSpace ℝ (Fin (n + 1))))) :=
    W1p.valueL.comp ((W1p.restrictL (inf_le_left : Ω ⊓ V ≤ Ω)).comp sub)
  let B : Wkp μ (Ω ⊓ V) 2 (k + 2) →L[ℝ] Lp ℝ 2 (μ.restrict (Ω ⊓ V : Set (EuclideanSpace ℝ (Fin (n + 1))))) :=
    Wkp.valueL (k + 2)
  have hBvalue (w : Wkp μ (Ω ⊓ V) 2 (k + 2)) : B w = Wkp.value (k + 2) w := by
