    by_cases hl : l ≤ R
    · simpa only [if_pos hl] using B.inverse_symm l i j y hy
    · simp only [if_neg hl]
  normalDrift_smooth l := by
    by_cases hl : l ≤ R
    · simpa only [if_pos hl] using B.normalDrift_smooth l
    · simpa only [if_neg hl] using (contDiffOn_const : ContDiffOn ℝ ∞ (fun _ : Y => (0 : ℂ)) U)
