      -ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) := by
  obtain ⟨L, hL⟩ := exists_simultaneous_continuous_ordinary_jet_functional g points ℓ
  rw [G.greenJetSection_normal_chart_read g q ν S points hpoints ℓ L hL y]
