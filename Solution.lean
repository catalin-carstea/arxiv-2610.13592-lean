noncomputable section ProofPart_BallClassicalDirichlet




/- Actual classical zero-Dirichlet existence on the unit ball for
Holder forcing. The result is C2 in the interior and continuous on
the closed ball. The global Holder Hessian is a separate obligation. -/
open Set Metric Filter Topology TauCeti
open scoped NNReal ContDiff Laplacian
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
/-- The canonical closed-ball forcing has its original Holder bound. -/
theorem holderOnWith_domainRead_closedBall
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) :
    HolderOnWith ‖f‖₊ α (domainRead (closedBall 0 1) f) (closedBall 0 1) := by
  intro x hx y hy
  rw [domainRead_of_mem _ _ hx, domainRead_of_mem _ _ hy]
  exact f.holderWith_nnnorm ⟨x, hx⟩ ⟨y, hy⟩

without_proof_info in
/-- This is genuine existence for the actual forcing, without a
boundary Hessian regularity or inverse premise. -/
theorem exists_ball_classical_zeroDirichlet (hα : 0 < α) (hαlt : α < 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) :
    ∃ u : V → ℝ, ContDiffOn ℝ 2 u (ball 0 1) ∧
      ContinuousOn u (closedBall 0 1) ∧ EqOn u 0 (sphere 0 1) ∧
      (∀ x ∈ ball 0 1, -Δ u x = domainRead (closedBall 0 1) f x) := by
  let F : V → ℝ := domainRead (closedBall 0 1) f
  have hF : HolderOnWith ‖f‖₊ α F (closedBall 0 1) := holderOnWith_domainRead_closedBall f
  have hbound : Bornology.IsBounded ((-F) '' ball 0 1) := by
    apply (isBounded_closedBall (x := (0 : ℝ)) (r := ‖f‖)).subset
    rintro y ⟨x, hx, rfl⟩
    rw [mem_closedBall_zero_iff]
    change ‖-F x‖ ≤ ‖f‖
    rw [norm_neg, show F x = f ⟨x, ball_subset_closedBall hx⟩ from
      domainRead_of_mem _ _ (ball_subset_closedBall hx)]
    exact f.norm_apply_le _
  have hlocal : ∀ x ∈ ball (0 : V) 1, ∃ T ∈ 𝓝 x, ∃ K : ℝ≥0,
      HolderOnWith K α (-F) T := by
    intro x hx
    refine ⟨ball 0 1, isOpen_ball.mem_nhds hx, ‖f‖₊, ?_⟩
    intro y hy z hz
    simpa only [Pi.neg_apply, edist_neg_neg] using
      hF y (ball_subset_closedBall hy) z (ball_subset_closedBall hz)
  obtain ⟨w, hw, hwc, hΔw⟩ := PDE.exists_contDiffOn_continuousOn_closure_laplacian_eq
    hα hαlt isOpen_ball isBounded_ball hbound hlocal
  rw [closure_ball (0 : V) (by norm_num : (1 : ℝ) ≠ 0)] at hwc
  obtain ⟨h, hh, hhc, hhw⟩ := exists_harmonicOnNhd_ball_continuousOn_closedBall_eqOn_sphere
    (hwc.mono sphere_subset_closedBall)
  refine ⟨w - h, hw.sub hh.contDiffOn, hwc.sub hhc, ?_, ?_⟩
  · intro x hx
    simp only [Pi.sub_apply, hhw hx, sub_self, Pi.zero_apply]
  · intro x hx
    rw [(hw.contDiffAt (isOpen_ball.mem_nhds hx)).laplacian_sub (hh x hx).1,
      hΔw x hx, (hh x hx).2.self_of_nhds]
    simp only [Pi.zero_apply, sub_zero, Pi.neg_apply, neg_neg]
    rfl
end ConformalPoisson.DirichletHolder

