without_proof_info in
theorem norm_coordinate_word_le_of_mixed_bounds
    {S : Set V} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : V → F} (hf : ContDiffOn ℝ ∞ f S) {x : V} (hx : x ∈ S)
    {M B C : ℝ} (hM : 0 ≤ M) (hB : 0 ≤ B) (hC : 0 ≤ C) (hBC : B ≤ C)
    (hbound : ∀ p j, ‖mixedDerivativeWithin S boundaryTangentialProjection e p j f x‖ ≤
      M * B ^ p * C ^ j * ((p + j).factorial : ℝ))
    (is : List (Fin (n + 1))) :
    ‖iteratedFDerivWithinAlong S (is.map (fun i => (EuclideanSpace.single i 1 : V))) f x‖ ≤
      M * C ^ is.length * (is.length.factorial : ℝ) := by
  classical
  let b : Fin (n + 1) → V := fun i => EuclideanSpace.single i 1
  let pred : Fin (n + 1) → Bool := fun i => decide (i ≠ 0)
