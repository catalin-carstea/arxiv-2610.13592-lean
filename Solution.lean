theorem remainder_homogeneous (b : ℕ → NativeSymbol n) (r : ℕ)
    (hA : ∀ p ≤ r, SymbolContMDiffOn S ω (b p))
    (hb : ∀ p ≤ r, Homogeneous S (1 - (p : ℤ)) (b p)) :
    Homogeneous S (1 - (r : ℤ)) (symbolCompositionRemainder b r) := by
  unfold symbolCompositionRemainder
  apply homogeneous_sum
  intro p hp
  apply homogeneous_sum
  intro q hq
  have hpr : p ≤ r := Nat.le_of_lt_succ (Finset.mem_range.mp hp)
  have hqr : q ≤ r := Nat.le_of_lt_succ (Finset.mem_range.mp hq)
  by_cases hpq : p + q ≤ r + 1
  · simp only [ite_eq_left hpq]
    apply homogeneous_sum
    intro α hα
    have hαsum : (∑ i, (α i : ℤ)) = ((r + 1 - (p + q) : ℕ) : ℤ) := by
      exact_mod_cast Finset.Nat.mem_antidiagonalTuple.mp hα
    have hdeg : (1 - (p : ℤ) - ∑ i, (α i : ℤ)) + (1 - (q : ℤ)) = 1 - (r : ℤ) := by
      rw [hαsum, Nat.cast_sub hpq]
      push_cast
      ring
    have hf := homogeneous_multi_frequency (hA p hpr) (hb p hpr) α
    have hg := homogeneous_multi_preserved symbolBaseDeriv
      (fun i b hb => modelDeriv_homogeneous hb
        (euclideanHalfSpaceBoundaryParam n (EuclideanSpace.single i 1))) α (hb q hqr)
    have h := homogeneous_const_mul (homogeneous_mul hf hg)
      (((-Complex.I) ^ (∑ i, α i)) / ((∏ i, Nat.factorial (α i) : ℕ) : ℂ))
    simpa only [hdeg, mul_assoc] using h
  · simp only [ite_eq_right hpq]
    exact homogeneous_zero _


