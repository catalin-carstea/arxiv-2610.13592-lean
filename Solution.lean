def nativeDiffeomorphOfPartial
    (F : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (U : TopologicalSpace.Opens M₁) (V : TopologicalSpace.Opens M₂)
