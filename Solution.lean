theorem boundary_function_directional_eq
    {f g : EuclideanHalfSpace (n + 1) → F}
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W)
    (he : EqOn (f ∘ EuclideanHalfSpace.boundaryParam n)
      (g ∘ EuclideanHalfSpace.boundaryParam n) W)
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W)
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f (EuclideanHalfSpace.boundaryParam n x))
    (hg : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω g (EuclideanHalfSpace.boundaryParam n x))
