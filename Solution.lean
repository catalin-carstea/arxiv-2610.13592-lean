    boundaryOddReflection u =ᶠ[𝓝 x] u := by
  have hc : Continuous (fun y : V => y 0) :=
    (PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0 : V →L[ℝ] ℝ).continuous
  filter_upwards [(isOpen_lt continuous_const hc).mem_nhds hx] with y hy
