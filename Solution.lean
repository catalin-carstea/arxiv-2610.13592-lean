theorem NativeClassicalValueKernel.symmetric_interior
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
    {K : NativeInverseLpRowFamily g q s} (G : NativeClassicalValueKernel K)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hp : p ≠ (⊤ : ℝ≥0∞)) (x z : M)
    (hx : (Ihalf).IsInteriorPoint x) (hz : (Ihalf).IsInteriorPoint z) (hxz : x ≠ z) :
    G.kernel x z = G.kernel z x := by
  let W : Opens M := ⟨(Ihalf).interior M \ {z},
