/- The first possible nonzero normal jet of a bilinear product. These
finite Leibniz identities isolate the positive square used in the
project analytic no-escape normal-jet induction. -/
open Set
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {F₁ F₂ F₃ : Type*}
  [NormedAddCommGroup F₁] [NormedSpace ℝ F₁]
  [NormedAddCommGroup F₂] [NormedSpace ℝ F₂]
  [NormedAddCommGroup F₃] [NormedSpace ℝ F₃]

without_proof_info in
theorem bilinear_binomial_zero_below (B : F₁ →L[ℝ] F₂ →L[ℝ] F₃)
    (a : ℕ → F₁) (b : ℕ → F₂) (m l k : ℕ)
    (ha : ∀ i < m, a i = 0) (hb : ∀ i < l, b i = 0) (hk : k < m + l) :
    (∑ i ∈ Finset.range (k + 1), k.choose i • B (a i) (b (k - i))) = 0 := by
  apply Finset.sum_eq_zero
  intro i hi
  have hi' : i ≤ k := by have := Finset.mem_range.mp hi; omega
  by_cases him : i < m
  · simp [ha i him]
  · have hbl : k - i < l := by omega
    simp [hb (k - i) hbl]

without_proof_info in
theorem bilinear_binomial_first (B : F₁ →L[ℝ] F₂ →L[ℝ] F₃)
    (a : ℕ → F₁) (b : ℕ → F₂) (m l : ℕ)
    (ha : ∀ i < m, a i = 0) (hb : ∀ i < l, b i = 0) :
    (∑ i ∈ Finset.range (m + l + 1), (m + l).choose i • B (a i) (b (m + l - i))) =
      (m + l).choose m • B (a m) (b l) := by
  rw [Finset.sum_eq_single m]
  · simp only [Nat.add_sub_cancel_left]
  · intro i hi him
    have hi' : i ≤ m + l := by have := Finset.mem_range.mp hi; omega
    by_cases hilt : i < m
    · simp [ha i hilt]
    · have hbl : m + l - i < l := by omega
      simp [hb (m + l - i) hbl]
  · intro hnot
    exact False.elim (hnot (Finset.mem_range.mpr (by omega)))

variable {n : ℕ} {f : EuclideanHalfSpace (n + 1) → F₁}
    {g : EuclideanHalfSpace (n + 1) → F₂} {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : IsOpen S)
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F₁) ∞ f S)
    (hg : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F₂) ∞ g S)
    (B : F₁ →L[ℝ] F₂ →L[ℝ] F₃) {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S)

include hS hf hg hz

without_proof_info in
theorem normalJet_bilinear_zero_below (m l k : ℕ)
    (ha : ∀ i < m, normalJet i f z = 0) (hb : ∀ i < l, normalJet i g z = 0)
    (hk : k < m + l) : normalJet k (fun y => B (f y) (g y)) z = 0 := by
  rw [normalJet_bilinear_eqOn B hS hf hg k hz]
  exact bilinear_binomial_zero_below B _ _ m l k ha hb hk

without_proof_info in
theorem normalJet_bilinear_first (m l : ℕ)
    (ha : ∀ i < m, normalJet i f z = 0) (hb : ∀ i < l, normalJet i g z = 0) :
    normalJet (m + l) (fun y => B (f y) (g y)) z =
      (m + l).choose m • B (normalJet m f z) (normalJet l g z) := by
  rw [normalJet_bilinear_eqOn B hS hf hg (m + l) hz]
  exact bilinear_binomial_first B _ _ m l ha hb
end ConformalPoisson

end ProofPart_LowestBilinearJets

/- Proof support: LowestQuadraticJet.lean, SHA256 3f9a792a286154b1158aa583bd64fe9f1b166411aab471d83849b290f3608f20 -/
noncomputable section ProofPart_LowestQuadraticJet


/- With arbitrary smooth coefficients, the first quadratic normal jet
is a positive binomial multiple of the square of the first vector jet.
Coefficient derivatives disappear because both vector factors vanish
to the same lower order. -/
open Set
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {A F V : Type*}
  [NormedAddCommGroup A] [NormedSpace ℝ A]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup V] [NormedSpace ℝ V]
  {a : EuclideanHalfSpace (n + 1) → A} {t : EuclideanHalfSpace (n + 1) → F}
  {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
  (ha : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, A) ∞ a S)
  (ht : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ t S)
  (C : A →L[ℝ] F →L[ℝ] V) (D : V →L[ℝ] F →L[ℝ] ℝ)
  {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S)
include hS ha ht hz

without_proof_info in
theorem normalJet_variable_quadratic_first (m : ℕ)
    (hlow : ∀ i < m, normalJet i t z = 0) :
    normalJet (m + m) (fun y => D (C (a y) (t y)) (t y)) z =
      (m + m).choose m • D (C (a z) (normalJet m t z)) (normalJet m t z) := by
  have hP := normalBilinear_contMDiffOn C ha ht
  have hPlow : ∀ i < m, normalJet i (fun y => C (a y) (t y)) z = 0 := by
    intro i hi
    exact normalJet_bilinear_zero_below hS ha ht C hz 0 m i
      (fun j hj => by omega) hlow (by omega)
  have hPm : normalJet m (fun y => C (a y) (t y)) z = C (a z) (normalJet m t z) := by
    simpa only [Nat.zero_add, Nat.choose_zero_right, one_nsmul, normalJet_zero] using
      normalJet_bilinear_first hS ha ht C hz 0 m (fun j hj => by omega) hlow
  rw [normalJet_bilinear_first hS hP ht D hz m m hPlow hlow, hPm]

without_proof_info in
theorem normalJet_variable_quadratic_zero_below (m k : ℕ)
    (hlow : ∀ i < m, normalJet i t z = 0) (hk : k < m + m) :
    normalJet k (fun y => D (C (a y) (t y)) (t y)) z = 0 := by
  have hP := normalBilinear_contMDiffOn C ha ht
  have hPlow : ∀ i < m, normalJet i (fun y => C (a y) (t y)) z = 0 := by
    intro i hi
    exact normalJet_bilinear_zero_below hS ha ht C hz 0 m i
      (fun j hj => by omega) hlow (by omega)
  exact normalJet_bilinear_zero_below hS hP ht D hz m m k hPlow hlow hk
end ConformalPoisson

end ProofPart_LowestQuadraticJet

/- Proof support: WeakConformalJetStep.lean, SHA256 0c0b72d7574d9220340ebf185246bb6855cad0b9a0a8e58548fc02cef4db3225 -/
noncomputable section ProofPart_WeakConformalJetStep


/- A positive weak-conformality diagonal identity forces the next
normal vector jet to vanish. This remains valid for a potentially
degenerate map differential; no inverse or metric pullback is assumed. -/
open Set
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {A F V : Type*}
  [NormedAddCommGroup A] [NormedSpace ℝ A]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

without_proof_info in
theorem weakConformal_normalJet_step
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    {a : EuclideanHalfSpace (n + 1) → A}
    {t w : EuclideanHalfSpace (n + 1) → F} {b d : EuclideanHalfSpace (n + 1) → ℝ}
    (ha : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, A) ∞ a S)
    (ht : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ t S)
    (hw : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ w S)
    (hb : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ b S)
    (hd : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ d S)
    (C : A →L[ℝ] F →L[ℝ] V) (D : V →L[ℝ] F →L[ℝ] ℝ)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S)
    (hbpos : 0 < b z) (hpositive : ∀ v : F, D (C (a z) v) v = 0 → v = 0)
    (heq : EqOn (fun y => b y * D (C (a y) (t y)) (t y))
      (fun y => d y * D (C (a y) (w y)) (w y)) S)
    (m : ℕ) (htlow : ∀ i < m, normalJet i t z = 0)
    (hwlow : ∀ i ≤ m, normalJet i w z = 0) : normalJet m t z = 0 := by
  let qt := fun y => D (C (a y) (t y)) (t y)
  let qw := fun y => D (C (a y) (w y)) (w y)
  have hqt := normalBilinear_contMDiffOn D (normalBilinear_contMDiffOn C ha ht) ht
  have hqw := normalBilinear_contMDiffOn D (normalBilinear_contMDiffOn C ha hw) hw
  have hqtlow : ∀ i < m + m, normalJet i qt z = 0 := fun i hi =>
    normalJet_variable_quadratic_zero_below hS ha ht C D hz m i htlow hi
  have hqwlow : ∀ i < (m + 1) + (m + 1), normalJet i qw z = 0 := fun i hi =>
    normalJet_variable_quadratic_zero_below hS ha hw C D hz (m + 1) i
      (fun j hj => hwlow j (by omega)) hi
  have hleft := normalJet_bilinear_first hS hb hqt (ContinuousLinearMap.mul ℝ ℝ) hz
    0 (m + m) (fun i hi => by omega) hqtlow
  have hright := normalJet_bilinear_zero_below hS hd hqw (ContinuousLinearMap.mul ℝ ℝ) hz
    0 ((m + 1) + (m + 1)) (m + m) (fun i hi => by omega) hqwlow (by omega)
  simp only [ContinuousLinearMap.mul_apply'] at hright
  have hjet := normalJet_eqOn hS heq (m + m) hz
  rw [hright] at hjet
  have htop := normalJet_variable_quadratic_first hS ha ht C D hz m htlow
  have hleft' : normalJet (m + m) (fun y => b y * qt y) z =
      b z * ((m + m).choose m • D (C (a z) (normalJet m t z)) (normalJet m t z)) := by
    simpa only [Nat.zero_add, Nat.choose_zero_right, one_nsmul, normalJet_zero,
      ContinuousLinearMap.mul_apply', htop] using hleft
  change normalJet (m + m) (fun y => b y * qt y) z = 0 at hjet
  rw [hleft'] at hjet
  have hqzero : D (C (a z) (normalJet m t z)) (normalJet m t z) = 0 := by
    have hchoose : 0 < (m + m).choose m := Nat.choose_pos (by omega)
    have hc : ((m + m).choose m : ℝ) ≠ 0 := (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hchoose))
    have hproduct := (mul_eq_zero.mp hjet).resolve_left hbpos.ne'
    simpa only [nsmul_eq_mul, mul_eq_zero, hc, false_or] using hproduct
  exact hpositive _ hqzero
end ConformalPoisson

end ProofPart_WeakConformalJetStep

/- Proof support: WeakConformalAnalyticRigidity.lean, SHA256 1beec69f0ede1b52d6d7d93965bebf0ac8d164a376b5a5e1ed76ab5c3d38629a -/
noncomputable section ProofPart_WeakConformalAnalyticRigidity




/- Analytic weak conformality cannot collapse an open boundary patch
without collapsing a germ. Fixed-patch strong induction proves all
normal jet FUNCTIONS vanish; no intersection of infinitely many germs. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {A F V : Type*}
  [NormedAddCommGroup A] [NormedSpace ℝ A]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

without_proof_info in
theorem weakConformal_analytic_zero_germ
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    {f : EuclideanHalfSpace (n + 1) → F}
    {a : EuclideanHalfSpace (n + 1) → A} {b d : EuclideanHalfSpace (n + 1) → ℝ}
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f S)
    (ha : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, A) ∞ a S)
    (hb : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ b S)
    (hd : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ d S)
    (C : A →L[ℝ] F →L[ℝ] V) (D : V →L[ℝ] F →L[ℝ] ℝ)
    (v : EuclideanSpace ℝ (Fin n))
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hbpos : ∀ y ∈ W, 0 < b (EuclideanHalfSpace.boundaryParam n y))
    (hpositive : ∀ y ∈ W, ∀ u : F,
      D (C (a (EuclideanHalfSpace.boundaryParam n y)) u) u = 0 → u = 0)
    (hzero : ∀ y ∈ W, f (EuclideanHalfSpace.boundaryParam n y) = 0)
    (heq : EqOn
      (fun z => b z * D (C (a z) (normalDeriv f z)) (normalDeriv f z))
      (fun z => d z * D (C (a z)
        (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f z))
        (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f z)) S)
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W) :
    f =ᶠ[𝓝 (EuclideanHalfSpace.boundaryParam n x)] 0 := by
  have hT : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ (normalDeriv f) S :=
    normalJet_contMDiffOn hS (hf.of_le le_top) 1
  have hWf := (modelDirectionalDeriv_analyticOn (𝓡∂ (n + 1))
    (euclideanHalfSpaceBoundaryParam n v) hS hf).of_le (le_top : (∞ : ℕ∞ω) ≤ ω)
  have hj : ∀ k : ℕ, ∀ y ∈ W, normalJet k f (EuclideanHalfSpace.boundaryParam n y) = 0 := by
    intro k
    induction k using Nat.strong_induction_on with
    | ind k ih =>
      intro y hy
      cases k with
      | zero => exact hzero y hy
      | succ m =>
        have hTlow : ∀ i < m, normalJet i (normalDeriv f) (EuclideanHalfSpace.boundaryParam n y) = 0 := by
          intro i hi
          rw [← normalJet_succ']
          exact ih (i + 1) (by omega) y hy
        have hWlow : ∀ i ≤ m,
            normalJet i (modelDirectionalDeriv (𝓡∂ (n + 1))
              (euclideanHalfSpaceBoundaryParam n v) f) (EuclideanHalfSpace.boundaryParam n y) = 0 := by
          intro i hi
          rw [normalJet_directional_comm_eqOn _ hS hf i (hWS hy)]
          have he : EqOn ((normalJet i f) ∘ EuclideanHalfSpace.boundaryParam n)
              ((fun _ : EuclideanHalfSpace (n + 1) => (0 : F)) ∘ EuclideanHalfSpace.boundaryParam n) W :=
            fun z hz => ih i (by omega) z hz
          have hfun := boundary_function_directional_eq hW he hy
            (((normalJet_analyticOn hS hf i) _ (hWS hy)).contMDiffAt (hS.mem_nhds (hWS hy)))
            contMDiffAt_const v
          change modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v)
            (normalJet i f) (EuclideanHalfSpace.boundaryParam n y) = _ at hfun
          have hz0 : modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v)
              (fun _ : EuclideanHalfSpace (n + 1) => (0 : F))
              (EuclideanHalfSpace.boundaryParam n y) = 0 := by
            unfold modelDirectionalDeriv
            rw [mvfderiv_const]
            rfl
          exact hfun.trans hz0
        have hstep := weakConformal_normalJet_step hS ha hT hWf hb hd C D (hWS hy)
          (hbpos y hy) (hpositive y hy) heq m hTlow hWlow
        simpa only [← normalJet_succ'] using hstep
  exact native_analytic_eventually_zero_of_normalJets
    ((hf _ (hWS hx)).contMDiffAt (hS.mem_nhds (hWS hx))) hW hx hj
end ConformalPoisson

end ProofPart_WeakConformalAnalyticRigidity

/- Proof support: WeakConformalConstantGerm.lean, SHA256 e31229c6815b04a62f3ee1b6f7e1583ef1031ca52cf315ef2efc52a08838faf9 -/
noncomputable section ProofPart_WeakConformalConstantGerm



/- The actual zero boundary differential supplies the constant face
value for analytic weak-conformal rigidity. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {A F V : Type*}
  [NormedAddCommGroup A] [NormedSpace ℝ A]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  [NormedAddCommGroup V] [NormedSpace ℝ V]

without_proof_info in
theorem weakConformal_analytic_constant_germ
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    {f : EuclideanHalfSpace (n + 1) → F}
    {a : EuclideanHalfSpace (n + 1) → A} {b d : EuclideanHalfSpace (n + 1) → ℝ}
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f S)
    (ha : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, A) ∞ a S)
    (hb : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ b S)
    (hd : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ d S)
    (C : A →L[ℝ] F →L[ℝ] V) (D : V →L[ℝ] F →L[ℝ] ℝ)
    (v : EuclideanSpace ℝ (Fin n))
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W) (hconn : IsPreconnected W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hbpos : ∀ y ∈ W, 0 < b (EuclideanHalfSpace.boundaryParam n y))
    (hpositive : ∀ y ∈ W, ∀ u : F,
      D (C (a (EuclideanHalfSpace.boundaryParam n y)) u) u = 0 → u = 0)
    (hdf : ∀ y ∈ W, mvfderiv (𝓡∂ (n + 1)) f (EuclideanHalfSpace.boundaryParam n y) = 0)
    (heq : EqOn
      (fun z => b z * D (C (a z) (normalDeriv f z)) (normalDeriv f z))
      (fun z => d z * D (C (a z)
        (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f z))
        (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f z)) S)
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W) :
    f =ᶠ[𝓝 (EuclideanHalfSpace.boundaryParam n x)] (fun _ => f (EuclideanHalfSpace.boundaryParam n x)) := by
  let f₀ : EuclideanHalfSpace (n + 1) → F :=
    fun z => f z - f (EuclideanHalfSpace.boundaryParam n x)
  have hf₀ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f₀ S := hf.sub contMDiffOn_const
  have hDf₀ {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) :
      mvfderiv (𝓡∂ (n + 1)) f₀ z = mvfderiv (𝓡∂ (n + 1)) f z := by
    change mvfderiv (𝓡∂ (n + 1))
      (f - (fun _ => f (EuclideanHalfSpace.boundaryParam n x))) z = _
    rw [mvfderiv_sub
      (((hf z hz).contMDiffAt (hS.mem_nhds hz)).mdifferentiableAt (by decide))
      mdifferentiableAt_const, mvfderiv_const, sub_zero]
  have hconst := native_boundary_constant_of_zero_differential hW hconn
    (fun y hy => (hf _ (hWS hy)).contMDiffAt (hS.mem_nhds (hWS hy))) hdf hx
  have hzero : ∀ y ∈ W, f₀ (EuclideanHalfSpace.boundaryParam n y) = 0 := by
    intro y hy
    exact sub_eq_zero.mpr (hconst y hy)
  have heq₀ : EqOn
      (fun z => b z * D (C (a z) (normalDeriv f₀ z)) (normalDeriv f₀ z))
      (fun z => d z * D (C (a z)
        (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f₀ z))
        (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f₀ z)) S := by
    intro z hz
    dsimp only [normalDeriv, modelDirectionalDeriv]
    rw [hDf₀ hz]
    exact heq hz
  have hgerm := weakConformal_analytic_zero_germ hS hf₀ ha hb hd C D v hW hWS
    hbpos hpositive hzero heq₀ hx
  filter_upwards [hgerm] with z hz
  exact sub_eq_zero.mp hz
end ConformalPoisson

end ProofPart_WeakConformalConstantGerm

/- Proof support: NativeWeakConformalRigidity.lean, SHA256 1a3bd0176fef514c0cf7f40c8c0dafc403126fb6e092236e112e103d4b4e5402 -/
noncomputable section ProofPart_NativeWeakConformalRigidity




/- Instantiate analytic rigidity with the ACTUAL original metric read
in one actual target chart, the ACTUAL coordinate differential of F,
and an ACTUAL nondegenerate chart on the source side. -/
open Bundle Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem native_weakConformal_constant_germ
    (g₁ : Metric (n := n) (M := M₁) ω) (g₂ : Metric (n := n) (M := M₂) ω)
    {U : Set (EuclideanHalfSpace (n + 1))} (hU : IsOpen U)
    {F : EuclideanHalfSpace (n + 1) → M₁}
    (hF : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω F U)
    (α : M₁) (htarget : MapsTo F U (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    (hUχ : U ⊆ χ.source) (v : EuclideanSpace ℝ (Fin n)) (hv : v ≠ 0)
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W) (hconn : IsPreconnected W)
    (hWU : MapsTo (EuclideanHalfSpace.boundaryParam n) W U)
    (hzero : ∀ y ∈ W, mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F
      (EuclideanHalfSpace.boundaryParam n y) = 0)
    (hdiag : ∀ z ∈ U,
      nativeMapPullbackPairing (g₁.ofLE (by decide)) F z
        (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) *
        nativeMapPullbackPairing (g₂.ofLE (by decide)) χ z
          (euclideanHalfSpaceBoundaryParam n v) (euclideanHalfSpaceBoundaryParam n v) =
      nativeMapPullbackPairing (g₁.ofLE (by decide)) F z
        (euclideanHalfSpaceBoundaryParam n v) (euclideanHalfSpaceBoundaryParam n v) *
        nativeMapPullbackPairing (g₂.ofLE (by decide)) χ z
          (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)))
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W) :
    F =ᶠ[𝓝 (EuclideanHalfSpace.boundaryParam n x)]
      (fun _ => F (EuclideanHalfSpace.boundaryParam n x)) := by
  let f := extChartAt (𝓡∂ (n + 1)) α ∘ F
