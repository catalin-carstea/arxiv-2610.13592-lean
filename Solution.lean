/- The actual potential formula extends from the dense interior of the
observed OPEN submanifold by continuity of its INTRINSIC operator.
The operator restriction theorem identifies the exact ambient extension. -/
open Bundle Set TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem GaugePair.potential_eq_of_interior
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (P : GaugePair (n := n) V₁ V₂) (g : Metric (n := n) (M := M₁)) (q₁ : M₁ → ℝ) (q₂ : M₂ → ℝ)
    (hq₁ : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q₁) (hq₂ : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q₂)
    (hinterior : ∀ x : observedDomain (𝓡∂ (n + 1)) V₁,
      x ∈ (𝓡∂ (n + 1)).interior (observedDomain (𝓡∂ (n + 1)) V₁) →
      q₂ (P.map x) = Real.rpow (P.multiplier x) (-((n + 1 : ℝ) + 2) / ((n + 1 : ℝ) - 2)) *
        schrodinger g q₁ (extendFromOpen (observedDomain (𝓡∂ (n + 1)) V₁) P.multiplier) x) :
    ∀ x : observedDomain (𝓡∂ (n + 1)) V₁,
      q₂ (P.map x) = Real.rpow (P.multiplier x) (-((n + 1 : ℝ) + 2) / ((n + 1 : ℝ) - 2)) *
        schrodinger g q₁ (extendFromOpen (observedDomain (𝓡∂ (n + 1)) V₁) P.multiplier) x := by
  let U := observedDomain (𝓡∂ (n + 1)) V₁
  let q : U → ℝ := fun x => q₁ x
  let s : ℝ := -((n + 1 : ℝ) + 2) / ((n + 1 : ℝ) - 2)
  have hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q := hq₁.comp contMDiff_subtype_val
  have hc : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ P.multiplier := P.analytic.of_le (by decide)
  have hmap : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ∞ (fun x : U => (P.map x : M₂)) :=
    contMDiff_subtype_val.comp (P.map.contMDiff.of_le (by decide))
  have hleft : Continuous (fun x : U => q₂ (P.map x)) := (hq₂.comp hmap).continuous
  have hright : Continuous (fun x : U => Real.rpow (P.multiplier x) s *
      schrodinger (g.restrictOpenTangentSpace U) q P.multiplier x) :=
    ((hc.rpow_const_of_ne (fun x => (P.positive x).ne') s).mul
      (contMDiff_schrodinger (g.restrictOpenTangentSpace U) q P.multiplier hq hc)).continuous
  have hL (x : U) : schrodinger (g.restrictOpenTangentSpace U) q P.multiplier x =
      schrodinger g q₁ (extendFromOpen U P.multiplier) x := by
    have h := schrodinger_restrictOpen g U q₁ (extendFromOpen U P.multiplier) x
      ((contMDiffAt_extendFromOpen U P.multiplier P.analytic x).of_le (by decide : (2 : ℕ∞ω) ≤ ω))
    have heq : (fun y : U => extendFromOpen U P.multiplier y) = P.multiplier :=
      funext (extendFromOpen_apply U P.multiplier)
    rw [heq] at h
    exact h
  have heq := Continuous.ext_on (dense_nativeInterior (n := n) (M := U)) hleft hright (fun x hx => by
    change q₂ (P.map x) = Real.rpow (P.multiplier x) s *
      schrodinger (g.restrictOpenTangentSpace U) q P.multiplier x
    rw [hL x]
    exact hinterior x hx)
  intro x
  have h := congrFun heq x
  change q₂ (P.map x) = Real.rpow (P.multiplier x) s *
    schrodinger (g.restrictOpenTangentSpace U) q P.multiplier x at h
  rw [hL x] at h
  exact h
end ConformalPoisson

