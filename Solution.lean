noncomputable section ProofPart_FiniteJetCutoffs




/- Smooth compact interior extensions of finitely many local solution germs.
The forcing of the extension is supported away from all prescribed points. -/
open Set Filter Bundle
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem schrodinger_zero (g : Metric (n := n) (M := M)) (q : M → ℝ) (x : M) :
    schrodinger g q (0 : M → ℝ) x = 0 := by
  let : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1
      (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (n' := 1) (by decide)
  simp [schrodinger]

without_proof_info in
theorem tsupport_schrodinger_subset (g : Metric (n := n) (M := M)) (q w : M → ℝ)
    (hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w) :
    tsupport (schrodinger g q w) ⊆ tsupport w := by
  apply closure_minimal ?_ (isClosed_tsupport w)
  intro x hx
  by_contra hnot
  have h := schrodinger_eq_of_eventuallyEq g q (hw.of_le (by decide)).contMDiffAt
    (contMDiffAt_const (c := (0 : ℝ))) (notMem_tsupport_iff_eventuallyEq.mp hnot)
  exact hx (h.trans (schrodinger_zero g q x))

without_proof_info in
theorem exists_compact_interior_extension_of_local_germs [CompactSpace M]
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (U : Fin N → TopologicalSpace.Opens M) (hpointU : ∀ i, points i ∈ U i)
    (hU : ∀ i, (U i : Set M) ⊆ (𝓡∂ (n + 1)).interior M)
    (v : Fin N → M → ℝ)
    (hv : ∀ i, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (v i) (U i)) :
    ∃ w : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w ∧
      HasCompactSupport w ∧ tsupport w ⊆ (𝓡∂ (n + 1)).interior M ∧
      ∀ i, w =ᶠ[𝓝 (points i)] v i := by
  classical
  let : SecondCountableTopology (EuclideanHalfSpace (n + 1)) :=
    inferInstanceAs (SecondCountableTopology {x : EuclideanSpace ℝ (Fin (n + 1)) // 0 ≤ x 0})
  let : SecondCountableTopology M :=
    ChartedSpace.secondCountable_of_sigmaCompact (EuclideanHalfSpace (n + 1)) M
  let O (i : Fin N) : Set M := (U i : Set M) \ points '' {i}ᶜ
  have hO (i : Fin N) : IsOpen (O i) :=
    (U i).isOpen.inter (((Set.toFinite _).image points).isClosed.isOpen_compl)
  have hpO (i : Fin N) : points i ∈ O i := by
    refine ⟨hpointU i, ?_⟩
    rintro ⟨j, hj, heq⟩
    exact hj (hinj heq)
  choose χ hχ hχone hχcompact hχsupp hχrange using fun i =>
    (isCompact_singleton (x := points i)).exists_contMDiff_one_nhds_tsupport_subset
      (𝓡∂ (n + 1)) (hO i) (singleton_subset_iff.mpr (hpO i))
  let a (i : Fin N) : M → ℝ := χ i * v i
  have ha (i : Fin N) : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (a i) := by
    apply contMDiff_of_tsupport
    intro x hx
    have hxU := (hχsupp i (tsupport_mul_subset_left hx)).1
    exact (hχ i x).mul ((hv i x hxU).contMDiffAt ((U i).isOpen.mem_nhds hxU))
  let w : M → ℝ := fun x => ∑ i, a i x
  have hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w :=
    ContMDiff.sum fun i _ => ha i
  let K : Set M := ⋃ i, tsupport (χ i)
  have hK : IsCompact K := isCompact_iUnion hχcompact
  have hwK : tsupport w ⊆ K := by
    apply closure_minimal ?_ hK.isClosed
    intro x hx
    by_contra hxK
    have hz : ∀ i, χ i x = 0 := fun i => image_eq_zero_of_notMem_tsupport
      (fun hi => hxK (mem_iUnion.mpr ⟨i, hi⟩))
    apply hx
    simp [w, a, hz]
  refine ⟨w, hw, hK.of_isClosed_subset (isClosed_tsupport w) hwK,
    fun x hx => ?_, ?_⟩
  · obtain ⟨i, hi⟩ := mem_iUnion.mp (hwK hx)
    exact hU i (hχsupp i hi).1
  · intro i
    have hterms : ∀ j, a j =ᶠ[𝓝 (points i)] (if j = i then v i else 0) := by
      intro j
      by_cases hji : j = i
      · subst j
        have h1 : χ i =ᶠ[𝓝 (points i)] (fun _ => 1) := by
          change ∀ᶠ x in 𝓝 (points i), χ i x = 1
          simpa only [nhdsSet_singleton] using hχone i
        filter_upwards [h1] with x hx
        simp [a, hx]
      · have hnot : points i ∉ tsupport (χ j) := by
          intro h
          exact (hχsupp j h).2 ⟨i, Ne.symm hji, rfl⟩
        filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hnot] with x hx
        simp [a, hx, hji]
    filter_upwards [Filter.eventually_all.mpr hterms] with x hx
    simp only [w]
    simp_rw [hx]
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hji
      simp [hji]
    · simp

without_proof_info in
theorem exists_compact_local_solution_extension [CompactSpace M]
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (U : Fin N → TopologicalSpace.Opens M) (hpointU : ∀ i, points i ∈ U i)
    (hU : ∀ i, (U i : Set M) ⊆ (𝓡∂ (n + 1)).interior M)
    (v : Fin N → M → ℝ)
    (hv : ∀ i, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (v i) (U i))
    (hLv : ∀ i, ∀ x ∈ U i, schrodinger g q (v i) x = 0) :
    ∃ w : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w ∧
      HasCompactSupport w ∧ tsupport w ⊆ (𝓡∂ (n + 1)).interior M ∧
      (∀ i, secondJet g w (points i) = secondJet g (v i) (points i)) ∧
      ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (schrodinger g q w) ∧
      HasCompactSupport (schrodinger g q w) ∧
      tsupport (schrodinger g q w) ⊆ (𝓡∂ (n + 1)).interior M ∧
      Disjoint (tsupport (schrodinger g q w)) (range points) := by
  obtain ⟨w, hw, hwc, hwi, hwgerm⟩ :=
    exists_compact_interior_extension_of_local_germs N points hinj U hpointU hU v hv
  have hvs (i : Fin N) : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (v i) (points i) :=
    ((hv i _ (hpointU i)).contMDiffAt ((U i).isOpen.mem_nhds (hpointU i))).of_le (by decide)
  have hFsub := tsupport_schrodinger_subset g q w hw
  refine ⟨w, hw, hwc, hwi, fun i => secondJet_eq_of_eventuallyEq g
    (hw.of_le (by decide)).contMDiffAt (hvs i) (hwgerm i),
    contMDiff_schrodinger g q w hq hw,
    hwc.of_isClosed_subset (isClosed_tsupport _) hFsub, hFsub.trans hwi, ?_⟩
  rw [disjoint_left]
  rintro x hx ⟨i, rfl⟩
  have hzero : schrodinger g q w =ᶠ[𝓝 (points i)] 0 := by
    filter_upwards [(hwgerm i).eventuallyEq_nhds,
      (U i).isOpen.mem_nhds (hpointU i)] with y hy hyU
    exact (schrodinger_eq_of_eventuallyEq g q (hw.of_le (by decide)).contMDiffAt
      (((hv i _ hyU).contMDiffAt ((U i).isOpen.mem_nhds hyU)).of_le (by decide)) hy).trans
        (hLv i y hyU)
  exact (notMem_tsupport_iff_eventuallyEq.mpr hzero) hx

end ConformalPoisson

end ProofPart_FiniteJetCutoffs

