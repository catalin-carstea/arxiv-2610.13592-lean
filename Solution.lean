/- Continuous functions on the compact closure of an open set embed
boundedly and injectively into its actual Lp values. Intended caller:
closed-graph lift of native smooth representatives and their derivatives. -/
open Set MeasureTheory TopologicalSpace
open scoped ENNReal NNReal BoundedContinuousFunction
namespace ConformalPoisson
variable {E F : Type*} [TopologicalSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsOpenPosMeasure] {Ω : Opens E}
  [CompactSpace (closure (Ω : Set E))]
  [IsFiniteMeasure (μ.restrict (Ω : Set E))]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

without_proof_info in
theorem finite_comap_open : IsFiniteMeasure (μ.comap ((↑) : Ω → E)) := by
  constructor
  have he : MeasurableEmbedding ((↑) : Ω → E) := Ω.isOpen.isOpenEmbedding_subtypeVal.measurableEmbedding
  rw [he.comap_apply μ univ]
  have hrange : Set.range ((↑) : Ω → E) = (Ω : Set E) := by
    ext x
    exact ⟨fun ⟨y, hy⟩ => hy ▸ y.property, fun hx => ⟨⟨x, hx⟩, rfl⟩⟩
  rw [image_univ, hrange]
  simpa only [Measure.restrict_apply_univ] using
    (show (μ.restrict (Ω : Set E)) univ < ∞ from measure_lt_top _ _)

attribute [local instance] finite_comap_open

/-- Restriction from the compact closure to its dense open subset. -/
def continuousClosureRestrictL : C(closure (Ω : Set E), F) →L[ℝ] (Ω →ᵇ F) :=
  (BoundedContinuousFunction.compContinuousCLM F ℝ
    ⟨Set.inclusion subset_closure, continuous_inclusion subset_closure⟩).comp
      (ContinuousMap.linearIsometryBoundedOfCompact _ F ℝ).toLinearIsometry.toContinuousLinearMap

without_proof_info in
@[simp] theorem continuousClosureRestrictL_apply (f : C(closure (Ω : Set E), F)) (x : Ω) :
    continuousClosureRestrictL f x = f ⟨x, subset_closure x.property⟩ := rfl

set_option maxHeartbeats 400000 in
def continuousClosureToLp : C(closure (Ω : Set E), F) →L[ℝ]
    Lp F p (μ.restrict (Ω : Set E)) := by
  letI := finite_comap_open (μ := μ) (Ω := Ω)
  exact (Lp.comapSubtypeEquivₗᵢ ℝ μ Ω.isOpen.measurableSet).symm.toLinearIsometry.toContinuousLinearMap.comp
    ((BoundedContinuousFunction.toLp p (μ.comap ((↑) : Ω → E)) ℝ).comp continuousClosureRestrictL)

without_proof_info in
@[simp] theorem continuousClosureToLp_apply (f : C(closure (Ω : Set E), F)) :
    continuousClosureToLp (μ := μ) (p := p) f =
      (Lp.comapSubtypeEquivₗᵢ ℝ μ Ω.isOpen.measurableSet).symm
        ((BoundedContinuousFunction.toLp p (μ.comap ((↑) : Ω → E)) ℝ)
            (continuousClosureRestrictL f)) := rfl

set_option maxHeartbeats 500000 in
without_proof_info in
theorem continuousClosureToLp_readback (f : C(closure (Ω : Set E), F)) :
    ∀ᵐ x ∂μ.restrict (Ω : Set E), ∀ hx : x ∈ (Ω : Set E),
      continuousClosureToLp (μ := μ) (p := p) f x = f ⟨x, subset_closure hx⟩ := by
  letI := finite_comap_open (μ := μ) (Ω := Ω)
  have h₁ := Lp.coeFn_comapSubtypeEquivₗᵢ_symm_comp_subtype (𝕜 := ℝ) Ω.isOpen.measurableSet
    ((BoundedContinuousFunction.toLp p (μ.comap ((↑) : Ω → E)) ℝ) (continuousClosureRestrictL f))
  have h₂ := BoundedContinuousFunction.coeFn_toLp p (μ.comap ((↑) : Ω → E)) ℝ
    (continuousClosureRestrictL f)
  rw [ae_restrict_iff_subtype Ω.isOpen.measurableSet]
  filter_upwards [h₁, h₂] with x hx₁ hx₂ hx
  simpa only [continuousClosureToLp_apply, continuousClosureRestrictL_apply, Function.comp_apply] using hx₁.trans hx₂

set_option maxHeartbeats 500000 in
without_proof_info in
theorem continuousClosureToLp_injective : Function.Injective
    (continuousClosureToLp (μ := μ) (Ω := Ω) (F := F) (p := p)) := by
  letI := finite_comap_open (μ := μ) (Ω := Ω)
  letI : (μ.comap ((↑) : Ω → E)).IsOpenPosMeasure :=
    Measure.IsOpenPosMeasure.comap μ Ω.isOpen.isOpenEmbedding_subtypeVal
  intro f g hfg
  have hLp : (BoundedContinuousFunction.toLp p (μ.comap ((↑) : Ω → E)) ℝ)
      (continuousClosureRestrictL f) =
      (BoundedContinuousFunction.toLp p (μ.comap ((↑) : Ω → E)) ℝ) (continuousClosureRestrictL g) :=
    (Lp.comapSubtypeEquivₗᵢ ℝ μ Ω.isOpen.measurableSet).symm.injective (by
      simpa only [continuousClosureToLp_apply] using hfg)
  have hR := BoundedContinuousFunction.toLp_injective (p := p) (𝕜 := ℝ)
    (μ := μ.comap ((↑) : Ω → E)) hLp
  have hd : DenseRange (Set.inclusion (subset_closure : (Ω : Set E) ⊆ closure (Ω : Set E))) :=
    (denseRange_inclusion_iff subset_closure).2 subset_rfl
  exact DFunLike.coe_injective (hd.equalizer f.continuous g.continuous
    (funext fun x => congrArg (fun h : Ω →ᵇ F => h x) hR))

end ConformalPoisson

