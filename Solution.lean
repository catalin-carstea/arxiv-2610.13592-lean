    (hregularity : ∀ (g : Metric (n := n) (M := M)) (q : M → ℝ)
      (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q), NativeWeakDirichletValueRegularity g q hq) :
    ForwardInhomogeneousAssumption (n := n) (M := M) := by
