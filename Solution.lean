set_option maxHeartbeats 500000 in
without_proof_info in
theorem chart_representative_native_value_ae (D : Opens V)
    (hDU : (D : Set V) ⊆ ball (extChartAt Ihalf c c) L.bump.rIn)
    (u : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x}) {g : V → ℝ}
    (hgr : g =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (L.innerCap ⊓ D : Opens V)]
      W1p.value (L.innerReadingL u)) :
    (g ∘ extChartAt Ihalf c) =ᵐ[(riemannianVolume Ihalf M).restrict
      ((extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (D : Set V))]
      valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u := by
  let μ := (Module.finBasis ℝ V).addHaar
  let A := L.innerCap ⊓ D
  let S := (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (D : Set V)
  have hAt : (A : Set V) ⊆ (extChartAt Ihalf c).target :=
    (SetLike.coe_subset_coe.mpr (inf_le_left : A ≤ L.innerCap)).trans
      (L.innerCap_subset_interior_target.trans interior_subset)
  have hr : W1p.value (L.innerReadingL u) =ᵐ[μ.restrict A]
      fun z => valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u ((extChartAt Ihalf c).symm z) :=
    ae_restrict_of_ae_restrict_of_subset
      (SetLike.coe_subset_coe.mpr (inf_le_left : A ≤ L.innerCap)) (L.innerReadingL_native_value_ae u)
  have hP : ∀ᵐ z ∂μ.restrict A,
      (g ∘ extChartAt Ihalf c) ((extChartAt Ihalf c).symm z) =
        valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u ((extChartAt Ihalf c).symm z) := by
    filter_upwards [hgr.trans hr, ae_restrict_mem A.isOpen.measurableSet] with z hz hzA
    rw [Function.comp_apply, (extChartAt Ihalf c).right_inv (hAt hzA), hz]
  have hn := ae_native_chart_preimage c (Ω := A)
    (P := fun x => (g ∘ extChartAt Ihalf c) x =
      valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u x) hAt hP
  have hn' := (ae_restrict_iff' (isOpen_extChartAt_preimage' c A.isOpen).measurableSet).1 hn
  have hbd : riemannianVolume Ihalf M ((Ihalf).boundary M) = 0 :=
    (isNullSet_boundary (I := Ihalf) (M := M)).riemannianVolume_eq_zero
  rw [Filter.EventuallyEq,
    ae_restrict_iff' (isOpen_extChartAt_preimage' (I := Ihalf) c D.isOpen).measurableSet]
  filter_upwards [hn', measure_eq_zero_iff_ae_notMem.1 hbd] with x hnx hxi hxS
  have hxI : (Ihalf).IsInteriorPoint x :=
    ((Ihalf).isInteriorPoint_iff_not_isBoundaryPoint x).2 hxi
  have hsrc : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) c).source := by
    simpa only [extChartAt_source] using hxS.1
  have hcoord := (TauCeti.ModelWithCorners.isInteriorPoint_iff_mem_interior_range
    (I := Ihalf) (k := ∞) (by simp) (IsManifold.chart_mem_maximalAtlas c) hsrc).1 hxI
  exact hnx ⟨hxS.1, ⟨⟨hDU hxS.2, hcoord⟩, hxS.2⟩⟩

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_native_local_smooth_zero_representative {q F : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hF : ContMDiff Ihalf 𝓘(ℝ) ∞ F)
    (u : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x})
    (hu : ∀ v : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x},
      schrodingerForm (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x}
          (ContinuousMap.toLp ⊤ (riemannianVolume Ihalf M) ℝ ⟨q, hq.continuous⟩) u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ ⟨F, hF.continuous⟩,
          valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} v⟫_ℝ) :
    ∃ O : Opens M, c ∈ O ∧ ∃ w : M → ℝ,
      ContMDiffOn Ihalf 𝓘(ℝ) ∞ w O ∧
      (∀ x ∈ O, (Ihalf).IsBoundaryPoint x → w x = 0) ∧
      w =ᵐ[(riemannianVolume Ihalf M).restrict O]
        valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u := by
  let D := L.derivativeOuterBall
  have hDc : IsCompact (closure (D : Set V)) := L.derivativeOuterBall_compact_closure
  have hDU : closure (D : Set V) ⊆ ball (extChartAt Ihalf c c) L.bump.rIn :=
    L.derivativeOuterBall_closure_subset
  have hconvD : Convex ℝ (D : Set V) := convex_ball _ _
  obtain ⟨g, _, hgs, hgr, hg0⟩ := L.innerReadingL_exists_smooth_zero_boundary_representative
    hq hF u hu D hDc hDU hconvD
  let O : Opens M := ⟨(extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (D : Set V),
    isOpen_extChartAt_preimage' c D.isOpen⟩
  refine ⟨O, ⟨?_, L.derivativeInnerBall_le_outer L.derivativeInnerBall_center⟩,
    g ∘ extChartAt Ihalf c, L.contMDiffOn_chart_representative D (subset_closure.trans hDU) hgs,
    L.chart_representative_zero_on_boundary D hg0,
    L.chart_representative_native_value_ae D (subset_closure.trans hDU) u hgr⟩
  simpa only [extChartAt_source] using mem_chart_source (EuclideanHalfSpace (n + 1)) c
end ConformalPoisson.BoundaryChartLocalization


end ProofPart_NativeChartRepresentative

/- Proof support: NativeRepresentativeGluing.lean, SHA256 d5c7f1e0312f4ffee05c2139ebbfc0bd3403823a81ea73d39bf71b404c781cbd -/
noncomputable section ProofPart_NativeRepresentativeGluing




/-
Gluing local smooth representatives of a fixed native measurable value.
The null-set gluing follows the pattern in pinned Tau Ceti
MeasureTheory/Function/LocalRepresentative.lean, adapted to ContMDiff
and with the local zero condition retained. Original copyright (c) 2026
The Tau Ceti contributors, Apache2.0; External/LICENSE.tauceti.
-/
open Set MeasureTheory TopologicalSpace Filter
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [SecondCountableTopology M]
  [MeasurableSpace M] [OpensMeasurableSpace M]
  {μ : Measure M} [μ.IsOpenPosMeasure] {B : Set M} {u : M → ℝ}

without_proof_info in
theorem exists_contMDiff_zero_ae_eq_of_locally
    (h : ∀ x : M, ∃ O : Opens M, x ∈ O ∧ ∃ f : M → ℝ,
      ContMDiffOn I 𝓘(ℝ) ∞ f O ∧ (∀ y ∈ O, y ∈ B → f y = 0) ∧
        f =ᵐ[μ.restrict O] u) :
    ∃ g : M → ℝ, ContMDiff I 𝓘(ℝ) ∞ g ∧ (∀ x ∈ B, g x = 0) ∧ g =ᵐ[μ] u := by
  classical
  choose O hxO f hf hf0 hfu using h
  let g := fun x => f x x
  have heq : ∀ c : M, EqOn g (f c) (O c) := by
    intro c y hy
    have hyu : f y =ᵐ[μ.restrict ((O y ⊓ O c : Opens M) : Set M)] u :=
      ae_restrict_of_ae_restrict_of_subset
        (SetLike.coe_subset_coe.mpr (inf_le_left : O y ⊓ O c ≤ O y)) (hfu y)
    have hcu : f c =ᵐ[μ.restrict ((O y ⊓ O c : Opens M) : Set M)] u :=
      ae_restrict_of_ae_restrict_of_subset
        (SetLike.coe_subset_coe.mpr (inf_le_right : O y ⊓ O c ≤ O c)) (hfu c)
    exact Measure.eqOn_open_of_ae_eq (hyu.trans hcu.symm) (O y ⊓ O c).isOpen
      ((hf y).continuousOn.mono (SetLike.coe_subset_coe.mpr inf_le_left))
      ((hf c).continuousOn.mono (SetLike.coe_subset_coe.mpr inf_le_right)) ⟨hxO y, hy⟩
  refine ⟨g, ?_, fun x hx => hf0 x x (hxO x) hx, ?_⟩
  · intro x
    apply ((hf x).contMDiffAt ((O x).isOpen.mem_nhds (hxO x))).congr_of_eventuallyEq
    exact Filter.eventually_of_mem ((O x).isOpen.mem_nhds (hxO x)) (heq x)
  · apply ae_iff.2
    refine measure_null_of_locally_null _ fun x _ => ?_
    refine ⟨_, inter_mem_nhdsWithin _ ((O x).isOpen.mem_nhds (hxO x)),
      measure_mono_null ?_ (ae_iff.1 (ae_imp_of_ae_restrict (hfu x)))⟩
    rintro y ⟨hy, hyO⟩
    exact not_imp.2 ⟨hyO, by rwa [← heq x hyO]⟩
end ConformalPoisson

end ProofPart_NativeRepresentativeGluing

