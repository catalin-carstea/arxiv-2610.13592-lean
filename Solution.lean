  · simp only [Nat.sub_zero]
    have heq : B / C * C ^ 2 = B * C := by field_simp
    rw [div_le_iff₀ (pow_pos hC 2), heq]
    interval_cases k
    · simpa using one_le_mul_of_one_le_of_one_le hB hC1
    · simpa using le_mul_of_one_le_right (by linarith : 0 ≤ B) hC1
    · simpa only [pow_two] using mul_le_mul_of_nonneg_left hBC (by linarith : 0 ≤ B)
  · have hk1 : k ≤ 1 := by omega
    norm_num only [Nat.reduceSub, pow_one]
    apply (div_le_div_iff_of_pos_right hC).mpr
    interval_cases k <;> simp [hB]

set_option maxHeartbeats 500000 in
without_proof_info in
theorem normal_majorant_sum_weights_le
    {ι : Type*} [Fintype ι]
    (L : ι → ℝ) (k ell : ι → ℕ) (B H : ℝ)
    (hL : ∀ i, 0 ≤ L i) (hB : 1 ≤ B) (hH : 1 ≤ H) (hLH : ∑ i, L i ≤ H)
