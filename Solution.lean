noncomputable section ProofPart_GreenTrace_ContinuousKernelLpSections



/- A jointly continuous kernel on a product with a compact cap closure
has a CONTINUOUS Lp row family. If the actual rows lie in a specified closed
solution subspace, their subspace-valued family is continuous as well.
Intended caller: the native bounded column integral for Hilbert factorization. -/
open Set MeasureTheory TopologicalSpace
open scoped ENNReal NNReal
namespace ConformalPoisson
variable {A E : Type*} [TopologicalSpace A]
  [TopologicalSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsOpenPosMeasure] {Ω : Opens E}
  [CompactSpace (closure (Ω : Set E))] [IsFiniteMeasure (μ.restrict (Ω : Set E))]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

def continuousKernelLpSections (k : C(A × closure (Ω : Set E), ℝ)) :
    C(A, Lp ℝ p (μ.restrict (Ω : Set E))) :=
  ⟨fun a => continuousClosureToLp (μ := μ) (p := p) (k.curry a),
    (continuousClosureToLp (μ := μ) (p := p)).continuous.comp k.curry.continuous⟩

without_proof_info in
theorem continuousKernelLpSections_readback (k : C(A × closure (Ω : Set E), ℝ)) (a : A) :
    ∀ᵐ x ∂μ.restrict (Ω : Set E), ∀ hx : x ∈ (Ω : Set E),
      continuousKernelLpSections (μ := μ) (p := p) k a x = k (a, ⟨x, subset_closure hx⟩) :=
  continuousClosureToLp_readback (k.curry a)

def continuousKernelSectionsInSubmodule (k : C(A × closure (Ω : Set E), ℝ))
    (P : Submodule ℝ (Lp ℝ p (μ.restrict (Ω : Set E))))
    (hP : ∀ a, continuousKernelLpSections (μ := μ) (p := p) k a ∈ P) : C(A, P) :=
  ⟨fun a => ⟨continuousKernelLpSections (μ := μ) (p := p) k a, hP a⟩,
    (continuousKernelLpSections (μ := μ) (p := p) k).continuous.subtype_mk _⟩

without_proof_info in
@[simp] theorem coe_continuousKernelSectionsInSubmodule (k : C(A × closure (Ω : Set E), ℝ))
    (P : Submodule ℝ (Lp ℝ p (μ.restrict (Ω : Set E))))
    (hP : ∀ a, continuousKernelLpSections (μ := μ) (p := p) k a ∈ P) (a : A) :
    ((continuousKernelSectionsInSubmodule k P hP a : P) : Lp ℝ p (μ.restrict (Ω : Set E))) =
      continuousKernelLpSections (μ := μ) (p := p) k a := rfl

end ConformalPoisson

