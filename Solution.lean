/- Green's first identity for a test supported in one interior chart
of the actual manifold with boundary. No Boundaryless assumption on
that manifold is used. The product-rule argument follows the pinned
Tau Ceti divergence theorem, with the interior-support theorem above. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [CompactSpace M]
  [IsManifold I 2 M] [RiemannianBundle (fun x : M ↦ TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 E (fun x : M ↦ TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
  [IsContinuousRiemannianBundle E (fun x : M ↦ TangentSpace I x)]

without_proof_info in
theorem integral_mul_laplaceBeltrami_of_interior_chart (α : M)
    {f g : M → ℝ} (hf : ContMDiff I 𝓘(ℝ) 1 f) (hg : ContMDiff I 𝓘(ℝ) 2 g)
    (hs : tsupport f ⊆ (chartAt H α).source)
    (hi : extChartAt I α '' tsupport f ⊆ interior (extChartAt I α).target) :
    (∫ x, f x * laplaceBeltrami I g x ∂riemannianVolume I M) =
      -∫ x, ⟪mgradient I f x, mgradient I g x⟫_ℝ ∂riemannianVolume I M := by
  have : IsManifold I (1 + 1) M := by norm_num; infer_instance
  have hX : ContMDiff I I.tangent 1 (T% (mgradient I g)) :=
    contMDiff_mgradient (n := 1) (by simpa only [one_add_one_eq_two] using hg)
  have hfX := hf.smul_section hX
  have hsupport : tsupport (α := E) (fun x => f x • mgradient I g x) ⊆ tsupport f :=
    tsupport_smul_subset_left _ _
  have hzero := integral_divergence_eq_zero_of_interior_chart (α := α) hfX
    (HasCompactSupport.of_compactSpace _)
    (hsupport.trans hs) ((image_mono hsupport).trans hi)
  have hpt (x : M) : divergence I (f • mgradient I g) x =
      f x * laplaceBeltrami I g x + ⟪mgradient I f x, mgradient I g x⟫_ℝ := by
    rw [divergence_smul_function I f (mgradient I g) x
      ((hf x).mdifferentiableAt one_ne_zero) ((hX x).mdifferentiableAt one_ne_zero),
      ← laplaceBeltrami_def, inner_mgradient]
  have hint : Integrable (fun x => f x * laplaceBeltrami I g x) (riemannianVolume I M) :=
    (hf.continuous.mul (continuous_laplaceBeltrami hg)).integrable_of_compactSpace
  have hgrad : Integrable (fun x => ⟪mgradient I f x, mgradient I g x⟫_ℝ)
      (riemannianVolume I M) :=
    (continuous_inner_mgradient hf (hg.of_le (by norm_num))).integrable_of_compactSpace
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_add hint hgrad] at hzero
  exact eq_neg_of_add_eq_zero_left hzero
end ConformalPoisson

end ProofPart_NativeInteriorGreen

