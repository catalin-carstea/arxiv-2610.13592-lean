without_proof_info in
theorem coordinatePushforward_target
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (f : H → F) {x : M} (hx : x ∈ χ.target) : coordinatePushforward χ f x = f (χ.symm x) := by
  have he := congrFun (Function.extend_comp
    (Subtype.val_injective : Function.Injective
      (Subtype.val : (⟨χ.target, χ.open_target⟩ : TopologicalSpace.Opens M) → M))
    (fun z => f (χ.symm z)) 0) ⟨x, hx⟩
