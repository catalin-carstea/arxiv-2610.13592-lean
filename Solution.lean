  middle : ContDiffBump z₀
  outer : ContDiffBump z₀
  outer_subset : tsupport outer ⊆ Ω
  agree_outer : ∀ z ∈ tsupport outer, E.principal z = A z ∧ E.drift z = b z ∧ E.potential z = q z
  middle_subset_outer : tsupport middle ⊆ tsupport outer
