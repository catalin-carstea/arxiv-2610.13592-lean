/- Interior analytic support: LocalizedSolutionFamily.lean, SHA256 49bec7afdd6e09b9b46ff0fc115e35f158d307b4810a433bf17ea38505e6f32d -/
noncomputable section ProofPart_InteriorAnalytic_LocalizedSolutionFamily



/- The SAME supplied smooth u gives a continuous C2-alpha zero-boundary
family u composed with the localized translation, minus u. The larger local
ball is only room for translations, without any optimal-radius assertion. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]

def localizedSolutionDifference (χ u : E → ℝ) (a x : E) : ℝ :=
  u (localizedTranslation χ a x) - u x

without_proof_info in
@[simp] theorem localizedSolutionDifference_zero (χ u : E → ℝ) :
    localizedSolutionDifference χ u 0 = 0 := by
  funext x
  simp [localizedSolutionDifference, localizedTranslation]

without_proof_info in
theorem localizedTranslation_mem_ball_three (χ : E → ℝ)
    (hχ : ∀ x, ‖χ x‖ ≤ 1) {a x : E} (ha : a ∈ ball 0 1) (hx : x ∈ ball 0 2) :
    localizedTranslation χ a x ∈ ball 0 3 := by
  simp only [mem_ball_zero_iff] at ha hx ⊢
  have hs : ‖χ x • a‖ ≤ ‖a‖ := by
    rw [norm_smul]
    exact (mul_le_mul_of_nonneg_right (hχ x) (norm_nonneg a)).trans_eq (one_mul _)
  have ht := norm_add_le x (χ x • a)
  change ‖x + χ x • a‖ < 3
  linarith

without_proof_info in
theorem exists_localizedSolutionDifference_ballJets {α : ℝ≥0} (hα : α ≤ 1)
    (χ u : E → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχbound : ∀ x, ‖χ x‖ ≤ 1)
    (hχsphere : ∀ x ∈ sphere (0 : E) 1, χ x = 0)
    (hu : ContDiffOn ℝ ∞ u (ball 0 3)) :
    ∃ J : E → BallSpace α E ℝ, ContinuousOn J (ball (0 : E) 1) ∧
      ∀ a ∈ ball (0 : E) 1, ∀ x : closedBall (0 : E) 1,
        (J a).val.1 x = localizedSolutionDifference χ u a x ∧
        (J a).val.2.1 x = fderiv ℝ (localizedSolutionDifference χ u a) x ∧
        (J a).val.2.2 x = fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u a)) x := by
  have hPhi : ContDiff ℝ ∞ (fun z : E × E => localizedTranslation χ z.1 z.2) :=
    contDiff_snd.add ((hχ.comp contDiff_snd).smul contDiff_fst)
  have hcomp : ContDiffOn ℝ ∞ (fun z : E × E => u (localizedTranslation χ z.1 z.2))
      (ball (0 : E) 1 ×ˢ ball (0 : E) 2) :=
    hu.comp hPhi.contDiffOn (fun z hz => localizedTranslation_mem_ball_three χ hχbound hz.1 hz.2)
  have hsnd : ContDiffOn ℝ ∞ (fun z : E × E => u z.2)
      (ball (0 : E) 1 ×ˢ ball (0 : E) 2) :=
    hu.comp contDiffOn_snd (fun z hz => ball_subset_ball (by norm_num : (2 : ℝ) ≤ 3) hz.2)
  apply exists_ballJets_of_smooth_joint_family hα isOpen_ball
    (closedBall_subset_ball (by norm_num : (1 : ℝ) < 2))
    (localizedSolutionDifference χ u) (hcomp.sub hsnd)
  intro a ha x hx
  simp [localizedSolutionDifference, localizedTranslation, hχsphere x hx]

without_proof_info in
theorem localizedSolutionDifference_center (χ u : E → ℝ) (hχ0 : χ 0 = 1) (a : E) :
    localizedSolutionDifference χ u a 0 = u a - u 0 := by
  simp [localizedSolutionDifference, localizedTranslation, hχ0]

end ConformalPoisson

end ProofPart_InteriorAnalytic_LocalizedSolutionFamily

