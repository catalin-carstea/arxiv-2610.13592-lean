      (⟨fun x => v x, hv.comp continuous_subtype_val⟩ : C(closure (D : Set V), ℝ))
    filter_upwards [hval, hvA, hR (A u), ae_restrict_mem D.isOpen.measurableSet] with x hx hvx hRx hxD
    exact (hx hxD).trans (hvx.trans hRx.symm)
  obtain ⟨T, hT⟩ := exists_continuous_lift_of_injective_value (R.comp A) B hB (by
    intro u
    obtain ⟨v, hv, _, hvA⟩ := hrep u
    exact ⟨⟨fun x => v x, hv.comp continuous_subtype_val⟩, hBrep u v hv hvA⟩)
  refine ⟨T, fun u => ?_⟩
  obtain ⟨v, hv, hvs, hvA⟩ := hrep u
  have heq : T u = (⟨fun x => v x, hv.comp continuous_subtype_val⟩ : C(closure (D : Set V), ℝ)) :=
    hB ((hT u).trans (hBrep u v hv hvA).symm)
  exact ⟨v, hv, hvs, fun x hx => congrArg (fun f : C(closure (D : Set V), ℝ) => f ⟨x, hx⟩) heq, hvA⟩

end ConformalPoisson

end ProofPart_GreenTrace_BoundedSmoothCapReading

/- Green/trace proof support: BoundedSobolevDirectionalReading.lean, SHA256 6a446354dd7dc105aa7d67e1cf8e2d2048a8b34fb69367fac49a44cf517e8ca8 -/
noncomputable section ProofPart_GreenTrace_BoundedSobolevDirectionalReading



/- The existing arbitrary-order weak directional derivative is a bounded
linear map, obtained by its unique value readback. Intended caller: bounded
continuous readings of every derivative of local native solutions. -/
open Set MeasureTheory TauCeti TopologicalSpace
open scoped ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_bounded_wkp_directional_reading (v : E) (k : ℕ) :
    ∃ T : Wkp μ Ω p (k + 1) →L[ℝ] Wkp μ Ω p k,
      ∀ u, HasWeakLineDerivOn μ Ω (Wkp.value (k + 1) u) (Wkp.value k (T u)) v := by
  let Q : Wkp μ Ω p (k + 1) →L[ℝ] W1p μ Ω p := Wkp.firstOrderL k
  let A : Wkp μ Ω p (k + 1) →L[ℝ] Lp ℝ p (μ.restrict (Ω : Set E)) :=
    ((innerSL ℝ v).compLpL p (μ.restrict (Ω : Set E))).comp (W1p.gradientL.comp Q)
  let B : Wkp μ Ω p k →L[ℝ] Lp ℝ p (μ.restrict (Ω : Set E)) := Wkp.valueL k
  have hBval : ∀ w, B w = Wkp.value k w := fun w => Wkp.valueL_apply k w
  have hB : Function.Injective B := fun w z h =>
    Wkp.ext k ((hBval w).symm.trans (h.trans (hBval z)))
  have hA : ∀ u, A u =ᵐ[μ.restrict (Ω : Set E)]
      (fun x => ⟪W1p.gradient (Q u) x, v⟫_ℝ) := by
    intro u
    have hEq : A u = (innerSL ℝ v).compLp (W1p.gradient (Q u)) := by
      simp only [A, ContinuousLinearMap.comp_apply, W1p.gradientL_apply]
      rfl
    rw [hEq]
    filter_upwards [(innerSL ℝ v).coeFn_compLp (W1p.gradient (Q u))] with x hx
    rw [hx, innerSL_apply_apply, real_inner_comm]
  have hSource : ∀ u, HasWeakLineDerivOn μ Ω (Wkp.value (k + 1) u) (A u) v := by
    intro u
    have hval : W1p.value (Q u) = Wkp.value (k + 1) u :=
      (congrArg W1p.value (Wkp.firstOrderL_apply k u)).trans (Wkp.value_firstOrder k u)
    have h := (W1p.hasWeakFDerivOn (Q u)).hasWeakLineDerivOn v
    rw [hval] at h
    exact h.congr_ae_deriv (hA u).symm
  obtain ⟨T, hT⟩ := exists_continuous_lift_of_injective_value A B hB (by
    intro u
    obtain ⟨d, hd⟩ := Wkp.exists_hasWeakLineDerivOn_value k u v
    refine ⟨d, ?_⟩
    rw [hBval]
    exact Lp.ext (hd.ae_eq (hSource u)))
  refine ⟨T, fun u => ?_⟩
  have heq : Wkp.value k (T u) = A u := (hBval (T u)).symm.trans (hT u)
  rw [heq]
  exact hSource u

end ConformalPoisson

end ProofPart_GreenTrace_BoundedSobolevDirectionalReading

