/- Proof support: BoundedHolderJets.lean, SHA256 d38e7df3395e5f92756d557253b87f9d59b3a40edcd2ba9c8d9dfd8b7f162a25 -/
noncomputable section ProofPart_BoundedHolderJets



/- On a bounded convex open set, a Holder Hessian controls all
three actual jets by finite bounded Holder constants. No values or
derivatives on the frontier are postulated. -/
open Set Metric Filter
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {S : Set E} {α K : ℝ≥0} {u : E → F}

without_proof_info in
theorem exists_norm_bound_of_holderOnWith (hb : Bornology.IsBounded S)
    (hf : HolderOnWith K α u S) : ∃ M : ℝ≥0, ∀ x ∈ S, ‖u x‖ ≤ M := by
  obtain ⟨D, hD⟩ := Metric.isBounded_iff.mp hb
  have hbimage : Bornology.IsBounded (u '' S) := by
    apply Metric.isBounded_image_iff.mpr
    refine ⟨K * (max D 0) ^ (α : ℝ), ?_⟩
    intro x hx y hy
    apply (hf.dist_le hx hy).trans
    gcongr
    exact (hD hx hy).trans (le_max_left D 0)
  obtain ⟨M, hM, hbound⟩ := hbimage.exists_pos_norm_le
  exact ⟨⟨M, hM.le⟩, fun x hx => hbound (u x) ⟨x, hx, rfl⟩⟩

without_proof_info in
theorem exists_holderBound_of_holderOnWith_isBounded (hb : Bornology.IsBounded S)
    (hf : HolderOnWith K α u S) : ∃ M : ℝ≥0, holderBound α S u M := by
  obtain ⟨M, hM⟩ := exists_norm_bound_of_holderOnWith hb hf
  exact ⟨M + K, ⟨fun x hx => (hM x hx).trans (by exact_mod_cast le_add_of_nonneg_right (show 0 ≤ K from zero_le)),
    hf.mono_const (le_add_of_nonneg_left (by positivity))⟩⟩

without_proof_info in
theorem exists_bounded_holder_jets_of_hessian (hS : IsOpen S) (hconv : Convex ℝ S)
    (hb : Bornology.IsBounded S) (hα : α ≤ 1) (hu : ContDiffOn ℝ 2 u S)
    (hH : HolderOnWith K α (fderiv ℝ (fderiv ℝ u)) S) :
    (∃ M : ℝ≥0, holderBound α S u M) ∧
    (∃ M : ℝ≥0, holderBound α S (fderiv ℝ u) M) ∧
    (∃ M : ℝ≥0, holderBound α S (fderiv ℝ (fderiv ℝ u)) M) := by
  have hDu : ContDiffOn ℝ 1 (fderiv ℝ u) S := hu.fderiv_of_isOpen hS (by decide)
  obtain ⟨MH, hMH⟩ := exists_norm_bound_of_holderOnWith hb hH
  have hLD : LipschitzOnWith MH (fderiv ℝ u) S := by
    apply Convex.lipschitzOnWith_of_nnNorm_fderiv_le
      (fun x hx => hDu.differentiableOn one_ne_zero |>.differentiableAt (hS.mem_nhds hx)) ?_ hconv
    intro x hx
    exact_mod_cast hMH x hx
  obtain ⟨MD, hMD⟩ := exists_norm_bound_of_holderOnWith hb hLD.holderOnWith
  have hLU : LipschitzOnWith MD u S := by
    apply Convex.lipschitzOnWith_of_nnNorm_fderiv_le
      (fun x hx => hu.differentiableOn (by decide) |>.differentiableAt (hS.mem_nhds hx)) ?_ hconv
    intro x hx
    exact_mod_cast hMD x hx
  obtain ⟨MU, hMU⟩ := exists_norm_bound_of_holderOnWith hb hLU.holderOnWith
  exact ⟨exists_holderBound_of_holderOnWith_isBounded hb (hLU.holderOnWith_of_norm_le hMU hα),
    exists_holderBound_of_holderOnWith_isBounded hb (hLD.holderOnWith_of_norm_le hMD hα),
    exists_holderBound_of_holderOnWith_isBounded hb hH⟩
end ConformalPoisson

end ProofPart_BoundedHolderJets

/- Proof support: HolderJetComposition.lean, SHA256 f0c78b6a8907f37bbae2a6f334fb23c49fe1fab54f47b6ee2e7f0ed1736623ae -/
noncomputable section ProofPart_HolderJetComposition




/- Bounded Holder second jets are preserved by a weighted C2 change
of variables when the chart and weight jets have bounded Holder norms.
The proof uses the actual second derivative product and chain rules;
finite basis assembly gives the genuine bilinear operator norm. -/
open Set Metric Filter TauCeti
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
section Congruence
variable {E F : Type*} [NormedAddCommGroup E] [NormedAddCommGroup F]
  {S : Set E} {f g : E → F} {α K : ℝ≥0}
without_proof_info in
theorem holderBound.holderOnWith_congr (hf : holderBound α S f K) (heq : EqOn f g S) :
    HolderOnWith K α g S := by
  apply HolderOnWith.of_dist_le
  intro x hx y hy
  rw [← heq hx, ← heq hy]
  exact hf.2.dist_le hx hy
end Congruence

variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_holderOnWith_hessian_weighted_comp
    {S : Set V} {g ψ : V → ℝ} {Φ : V → V}
    (hg : ∀ x ∈ S, ContDiffAt ℝ 2 g (Φ x))
    (hΦ : ∀ x ∈ S, ContDiffAt ℝ 2 Φ x) (hψ : ∀ x ∈ S, ContDiffAt ℝ 2 ψ x)
    {K0 K1 K2 L1 L2 M0 M1 M2 : ℝ≥0}
    (h0 : holderBound α S (g ∘ Φ) K0)
    (h1 : holderBound α S (fun x => fderiv ℝ g (Φ x)) K1)
    (h2 : holderBound α S (fun x => fderiv ℝ (fderiv ℝ g) (Φ x)) K2)
    (hD : holderBound α S (fderiv ℝ Φ) L1)
    (hH : holderBound α S (fderiv ℝ (fderiv ℝ Φ)) L2)
    (hP : holderBound α S ψ M0)
    (hDP : holderBound α S (fderiv ℝ ψ) M1)
    (hHP : holderBound α S (fderiv ℝ (fderiv ℝ ψ)) M2) :
    ∃ K : ℝ≥0, HolderOnWith K α (fderiv ℝ (fderiv ℝ (fun x => ψ x * g (Φ x)))) S := by
  classical
  let : NormedAddCommGroup (V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ) :=
    ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
      (E := V) (F := (V →L[ℝ] ℝ) →L[ℝ] ℝ)
  let : NormedAddCommGroup ((V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ) :=
    ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
      (E := V →L[ℝ] V →L[ℝ] ℝ) (F := V →L[ℝ] ℝ)
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  let E : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ
  let EH : V →L[ℝ] (V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ :=
    ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ)
  let R : ℝ →L[ℝ] ℝ →L[ℝ] ℝ := ContinuousLinearMap.mul ℝ ℝ
  have entries : ∀ i j : Fin (n + 1), ∃ C : ℝ≥0, HolderOnWith C α
      (fun x => fderiv ℝ (fderiv ℝ (fun y => ψ y * g (Φ y))) x (b i) (b j)) S := by
    intro i j
    have hAi := hD.mapCLM (ContinuousLinearMap.apply ℝ V (b i))
    have hAj := hD.mapCLM (ContinuousLinearMap.apply ℝ V (b j))
    have hBij := (hH.mapCLM (ContinuousLinearMap.apply ℝ (V →L[ℝ] V) (b i))).mapCLM
      (ContinuousLinearMap.apply ℝ V (b j))
    have hDgi := hAi.bilinear h1 E
    have hDgj := hAj.bilinear h1 E
    have hQuad := hAj.bilinear (hAi.bilinear h2 EH) E
    have hLinear := hBij.bilinear h1 E
    have hHcomp := hQuad.add hLinear
    have hPi := hDP.mapCLM (ContinuousLinearMap.apply ℝ ℝ (b i))
    have hPj := hDP.mapCLM (ContinuousLinearMap.apply ℝ ℝ (b j))
    have hPij := (hHP.mapCLM (ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) (b i))).mapCLM
      (ContinuousLinearMap.apply ℝ ℝ (b j))
    have hraw := (((hP.bilinear hHcomp R).add (h0.bilinear hPij R)).add
      (hPi.bilinear hDgj R)).add (hDgi.bilinear hPj R)
    refine ⟨_, hraw.holderOnWith_congr ?_⟩
    intro x hx
    dsimp only [R, E, EH]
    simp only [ContinuousLinearMap.mul_apply', ContinuousLinearMap.apply_apply]
    have hprod := fderiv_fderiv_mul_apply (hψ x hx) ((hg x hx).comp x (hΦ x hx)) (b i) (b j)
    have hchain := fderiv_fderiv_comp_apply (hg x hx) (hΦ x hx) (b i) (b j)
    have hder := fderiv_comp x ((hg x hx).differentiableAt (by decide))
      ((hΦ x hx).differentiableAt (by decide))
    have hfun : ψ * (g ∘ Φ) = (fun y => ψ y * g (Φ y)) := rfl
    rw [hfun] at hprod
    simpa only [Pi.mul_apply, Function.comp_apply, hchain, hder, ContinuousLinearMap.comp_apply] using hprod.symm
  choose C hC using entries
  exact ⟨∑ i, ∑ j, C i j, holderOnWith_bilinear_of_entries C hC⟩
end ConformalPoisson

end ProofPart_HolderJetComposition

/- Proof support: HolderJetPullback.lean, SHA256 b8732667cd1f57d921a27cb38b974ac0dfd2f5af6e0abb3a36a728d9cddd69db -/
noncomputable section ProofPart_HolderJetPullback



/- Compact smooth chart jets and Lipschitz precomposition supply the
explicit bounded Holder data used by the weighted Hessian formula. -/
open Set Metric Filter TauCeti
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
section Composition
variable {E F G : Type*} [NormedAddCommGroup E] [NormedAddCommGroup F] [NormedAddCommGroup G]
  {S : Set E} {T : Set F} {f : F → G} {Φ : E → F} {α K L : ℝ≥0}
without_proof_info in
theorem holderBound.restrict_set {T' : Set F} (hf : holderBound α T f K) (hT : T' ⊆ T) :
    holderBound α T' f K := ⟨fun x hx => hf.1 x (hT hx), hf.2.mono hT⟩

without_proof_info in
theorem holderBound.comp_lipschitz (hf : holderBound α T f K)
    (hΦ : LipschitzOnWith L Φ S) (hmap : MapsTo Φ S T) :
    holderBound α S (f ∘ Φ) (K + K * L ^ (α : ℝ)) := by
  refine ⟨fun x hx => (hf.1 (Φ x) (hmap hx)).trans ?_, ?_⟩
  · exact_mod_cast le_add_of_nonneg_right (show 0 ≤ K * L ^ (α : ℝ) from zero_le)
  · have hcomp : HolderOnWith (K * L ^ (α : ℝ)) α (f ∘ Φ) S := by
      simpa only [mul_one] using hf.2.comp hΦ.holderOnWith hmap
    exact hcomp.mono_const (le_add_of_nonneg_left (by positivity))
end Composition

section CompactJets
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {C : Set E} {f : E → F} {α : ℝ≥0}
without_proof_info in
theorem exists_holderBounds_jets_of_contDiffAt_isCompact (hC : IsCompact C)
    (hf : ∀ x ∈ C, ContDiffAt ℝ ∞ f x) (hα : α ≤ 1) :
    ∃ K0 K1 K2 : ℝ≥0, holderBound α C f K0 ∧
      holderBound α C (fderiv ℝ f) K1 ∧
      holderBound α C (fderiv ℝ (fderiv ℝ f)) K2 := by
  obtain ⟨K0, hK0⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (fun x hx => (hf x hx).of_le (by simp)) hα
  obtain ⟨K1, hK1⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (fun x hx => (hf x hx).fderiv_right (by simp : (1 : ℕ∞ω) + 1 ≤ ∞)) hα
  obtain ⟨K2, hK2⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (fun x hx => ((hf x hx).fderiv_right (m := ∞) (by simp)).fderiv_right
      (by simp : (1 : ℕ∞ω) + 1 ≤ ∞)) hα
  exact ⟨K0, K1, K2, hK0, hK1, hK2⟩
end CompactJets
end ConformalPoisson

end ProofPart_HolderJetPullback

/- Proof support: SphereInverseGeometry.lean, SHA256 8abdb107e6acdb38abb1e0b9c60729bf5434e7c21aef5771d7f8803c0fc20aef -/
noncomputable section ProofPart_SphereInverseGeometry



/- The weighted inverse chart recovers the original solution away
from the inversion pole. Its weight is smooth there. A genuine compact
neighborhood of each non-pole sphere point maps into a unit ball about
the flat face, where the proved Hessian estimate applies. -/
open Set Metric Filter TopologicalSpace TauCeti EuclideanGeometry
open scoped NNReal ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e₀" => (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ))

without_proof_info in
theorem chartMap_ne_pole {x : V} (hx : x ≠ -e₀) : chartMap n x ≠ -e₀ :=
  fun h => hx ((inversion_eq_center (Real.sqrt_ne_zero'.mpr (by norm_num : (0 : ℝ) < 2))).mp h)

without_proof_info in
theorem ne_pole_of_mem_ball {x : V} (hx : x ∈ ball (0 : V) 1) : x ≠ -e₀ := by
  intro heq
  have hnorm : ‖x‖ < 1 := by simpa only [mem_ball, dist_zero_right] using hx
  rw [heq] at hnorm
  simpa [EuclideanSpace.single, PiLp.norm_single] using hnorm

without_proof_info in
theorem chartMap_pos_of_mem_ball {x : V} (hx : x ∈ ball (0 : V) 1) :
    0 < (chartMap n x) 0 :=
  (inversion_apply_zero_pos_iff (ne_pole_of_mem_ball hx)).mpr
    (by simpa only [mem_ball, dist_zero_right] using hx)

without_proof_info in
theorem chartMap_zero_of_mem_sphere {x : V} (hx : x ∈ sphere (0 : V) 1)
    (hne : x ≠ -e₀) : (chartMap n x) 0 = 0 := by
  have hnorm : ‖x‖ = 1 := by simpa only [mem_sphere, dist_zero_right] using hx
  change (inversion (-e₀) √2 x) 0 = 0
  rw [inversion_apply_zero hne, hnorm]
  simp

def inverseChartWeight (n : ℕ) : EuclideanSpace ℝ (Fin (n + 1)) → ℝ :=
  fun x => (‖chartMap n x - (-EuclideanSpace.single 0 1)‖ ^ (2 - ((n : ℝ) + 1)))⁻¹

without_proof_info in
theorem contDiffAt_inverseChartWeight {x : V} {k : ℕ∞ω} (hx : x ≠ -e₀) :
    ContDiffAt ℝ k (inverseChartWeight n) x := by
  have hI : ContDiffAt ℝ k (chartMap n) x := EuclideanGeometry.contDiffAt_inversion hx
  have hw : ContDiffAt ℝ k
      (fun y : V => ‖y - (-e₀)‖ ^ (2 - ((n : ℝ) + 1))) (chartMap n x) :=
    contDiffAt_norm_sub_rpow (-e₀) (2 - ((n : ℝ) + 1)) (chartMap_ne_pole hx)
  exact (hw.comp x hI).inv (ne_of_gt (Real.rpow_pos_of_pos
    (norm_pos_iff.mpr (sub_ne_zero.mpr (chartMap_ne_pole hx))) _))

without_proof_info in
theorem recover_from_chartKelvin (u : V → ℝ) {x : V} (hx : x ≠ -e₀) :
    inverseChartWeight n x * chartKelvin u (chartMap n x) = u x := by
  change (‖chartMap n x - (-e₀)‖ ^ (2 - ((n : ℝ) + 1)))⁻¹ *
    (‖chartMap n x - (-e₀)‖ ^ (2 - ((n : ℝ) + 1)) * u (chartMap n (chartMap n x))) = u x
  rw [chartMap_chartMap]
  exact inv_mul_cancel_left₀ (ne_of_gt (Real.rpow_pos_of_pos
    (norm_pos_iff.mpr (sub_ne_zero.mpr (chartMap_ne_pole hx))) _)) _

without_proof_info in
theorem exists_compact_chart_neighborhood {p : V} (hp : p ∈ sphere (0 : V) 1)
    (hne : p ≠ -e₀) :
    ∃ δ : ℝ, 0 < δ ∧ (∀ x ∈ closedBall p δ, x ≠ -e₀) ∧
      MapsTo (chartMap n) (closedBall p δ) (ball (chartMap n p) 1) ∧ (chartMap n p) 0 = 0 := by
  have hΦ : ContinuousAt (chartMap n) p :=
    (EuclideanGeometry.contDiffAt_inversion hne (R := √2) (n := 0)).continuousAt
  have hpole : {-e₀}ᶜ ∈ 𝓝 p := isOpen_compl_singleton.mem_nhds hne
  obtain ⟨ε, hε, hsub⟩ := Metric.mem_nhds_iff.mp
    (inter_mem hpole (hΦ.preimage_mem_nhds (ball_mem_nhds _ (by norm_num : (0 : ℝ) < 1))))
  have hcb : closedBall p (ε / 2) ⊆ ball p ε := closedBall_subset_ball (by linarith)
  exact ⟨ε / 2, by positivity, fun x hx => (hsub (hcb hx)).1,
    fun x hx => (hsub (hcb hx)).2, chartMap_zero_of_mem_sphere hp hne⟩
end ConformalPoisson.SphereFlattening

end ProofPart_SphereInverseGeometry

/- Proof support: SphereInverseHessian.lean, SHA256 8fb08f7d0e7c99e0c324ecd80278aea9d57e5d7a58602d8f19b3027706d6bd93 -/
