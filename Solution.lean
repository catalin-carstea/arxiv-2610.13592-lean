/- Analytic division by the actual zeroth boundary coordinate. This
reuses the proved normal-factor theorem through the canonical split map. -/
open Set Filter Topology TauCeti
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Y" => EuclideanSpace ℝ (Fin n)

without_proof_info in
@[simp] theorem boundaryTangentialProjection_succ (x : V) (i : Fin n) :
    boundaryTangentialProjection x i.succ = x i.succ := by
  simp [boundaryTangentialProjection_apply]
  ring

without_proof_info in
theorem boundaryTangentialProjection_split (z : Y × ℝ) :
    boundaryTangentialProjection (euclideanHalfSpaceBoundaryNormalEquiv n z) =
      euclideanHalfSpaceBoundaryNormalEquiv n (z.1, 0) := by
  rcases z with ⟨z, t⟩
  ext i
  refine Fin.cases ?_ (fun j => ?_) i
  · simp
  · simp

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_analytic_boundary_coordinate_factor
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
    {f : V → F} (hf : AnalyticAt ℝ f 0)
    (hzero : ∀ᶠ x in 𝓝 (0 : V), f (boundaryTangentialProjection x) = 0) :
    ∃ B : V → F, AnalyticAt ℝ B 0 ∧
      ∀ᶠ x in 𝓝 (0 : V), f x = x 0 • B x := by
  let L := euclideanHalfSpaceBoundaryNormalEquiv n
  have hfL : AnalyticAt ℝ (f ∘ L) (0 : Y × ℝ) :=
    hf.comp_of_eq (L.analyticAt 0) L.map_zero
  have ht : Tendsto L (𝓝 (0 : Y × ℝ)) (𝓝 (0 : V)) := by simpa using L.continuous.tendsto 0
  have hz : ∀ᶠ z : Y × ℝ in 𝓝 (0 : Y × ℝ), (f ∘ L) (z.1, 0) = 0 := by
    filter_upwards [ht.eventually hzero] with z hz
    simpa only [L, boundaryTangentialProjection_split, Function.comp_apply] using hz
  obtain ⟨B, hB, _, hfactor⟩ := exists_analytic_normal_factor_of_boundary_zero hfL hz
  refine ⟨B ∘ L.symm, hB.comp_of_eq (L.symm.analyticAt 0) L.symm.map_zero, ?_⟩
  have hti : Tendsto L.symm (𝓝 (0 : V)) (𝓝 (0 : Y × ℝ)) := by
    simpa using L.symm.continuous.tendsto 0
  filter_upwards [hti.eventually hfactor] with x hx
  simpa only [Function.comp_apply, ContinuousLinearEquiv.apply_symm_apply,
    L, euclideanHalfSpaceBoundaryNormalEquiv_symm_apply_snd] using hx

end ConformalPoisson

