/- Boundary analytic support: AnalyticWithinOfFactorialBounds.lean, SHA256 bb572267cf3ac747431d1ac261f2f4d2fbe07fc8f66378751da62f51d21e18b4 -/
noncomputable section ProofPart_BoundaryAnalytic_AnalyticWithinOfFactorialBounds



/- Uniform factorial bounds on a convex physical set give an actual
convergent relative power series of the SAME function. This is the required
one-sided analytic-germ criterion. -/
open Set Metric Filter Topology
open scoped ContDiff NNReal ENNReal BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

set_option maxHeartbeats 1800000 in
without_proof_info in
theorem analyticWithinAt_zero_of_uniform_factorial_bounds
    {S : Set E} (hS : UniqueDiffOn ℝ S) (hconv : Convex ℝ S) (h0 : (0 : E) ∈ S)
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    {M D : ℝ} (hM : 0 ≤ M) (hD : 0 < D)
    (hbound : ∀ x ∈ S, ∀ k, ‖iteratedFDerivWithin ℝ k f S x‖ ≤
      M * D ^ k * (k.factorial : ℝ)) : AnalyticWithinAt ℝ f S 0 := by
  let p := relativeTaylorPowerSeries f S 0
  let R : ℝ≥0 := ⟨D⁻¹, inv_nonneg.mpr hD.le⟩
  have hRp : 0 < R := by change 0 < D⁻¹; exact inv_pos.mpr hD
  have hRradius : (R : ℝ≥0∞) ≤ p.radius := by
    apply p.le_radius_of_bound M
    intro k
    change ‖p k‖ * (D⁻¹) ^ k ≤ M
    calc
      _ ≤ (M * D ^ k) * (D⁻¹) ^ k := mul_le_mul_of_nonneg_right
        (norm_relativeTaylorPowerSeries_le hM hD.le (hbound 0 h0) k) (by positivity)
      _ = M := by rw [mul_assoc, ← mul_pow, mul_inv_cancel₀ hD.ne', one_pow, mul_one]
  refine ⟨p, R, hRradius, ENNReal.coe_pos.mpr hRp, ?_⟩
  intro y hy hball
  have hyS : y ∈ S := by simpa only [zero_add, insert_eq_of_mem h0] using hy
  have hynorm : ‖y‖ < D⁻¹ := by
    rw [Metric.eball_coe] at hball
    exact mem_ball_zero_iff.mp hball
  let r : ℝ := D * ‖y‖
  have hr0 : 0 ≤ r := mul_nonneg hD.le (norm_nonneg y)
  have hr : r < 1 := by
    have ht := mul_lt_mul_of_pos_left hynorm hD
    simpa only [mul_inv_cancel₀ hD.ne'] using ht
  have hsmall : y ∈ Metric.eball (0 : E) p.radius :=
    Metric.mem_eball.mpr ((Metric.mem_eball.mp hball).trans_le hRradius)
  have hsum := p.hasSum hsmall
  have hn := tendsto_self_mul_const_pow_of_lt_one hr0 hr
  have hp := tendsto_pow_atTop_nhds_zero_of_lt_one hr0 hr
  have hupper : Tendsto (fun N : ℕ => M * (N + 1 : ℝ) * r ^ (N + 1)) atTop (𝓝 0) := by
    have ht := (hn.add hp).const_mul (M * r)
    simp only [add_zero, mul_zero] at ht
    convert ht using 1
    funext N
    rw [pow_succ]
    push_cast
    ring
  have hTaylor : Tendsto (fun N : ℕ => ∑ k ∈ Finset.range (N + 1), p k (fun _ => y))
      atTop (𝓝 (f y)) := by
    apply tendsto_iff_norm_sub_tendsto_zero.mpr
    apply squeeze_zero (fun _ => norm_nonneg _) (fun N => ?_) hupper
    simpa only [norm_sub_rev] using relative_taylor_remainder_bound hS hconv h0 hf hbound hyS N
  have hsumShift := hsum.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
  have heq : f y = p.sum y := tendsto_nhds_unique hTaylor hsumShift
  simpa only [zero_add, heq] using hsum

end ConformalPoisson

end ProofPart_BoundaryAnalytic_AnalyticWithinOfFactorialBounds

