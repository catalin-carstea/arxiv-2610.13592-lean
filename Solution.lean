noncomputable section ProofPart_BoundaryAnalytic_MixedDerivativeLeibniz


/- The mixed Leibniz estimate retains separate tangential and normal
binomial coefficients, so lower normal order is preserved in the induction. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

set_option maxHeartbeats 1500000 in
without_proof_info in
theorem norm_mixedDerivativeWithin_mul_le
    {S : Set E} (hS : IsOpen S) {f g : E → ℝ}
    (hf : ContDiffOn ℝ ∞ f S) (hg : ContDiffOn ℝ ∞ g S)
    {x : E} (hx : x ∈ S) (P : E →L[ℝ] E) (e : E) (p q : ℕ) :
    ‖mixedDerivativeWithin S P e p q (f * g) x‖ ≤
      ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
        (p.choose a : ℝ) * (q.choose b : ℝ) *
          ‖mixedDerivativeWithin S P e a b f x‖ *
          ‖mixedDerivativeWithin S P e (p - a) (q - b) g x‖ := by
  classical
  let φ := derivativeAffineParameter x P
  let U : Set E := φ ⁻¹' S
  have hU : IsOpen U := hS.preimage φ.continuous
  have h0 : (0 : E) ∈ U := by simpa [U, φ] using hx
  let F : ℕ → E → ℝ := fun j y => normalDerivativeWithin S e j f (φ y)
  let G : ℕ → E → ℝ := fun j y => normalDerivativeWithin S e j g (φ y)
  have hφ : ContDiffOn ℝ ∞ φ U :=
    (contDiff_const.add P.contDiff).contDiffOn
  have hF (j : ℕ) : ContDiffOn ℝ ∞ (F j) U :=
    (contDiffOn_normalDerivativeWithin hS.uniqueDiffOn hf e j).comp hφ (fun _ hy => hy)
  have hG (j : ℕ) : ContDiffOn ℝ ∞ (G j) U :=
    (contDiffOn_normalDerivativeWithin hS.uniqueDiffOn hg e j).comp hφ (fun _ hy => hy)
  have hsum : EqOn (fun y => normalDerivativeWithin S e q (f * g) (φ y))
      (fun y => ∑ b ∈ Finset.range (q + 1), (q.choose b : ℝ) * F b y * G (q - b) y) U := by
    intro y hy
    exact iteratedFDerivWithinAlong_replicate_mul hS hf hg hy e q
  have hreadF (a b : ℕ) : iteratedFDerivWithin ℝ a (F b) U 0 =
      mixedDerivativeWithin S P e a b f x := by
    rw [iteratedFDerivWithin_of_isOpen a hU h0]
    exact (mixedDerivativeWithin_eq_iteratedFDeriv_parameter hS hf hx P e a b).symm
  have hreadG (a b : ℕ) : iteratedFDerivWithin ℝ a (G b) U 0 =
      mixedDerivativeWithin S P e a b g x := by
    rw [iteratedFDerivWithin_of_isOpen a hU h0]
    exact (mixedDerivativeWithin_eq_iteratedFDeriv_parameter hS hg hx P e a b).symm
  have hterm (b : ℕ) :
      ‖iteratedFDerivWithin ℝ p (fun y => (q.choose b : ℝ) * F b y * G (q - b) y) U 0‖ ≤
        (q.choose b : ℝ) * ∑ a ∈ Finset.range (p + 1), (p.choose a : ℝ) *
          ‖mixedDerivativeWithin S P e a b f x‖ *
          ‖mixedDerivativeWithin S P e (p - a) (q - b) g x‖ := by
    have hprod : (fun y => (q.choose b : ℝ) * F b y * G (q - b) y) =
        (q.choose b : ℝ) • (fun y => F b y * G (q - b) y) := by
      funext y
      simp [Pi.smul_apply, mul_assoc]
    rw [hprod, iteratedFDerivWithin_const_smul_apply
      (((hF b).mul (hG (q - b))) 0 h0 |>.of_le (by simp)) hU.uniqueDiffOn h0,
      norm_smul, Real.norm_of_nonneg (Nat.cast_nonneg _)]
    have hbnd := norm_iteratedFDerivWithin_mul_le (hF b) (hG (q - b))
      hU.uniqueDiffOn h0 (n := p) (by simp)
    simp_rw [hreadF, hreadG] at hbnd
    exact mul_le_mul_of_nonneg_left hbnd (Nat.cast_nonneg _)
  have hsumC (b : ℕ) :
      ContDiffWithinAt ℝ p (fun y => (q.choose b : ℝ) * F b y * G (q - b) y) U 0 :=
    ((((hF b).const_smul (q.choose b : ℝ)).mul (hG (q - b))) 0 h0).of_le (by simp)
  have hfg : ContDiffOn ℝ ∞ (f * g) S := hf.mul hg
  rw [mixedDerivativeWithin_eq_iteratedFDeriv_parameter hS hfg hx P e p q]
  change ‖iteratedFDeriv ℝ p (fun y => normalDerivativeWithin S e q (f * g) (φ y)) 0‖ ≤ _
  rw [← iteratedFDerivWithin_of_isOpen p hU h0, iteratedFDerivWithin_congr hsum h0 p,
    iteratedFDerivWithin_fun_sum_apply hU.uniqueDiffOn h0 (fun b _ => hsumC b)]
  calc
    _ ≤ ∑ b ∈ Finset.range (q + 1),
        ‖iteratedFDerivWithin ℝ p (fun y => (q.choose b : ℝ) * F b y * G (q - b) y) U 0‖ :=
      norm_sum_le _ _
    _ ≤ ∑ b ∈ Finset.range (q + 1), (q.choose b : ℝ) *
        ∑ a ∈ Finset.range (p + 1), (p.choose a : ℝ) *
          ‖mixedDerivativeWithin S P e a b f x‖ *
          ‖mixedDerivativeWithin S P e (p - a) (q - b) g x‖ :=
      Finset.sum_le_sum (fun b _ => hterm b)
    _ = _ := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro a _
      apply Finset.sum_congr rfl
      intro b _
      ring

end ConformalPoisson

