/- Proof support: AmbientCarlemanIntegrals.lean, SHA256 5d7198a9067b20e7794a8ebbb8db3f401abd323f5808ab797c02858c99471225 -/
noncomputable section ProofPart_AmbientCarlemanIntegrals



/- Both actual ambient weighted integrals are the corresponding
coordinate integrals with the same density/exponential weight. The
operator sign disappears only after squaring, as in the Carleman estimate. -/
open Bundle Set MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold Filter
open scoped Manifold ContDiff Topology ENNReal
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {d : ℕ} (D : Opens (EuclideanSpace ℝ (Fin d)))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) ∞
    (EuclideanSpace ℝ (Fin d)) (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [MeasurableSpace D] [BorelSpace D]

local instance : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d))
    (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle
    (IB := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) (n := ∞)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem integral_ambient_weighted_value (p : D) (φ : D → ℝ) (τ : ℝ)
    {U : Opens (EuclideanSpace ℝ (Fin d))} (hUD : U ≤ D)
    (f : EuclideanSpace ℝ (Fin d) → ℝ) (hfs : tsupport f ⊆ U) :
    (∫ x : D, Real.exp (2 * τ * φ x) * f x ^ 2
      ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D) =
      ∫ z in (U : Set _), ambientDensityExponentialWeight D p φ τ z ^ 2 * f z ^ 2
        ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar := by
  have he := setIntegral_ambient_chart D p hUD (fun x : D => Real.exp (2 * τ * φ x) * f x ^ 2)
  have hs : (∫ x in (Subtype.val ⁻¹' (U : Set _) : Set D), Real.exp (2 * τ * φ x) * f x ^ 2
      ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D) =
      ∫ x : D, Real.exp (2 * τ * φ x) * f x ^ 2
        ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D := by
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro x hx
    have hz : f (x : EuclideanSpace ℝ (Fin d)) = 0 :=
      image_eq_zero_of_notMem_tsupport (fun ht => hx (hfs ht))
    simp only [hz, zero_pow (by decide : 2 ≠ 0), mul_zero]
  rw [hs] at he
  refine he.trans ?_
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem U.isOpen.measurableSet] with z hz
  rw [ambientDensityExponentialWeight_sq, ambient_extChartAt_symm_val D p (hUD hz)]
  ring

set_option maxHeartbeats 600000 in
without_proof_info in
theorem integral_ambient_weighted_operator (p : D) (φ : D → ℝ) (τ : ℝ)
    {U : Opens (EuclideanSpace ℝ (Fin d))} (hUD : U ≤ D) (q : D → ℝ)
    {f : EuclideanSpace ℝ (Fin d) → ℝ} (hf : ContDiff ℝ 2 f) (hfs : tsupport f ⊆ U) :
    (∫ x : D, Real.exp (2 * τ * φ x) *
      (laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) (fun y : D => f y) x - q x * f x) ^ 2
        ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) D) =
      ∫ z in (U : Set _), ambientDensityExponentialWeight D p φ τ z ^ 2 *
        coordinateSchrodinger (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
          (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
          (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q) f z ^ 2
            ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar := by
  let g := coordinateSchrodinger
    (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
    (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
    (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q) f
  have hgs : tsupport g ⊆ U := (tsupport_coordinateSchrodinger_subset _ _ _ f).trans hfs
  have he := integral_ambient_weighted_value D p φ τ hUD g hgs
  refine (integral_congr_ae ?_).trans he
  exact Eventually.of_forall fun x => by
    have hread := coordinateSchrodinger_ambient_restriction D p x q hf
    change Real.exp (2 * τ * φ x) *
      (laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) (fun y : D => f y) x - q x * f x) ^ 2 =
      Real.exp (2 * τ * φ x) * g (x : EuclideanSpace ℝ (Fin d)) ^ 2
    dsimp only [g]
    rw [hread]
    ring
end ConformalPoisson

end ProofPart_AmbientCarlemanIntegrals

