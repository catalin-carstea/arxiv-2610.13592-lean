      𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
      (fun p : boundaryParameterDomain V × ℝ => R.map p.1 p.2) (x, t)
    inner ℝ (D (v, 0)) (D (0, 1)) = 0 := by
  dsimp only
