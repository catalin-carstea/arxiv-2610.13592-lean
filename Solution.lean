    (hJinterior : ∀ x ∈ U, J x ∈ (𝓡∂ (n + 1)).interior M₂)
    (hc : ∀ x ∈ U, c x ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x)) :
    ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun x : U => J x) ∧
      (∀ x : U, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun x : U => J x) x).IsInvertible) ∧
      ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun x : U => c x) := by
  obtain ⟨_, hcω, hlocal⟩ := native_scaled_solution_relation_regularity hSchauder
    hRunge₁ hRunge₂ hReg₁ hReg₂ hdim hcompact₁ hcompact₂ hconnected₁ hconnected₂
    A₁ A₂ V₁ V₂ D U hU J c hJcont hJinterior hc hrel
  have hopen : IsLocalDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω (fun x : U => J x) := by
