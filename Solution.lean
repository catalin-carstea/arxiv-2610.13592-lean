  refine ⟨nativeSmoothValueLinearMap G, ⟨G, rfl⟩, ?_⟩
  apply lt_of_le_of_lt ((ContinuousMap.dist_le (half_pos hε).le).2 fun x => by
    change dist (F x) (G x) ≤ ε / 2
    rw [dist_comm]
    exact (hG x).le)
  exact half_lt_self hε

