noncomputable section ProofPart_BoundaryParametricNormal


/- Joint smoothness of the supplied unit-normal trace follows from its
pointwise geometric specification, with no extra normal-field premise. -/
open Bundle Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local instance boundaryParametricAnalytic : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M) :=
  TauCeti.isManifold_boundary M (by decide)

without_proof_info in
theorem contMDiffAt_parametric_normalDerivative
    (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    {G : E → M → ℝ} {x : E} {y : (𝓡∂ (n + 1)).boundary M}
    (hG : ContMDiffAt (𝓘(ℝ, E).prod (𝓡∂ (n + 1))) 𝓘(ℝ) ∞ (uncurry G) (x, (y : M))) :
    ContMDiffAt (𝓘(ℝ, E).prod (𝓡 n)) 𝓘(ℝ) ∞
      (fun p : E × (𝓡∂ (n + 1)).boundary M => normalDerivative ν (G p.1) p.2) (x, y) := by
  let : RiemannianBundle (fun z : M => TangentSpace (𝓡∂ (n + 1)) z) := ⟨g.toRiemannianMetric⟩
  let : IsManifold (𝓡∂ (n + 1)) (∞ + 1) M := by
    simpa using (inferInstance : IsManifold (𝓡∂ (n + 1)) ∞ M)
  let f := chartBoundaryFunction (n := n) (y : M)
  have hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f (y : M) :=
    (contMDiffOn_chartBoundaryFunction (y : M) (y : M) (mem_chart_source _ _)).contMDiffAt
      ((chartAt (EuclideanHalfSpace (n + 1)) (y : M)).open_source.mem_nhds (mem_chart_source _ _))
  have hEq := (hν y).eq_nativeNegativeUnitGradient_chart g (y : M) y
    (mem_chart_source _ _) (ν y)
  have hgradient : TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) f (y : M) ≠ 0 := by
    intro hz
    have hνzero : ν y = 0 := by
      simpa only [nativeNegativeUnitGradient, f, hz, NormedSpace.normalize_zero_eq_zero,
        neg_zero] using hEq
    have hu := (hν y).2.1
    rw [hνzero] at hu
    simp only [map_zero, zero_ne_one] at hu
  let N : (z : M) → TangentSpace (𝓡∂ (n + 1)) z := nativeNegativeUnitGradient g f
  have hN : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)).tangent ∞
      (fun z => (⟨z, N z⟩ : TangentBundle (𝓡∂ (n + 1)) M)) (y : M) := by
    have hn := TauCeti.Manifold.contMDiffAt_normalize_mgradient (n := ∞)
      (by simpa using hf) hgradient
    simpa only [N, nativeNegativeUnitGradient, Pi.neg_apply] using hn.neg_section
  have hnormal := contMDiffAt_parametric_vector_derivative hG N hN
  have hinc : ContMDiff (𝓡 n) (𝓡∂ (n + 1)) ∞
      (Subtype.val : (𝓡∂ (n + 1)).boundary M → M) :=
    (TauCeti.isImmersion_subtypeVal_boundary (n := n) (k := ω) M (by decide)).contMDiff.of_le
      (by decide)
  have hcomp := hnormal.comp (x, y)
    (contMDiffAt_fst.prodMk (hinc.contMDiffAt.comp (x, y) contMDiffAt_snd))
  refine hcomp.congr_of_eventuallyEq ?_
  have hsource : ∀ᶠ p : E × (𝓡∂ (n + 1)).boundary M in 𝓝 (x, y),
      (p.2 : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) (y : M)).source :=
    (continuous_subtype_val.comp continuous_snd).continuousAt.preimage_mem_nhds
      ((chartAt (EuclideanHalfSpace (n + 1)) (y : M)).open_source.mem_nhds (mem_chart_source _ _))
  filter_upwards [hsource] with p hp
  change normalDerivative ν (G p.1) p.2 = mvfderiv (𝓡∂ (n + 1)) (G p.1) p.2 (N p.2)
  unfold normalDerivative
  rw [(hν p.2).eq_nativeNegativeUnitGradient_chart g (y : M) p.2 hp (ν p.2)]

end ConformalPoisson

