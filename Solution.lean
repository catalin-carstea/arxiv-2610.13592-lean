noncomputable section ProofPart_CarlemanIntegration


/- Integration-by-parts identities for the actual Riemannian
Carleman commutator. These are for a compactly supported smooth test
on an ambient manifold without boundary. They do not impose a
boundaryless hypothesis on the original paper manifolds. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M] [SigmaCompactSpace M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
local notation "μ" => riemannianVolume I M

set_option maxHeartbeats 600000 in
without_proof_info in
theorem integral_laplacian_gradient_transport {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hc : HasCompactSupport v) :
    (∫ x, laplaceBeltrami I v x * ⟪mgradient I φ x, mgradient I v x⟫_ℝ ∂μ) =
      -(∫ x, hessian I φ x (mgradient I v x) (mgradient I v x) ∂μ) +
        (1 / 2 : ℝ) * ∫ x, ‖mgradient I v x‖ ^ 2 * laplaceBeltrami I φ x ∂μ := by
  have hHφ : Integrable (fun x => hessian I φ x (mgradient I v x) (mgradient I v x)) μ :=
    (contMDiff_hessian_gradient_pair hφ hv hv).continuous.integrable_of_hasCompactSupport
      (hasCompactSupport_hessian_gradient_pair hc)
  have hHv : Integrable (fun x => hessian I v x (mgradient I v x) (mgradient I φ x)) μ :=
    (contMDiff_hessian_gradient_pair hv hv hφ).continuous.integrable_of_hasCompactSupport
      (hasCompactSupport_hessian_gradient_pair hc)
  have hgrad : (∫ x, ⟪mgradient I (fun y => ⟪mgradient I φ y, mgradient I v y⟫_ℝ) x,
      mgradient I v x⟫_ℝ ∂μ) =
      (∫ x, hessian I φ x (mgradient I v x) (mgradient I v x) ∂μ) +
      ∫ x, hessian I v x (mgradient I v x) (mgradient I φ x) ∂μ := by
    rw [← integral_add hHφ hHv]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun x => by
      dsimp only
      rw [real_inner_comm]
      exact inner_gradient_inner_gradients_eq_hessians hφ hv x)
  have hgreen := integral_mul_laplaceBeltrami ((smooth_inner_mgradients hφ hv).of_le (by simp))
    (hasCompactSupport_inner_mgradients_right hc) (hv.of_le (by simp))
  rw [hgrad] at hgreen
  have hnorm := integral_mul_laplaceBeltrami ((smooth_normSq_mgradient hv).of_le (by simp))
    (hasCompactSupport_normSq_mgradient hc) (hφ.of_le (by simp))
  have hnormgrad : (∫ x, ⟪mgradient I (fun y => ‖mgradient I v y‖ ^ 2) x,
      mgradient I φ x⟫_ℝ ∂μ) =
      2 * ∫ x, hessian I v x (mgradient I v x) (mgradient I φ x) ∂μ := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun x => by
      dsimp only
      rw [real_inner_comm]
      exact inner_gradient_normSq_gradient_eq_hessian hv x)
  rw [hnormgrad] at hnorm
  have hcomm : (∫ x, laplaceBeltrami I v x * ⟪mgradient I φ x, mgradient I v x⟫_ℝ ∂μ) =
      ∫ x, ⟪mgradient I φ x, mgradient I v x⟫_ℝ * laplaceBeltrami I v x ∂μ := by
    exact integral_congr_ae (Filter.Eventually.of_forall fun x => mul_comm _ _)
  rw [hcomm]
  linarith
end ConformalPoisson

