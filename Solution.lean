  [IsScalarTower ℝ ℂ E] [FiniteDimensional ℂ E]
  [TopologicalSpace K] [CompactSpace K]

/-- Restrict a complex covector to the actual real spatial directions. -/
def restrictPrecompL (ι : V →L[ℝ] E) :
    (E →L[ℂ] ℂ) →L[ℂ] (V →L[ℝ] ℂ) := by
  let L : (E →L[ℂ] ℂ) →ₗ[ℂ] (V →L[ℝ] ℂ) :=
    { toFun := fun Q => (Q.restrictScalars ℝ).comp ι
      map_add' := fun Q R => by ext v; simp
      map_smul' := fun c Q => by ext v; simp }
  exact L.mkContinuous ‖ι‖ (fun Q => by
    change ‖(Q.restrictScalars ℝ).comp ι‖ ≤ ‖ι‖ * ‖Q‖
    simpa only [ContinuousLinearMap.norm_restrictScalars, mul_comm] using
      (Q.restrictScalars ℝ).opNorm_comp_le ι)

without_proof_info in
@[simp] theorem restrictPrecompL_apply (ι : V →L[ℝ] E) (Q : E →L[ℂ] ℂ) (v : V) :
    restrictPrecompL ι Q v = Q (ι v) := rfl

def embeddedTranslationDerivative (ι : V →L[ℝ] E) (F : E → ℂ)
    (i : K → E) (χ : K → ℂ) (η : K → (V →L[ℝ] ℂ)) (p : E) :
    C(K, V →L[ℝ] ℂ) :=
  ContinuousMap.mkD (fun k =>
    restrictPrecompL ι (fderiv ℂ F (i k + χ k • p)) +
      (fderiv ℂ F (i k + χ k • p) p) • η k) 0

without_proof_info in
theorem analyticAt_embeddedTranslationDerivative
    (ι : V →L[ℝ] E) (F : E → ℂ) (i : K → E) (χ : K → ℂ)
    (η : K → (V →L[ℝ] ℂ)) (hi : Continuous i) (hχ : Continuous χ)
    (hη : Continuous η) (hF : ∀ k, AnalyticAt ℂ F (i k)) :
    AnalyticAt ℂ (embeddedTranslationDerivative ι F i χ η) 0 := by
  letI : CompleteSpace E := FiniteDimensional.complete ℂ E
  let Q : E × (E × ℂ × (V →L[ℝ] ℂ)) → (V →L[ℝ] ℂ) := fun z =>
    restrictPrecompL ι (fderiv ℂ F (z.2.1 + z.2.2.1 • z.1)) +
      fderiv ℂ F (z.2.1 + z.2.2.1 • z.1) z.1 • z.2.2.2
  have hQ (k : K) : AnalyticAt ℂ Q (0, (i k, χ k, η k)) := by
    have harg : AnalyticAt ℂ
        (fun z : E × (E × ℂ × (V →L[ℝ] ℂ)) => z.2.1 + z.2.2.1 • z.1)
        (0, (i k, χ k, η k)) :=
      (contDiffAt_snd.fst.add
        (contDiffAt_snd.snd.fst.smul contDiffAt_fst)).analyticAt
    have hD := (hF k).fderiv.comp_of_eq harg (by simp)
    exact (((restrictPrecompL ι).analyticAt _).comp hD).add
      ((hD.contDiffAt.clm_apply contDiffAt_fst).smul
        contDiffAt_snd.snd.snd).analyticAt
  exact TauCeti.analyticAt_mkD_of_analyticAt (hi.prodMk (hχ.prodMk hη)) hQ

without_proof_info in
theorem hasFDerivAt_embedded_localized_coefficient
    (ι : V →L[ℝ] E) (F : E → ℂ) (χ : V → ℝ) (p : E) (x : V)
    (hχ : DifferentiableAt ℝ χ x) (hF : AnalyticAt ℂ F (ι x + χ x • p)) :
    HasFDerivAt (fun y => F (ι y + χ y • p))
      (restrictPrecompL ι (fderiv ℂ F (ι x + χ x • p)) +
        fderiv ℂ F (ι x + χ x • p) p • (Complex.ofRealCLM.comp (fderiv ℝ χ x))) x := by
  let Q := fderiv ℂ F (ι x + χ x • p)
  have hPhi := ι.hasFDerivAt.add (hχ.hasFDerivAt.smul_const p)
  have hchain : HasFDerivAt (fun y => F (ι y + χ y • p))
      ((Q.restrictScalars ℝ).comp (ι + (fderiv ℝ χ x).smulRight p)) x :=
    (hF.differentiableAt.hasFDerivAt.restrictScalars ℝ).comp x hPhi
  have hlin : restrictPrecompL ι Q +
      Q p • (Complex.ofRealCLM.comp (fderiv ℝ χ x)) =
      (Q.restrictScalars ℝ).comp (ι + (fderiv ℝ χ x).smulRight p) := by
    ext v
    simp only [ContinuousLinearMap.add_apply, restrictPrecompL_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.coe_restrictScalars, ContinuousLinearMap.smulRight_apply,
      map_add]
    rw [← algebraMap_smul ℝ (fderiv ℝ χ x v) p, map_smul]
    simp [smul_eq_mul, mul_comm]
  rw [show fderiv ℂ F (ι x + χ x • p) = Q from rfl, hlin]
  exact hchain

