      ((extChartAt (𝓡∂ (n + 1)) α).symm (A.chart (z : V)))) :
    coordinateSchrodinger (chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, V)) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, V)) p Qnormal)
