open scoped BigOperators
namespace ConformalPoisson

set_option maxHeartbeats 1400000 in
without_proof_info in
theorem exists_uniform_factorial_normal_majorant
    {X ι : Type*} [Fintype ι]
    (D : X → ℕ → ℕ → ℝ) (k ell : ι → ℕ) (L : ι → ℝ) (A F M0 B0 : ℝ)
    (hA : 0 ≤ A) (hF : 0 ≤ F) (hM0 : 0 ≤ M0) (hB0 : 0 ≤ B0)
    (hL : ∀ i, 0 ≤ L i) (hell : ∀ i, ell i ≤ 1) (hkell : ∀ i, k i + ell i ≤ 2)
    (hbase : ∀ x p j, j ≤ 1 → D x p j ≤ M0 * B0 ^ p * (p.factorial : ℝ))
    (hrec : ∀ x p q, D x p (q + 2) ≤ F * A ^ (p + q) * ((p + q).factorial : ℝ) +
      ∑ i, ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
        (p.choose a : ℝ) * (q.choose b : ℝ) *
          (L i * A ^ (a + b) * ((a + b).factorial : ℝ)) *
          D x (p - a + k i) (q - b + ell i)) :
    ∃ M B C : ℝ, 0 < M ∧ 0 < B ∧ 0 < C ∧ B ≤ C ∧
      ∀ x p j, D x p j ≤ M * B ^ p * C ^ j * ((p + j).factorial : ℝ) := by
  classical
  let B : ℝ := max 1 (max (2 * A) B0)
  let H : ℝ := max 1 (∑ i, L i)
  let C : ℝ := 8 * H * B
  let M : ℝ := max 1 (max M0 F)
  have hB1 : 1 ≤ B := le_max_left _ _
  have hAB : 2 * A ≤ B := (le_max_left _ _).trans (le_max_right _ _)
  have hB0B : B0 ≤ B := (le_max_right _ _).trans (le_max_right _ _)
  have hH1 : 1 ≤ H := le_max_left _ _
  have hLH : ∑ i, L i ≤ H := le_max_right _ _
  have hM1 : 1 ≤ M := le_max_left _ _
  have hM0M : M0 ≤ M := (le_max_left _ _).trans (le_max_right _ _)
  have hFM : F ≤ M := (le_max_right _ _).trans (le_max_right _ _)
  have hBp : 0 < B := lt_of_lt_of_le zero_lt_one hB1
  have hMp : 0 < M := lt_of_lt_of_le zero_lt_one hM1
  have hHB : B ≤ H * B := by
    simpa using mul_le_mul_of_nonneg_right hH1 hBp.le
  have hC8 : 8 ≤ C := by dsimp [C]; nlinarith
  have hCp : 0 < C := by linarith
  have hBC : B ≤ C := by dsimp [C]; nlinarith
  have hC2 : 2 ≤ C ^ 2 := by nlinarith [sq_nonneg (C - 8)]
  have hweights : ∑ i, L i * (B ^ k i / C ^ (2 - ell i)) ≤ 1 / 8 :=
    normal_majorant_sum_weights_le L k ell B H hL hB1 hH1 hLH hell hkell
  refine ⟨M, B, C, hMp, hBp, hCp, hBC, ?_⟩
  intro x
  apply factorial_normal_majorant_of_recurrence (D x) k ell L A B C F M hA hBp hCp hF hFM
    hAB (hAB.trans hBC) hC2 hL hell hkell hweights
  · intro p j hj
    have hpow : B0 ^ p ≤ B ^ p := pow_le_pow_left₀ hB0 hB0B p
    have hMB : M0 * B0 ^ p ≤ M * B ^ p :=
      mul_le_mul hM0M hpow (pow_nonneg hB0 p) hMp.le
    have hfac : (p.factorial : ℝ) ≤ ((p + j).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_le (Nat.le_add_right p j)
    calc
      D x p j ≤ M0 * B0 ^ p * (p.factorial : ℝ) := hbase x p j hj
      _ ≤ M * B ^ p * ((p + j).factorial : ℝ) :=
        mul_le_mul hMB hfac (Nat.cast_nonneg _) (by positivity)
      _ ≤ M * B ^ p * C ^ j * ((p + j).factorial : ℝ) := by
        have hCpow : 1 ≤ C ^ j := one_le_pow₀ (by linarith : 1 ≤ C)
        have ht := mul_le_mul_of_nonneg_left hCpow
          (show 0 ≤ M * B ^ p * ((p + j).factorial : ℝ) by positivity)
        nlinarith
  · exact hrec x

end ConformalPoisson

