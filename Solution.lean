noncomputable section ProofPart_BoundaryAnalytic_MixedDerivativeNormBound



/- Contractive tangent projection and a unit normal make every mixed
coefficient jet bounded by its full derivative of the same total order. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem norm_mixedDerivativeWithin_le_full
    {S : Set E} (hS : UniqueDiffOn ℝ S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    {x : E} (hx : x ∈ S) (P : E →L[ℝ] E) (hP : ∀ v, ‖P v‖ ≤ ‖v‖)
    (e : E) (he : ‖e‖ ≤ 1) (p q : ℕ) :
    ‖mixedDerivativeWithin S P e p q f x‖ ≤ ‖iteratedFDerivWithin ℝ (p + q) f S x‖ := by
  classical
  apply ContinuousMultilinearMap.opNorm_le_bound (norm_nonneg _)
  intro m
  let v : Fin (p + q) → E := Fin.append (fun i : Fin p => P (m i)) (fun _ : Fin q => e)
  have hword := iteratedFDerivWithinAlong_ofFn hS hf v hx
  have hlist : List.ofFn v = List.ofFn (fun i : Fin p => P (m i)) ++ List.replicate q e := by
    rw [List.ofFn_fin_append, List.ofFn_const]
  rw [hlist] at hword
  rw [mixedDerivativeWithin_apply_eq_word hS hf hx P e p q m, hword]
  have hprodP : (∏ i : Fin p, ‖P (m i)‖) ≤ ∏ i : Fin p, ‖m i‖ :=
    Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => hP (m i))
  have hepow : ‖e‖ ^ q ≤ 1 := pow_le_one₀ (norm_nonneg e) he
  have hprod : (∏ i : Fin (p + q), ‖v i‖) ≤ ∏ i : Fin p, ‖m i‖ := by
    have heq : (∏ i : Fin (p + q), ‖v i‖) = (∏ i : Fin p, ‖P (m i)‖) * ‖e‖ ^ q := by
      simp [v, Fin.prod_univ_add]
    rw [heq]
    calc
      _ ≤ (∏ i : Fin p, ‖m i‖) * 1 :=
        mul_le_mul hprodP hepow (pow_nonneg (norm_nonneg e) q) (by positivity)
      _ = _ := mul_one _
  exact ((iteratedFDerivWithin ℝ (p + q) f S x).le_opNorm v).trans
    (mul_le_mul_of_nonneg_left hprod (norm_nonneg _))

without_proof_info in
theorem norm_mixedDerivativeWithin_boundary_le_full
    {n : ℕ} {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {S : Set (EuclideanSpace ℝ (Fin (n + 1)))} (hS : UniqueDiffOn ℝ S)
    {f : EuclideanSpace ℝ (Fin (n + 1)) → F} (hf : ContDiffOn ℝ ∞ f S)
    {x : EuclideanSpace ℝ (Fin (n + 1))} (hx : x ∈ S) (p q : ℕ) :
    ‖mixedDerivativeWithin S boundaryTangentialProjection (EuclideanSpace.single 0 1) p q f x‖ ≤
      ‖iteratedFDerivWithin ℝ (p + q) f S x‖ :=
  norm_mixedDerivativeWithin_le_full hS hf hx boundaryTangentialProjection
    norm_boundaryTangentialProjection_le _ (by simp) p q

end ConformalPoisson

end ProofPart_BoundaryAnalytic_MixedDerivativeNormBound

/- Boundary analytic support: NormalMajorantCombinatorics.lean, SHA256 19c0ecd9a8af43c040c5352c20e35825c93cfbc94407c8f27c3e6e013c4bbda2 -/
noncomputable section ProofPart_BoundaryAnalytic_NormalMajorantCombinatorics




/- The nonoptimal numerical majorant needed for normal-order induction.
Vandermonde controls mixed Leibniz coefficients without a dimension-dependent
loss at each derivative order. -/
open scoped BigOperators
namespace ConformalPoisson

without_proof_info in
theorem choose_mul_le_choose_add (p q a b : ℕ) :
    p.choose a * q.choose b ≤ (p + q).choose (a + b) := by
  rw [Nat.add_choose_eq]
  exact Finset.single_le_sum (s := Finset.antidiagonal (a + b)) (a := (a, b))
    (f := fun ij : ℕ × ℕ => p.choose ij.1 * q.choose ij.2)
    (fun _ _ => Nat.zero_le _) (by simp)

without_proof_info in
theorem mixedLeibniz_factorial_le (p q a b k ell : ℕ)
    (ha : a ≤ p) (hb : b ≤ q) (hkell : k + ell ≤ 2) :
    p.choose a * q.choose b * (a + b).factorial *
      (p - a + (q - b) + k + ell).factorial ≤ (p + q + 2).factorial := by
  have hc : p.choose a * q.choose b ≤ (p + q + 2).choose (a + b) :=
    (choose_mul_le_choose_add p q a b).trans (Nat.choose_le_choose _ (by omega))
  have hr : p - a + (q - b) + k + ell ≤ p + q + 2 - (a + b) := by omega
  calc
    _ ≤ (p + q + 2).choose (a + b) * (a + b).factorial *
        (p + q + 2 - (a + b)).factorial :=
      Nat.mul_le_mul (Nat.mul_le_mul_right _ hc) (Nat.factorial_le hr)
    _ = _ := Nat.choose_mul_factorial_mul_factorial (by omega)

without_proof_info in
theorem geometric_sum_le_two {r : ℝ} (hr0 : 0 ≤ r) (hr : r ≤ 1 / 2) (m : ℕ) :
    ∑ i ∈ Finset.range m, r ^ i ≤ 2 := by
  have hsum0 : 0 ≤ ∑ i ∈ Finset.range m, r ^ i :=
    Finset.sum_nonneg (fun i _ => pow_nonneg hr0 i)
  have hpow0 := pow_nonneg hr0 m
  have hgeom := geom_sum_mul_neg r m
  nlinarith

without_proof_info in
theorem double_geometric_sum_le_four {r s : ℝ}
    (hr0 : 0 ≤ r) (hr : r ≤ 1 / 2) (hs0 : 0 ≤ s) (hs : s ≤ 1 / 2)
    (p q : ℕ) :
    (∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1), r ^ a * s ^ b) ≤ 4 := by
  have heq : (∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1), r ^ a * s ^ b) =
      (∑ a ∈ Finset.range (p + 1), r ^ a) * (∑ b ∈ Finset.range (q + 1), s ^ b) := by
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
  rw [heq]
  have hrb := geometric_sum_le_two hr0 hr (p + 1)
  have hsb := geometric_sum_le_two hs0 hs (q + 1)
  have hrn : 0 ≤ ∑ a ∈ Finset.range (p + 1), r ^ a :=
    Finset.sum_nonneg (fun a _ => pow_nonneg hr0 a)
  have hsn : 0 ≤ ∑ b ∈ Finset.range (q + 1), s ^ b :=
    Finset.sum_nonneg (fun b _ => pow_nonneg hs0 b)
  nlinarith

end ConformalPoisson

end ProofPart_BoundaryAnalytic_NormalMajorantCombinatorics

/- Boundary analytic support: NormalMajorantInduction.lean, SHA256 27c98c1bf4a38d4a61f6e4c5302b999acb79322de48599e62df11093ad017305 -/
noncomputable section ProofPart_BoundaryAnalytic_NormalMajorantInduction


/- Strong induction only in normal order, with all tangential orders
available at each earlier normal order. The geometric margins are fixed
before differentiating the equation. -/
open scoped BigOperators
namespace ConformalPoisson

set_option maxHeartbeats 800000 in
without_proof_info in
theorem normal_majorant_le_one
    {ι : Type*} [Fintype ι]
    (E : ℕ → ℕ → ℝ) (k ell : ι → ℕ) (γ : ι → ℝ) (r s : ℝ)
    (hr0 : 0 ≤ r) (hr : r ≤ 1 / 2) (hs0 : 0 ≤ s) (hs : s ≤ 1 / 2)
    (hell : ∀ i, ell i ≤ 1) (hγ : ∀ i, 0 ≤ γ i) (hγsum : ∑ i, γ i ≤ 1 / 8)
    (hbase : ∀ p j, j ≤ 1 → E p j ≤ 1)
    (hrec : ∀ p q,
      E p (q + 2) ≤ 1 / 2 + ∑ i, γ i *
        ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
          r ^ a * s ^ b * E (p - a + k i) (q - b + ell i)) :
    ∀ p j, E p j ≤ 1 := by
  classical
  intro p j
  induction j using Nat.strong_induction_on generalizing p with
  | ind j ih =>
    by_cases hj : j ≤ 1
    · exact hbase p j hj
    · obtain ⟨q, rfl⟩ : ∃ q, j = q + 2 := ⟨j - 2, by omega⟩
      have hinner (i : ι) :
          (∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
            r ^ a * s ^ b * E (p - a + k i) (q - b + ell i)) ≤ 4 := by
        calc
          _ ≤ ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1), r ^ a * s ^ b := by
            apply Finset.sum_le_sum
            intro a ha
            apply Finset.sum_le_sum
            intro b hb
            have horder : q - b + ell i < q + 2 := by have := hell i; omega
            have hbound := ih (q - b + ell i) horder (p - a + k i)
            have hw : 0 ≤ r ^ a * s ^ b := mul_nonneg (pow_nonneg hr0 a) (pow_nonneg hs0 b)
            exact mul_le_of_le_one_right hw hbound
          _ ≤ 4 := double_geometric_sum_le_four hr0 hr hs0 hs p q
      calc
        E p (q + 2) ≤ 1 / 2 + ∑ i, γ i *
            ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
              r ^ a * s ^ b * E (p - a + k i) (q - b + ell i) := hrec p q
        _ ≤ 1 / 2 + ∑ i, γ i * 4 := by
          exact add_le_add le_rfl (Finset.sum_le_sum (fun i _ =>
            mul_le_mul_of_nonneg_left (hinner i) (hγ i)))
        _ ≤ 1 := by rw [← Finset.sum_mul]; linarith

