  calc
    _ ≤ _ := norm_sub_le _ _
    _ ≤ _ := add_le_add (norm_sub_le _ _) le_rfl
    _ ≤ _ := add_le_add (add_le_add (norm_sub_le _ _) le_rfl) le_rfl
    _ ≤ _ := add_le_add (add_le_add (add_le_add (norm_sub_le _ _) le_rfl) le_rfl) le_rfl
