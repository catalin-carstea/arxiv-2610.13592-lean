/- Classical zero first jets through the physical face supply all
Sobolev hypotheses of the actual H2 cutoff zero extension. Smoothness
is relative to the chart target; no boundary analyticity or ambient
smooth extension of the solution is assumed. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace Distributions Gradient Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω U : Opens E} {S K : Set E}
  {ι : Type*} [Fintype ι]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_local_H2_zeroExtension_of_relative_smooth_zero_firstJets
    (b : OrthonormalBasis ι ℝ E)
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set E) ⊆ K) (hΩS : (Ω : Set E) ⊆ interior S)
    {f : E → ℝ} (hf : ContDiffOn ℝ ∞ f S)
    (hf0 : ∀ x ∈ frontier (Ω : Set E), x ∈ U → f x = 0)
    (hdf0 : ∀ x ∈ frontier (Ω : Set E), x ∈ U → fderivWithin ℝ f S x = 0)
    (χ : 𝓓(U, ℝ)) :
    ∃ W : Wkp μ U 2 2, W ∈ wkp0Submodule μ U 2 2 ∧
      Wkp.value 2 W =ᵐ[μ.restrict U] (Ω : Set E).indicator (fun x => χ x * f x) := by
  obtain ⟨uW, huW⟩ := exists_wkp_of_relative_smooth (μ := μ) hS hK hKS hΩK hΩS hf 1
  let u := Wkp.firstOrder 0 uW
  have hu' : W1p.value u =ᵐ[μ.restrict Ω] f := by
    dsimp only [u]
    rw [Wkp.value_firstOrder]
    exact huW
  let g := fun i x => fderivWithin ℝ f S x (b i)
  have hg : ∀ i, ContDiffOn ℝ ∞ (g i) S :=
    fun i => relative_smooth_directional_derivative hS hf (b i)
  have hdi : ∀ i, ∃ d : W1p μ Ω 2, W1p.value d =ᵐ[μ.restrict Ω] g i := by
    intro i
    obtain ⟨di, hdi⟩ := exists_wkp_of_relative_smooth (μ := μ) hS hK hKS hΩK hΩS (hg i) 1
    refine ⟨Wkp.firstOrder 0 di, ?_⟩
    rw [Wkp.value_firstOrder]
    exact hdi
  choose d hd using hdi
  have hug : W1p.gradient u =ᵐ[μ.restrict Ω] ∇ f :=
    W1p.gradient_ae_eq_of_contDiffOn u
      ((hf.mono (hΩS.trans interior_subset)).of_le (by simp)) hu'
  have hdgrad : ∀ i, W1p.value (d i) =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient u x, b i⟫_ℝ := by
    intro i
    filter_upwards [hd i, hug, ae_restrict_mem Ω.isOpen.measurableSet] with x hdx hux hxΩ
    rw [hdx, hux, inner_gradient_left]
    change fderivWithin ℝ f S x (b i) = fderiv ℝ f x (b i)
    rw [fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp (hΩS hxΩ))]
  have hclS : closure (Ω : Set E) ⊆ S :=
    (closure_minimal hΩK hK.isClosed).trans hKS
  have hb : Bornology.IsBounded (Ω : Set E) := hK.isBounded.subset hΩK
  have hu0 : ∀ ψ : 𝓓(U, ℝ), ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x := by
    intro ψ
    exact exists_local_zeroTrace_of_continuous_frontier hb (hf.continuousOn.mono hclS)
      hf0 u hu' ψ.contDiff ψ.hasCompactSupport ψ.tsupport_subset
  have hd0 : ∀ i, ∀ ψ : 𝓓(U, ℝ), ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value (d i) x := by
    intro i ψ
    apply exists_local_zeroTrace_of_continuous_frontier hb ((hg i).continuousOn.mono hclS)
      ?_ (d i) (hd i) ψ.contDiff ψ.hasCompactSupport ψ.tsupport_subset
    intro x hx hxU
    change fderivWithin ℝ f S x (b i) = 0
    rw [hdf0 x hx hxU, ContinuousLinearMap.zero_apply]
  obtain ⟨W, hW0, hW⟩ := exists_local_H2_zeroExtension_of_local_zeroTrace_firstJets
    b u d hdgrad hu0 hd0 χ
  refine ⟨W, hW0, ?_⟩
  have hu'' := (ae_restrict_iff' Ω.isOpen.measurableSet).1 hu'
  filter_upwards [hW, ae_restrict_of_ae hu''] with x hx hux
  rw [hx]
  by_cases hxΩ : x ∈ (Ω : Set E)
  · rw [indicator_of_mem hxΩ, indicator_of_mem hxΩ, hux hxΩ]
  · rw [indicator_of_notMem hxΩ, indicator_of_notMem hxΩ]
end ConformalPoisson

end ProofPart_ClassicalCauchyZeroExtension

/- Proof support: CauchyFirstJets.lean, SHA256 906ad8de113be1feb93779c815d555d72c5d4bae478d88f1824e7f178169dae0 -/
noncomputable section ProofPart_CauchyFirstJets



/- Zero boundary values kill tangential first derivatives. One
transverse Cauchy derivative then kills the entire first differential.
The derivative is taken within the relative chart target throughout. -/
open Set Filter TopologicalSpace MeasureTheory TauCeti
open scoped ContDiff Topology Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {S : Set E} {U : Opens E} {f : E → ℝ} {x : E}

without_proof_info in
theorem fderivWithin_tangent_eq_zero_of_zero_face
    (ℓ : E →L[ℝ] ℝ) (hx : ℓ x = 0) (hxU : x ∈ U)
    (hUS : {y : E | 0 ≤ ℓ y} ∩ U ⊆ S)
    (hf : DifferentiableWithinAt ℝ f S x)
    (hzero : ∀ y ∈ U, ℓ y = 0 → f y = 0)
    (v : E) (hv : ℓ v = 0) : fderivWithin ℝ f S x v = 0 := by
  let γ : ℝ → E := fun t => x + t • v
  have hγ : HasDerivAt γ v 0 := by
    have hh := (hasDerivAt_const (0 : ℝ) x).add ((hasDerivAt_id' (0 : ℝ)).smul_const v)
    have he : ((fun _ : ℝ => x) + (fun t : ℝ => t • v)) = γ := by
      funext t
      rfl
    rw [he] at hh
    simpa only [one_smul, zero_add] using hh
  have hγℓ (t : ℝ) : ℓ (γ t) = 0 := by simp only [γ, map_add, map_smul, hx, hv, smul_zero, add_zero]
  have hγU : ∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ U := by
    apply hγ.continuousAt.tendsto.eventually
    change (U : Set E) ∈ 𝓝 (γ 0)
    simpa only [γ, zero_smul, add_zero] using U.isOpen.mem_nhds hxU
  have hγS : ∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ S :=
    hγU.mono fun t ht => hUS ⟨show 0 ≤ ℓ (γ t) from by simp only [hγℓ, le_refl], ht⟩
  have hchain := hf.hasFDerivWithinAt.comp_hasDerivAt_of_eq (0 : ℝ) hγ hγS
    (by simp only [γ, zero_smul, add_zero])
  have heq : f ∘ γ =ᶠ[𝓝 (0 : ℝ)] (fun _ => (0 : ℝ)) :=
    hγU.mono fun t ht => hzero (γ t) ht (hγℓ t)
  have he := hchain.deriv
  rw [heq.deriv_eq, deriv_const] at he
  exact he.symm

without_proof_info in
theorem fderivWithin_eq_zero_of_transverse_cauchy_data
    (ℓ : E →L[ℝ] ℝ) (hx : ℓ x = 0) (hxU : x ∈ U)
    (hUS : {y : E | 0 ≤ ℓ y} ∩ U ⊆ S)
    (hf : DifferentiableWithinAt ℝ f S x)
    (hzero : ∀ y ∈ U, ℓ y = 0 → f y = 0)
    (ν : E) (hν : ℓ ν ≠ 0) (hDν : fderivWithin ℝ f S x ν = 0) :
    fderivWithin ℝ f S x = 0 := by
  ext v
  change fderivWithin ℝ f S x v = 0
  have hk : ℓ (v - (ℓ v / ℓ ν) • ν) = 0 := by
    simp only [map_sub, map_smul, smul_eq_mul]
    field_simp [hν]
    ring
  have htan := fderivWithin_tangent_eq_zero_of_zero_face ℓ hx hxU hUS hf hzero
    (v - (ℓ v / ℓ ν) • ν) hk
  simpa only [map_sub, map_smul, hDν, smul_zero, sub_zero] using htan

section Sobolev
variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [FiniteDimensional ℝ V] [MeasurableSpace V] [BorelSpace V]
  {μ : Measure V} [μ.IsAddHaarMeasure] {Ω A : Opens V} {T K : Set V}
  {ι : Type*} [Fintype ι]

set_option maxHeartbeats 600000 in
without_proof_info in
/-- A classical transverse Cauchy condition supplies the local H2
zero extension, without an ambient smooth extension of the solution. -/
theorem exists_local_H2_zeroExtension_of_transverse_cauchy_data
    (b : OrthonormalBasis ι ℝ V)
    (hT : UniqueDiffOn ℝ T) (hK : IsCompact K) (hKT : K ⊆ T)
    (hΩK : (Ω : Set V) ⊆ K) (hΩT : (Ω : Set V) ⊆ interior T)
    {F : V → ℝ} (hF : ContDiffOn ℝ ∞ F T)
    (ℓ : V →L[ℝ] ℝ) (hAT : {y : V | 0 ≤ ℓ y} ∩ A ⊆ T)
    (hfront : ∀ x ∈ frontier (Ω : Set V), x ∈ A → ℓ x = 0)
    (hzero : ∀ x ∈ A, ℓ x = 0 → F x = 0)
    (ν : V → V)
    (hν : ∀ x ∈ frontier (Ω : Set V), x ∈ A → ℓ (ν x) ≠ 0)
    (hDν : ∀ x ∈ frontier (Ω : Set V), x ∈ A → fderivWithin ℝ F T x (ν x) = 0)
    (χ : 𝓓(A, ℝ)) :
    ∃ W : Wkp μ A 2 2, W ∈ wkp0Submodule μ A 2 2 ∧
      Wkp.value 2 W =ᵐ[μ.restrict A] (Ω : Set V).indicator (fun x => χ x * F x) := by
  have hclT : closure (Ω : Set V) ⊆ T :=
    (closure_minimal hΩK hK.isClosed).trans hKT
  apply exists_local_H2_zeroExtension_of_relative_smooth_zero_firstJets
    b hT hK hKT hΩK hΩT hF ?_ ?_ χ
  · intro x hx hxA
    exact hzero x hxA (hfront x hx hxA)
  · intro x hx hxA
    exact fderivWithin_eq_zero_of_transverse_cauchy_data ℓ (hfront x hx hxA) hxA hAT
      ((hF.differentiableOn (by simp)) x (hclT hx.1)) hzero (ν x) (hν x hx hxA) (hDν x hx hxA)
end Sobolev

end ConformalPoisson

end ProofPart_CauchyFirstJets

/- Proof support: CutoffRepresentative.lean, SHA256 77f4d39e3af26b301b56343b08d1fc8e4e768e4a53d2ea937c576ab4055388b5 -/
noncomputable section ProofPart_CutoffRepresentative



/- Recover pointwise zero values of the classical solution from
the vanishing H2 cutoff representative on a smaller open region. -/
open Set MeasureTheory TopologicalSpace TauCeti
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {U V Ω : Opens E} {S : Set E}

without_proof_info in
theorem eqOn_zero_of_H2_cutoff_ae_zero
    (u : Wkp μ U 2 2) {χ F : E → ℝ}
    (hu : Wkp.value 2 u =ᵐ[μ.restrict U] (Ω : Set E).indicator (fun x => χ x * F x))
    (hzero : Wkp.value 2 u =ᵐ[(μ.restrict U).restrict S] 0)
    (hVU : V ≤ U) (hVS : (V : Set E) ⊆ S) (hVΩ : V ≤ Ω)
    (hχ : ∀ x ∈ V, χ x = 1) (hF : ContinuousOn F V) :
    EqOn F 0 V := by
  have hzV : Wkp.value 2 u =ᵐ[μ.restrict V] 0 := by
    have hh := hzero.filter_mono (ae_mono (Measure.restrict_mono_set (μ.restrict U) hVS))
    rwa [Measure.restrict_restrict_of_subset (SetLike.coe_subset_coe.mpr hVU)] at hh
  have hvV := ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hVU) hu
  have hFzero : F =ᵐ[μ.restrict V] 0 := by
    filter_upwards [hzV, hvV, ae_restrict_mem V.isOpen.measurableSet] with x hx hv hxV
    rw [hv, indicator_of_mem (hVΩ hxV), hχ x hxV, one_mul] at hx
    exact hx
  exact Measure.eqOn_open_of_ae_eq hFzero V.isOpen hF continuousOn_const

end ConformalPoisson

end ProofPart_CutoffRepresentative

/- Proof support: AmbientCauchyUniqueness.lean, SHA256 8fb0b0b714a7bdf98f9add78486609251e755448ebbc7fb594fe422080043879 -/
noncomputable section ProofPart_AmbientCauchyUniqueness




/- Boundary Cauchy uniqueness on the actual smooth ambient metric
cap. The solution is smooth only relative to its original closed-side
chart target. Zero value and one transverse Cauchy derivative supply
the H2 zero extension; the constructed Carleman estimate supplies the
vanishing germ. Native manifold chart hypotheses are separate callers. -/
open Bundle Set MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold Filter
open scoped Manifold ContDiff Topology ENNReal Distributions
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {n : ℕ} (D : Opens (EuclideanSpace ℝ (Fin (n + 1))))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ∞
    (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
  [MeasurableSpace D] [BorelSpace D]

set_option maxHeartbeats 1800000 in
without_proof_info in
theorem ambient_boundary_cauchy_local_zero
    (p : D) (hp : (p : EuclideanSpace ℝ (Fin (n + 1))) 0 = 0)
    {q : D → ℝ} (hq : Continuous q)
    {Ω : Opens (EuclideanSpace ℝ (Fin (n + 1)))}
    {S K : Set (EuclideanSpace ℝ (Fin (n + 1)))}
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set _) ⊆ K) (hΩS : (Ω : Set _) ⊆ interior S)
    {F : EuclideanSpace ℝ (Fin (n + 1)) → ℝ} (hF : ContDiffOn ℝ ∞ F S)
    (hhalf : {x : EuclideanSpace ℝ (Fin (n + 1)) | 0 ≤ x 0} ∩ D ⊆ S)
    (hpos : ∀ x ∈ D, 0 < x 0 → x ∈ Ω)
    (hneg : ∀ x ∈ D, x 0 < 0 → x ∉ Ω)
    (hfront : ∀ x ∈ frontier (Ω : Set _), x ∈ D → x 0 = 0)
    (hzero : ∀ x ∈ D, x 0 = 0 → F x = 0)
    (v : EuclideanSpace ℝ (Fin (n + 1)) → EuclideanSpace ℝ (Fin (n + 1)))
    (hv : ∀ x ∈ frontier (Ω : Set _), x ∈ D → v x 0 ≠ 0)
    (hDv : ∀ x ∈ frontier (Ω : Set _), x ∈ D → fderivWithin ℝ F S x (v x) = 0)
    (hP : ∀ x ∈ Ω,
      coordinateSchrodinger
        (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
        (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
        (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p q) F x = 0) :
    ∃ N : Opens (EuclideanSpace ℝ (Fin (n + 1))),
      (p : EuclideanSpace ℝ (Fin (n + 1))) ∈ N ∧
      ∀ x ∈ N, 0 ≤ x 0 → F x = 0 := by
  obtain ⟨b, η, T, U, C, _, hη, _, hpU, hUc, hUDcl, hφp, hshape, hEst⟩ :=
    exists_ambient_H2_weighted_carleman_estimate D p hp hq
  have hUD : (U : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ D :=
    subset_closure.trans hUDcl
  obtain ⟨χ₀, hχsmooth, _, hχone, hχcompact, hχsupport⟩ :=
    (isCompact_singleton (x := (p : EuclideanSpace ℝ (Fin (n + 1))))).exists_contDiff_cutoff
      U.isOpen (singleton_subset_iff.mpr hpU)
  let χ : 𝓓(U, ℝ) := ⟨χ₀, hχsmooth, hχcompact, hχsupport⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp
    (isOpen_interior.mem_nhds (hχone (mem_singleton _)))
  have hχ : ∀ x ∈ Metric.ball (p : EuclideanSpace ℝ (Fin (n + 1))) r, χ x = 1 :=
    fun _ hx => interior_subset (hball hx)
  let ℓ : EuclideanSpace ℝ (Fin (n + 1)) →L[ℝ] ℝ :=
    PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  have hℓ : ℓ ≠ 0 := by
    intro he
    have hh := congrArg (fun L : EuclideanSpace ℝ (Fin (n + 1)) →L[ℝ] ℝ =>
      L (EuclideanSpace.single 0 1)) he
    simpa [ℓ] using hh
  obtain ⟨u, hu0, hu⟩ := exists_local_H2_zeroExtension_of_transverse_cauchy_data
    (μ := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar)
    (EuclideanSpace.basisFun (Fin (n + 1)) ℝ) hS hK hKS hΩK hΩS hF ℓ
    (fun x hx => hhalf ⟨hx.1, hUD hx.2⟩)
    (fun x hx hxU => hfront x hx (hUD hxU))
    (fun x hxU hx0 => hzero x (hUD hxU) hx0) v
    (fun x hx hxU => hv x hx (hUD hxU))
    (fun x hx hxU => hDv x hx (hUD hxU)) χ
  let φ := ambientCarlemanWeight D p b
  let Φ := fun z => φ ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) p).symm z)
  have hφ : Continuous φ := (contMDiff_ambientCarlemanWeight D p b).continuous
  have hΦ : ContinuousOn Φ (U : Set (EuclideanSpace ℝ (Fin (n + 1)))) := by
    have hh := hφ.comp_continuousOn
      (continuousOn_extChartAt_symm (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
    rw [ambient_extChartAt_target] at hh
    exact hh.mono hUD
  have hshape' : ∀ x ∈ U, 0 ≤ ℓ x → Φ x ≤ -ℓ x / 2 -
      ‖x - (p : EuclideanSpace ℝ (Fin (n + 1)))‖ ^ 2 := by
    intro x hx ht
    have he : (extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) p).symm x =
        (⟨x, hUD hx⟩ : D) := Subtype.ext (ambient_extChartAt_symm_val D p (hUD hx))
    dsimp only [Φ]
    rw [he]
    exact hshape ⟨x, hUD hx⟩ hx ht
  have hFΩ : ContDiffOn ℝ 2 F Ω :=
    (hF.mono (hΩS.trans interior_subset)).of_le (by simp)
  have hError := C.cutoff_error_weight_level u ℓ hℓ hr hFΩ hP
    (fun x hx ht => hpos x (hUD hx) ht) (fun x hx ht => hneg x (hUD hx) ht) hχ hu hshape'
  have hz := ambient_H2_ae_zero_above_error_level D p hUc subset_closure hUDcl hφ C u hη
    hError (fun τ hτ => hEst τ hτ u hu0)
  let N : Opens (EuclideanSpace ℝ (Fin (n + 1))) :=
    ⟨(U : Set _) ∩ Φ ⁻¹' Ioi (-(r ^ 2)) ∩ Metric.ball (p : EuclideanSpace ℝ (Fin (n + 1))) r,
      (hΦ.isOpen_inter_preimage U.isOpen isOpen_Ioi).inter Metric.isOpen_ball⟩
  have hpN : (p : EuclideanSpace ℝ (Fin (n + 1))) ∈ N := by
    refine ⟨⟨hpU, ?_⟩, Metric.mem_ball_self hr⟩
    have he : (extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) p).symm
        (p : EuclideanSpace ℝ (Fin (n + 1))) = p :=
      Subtype.ext (ambient_extChartAt_symm_val D p p.property)
    change -(r ^ 2) < φ ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) p).symm p)
    rw [he]
    change -(r ^ 2) < ambientCarlemanWeight D p b p
    rw [hφp]
    nlinarith [sq_pos_of_pos hr]
  let V : Opens (EuclideanSpace ℝ (Fin (n + 1))) :=
    ⟨(N : Set _) ∩ {x | 0 < ℓ x}, N.isOpen.inter (isOpen_lt continuous_const ℓ.continuous)⟩
  have hVU : V ≤ U := fun _ hx => hx.1.1.1
  have hVΩ : V ≤ Ω := fun x hx => hpos x (hUD (hVU hx)) hx.2
  have hFzero : EqOn F 0 V := eqOn_zero_of_H2_cutoff_ae_zero u hu hz hVU
    (fun _ hx => hx.1.1.2.le) hVΩ (fun x hx => hχ x hx.1.2)
    (hFΩ.continuousOn.mono (SetLike.coe_subset_coe.mpr hVΩ))
  refine ⟨N, hpN, ?_⟩
  intro x hx ht
  rcases eq_or_lt_of_le ht with hxt | hxt
  · exact hzero x (hUD hx.1.1) hxt.symm
  · exact hFzero ⟨hx, hxt⟩

end ConformalPoisson

end ProofPart_AmbientCauchyUniqueness

/- Proof support: NativeCauchyLocalZero.lean, SHA256 a62e0af6bf6f90c698783f9abb351ed69b140525a9e9b06a54382333deaa13c6 -/
noncomputable section ProofPart_NativeCauchyLocalZero



/- Apply the ambient Cauchy theorem to the actual original solution,
metric and outward normal. The positive cap is contained in the SAME
ambient domain where the native operator readback is proved. -/
open Bundle Set TauCeti TauCeti.Manifold TopologicalSpace Filter
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

set_option maxHeartbeats 2400000 in
without_proof_info in
theorem native_cauchy_local_zero_of_ambient_extension
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (α : (𝓡∂ (n + 1)).boundary M) (U : Opens M) (hα : (α : M) ∈ U)
    (R : NativeMetricAmbientExtension g (α : M))
    (Q : R.domain → ℝ) (hQcont : Continuous Q)
    (hQ : ∀ z : R.domain, 0 ≤ (z : EuclideanSpace ℝ (Fin (n + 1))) 0 →
      Q z = q ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm z))
    {r : ℝ} (hr : 0 < r)
    (hcap : Metric.closedBall (extChartAt (𝓡∂ (n + 1)) (α : M) α) r ∩ range (𝓡∂ (n + 1)) ⊆
      nativeCauchyChartTarget (n := n) (α : M) U)
    (hDball : (R.domain : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆
      Metric.ball (extChartAt (𝓡∂ (n + 1)) (α : M) α) r)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (u : M → ℝ) (hu : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u U)
    (hL : ∀ y ∈ U, (𝓡∂ (n + 1)).IsInteriorPoint y → schrodinger g q u y = 0)
    (hC : ∀ y : (𝓡∂ (n + 1)).boundary M, (y : M) ∈ U →
      u y = 0 ∧ normalDerivative ν u y = 0) :
    ∃ W : Opens M, (α : M) ∈ W ∧ (W : Set M) ⊆ U ∧ EqOn u 0 W := by
  classical
  letI : RiemannianBundle (fun x : R.domain =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x) := ⟨R.metric.toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ∞
      (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : R.domain => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x) :=
    IsContMDiffRiemannianBundle.of_le (n := ω) (by decide)
  let S := nativeCauchyChartTarget (n := n) (α : M) U
  let K := Metric.closedBall (extChartAt (𝓡∂ (n + 1)) (α : M) α) r ∩ range (𝓡∂ (n + 1))
  let Ω := positiveCoordinateCap R.domain
  let F := u ∘ (extChartAt (𝓡∂ (n + 1)) (α : M)).symm
  let p : R.domain := ⟨extChartAt (𝓡∂ (n + 1)) (α : M) α, R.base_mem⟩
  have hK : IsCompact K := (isCompact_closedBall _ _).inter_right (𝓡∂ (n + 1)).isClosed_range
  have hhalf : {z : EuclideanSpace ℝ (Fin (n + 1)) | 0 ≤ z 0} ∩ R.domain ⊆ S := by
    intro z hz
    apply hcap
    refine ⟨Metric.ball_subset_closedBall (hDball hz.2), ?_⟩
    simpa only [range_modelWithCornersEuclideanHalfSpace, mem_ofPred_eq] using hz.1
  have hΩK : (Ω : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ K := by
    intro z hz
    refine ⟨Metric.ball_subset_closedBall (hDball hz.1), ?_⟩
    simpa only [range_modelWithCornersEuclideanHalfSpace, mem_ofPred_eq] using hz.2.le
  have hΩS : (Ω : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ interior S :=
    Ω.isOpen.subset_interior_iff.mpr (hΩK.trans hcap)
  have hΩtarget : (Ω : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆
      interior (extChartAt (𝓡∂ (n + 1)) (α : M)).target :=
    Ω.isOpen.subset_interior_iff.mpr ((hΩK.trans hcap).trans inter_subset_left)
  have hface (z : EuclideanSpace ℝ (Fin (n + 1))) (hzD : z ∈ R.domain) (hz0 : z 0 = 0) :
      (𝓡∂ (n + 1)).IsBoundaryPoint ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm z) :=
    inverseChart_boundary_of_coordinate_zero (α : M) (hhalf ⟨by change 0 ≤ z 0; rw [hz0], hzD⟩).1 hz0
  let v : EuclideanSpace ℝ (Fin (n + 1)) → EuclideanSpace ℝ (Fin (n + 1)) := fun z =>
    if h : (𝓡∂ (n + 1)).IsBoundaryPoint ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm z) then
      mvfderiv (𝓡∂ (n + 1)) (extChartAt (𝓡∂ (n + 1)) (α : M))
        ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm z) (ν ⟨_, h⟩)
    else 0
  have hzero : ∀ z ∈ R.domain, z 0 = 0 → F z = 0 := by
    intro z hzD hz0
    exact (hC ⟨_, hface z hzD hz0⟩ (hhalf ⟨by change 0 ≤ z 0; rw [hz0], hzD⟩).2).1
  have hv : ∀ z ∈ frontier (Ω : Set _), z ∈ R.domain → v z 0 ≠ 0 := by
    intro z hz hzD
    have hz0 := positiveCoordinateCap_frontier R.domain hz hzD
    have hzS := hhalf ⟨show 0 ≤ z 0 from by rw [hz0], hzD⟩
    have hB := hface z hzD hz0
    let y : (𝓡∂ (n + 1)).boundary M := ⟨_, hB⟩
    have hy : (y : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) (α : M)).source := by
      simpa only [extChartAt_source] using (extChartAt (𝓡∂ (n + 1)) (α : M)).map_target hzS.1
    have hn := native_normal_chart_coordinate_neg g (α : M) y hy (ν y) (hν y)
    dsimp only [v]
    rw [dite_eq_left hB]
    exact ne_of_lt hn
  have hDv : ∀ z ∈ frontier (Ω : Set _), z ∈ R.domain → fderivWithin ℝ F S z (v z) = 0 := by
    intro z hz hzD
    have hz0 := positiveCoordinateCap_frontier R.domain hz hzD
    have hzS := hhalf ⟨show 0 ≤ z 0 from by rw [hz0], hzD⟩
    have hB := hface z hzD hz0
    let y : (𝓡∂ (n + 1)).boundary M := ⟨_, hB⟩
    have hy : (y : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) (α : M)).source := by
      simpa only [extChartAt_source] using (extChartAt (𝓡∂ (n + 1)) (α : M)).map_target hzS.1
    have hyU : (y : M) ∈ U := hzS.2
    have huAt := (hu y hyU).contMDiffAt (U.isOpen.mem_nhds hyU)
    have hd := normalDerivative_eq_inverseChart_fderivWithin_on (α : M) U y hy hyU ν
      (huAt.mdifferentiableAt (by simp))
    have he : extChartAt (𝓡∂ (n + 1)) (α : M) (y : M) = z :=
      (extChartAt (𝓡∂ (n + 1)) (α : M)).right_inv hzS.1
    rw [he] at hd
    dsimp only [v]
    rw [dite_eq_left hB]
    exact hd.symm.trans (hC y hyU).2
  have hP : ∀ z ∈ Ω,
      coordinateSchrodinger (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
        (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
        (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p Q) F z = 0 := by
    intro z hz
    have hzS := hΩK.trans hcap hz
    have huAt := (hu _ hzS.2).contMDiffAt (U.isOpen.mem_nhds hzS.2)
    have he := R.coordinateSchrodinger_eq_original p ⟨z, hz.1⟩ (hΩtarget hz) Q q u
      (hQ ⟨z, hz.1⟩ hz.2.le) (huAt.of_le (by simp))
    exact he.trans (hL _ hzS.2 (inverseChart_interior_of_mem_interior_target (α : M) (hΩtarget hz)))
  obtain ⟨N, hpN, hN⟩ := ambient_boundary_cauchy_local_zero R.domain p
    (boundary_coordinate_zero α) hQcont (uniqueDiffOn_nativeCauchyChartTarget (α : M) U)
    hK hcap hΩK hΩS (contDiffOn_nativeCauchyChartTarget (α : M) U hu) hhalf
    (fun z hz ht => ⟨hz, ht⟩) (fun _ _ hn hp => (not_lt_of_ge hn.le) hp.2)
    (fun _ hz hzD => positiveCoordinateCap_frontier R.domain hz hzD) hzero v hv hDv hP
  let N' : Opens (EuclideanSpace ℝ (Fin (n + 1))) := N ⊓ R.domain
  let W : Opens M :=
    ⟨(extChartAt (𝓡∂ (n + 1)) (α : M)).source ∩
      extChartAt (𝓡∂ (n + 1)) (α : M) ⁻¹' (N' : Set _),
      isOpen_extChartAt_preimage' (α : M) N'.isOpen⟩
  have hWU : (W : Set M) ⊆ U := by
    intro y hy
    have hc := (extChartAt (𝓡∂ (n + 1)) (α : M)).map_source hy.1
    have hnonneg : 0 ≤ (extChartAt (𝓡∂ (n + 1)) (α : M) y) 0 := by
      have hh := extChartAt_target_subset_range (α : M) hc
      simpa only [range_modelWithCornersEuclideanHalfSpace, mem_ofPred_eq] using hh
    have hS := hhalf ⟨hnonneg, hy.2.2⟩
    have he := (extChartAt (𝓡∂ (n + 1)) (α : M)).left_inv hy.1
    have hm : (extChartAt (𝓡∂ (n + 1)) (α : M)).symm
        (extChartAt (𝓡∂ (n + 1)) (α : M) y) ∈ U := hS.2
    rwa [he] at hm
  refine ⟨W, ⟨mem_extChartAt_source (α : M), hpN, R.base_mem⟩, hWU, ?_⟩
  intro y hy
  have hc := (extChartAt (𝓡∂ (n + 1)) (α : M)).map_source hy.1
  have hnonneg : 0 ≤ (extChartAt (𝓡∂ (n + 1)) (α : M) y) 0 := by
    have hh := extChartAt_target_subset_range (α : M) hc
    simpa only [range_modelWithCornersEuclideanHalfSpace, mem_ofPred_eq] using hh
  have hz := hN _ hy.2.1 hnonneg
  change u ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm (extChartAt (𝓡∂ (n + 1)) (α : M) y)) = 0 at hz
  change u y = 0
  simpa only [(extChartAt (𝓡∂ (n + 1)) (α : M)).left_inv hy.1] using hz

end ConformalPoisson

end ProofPart_NativeCauchyLocalZero

/- Proof support: AnalyticMetricCauchy.lean, SHA256 2848e22ecc77a47501c970b53735e3963966416a88f18ce8355d1b84f4a09b61 -/
noncomputable section ProofPart_AnalyticMetricCauchy



/- Native boundary Cauchy uniqueness for metrics analytic on the
actual local solution domain. The solution need only be smooth there,
and the potential need only be continuous. The actual ambient metric
and continuous potential extension are constructed inside the proof. -/
open Bundle Set TauCeti TopologicalSpace
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

set_option maxHeartbeats 1400000 in
without_proof_info in
theorem native_cauchy_local_zero_of_analytic_metric
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : Continuous q)
    (U : Opens M) (hg : MetricAnalyticOn g U)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (u : M → ℝ) (hu : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u U)
    (hL : ∀ y ∈ U, (𝓡∂ (n + 1)).IsInteriorPoint y → schrodinger g q u y = 0)
    (hC : ∀ y : (𝓡∂ (n + 1)).boundary M, (y : M) ∈ U →
      u y = 0 ∧ normalDerivative ν u y = 0)
    (α : (𝓡∂ (n + 1)).boundary M) (hα : (α : M) ∈ U) :
    ∃ W : Opens M, (α : M) ∈ W ∧ (W : Set M) ⊆ U ∧ EqOn u 0 W := by
  obtain ⟨R₀⟩ := exists_native_metric_ambient_extension g U hg hα
  obtain ⟨R₁, _, _, hcompat⟩ := R₀.exists_domain_in_chart
  obtain ⟨R₂, _, _, Q₂, hQ₂cont, hQ₂⟩ := R₁.exists_continuous_potential_extension hcompat hq
  obtain ⟨r, hr, hcap⟩ := exists_closed_halfBall_nativeCauchyChartTarget (n := n) (α : M) U hα
  let D : Opens (EuclideanSpace ℝ (Fin (n + 1))) :=
    R₂.domain ⊓ ⟨Metric.ball (extChartAt (𝓡∂ (n + 1)) (α : M) α) (r / 2), Metric.isOpen_ball⟩
  let R : NativeMetricAmbientExtension g (α : M) :=
    { domain := D
      base_mem := ⟨R₂.base_mem, Metric.mem_ball_self (by positivity)⟩
      tensor := R₂.tensor
      analytic := R₂.analytic.mono inter_subset_left
      symmetric := R₂.symmetric
      positive := fun z hz => R₂.positive z hz.1
      agrees := R₂.agrees }
  let incl : R.domain → R₂.domain := fun z => ⟨z, z.property.1⟩
  have hincl : Continuous incl := continuous_subtype_val.subtype_mk _
  let Q : R.domain → ℝ := Q₂ ∘ incl
  have hQcont : Continuous Q := hQ₂cont.comp hincl
  have hQ : ∀ z : R.domain, 0 ≤ (z : EuclideanSpace ℝ (Fin (n + 1))) 0 →
      Q z = q ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm z) := by
    intro z hz
    exact hQ₂ (incl z) hz
  have hDball : (R.domain : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆
      Metric.ball (extChartAt (𝓡∂ (n + 1)) (α : M) α) r := by
    intro z hz
    exact Metric.ball_subset_ball (by linarith : r / 2 ≤ r) hz.2
  exact native_cauchy_local_zero_of_ambient_extension g q α U hα R Q hQcont hQ hr hcap hDball
    ν hν u hu hL hC

set_option maxHeartbeats 900000 in
without_proof_info in
/-- The original relatively open boundary patch need not be the full
boundary of the solution domain. Local metric analyticity suffices. -/
theorem boundary_cauchy_uniqueness_of_analytic_metric
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : Continuous q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (V : Opens M) (hg : MetricAnalyticOn g V)
    (Γ : Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓV : ∀ y ∈ Γ, (y : M) ∈ V)
    (u : M → ℝ) (hu : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u V)
    (hL : ∀ y ∈ V, (𝓡∂ (n + 1)).IsInteriorPoint y → schrodinger g q u y = 0)
    (hC : ∀ y ∈ Γ, u y = 0 ∧ normalDerivative ν u y = 0)
    (α : (𝓡∂ (n + 1)).boundary M) (hα : α ∈ Γ) :
    ∃ W : Opens M, (α : M) ∈ W ∧ (W : Set M) ⊆ V ∧ EqOn u 0 W := by
  obtain ⟨O, hO⟩ := exists_open_representing_boundary_patch (n := n) Γ
  let T : Opens M := V ⊓ O
  have hαT : (α : M) ∈ T := by
    refine ⟨hΓV α hα, ?_⟩
    change α ∈ observedPatch (n := n) O
    rw [hO]
    exact hα
  have hgT : MetricAnalyticOn g T := fun y hy => (hg y hy.1).mono inter_subset_left
  have hCT : ∀ y : (𝓡∂ (n + 1)).boundary M, (y : M) ∈ T →
      u y = 0 ∧ normalDerivative ν u y = 0 := by
    intro y hy
    apply hC y
    change y ∈ (Γ : Set ((𝓡∂ (n + 1)).boundary M))
    rw [← hO]
    exact hy.2
  obtain ⟨W, hαW, hWT, hW⟩ := native_cauchy_local_zero_of_analytic_metric g q hq T hgT ν hν u
    (hu.mono inter_subset_left) (fun y hy => hL y hy.1) hCT α hαT
  exact ⟨W, hαW, (fun y hy => (hWT hy).1), hW⟩

end ConformalPoisson

end ProofPart_AnalyticMetricCauchy

/- Proof support: AnalyticRemoteNormal.lean, SHA256 6aaa49e177459d7dca87db61ccb9e40190b93b63e3e19464649e11312017822a -/
noncomputable section ProofPart_AnalyticRemoteNormal







/- Remote-normal nonvanishing for the original analytic problem. Its
Poisson section is analytic in the interior by the retained regularity input,
so no independent interior UCP premise is needed. -/
open Set MeasureTheory Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance analyticRemoteBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary

without_proof_info in
theorem exists_remote_normal_datum_of_analytic
    (hInverse : ForwardInhomogeneousAssumption (n := n) (M := M))
    (hEstimate : NormalTraceInverseEstimateAssumption (n := n) (M := M))
    (hReg : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    (A : AnalyticProblem (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal A.smoothMetric y (ν y))
    (S : DirichletSolver A.smoothMetric A.potential)
    (G : DirichletGreenKernel A.smoothMetric A.potential ν S)
    (y : (𝓡∂ (n + 1)).boundary M)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty) (hy : y ∉ Γ) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      normalDerivative ν (S.solve f.val) y ≠ 0 := by
  classical
  by_contra hnot
  have hzero : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      normalDerivative ν (S.solve f.val) y = 0 := by
    intro f
    by_contra hf
    exact hnot ⟨f, hf⟩
  let K := boundaryPoissonSection ν G.kernel y
  have hcauchy := G.cauchy_zero_of_remote_normal_zero A.smoothMetric A.potential ν hν S y Γ hy hzero
  let V : TopologicalSpace.Opens M := ⟨{(y : M)}ᶜ, isClosed_singleton.isOpen_compl⟩
  have hΓV : ∀ z ∈ Γ, (z : M) ∈ V := by
    intro z hz heq
    exact hy ((Subtype.ext heq : z = y) ▸ hz)
  have hq := A.analytic_potential.of_le (show (∞ : ℕ∞ω) ≤ ω by decide)
  obtain ⟨z, hz⟩ := hΓ
  obtain ⟨W, hzW, _, hWzero⟩ := boundary_cauchy_uniqueness_of_analytic_metric A.smoothMetric A.potential hq.continuous ν hν
    V (metricAnalyticOn_of_analytic A.metric V) Γ hΓV K
    (G.poisson_section_smooth y) (fun z _ hz => G.poisson_section_equation y z hz) hcauchy z hz
  let U : TopologicalSpace.Opens M :=
    ⟨(𝓡∂ (n + 1)).interior M, (𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)⟩
  have hUV : (U : Set M) ⊆ V := by
    intro p hp heq
    have hpB : p ∈ (𝓡∂ (n + 1)).boundary M := heq ▸ y.property
    exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary hp hpB
  have hω : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω K U := hReg A.metric A.potential
    A.analytic_potential U Subset.rfl K ((G.poisson_section_smooth y).mono hUV)
    (G.poisson_section_equation y)
  obtain ⟨p, hp, hpW⟩ := (dense_nativeInterior (n := n) (M := M)).exists_mem_open
    W.isOpen ⟨z, hzW⟩
  have hWU : ((W ⊓ U : TopologicalSpace.Opens M) : Set M).Nonempty := ⟨p, hpW, hp⟩
  have hconn : IsPreconnected ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M) := by
    simpa only [U, TopologicalSpace.Opens.coe_mk, inter_self] using hconnected.isPreconnected
  have hglobal := native_analytic_eqOn_of_open_match U hconn hω contMDiffOn_const
    (W ⊓ U) hWU (fun _ hp => ⟨hp.2, hp.2⟩) (fun _ hp => hWzero hp.1)
  exact G.poisson_section_not_zero hInverse hEstimate A.smoothMetric A.potential hq
    A.nonresonant ν hν S y hglobal

without_proof_info in
theorem exists_remote_normal_solution_of_analytic
    (hGreen : GreenKernelAssumption (n := n) (M := M))
    (hInverse : ForwardInhomogeneousAssumption (n := n) (M := M))
    (hEstimate : NormalTraceInverseEstimateAssumption (n := n) (M := M))
    (hReg : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    (A : AnalyticProblem (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal A.smoothMetric y (ν y))
    (S : DirichletSolver A.smoothMetric A.potential) (y : (𝓡∂ (n + 1)).boundary M)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty) (hy : y ∉ Γ) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      normalDerivative ν (S.solve f.val) y ≠ 0 ∧
      mvfderiv (𝓡∂ (n + 1)) (S.solve f.val) (y : M) ≠ 0 ∧
      ∀ᶠ z : (𝓡∂ (n + 1)).boundary M in 𝓝 y, S.solve f.val z = 0 := by
  have hq := A.analytic_potential.of_le (show (∞ : ℕ∞ω) ≤ ω by decide)
  obtain ⟨G⟩ := hGreen isCompact_univ A.smoothMetric A.potential hq A.nonresonant S ν hν
  obtain ⟨f, hf⟩ := exists_remote_normal_datum_of_analytic hInverse hEstimate hReg
    hconnected A ν hν S G y Γ hΓ hy
  refine ⟨f, hf, ?_, ?_⟩
  · intro hder
    apply hf
    unfold normalDerivative
    rw [hder, zero_apply]
  · exact S.eventually_zero_at_unobserved_boundary A.smoothMetric A.potential f y hy
end ConformalPoisson

end ProofPart_AnalyticRemoteNormal

/- Proof support: NativeNormalRepresentative.lean, SHA256 3b2c8c6c7749cf75d2d24e4897069a80513c038e5cbd05f80400d749de6891d2 -/
noncomputable section ProofPart_NativeNormalRepresentative


/- One genuine signed analytic representative in tangential/normal
product coordinates, retaining the actual native function and normal. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

def nativeNormalCoordinates (z : EuclideanHalfSpace (n + 1)) :
    EuclideanSpace ℝ (Fin n) × ℝ :=
  (euclideanHalfSpaceBoundaryNormalEquiv n).symm ((𝓡∂ (n + 1)) z)

without_proof_info in
@[simp] theorem nativeNormalCoordinates_boundary (x : EuclideanSpace ℝ (Fin n)) :
    nativeNormalCoordinates (EuclideanHalfSpace.boundaryParam n x) = (x, 0) := by
  apply (euclideanHalfSpaceBoundaryNormalEquiv n).injective
  simp [nativeNormalCoordinates, euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam,
    modelWithCornersEuclideanHalfSpace_toFun, EuclideanHalfSpace.boundaryParam_coe]

without_proof_info in
@[simp] theorem nativeNormalCoordinates_snd (z : EuclideanHalfSpace (n + 1)) :
    (nativeNormalCoordinates z).2 = z.val 0 := by
  simp [nativeNormalCoordinates, euclideanHalfSpaceBoundaryNormalEquiv_symm_apply_snd,
    modelWithCornersEuclideanHalfSpace_toFun]

without_proof_info in
theorem continuous_nativeNormalCoordinates : Continuous (nativeNormalCoordinates (n := n)) :=
  (euclideanHalfSpaceBoundaryNormalEquiv n).symm.continuous.comp (𝓡∂ (n + 1)).continuous

without_proof_info in
theorem exists_native_normal_representative
    {f : EuclideanHalfSpace (n + 1) → F} {x : EuclideanSpace ℝ (Fin n)}
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f (EuclideanHalfSpace.boundaryParam n x)) :
    ∃ H : EuclideanSpace ℝ (Fin n) × ℝ → F, AnalyticAt ℝ H (x, 0) ∧
      (∀ z, f z = H (nativeNormalCoordinates z)) ∧
      (∀ y, H (y, 0) = f (EuclideanHalfSpace.boundaryParam n y)) ∧
      fderiv ℝ H (x, 0) (0, 1) = normalDeriv f (EuclideanHalfSpace.boundaryParam n x) := by
  obtain ⟨G, hG, he⟩ := model_exists_analytic_extension (𝓡∂ (n + 1)) hf
  let e := euclideanHalfSpaceBoundaryNormalEquiv n
  have hbase : e (x, 0) = (𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n x) := by
    simp [e, euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam,
      modelWithCornersEuclideanHalfSpace_toFun, EuclideanHalfSpace.boundaryParam_coe]
  have hG' : AnalyticAt ℝ G (e (x, 0)) := hbase.symm ▸ hG
  refine ⟨G ∘ e, hG'.comp (e.analyticAt _), ?_, ?_, ?_⟩
  · intro z
    rw [he]
    simp only [Function.comp_apply, nativeNormalCoordinates, e,
      ContinuousLinearEquiv.apply_symm_apply]
  · intro y
    rw [he]
    simp only [Function.comp_apply, e,
      euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam,
      modelWithCornersEuclideanHalfSpace_toFun, EuclideanHalfSpace.boundaryParam_coe]
  · have hd := hG'.differentiableAt.hasFDerivAt.comp (x, 0) e.hasFDerivAt
    rw [hd.fderiv]
    change fderiv ℝ G (e (x, 0)) (e (0, 1)) = _
    rw [hbase, he]
    exact (modelDirectionalDeriv_ambient (𝓡∂ (n + 1))
      (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) hG.differentiableAt).symm
end ConformalPoisson

end ProofPart_NativeNormalRepresentative

/- Proof support: AnalyticNormalDivision.lean, SHA256 b65013cd61763e3d9f6555504b6fcaf5d8e15a88b5743c2385977ec181acc55d -/
noncomputable section ProofPart_AnalyticNormalDivision







/- Analytic division in one normal variable, with the tangential
variables retained. Uses the pinned Tau Ceti analytic contraction-integral
theorem and the fundamental theorem of calculus; no division premise. -/
open Filter Set MeasureTheory
open scoped Topology Interval
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

def normalContraction (t : ℝ) : (E × ℝ) →L[ℝ] (E × ℝ) :=
  (ContinuousLinearMap.fst ℝ E ℝ).prod (t • ContinuousLinearMap.snd ℝ E ℝ)

without_proof_info in
@[simp] theorem normalContraction_apply (t : ℝ) (z : E × ℝ) :
    normalContraction t z = (z.1, t * z.2) := rfl

without_proof_info in
theorem normalContraction_norm_le {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) :
    ‖normalContraction (E := E) t‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro z
  simp only [normalContraction_apply, one_mul, Prod.norm_def]
  apply max_le
  · exact le_max_left _ _
  · calc |t * z.2| = |t| * |z.2| := abs_mul _ _
         _ ≤ 1 * |z.2| := mul_le_mul_of_nonneg_right (by simpa [abs_of_nonneg ht.1] using ht.2) (abs_nonneg _)
         _ ≤ max ‖z.1‖ ‖z.2‖ := by simp

without_proof_info in
theorem exists_analytic_normal_factor {f : E × ℝ → F} {x : E}
    (hf : AnalyticAt ℝ f (x, 0)) :
    ∃ a : E × ℝ → F, AnalyticAt ℝ a (x, 0) ∧
      a (x, 0) = fderiv ℝ f (x, 0) (0, 1) ∧
      ∀ᶠ z in 𝓝 (x, (0 : ℝ)), f z - f (z.1, 0) = z.2 • a z := by
  let c : E × ℝ := (x, 0)
  let L : ℝ → (E × ℝ) →L[ℝ] (E × ℝ) := normalContraction
  have hLc : Continuous L := by
    change Continuous (fun t : ℝ =>
      (ContinuousLinearMap.fst ℝ E ℝ).prod (t • ContinuousLinearMap.snd ℝ E ℝ))
    exact (ContinuousLinearMap.prodₗᵢ ℝ).continuous.comp
      (continuous_const.prodMk (continuous_id.smul continuous_const))
  have hL1 : ∀ᵐ t : ℝ, t ∈ Ι (0 : ℝ) 1 → ‖L t‖ ≤ 1 :=
    .of_forall fun t ht => normalContraction_norm_le (Ioc_subset_Icc_self (by
      simpa only [uIoc_of_le zero_le_one] using ht))
  let G : E × ℝ → (E × ℝ) →L[ℝ] F :=
    fun z => ∫ t in (0 : ℝ)..1, fderiv ℝ f (c + L t (z - c))
  have hG : AnalyticAt ℝ G c := hf.fderiv.intervalIntegral_comp hLc.aestronglyMeasurable hL1
  refine ⟨fun z => G z (0, 1),
    ((ContinuousLinearMap.apply ℝ F ((0, 1) : E × ℝ)).analyticAt (G c)).comp hG,
    ?_, ?_⟩
  · simp [G, c]
  obtain ⟨ρ, hρ, hball⟩ := Metric.eventually_nhds_iff_ball.1 hf.eventually_analyticAt
  filter_upwards [Metric.ball_mem_nhds c hρ] with z hz
  have hmem (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) :
      c + L t (z - c) ∈ Metric.ball c ρ := by
    rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
    simpa only [add_sub_cancel_left] using
      (show ‖L t (z - c)‖ ≤ ‖z - c‖ by
        simpa using (L t).le_of_opNorm_le (normalContraction_norm_le ht) (z - c)).trans_lt hz
  have hpath (t : ℝ) : c + L t (z - c) = (z.1, t * z.2) := by
    ext <;> simp [c, L]
  have hcont : ContinuousOn (fun t : ℝ => fderiv ℝ f (c + L t (z - c))) (Icc 0 1) :=
    fun t ht => ((hball _ (hmem t ht)).fderiv.continuousAt.comp
      (f := fun t : ℝ => c + L t (z - c))
      (continuous_const.add (hLc.clm_apply continuous_const)).continuousAt).continuousWithinAt
  have hderiv (t : ℝ) (ht : t ∈ Icc (0 : ℝ) 1) :
      HasDerivAt (fun s : ℝ => f (z.1, s * z.2))
        (fderiv ℝ f (c + L t (z - c)) (0, z.2)) t := by
    have hd : HasDerivAt (fun s : ℝ => (z.1, s * z.2)) (0, z.2) t :=
      by
        simpa using (hasDerivAt_const t z.1).prodMk ((hasDerivAt_id t).mul_const z.2)
    have hdf := (hball _ (hmem t ht)).differentiableAt.hasFDerivAt
    rw [hpath t] at hdf ⊢
    exact hdf.comp_hasDerivAt t hd
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := 1)
    (fun t ht => hderiv t (by simpa only [uIcc_of_le zero_le_one] using ht))
    ((hcont.clm_apply (continuousOn_const (c := (0, z.2)))).intervalIntegrable_of_Icc zero_le_one)
  have hGapply := ContinuousLinearMap.intervalIntegral_apply (μ := volume)
    (hcont.intervalIntegrable_of_Icc zero_le_one) (0, z.2)
  have hdisp : ((0, z.2) : E × ℝ) = z.2 • ((0, 1) : E × ℝ) := by simp
  change f z - f (z.1, 0) = z.2 • G z (0, 1)
  calc f z - f (z.1, 0) = G z (0, z.2) := by
         change f z - f (z.1, 0) =
           (∫ t in (0 : ℝ)..1, fderiv ℝ f (c + L t (z - c))) (0, z.2)
         rw [hGapply]
         simpa using hFTC.symm
       _ = z.2 • G z (0, 1) := by rw [hdisp, map_smul]
end ConformalPoisson

end ProofPart_AnalyticNormalDivision

/- Proof support: AnalyticBoundaryQuotient.lean, SHA256 4f6a41e3170d160dac20d6b702d84b8ea1bb3ee281cc76d06e0739d6542ffafe -/
noncomputable section ProofPart_AnalyticBoundaryQuotient



/- Actual analytic quotients across a zero Dirichlet face. The common
normal factor is nonzero at the base; equality with the original quotient
is asserted only off the face. -/
open Filter Set
open scoped Topology
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

without_proof_info in
theorem exists_analytic_normal_factor_of_boundary_zero {f : E × ℝ → F} {x : E}
    (hf : AnalyticAt ℝ f (x, 0))
    (hzero : ∀ᶠ z : E × ℝ in 𝓝 (x, 0), f (z.1, 0) = 0) :
    ∃ a : E × ℝ → F, AnalyticAt ℝ a (x, 0) ∧
      a (x, 0) = fderiv ℝ f (x, 0) (0, 1) ∧
      ∀ᶠ z in 𝓝 (x, (0 : ℝ)), f z = z.2 • a z := by
  obtain ⟨a, ha, hav, hfa⟩ := exists_analytic_normal_factor hf
  refine ⟨a, ha, hav, ?_⟩
  filter_upwards [hfa, hzero] with z hz hzeroz
  simpa only [hzeroz, sub_zero] using hz

omit [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F] in
without_proof_info in
theorem exists_analytic_boundary_quotient {f w : E × ℝ → ℝ} {x : E}
    (hf : AnalyticAt ℝ f (x, 0)) (hw : AnalyticAt ℝ w (x, 0))
    (hfzero : ∀ᶠ z : E × ℝ in 𝓝 (x, 0), f (z.1, 0) = 0)
    (hwzero : ∀ᶠ z : E × ℝ in 𝓝 (x, 0), w (z.1, 0) = 0)
    (hDw : fderiv ℝ w (x, 0) (0, 1) ≠ 0) :
    ∃ Q : E × ℝ → ℝ, AnalyticAt ℝ Q (x, 0) ∧
      Q (x, 0) = fderiv ℝ f (x, 0) (0, 1) / fderiv ℝ w (x, 0) (0, 1) ∧
      ∀ᶠ z : E × ℝ in 𝓝 (x, 0), z.2 ≠ 0 → w z ≠ 0 ∧ f z / w z = Q z := by
  obtain ⟨a, ha, hav, hfa⟩ := exists_analytic_normal_factor_of_boundary_zero hf hfzero
  obtain ⟨b, hb, hbv, hwb⟩ := exists_analytic_normal_factor_of_boundary_zero hw hwzero
  have hbn : b (x, 0) ≠ 0 := hbv ▸ hDw
  refine ⟨fun z => a z / b z, ha.div hb hbn, by dsimp only; rw [hav, hbv], ?_⟩
  have hbnear : ∀ᶠ z : E × ℝ in 𝓝 (x, 0), b z ≠ 0 :=
    hb.continuousAt.eventually (eventually_ne_nhds hbn)
  filter_upwards [hfa, hwb, hbnear] with z hzf hzw hzb
  intro hzt
  rw [smul_eq_mul] at hzf hzw
  refine ⟨hzw ▸ mul_ne_zero hzt hzb, ?_⟩
  rw [hzf, hzw]
  field_simp

omit [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F] in
without_proof_info in
theorem exists_analytic_boundary_quotients {ι : Type*} [Fintype ι]
    {f : ι → E × ℝ → ℝ} {w : E × ℝ → ℝ} {x : E}
    (hf : ∀ i, AnalyticAt ℝ (f i) (x, 0)) (hw : AnalyticAt ℝ w (x, 0))
    (hfzero : ∀ i, ∀ᶠ z : E × ℝ in 𝓝 (x, 0), f i (z.1, 0) = 0)
    (hwzero : ∀ᶠ z : E × ℝ in 𝓝 (x, 0), w (z.1, 0) = 0)
    (hDw : fderiv ℝ w (x, 0) (0, 1) ≠ 0) :
    ∃ Q : E × ℝ → ι → ℝ, AnalyticAt ℝ Q (x, 0) ∧
      (∀ i, Q (x, 0) i = fderiv ℝ (f i) (x, 0) (0, 1) / fderiv ℝ w (x, 0) (0, 1)) ∧
      ∀ᶠ z : E × ℝ in 𝓝 (x, 0), ∀ i, z.2 ≠ 0 → w z ≠ 0 ∧ f i z / w z = Q z i := by
  classical
  have hex (i : ι) := exists_analytic_boundary_quotient (hf i) hw (hfzero i) hwzero hDw
  choose Q hQ hbase heq using hex
  exact ⟨fun z i => Q i z, AnalyticAt.pi hQ, hbase, (Filter.eventually_all).mpr heq⟩
end ConformalPoisson

end ProofPart_AnalyticBoundaryQuotient

/- Proof support: NativeBoundaryQuotient.lean, SHA256 4b4ab1bc478463c3c1fe389f619e43b55706c63964a6f643633f63fa959de930 -/
noncomputable section ProofPart_NativeBoundaryQuotient



/- Finite analytic native solution quotients extend through a zero
boundary face when one common denominator has nonzero actual normal
jet. The extension is a signed product-coordinate analytic function. -/
open Filter Set TauCeti
open scoped Topology Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {ι : Type*} [Fintype ι]

without_proof_info in
theorem exists_native_boundary_quotients
    {f : ι → EuclideanHalfSpace (n + 1) → ℝ} {w : EuclideanHalfSpace (n + 1) → ℝ}
    {x : EuclideanSpace ℝ (Fin n)}
    (hf : ∀ i, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (f i) (EuclideanHalfSpace.boundaryParam n x))
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω w (EuclideanHalfSpace.boundaryParam n x))
    (hfzero : ∀ i, ∀ᶠ y in 𝓝 x, f i (EuclideanHalfSpace.boundaryParam n y) = 0)
    (hwzero : ∀ᶠ y in 𝓝 x, w (EuclideanHalfSpace.boundaryParam n y) = 0)
    (hDw : normalDeriv w (EuclideanHalfSpace.boundaryParam n x) ≠ 0) :
    ∃ Q : EuclideanSpace ℝ (Fin n) × ℝ → ι → ℝ, AnalyticAt ℝ Q (x, 0) ∧
      (∀ i, Q (x, 0) i = normalDeriv (f i) (EuclideanHalfSpace.boundaryParam n x) /
        normalDeriv w (EuclideanHalfSpace.boundaryParam n x)) ∧
      ∀ᶠ z : EuclideanHalfSpace (n + 1) in 𝓝 (EuclideanHalfSpace.boundaryParam n x),
        ∀ i, z.val 0 ≠ 0 → w z ≠ 0 ∧ f i z / w z = Q (nativeNormalCoordinates z) i := by
  classical
  have hex (i : ι) := exists_native_normal_representative (hf i)
  choose H hH hHf hHb hHN using hex
  obtain ⟨W, hW, hWw, hWb, hWN⟩ := exists_native_normal_representative hw
  have hzeroH (i : ι) : ∀ᶠ z : EuclideanSpace ℝ (Fin n) × ℝ in 𝓝 (x, 0), H i (z.1, 0) = 0 := by
    filter_upwards [continuous_fst.continuousAt.eventually (hfzero i)] with z hz
    exact (hHb i z.1).trans hz
  have hzeroW : ∀ᶠ z : EuclideanSpace ℝ (Fin n) × ℝ in 𝓝 (x, 0), W (z.1, 0) = 0 := by
    filter_upwards [continuous_fst.continuousAt.eventually hwzero] with z hz
    exact (hWb z.1).trans hz
  have hDW : fderiv ℝ W (x, 0) (0, 1) ≠ 0 := hWN ▸ hDw
  obtain ⟨Q, hQ, hQbase, hQeq⟩ := exists_analytic_boundary_quotients hH hW hzeroH hzeroW hDW
  refine ⟨Q, hQ, ?_, ?_⟩
  · intro i
    rw [hQbase i, hHN i, hWN]
  have hT : Tendsto (nativeNormalCoordinates (n := n))
      (𝓝 (EuclideanHalfSpace.boundaryParam n x)) (𝓝 (x, 0)) := by
    have h := continuous_nativeNormalCoordinates.continuousAt.tendsto
      (x := EuclideanHalfSpace.boundaryParam n x)
    simpa only [nativeNormalCoordinates_boundary] using h
  filter_upwards [hT.eventually hQeq] with z hz
  intro i hzt
  have h := hz i (by simpa only [nativeNormalCoordinates_snd] using hzt)
  simpa only [← hHf i z, ← hWw z] using h
end ConformalPoisson

end ProofPart_NativeBoundaryQuotient

/- Proof support: RemoteSolutionAnalyticity.lean, SHA256 fc02120d4fbf60912773bc858261def7ab3a701997a0b9baf83077d5066011c3 -/
noncomputable section ProofPart_RemoteSolutionAnalyticity




/- Apply the already permitted local boundary analytic regularity to
an ORIGINAL analytic problem at an unobserved point. The cutoff gauges
are not used or asserted analytic there. -/
open Set Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem DirichletSolver.analyticAt_unobserved_boundary
    (hRegularity : BoundaryAnalyticRegularityAssumption (n := n) (M := M))
    (A : AnalyticProblem (n := n) (M := M)) (S : DirichletSolver A.smoothMetric A.potential)
    {Γ : Set ((𝓡∂ (n + 1)).boundary M)} (f : BoundaryDatum Γ)
    (y : (𝓡∂ (n + 1)).boundary M) (hy : y ∉ Γ) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (S.solve f.val) (y : M) := by
  obtain ⟨V, hyV, hzero⟩ := BoundaryDatum.exists_unobserved_zero_boundary_neighborhood f y hy
  have hfanalytic : ContMDiffOn (𝓡 n) 𝓘(ℝ) ω f.val (observedPatch (n := n) V) :=
    contMDiffOn_const.congr hzero
  have hu := hRegularity A.metric A.potential A.analytic_potential f.val (S.solve f.val)
    (S.correct f.val f.property.1) V hfanalytic
  exact (hu (y : M) hyV).contMDiffAt (V.isOpen.mem_nhds hyV)
end ConformalPoisson

end ProofPart_RemoteSolutionAnalyticity

/- Proof support: NormalChartRemoteQuotients.lean, SHA256 61ece1c2c218aa091e223b4e8950e0a70c62f97124f83e54d3f9b83dbf25909d -/
noncomputable section ProofPart_NormalChartRemoteQuotients




/- Bind finite analytic quotient extension to the ACTUAL original
Dirichlet solutions in an ACTUAL normal chart at an unobserved point.
The supplied outward normal is converted to native inward time. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem DirichletSolver.normalChart_unobserved_boundary_zero
    (A : AnalyticProblem (n := n) (M := M)) (S : DirichletSolver A.smoothMetric A.potential)
    {Γ : Set ((𝓡∂ (n + 1)).boundary M)} (f : BoundaryDatum Γ)
    (y : (𝓡∂ (n + 1)).boundary M) (hy : y ∉ Γ)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    {x : EuclideanSpace ℝ (Fin n)} (hx : EuclideanHalfSpace.boundaryParam n x ∈ χ.source)
    (hbase : χ (EuclideanHalfSpace.boundaryParam n x) = (y : M)) :
    ∀ᶠ r in 𝓝 x, S.solve f.val (χ (EuclideanHalfSpace.boundaryParam n r)) = 0 := by
  obtain ⟨V, hyV, hzero⟩ := BoundaryDatum.exists_unobserved_zero_boundary_neighborhood f y hy
  have hc : ContinuousAt (fun r => χ (EuclideanHalfSpace.boundaryParam n r)) x :=
    (χ.contMDiffOn.continuousOn.continuousAt (χ.open_source.mem_nhds hx)).comp
      EuclideanHalfSpace.continuous_boundaryParam.continuousAt
  have hVnhds : (V : Set M) ∈ 𝓝 (χ (EuclideanHalfSpace.boundaryParam n x)) := by
    rw [hbase]
    exact V.isOpen.mem_nhds hyV
  have hnear : ∀ᶠ r in 𝓝 x, χ (EuclideanHalfSpace.boundaryParam n r) ∈ V :=
    hc.eventually hVnhds
  have hsource : ∀ᶠ r in 𝓝 x, EuclideanHalfSpace.boundaryParam n r ∈ χ.source :=
    EuclideanHalfSpace.continuous_boundaryParam.continuousAt.eventually (χ.open_source.mem_nhds hx)
  filter_upwards [hnear, hsource] with r hrV hrS
  have hzeroR : (EuclideanHalfSpace.boundaryParam n r).val 0 = 0 := by simp
  let z : (𝓡∂ (n + 1)).boundary M :=
    ⟨χ (EuclideanHalfSpace.boundaryParam n r), partialDiffeomorph_halfSpace_boundary χ hrS hzeroR⟩
  exact ((S.correct f.val f.property.1).2.2 z).trans (hzero hrV)

without_proof_info in
theorem DirichletSolver.exists_unobserved_normalChart_quotients {ι : Type*} [Fintype ι]
    (hRegularity : BoundaryAnalyticRegularityAssumption (n := n) (M := M))
    (A : AnalyticProblem (n := n) (M := M)) (S : DirichletSolver A.smoothMetric A.potential)
    {Γ : Set ((𝓡∂ (n + 1)).boundary M)}
    (f : ι → BoundaryDatum Γ) (f₀ : BoundaryDatum Γ)
    (y : (𝓡∂ (n + 1)).boundary M) (hy : y ∉ Γ)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    (G : NormalChartGeometry A.smoothMetric χ)
    {x : EuclideanSpace ℝ (Fin n)} (hx : EuclideanHalfSpace.boundaryParam n x ∈ χ.source)
    (hbase : χ (EuclideanHalfSpace.boundaryParam n x) = (y : M))
    (ν : (z : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (z : M))
    (hν : ∀ z, IsOutwardUnitNormal A.smoothMetric z (ν z))
    (hnormal : normalDerivative ν (S.solve f₀.val) y ≠ 0) :
    ∃ Q : EuclideanSpace ℝ (Fin n) × ℝ → ι → ℝ, AnalyticAt ℝ Q (x, 0) ∧
      ∀ᶠ z : EuclideanHalfSpace (n + 1) in 𝓝 (EuclideanHalfSpace.boundaryParam n x),
        ∀ i, z.val 0 ≠ 0 → S.solve f₀.val (χ z) ≠ 0 ∧
          S.solve (f i).val (χ z) / S.solve f₀.val (χ z) = Q (nativeNormalCoordinates z) i := by
  have hχ := χ.contMDiffOn.contMDiffAt (χ.open_source.mem_nhds hx)
  have hu (h : BoundaryDatum Γ) : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      (S.solve h.val ∘ χ) (EuclideanHalfSpace.boundaryParam n x) := by
    have han := S.analyticAt_unobserved_boundary hRegularity A h y hy
    have han' : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (S.solve h.val)
        (χ (EuclideanHalfSpace.boundaryParam n x)) := hbase.symm ▸ han
    exact han'.comp _ hχ
  have hz0 : (EuclideanHalfSpace.boundaryParam n x).val 0 = 0 := by simp
  have heBoundary : (⟨χ (EuclideanHalfSpace.boundaryParam n x),
      partialDiffeomorph_halfSpace_boundary χ hx hz0⟩ : (𝓡∂ (n + 1)).boundary M) = y :=
    Subtype.ext hbase
  have hN := G.normalDerivative hx hz0 ν hν (S.solve f₀.val)
    ((S.correct f₀.val f₀.property.1).1.mdifferentiable (by decide) _)
  rw [heBoundary] at hN
  have hDn : normalDeriv (S.solve f₀.val ∘ χ) (EuclideanHalfSpace.boundaryParam n x) ≠ 0 := by
    intro hzero
    apply hnormal
    change normalDerivative ν (S.solve f₀.val) y = -normalDeriv (S.solve f₀.val ∘ χ)
      (EuclideanHalfSpace.boundaryParam n x) at hN
    simpa only [hzero, neg_zero] using hN
  obtain ⟨Q, hQ, _, heq⟩ := exists_native_boundary_quotients
    (fun i => hu (f i)) (hu f₀)
    (fun i => S.normalChart_unobserved_boundary_zero A (f i) y hy χ hx hbase)
    (S.normalChart_unobserved_boundary_zero A f₀ y hy χ hx hbase) hDn
  exact ⟨Q, hQ, heq⟩
end ConformalPoisson

end ProofPart_NormalChartRemoteQuotients

/- Proof support: RemoteQuotientData.lean, SHA256 3e0cc55e3a6eb68c086af4b8daa252366ae33aec27d2ff39f7e0df9777c8a517 -/
noncomputable section ProofPart_RemoteQuotientData






/- Produce the actual finite original data and original normal chart
for an unobserved boundary limit. No finite-quotient or common-datum
existence is added as a premise. -/
open Bundle Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

structure RemoteQuotientData
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (b : (𝓡∂ (n + 1)).boundary M₂) where
  denominator : BoundaryDatum (observedPatch (n := n) V₁)
  source_nonzero : D.solver₁.solve denominator.val x ≠ 0
  target_normal_nonzero : normalDerivative D.normal₂
    (D.solver₂.solve (denominator.val ∘ D.boundaryIdentification.symm)) b ≠ 0
  numerators : Fin (n + 1) → BoundaryDatum (observedPatch (n := n) V₁)
  numerator_zero : ∀ i, D.solver₁.solve (numerators i).val x = 0
  quotient_diffeo : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
    (quotientCoordinates (fun i => D.solver₁.solve (numerators i).val) (D.solver₁.solve denominator.val)) x
  chart : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω
  geometry : NormalChartGeometry A₂.smoothMetric chart
  base : EuclideanSpace ℝ (Fin n)
  base_mem : EuclideanHalfSpace.boundaryParam n base ∈ chart.source
  base_value : chart (EuclideanHalfSpace.boundaryParam n base) = (b : M₂)
  quotient : EuclideanSpace ℝ (Fin n) × ℝ → Fin (n + 1) → ℝ
  quotient_analytic : AnalyticAt ℝ quotient (base, 0)
  quotient_extension : ∀ᶠ z : EuclideanHalfSpace (n + 1) in 𝓝 (EuclideanHalfSpace.boundaryParam n base),
    ∀ i, z.val 0 ≠ 0 → D.solver₂.solve (denominator.val ∘ D.boundaryIdentification.symm) (chart z) ≠ 0 ∧
      D.solver₂.solve ((numerators i).val ∘ D.boundaryIdentification.symm) (chart z) /
        D.solver₂.solve (denominator.val ∘ D.boundaryIdentification.symm) (chart z) =
          quotient (nativeNormalCoordinates z) i

variable [CompactSpace M₂] [MeasurableSpace M₂] [BorelSpace M₂]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₂)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₂)]

local instance remoteQuotientBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M₂) :=
  compactSpace_nativeBoundary

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_remoteQuotientData
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hBoundaryReg₂ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₂))
    (hGreen₂ : GreenKernelAssumption (n := n) (M := M₂))
    (hInverse₂ : ForwardInhomogeneousAssumption (n := n) (M := M₂))
    (hEstimate₂ : NormalTraceInverseEstimateAssumption (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (hx : x ∈ (𝓡∂ (n + 1)).interior M₁)
    (b : (𝓡∂ (n + 1)).boundary M₂) (hb : (b : M₂) ∉ V₂) :
    Nonempty (RemoteQuotientData A₁ A₂ V₁ V₂ D x b) := by
  let Γ₁ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₁) :=
    ⟨observedPatch (n := n) V₁, V₁.isOpen.preimage continuous_subtype_val⟩
  let Γ₂ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₂) :=
    ⟨observedPatch (n := n) V₂, V₂.isOpen.preimage continuous_subtype_val⟩
  have hΓ₂ : (Γ₂ : Set ((𝓡∂ (n + 1)).boundary M₂)).Nonempty := by
    obtain ⟨a, ha⟩ := D.patch_nonempty
    exact ⟨D.boundaryIdentification a, (D.patches_match a).mp ha⟩
  obtain ⟨fval, hfval⟩ := exists_datum_with_value_one hSchauder (hRunge₁ A₁) hn hcompact₁ hconnected₁ (A₁.analytic_potential.of_le (by decide)) A₁.nonresonant
    D.solver₁ Γ₁ D.patch_nonempty x hx
  obtain ⟨fnormal, hfnormal, _, _⟩ := exists_remote_normal_solution_of_analytic
    hGreen₂ hInverse₂ hEstimate₂ hReg₂ hconnected₂ A₂
    D.normal₂ D.normal₂_spec D.solver₂ b Γ₂ hΓ₂ hb
  obtain ⟨f₀, hf₀, hf₀normal⟩ := exists_common_value_normal_datum A₁ A₂ D.solver₁ D.solver₂
    D.boundaryIdentification D.patches_match D.normal₂ x b
    ⟨fval, by simpa only [hfval] using (one_ne_zero : (1 : ℝ) ≠ 0)⟩ ⟨fnormal, hfnormal⟩
  obtain ⟨fs, hfs, hIFT⟩ := exists_interior_analytic_quotient_coordinates_fixed_denominator
    hSchauder hRunge₁ hReg₁ hn hcompact₁ hconnected₁ A₁ D.solver₁ Γ₁ D.patch_nonempty x hx f₀ hf₀
  obtain ⟨C⟩ := exists_normalChartData A₂.smoothMetric (⊤ : TopologicalSpace.Opens M₂)
    (metricAnalyticOn_of_analytic A₂.metric _) (Set.mem_univ (b : M₂))
  let r := extChartAt (𝓡 n) b b
  have hbase : EuclideanHalfSpace.boundaryParam n r = chartAt (EuclideanHalfSpace (n + 1)) (b : M₂) (b : M₂) := by
    apply Subtype.ext
    simpa only [EuclideanHalfSpace.boundaryParam_coe,
      euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam] using (boundaryNormalBase_read b).symm
  have hrmem : EuclideanHalfSpace.boundaryParam n r ∈ C.chart.source := by rw [hbase]; exact C.base_mem
  have hrvalue : C.chart (EuclideanHalfSpace.boundaryParam n r) = (b : M₂) := by rw [hbase]; exact C.base_value
  let f₂ : Fin (n + 1) → BoundaryDatum (observedPatch (n := n) V₂) :=
    fun i => transportBoundaryDatum D.boundaryIdentification D.patches_match (fs i)
  let f₀₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match f₀
  obtain ⟨Q, hQ, hQext⟩ := D.solver₂.exists_unobserved_normalChart_quotients hBoundaryReg₂ A₂
    f₂ f₀₂ b hb C.chart C.geometry hrmem hrvalue D.normal₂ D.normal₂_spec hf₀normal
  refine ⟨{ denominator := f₀
            source_nonzero := hf₀
            target_normal_nonzero := hf₀normal
            numerators := fs
            numerator_zero := hfs
            quotient_diffeo := hIFT
            chart := C.chart
            geometry := C.geometry
            base := r
            base_mem := hrmem
            base_value := hrvalue
            quotient := Q
            quotient_analytic := hQ
            quotient_extension := hQext }⟩
end ConformalPoisson

end ProofPart_RemoteQuotientData

/- Proof support: OldInverseChart.lean, SHA256 f1acd1c3676adf3c9024fa6db9172aac8989e40815f95c8fe591fe8d175b6e2c -/
noncomputable section ProofPart_OldInverseChart



/- The old inverse in actual normal coordinates is an ACTUAL partial
diffeomorphism, chi followed by J inverse. Eventual agreement on an
open matching set supplies the regular point for no-escape. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

def oldInverseChart
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω) :
    PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₁ ω := χ.trans J.symm

without_proof_info in
theorem oldInverseChart_source
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω) :
    (oldInverseChart J χ).source = χ.source ∩ χ ⁻¹' J.target := rfl

without_proof_info in
theorem oldInverseChart_maps_to_source
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ (oldInverseChart J χ).source) :
    oldInverseChart J χ z ∈ J.source := J.map_target hz.2

without_proof_info in
theorem oldInverseChart_right_inverse
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ (oldInverseChart J χ).source) :
    J (oldInverseChart J χ z) = χ z := J.right_inv hz.2

without_proof_info in
theorem oldInverseChart_regular_on_open_match
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    {F : EuclideanHalfSpace (n + 1) → M₁} {W : Set (EuclideanHalfSpace (n + 1))}
    (hW : IsOpen W) (hWs : W ⊆ (oldInverseChart J χ).source)
    (heq : EqOn F (oldInverseChart J χ) W) {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ W) :
    (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z).IsInvertible := by
  have hevent := Filter.eventuallyEq_of_mem (hW.mem_nhds hz) heq
  have hD := hevent.mfderiv_eq (I := 𝓡∂ (n + 1)) (I' := 𝓡∂ (n + 1))
  change mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z =
    mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (oldInverseChart J χ) z at hD
  rw [hD]
  exact ((oldInverseChart J χ).isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
    (hWs hz)).isInvertible_mfderiv (by decide)
end ConformalPoisson

end ProofPart_OldInverseChart

/- Proof support: OldInverseSequence.lean, SHA256 7c01e5814432e7bf38d5180be1e14cfead03575743b5ac65aca65d4dbde2fe92 -/
noncomputable section ProofPart_OldInverseSequence



/- The SAME escaping image sequence read in the ACTUAL normal chart.
Its old inverse values are eventually the original source sequence. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem oldInverseChart_source_interior
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    (hJ : J.source ⊆ (𝓡∂ (n + 1)).interior M₁) :
    (oldInverseChart J χ).source ⊆ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1)) := by
  intro z hz
  exact ((oldInverseChart J χ).isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω hz).isInteriorPoint_iff
    (by decide : (ω : ℕ∞ω) ≠ 0) |>.mpr (hJ (oldInverseChart_maps_to_source J χ hz))

without_proof_info in
theorem oldInverseChart_sequence
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    {z₀ : EuclideanHalfSpace (n + 1)} (hz₀ : z₀ ∈ χ.source)
    {xs : ℕ → M₁} {x : M₁} (hxs : Tendsto xs atTop (𝓝 x))
    (hs : ∀ k, xs k ∈ J.source) (hys : Tendsto (J ∘ xs) atTop (𝓝 (χ z₀))) :
    Tendsto (fun k => χ.symm (J (xs k))) atTop (𝓝 z₀) ∧
      Tendsto (fun k => oldInverseChart J χ (χ.symm (J (xs k)))) atTop (𝓝 x) ∧
      ∀ᶠ k in atTop, χ.symm (J (xs k)) ∈ (oldInverseChart J χ).source ∧
        oldInverseChart J χ (χ.symm (J (xs k))) = xs k ∧ χ (χ.symm (J (xs k))) = J (xs k) := by
  have htarget : χ z₀ ∈ χ.target := χ.map_source hz₀
  have hχinv := χ.symm.contMDiffOn.continuousOn.continuousAt
    (χ.symm.open_source.mem_nhds htarget)
  have hzlim : Tendsto (fun k => χ.symm (J (xs k))) atTop (𝓝 (χ.symm (χ z₀))) :=
    hχinv.tendsto.comp hys
  have hleft : χ.symm (χ z₀) = z₀ := χ.left_inv hz₀
  rw [hleft] at hzlim
  have hnear : ∀ᶠ k in atTop, J (xs k) ∈ χ.target := hys.eventually (χ.open_target.mem_nhds htarget)
  have hall : ∀ᶠ k in atTop, χ.symm (J (xs k)) ∈ (oldInverseChart J χ).source ∧
      oldInverseChart J χ (χ.symm (J (xs k))) = xs k ∧ χ (χ.symm (J (xs k))) = J (xs k) := by
    filter_upwards [hnear] with k hk
    have hχright : χ (χ.symm (J (xs k))) = J (xs k) := χ.right_inv hk
    have hKsource : χ.symm (J (xs k)) ∈ (oldInverseChart J χ).source := by
      rw [oldInverseChart_source]
      refine ⟨χ.map_target hk, ?_⟩
      change χ (χ.symm (J (xs k))) ∈ J.target
      rw [hχright]
      exact J.map_source (hs k)
    refine ⟨hKsource, ?_, hχright⟩
    change J.symm (χ (χ.symm (J (xs k)))) = xs k
    rw [hχright]
    exact J.left_inv (hs k)
  have heq : (fun k => oldInverseChart J χ (χ.symm (J (xs k)))) =ᶠ[atTop] xs := hall.mono fun _ h => h.2.1
  exact ⟨hzlim, hxs.congr' heq.symm, hall⟩
end ConformalPoisson

end ProofPart_OldInverseSequence

/- Proof support: InverseQuotientMatching.lean, SHA256 4fd06326094b6386164a483d23a8d0f7b6a6aa18f6ed83f3eb95cdde42a7306b -/
noncomputable section ProofPart_InverseQuotientMatching





/- The SAME original datum family and common scale identify actual
source quotient coordinates with the target signed quotient extension
on the old inverse domain, which lies in the native interior. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ D : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem inverse_quotient_coordinates_eq_on_old_domain
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    (hJ : J.source ⊆ (𝓡∂ (n + 1)).interior M₁)
    (u : D → M₁ → ℝ) (v : D → M₂ → ℝ) (c : M₁ → ℝ)
    (hc : ∀ x ∈ J.source, c x ≠ 0)
    (hrel : ∀ d x, x ∈ J.source → u d x = c x * v d (J x))
    (d₀ : D) (ds : Fin (n + 1) → D)
    (Q : EuclideanHalfSpace (n + 1) → Fin (n + 1) → ℝ)
    {S : Set (EuclideanHalfSpace (n + 1))}
    (hQ : ∀ z ∈ S, ∀ i, z.val 0 ≠ 0 → v d₀ (χ z) ≠ 0 ∧
      v (ds i) (χ z) / v d₀ (χ z) = Q z i) :
    ∀ z ∈ (oldInverseChart J χ).source ∩ S,
      quotientCoordinates (fun i => u (ds i)) (u d₀) (oldInverseChart J χ z) = Q z := by
  intro z hz
  have hxJ := oldInverseChart_maps_to_source J χ hz.1
  have hpoint := oldInverseChart_right_inverse J χ hz.1
  have hcoord := quotientCoordinates_eq_of_scaled_evaluations u v d₀ ds
    (oldInverseChart J χ z) (χ z) (c (oldInverseChart J χ z)) (hc _ hxJ) (fun d => by
      simpa only [hpoint] using hrel d _ hxJ)
  have hzI := oldInverseChart_source_interior J χ hJ hz.1
  have hzt : z.val 0 ≠ 0 := ((halfSpace_mem_interior_iff z).mp hzI).ne'
  funext i
  exact (congrFun hcoord i).trans ((hQ z hz.2 i hzt).2)
end ConformalPoisson

end ProofPart_InverseQuotientMatching

/- Proof support: NativeAnalyticQuotientMap.lean, SHA256 5382678fb47c0d45c059438f490d3adba7502e0f124930d59d528f4084103935 -/
noncomputable section ProofPart_NativeAnalyticQuotientMap



/- A signed analytic quotient extension gives an actual native analytic
map through a chosen quotient inverse, without asserting invertibility
of that continued map's differential at the boundary. -/
open Set TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

without_proof_info in
theorem analyticAt_comp_nativeNormalCoordinates
    {Q : EuclideanSpace ℝ (Fin n) × ℝ → F} {x : EuclideanSpace ℝ (Fin n)}
    (hQ : AnalyticAt ℝ Q (x, 0)) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω (Q ∘ nativeNormalCoordinates)
      (EuclideanHalfSpace.boundaryParam n x) := by
  let z := EuclideanHalfSpace.boundaryParam n x
  let e := euclideanHalfSpaceBoundaryNormalEquiv n
  have hval : e.symm ((𝓡∂ (n + 1)) z) = (x, 0) := nativeNormalCoordinates_boundary x
  have hG : AnalyticAt ℝ (Q ∘ e.symm) ((𝓡∂ (n + 1)) z) :=
    hQ.comp_of_eq (e.symm.analyticAt _) hval
  have hI : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ω
      (𝓡∂ (n + 1)) z := contMDiffAt_extChartAt (I := 𝓡∂ (n + 1)) (n := ω) (x := z)
  exact hG.contDiffAt.contMDiffAt.comp z hI

variable {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

omit [IsManifold (𝓡∂ (n + 1)) ω M] in
without_proof_info in
theorem quotient_inverse_extension_analyticAt
    (E : PartialDiffeomorph 𝓘(ℝ, F) (𝓡∂ (n + 1)) F M ω)
    {Q : EuclideanSpace ℝ (Fin n) × ℝ → F} {x : EuclideanSpace ℝ (Fin n)}
    (hQ : AnalyticAt ℝ Q (x, 0)) (hq : Q (x, 0) ∈ E.source) :
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
      (fun z => E (Q (nativeNormalCoordinates z))) (EuclideanHalfSpace.boundaryParam n x) := by
  have hE := E.contMDiffOn.contMDiffAt (E.open_source.mem_nhds hq)
  have hQnative := analyticAt_comp_nativeNormalCoordinates hQ
  have hE' : ContMDiffAt 𝓘(ℝ, F) (𝓡∂ (n + 1)) ω E
      ((Q ∘ nativeNormalCoordinates) (EuclideanHalfSpace.boundaryParam n x)) := by
    simpa only [Function.comp_apply, nativeNormalCoordinates_boundary] using hE
  exact hE'.comp _ hQnative
end ConformalPoisson

end ProofPart_NativeAnalyticQuotientMap

/- Proof support: InverseQuotientLimit.lean, SHA256 5b2837e7303f2ffd8645e33a22200440f2ef29ca35106fa3bc2ba28e25e9e177 -/
noncomputable section ProofPart_InverseQuotientLimit



/- The actual escaping sequence identifies the signed quotient's base
value with the SAME source quotient coordinate, before choosing its
inverse. No several-variable identity argument uses only a sequence. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ D : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem inverse_signed_quotient_base_eq
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)
    (hJ : J.source ⊆ (𝓡∂ (n + 1)).interior M₁)
    (u : D → M₁ → ℝ) (v : D → M₂ → ℝ) (c : M₁ → ℝ)
    (hc : ∀ x ∈ J.source, c x ≠ 0)
    (hrel : ∀ d x, x ∈ J.source → u d x = c x * v d (J x))
    (d₀ : D) (ds : Fin (n + 1) → D)
    {Q : EuclideanSpace ℝ (Fin n) × ℝ → Fin (n + 1) → ℝ} {r : EuclideanSpace ℝ (Fin n)}
    (hQ : AnalyticAt ℝ Q (r, 0))
    (hremote : ∀ᶠ z : EuclideanHalfSpace (n + 1) in 𝓝 (EuclideanHalfSpace.boundaryParam n r),
      ∀ i, z.val 0 ≠ 0 → v d₀ (χ z) ≠ 0 ∧
        v (ds i) (χ z) / v d₀ (χ z) = Q (nativeNormalCoordinates z) i)
    (hz₀ : EuclideanHalfSpace.boundaryParam n r ∈ χ.source)
    {xs : ℕ → M₁} {x : M₁} (hxs : Tendsto xs atTop (𝓝 x)) (hs : ∀ k, xs k ∈ J.source)
    (hys : Tendsto (J ∘ xs) atTop (𝓝 (χ (EuclideanHalfSpace.boundaryParam n r))))
    (hsource : ContinuousAt (quotientCoordinates (fun i => u (ds i)) (u d₀)) x) :
    Q (r, 0) = quotientCoordinates (fun i => u (ds i)) (u d₀) x := by
  obtain ⟨hzlim, hKlim, hall⟩ := oldInverseChart_sequence J χ hz₀ hxs hs hys
  let zs := fun k => χ.symm (J (xs k))
  let S : Set (EuclideanHalfSpace (n + 1)) := {z | ∀ i, z.val 0 ≠ 0 → v d₀ (χ z) ≠ 0 ∧
    v (ds i) (χ z) / v d₀ (χ z) = Q (nativeNormalCoordinates z) i}
  have hSnear : ∀ᶠ k in atTop, zs k ∈ S := hzlim.eventually hremote
  have hmatching := inverse_quotient_coordinates_eq_on_old_domain J χ hJ u v c hc hrel d₀ ds
    (Q ∘ nativeNormalCoordinates) (S := S) (fun z hz => hz)
  have heq : (fun k => quotientCoordinates (fun i => u (ds i)) (u d₀) (oldInverseChart J χ (zs k))) =ᶠ[atTop]
      (fun k => Q (nativeNormalCoordinates (zs k))) := by
    filter_upwards [hall, hSnear] with k hk hSk
    exact hmatching (zs k) ⟨hk.1, hSk⟩
  have hsourceLim := hsource.tendsto.comp hKlim
  have htargetLim : Tendsto (fun k => Q (nativeNormalCoordinates (zs k))) atTop (𝓝 (Q (r, 0))) := by
    have h : Tendsto (fun k => Q (nativeNormalCoordinates (zs k))) atTop
        (𝓝 ((Q ∘ nativeNormalCoordinates) (EuclideanHalfSpace.boundaryParam n r))) :=
      (analyticAt_comp_nativeNormalCoordinates hQ).continuousAt.tendsto.comp hzlim
    simpa only [Function.comp_apply, nativeNormalCoordinates_boundary] using h
  exact tendsto_nhds_unique htargetLim (hsourceLim.congr' heq)
end ConformalPoisson

end ProofPart_InverseQuotientLimit

/- Proof support: QuotientInverseExtension.lean, SHA256 52671655d50514db9fc399d6e88c285b655a1ee4da68ff7edb917c286d9c3448 -/
noncomputable section ProofPart_QuotientInverseExtension


/- The continued inverse is the genuine source quotient inverse
composed with the signed target quotient extension. All domains and
base values remain those of this same explicit map. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  {Q₁ : M → Fin (n + 1) → ℝ} {x : M}

def quotientInverseExtension
    (hQ₁ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω Q₁ x)
    (Q₂ : EuclideanSpace ℝ (Fin n) × ℝ → Fin (n + 1) → ℝ) : EuclideanHalfSpace (n + 1) → M :=
  fun z => hQ₁.localInverse (Q₂ (nativeNormalCoordinates z))

without_proof_info in
theorem quotientInverseExtension_analyticAt
    (hQ₁ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω Q₁ x)
    {Q₂ : EuclideanSpace ℝ (Fin n) × ℝ → Fin (n + 1) → ℝ} {r : EuclideanSpace ℝ (Fin n)}
    (hQ₂ : AnalyticAt ℝ Q₂ (r, 0)) (hbase : Q₂ (r, 0) = Q₁ x) :
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω (quotientInverseExtension hQ₁ Q₂)
      (EuclideanHalfSpace.boundaryParam n r) := by
  apply quotient_inverse_extension_analyticAt hQ₁.localInverse hQ₂
  rw [hbase]
  exact hQ₁.localInverse_mem_source

without_proof_info in
theorem quotientInverseExtension_base
    (hQ₁ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω Q₁ x)
    {Q₂ : EuclideanSpace ℝ (Fin n) × ℝ → Fin (n + 1) → ℝ} {r : EuclideanSpace ℝ (Fin n)}
    (hbase : Q₂ (r, 0) = Q₁ x) : quotientInverseExtension hQ₁ Q₂ (EuclideanHalfSpace.boundaryParam n r) = x := by
  change hQ₁.localInverse (Q₂ (nativeNormalCoordinates (EuclideanHalfSpace.boundaryParam n r))) = x
  rw [nativeNormalCoordinates_boundary, hbase]
  exact hQ₁.localInverse_left_inv hQ₁.localInverse_mem_target

without_proof_info in
theorem quotientInverseExtension_eventually_inverse
    (hQ₁ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω Q₁ x)
    {Q₂ : EuclideanSpace ℝ (Fin n) × ℝ → Fin (n + 1) → ℝ} {r : EuclideanSpace ℝ (Fin n)}
    (hQ₂ : AnalyticAt ℝ Q₂ (r, 0)) (hbase : Q₂ (r, 0) = Q₁ x) :
    ∀ᶠ z : EuclideanHalfSpace (n + 1) in 𝓝 (EuclideanHalfSpace.boundaryParam n r),
      Q₂ (nativeNormalCoordinates z) ∈ hQ₁.localInverse.source ∧
      quotientInverseExtension hQ₁ Q₂ z ∈ hQ₁.localInverse.target ∧
      Q₁ (quotientInverseExtension hQ₁ Q₂ z) = Q₂ (nativeNormalCoordinates z) := by
  have hnear : hQ₁.localInverse.source ∈ 𝓝
      ((Q₂ ∘ nativeNormalCoordinates) (EuclideanHalfSpace.boundaryParam n r)) := by
    simp only [Function.comp_apply, nativeNormalCoordinates_boundary, hbase]
    exact hQ₁.localInverse.open_source.mem_nhds hQ₁.localInverse_mem_source
  have he := (analyticAt_comp_nativeNormalCoordinates hQ₂).continuousAt.eventually hnear
  filter_upwards [he] with z hz
  exact ⟨hz, hQ₁.localInverse.map_source hz, hQ₁.localInverse_right_inv hz⟩
end ConformalPoisson

end ProofPart_QuotientInverseExtension

/- Proof support: RemoteInverseExtension.lean, SHA256 2c7c72d4a802c9cdb3e446de39d9b81d1d5f0546bc3e74a1709d379d37440f37 -/
noncomputable section ProofPart_RemoteInverseExtension




/- Bind the explicit continued inverse to the ACTUAL original finite
remote data. The escaping sequence supplies its genuine inverse base
membership, without assuming any extension of the original scale. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {b : (𝓡∂ (n + 1)).boundary M₂}

def RemoteQuotientData.sourceCoordinates (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b) :
    M₁ → Fin (n + 1) → ℝ :=
  quotientCoordinates (fun i => D.solver₁.solve (R.numerators i).val) (D.solver₁.solve R.denominator.val)

def RemoteQuotientData.continuedInverse (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b) :
    EuclideanHalfSpace (n + 1) → M₁ := quotientInverseExtension R.quotient_diffeo R.quotient

without_proof_info in
theorem RemoteQuotientData.base_eq_of_sequence
    (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b)
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hJ : J.source ⊆ (𝓡∂ (n + 1)).interior M₁) (c : M₁ → ℝ)
    (hc : ∀ y ∈ J.source, c y ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ y ∈ J.source,
      D.solver₁.solve f.val y = c y * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J y))
    {xs : ℕ → M₁} (hxs : Tendsto xs atTop (𝓝 x)) (hs : ∀ k, xs k ∈ J.source)
    (hys : Tendsto (J ∘ xs) atTop (𝓝 (b : M₂))) :
    R.quotient (R.base, 0) = R.sourceCoordinates x := by
  have hys' : Tendsto (J ∘ xs) atTop (𝓝 (R.chart (EuclideanHalfSpace.boundaryParam n R.base))) := by
    rw [R.base_value]
    exact hys
  exact inverse_signed_quotient_base_eq J R.chart hJ
    (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
    (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)) c hc hrel
    R.denominator R.numerators R.quotient_analytic R.quotient_extension R.base_mem
    hxs hs hys' R.quotient_diffeo.contMDiffAt.continuousAt

without_proof_info in
theorem RemoteQuotientData.continuedInverse_analyticAt
    (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b)
    (hbase : R.quotient (R.base, 0) = R.sourceCoordinates x) :
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω R.continuedInverse
      (EuclideanHalfSpace.boundaryParam n R.base) :=
  quotientInverseExtension_analyticAt R.quotient_diffeo R.quotient_analytic hbase

without_proof_info in
theorem RemoteQuotientData.continuedInverse_base
    (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b)
    (hbase : R.quotient (R.base, 0) = R.sourceCoordinates x) :
    R.continuedInverse (EuclideanHalfSpace.boundaryParam n R.base) = x :=
  quotientInverseExtension_base R.quotient_diffeo hbase

without_proof_info in
theorem RemoteQuotientData.continuedInverse_eventually_inverse
    (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b)
    (hbase : R.quotient (R.base, 0) = R.sourceCoordinates x) :
    ∀ᶠ z : EuclideanHalfSpace (n + 1) in 𝓝 (EuclideanHalfSpace.boundaryParam n R.base),
      R.quotient (nativeNormalCoordinates z) ∈ R.quotient_diffeo.localInverse.source ∧
      R.continuedInverse z ∈ R.quotient_diffeo.localInverse.target ∧
      R.sourceCoordinates (R.continuedInverse z) = R.quotient (nativeNormalCoordinates z) :=
  quotientInverseExtension_eventually_inverse R.quotient_diffeo R.quotient_analytic hbase
end ConformalPoisson

end ProofPart_RemoteInverseExtension

/- Proof support: NativeBoundaryNeighborhood.lean, SHA256 de84e077ce96e7ee2d751b1a5b17b9861954c628d5291ddba75354fa780b4321 -/
noncomputable section ProofPart_NativeBoundaryNeighborhood


/- One native half-neighborhood and one connected spatial face patch
inside finitely assembled actual germ conditions. Both are chosen once
before any normal-order induction or all-data continuation. -/
open Set Filter Topology TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ}

without_proof_info in
theorem exists_native_boundary_neighborhood
    {x : EuclideanSpace ℝ (Fin n)} {S : Set (EuclideanHalfSpace (n + 1))}
    (hS : S ∈ 𝓝 (EuclideanHalfSpace.boundaryParam n x))
    {Z : Set (EuclideanSpace ℝ (Fin n))} (hZ : Z ∈ 𝓝 x) :
    ∃ U : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1)),
      EuclideanHalfSpace.boundaryParam n x ∈ U ∧ (U : Set (EuclideanHalfSpace (n + 1))) ⊆ S ∧
      IsConnected ((U : Set (EuclideanHalfSpace (n + 1))) ∩
        (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1))) ∧
      ∃ P : TopologicalSpace.Opens (EuclideanSpace ℝ (Fin n)),
        x ∈ P ∧ (P : Set (EuclideanSpace ℝ (Fin n))) ⊆ Z ∧ IsConnected (P : Set (EuclideanSpace ℝ (Fin n))) ∧
        MapsTo (EuclideanHalfSpace.boundaryParam n) P U := by
  obtain ⟨ε, hε, hsub⟩ := exists_halfSpaceBall_subset hS
  let U : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1)) :=
    ⟨halfSpaceBall (EuclideanHalfSpace.boundaryParam n x) ε, halfSpaceBall_isOpen _ _⟩
  have hxU : EuclideanHalfSpace.boundaryParam n x ∈ U := Metric.mem_ball_self hε
  have hface : (EuclideanHalfSpace.boundaryParam n) ⁻¹' (U : Set (EuclideanHalfSpace (n + 1))) ∈ 𝓝 x :=
    EuclideanHalfSpace.continuous_boundaryParam.continuousAt.preimage_mem_nhds (U.isOpen.mem_nhds hxU)
  obtain ⟨δ, hδ, hδsub⟩ := Metric.mem_nhds_iff.mp (inter_mem hZ hface)
  let P : TopologicalSpace.Opens (EuclideanSpace ℝ (Fin n)) := ⟨Metric.ball x δ, Metric.isOpen_ball⟩
  exact ⟨U, hxU, hsub, halfSpace_ball_interior_connected _ hε, P, Metric.mem_ball_self hδ,
    (fun y hy => (hδsub hy).1), ⟨⟨x, Metric.mem_ball_self hδ⟩, (convex_ball x δ).isPreconnected⟩,
    fun y hy => (hδsub hy).2⟩
end ConformalPoisson

end ProofPart_NativeBoundaryNeighborhood

/- Proof support: RemoteInverseNeighborhood.lean, SHA256 26f96c04d8302e2970660518529cfe3ed59b5034f0c46db39eaf159e4a7a2d1e -/
noncomputable section ProofPart_RemoteInverseNeighborhood




/- Assemble the finite analytic/source/nonzero germs BEFORE choosing
one connected half-neighborhood and one connected boundary patch for
the SAME explicit continued inverse and original denominator solutions. -/
open Bundle Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {b : (𝓡∂ (n + 1)).boundary M₂}

structure RemoteInverseNeighborhood (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b) where
  domain : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))
  base_mem : EuclideanHalfSpace.boundaryParam n R.base ∈ domain
  interior_connected : IsConnected ((domain : Set (EuclideanHalfSpace (n + 1))) ∩
    (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1)))
  chart_source : (domain : Set (EuclideanHalfSpace (n + 1))) ⊆ R.chart.source
  image_chart : MapsTo R.continuedInverse domain (chartAt (EuclideanHalfSpace (n + 1)) x).source
  image_interior : MapsTo R.continuedInverse domain ((𝓡∂ (n + 1)).interior M₁)
  map_analytic : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω R.continuedInverse domain
  source_solution_analytic : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
    (D.solver₁.solve R.denominator.val ∘ R.continuedInverse) domain
  target_solution_analytic : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
    (D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) ∘ R.chart) domain
  source_solution_nonzero : ∀ z ∈ domain, D.solver₁.solve R.denominator.val (R.continuedInverse z) ≠ 0
  quotients : ∀ z ∈ domain, ∀ i, z.val 0 ≠ 0 →
    D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.chart z) ≠ 0 ∧
      D.solver₂.solve ((R.numerators i).val ∘ D.boundaryIdentification.symm) (R.chart z) /
        D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.chart z) =
          R.quotient (nativeNormalCoordinates z) i
  patch : TopologicalSpace.Opens (EuclideanSpace ℝ (Fin n))
  patch_base : R.base ∈ patch
  patch_connected : IsConnected (patch : Set (EuclideanSpace ℝ (Fin n)))
  patch_into_domain : MapsTo (EuclideanHalfSpace.boundaryParam n) patch domain
  boundary_solution_zero : ∀ r ∈ patch,
    D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm)
      (R.chart (EuclideanHalfSpace.boundaryParam n r)) = 0

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_remoteInverseNeighborhood
    (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b)
    (hbase : R.quotient (R.base, 0) = R.sourceCoordinates x)
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hBoundaryReg₂ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₂))
    (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) (hb : (b : M₂) ∉ V₂) :
    Nonempty (RemoteInverseNeighborhood R) := by
  let z₀ := EuclideanHalfSpace.boundaryParam n R.base
  let F := R.continuedInverse
  let a := D.solver₁.solve R.denominator.val ∘ F
  let q := D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) ∘ R.chart
  have hF₀ := R.continuedInverse_analyticAt hbase
  have hFx : F z₀ = x := R.continuedInverse_base hbase
  have hsource := D.solver₁.analyticAt_interior hReg₁ A₁.metric A₁.potential A₁.analytic_potential
    R.denominator.val R.denominator.property.1 x hx
  have hsource' : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (D.solver₁.solve R.denominator.val) (F z₀) :=
    hFx.symm ▸ hsource
  have ha₀ : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω a z₀ := hsource'.comp z₀ hF₀
  let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match R.denominator
  have htarget := D.solver₂.analyticAt_unobserved_boundary hBoundaryReg₂ A₂ f₂ b hb
  have htarget' : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (D.solver₂.solve f₂.val) (R.chart z₀) :=
    R.base_value.symm ▸ htarget
  have hχ₀ := R.chart.contMDiffOn.contMDiffAt (R.chart.open_source.mem_nhds R.base_mem)
  have hq₀ : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω q z₀ := htarget'.comp z₀ hχ₀
  have ha_ne : a z₀ ≠ 0 := by
    change D.solver₁.solve R.denominator.val (F z₀) ≠ 0
    rw [hFx]
    exact R.source_nonzero
  have hchart : F ⁻¹' (chartAt (EuclideanHalfSpace (n + 1)) x).source ∈ 𝓝 z₀ := by
    apply hF₀.continuousAt.preimage_mem_nhds
    change (chartAt (EuclideanHalfSpace (n + 1)) x).source ∈ 𝓝 (F z₀)
    rw [hFx]
    exact (chartAt (EuclideanHalfSpace (n + 1)) x).open_source.mem_nhds (mem_chart_source _ _)
  have hinterior : F ⁻¹' ((𝓡∂ (n + 1)).interior M₁) ∈ 𝓝 z₀ := by
    apply hF₀.continuousAt.preimage_mem_nhds
    change (𝓡∂ (n + 1)).interior M₁ ∈ 𝓝 (F z₀)
    rw [hFx]
    exact ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).mem_nhds hx
  let S := {z : EuclideanHalfSpace (n + 1) | z ∈ R.chart.source ∧
    F z ∈ (chartAt (EuclideanHalfSpace (n + 1)) x).source ∧ F z ∈ (𝓡∂ (n + 1)).interior M₁ ∧ a z ≠ 0 ∧
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω F z ∧
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω a z ∧ ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω q z ∧
    ∀ i, z.val 0 ≠ 0 → D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.chart z) ≠ 0 ∧
      D.solver₂.solve ((R.numerators i).val ∘ D.boundaryIdentification.symm) (R.chart z) /
        D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.chart z) =
          R.quotient (nativeNormalCoordinates z) i}
  have hS : S ∈ 𝓝 z₀ := by
    have hFe := (contMDiffAt_iff_contMDiffAt_nhds (by decide : (ω : ℕ∞ω) ≠ ∞)).mp hF₀
    have hae := (contMDiffAt_iff_contMDiffAt_nhds (by decide : (ω : ℕ∞ω) ≠ ∞)).mp ha₀
    have hqe := (contMDiffAt_iff_contMDiffAt_nhds (by decide : (ω : ℕ∞ω) ≠ ∞)).mp hq₀
    have hane := ha₀.continuousAt.eventually (eventually_ne_nhds ha_ne)
    filter_upwards [R.chart.open_source.mem_nhds R.base_mem, hchart, hinterior, hane,
      hFe, hae, hqe, R.quotient_extension] with z hz hc hi han hf haa hqq hQ
    exact ⟨hz, hc, hi, han, hf, haa, hqq, hQ⟩
  have hZ := D.solver₂.normalChart_unobserved_boundary_zero A₂ f₂ b hb R.chart R.base_mem R.base_value
  obtain ⟨U, hzU, hUS, hUconn, P, hrP, hPZ, hPconn, hPU⟩ := exists_native_boundary_neighborhood hS hZ
  refine ⟨{ domain := U
            base_mem := hzU
            interior_connected := hUconn
            chart_source := fun z hz => (hUS hz).1
            image_chart := fun z hz => (hUS hz).2.1
            image_interior := fun z hz => (hUS hz).2.2.1
            map_analytic := fun z hz => (hUS hz).2.2.2.2.1.contMDiffWithinAt
            source_solution_analytic := fun z hz => (hUS hz).2.2.2.2.2.1.contMDiffWithinAt
            target_solution_analytic := fun z hz => (hUS hz).2.2.2.2.2.2.1.contMDiffWithinAt
            source_solution_nonzero := fun z hz => (hUS hz).2.2.2.1
            quotients := fun z hz => (hUS hz).2.2.2.2.2.2.2
            patch := P
            patch_base := hrP
            patch_connected := hPconn
            patch_into_domain := hPU
            boundary_solution_zero := fun r hr => hPZ hr }⟩
end ConformalPoisson

end ProofPart_RemoteInverseNeighborhood

/- Proof support: RemoteInverseMatch.lean, SHA256 cbcf392a88e77dbf0ed385cb5752eebdeaf27da1f4faa2b875cb382547098b62 -/
noncomputable section ProofPart_RemoteInverseMatch



/- The SAME escaping sequence and actual quotient inverse give a
nonempty OPEN region of agreement with the old inverse. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {b : (𝓡∂ (n + 1)).boundary M₂}

set_option maxHeartbeats 800000 in
without_proof_info in
theorem RemoteInverseNeighborhood.exists_open_match
    (R : RemoteQuotientData A₁ A₂ V₁ V₂ D x b) (N : RemoteInverseNeighborhood R)
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hJ : J.source ⊆ (𝓡∂ (n + 1)).interior M₁) (c : M₁ → ℝ)
    (hc : ∀ y ∈ J.source, c y ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ y ∈ J.source,
      D.solver₁.solve f.val y = c y * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J y))
    {xs : ℕ → M₁} (hxs : Tendsto xs atTop (𝓝 x)) (hs : ∀ k, xs k ∈ J.source)
    (hys : Tendsto (J ∘ xs) atTop (𝓝 (b : M₂))) :
    ∃ W : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1)),
      (W : Set (EuclideanHalfSpace (n + 1))).Nonempty ∧
      (W : Set (EuclideanHalfSpace (n + 1))) ⊆ (oldInverseChart J R.chart).source ∩
        (N.domain : Set (EuclideanHalfSpace (n + 1))) ∧
      EqOn R.continuedInverse (oldInverseChart J R.chart) W := by
  let K := oldInverseChart J R.chart
  let B : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1)) := ⟨K.source, K.open_source⟩
  let V : TopologicalSpace.Opens M₁ :=
    ⟨R.quotient_diffeo.localInverse.target, R.quotient_diffeo.localInverse.open_target⟩
  have hys' : Tendsto (J ∘ xs) atTop (𝓝 (R.chart (EuclideanHalfSpace.boundaryParam n R.base))) := by
    rw [R.base_value]
    exact hys
  obtain ⟨hzs, hKzs, hKs⟩ := oldInverseChart_sequence J R.chart R.base_mem hxs hs hys'
  have hU := hzs.eventually (N.domain.isOpen.mem_nhds N.base_mem)
  have hV := hKzs.eventually (V.isOpen.mem_nhds R.quotient_diffeo.localInverse_mem_target)
  have hne : ((B : Set (EuclideanHalfSpace (n + 1))) ∩
      (N.domain : Set (EuclideanHalfSpace (n + 1))) ∩ K ⁻¹' (V : Set M₁)).Nonempty := by
    obtain ⟨k, hkK, hkU, hkV⟩ := (hKs.and (hU.and hV)).exists
    exact ⟨R.chart.symm (J (xs k)), ⟨hkK.1, hkU⟩, hkV⟩
  have hquot := inverse_quotient_coordinates_eq_on_old_domain J R.chart hJ
    (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
    (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)) c hc hrel
    R.denominator R.numerators (fun z => R.quotient (nativeNormalCoordinates z)) N.quotients
  obtain ⟨W, hWne, hWsub, hWeq⟩ := exists_open_inverse_match B N.domain V K K.contMDiffOn.continuousOn
    R.sourceCoordinates (fun z => R.quotient (nativeNormalCoordinates z)) R.quotient_diffeo.localInverse
    (fun y hy => R.quotient_diffeo.localInverse_left_inv hy) hquot hne
  exact ⟨W, hWne, hWsub, hWeq⟩
end ConformalPoisson

