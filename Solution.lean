    nativeC1Function g u (hu.1.of_le (by simp)) x ≤ K * (A * forcingLpNorm + B * gradLpNorm + D * valueLpNorm) := hpnt
    _ ≤ K * (A * (A₀ * FN) + M₀ * (ε * S + CE * FN)) := mul_le_mul_of_nonneg_left hsum hK
