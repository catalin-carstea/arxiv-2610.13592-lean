noncomputable section ProofPart_WeakDerivativeClosure





/- Continuous weak derivative representatives upgrade differentiability
through the boundary of a convex open set. The closure calculus is the
public mathlib limit-of-derivatives theorem; no ambient extension of
the function or its coefficients is assumed. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}
  {u f : E → F} {G : E → E →L[ℝ] F}

without_proof_info in
theorem uniqueDiffOn_closure_of_convex_open (Ω : Opens E) (hconv : Convex ℝ (Ω : Set E)) :
    UniqueDiffOn ℝ (closure (Ω : Set E)) := by
  by_cases hΩ : (Ω : Set E).Nonempty
  · apply uniqueDiffOn_convex hconv.closure
    obtain ⟨x, hx⟩ := hΩ
    refine ⟨x, mem_interior_iff_mem_nhds.mpr ?_⟩
    exact Filter.mem_of_superset (Ω.isOpen.mem_nhds hx) subset_closure
  · have heq : (Ω : Set E) = ∅ := Set.not_nonempty_iff_eq_empty.mp hΩ
    rw [heq, closure_empty]
    intro x hx
    exact False.elim hx

without_proof_info in
theorem contDiffOn_closure_of_weak_derivative
    (hconv : Convex ℝ (Ω : Set E)) (huniq : UniqueDiffOn ℝ (closure (Ω : Set E)))
    (hu : HasWeakFDerivOn μ Ω u G) (hf : ContinuousOn f (closure (Ω : Set E)))
    (huf : u =ᵐ[μ.restrict Ω] f) (k : ℕ)
    (hG : ContDiffOn ℝ k G (closure (Ω : Set E))) :
    ContDiffOn ℝ (k + 1) f (closure (Ω : Set E)) := by
  have hweak := hu.congr_ae huf
  have hclassical : ∀ x ∈ Ω, HasFDerivAt f (G x) x := fun x hx =>
    hweak.hasFDerivAt_of_continuousOn (hf.mono subset_closure)
      (hG.continuousOn.mono subset_closure) hx
  have hderiv : ∀ x ∈ Ω, fderiv ℝ f x = G x := fun x hx => (hclassical x hx).fderiv
  have hboundary : ∀ x ∈ closure (Ω : Set E),
      HasFDerivWithinAt f (G x) (closure (Ω : Set E)) x := by
    intro x hx
    have heq : (fun y => fderiv ℝ f y) =ᶠ[𝓝[Ω] x] G :=
      Filter.eventually_of_mem self_mem_nhdsWithin fun y hy => hderiv y hy
    exact hasFDerivWithinAt_closure_of_tendsto_fderiv
      (fun y hy => (hclassical y hy).differentiableAt.differentiableWithinAt) hconv Ω.isOpen
      (fun y hy => (hf y hy).mono subset_closure)
      ((hG.continuousOn x hx).mono subset_closure |>.congr' heq.symm)
  change ContDiffOn ℝ ((k : ℕ∞ω) + 1) f (closure (Ω : Set E))
  exact (contDiffOn_succ_iff_hasFDerivWithinAt_of_uniqueDiffOn huniq).2
    ⟨by simp, G, hG, hboundary⟩
end ConformalPoisson

end ProofPart_WeakDerivativeClosure

