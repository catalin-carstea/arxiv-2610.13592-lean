  let wR := Wkp.restrictL (inf_le_left : Ωt ≤ Ω) 2 w
  have hηR : tsupport η ⊆ ball x₀ R := hηs.trans (ball_subset_ball (by linarith))
  have hwr := cutoff_reading_restrict (V := Bt) η u w hw
  have hwr0 := cutoff_zeroTrace_restrict (V := Bt) η hηc hηs u w hw (hzero η hη hηc hηR w hw)
