noncomputable section ProofPart_GreenTrace_HalfBallClassicalC1Bound



/- A non-optimal local classical C1 estimate for homogeneous rows, from
the actual value-controlled cutoff/odd W2p reading and existing Morrey maps.
The Hessian input is the proved homogeneous estimate, supplied downstream
by the SAME native metric. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti Module Metric
open scoped ENNReal NNReal InnerProductSpace ContDiff Gradient
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
local notation "P" => WithLp 2 (ℝ × E)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_halfBall_classical_c1_bound
    (p : ℝ≥0) [Fact (1 ≤ (p : ℝ≥0∞))] (hp : (finrank ℝ P : ℝ≥0) < p)
    (a : ℝ) (Ω : Opens P) (x₀ : P) (R : ℝ) (hR : 0 < R)
    (hmatch : (Ω : Set P) ∩ ball x₀ R = (normalHalfSpace (E := E) a : Set P) ∩ ball x₀ R)
    (D : ℝ) (hD : 0 ≤ D) :
    ∃ C ≥ 0, ∀ u : Wkp (volume : Measure P) Ω (p : ℝ≥0∞) 2,
      (∀ ζ : P → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball x₀ R →
        ∀ w : Wkp (volume : Measure P) Ω (p : ℝ≥0∞) 2,
          Wkp.value 2 w =ᵐ[volume.restrict (Ω : Set P)] (fun x => ζ x * Wkp.value 2 u x) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω (p : ℝ≥0∞)) →
      (∀ r > 0, r < R → (R - r) ^ 2 * lpNorm (Wkp.iteratedGradient 1 u) (p : ℝ≥0∞)
        (volume.restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
        D * lpNorm (Wkp.value 2 u) (p : ℝ≥0∞) (volume.restrict ((Ω : Set P) ∩ ball x₀ R))) →
      ∀ f : P → ℝ, ContDiffOn ℝ ∞ f Ω →
      Wkp.value 2 u =ᵐ[volume.restrict (Ω : Set P)] f →
      ∀ x ∈ (Ω : Set P) ∩ ball x₀ (R / 4), |f x| + ‖∇ f x‖ ≤
        C * lpNorm (Wkp.value 2 u) (p : ℝ≥0∞) (volume.restrict ((Ω : Set P) ∩ ball x₀ R)) := by
  obtain ⟨c₀, hc₀, hcut⟩ := exists_forall_contDiff_cutoff_closedBall (E := P)
  obtain ⟨η, hη, hηrange, hηone, hηts, hηg, hηh⟩ :=
    hcut x₀ (show 0 ≤ R / 4 by positivity) (show R / 4 < 3 * R / 8 by linarith)
  have hηc : HasCompactSupport η := (isCompact_closedBall x₀ (3 * R / 8)).of_isClosed_subset
    (isClosed_tsupport η) hηts
  have hηs : tsupport η ⊆ ball x₀ (R / 2) := hηts.trans (closedBall_subset_ball (by linarith))
  have hηabs : ∀ x, |η x| ≤ 1 := fun x => abs_le.mpr
    ⟨by linarith [(hηrange ⟨x, rfl⟩).1], (hηrange ⟨x, rfl⟩).2⟩
  have hηinner : EqOn η 1 ((Ω : Set P) ∩ ball x₀ (R / 4)) :=
    fun x hx => hηone (ball_subset_closedBall hx.2)
  obtain ⟨B, hB, hreading⟩ := exists_bounded_halfBall_w2p_reading (p := (p : ℝ≥0∞))
    ENNReal.coe_ne_top a Ω x₀ R hR hmatch D hD η hη hηc hηs hηabs hηinner _ _ hηg hηh
  obtain ⟨Cv, hCv, hv⟩ := exists_wholeSpace_classical_value_bound (E := E) hp
  obtain ⟨Cg, hCg, hg⟩ := exists_wholeSpace_classical_gradient_bound (E := E) hp
  refine ⟨(Cv + Cg) * B, by positivity, fun u hzero hH f hf huf x hx => ?_⟩
  obtain ⟨W, hWread, hWnorm⟩ := hreading u hzero hH
  let S : Opens P := Ω ⊓ ⟨ball x₀ (R / 4), isOpen_ball⟩
  have hufS : Wkp.value 2 u =ᵐ[volume.restrict (S : Set P)] f :=
    ae_restrict_of_ae_restrict_of_subset inter_subset_left huf
  have hWf : Wkp.value 2 W =ᵐ[volume.restrict (S : Set P)] f := hWread.trans hufS
  have hfS : ContDiffOn ℝ ∞ f S := hf.mono inter_subset_left
  have hvx := hv W S f hfS.continuousOn hWf x hx
  have hgx := hg W S f (hfS.of_le (by simp)) hWf x hx
  calc
    _ ≤ Cv * ‖W‖ + Cg * ‖W‖ := add_le_add hvx hgx
    _ = (Cv + Cg) * ‖W‖ := by ring
    _ ≤ (Cv + Cg) * (B * lpNorm (Wkp.value 2 u) (p : ℝ≥0∞)
      (volume.restrict ((Ω : Set P) ∩ ball x₀ R))) :=
      mul_le_mul_of_nonneg_left hWnorm (add_nonneg hCv hCg)
    _ = _ := by ring

end ConformalPoisson

end ProofPart_GreenTrace_HalfBallClassicalC1Bound

