      ∫ x in (Ω : Set V), f x * φ x)
    (hd : HasWeakLineDerivOn volume Ω (W1p.value u) (W1p.value d) e) (φ : 𝓓(Ω, ℝ)) :
    energyFormH1 (fun _ => 1) 0 0 d (W1p.ofTestFunctionₗ volume Ω 2 φ) =
      ∫ x in (Ω : Set V), ⟪(-f x) • e, ∇ (φ : V → ℝ) x⟫_ℝ := by
  rw [energyFormH1_ofTestFunctionₗ_eq_neg_of_hasWeakLineDerivOn hd, hu, ← integral_neg]
  apply integral_congr_ae
  exact ae_of_all _ fun x => by
    change -(f x * (∂_{e} φ) x) = ⟪(-f x) • e, ∇ (φ : V → ℝ) x⟫_ℝ
    rw [TestFunction.lineDerivOp_apply_eq_fderiv, real_inner_smul_left,
      inner_gradient_right, conj_trivial]
