noncomputable section ProofPart_GreenTrace_GardingWeakInverseBound


/- Quantitative readback of the bounded inverse already constructed by
the pinned Garding/Fredholm theorem. Intended caller: the actual native
zero-trace energy space, with its proved compact value map and kernel. -/
open InnerProductSpace TauCeti
open scoped InnerProductSpace
namespace ConformalPoisson
variable {E H : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H]

without_proof_info in
theorem norm_weak_solution_le_mul_forcing_of_garding
    {B : E →L[ℝ] E →L[ℝ] ℝ} {J : E →L[ℝ] H} {C₀ β : ℝ}
    (hJ : IsCompactOperator J) (hC₀ : 0 < C₀)
    (hB : ∀ u, C₀ * ‖u‖ ^ 2 ≤ B u u + β * ‖J u‖ ^ 2)
    (hker : ∀ u, (∀ v, B u v = 0) → u = 0) :
    ∃ C ≥ 0, ∀ F : H, ∀ u : E,
      (∀ v, B u v = ⟪F, J v⟫_ℝ) → ‖u‖ ≤ C * ‖F‖ := by
  let T := continuousLinearMapOfBilin B
  have hinj : Function.Injective T := by
    rw [injective_iff_map_eq_zero]
    intro u hu
    apply hker u
    intro v
    rw [← continuousLinearMapOfBilin_apply]
    change ⟪T u, v⟫_ℝ = 0
    rw [hu, inner_zero_left]
  have hT : T.IsInvertible :=
    (hJ.isFredholm_continuousLinearMapOfBilin_of_garding hC₀ hB).isInvertible_of_injective_of_index_eq_zero
      hinj (hJ.index_continuousLinearMapOfBilin_eq_zero_of_garding hC₀ hB)
  refine ⟨‖T.inverse‖ * ‖J‖, mul_nonneg (norm_nonneg _) (norm_nonneg _), fun F u hu => ?_⟩
  let ℓ : StrongDual ℝ E := (innerSL ℝ F).comp J
  have heq : T u = (toDual ℝ E).symm ℓ := by
    apply ext_inner_right ℝ
    intro v
    rw [toDual_symm_apply]
    exact (continuousLinearMapOfBilin_apply B u v).trans (hu v)
  have hinner : ‖innerSL ℝ F‖ ≤ ‖F‖ :=
    ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg F) fun v => abs_real_inner_le_norm F v
  have hℓ : ‖ℓ‖ ≤ ‖J‖ * ‖F‖ :=
    ((innerSL ℝ F).opNorm_comp_le J).trans
      ((mul_le_mul_of_nonneg_right hinner (norm_nonneg J)).trans_eq (mul_comm _ _))
  calc ‖u‖ = ‖T.inverse (T u)‖ := congrArg norm (hT.inverse_apply_self u).symm
    _ ≤ ‖T.inverse‖ * ‖T u‖ := T.inverse.le_opNorm _
    _ = ‖T.inverse‖ * ‖ℓ‖ := by rw [heq, LinearIsometryEquiv.norm_map]
    _ ≤ ‖T.inverse‖ * (‖J‖ * ‖F‖) := mul_le_mul_of_nonneg_left hℓ (norm_nonneg _)
    _ = _ := (mul_assoc _ _ _).symm

end ConformalPoisson

end ProofPart_GreenTrace_GardingWeakInverseBound

