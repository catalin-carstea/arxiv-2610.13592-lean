    (fun h => (fr h).val ∘ D.boundaryIdentification.symm) (fun h => (fi h).val ∘ D.boundaryIdentification.symm)
    hfr₂ hfi₂ ξ hy₂ hy0 _ ha₂
  change FinitePowerExpansion (scaledTime₁ P hn C fr fi ξ (EuclideanHalfSpace.boundaryParam n y)) _ at he₁
  change FinitePowerExpansion (scaledTime₂ P hn C fr fi ξ (EuclideanHalfSpace.boundaryParam n y)) _ at he₂
  have he₂' := he₂.congr_positive (fun h _ => (scaledTime_eq P hn C fr fi ξ hy₁ hy0 h).symm)
  exact congrFun (coefficients_eq_of_common_finite_expansions _ _ _ he₁ he₂') j

