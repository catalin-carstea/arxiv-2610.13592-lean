    (hηone : EqOn η 1 ((Ω : Set P) ∩ ball x₀ (R / 4)))
    (c₁ c₂ : ℝ) (hηg : ∀ x, ‖gradient η x‖ ≤ c₁)
    (hηh : ∀ x, ‖fderiv ℝ (gradient η) x‖ ≤ c₂) :
    ∃ B ≥ 0, ∀ u : Wkp (volume : Measure P) Ω p 2,
      (∀ ζ : P → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball x₀ R →
        ∀ w : Wkp (volume : Measure P) Ω p 2,
          Wkp.value 2 w =ᵐ[(volume : Measure P).restrict Ω] (fun x => ζ x * Wkp.value 2 u x) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω p) →
      (∀ r > 0, r < R → (R - r) ^ 2 * lpNorm (Wkp.iteratedGradient 1 u) p
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
        D * lpNorm (Wkp.value 2 u) p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R))) →
      ∃ W : Wkp (volume : Measure P) ⊤ p 2,
        Wkp.value 2 W =ᵐ[(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ (R / 4))] Wkp.value 2 u ∧
        ‖W‖ ≤ B * lpNorm (Wkp.value 2 u) p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := by
  obtain ⟨Cg, hCg, hgrad⟩ := exists_halfBall_gradient_bound_of_hessian hp a Ω x₀ R hR hmatch D hD
  obtain ⟨T, hT⟩ := exists_bounded_odd_w2p_extension (E := E) (p := p) a
  have hc₁ : 0 ≤ c₁ := (norm_nonneg (gradient η 0)).trans (hηg 0)
  have hc₂ : 0 ≤ c₂ := (norm_nonneg (fderiv ℝ (gradient η) 0)).trans (hηh 0)
  let B₀ : ℝ := 4 * D / R ^ 2 + (1 + 2 * c₁) * Cg + (1 + c₁ + c₂)
  have hB₀ : 0 ≤ B₀ := by dsimp [B₀]; positivity
  refine ⟨‖T‖ * B₀, by positivity, fun u hzero hH => ?_⟩
  let Bt : Opens P := ⟨ball x₀ (R / 2), isOpen_ball⟩
