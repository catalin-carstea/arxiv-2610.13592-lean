    contMDiffOn_chartLeviCivitaMap (I := I) (k := ∞) (m := ∞) (r := ∞) α (by simp) (by simp)

without_proof_info in
theorem contDiffOn_chartDriftCoefficient (α : M) :
    ContDiffOn ℝ ∞ (chartDriftCoefficient (I := I) α)
