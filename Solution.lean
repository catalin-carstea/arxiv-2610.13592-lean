/- The actual smooth supplied solution in the normal chart, and analytic
readback to that SAME solution through the actual inverse partial chart. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" => EuclideanHalfSpace (n + 1)
variable {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {α : (𝓡∂ (n + 1)).boundary M}
  (R : NativeMetricAmbientExtension g (α : M))
local instance : RiemannianBundle (fun x : R.domain => TangentSpace 𝓘(ℝ, V) x) :=
  ⟨R.metric.toRiemannianMetric⟩
local instance : IsContMDiffRiemannianBundle 𝓘(ℝ, V) 1 V
    (fun x : R.domain => TangentSpace 𝓘(ℝ, V) x) :=
  IsContMDiffRiemannianBundle.of_le (n := ω) (by decide)
variable {D : BoundaryNormalMapData R.domain R.boundaryBase}
  {Q : BoundaryNormalRectangle R.domain D} (A : NormalModelChartData R.domain D Q)

without_proof_info in
theorem NativeMetricAmbientExtension.normalCoordinateFunction_smooth
    (hcompat : ∀ z ∈ R.domain, 0 ≤ z 0 → z ∈ (extChartAt (𝓡∂ (n + 1)) (α : M)).target)
    (u : M → ℝ) (hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u) :
    ContDiffOn ℝ ∞ (R.normalCoordinateFunction A u)
      ((R.normalCoordinateDomain A : Set V) ∩ {x : V | 0 ≤ x 0}) := by
  let χ := R.normalChart A
  have hχ : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ∞ χ χ.source :=
    χ.contMDiffOn_toFun.of_le (by decide)
  have hF := hu.comp_contMDiffOn hχ
  have hF' : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (u ∘ χ)
      ((Subtype.val : H → V) ⁻¹' A.chart.source) := by
    rwa [R.normalChart_source A hcompat] at hF
  apply contDiffOn_halfSpace_ambient_reading ⟨0, by simp⟩ A.chart.source A.chart.open_source
    (u ∘ χ) (R.normalCoordinateFunction A u) hF'
  intro y _
  change R.normalCoordinateFunction A u y.val = u (R.normalChart A y)
  rw [R.normalChart_apply A y]
  rfl

without_proof_info in
theorem NativeMetricAmbientExtension.normalCoordinateFunction_native_analytic
    (u : M → ℝ) (p : EuclideanHalfSpace (n + 1)) (hp : p ∈ (R.normalChart A).source)
    (ha : AnalyticWithinAt ℝ (R.normalCoordinateFunction A u) {x : V | 0 ≤ x 0} p.val) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω u (R.normalChart A p) := by
  let χ := R.normalChart A
  let F : H → ℝ := u ∘ χ
  have hread : F ∘ (extChartAt (𝓡∂ (n + 1)) p).symm =ᶠ[𝓝[{x : V | 0 ≤ x 0}] p.val]
      R.normalCoordinateFunction A u := by
    filter_upwards [self_mem_nhdsWithin] with x hx
    change u (R.normalChart A ((extChartAt (𝓡∂ (n + 1)) p).symm x)) = R.normalCoordinateFunction A u x
    rw [R.normalChart_apply A, halfSpace_extChartAt_symm_val p hx]
    rfl
  have hbase : F p = R.normalCoordinateFunction A u p.val := by
    change u (R.normalChart A p) = _
    rw [R.normalChart_apply A p]
    rfl
  have hFa := contMDiffAt_halfSpace_of_ambient_analyticWithinAt p F _ ha hread hbase
  have hb : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω χ.symm (χ p) :=
    (χ.symm.contMDiffOn_toFun (χ p) (χ.map_source hp)).contMDiffAt
      (χ.open_target.mem_nhds (χ.map_source hp))
  have hc : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (F ∘ χ.symm) (χ p) :=
    ContMDiffAt.comp_of_eq (g := F) (f := χ.symm) hFa hb (χ.left_inv hp)
  apply hc.congr_of_eventuallyEq
  filter_upwards [χ.open_target.mem_nhds (χ.map_source hp)] with y hy
  change u y = u (χ (χ.symm y))
  exact congrArg u (χ.right_inv hy).symm

end ConformalPoisson

