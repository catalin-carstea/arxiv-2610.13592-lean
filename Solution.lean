  have hN : {z | z ∈ Ω ∧ E.principal z = A z ∧ E.drift z = b z ∧ E.potential z = q z} ∈ 𝓝 z₀ := by
    filter_upwards [hΩ.mem_nhds hz₀, E.agrees] with z hz he
    exact ⟨hz, he⟩
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hN
  let inn : ContDiffBump z₀ :=
    { rIn := r / 16
      rOut := r / 8
      rIn_pos := by positivity
      rIn_lt_rOut := by linarith }
  let mid : ContDiffBump z₀ :=
    { rIn := r / 4
      rOut := r / 2
      rIn_pos := by positivity
      rIn_lt_rOut := by linarith }
  let out : ContDiffBump z₀ :=
    { rIn := r / 2
      rOut := 3 * r / 4
      rIn_pos := by positivity
      rIn_lt_rOut := by linarith }
  have hOut : tsupport out ⊆ {z | z ∈ Ω ∧ E.principal z = A z ∧ E.drift z = b z ∧ E.potential z = q z} := by
    rw [out.tsupport_eq]
    apply Subset.trans _ hball
    apply closedBall_subset_ball
    dsimp only [out]
    linarith
  have hmidout : tsupport mid ⊆ tsupport out := by
    rw [mid.tsupport_eq, out.tsupport_eq]
    apply closedBall_subset_closedBall
    dsimp only [mid, out]
    linarith
  have houtone : ∀ z ∈ tsupport mid, out z = 1 := by
    intro z hz
    apply out.one_of_mem_closedBall
    rwa [mid.tsupport_eq] at hz
