noncomputable section ProofPart_InteriorCutoffs





/-
Smooth compact-interior cutoffs for the forcing approximation in Lemma 3.6.
The sequence is eventually exactly one at every interior point.
-/

open Set Filter
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

structure SmoothInteriorCutoffs where
  cutoff : ℕ → M → ℝ
  smooth : ∀ m, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (cutoff m)
  compact_support : ∀ m, HasCompactSupport (cutoff m)
  support_interior : ∀ m, tsupport (cutoff m) ⊆ (𝓡∂ (n + 1)).interior M
  range : ∀ m x, cutoff m x ∈ Icc 0 1
  eventually_one : ∀ x ∈ (𝓡∂ (n + 1)).interior M,
    ∀ᶠ m in atTop, cutoff m x = 1

without_proof_info in
/-- A compact manifold has enough smooth interior cutoffs; no analytical density premise. -/
theorem nonempty_smoothInteriorCutoffs [CompactSpace M] :
    Nonempty (SmoothInteriorCutoffs (n := n) (M := M)) := by
  let : SecondCountableTopology (EuclideanHalfSpace (n + 1)) :=
    inferInstanceAs (SecondCountableTopology {x : EuclideanSpace ℝ (Fin (n + 1)) // 0 ≤ x 0})
  let : SecondCountableTopology M :=
    ChartedSpace.secondCountable_of_sigmaCompact (EuclideanHalfSpace (n + 1)) M
  let U := (𝓡∂ (n + 1)).interior M
  have hopen : IsOpen U := (𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)
  let : LocallyCompactSpace U := hopen.locallyCompactSpace
  let : SigmaCompactSpace U := inferInstance
  let K : ℕ → Set M := fun m => Subtype.val '' compactCovering U m
  have hK (m : ℕ) : IsCompact (K m) :=
    (isCompact_compactCovering U m).image continuous_subtype_val
  have hKU (m : ℕ) : K m ⊆ U := by
    rintro x ⟨y, _, rfl⟩
    exact y.property
  choose σ hσ hσone hσcompact hσsupp hσrange using fun m =>
    (hK m).exists_contMDiff_one_nhds_tsupport_subset (𝓡∂ (n + 1)) hopen (hKU m)
  refine ⟨⟨σ, hσ, hσcompact, hσsupp, hσrange, ?_⟩⟩
  intro x hx
  obtain ⟨N, hN⟩ := exists_mem_compactCovering (⟨x, hx⟩ : U)
  filter_upwards [eventually_ge_atTop N] with m hm
  apply (hσone m).self_of_nhdsSet
  exact ⟨⟨x, hx⟩, compactCovering_subset U hm hN, rfl⟩

end ConformalPoisson

end ProofPart_InteriorCutoffs

/- Proof support: InteriorForcingApproximation.lean, SHA256 42a3956237f6b827cc5e6f926ead4085c2999a9adf3ae893e419a3ada47f8879 -/
noncomputable section ProofPart_InteriorForcingApproximation





/- Smooth interior cutoff approximation, with genuine extended L^p convergence. -/

open Set Filter MeasureTheory
open scoped Manifold ContDiff Topology ENNReal

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]

omit [T2Space M] [IsManifold (𝓡∂ (n + 1)) ω M] in
without_proof_info in
/-- Bounded cutoff multiplication approximates a smooth finite L^p forcing.
The full-measure interior hypothesis will be supplied by native boundary nullity. -/
theorem SmoothInteriorCutoffs.tendsto_forcing_eLpNorm
    (χ : SmoothInteriorCutoffs (n := n) (M := M)) (μ : Measure M)
    (hinterior : ∀ᵐ x ∂μ, x ∈ (𝓡∂ (n + 1)).interior M)
    (p : ℝ≥0∞) (hp0 : p ≠ 0) (hptop : p ≠ (⊤ : ℝ≥0∞))
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F) (hFp : MemLp F p μ) :
    Tendsto (fun m => eLpNorm (fun x => χ.cutoff m x * F x - F x) p μ) atTop (𝓝 0) := by
  have hp : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  have hmeas (m : ℕ) : Measurable (fun x => ‖χ.cutoff m x * F x - F x‖ₑ ^ p.toReal) :=
    (((χ.smooth m).continuous.mul hF.continuous).sub hF.continuous).measurable.eNorm.pow_const _
  have hbd (m : ℕ) :
      (fun x => ‖χ.cutoff m x * F x - F x‖ₑ ^ p.toReal) ≤ᵐ[μ]
        (fun x => ‖F x‖ₑ ^ p.toReal) := by
    apply Eventually.of_forall
    intro x
    have hrange := χ.range m x
    have hscalar : |χ.cutoff m x - 1| ≤ 1 :=
      abs_le.mpr ⟨by linarith [hrange.1], by linarith [hrange.2]⟩
    have hn : ‖χ.cutoff m x * F x - F x‖ ≤ ‖F x‖ := by
      rw [← sub_one_mul, norm_mul, Real.norm_eq_abs]
      exact mul_le_of_le_one_left (norm_nonneg _) hscalar
    exact ENNReal.rpow_le_rpow (eNorm_le_iff_norm_le.mpr hn) hp.le
  have hlim : ∀ᵐ x ∂μ, Tendsto
      (fun m => ‖χ.cutoff m x * F x - F x‖ₑ ^ p.toReal) atTop (𝓝 0) := by
    filter_upwards [hinterior] with x hx
    have heq : (fun m => ‖χ.cutoff m x * F x - F x‖ₑ ^ p.toReal) =ᶠ[atTop]
        (fun _ => (0 : ℝ≥0∞)) := by
      filter_upwards [χ.eventually_one x hx] with m hm
      simp [hm, ENNReal.zero_rpow_of_pos hp]
    exact (tendsto_congr' heq).mpr tendsto_const_nhds
  have hI : Tendsto (fun m => ∫⁻ x, ‖χ.cutoff m x * F x - F x‖ₑ ^ p.toReal ∂μ)
      atTop (𝓝 0) := by
    simpa only [lintegral_zero] using tendsto_lintegral_of_dominated_convergence
      (fun x => ‖F x‖ₑ ^ p.toReal) hmeas hbd
      (lintegral_rpow_eNorm_lt_top_of_eLpNorm_lt_top hp0 hptop hFp).ne hlim
  have hroot := (ENNReal.continuous_rpow_const (y := 1 / p.toReal)).continuousAt.tendsto.comp hI
  have heq (m : ℕ) := eLpNorm_eq_lintegral_rpow_eNorm_toReal hp0 hptop
    ((((χ.smooth m).continuous.mul hF.continuous).sub hF.continuous).aestronglyMeasurable (μ := μ))
  rw [ENNReal.zero_rpow_of_pos (one_div_pos.mpr hp)] at hroot
  apply hroot.congr'
  exact .of_forall fun m => (heq m).symm

end ConformalPoisson

end ProofPart_InteriorForcingApproximation

