  have hround : (extChartAt I x).symm (extChartAt I x x) = x := extChartAt_to_inv x
  simpa only [Function.comp_apply, hround] using hbase.symm

end ConformalPoisson

end ProofPart_BoundaryAnalytic_NativeAnalyticChartExtension

