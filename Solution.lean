    rw [e.apply_symm_apply, gradient_comp_linearIsometryEquiv_right, e.symm.norm_map,
      e.apply_symm_apply] at hb
    have hevent : v =ᶠ[𝓝 z] f := Filter.eventually_of_mem (Ω.isOpen.mem_nhds hz) heq
    have hg : ∇ v z = ∇ f z := hevent.gradient_eq
