/- Proof support: OperatorRungeInput.lean, SHA256 ff3496d8a91ce9f2cad42d42d54c60a7a6a6a59945246e0b51c8c8cde039e48f -/
noncomputable section ProofPart_OperatorRungeInput




/- Finite-jet Runge at one fixed operator. This local proof interface permits
analytic producers to discharge the actual applications without asserting
the broader frozen smooth-coefficient literature proposition. -/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

/-- Approximation at finitely many points of local homogeneous solutions by one family of
global Dirichlet solutions whose data are all supported in the observed patch. -/
def RungeJetApproximationFor [T2Space M]
    (g : Metric (n := n) (M := M)) (q : M → ℝ) : Prop :=
  2 ≤ n → IsCompact (univ : Set M) →
    IsConnected ((𝓡∂ (n + 1)).interior M) →
      ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q → Nonresonant g q →
      ∀ S : DirichletSolver g q,
        ∀ Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M),
          (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty →
          ∀ (N : ℕ) (points : Fin N → M),
            Function.Injective points →
            (∀ i, points i ∈ (𝓡∂ (n + 1)).interior M) →
            ∀ (U : Fin N → TopologicalSpace.Opens M),
              (∀ i, points i ∈ U i) →
              (∀ i, (U i : Set M) ⊆ (𝓡∂ (n + 1)).interior M) →
              ∀ v : Fin N → M → ℝ,
                (∀ i, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (v i) (U i)) →
                (∀ i, ∀ x ∈ U i, schrodinger g q (v i) x = 0) →
                ∃ f : ℕ → BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
                  Filter.Tendsto
                    (fun m i => secondJet g (S.solve (f m).val) (points i))
                    Filter.atTop
                    (nhds (fun i => secondJet g (v i) (points i)))

/-- A proved interface for analytic operators on this manifold. Unlike the
frozen literature proposition, it makes no claim about arbitrary smooth coefficients. -/
def AnalyticRungeJetApproximation [T2Space M] : Prop :=
  ∀ A : AnalyticProblem (n := n) (M := M),
    RungeJetApproximationFor A.smoothMetric A.potential

end ConformalPoisson

end ProofPart_OperatorRungeInput

/- Proof support: External/CalderonFiniteJetRange.lean, SHA256 0300a3ded051bcf00025ad76519acc8fd93f959f665539809f11e6c76b3292c6 -/
noncomputable section ProofPart_External_CalderonFiniteJetRange



/-
Adapted from Cătălin I. Cârstea and Lauri Oksanen, anisotropic-calderon-lean,
commit 0f09786282d0f2d3865fa0f175b63c35969d25f7,
Calderon/FiniteDimensionalJetRange.lean. BSD-3-Clause.
The mathematical declarations and proofs are preserved. The changes add the module
header and public visibility and omit the diagnostic axiom-printing commands.
See LICENSE.calderon for the upstream copyright and license.
-/

set_option autoImplicit false
namespace OAI.AnisotropicCalderon.SourceJet

variable {D J : Type*} [AddCommGroup D] [Module ℝ D]
  [NormedAddCommGroup J] [NormedSpace ℝ J] [FiniteDimensional ℝ J]

without_proof_info in
theorem mem_range_of_approx (T : D →ₗ[ℝ] J) (v : J)
    (hApprox : ∀ ε : ℝ, 0 < ε → ∃ f : D, ‖T f - v‖ < ε) :
    v ∈ LinearMap.range T := by
  have hClosure : v ∈ closure (LinearMap.range T : Set J) := by
    apply Metric.mem_closure_iff.mpr
    intro ε hε
    obtain ⟨f, hf⟩ := hApprox ε hε
    refine ⟨T f, ⟨f, rfl⟩, ?_⟩
    simpa only [dist_eq_norm, norm_sub_rev] using hf
  rwa [(LinearMap.range T).closed_of_finiteDimensional.closure_eq] at hClosure

without_proof_info in
theorem range_eq_of_approx (T : D →ₗ[ℝ] J) (S : Submodule ℝ J)
    (hRange : LinearMap.range T ≤ S)
    (hApprox : ∀ v ∈ S, ∀ ε : ℝ, 0 < ε → ∃ f : D, ‖T f - v‖ < ε) :
    LinearMap.range T = S := by
  apply le_antisymm hRange
  intro v hv
  exact mem_range_of_approx T v (hApprox v hv)

end OAI.AnisotropicCalderon.SourceJet

end ProofPart_External_CalderonFiniteJetRange

/- Proof support: ExactJetsFromRunge.lean, SHA256 21f1b5dbe9b03d68535e244ae8f62f834bc2918173e9e0949b39b95934b94936 -/
noncomputable section ProofPart_ExactJetsFromRunge




/-
The finite-dimensional step of Proposition 3.4, using the attributed Cârstea–Oksanen lemma.
The next producer must construct local solutions with prescribed compatible jets. Given those
local solutions and the Runge input, this module already yields exact simultaneous global jets.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

without_proof_info in
theorem mem_range_of_tendsto
    {D J : Type*} [AddCommGroup D] [Module ℝ D]
    [NormedAddCommGroup J] [NormedSpace ℝ J] [FiniteDimensional ℝ J]
    (T : D →ₗ[ℝ] J) (f : ℕ → D) (v : J)
    (hconv : Filter.Tendsto (fun m => T (f m)) Filter.atTop (nhds v)) :
    v ∈ LinearMap.range T := by
  apply OAI.AnisotropicCalderon.SourceJet.mem_range_of_approx T v
  intro ε hε
  obtain ⟨m, hm⟩ := (Metric.tendsto_atTop.mp hconv) ε hε
  exact ⟨f m, by simpa only [dist_eq_norm] using hm m le_rfl⟩

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

without_proof_info in
/-- All selected local jets are realized by one smooth boundary datum supported in Γ. -/
theorem exists_datum_with_local_jets
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (U : Fin N → TopologicalSpace.Opens M) (hpointU : ∀ i, points i ∈ U i)
    (hU : ∀ i, (U i : Set M) ⊆ (𝓡∂ (n + 1)).interior M)
    (v : Fin N → M → ℝ)
    (hv : ∀ i, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (v i) (U i))
    (hLv : ∀ i, ∀ x ∈ U i, schrodinger g q (v i) x = 0) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∀ i, secondJet g (S.solve f.val) (points i) = secondJet g (v i) (points i) := by
  obtain ⟨f, hf⟩ := hRunge hdim hcompact hconnected hq hNR S Γ hΓ
    N points hinj hpoints U hpointU hU v hv hLv
  let T : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)) →ₗ[ℝ]
      ((i : Fin N) → JetSpace g (points i)) :=
    LinearMap.pi fun i => S.jetLinearMap g q hNR Γ (points i)
  obtain ⟨datum, hdatum⟩ := mem_range_of_tendsto T f
    (fun i => secondJet g (v i) (points i)) hf
  exact ⟨datum, fun i => congrFun hdatum i⟩

end ConformalPoisson

end ProofPart_ExactJetsFromRunge

/- Proof support: JetTraceShift.lean, SHA256 a627fe35af0a01c4c6b3cc6dc8e10ad47e591f3f37112ed6b4c4eedd78c03378 -/
noncomputable section ProofPart_JetTraceShift



/-
The value and covector of a compatible jet are unrestricted. Its Hessian has one fixed trace.
Subtracting q(x) times the value divided by the dimension from its raised Hessian identifies
the compatible jets with trace-free jets. This is the coordinate target of the small-ball
construction in Appendix A; it uses the actual tangent metric and native trace.
-/

open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

omit [IsManifold (𝓡∂ (n + 1)) ω M] in
without_proof_info in
theorem trace_tangent_id (x : M) :
    LinearMap.trace ℝ (TangentSpace (𝓡∂ (n + 1)) x)
      (ContinuousLinearMap.id ℝ (TangentSpace (𝓡∂ (n + 1)) x)).toLinearMap =
      (n + 1 : ℝ) := by
  change LinearMap.trace ℝ (TangentSpace (𝓡∂ (n + 1)) x) LinearMap.id = (n + 1 : ℝ)
  rw [LinearMap.trace_id]
  change (Module.finrank ℝ (EuclideanSpace ℝ (Fin (n + 1))) : ℝ) = n + 1
  simp

/-- Change the required trace by r times the value, retaining the value and covector. -/
def jetTraceShift (g : Metric (n := n) (M := M)) (x : M) (r : ℝ) :
    JetSpace g x →ₗ[ℝ] JetSpace g x where
  toFun j := ⟨j.1, j.2.1,
    j.2.2 + (r * j.1 / (n + 1 : ℝ)) • ContinuousLinearMap.id ℝ _⟩
  map_add' j k := by
    refine Prod.ext rfl (Prod.ext rfl ?_)
    change (j.2.2 + k.2.2) + (r * (j.1 + k.1) / (n + 1 : ℝ)) • _ =
      (j.2.2 + (r * j.1 / (n + 1 : ℝ)) • _) +
        (k.2.2 + (r * k.1 / (n + 1 : ℝ)) • _)
    rw [mul_add, add_div, add_smul]
    abel
  map_smul' a j := by
    refine Prod.ext rfl (Prod.ext rfl ?_)
    change a • j.2.2 + (r * (a * j.1) / (n + 1 : ℝ)) • _ =
      a • (j.2.2 + (r * j.1 / (n + 1 : ℝ)) • _)
    rw [smul_add, smul_smul]
    congr 1
    congr 1
    ring

without_proof_info in
theorem jetTraceShift_zero (g : Metric (n := n) (M := M)) (x : M)
    (j : JetSpace g x) : jetTraceShift g x 0 j = j := by
  refine Prod.ext rfl (Prod.ext rfl ?_)
  change j.2.2 + (0 * j.1 / (n + 1 : ℝ)) • _ = j.2.2
  simp

without_proof_info in
theorem jetTraceShift_comp (g : Metric (n := n) (M := M)) (x : M)
    (r s : ℝ) (j : JetSpace g x) :
    jetTraceShift g x r (jetTraceShift g x s j) = jetTraceShift g x (r + s) j := by
  refine Prod.ext rfl (Prod.ext rfl ?_)
  change (j.2.2 + (s * j.1 / (n + 1 : ℝ)) • _) +
      (r * j.1 / (n + 1 : ℝ)) • _ =
    j.2.2 + ((r + s) * j.1 / (n + 1 : ℝ)) • _
  rw [add_mul, add_div, add_smul]
  abel

without_proof_info in
theorem jetTraceShift_mem_symmetric (g : Metric (n := n) (M := M)) (x : M)
    (r : ℝ) {j : JetSpace g x} (hj : j ∈ symmetricJetSubmodule g x) :
    jetTraceShift g x r j ∈ symmetricJetSubmodule g x := by
  intro v w
  change g.inner x (j.2.2 v + (r * j.1 / (n + 1 : ℝ)) • v) w =
    g.inner x v (j.2.2 w + (r * j.1 / (n + 1 : ℝ)) • w)
  simp only [map_add, add_apply, map_smul, smul_apply, smul_eq_mul, hj v w]

without_proof_info in
theorem jetEquation_traceShift (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (x : M) (r : ℝ) (j : JetSpace g x) :
    jetEquation g q x (jetTraceShift g x r j) = jetEquation g q x j - r * j.1 := by
  change -LinearMap.trace ℝ _
      (j.2.2 + (r * j.1 / (n + 1 : ℝ)) • ContinuousLinearMap.id ℝ _).toLinearMap +
      q x * j.1 = (-LinearMap.trace ℝ _ j.2.2.toLinearMap + q x * j.1) - r * j.1
  rw [ContinuousLinearMap.toLinearMap_add, map_add,
    ContinuousLinearMap.toLinearMap_smul, map_smul, trace_tangent_id]
  simp only [smul_eq_mul]
  have hd : (n + 1 : ℝ) ≠ 0 := by positivity
  field_simp
  ring

/-- Compatibility with potential q is equivalent to trace-free compatibility after the shift. -/
def compatibleJetTraceFreeEquiv (g : Metric (n := n) (M := M)) (q : M → ℝ) (x : M) :
    compatibleJetSubmodule g q x ≃ₗ[ℝ] compatibleJetSubmodule g (fun _ => 0) x where
  toFun j := ⟨jetTraceShift g x (-q x) j, by
    refine ⟨jetTraceShift_mem_symmetric g x _ j.property.1, ?_⟩
    change jetEquation g (fun _ => 0) x (jetTraceShift g x (-q x) j.val) = 0
    rw [jetEquation_traceShift]
    have hj : jetEquation g q x j.val = 0 := j.property.2
    change -LinearMap.trace ℝ _ j.val.2.2.toLinearMap + q x * j.val.1 = 0 at hj
    change -LinearMap.trace ℝ _ j.val.2.2.toLinearMap + 0 * j.val.1 - -q x * j.val.1 = 0
    linarith⟩
  invFun j := ⟨jetTraceShift g x (q x) j, by
    refine ⟨jetTraceShift_mem_symmetric g x _ j.property.1, ?_⟩
    change jetEquation g q x (jetTraceShift g x (q x) j.val) = 0
    rw [jetEquation_traceShift]
    have hj : jetEquation g (fun _ => 0) x j.val = 0 := j.property.2
    change -LinearMap.trace ℝ _ j.val.2.2.toLinearMap + 0 * j.val.1 = 0 at hj
    change (-LinearMap.trace ℝ _ j.val.2.2.toLinearMap + q x * j.val.1) - q x * j.val.1 = 0
    linarith⟩
  left_inv j := by
    apply Subtype.ext
    change jetTraceShift g x (q x) (jetTraceShift g x (-q x) j.val) = j.val
    rw [jetTraceShift_comp, add_neg_cancel, jetTraceShift_zero]
  right_inv j := by
    apply Subtype.ext
    change jetTraceShift g x (-q x) (jetTraceShift g x (q x) j.val) = j.val
    rw [jetTraceShift_comp, neg_add_cancel, jetTraceShift_zero]
  map_add' j k := Subtype.ext ((jetTraceShift g x (-q x)).map_add j.val k.val)
  map_smul' a j := Subtype.ext ((jetTraceShift g x (-q x)).map_smul a j.val)

end ConformalPoisson

end ProofPart_JetTraceShift

/- Proof support: ExactJets.lean, SHA256 519dab497a0173ee53884350cb88852a5ae325cc49207177bef72d4a6671b32f -/
noncomputable section ProofPart_ExactJets




/-
Checked conditional caller of the local-jet producer. `LocalCompatibleJetRealization` is
proved from forward Schauder theory in `LocalNativeJetRealization`, and `ExactNativeJets`
supplies that proof to the Runge consumer here. It is not a literature premise or an axiom.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

/-- Exact realization of one compatible native jet on an interior neighborhood.
The project proves this proposition from forward Schauder theory; it is not assumed at the root. -/
def LocalCompatibleJetRealization
    (g : Metric (n := n) (M := M)) (q : M → ℝ) : Prop :=
  ∀ x ∈ (𝓡∂ (n + 1)).interior M, ∀ j : compatibleJetSubmodule g q x,
    ∃ U : TopologicalSpace.Opens M,
      x ∈ U ∧ (U : Set M) ⊆ (𝓡∂ (n + 1)).interior M ∧
      ∃ v : M → ℝ, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ v U ∧
        (∀ y ∈ U, schrodinger g q v y = 0) ∧ secondJet g v x = j.val

/-- A compatible jet with any prescribed value and covector; the scalar Hessian part supplies
the equation's required trace. -/
def compatibleValueJet (g : Metric (n := n) (M := M)) (q : M → ℝ) (x : M)
    (a : ℝ) (ξ : TangentSpace (𝓡∂ (n + 1)) x →L[ℝ] ℝ) :
    compatibleJetSubmodule g q x :=
  (compatibleJetTraceFreeEquiv g q x).symm
    ⟨(a, ξ, 0), by
      constructor
      · intro v w
        change g.inner x 0 w = g.inner x v 0
        simp only [map_zero, zero_apply]
      · change -LinearMap.trace ℝ _ (0 : _ →ₗ[ℝ] _) + 0 * a = 0
        simp⟩

without_proof_info in
@[simp] theorem compatibleValueJet_value (g : Metric (n := n) (M := M))
    (q : M → ℝ) (x : M) (a : ℝ)
    (ξ : TangentSpace (𝓡∂ (n + 1)) x →L[ℝ] ℝ) :
    (compatibleValueJet g q x a ξ).val.1 = a := rfl

without_proof_info in
@[simp] theorem compatibleValueJet_covector (g : Metric (n := n) (M := M))
    (q : M → ℝ) (x : M) (a : ℝ)
    (ξ : TangentSpace (𝓡∂ (n + 1)) x →L[ℝ] ℝ) :
    (compatibleValueJet g q x a ξ).val.2.1 = ξ := rfl

variable [T2Space M]

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

without_proof_info in
/-- Exact global jets, conditional only on the explicit local producer and approved Runge input. -/
theorem exists_datum_with_compatible_jets
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hLocal : LocalCompatibleJetRealization g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (jets : (i : Fin N) → compatibleJetSubmodule g q (points i)) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∀ i, secondJet g (S.solve f.val) (points i) = (jets i).val := by
  classical
  choose U hpointU hU v hv hLv hj using fun i => hLocal (points i) (hpoints i) (jets i)
  obtain ⟨f, hf⟩ := exists_datum_with_local_jets hRunge hdim hcompact hconnected hq hNR S Γ hΓ N points hinj hpoints U hpointU hU v hv hLv
  exact ⟨f, fun i => (hf i).trans (hj i)⟩

without_proof_info in
/-- Arbitrary finite-point values are a consequence of compatible jets, for the same datum. -/
theorem exists_datum_with_values
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hLocal : LocalCompatibleJetRealization g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M) (values : Fin N → ℝ) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∀ i, S.solve f.val (points i) = values i := by
  obtain ⟨f, hf⟩ := exists_datum_with_compatible_jets hRunge hdim hcompact hconnected hq hNR hLocal S Γ hΓ N points hinj hpoints
    (fun i => compatibleValueJet g q (points i) (values i) 0)
  refine ⟨f, fun i => ?_⟩
  exact congrArg (fun j : JetSpace g (points i) => j.1) (hf i)

end ConformalPoisson

end ProofPart_ExactJets

/- Proof support: EuclideanQuadratic.lean, SHA256 609e0d7f0f1b652c21ac10f2820e61842e9d195caf3105e402dcf7fbae89d4fb -/
noncomputable section ProofPart_EuclideanQuadratic



/-
Quadratic polynomials realizing their value, first derivative and symmetric second derivative.
The trace-free coefficient subspace gives the Euclidean harmonic polynomial family used in
the small-ball construction. Every derivative below is Mathlib's actual Fréchet derivative.
-/

open scoped ContDiff

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def symmetricBilinearSubmodule (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    Submodule ℝ (E →L[ℝ] E →L[ℝ] ℝ) where
  carrier := {B | ∀ v w, B v w = B w v}
  zero_mem' := by intro v w; rfl
  add_mem' := by
    intro B C hB hC v w
    change B v w + C v w = B w v + C w v
    rw [hB v w, hC v w]
  smul_mem' a B hB := by
    intro v w
    change a * B v w = a * B w v
    rw [hB v w]

/-- Use the canonical subspace norm, fixing its real scalar explicitly for elaboration. -/
instance : NormedAddCommGroup (symmetricBilinearSubmodule E) :=
  Submodule.normedAddCommGroup (𝕜 := ℝ) (E := E →L[ℝ] E →L[ℝ] ℝ)
    (symmetricBilinearSubmodule E)

instance : NormedSpace ℝ (symmetricBilinearSubmodule E) :=
  Submodule.normedSpace (𝕜 := ℝ) (R := ℝ) (E := E →L[ℝ] E →L[ℝ] ℝ)
    (symmetricBilinearSubmodule E)

instance [FiniteDimensional ℝ E] : FiniteDimensional ℝ (symmetricBilinearSubmodule E) :=
  FiniteDimensional.of_injective (K := ℝ) (V₂ := E →L[ℝ] E →L[ℝ] ℝ)
    (symmetricBilinearSubmodule E).subtype (fun _ _ h => Subtype.ext h)

abbrev FlatJet (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :=
  ℝ × (E →L[ℝ] ℝ) × symmetricBilinearSubmodule E

def quadraticPolynomial (a : ℝ) (ξ : E →L[ℝ] ℝ)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (z : E) : ℝ :=
  a + ξ z + (1 / 2 : ℝ) * B z z

without_proof_info in
theorem hasFDerivAt_quadraticPolynomial (a : ℝ) (ξ : E →L[ℝ] ℝ)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (hs : ∀ v w, B v w = B w v) (z : E) :
    HasFDerivAt (quadraticPolynomial a ξ B) (ξ + B z) z := by
  have hquad := B.hasFDerivAt_of_bilinear (hasFDerivAt_id z) (hasFDerivAt_id z)
  have h := ((hasFDerivAt_const a z).add ξ.hasFDerivAt).add
    (hquad.const_smul (1 / 2 : ℝ))
  convert h using 1
  · rfl
  · ext v
    simp [ContinuousLinearMap.precompL_apply, ContinuousLinearMap.precompR_apply, hs z v]
    ring

without_proof_info in
theorem fderiv_quadraticPolynomial (a : ℝ) (ξ : E →L[ℝ] ℝ)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (hs : ∀ v w, B v w = B w v) (z : E) :
    fderiv ℝ (quadraticPolynomial a ξ B) z = ξ + B z :=
  (hasFDerivAt_quadraticPolynomial a ξ B hs z).fderiv

without_proof_info in
theorem secondFDeriv_quadraticPolynomial (a : ℝ) (ξ : E →L[ℝ] ℝ)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (hs : ∀ v w, B v w = B w v) (z : E) :
    fderiv ℝ (fderiv ℝ (quadraticPolynomial a ξ B)) z = B := by
  have hfirst : fderiv ℝ (quadraticPolynomial a ξ B) = fun z => ξ + B z :=
    funext (fderiv_quadraticPolynomial a ξ B hs)
  rw [hfirst]
  simp

without_proof_info in
theorem contDiff_quadraticPolynomial (a : ℝ) (ξ : E →L[ℝ] ℝ)
    (B : E →L[ℝ] E →L[ℝ] ℝ) : ContDiff ℝ ∞ (quadraticPolynomial a ξ B) := by
  unfold quadraticPolynomial
  fun_prop

/-- One linear family of polynomials, with the coefficient jet as its parameter. -/
def flatJetPolynomial : FlatJet E →ₗ[ℝ] (E → ℝ) where
  toFun j := quadraticPolynomial j.1 j.2.1 j.2.2.val
  map_add' j k := by
    funext z
    change (j.1 + k.1) + (j.2.1 z + k.2.1 z) +
      (1 / 2 : ℝ) * (j.2.2.val z z + k.2.2.val z z) =
      (j.1 + j.2.1 z + (1 / 2 : ℝ) * j.2.2.val z z) +
        (k.1 + k.2.1 z + (1 / 2 : ℝ) * k.2.2.val z z)
    ring
  map_smul' a j := by
    funext z
    change a * j.1 + a * j.2.1 z + (1 / 2 : ℝ) * (a * j.2.2.val z z) =
      a * (j.1 + j.2.1 z + (1 / 2 : ℝ) * j.2.2.val z z)
    ring

without_proof_info in
@[simp] theorem flatJetPolynomial_value_zero (j : FlatJet E) :
    flatJetPolynomial j 0 = j.1 := by
  change quadraticPolynomial j.1 j.2.1 j.2.2.val 0 = j.1
  simp [quadraticPolynomial]

without_proof_info in
@[simp] theorem flatJetPolynomial_fderiv_zero (j : FlatJet E) :
    fderiv ℝ (flatJetPolynomial j) 0 = j.2.1 := by
  change fderiv ℝ (quadraticPolynomial j.1 j.2.1 j.2.2.val) 0 = j.2.1
  rw [fderiv_quadraticPolynomial _ _ _ j.2.2.property]
  simp

without_proof_info in
@[simp] theorem flatJetPolynomial_secondFDeriv (j : FlatJet E) (z : E) :
    fderiv ℝ (fderiv ℝ (flatJetPolynomial j)) z = j.2.2.val :=
  secondFDeriv_quadraticPolynomial _ _ _ j.2.2.property z

without_proof_info in
theorem contDiff_flatJetPolynomial (j : FlatJet E) :
    ContDiff ℝ ∞ (flatJetPolynomial j) := contDiff_quadraticPolynomial _ _ _

variable {d : ℕ}

def flatJetTrace : FlatJet (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] ℝ where
  toFun j := ∑ i, j.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)
  map_add' j k := by
    change (∑ i, (j.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1) +
      k.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1))) = _
    exact Finset.sum_add_distrib
  map_smul' a j := by
    change (∑ i, a * j.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)) = _
    exact (Finset.mul_sum _ _ _).symm

def traceFreeFlatJetSubmodule (d : ℕ) : Submodule ℝ (FlatJet (EuclideanSpace ℝ (Fin d))) :=
  flatJetTrace.ker

instance (d : ℕ) : FiniteDimensional ℝ (traceFreeFlatJetSubmodule d) :=
  FiniteDimensional.of_injective (K := ℝ) (V₂ := FlatJet (EuclideanSpace ℝ (Fin d)))
    (traceFreeFlatJetSubmodule d).subtype (fun _ _ h => Subtype.ext h)

without_proof_info in
/-- The trace-free parameter family solves the unperturbed equation everywhere. -/
theorem coordinateSchrodinger_flatJetPolynomial
    (j : traceFreeFlatJetSubmodule d) (z : EuclideanSpace ℝ (Fin d)) :
    coordinateSchrodinger (fun _ => ContinuousLinearMap.id ℝ _) 0 0
      (flatJetPolynomial j.val) z = 0 := by
  have hj : flatJetTrace j.val = 0 := j.property
  change (∑ i, j.val.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)) = 0 at hj
  change -(∑ i, fderiv ℝ (fderiv ℝ (flatJetPolynomial j.val)) z
    (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)) +
      fderiv ℝ (flatJetPolynomial j.val) z 0 + 0 * flatJetPolynomial j.val z = 0
  rw [flatJetPolynomial_secondFDeriv]
  simpa only [map_zero, zero_mul, add_zero, neg_eq_zero] using hj

end ConformalPoisson

end ProofPart_EuclideanQuadratic

/- Proof support: CoefficientRescaling.lean, SHA256 fe817c813d2300ad69bbdc34f4d349f246dd862c8057a37b93047e5d1bb4dd69 -/
noncomputable section ProofPart_CoefficientRescaling





/-
Smallness of the actual coefficient fields after rescaling to the unit ball. The estimates
control both the supremum and the Hölder seminorm required by SchauderInput. No elliptic
solvability is asserted in this module.
-/

open Set Metric Filter
open scoped NNReal ContDiff Topology

namespace ConformalPoisson

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
without_proof_info in
theorem holderBound.mono {α K L : ℝ≥0} {U : Set E} {f : E → F}
    (h : holderBound α U f K) (hKL : K ≤ L) : holderBound α U f L :=
  ⟨fun x hx => (h.1 x hx).trans (by exact_mod_cast hKL), h.2.mono_const hKL⟩

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
without_proof_info in
theorem holderBound.add {α K L : ℝ≥0} {U : Set E} {f g : E → F}
    (hf : holderBound α U f K) (hg : holderBound α U g L) :
    holderBound α U (fun x => f x + g x) (K + L) := by
  refine ⟨fun x hx => ?_, hf.2.add hg.2⟩
  exact (norm_add_le _ _).trans (add_le_add (hf.1 x hx) (hg.1 x hx))

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
without_proof_info in
theorem holderBound.const (α : ℝ≥0) (U : Set E) (c : F) :
    holderBound α U (fun _ => c) ‖c‖₊ :=
  ⟨fun _ _ => le_rfl, HolderWith.const.holderOnWith U⟩

omit [NormedSpace ℝ E] in
without_proof_info in
theorem holderBound.const_smul {α K : ℝ≥0} {U : Set E} {f : E → F}
    (h : holderBound α U f K) (a : ℝ) :
    holderBound α U (fun x => a • f x) (‖a‖₊ * K) := by
  refine ⟨fun x hx => ?_, ?_⟩
  · rw [norm_smul]
    exact mul_le_mul_of_nonneg_left (h.1 x hx) (norm_nonneg a)
  · apply HolderOnWith.of_dist_le
    intro x hx y hy
    rw [dist_eq_norm, ← smul_sub, norm_smul]
    have hh := h.2.dist_le hx hy
    rw [dist_eq_norm] at hh
    exact (mul_le_mul_of_nonneg_left hh (norm_nonneg a)).trans_eq (by push_cast; ring)

omit [NormedSpace ℝ F] in
without_proof_info in
/-- Quantitative rescaling of a Lipschitz coefficient which vanishes at the center. -/
theorem holderBound_rescale_of_zero {μ : E → F} {s : Set E} {L α : ℝ≥0}
    (hμ : LipschitzOnWith L μ s) (hs : (0 : E) ∈ s) (hμ0 : μ 0 = 0)
    (hα : α ≤ 1) (ε : ℝ)
    (hmap : MapsTo (fun z : E => ε • z) (closedBall 0 1) s) :
    holderBound α (closedBall 0 1) (fun z => μ (ε • z)) (3 * L * ‖ε‖₊) := by
  have hb : ∀ z ∈ closedBall (0 : E) 1, ‖μ (ε • z)‖ ≤ (L * ‖ε‖₊ : ℝ≥0) := by
    intro z hz
    have h := hμ.dist_le_mul (ε • z) (hmap hz) 0 hs
    rw [hμ0, dist_zero_right, dist_zero_right, norm_smul] at h
    calc
      ‖μ (ε • z)‖ ≤ L * (‖ε‖ * ‖z‖) := h
      _ ≤ L * (‖ε‖ * 1) := by
        gcongr
        exact mem_closedBall_zero_iff.mp hz
      _ = (L * ‖ε‖₊ : ℝ≥0) := by simp
  have hLip : LipschitzOnWith (L * ‖ε‖₊) (fun z => μ (ε • z)) (closedBall 0 1) :=
    hμ.comp (lipschitzWith_smul ε).lipschitzOnWith hmap
  have hH := hLip.holderOnWith_of_norm_le hb hα
  have hK : L * ‖ε‖₊ ≤ 3 * L * ‖ε‖₊ := by
    calc
      _ ≤ 3 * (L * ‖ε‖₊) := le_mul_of_one_le_left (by positivity) (by norm_num)
      _ = _ := by ring
  refine ⟨fun z hz => (hb z hz).trans (by exact_mod_cast hK), ?_⟩
  convert hH using 1
  ring

without_proof_info in
theorem eventually_rescale_unit_closedBall {R : ℝ} (hR : 0 < R) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), MapsTo (fun z : E => ε • z) (closedBall 0 1) (ball 0 R) := by
  filter_upwards [ball_mem_nhds (0 : ℝ) hR] with ε hε z hz
  have hε' : ‖ε‖ < R := mem_ball_zero_iff.mp hε
  rw [mem_ball_zero_iff, norm_smul]
  calc
    ‖ε‖ * ‖z‖ ≤ ‖ε‖ * 1 := by
      gcongr
      exact mem_closedBall_zero_iff.mp hz
    _ < R := by simpa using hε'

without_proof_info in
/-- A C¹ coefficient, normalized by its central value, becomes small in C^{0,α}. -/
theorem eventually_holderBound_rescale_sub {μ : E → F} {α δ : ℝ≥0}
    (hμ : ContDiffAt ℝ 1 μ 0) (hα : α ≤ 1) (hδ : 0 < δ) :
    ∀ᶠ ε in 𝓝 (0 : ℝ),
      holderBound α (closedBall 0 1) (fun z => μ (ε • z) - μ 0) δ := by
  obtain ⟨L, t, ht, hLip⟩ := hμ.exists_lipschitzOnWith
  obtain ⟨R, hR, hRt⟩ := Metric.mem_nhds_iff.mp ht
  have hsub : LipschitzOnWith L (fun z => μ z - μ 0) (ball 0 R) := by
    apply LipschitzOnWith.of_dist_le_mul
    intro x hx y hy
    simpa only [dist_sub_right] using hLip.dist_le_mul x (hRt hx) y (hRt hy)
  have hlim : Tendsto (fun ε : ℝ => 3 * (L : ℝ) * ‖ε‖) (𝓝 0) (𝓝 0) := by
    have hc : Continuous (fun ε : ℝ => 3 * (L : ℝ) * ‖ε‖) := by fun_prop
    simpa only [norm_zero, mul_zero] using hc.tendsto (0 : ℝ)
  filter_upwards [eventually_rescale_unit_closedBall (E := E) hR,
    hlim.eventually (gt_mem_nhds (show (0 : ℝ) < δ from hδ))] with ε hmap hsmall
  have hb := holderBound_rescale_of_zero hsub (mem_ball_self hR) (sub_self _)
    hα ε hmap
  apply hb.mono
  exact_mod_cast hsmall.le

without_proof_info in
/-- Multiplication by a scalar tending to zero makes an arbitrary C¹ coefficient small. -/
theorem eventually_holderBound_weighted_rescale {μ : E → F} {α δ : ℝ≥0}
    (hμ : ContDiffAt ℝ 1 μ 0) (hα : α ≤ 1) (hδ : 0 < δ)
    {weight : ℝ → ℝ} (hw : Tendsto weight (𝓝 0) (𝓝 0)) :
    ∀ᶠ ε in 𝓝 (0 : ℝ),
      holderBound α (closedBall 0 1) (fun z => weight ε • μ (ε • z)) δ := by
  let K : ℝ≥0 := 1 + ‖μ 0‖₊
  have hlim : Tendsto (fun ε => ‖weight ε‖ * (K : ℝ)) (𝓝 0) (𝓝 0) := by
    simpa only [norm_zero, zero_mul] using hw.norm.mul_const (K : ℝ)
  filter_upwards [eventually_holderBound_rescale_sub (δ := 1) hμ hα (by norm_num),
    hlim.eventually (gt_mem_nhds (show (0 : ℝ) < δ from hδ))] with ε hsub hsmall
  have hb : holderBound α (closedBall 0 1) (fun z => μ (ε • z)) K := by
    simpa only [sub_add_cancel] using hsub.add (holderBound.const α (closedBall 0 1) (μ 0))
  exact (hb.const_smul (weight ε)).mono (by exact_mod_cast hsmall.le)

without_proof_info in
/-- All three coefficient smallness conditions hold for the same sufficiently small scale. -/
theorem eventually_rescaled_coefficient_bounds
    {a : E → (E →L[ℝ] E)} {b : E → E} {q : E → ℝ} {α δ : ℝ≥0}
    (ha : ContDiffAt ℝ 1 a 0) (hb : ContDiffAt ℝ 1 b 0) (hq : ContDiffAt ℝ 1 q 0)
    (ha0 : a 0 = ContinuousLinearMap.id ℝ E) (hα : α ≤ 1) (hδ : 0 < δ) :
    ∀ᶠ ε in 𝓝 (0 : ℝ),
      holderBound α (closedBall 0 1)
        (fun z => a (ε • z) - ContinuousLinearMap.id ℝ E) δ ∧
      holderBound α (closedBall 0 1) (fun z => ε • b (ε • z)) δ ∧
      holderBound α (closedBall 0 1) (fun z => ε ^ 2 * q (ε • z)) δ := by
  have ha' := eventually_holderBound_rescale_sub ha hα hδ
  have hb' := eventually_holderBound_weighted_rescale hb hα hδ
    (weight := fun ε : ℝ => ε) tendsto_id
  have hq' := eventually_holderBound_weighted_rescale hq hα hδ
    (weight := fun ε : ℝ => ε ^ 2)
    (by simpa using (tendsto_id : Tendsto (fun ε : ℝ => ε) (𝓝 0) (𝓝 0)).pow 2)
  filter_upwards [ha', hb', hq'] with ε haε hbε hqε
  exact ⟨by simpa only [ha0] using haε, hbε, hqε⟩

end ConformalPoisson

end ProofPart_CoefficientRescaling

/- Proof support: CoordinateCorrection.lean, SHA256 faa420e92cadf8211c733dd00ff383c1656e56e2a25618ee4531e93537e8f2d3 -/
noncomputable section ProofPart_CoordinateCorrection




/-
From the forward Schauder premise to actual homogeneous solutions with polynomial boundary
values, together with bounds on their value, derivative and Hessian errors at the center.
The correction is applied to the concrete coordinate differential operator.
-/

open Set Metric Filter
open scoped NNReal ContDiff Topology

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

without_proof_info in
theorem secondFDeriv_add {u v : E → ℝ} {z : E}
    (hu : ContDiffAt ℝ 2 u z) (hv : ContDiffAt ℝ 2 v z) :
    fderiv ℝ (fderiv ℝ (u + v)) z =
      fderiv ℝ (fderiv ℝ u) z + fderiv ℝ (fderiv ℝ v) z := by
  have hd : fderiv ℝ (u + v) =ᶠ[𝓝 z] fderiv ℝ u + fderiv ℝ v := by
    filter_upwards [hu.eventually (by simp), hv.eventually (by simp)] with y huy hvy
    exact fderiv_add (huy.differentiableAt (by norm_num)) (hvy.differentiableAt (by norm_num))
  rw [hd.fderiv_eq]
  exact fderiv_add
    ((hu.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num))
    ((hv.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num))

variable {d : ℕ}

without_proof_info in
theorem coordinateSchrodinger_add
    (a : EuclideanSpace ℝ (Fin d) →
      (EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q u v : EuclideanSpace ℝ (Fin d) → ℝ) (z : EuclideanSpace ℝ (Fin d))
    (hu : ContDiffAt ℝ 2 u z) (hv : ContDiffAt ℝ 2 v z) :
    coordinateSchrodinger a b q (u + v) z =
      coordinateSchrodinger a b q u z + coordinateSchrodinger a b q v z := by
  simp only [coordinateSchrodinger, secondFDeriv_add hu hv,
    fderiv_add (hu.differentiableAt (by norm_num)) (hv.differentiableAt (by norm_num)),
    add_apply, Pi.add_apply, Finset.sum_add_distrib, mul_add]
  ring

without_proof_info in
theorem coordinateSchrodinger_smul
    (a : EuclideanSpace ℝ (Fin d) →
      (EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q u : EuclideanSpace ℝ (Fin d) → ℝ) (c : ℝ) (z : EuclideanSpace ℝ (Fin d)) :
    coordinateSchrodinger a b q (c • u) z = c * coordinateSchrodinger a b q u z := by
  have hfirst : fderiv ℝ (c • u) = c • fderiv ℝ u := fderiv_const_smul_field c
  have hsecond : fderiv ℝ (fderiv ℝ (c • u)) = c • fderiv ℝ (fderiv ℝ u) := by
    rw [hfirst]
    exact fderiv_const_smul_field (𝕜 := ℝ) (f := fderiv ℝ u) c
  unfold coordinateSchrodinger
  rw [hsecond, hfirst]
  simp only [smul_apply, Pi.smul_apply,
    smul_eq_mul, ← Finset.mul_sum]
  ring

without_proof_info in
theorem contDiffOn_coordinateSchrodinger_flatJetPolynomial
    {a : EuclideanSpace ℝ (Fin d) →
      (EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))}
    {b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)}
    {q : EuclideanSpace ℝ (Fin d) → ℝ} {U : Set (EuclideanSpace ℝ (Fin d))}
    (ha : ContDiffOn ℝ ∞ a U) (hb : ContDiffOn ℝ ∞ b U) (hq : ContDiffOn ℝ ∞ q U)
    (j : FlatJet (EuclideanSpace ℝ (Fin d))) :
    ContDiffOn ℝ ∞ (coordinateSchrodinger a b q (flatJetPolynomial j)) U := by
  have hfirst (z : EuclideanSpace ℝ (Fin d)) :
      fderiv ℝ (flatJetPolynomial j) z = j.2.1 + j.2.2.val z :=
    fderiv_quadraticPolynomial _ _ _ j.2.2.property z
  unfold coordinateSchrodinger
  simp_rw [flatJetPolynomial_secondFDeriv, hfirst]
  have hprincipal (i : Fin d) : ContDiffOn ℝ ∞
      (fun z => j.2.2.val (EuclideanSpace.single i 1) (a z (EuclideanSpace.single i 1))) U :=
    (j.2.2.val (EuclideanSpace.single i 1)).contDiff.comp_contDiffOn
      (ha.clm_apply contDiffOn_const)
  have hgradient : ContDiffOn ℝ ∞ (fun z => (j.2.1 + j.2.2.val z) (b z)) U :=
    (contDiffOn_const.add j.2.2.val.contDiff.contDiffOn).clm_apply hb
  exact ((ContDiffOn.sum (fun i _ => hprincipal i)).neg.add hgradient).add
    (hq.mul (contDiff_flatJetPolynomial j).contDiffOn)

without_proof_info in
/-- Correct a polynomial by a zero-boundary solution. The same correction controls every
component of its central second jet, with the forward theory's single constant C. -/
theorem exists_polynomial_correction
    (α δ C : ℝ≥0)
    (hSolve : SchauderDirichletEstimate d α δ C)
    (a : EuclideanSpace ℝ (Fin d) →
      (EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q : EuclideanSpace ℝ (Fin d) → ℝ)
    (ha : ContDiffOn ℝ ∞ a (closedBall 0 1))
    (hb : ContDiffOn ℝ ∞ b (closedBall 0 1)) (hq : ContDiffOn ℝ ∞ q (closedBall 0 1))
    (haδ : holderBound α (closedBall 0 1) (fun z => a z - ContinuousLinearMap.id ℝ _) δ)
    (hbδ : holderBound α (closedBall 0 1) b δ) (hqδ : holderBound α (closedBall 0 1) q δ)
    (j : FlatJet (EuclideanSpace ℝ (Fin d))) (K : ℝ≥0)
    (hK : holderBound α (closedBall 0 1)
      (fun z => -coordinateSchrodinger a b q (flatJetPolynomial j) z) K) :
    ∃ w : EuclideanSpace ℝ (Fin d) → ℝ,
      ContDiffOn ℝ ∞ w (ball 0 1) ∧
      EqOn w (flatJetPolynomial j) (sphere 0 1) ∧
      (∀ z ∈ ball 0 1, coordinateSchrodinger a b q w z = 0) ∧
      ‖w 0 - j.1‖ ≤ (C * K : ℝ≥0) ∧
      ‖fderiv ℝ w 0 - j.2.1‖ ≤ (C * K : ℝ≥0) ∧
      ‖fderiv ℝ (fderiv ℝ w) 0 - j.2.2.val‖ ≤ (C * K : ℝ≥0) := by
  have hF := (contDiffOn_coordinateSchrodinger_flatJetPolynomial ha hb hq j).neg
  obtain ⟨u, hu, _hucont, hubdry, hLu, hbound⟩ :=
    hSolve a b q ha hb hq haδ hbδ hqδ _ K hF hK
  let P := flatJetPolynomial j
  have hP : ContDiff ℝ ∞ P := contDiff_flatJetPolynomial j
  have hP2 (z : EuclideanSpace ℝ (Fin d)) : ContDiffAt ℝ 2 P z :=
    hP.contDiffAt.of_le (by decide)
  have hu2 (z : EuclideanSpace ℝ (Fin d)) (hz : z ∈ ball 0 1) : ContDiffAt ℝ 2 u z :=
    (hu.contDiffAt (isOpen_ball.mem_nhds hz)).of_le (by decide)
  have hzero : (0 : EuclideanSpace ℝ (Fin d)) ∈ ball 0 1 := mem_ball_self (by norm_num)
  obtain ⟨hval, hder, hhess⟩ := secondOrderHolderBound_at_center hbound
  refine ⟨P + u, hP.contDiffOn.add hu, ?_, ?_, ?_, ?_, ?_⟩
  · intro z hz
    change P z + u z = P z
    simp only [hubdry hz, Pi.zero_apply, add_zero]
  · intro z hz
    rw [coordinateSchrodinger_add _ _ _ _ _ _ (hP2 z) (hu2 z hz), hLu z hz]
    ring
  · simpa only [Pi.add_apply, show P 0 = j.1 from flatJetPolynomial_value_zero j,
      add_sub_cancel_left] using hval
  · rw [fderiv_add ((hP2 0).differentiableAt (by norm_num))
      ((hu2 0 hzero).differentiableAt (by norm_num))]
    simpa only [show fderiv ℝ P 0 = j.2.1 from flatJetPolynomial_fderiv_zero j,
      add_sub_cancel_left] using hder
  · rw [secondFDeriv_add (hP2 0) (hu2 0 hzero)]
    simpa only [show fderiv ℝ (fderiv ℝ P) 0 = j.2.2.val from
      flatJetPolynomial_secondFDeriv j 0, add_sub_cancel_left] using hhess

end ConformalPoisson

end ProofPart_CoordinateCorrection

/- Proof support: HolderBounds.lean, SHA256 0c7be95988ad441599ef17796f97107aaf6ec4bfe7633ca60ec02467ed3fd67a -/
noncomputable section ProofPart_HolderBounds




/- Bounds for linear and bilinear operations on the concrete max-type Hölder bounds. -/

open Set Metric
open scoped NNReal ContDiff

namespace ConformalPoisson

variable {E F G H : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup G] [NormedSpace ℝ G]
  [NormedAddCommGroup H] [NormedSpace ℝ H]

omit [NormedSpace ℝ E] in
without_proof_info in
theorem holderBound.mapCLM {α K : ℝ≥0} {U : Set E} {f : E → F}
    (hf : holderBound α U f K) (T : F →L[ℝ] G) :
    holderBound α U (fun x => T (f x)) (‖T‖₊ * K) := by
  refine ⟨fun x hx => ?_, ?_⟩
  · exact (T.le_opNorm _).trans
      (mul_le_mul_of_nonneg_left (hf.1 x hx) (norm_nonneg T))
  · apply HolderOnWith.of_dist_le
    intro x hx y hy
    calc
      dist (T (f x)) (T (f y)) ≤ ‖T‖ * dist (f x) (f y) := T.dist_le_opNorm _ _
      _ ≤ ‖T‖ * (K * dist x y ^ (α : ℝ)) :=
        mul_le_mul_of_nonneg_left (hf.2.dist_le hx hy) (norm_nonneg T)
      _ = (‖T‖₊ * K : ℝ≥0) * dist x y ^ (α : ℝ) := by push_cast; ring

omit [NormedSpace ℝ E] in
without_proof_info in
theorem holderBound.bilinear {α K L : ℝ≥0} {U : Set E} {f : E → F} {g : E → G}
    (hf : holderBound α U f K) (hg : holderBound α U g L)
    (T : F →L[ℝ] G →L[ℝ] H) :
    holderBound α U (fun x => T (f x) (g x)) (‖T‖₊ * (K * L + L * K)) := by
  refine ⟨fun x hx => ?_, ?_⟩
  · calc
      ‖T (f x) (g x)‖ ≤ ‖T‖ * ‖f x‖ * ‖g x‖ := T.le_opNorm₂ _ _
      _ ≤ ‖T‖ * K * L := by gcongr; exact hf.1 x hx; exact hg.1 x hx
      _ = ‖T‖ * (K * L) := by ring
      _ ≤ (‖T‖₊ * (K * L + L * K) : ℝ≥0) := by
        push_cast
        exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (by positivity)) (norm_nonneg T)
  · exact T.holderOnWith_comp₂ hf.2 hg.2 hf.1 hg.1

omit [NormedSpace ℝ E] in
without_proof_info in
theorem holderBound.neg {α K : ℝ≥0} {U : Set E} {f : E → F}
    (hf : holderBound α U f K) : holderBound α U (fun x => -f x) K := by
  simpa only [neg_smul, one_smul, nnNorm_neg, nnNorm_one, one_mul] using hf.const_smul (-1)

omit [NormedSpace ℝ E] in
without_proof_info in
theorem holderBound.sub {α K L : ℝ≥0} {U : Set E} {f g : E → F}
    (hf : holderBound α U f K) (hg : holderBound α U g L) :
    holderBound α U (fun x => f x - g x) (K + L) := by
  simpa only [sub_eq_add_neg] using hf.add hg.neg

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
without_proof_info in
theorem holderBound.sum {ι : Type*} (s : Finset ι) {α : ℝ≥0} {U : Set E}
    {f : ι → E → F} {K : ι → ℝ≥0}
    (hf : ∀ i ∈ s, holderBound α U (f i) (K i)) :
    holderBound α U (fun x => ∑ i ∈ s, f i x) (∑ i ∈ s, K i) := by
  classical
  revert hf
  induction s using Finset.induction_on with
  | empty =>
    intro _
    simpa only [Finset.sum_empty, nnNorm_zero] using holderBound.const α U (0 : F)
  | @insert i s hi ih =>
    intro hf
    have hs := ih (fun k hk => hf k (Finset.mem_insert_of_mem hk))
    simpa only [Finset.sum_insert hi] using (hf i (Finset.mem_insert_self i s)).add hs

without_proof_info in
theorem exists_holderBound_closedBall [ProperSpace E] {f : E → F}
    (hf : ContDiff ℝ 1 f) {α : ℝ≥0} (hα : α ≤ 1) :
    ∃ K : ℝ≥0, holderBound α (closedBall 0 1) f K := by
  obtain ⟨L, hL⟩ := hf.contDiffOn.exists_lipschitzOnWith (by norm_num)
    (convex_closedBall (0 : E) 1) (isCompact_closedBall 0 1)
  obtain ⟨M, hM⟩ := (isCompact_closedBall (0 : E) 1).exists_bound_of_continuousOn hf.continuous.continuousOn
  have hM0 : 0 ≤ M := (norm_nonneg (f 0)).trans (hM 0 (mem_closedBall_self zero_le_one))
  lift M to ℝ≥0 using hM0
  refine ⟨L + 2 * M, ⟨fun x hx => (hM x hx).trans ?_, hL.holderOnWith_of_norm_le hM hα⟩⟩
  have hle : M ≤ L + 2 * M := calc
    M ≤ 2 * M := le_mul_of_one_le_left (by positivity) (by norm_num)
    _ ≤ L + 2 * M := le_add_of_nonneg_left (by positivity)
  exact_mod_cast hle

end ConformalPoisson

end ProofPart_HolderBounds

/- Proof support: PolynomialResidual.lean, SHA256 c946ec4d65769282bf73764e842effa09ed2225431509d70b95e41f0493ff1db -/
noncomputable section ProofPart_PolynomialResidual




/-
The residual forcing of a fixed harmonic quadratic polynomial is bounded linearly by the
Hölder sizes of a-id, b and q. In particular it tends to zero after the small-ball rescaling.
This is a proved estimate, separate from the forward Schauder premise.
-/

open Set Metric Filter
open scoped NNReal ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def polynomialPrincipalFunctional (j : FlatJet V) (i : Fin d) :
    (V →L[ℝ] V) →L[ℝ] ℝ :=
  (j.2.2.val (EuclideanSpace.single i 1)).comp
    (ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i 1))

without_proof_info in
theorem coordinate_polynomial_residual_eq (j : traceFreeFlatJetSubmodule d)
    (a : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) (z : V) :
    -coordinateSchrodinger a b q (flatJetPolynomial j.val) z =
      (∑ i, polynomialPrincipalFunctional j.val i (a z - ContinuousLinearMap.id ℝ V)) -
      fderiv ℝ (flatJetPolynomial j.val) z (b z) - q z * flatJetPolynomial j.val z := by
  have htr : flatJetTrace j.val = 0 := j.property
  change (∑ i, j.val.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)) = 0 at htr
  have hprincipal :
      (∑ i, polynomialPrincipalFunctional j.val i (a z - ContinuousLinearMap.id ℝ V)) =
      ∑ i, j.val.2.2.val (EuclideanSpace.single i 1) (a z (EuclideanSpace.single i 1)) := by
    change (∑ i, j.val.2.2.val (EuclideanSpace.single i 1)
      (a z (EuclideanSpace.single i 1) - EuclideanSpace.single i 1)) = _
    simp only [map_sub, Finset.sum_sub_distrib, htr, sub_zero]
  unfold coordinateSchrodinger
  rw [flatJetPolynomial_secondFDeriv, hprincipal]
  ring

without_proof_info in
/-- For one fixed polynomial, one positive constant controls all coefficient triples. -/
theorem exists_polynomial_residual_bound (α : ℝ≥0) (hα : α ≤ 1)
    (j : traceFreeFlatJetSubmodule d) :
    ∃ C : ℝ≥0, 0 < C ∧
      ∀ (κ : ℝ≥0) (a : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ),
        holderBound α (closedBall 0 1) (fun z => a z - ContinuousLinearMap.id ℝ V) κ →
        holderBound α (closedBall 0 1) b κ → holderBound α (closedBall 0 1) q κ →
        holderBound α (closedBall 0 1)
          (fun z => -coordinateSchrodinger a b q (flatJetPolynomial j.val) z) (C * κ) := by
  obtain ⟨M, hM⟩ := exists_holderBound_closedBall
    ((contDiff_flatJetPolynomial j.val).of_le (by decide)) hα
  obtain ⟨D, hD⟩ := exists_holderBound_closedBall
    ((contDiff_flatJetPolynomial j.val).fderiv_right (m := 1) (by decide)) hα
  let : NormedAddCommGroup (V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ) :=
    ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
      (E := V) (F := (V →L[ℝ] ℝ) →L[ℝ] ℝ)
  let T : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ
  let R : ℝ →L[ℝ] ℝ →L[ℝ] ℝ := ContinuousLinearMap.mul ℝ ℝ
  let C₀ : ℝ≥0 := (∑ i, ‖polynomialPrincipalFunctional j.val i‖₊) +
    2 * ‖T‖₊ * D + 2 * ‖R‖₊ * M
  refine ⟨C₀ + 1, by positivity, ?_⟩
  intro κ a b q ha hb hq
  have hp := holderBound.sum Finset.univ
    (fun i _ => ha.mapCLM (polynomialPrincipalFunctional j.val i))
  have hdrift := hb.bilinear hD T
  have hpotential := hq.bilinear hM R
  have hraw := (hp.sub hdrift).sub hpotential
  have hres : holderBound α (closedBall 0 1)
      (fun z => -coordinateSchrodinger a b q (flatJetPolynomial j.val) z) (C₀ * κ) := by
    convert hraw using 1
    · funext z
      exact coordinate_polynomial_residual_eq j a b q z
    · dsimp [C₀]
      rw [← Finset.sum_mul]
      ring
  exact hres.mono (mul_le_mul_of_nonneg_right
    (le_add_of_nonneg_right (show 0 ≤ (1 : ℝ≥0) by norm_num)) (show 0 ≤ κ from zero_le))

without_proof_info in
/-- Rescaling makes the actual forcing arbitrarily small in the required Hölder norm. -/
theorem eventually_polynomial_residual_bound
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {α η : ℝ≥0}
    (ha : ContDiffAt ℝ 1 a 0) (hb : ContDiffAt ℝ 1 b 0) (hq : ContDiffAt ℝ 1 q 0)
    (ha0 : a 0 = ContinuousLinearMap.id ℝ V) (hα : α ≤ 1) (hη : 0 < η)
    (j : traceFreeFlatJetSubmodule d) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), holderBound α (closedBall 0 1)
      (fun z => -coordinateSchrodinger (fun z => a (ε • z))
        (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z))
        (flatJetPolynomial j.val) z) η := by
  obtain ⟨C, hC, hbound⟩ := exists_polynomial_residual_bound α hα j
  have hsmall := eventually_rescaled_coefficient_bounds ha hb hq ha0 hα (div_pos hη hC)
  filter_upwards [hsmall] with ε hε
  have h := hbound (η / C) _ _ _ hε.1 hε.2.1 hε.2.2
  convert h using 1
  field_simp

end ConformalPoisson

end ProofPart_PolynomialResidual

/- Proof support: FlatJetProjection.lean, SHA256 fafd179cc920aca047faa99ff3fb7884b7c620973796a88dc5fdc93d419e4136 -/
noncomputable section ProofPart_FlatJetProjection





/-
The actual central-jet map and its trace-free projection. This is the finite-dimensional target
to which the small-ball corrected polynomial family will be mapped. The projection preserves
the value and covector and removes only the scalar Euclidean Hessian trace.
-/

open scoped ContDiff

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def flatJetAt (u : E → ℝ) (x : E) (hu : ContDiffAt ℝ 2 u x) : FlatJet E :=
  ⟨u x, fderiv ℝ u x,
    ⟨fderiv ℝ (fderiv ℝ u) x, hu.isSymmSndFDerivAt (by norm_num)⟩⟩

without_proof_info in
theorem flatJetAt_add {u v : E → ℝ} {x : E}
    (hu : ContDiffAt ℝ 2 u x) (hv : ContDiffAt ℝ 2 v x) :
    flatJetAt (u + v) x (hu.add hv) = flatJetAt u x hu + flatJetAt v x hv := by
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact fderiv_add (hu.differentiableAt (by norm_num)) (hv.differentiableAt (by norm_num))
  · apply Subtype.ext
    exact secondFDeriv_add hu hv

without_proof_info in
theorem flatJetAt_smul (c : ℝ) {u : E → ℝ} {x : E} (hu : ContDiffAt ℝ 2 u x) :
    flatJetAt (c • u) x (hu.const_smul c) = c • flatJetAt u x hu := by
  have hfirst : fderiv ℝ (c • u) = c • fderiv ℝ u :=
    fderiv_const_smul_field (𝕜 := ℝ) (f := u) c
  have hsecond : fderiv ℝ (fderiv ℝ (c • u)) = c • fderiv ℝ (fderiv ℝ u) := by
    rw [hfirst]
    exact fderiv_const_smul_field (𝕜 := ℝ) (f := fderiv ℝ u) c
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact congrFun hfirst x
  · apply Subtype.ext
    exact congrFun hsecond x

without_proof_info in
theorem flatJetAt_polynomial (j : FlatJet E) :
    flatJetAt (flatJetPolynomial j) 0
      ((contDiff_flatJetPolynomial j).contDiffAt.of_le (by decide)) = j := by
  refine Prod.ext (flatJetPolynomial_value_zero j)
    (Prod.ext (flatJetPolynomial_fderiv_zero j) ?_)
  apply Subtype.ext
  exact flatJetPolynomial_secondFDeriv j 0

without_proof_info in
theorem norm_flatJetAt_sub_le {u : E → ℝ} {x : E} (hu : ContDiffAt ℝ 2 u x)
    (j : FlatJet E) (K : ℝ)
    (hval : ‖u x - j.1‖ ≤ K) (hder : ‖fderiv ℝ u x - j.2.1‖ ≤ K)
    (hhess : ‖fderiv ℝ (fderiv ℝ u) x - j.2.2.val‖ ≤ K) :
    ‖flatJetAt u x hu - j‖ ≤ K := by
  exact norm_prod_le_iff.mpr ⟨hval, norm_prod_le_iff.mpr ⟨hder, hhess⟩⟩

def flatMetricBilinear (d : ℕ) : symmetricBilinearSubmodule (EuclideanSpace ℝ (Fin d)) :=
  ⟨innerSL ℝ, by intro v w; exact real_inner_comm w v⟩

without_proof_info in
theorem flatMetricTrace (d : ℕ) :
    flatJetTrace ((0, 0, flatMetricBilinear d) : FlatJet (EuclideanSpace ℝ (Fin d))) =
      (d : ℝ) := by
  change (∑ i : Fin d,
    inner ℝ (EuclideanSpace.single i (1 : ℝ)) (EuclideanSpace.single i (1 : ℝ))) = d
  simp

def scalarHessianJet (d : ℕ) : ℝ →ₗ[ℝ] FlatJet (EuclideanSpace ℝ (Fin d)) :=
  (LinearMap.id : ℝ →ₗ[ℝ] ℝ).smulRight (0, 0, flatMetricBilinear d)

without_proof_info in
theorem flatJetTrace_scalarHessianJet (d : ℕ) (r : ℝ) :
    flatJetTrace (scalarHessianJet d r) = r * d := by
  change flatJetTrace (r • ((0, 0, flatMetricBilinear d) : FlatJet _)) = r * d
  rw [map_smul, flatMetricTrace]
  rfl

def flatTraceFreeProjectionLinear (d : ℕ) :
    FlatJet (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] FlatJet (EuclideanSpace ℝ (Fin d)) :=
  LinearMap.id - (scalarHessianJet d).comp ((d : ℝ)⁻¹ • flatJetTrace)

without_proof_info in
theorem flatJetTrace_projection (d : ℕ) (hd : 0 < d)
    (j : FlatJet (EuclideanSpace ℝ (Fin d))) :
    flatJetTrace (flatTraceFreeProjectionLinear d j) = 0 := by
  change flatJetTrace (j - scalarHessianJet d ((d : ℝ)⁻¹ * flatJetTrace j)) = 0
  rw [map_sub, flatJetTrace_scalarHessianJet]
  have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  field_simp
  ring

def flatTraceFreeProjection (d : ℕ) (hd : 0 < d) :
    FlatJet (EuclideanSpace ℝ (Fin d)) →ₗ[ℝ] traceFreeFlatJetSubmodule d :=
  (flatTraceFreeProjectionLinear d).codRestrict _ (flatJetTrace_projection d hd)

without_proof_info in
theorem flatTraceFreeProjection_eq_self (d : ℕ) (hd : 0 < d)
    (j : traceFreeFlatJetSubmodule d) : flatTraceFreeProjection d hd j.val = j := by
  apply Subtype.ext
  have hj : flatJetTrace j.val = 0 := j.property
  change j.val - scalarHessianJet d ((d : ℝ)⁻¹ * flatJetTrace j.val) = j.val
  rw [hj, mul_zero, map_zero, sub_zero]

without_proof_info in
@[simp] theorem flatTraceFreeProjection_value (d : ℕ) (hd : 0 < d)
    (j : FlatJet (EuclideanSpace ℝ (Fin d))) :
    (flatTraceFreeProjection d hd j).val.1 = j.1 := by
  change j.1 - (d : ℝ)⁻¹ * flatJetTrace j * 0 = j.1
  simp

without_proof_info in
@[simp] theorem flatTraceFreeProjection_covector (d : ℕ) (hd : 0 < d)
    (j : FlatJet (EuclideanSpace ℝ (Fin d))) :
    (flatTraceFreeProjection d hd j).val.2.1 = j.2.1 := by
  change j.2.1 - ((d : ℝ)⁻¹ * flatJetTrace j) • 0 = j.2.1
  simp

def flatTraceFreeProjectionCLM (d : ℕ) (hd : 0 < d) :
    FlatJet (EuclideanSpace ℝ (Fin d)) →L[ℝ] traceFreeFlatJetSubmodule d :=
  LinearMap.toContinuousLinearMap (𝕜 := ℝ)
    (E := FlatJet (EuclideanSpace ℝ (Fin d))) (F' := traceFreeFlatJetSubmodule d)
    (flatTraceFreeProjection d hd)

without_proof_info in
@[simp] theorem flatTraceFreeProjectionCLM_apply (d : ℕ) (hd : 0 < d)
    (j : FlatJet (EuclideanSpace ℝ (Fin d))) :
    flatTraceFreeProjectionCLM d hd j = flatTraceFreeProjection d hd j := rfl

without_proof_info in
/-- One positive bound works for every jet, and can be shared by all polynomial corrections. -/
theorem exists_flatTraceFreeProjection_bound (d : ℕ) (hd : 0 < d) :
    ∃ B : ℝ, 0 < B ∧ ∀ j : FlatJet (EuclideanSpace ℝ (Fin d)),
      ‖flatTraceFreeProjection d hd j‖ ≤ B * ‖j‖ := by
  exact (ContinuousLinearMap.isBoundedLinearMap (𝕜 := ℝ)
    (E := FlatJet (EuclideanSpace ℝ (Fin d))) (F := traceFreeFlatJetSubmodule d)
    (flatTraceFreeProjectionCLM d hd)).bound

without_proof_info in
/-- The central error bounds from a Schauder correction control the projected jet error. -/
theorem norm_projected_flatJetAt_sub_le (d : ℕ) (hd : 0 < d)
    {u : EuclideanSpace ℝ (Fin d) → ℝ} (hu : ContDiffAt ℝ 2 u 0)
    (j : traceFreeFlatJetSubmodule d) (K : ℝ)
    (B : ℝ) (hB : 0 ≤ B)
    (hprojection : ∀ k : FlatJet (EuclideanSpace ℝ (Fin d)),
      ‖flatTraceFreeProjection d hd k‖ ≤ B * ‖k‖)
    (hval : ‖u 0 - j.val.1‖ ≤ K) (hder : ‖fderiv ℝ u 0 - j.val.2.1‖ ≤ K)
    (hhess : ‖fderiv ℝ (fderiv ℝ u) 0 - j.val.2.2.val‖ ≤ K) :
    ‖flatTraceFreeProjectionCLM d hd (flatJetAt u 0 hu) - j‖ ≤
      B * K := by
  let T := flatTraceFreeProjectionCLM d hd
  have hfix : T j.val = j := flatTraceFreeProjection_eq_self d hd j
  calc
    ‖T (flatJetAt u 0 hu) - j‖ = ‖T (flatJetAt u 0 hu - j.val)‖ := by
      rw [map_sub, hfix]
    _ ≤ B * ‖flatJetAt u 0 hu - j.val‖ := hprojection _
    _ ≤ B * K := mul_le_mul_of_nonneg_left
      (norm_flatJetAt_sub_le hu j.val K hval hder hhess) hB

end ConformalPoisson

end ProofPart_FlatJetProjection

/- Proof support: CorrectedPolynomials.lean, SHA256 4fb7075fd0e325fb280fdb0b970db741827c0444f3e3bd47b0891c551c06bfee -/
noncomputable section ProofPart_CorrectedPolynomials




/-
Actual corrected polynomial solutions, selected on a sequence of common positive scales.
The sequence simultaneously controls a finite family; every member uses the same coefficients,
scale, forward estimate and error tolerance. This supplies the columns of the perturbed jet map.
-/

open Set Metric Filter
open scoped NNReal ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

structure CorrectedPolynomial (a : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ)
    (ε : ℝ) (j : FlatJet V) (η : ℝ≥0) where
  solution : V → ℝ
  smooth : ContDiffOn ℝ ∞ solution (ball 0 1)
  boundary : EqOn solution (flatJetPolynomial j) (sphere 0 1)
  homogeneous : ∀ z ∈ ball 0 1, coordinateSchrodinger (fun z => a (ε • z))
    (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z)) solution z = 0
  value_error : ‖solution 0 - j.1‖ ≤ η
  derivative_error : ‖fderiv ℝ solution 0 - j.2.1‖ ≤ η
  hessian_error : ‖fderiv ℝ (fderiv ℝ solution) 0 - j.2.2.val‖ ≤ η

def CorrectedPolynomial.centralJet {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ}
    {ε : ℝ} {j : FlatJet V} {η : ℝ≥0} (u : CorrectedPolynomial a b q ε j η) : FlatJet V :=
  flatJetAt u.solution 0
    ((u.smooth.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self (by norm_num)))).of_le (by decide))

without_proof_info in
theorem CorrectedPolynomial.projectedJet_error {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ}
    {ε : ℝ} (j : traceFreeFlatJetSubmodule d) {η : ℝ≥0}
    (u : CorrectedPolynomial a b q ε j.val η) (hd : 0 < d)
    (B : ℝ) (hB : 0 ≤ B)
    (hprojection : ∀ k : FlatJet V, ‖flatTraceFreeProjection d hd k‖ ≤ B * ‖k‖) :
    ‖flatTraceFreeProjectionCLM d hd u.centralJet - j‖ ≤ B * η :=
  norm_projected_flatJetAt_sub_le d hd _ j η B hB hprojection
    u.value_error u.derivative_error u.hessian_error

without_proof_info in
theorem eventually_rescaled_coefficients_smooth
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ} (hR : 0 < R)
    (ha : ContDiffOn ℝ ∞ a (ball 0 R)) (hb : ContDiffOn ℝ ∞ b (ball 0 R))
    (hq : ContDiffOn ℝ ∞ q (ball 0 R)) :
    ∀ᶠ ε in 𝓝 (0 : ℝ),
      ContDiffOn ℝ ∞ (fun z => a (ε • z)) (closedBall 0 1) ∧
      ContDiffOn ℝ ∞ (fun z => ε • b (ε • z)) (closedBall 0 1) ∧
      ContDiffOn ℝ ∞ (fun z => ε ^ 2 * q (ε • z)) (closedBall 0 1) := by
  filter_upwards [eventually_rescale_unit_closedBall (E := V) hR] with ε hmap
  have hscale : ContDiff ℝ ∞ (fun z : V => ε • z) := contDiff_const_smul ε
  exact ⟨ha.comp hscale.contDiffOn hmap,
    (hb.comp hscale.contDiffOn hmap).const_smul ε,
    (hq.comp hscale.contDiffOn hmap).const_smul (ε ^ 2)⟩

without_proof_info in
theorem eventually_nonempty_correctedPolynomial
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ}
    {α δ C η : ℝ≥0} (hR : 0 < R)
    (ha : ContDiffOn ℝ ∞ a (ball 0 R)) (hb : ContDiffOn ℝ ∞ b (ball 0 R))
    (hq : ContDiffOn ℝ ∞ q (ball 0 R)) (ha0 : a 0 = ContinuousLinearMap.id ℝ V)
    (hα : α ≤ 1) (hδ : 0 < δ) (hC : 0 < C) (hη : 0 < η)
    (hSolve : SchauderDirichletEstimate d α δ C) (j : traceFreeFlatJetSubmodule d) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), Nonempty (CorrectedPolynomial a b q ε j.val η) := by
  have ha1 : ContDiffAt ℝ 1 a 0 :=
    (ha.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hR))).of_le (by decide)
  have hb1 : ContDiffAt ℝ 1 b 0 :=
    (hb.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hR))).of_le (by decide)
  have hq1 : ContDiffAt ℝ 1 q 0 :=
    (hq.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hR))).of_le (by decide)
  have hcoeff := eventually_rescaled_coefficient_bounds ha1 hb1 hq1 ha0 hα hδ
  have hsmooth := eventually_rescaled_coefficients_smooth hR ha hb hq
  have hforce := eventually_polynomial_residual_bound ha1 hb1 hq1 ha0 hα (div_pos hη hC) j
  have hcancel : C * (η / C) = η := by field_simp
  filter_upwards [hcoeff, hsmooth, hforce] with ε hsmall hs hf
  obtain ⟨w, hw, hbd, hL, hval, hder, hhess⟩ := exists_polynomial_correction α δ C hSolve
    (fun z => a (ε • z)) (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z))
    hs.1 hs.2.1 hs.2.2 hsmall.1 hsmall.2.1 hsmall.2.2 j.val (η / C) hf
  exact ⟨⟨w, hw, hbd, hL, by simpa only [hcancel] using hval,
    by simpa only [hcancel] using hder, by simpa only [hcancel] using hhess⟩⟩

def jetErrorScale (m : ℕ) : ℝ≥0 := 1 / ((m : ℝ≥0) + 1)

without_proof_info in
theorem jetErrorScale_pos (m : ℕ) : 0 < jetErrorScale m := by
  unfold jetErrorScale
  positivity

without_proof_info in
theorem tendsto_jetErrorScale :
    Tendsto (fun m => (jetErrorScale m : ℝ)) atTop (𝓝 0) := by
  simpa [jetErrorScale] using
    (tendsto_one_div_add_atTop_nhds_zero_nat :
      Tendsto (fun m : ℕ => 1 / ((m : ℝ) + 1)) atTop (𝓝 (0 : ℝ)))

without_proof_info in
theorem exists_pos_of_eventually_zero {P : ℝ → Prop}
    (h : ∀ᶠ x in 𝓝 (0 : ℝ), P x) : ∃ x, 0 < x ∧ P x := by
  have hpos : ∀ᶠ x in 𝓝[Ioi (0 : ℝ)] 0, 0 < x := self_mem_nhdsWithin
  exact (hpos.and (h.filter_mono nhdsWithin_le_nhds)).exists

without_proof_info in
/-- A finite family has corrected solutions at common positive scales, with a common error
tending to zero. The scale is chosen before the member of the family. -/
theorem exists_corrected_polynomial_sequence
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ} {α δ C : ℝ≥0}
    (hR : 0 < R) (ha : ContDiffOn ℝ ∞ a (ball 0 R))
    (hb : ContDiffOn ℝ ∞ b (ball 0 R)) (hq : ContDiffOn ℝ ∞ q (ball 0 R))
    (ha0 : a 0 = ContinuousLinearMap.id ℝ V) (hα : α ≤ 1)
    (hδ : 0 < δ) (hC : 0 < C) (hSolve : SchauderDirichletEstimate d α δ C)
    {ι : Type*} [Finite ι] (jets : ι → traceFreeFlatJetSubmodule d) :
    ∃ ε : ℕ → ℝ, (∀ m, 0 < ε m) ∧ Tendsto ε atTop (𝓝 0) ∧
      Nonempty ((m : ℕ) → (i : ι) → CorrectedPolynomial a b q (ε m) (jets i).val (jetErrorScale m)) := by
  classical
  have hchoose (m : ℕ) : ∃ ε : ℝ, 0 < ε ∧ ε ≤ jetErrorScale m ∧
      Nonempty ((i : ι) → CorrectedPolynomial a b q ε (jets i).val (jetErrorScale m)) := by
    have hfamily : ∀ᶠ ε in 𝓝 (0 : ℝ),
        ∀ i, Nonempty (CorrectedPolynomial a b q ε (jets i).val (jetErrorScale m)) :=
      Filter.eventually_all.mpr fun i => eventually_nonempty_correctedPolynomial
        hR ha hb hq ha0 hα hδ hC (jetErrorScale_pos m) hSolve (jets i)
    have hgood : ∀ᶠ ε in 𝓝 (0 : ℝ),
        ‖ε‖ < jetErrorScale m ∧
          ∀ i, Nonempty (CorrectedPolynomial a b q ε (jets i).val (jetErrorScale m)) := by
      filter_upwards [ball_mem_nhds (0 : ℝ) (show (0 : ℝ) < jetErrorScale m from jetErrorScale_pos m),
        hfamily] with ε hε hf
      exact ⟨mem_ball_zero_iff.mp hε, hf⟩
    obtain ⟨ε, hε, hbound, hf⟩ := exists_pos_of_eventually_zero hgood
    refine ⟨ε, hε, ?_, ⟨fun i => Classical.choice (hf i)⟩⟩
    exact (le_abs_self ε).trans hbound.le
  choose ε hε hbound hu using hchoose
  refine ⟨ε, hε, ?_, ⟨fun m => Classical.choice (hu m)⟩⟩
  exact squeeze_zero (fun m => (hε m).le) hbound tendsto_jetErrorScale

end ConformalPoisson

end ProofPart_CorrectedPolynomials

/- Proof support: FiniteJetStability.lean, SHA256 a0a4dd9d7e255a52d7569f2d4432532edf25093ee20a6c60eb660373790584cf -/
noncomputable section ProofPart_FiniteJetStability




/-
The finite-dimensional stability step for the small-ball jet map. Convergence on a finite
basis implies convergence in operator norm. Hence a family tending to the polynomial jet
isomorphism is invertible at one common small parameter, for every desired jet at once.
-/

open Filter
open scoped Topology

namespace ConformalPoisson

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]
  {ι : Type*} [Fintype ι]

/-- Finite-basis interpolation as a continuous linear map of the specified basis images. -/
def basisInterpolationL (b : Module.Basis ι ℝ E) : (ι → F) →L[ℝ] (E →L[ℝ] F) :=
  (LinearMap.toContinuousLinearMap.toLinearMap.comp (b.constr ℝ).toLinearMap).toContinuousLinearMap

without_proof_info in
theorem basisInterpolationL_recover (b : Module.Basis ι ℝ E) (T : E →L[ℝ] F) :
    basisInterpolationL b (fun i => T (b i)) = T := by
  apply ContinuousLinearMap.coe_injective
  apply b.ext
  intro i
  change b.constr ℝ (fun k => T (b k)) (b i) = T (b i)
  exact b.constr_basis ℝ _ i

without_proof_info in
theorem tendsto_operator_of_basis {A : Type*} {l : Filter A}
    (b : Module.Basis ι ℝ E) (T : A → E →L[ℝ] F) (T₀ : E →L[ℝ] F)
    (h : ∀ i, Tendsto (fun t => T t (b i)) l (𝓝 (T₀ (b i)))) :
    Tendsto T l (𝓝 T₀) := by
  have hvalues : Tendsto (fun t i => T t (b i)) l (𝓝 (fun i => T₀ (b i))) :=
    tendsto_pi_nhds.mpr h
  have hlim := (basisInterpolationL b).continuous.tendsto (fun i => T₀ (b i)) |>.comp hvalues
  simpa only [Function.comp_def, basisInterpolationL_recover] using hlim

without_proof_info in
theorem eventually_invertible_of_basis_tendsto {A : Type*} {l : Filter A}
    (b : Module.Basis ι ℝ E) (T : A → E →L[ℝ] F) (e : E ≃L[ℝ] F)
    (h : ∀ i, Tendsto (fun t => T t (b i)) l (𝓝 (e (b i)))) :
    ∀ᶠ t in l, (T t).IsInvertible := by
  let : CompleteSpace E := FiniteDimensional.completeSpace ℝ E
  have hlim := tendsto_operator_of_basis b T (e : E →L[ℝ] F) h
  have he : (e : E →L[ℝ] F).IsInvertible := ⟨e, rfl⟩
  exact hlim.eventually he.eventually_nhds

without_proof_info in
/-- One parameter works for all coordinates, rather than a parameter chosen after the target. -/
theorem exists_parameter_prescribing_all {A : Type*} {l : Filter A} [l.NeBot]
    (b : Module.Basis ι ℝ E) (T : A → E →L[ℝ] F) (e : E ≃L[ℝ] F)
    (h : ∀ i, Tendsto (fun t => T t (b i)) l (𝓝 (e (b i)))) :
    ∃ t, ∀ v : F, ∃! u : E, T t u = v := by
  obtain ⟨t, ht⟩ := (eventually_invertible_of_basis_tendsto b T e h).exists
  exact ⟨t, ht.bijective.existsUnique⟩

end ConformalPoisson

end ProofPart_FiniteJetStability

/- Proof support: CoordinateSolutions.lean, SHA256 63c74f359f7694729d335c9cfe84158ad139836ef09f27b367ac2fd1c4291748 -/
noncomputable section ProofPart_CoordinateSolutions




/- Local coordinate solutions form a real submodule. Their actual central jets are linear. -/

open Set Metric
open scoped NNReal ContDiff

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def coordinateSolutionSubmodule (a : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) :
    Submodule ℝ (V → ℝ) where
  carrier := {u | ContDiffOn ℝ ∞ u (ball 0 1) ∧
    ∀ z ∈ ball 0 1, coordinateSchrodinger a b q u z = 0}
  zero_mem' := by
    refine ⟨contDiffOn_const, fun z _ => ?_⟩
    simp [coordinateSchrodinger]
  add_mem' := by
    intro u v hu hv
    refine ⟨hu.1.add hv.1, fun z hz => ?_⟩
    have hu2 : ContDiffAt ℝ 2 u z := (hu.1.contDiffAt (isOpen_ball.mem_nhds hz)).of_le (by decide)
    have hv2 : ContDiffAt ℝ 2 v z := (hv.1.contDiffAt (isOpen_ball.mem_nhds hz)).of_le (by decide)
    rw [coordinateSchrodinger_add _ _ _ _ _ _ hu2 hv2, hu.2 z hz, hv.2 z hz, add_zero]
  smul_mem' := by
    intro c u hu
    refine ⟨hu.1.const_smul c, fun z hz => ?_⟩
    rw [coordinateSchrodinger_smul, hu.2 z hz, mul_zero]

def coordinateSolutionCentralJet (a : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) :
    coordinateSolutionSubmodule a b q →ₗ[ℝ] FlatJet V where
  toFun u := flatJetAt u.val 0
    ((u.property.1.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self (by norm_num)))).of_le (by decide))
  map_add' u v := flatJetAt_add _ _
  map_smul' c u := flatJetAt_smul c _

def CorrectedPolynomial.asSolution {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ}
    {ε : ℝ} {j : FlatJet V} {η : ℝ≥0} (u : CorrectedPolynomial a b q ε j η) :
    coordinateSolutionSubmodule (fun z => a (ε • z)) (fun z => ε • b (ε • z))
      (fun z => ε ^ 2 * q (ε • z)) := ⟨u.solution, u.smooth, u.homogeneous⟩

without_proof_info in
theorem CorrectedPolynomial.asSolution_centralJet {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ}
    {ε : ℝ} {j : FlatJet V} {η : ℝ≥0} (u : CorrectedPolynomial a b q ε j η) :
    coordinateSolutionCentralJet _ _ _ u.asSolution = u.centralJet := rfl

/-- The whole linear family takes values in actual homogeneous solutions. -/
def correctedSolutionFamily
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {ε : ℝ} {η : ℝ≥0}
    {ι : Type*} [Fintype ι] (basis : Module.Basis ι ℝ (traceFreeFlatJetSubmodule d))
    (u : (i : ι) → CorrectedPolynomial a b q ε (basis i).val η) :
    traceFreeFlatJetSubmodule d →ₗ[ℝ]
      coordinateSolutionSubmodule (fun z => a (ε • z)) (fun z => ε • b (ε • z))
        (fun z => ε ^ 2 * q (ε • z)) :=
  basis.constr ℝ (fun i => (u i).asSolution)

def correctedJetOperator
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {ε : ℝ} {η : ℝ≥0}
    (hd : 0 < d) {ι : Type*} [Fintype ι]
    (basis : Module.Basis ι ℝ (traceFreeFlatJetSubmodule d))
    (u : (i : ι) → CorrectedPolynomial a b q ε (basis i).val η) :
    traceFreeFlatJetSubmodule d →L[ℝ] traceFreeFlatJetSubmodule d :=
  LinearMap.toContinuousLinearMap (𝕜 := ℝ)
    (E := traceFreeFlatJetSubmodule d) (F' := traceFreeFlatJetSubmodule d)
    (((flatTraceFreeProjection d hd).comp (coordinateSolutionCentralJet _ _ _)).comp
      (correctedSolutionFamily basis u))

without_proof_info in
theorem correctedJetOperator_basis
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {ε : ℝ} {η : ℝ≥0}
    (hd : 0 < d) {ι : Type*} [Fintype ι]
    (basis : Module.Basis ι ℝ (traceFreeFlatJetSubmodule d))
    (u : (i : ι) → CorrectedPolynomial a b q ε (basis i).val η) (i : ι) :
    correctedJetOperator hd basis u (basis i) = flatTraceFreeProjection d hd (u i).centralJet := by
  change flatTraceFreeProjection d hd (coordinateSolutionCentralJet _ _ _
    (basis.constr ℝ (fun i => (u i).asSolution) (basis i))) = _
  rw [basis.constr_basis]
  rfl

without_proof_info in
theorem correctedJetOperator_apply
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {ε : ℝ} {η : ℝ≥0}
    (hd : 0 < d) {ι : Type*} [Fintype ι]
    (basis : Module.Basis ι ℝ (traceFreeFlatJetSubmodule d))
    (u : (i : ι) → CorrectedPolynomial a b q ε (basis i).val η)
    (c : traceFreeFlatJetSubmodule d) :
    correctedJetOperator hd basis u c = flatTraceFreeProjection d hd
      (coordinateSolutionCentralJet _ _ _ (correctedSolutionFamily basis u c)) := rfl

end ConformalPoisson

end ProofPart_CoordinateSolutions

/- Proof support: SurjectiveProjectedJets.lean, SHA256 04e40fed6ef4defcf2696fef4e7263fbdb4ce93d1bedfb855290aed4d4ed03c3 -/
noncomputable section ProofPart_SurjectiveProjectedJets



/-
The perturbed polynomial jet map is onto at one positive scale. The proof uses the actual
solution submodule and its actual central-jet evaluation; surjectivity is not an input.
-/

open Set Metric Filter
open scoped NNReal ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem correctedJetOperator_basis_tendsto
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {ε : ℕ → ℝ}
    (hd : 0 < d) {ι : Type*} [Fintype ι]
    (basis : Module.Basis ι ℝ (traceFreeFlatJetSubmodule d))
    (u : (m : ℕ) → (i : ι) →
      CorrectedPolynomial a b q (ε m) (basis i).val (jetErrorScale m))
    (B : ℝ) (hB : 0 ≤ B)
    (hprojection : ∀ k : FlatJet V, ‖flatTraceFreeProjection d hd k‖ ≤ B * ‖k‖) (i : ι) :
    Tendsto (fun m => correctedJetOperator hd basis (u m) (basis i)) atTop (𝓝 (basis i)) := by
  apply (tendsto_iff_norm_sub_tendsto_zero (E := traceFreeFlatJetSubmodule d)).mpr
  have herror (m : ℕ) : ‖correctedJetOperator hd basis (u m) (basis i) - basis i‖ ≤
      B * (jetErrorScale m : ℝ) := by
    simpa only [correctedJetOperator_basis, flatTraceFreeProjectionCLM_apply] using
      (u m i).projectedJet_error (basis i) hd B hB hprojection
  apply squeeze_zero
    (fun m => norm_nonneg (correctedJetOperator hd basis (u m) (basis i) - basis i)) herror
  simpa only [mul_zero] using tendsto_jetErrorScale.const_mul B

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_scale_surjective_projectedJets
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ} {α δ C : ℝ≥0}
    (hd : 0 < d) (hR : 0 < R) (ha : ContDiffOn ℝ ∞ a (ball 0 R))
    (hb : ContDiffOn ℝ ∞ b (ball 0 R)) (hq : ContDiffOn ℝ ∞ q (ball 0 R))
    (ha0 : a 0 = ContinuousLinearMap.id ℝ V) (hα : α ≤ 1)
    (hδ : 0 < δ) (hC : 0 < C) (hSolve : SchauderDirichletEstimate d α δ C) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ j : traceFreeFlatJetSubmodule d,
      ∃ u : coordinateSolutionSubmodule (fun z => a (ε • z))
          (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z)),
        flatTraceFreeProjection d hd (coordinateSolutionCentralJet _ _ _ u) = j := by
  classical
  let : Module.Free ℝ (traceFreeFlatJetSubmodule d) :=
    Module.Free.of_divisionRing ℝ (traceFreeFlatJetSubmodule d)
  let basis := Module.finBasis ℝ (traceFreeFlatJetSubmodule d)
  obtain ⟨ε, hε, _hεlim, ⟨u⟩⟩ := exists_corrected_polynomial_sequence
    hR ha hb hq ha0 hα hδ hC hSolve basis
  obtain ⟨B, hB, hprojection⟩ := exists_flatTraceFreeProjection_bound d hd
  let T : ℕ → (traceFreeFlatJetSubmodule d →L[ℝ] traceFreeFlatJetSubmodule d) :=
    fun m => correctedJetOperator hd basis (u m)
  have hBasis : ∀ i, Tendsto (fun m => T m (basis i)) atTop (𝓝 (basis i)) := by
    intro i
    exact correctedJetOperator_basis_tendsto hd basis u B hB.le hprojection i
  obtain ⟨m, hm⟩ := exists_parameter_prescribing_all
    (E := traceFreeFlatJetSubmodule d) (F := traceFreeFlatJetSubmodule d) basis T
    (ContinuousLinearEquiv.refl ℝ (traceFreeFlatJetSubmodule d)) hBasis
  refine ⟨ε m, hε m, fun j => ?_⟩
  obtain ⟨c, hc, _⟩ := hm j
  exact ⟨correctedSolutionFamily basis (u m) c,
    by simpa only [T, correctedJetOperator_apply] using hc⟩

end ConformalPoisson

end ProofPart_SurjectiveProjectedJets

/- Proof support: FlatJetEquation.lean, SHA256 60e098e4e91acf0d750b720447aaf7b927780073bf0a7e0065b4b241ef4935cb -/
noncomputable section ProofPart_FlatJetEquation



/-
The coordinate equation at a point where the principal coefficient is the identity. The trace
is fixed by the value and covector. Thus the trace-free projection is injective on compatible
jets. The equation also intertwines with the actual value/gradient/Hessian rescaling.
-/

open Set Metric
open scoped NNReal ContDiff

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def flatCoordinateJetEquation (b₀ : V) (q₀ : ℝ) : FlatJet V →ₗ[ℝ] ℝ where
  toFun j := -flatJetTrace j + j.2.1 b₀ + q₀ * j.1
  map_add' j k := by
    change -flatJetTrace (j + k) + (j.2.1 + k.2.1) b₀ + q₀ * (j.1 + k.1) = _
    rw [map_add]
    simp only [add_apply]
    ring
  map_smul' c j := by
    change -flatJetTrace (c • j) + (c • j.2.1) b₀ + q₀ * (c * j.1) = _
    rw [map_smul]
    simp only [smul_apply, smul_eq_mul, RingHom.id_apply]
    ring

without_proof_info in
theorem flatCoordinateJetEquation_flatJetAt
    {a : V → V →L[ℝ] V} (b : V → V) (q u : V → ℝ)
    (ha₀ : a 0 = ContinuousLinearMap.id ℝ V) (hu : ContDiffAt ℝ 2 u 0) :
    flatCoordinateJetEquation (b 0) (q 0) (flatJetAt u 0 hu) = coordinateSchrodinger a b q u 0 := by
  change -(∑ i, fderiv ℝ (fderiv ℝ u) 0 (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)) +
      fderiv ℝ u 0 (b 0) + q 0 * u 0 =
    -(∑ i, fderiv ℝ (fderiv ℝ u) 0 (EuclideanSpace.single i 1) (a 0 (EuclideanSpace.single i 1))) +
      fderiv ℝ u 0 (b 0) + q 0 * u 0
  rw [ha₀]
  rfl

without_proof_info in
theorem coordinateSolutionCentralJet_equation
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ}
    (ha₀ : a 0 = ContinuousLinearMap.id ℝ V) (u : coordinateSolutionSubmodule a b q) :
    flatCoordinateJetEquation (b 0) (q 0) (coordinateSolutionCentralJet a b q u) = 0 := by
  rw [show flatCoordinateJetEquation (b 0) (q 0) (coordinateSolutionCentralJet a b q u) =
    coordinateSchrodinger a b q u.val 0 from flatCoordinateJetEquation_flatJetAt b q u.val ha₀
      ((u.property.1.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self (by norm_num)))).of_le (by decide))]
  exact u.property.2 0 (mem_ball_self (by norm_num))

without_proof_info in
theorem flatTraceFreeProjection_inj_on_equation (hd : 0 < d) (b₀ : V) (q₀ : ℝ)
    {j k : FlatJet V} (hj : flatCoordinateJetEquation b₀ q₀ j = 0)
    (hk : flatCoordinateJetEquation b₀ q₀ k = 0)
    (hproj : flatTraceFreeProjection d hd j = flatTraceFreeProjection d hd k) : j = k := by
  have hv : j.1 = k.1 := by
    simpa only [flatTraceFreeProjection_value] using congrArg
      (fun p : traceFreeFlatJetSubmodule d => p.val.1) hproj
  have hD : j.2.1 = k.2.1 := by
    simpa only [flatTraceFreeProjection_covector] using congrArg
      (fun p : traceFreeFlatJetSubmodule d => p.val.2.1) hproj
  have hj' : -flatJetTrace j + j.2.1 b₀ + q₀ * j.1 = 0 := hj
  have hk' : -flatJetTrace k + k.2.1 b₀ + q₀ * k.1 = 0 := hk
  have htr : flatJetTrace j = flatJetTrace k := by
    rw [hv, hD] at hj'
    linarith
  have hraw := congrArg (fun p : traceFreeFlatJetSubmodule d => p.val) hproj
  change j - scalarHessianJet d ((d : ℝ)⁻¹ * flatJetTrace j) =
    k - scalarHessianJet d ((d : ℝ)⁻¹ * flatJetTrace k) at hraw
  rw [htr] at hraw
  simpa only [sub_add_cancel] using congrArg
    (fun p => p + scalarHessianJet d ((d : ℝ)⁻¹ * flatJetTrace k)) hraw

def scaledFlatJet (ε : ℝ) : FlatJet V →ₗ[ℝ] FlatJet V where
  toFun j := ⟨j.1, ε • j.2.1, ε ^ 2 • j.2.2⟩
  map_add' j k := by
    refine Prod.ext rfl (Prod.ext ?_ ?_)
    · exact smul_add ε j.2.1 k.2.1
    · exact smul_add (ε ^ 2) j.2.2 k.2.2
  map_smul' c j := by
    refine Prod.ext rfl (Prod.ext ?_ ?_)
    · exact smul_comm ε c j.2.1
    · exact smul_comm (ε ^ 2) c j.2.2

without_proof_info in
theorem flatJetTrace_scaledFlatJet (ε : ℝ) (j : FlatJet V) :
    flatJetTrace (scaledFlatJet ε j) = ε ^ 2 * flatJetTrace j := by
  change (∑ i, ε ^ 2 * j.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)) =
    ε ^ 2 * ∑ i, j.2.2.val (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)
  exact (Finset.mul_sum _ _ _).symm

without_proof_info in
theorem flatCoordinateJetEquation_scaledFlatJet (ε : ℝ) (b₀ : V) (q₀ : ℝ) (j : FlatJet V) :
    flatCoordinateJetEquation (ε • b₀) (ε ^ 2 * q₀) (scaledFlatJet ε j) =
      ε ^ 2 * flatCoordinateJetEquation b₀ q₀ j := by
  change -flatJetTrace (scaledFlatJet ε j) + (ε • j.2.1) (ε • b₀) + (ε ^ 2 * q₀) * j.1 =
    ε ^ 2 * (-flatJetTrace j + j.2.1 b₀ + q₀ * j.1)
  rw [flatJetTrace_scaledFlatJet]
  simp only [smul_apply, map_smul, smul_eq_mul]
  ring

without_proof_info in
theorem scaledFlatJet_comp (c e : ℝ) (j : FlatJet V) :
    scaledFlatJet c (scaledFlatJet e j) = scaledFlatJet (c * e) j := by
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact smul_smul c e j.2.1
  · change c ^ 2 • (e ^ 2 • j.2.2) = (c * e) ^ 2 • j.2.2
    rw [smul_smul, mul_pow]

without_proof_info in
theorem scaledFlatJet_one (j : FlatJet V) : scaledFlatJet 1 j = j := by
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact one_smul ℝ j.2.1
  · change (1 : ℝ) ^ 2 • j.2.2 = j.2.2
    simp

end ConformalPoisson

end ProofPart_FlatJetEquation

/- Proof support: RescaledJetRealization.lean, SHA256 77769259a27df1b7c4d55c884a270b9bcc7cd8be254d292208f6a62ee26f6adb -/
noncomputable section ProofPart_RescaledJetRealization




/-
Exact full compatible jets for the rescaled equation. A single scale works for every target.
The trace-free jet is supplied by the proved perturbed polynomial map. The homogeneous
equation then fixes the remaining trace, so no full-jet realization premise is used.
-/

open Set Metric
open scoped NNReal ContDiff

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem exists_scale_realizing_scaled_compatible_jets
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ} {α δ C : ℝ≥0}
    (hd : 0 < d) (hR : 0 < R) (ha : ContDiffOn ℝ ∞ a (ball 0 R))
    (hb : ContDiffOn ℝ ∞ b (ball 0 R)) (hq : ContDiffOn ℝ ∞ q (ball 0 R))
    (ha0 : a 0 = ContinuousLinearMap.id ℝ V) (hα : α ≤ 1)
    (hδ : 0 < δ) (hC : 0 < C) (hSolve : SchauderDirichletEstimate d α δ C) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ j : FlatJet V,
      flatCoordinateJetEquation (b 0) (q 0) j = 0 →
      ∃ u : coordinateSolutionSubmodule (fun z => a (ε • z))
          (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z)),
        coordinateSolutionCentralJet _ _ _ u = scaledFlatJet ε j := by
  obtain ⟨ε, hε, hsurj⟩ := exists_scale_surjective_projectedJets
    hd hR ha hb hq ha0 hα hδ hC hSolve
  refine ⟨ε, hε, fun j hj => ?_⟩
  obtain ⟨u, hu⟩ := hsurj (flatTraceFreeProjection d hd (scaledFlatJet ε j))
  refine ⟨u, ?_⟩
  apply flatTraceFreeProjection_inj_on_equation hd (ε • b 0) (ε ^ 2 * q 0)
  · have haε : (fun z => a (ε • z)) (0 : V) = ContinuousLinearMap.id ℝ V := by
      simpa only [smul_zero] using ha0
    have hEq := coordinateSolutionCentralJet_equation
      (b := fun z => ε • b (ε • z)) (q := fun z => ε ^ 2 * q (ε • z)) haε u
    simpa only [smul_zero] using hEq
  · rw [flatCoordinateJetEquation_scaledFlatJet, hj, mul_zero]
  · exact hu

without_proof_info in
/-- The only analytical input in this coordinate construction is the approved local forward
Schauder theorem, instantiated at exponent one half. -/
theorem exists_scale_realizing_scaled_jets_of_localSchauder
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ}
    (hSchauder : LocalSchauderDirichletAssumption d) (hd : 0 < d) (hR : 0 < R)
    (ha : ContDiffOn ℝ ∞ a (ball 0 R)) (hb : ContDiffOn ℝ ∞ b (ball 0 R))
    (hq : ContDiffOn ℝ ∞ q (ball 0 R)) (ha0 : a 0 = ContinuousLinearMap.id ℝ V) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ j : FlatJet V,
      flatCoordinateJetEquation (b 0) (q 0) j = 0 →
      ∃ u : coordinateSolutionSubmodule (fun z => a (ε • z))
          (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z)),
        coordinateSolutionCentralJet _ _ _ u = scaledFlatJet ε j := by
  obtain ⟨δ, C, hδ, hC, hSolve⟩ := hSchauder hd (1 / 2) (by norm_num) (by norm_num)
  exact exists_scale_realizing_scaled_compatible_jets hd hR ha hb hq ha0
    (by norm_num : (1 / 2 : ℝ≥0) ≤ 1) hδ hC hSolve

end ConformalPoisson

end ProofPart_RescaledJetRealization

/- Proof support: CoordinateJetRealization.lean, SHA256 c9516ffca6c4b2fa57957cb4e6726f3c365927cb71a8e3dcd6c8e7100977609b -/
noncomputable section ProofPart_CoordinateJetRealization




/-
Scaling back gives actual local homogeneous solutions with every compatible second jet for
a smooth coordinate operator whose principal coefficient is the identity at the center.
This proves the coordinate version of the local producer, using only the forward Schauder input.
-/

open Set Metric
open scoped NNReal ContDiff

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

without_proof_info in
theorem secondFDeriv_comp_smul (c : ℝ) (u : E → ℝ) (x : E) :
    fderiv ℝ (fderiv ℝ (fun y => u (c • y))) x =
      c ^ 2 • fderiv ℝ (fderiv ℝ u) (c • x) := by
  have hfirst : fderiv ℝ (fun y => u (c • y)) = fun z => c • fderiv ℝ u (c • z) :=
    funext fun z => fderiv_comp_smul c
  rw [hfirst]
  change fderiv ℝ (c • (fun z => fderiv ℝ u (c • z))) x = _
  rw [fderiv_const_smul_field (𝕜 := ℝ) (R := ℝ) (f := fun z => fderiv ℝ u (c • z)) c]
  simp only [Pi.smul_apply]
  rw [fderiv_comp_smul (f := fderiv ℝ u) c]
  simp only [smul_smul, pow_two]

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem flatJetAt_comp_smul_zero (c : ℝ) (u : V → ℝ)
    (hu : ContDiffAt ℝ 2 u 0) (hv : ContDiffAt ℝ 2 (fun y => u (c • y)) 0) :
    flatJetAt (fun y => u (c • y)) 0 hv = scaledFlatJet c (flatJetAt u 0 hu) := by
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · change u (c • 0) = u 0
    rw [smul_zero]
  · change fderiv ℝ (fun y => u (c • y)) 0 = c • fderiv ℝ u 0
    rw [fderiv_comp_smul, smul_zero]
  · apply Subtype.ext
    change fderiv ℝ (fderiv ℝ (fun y => u (c • y))) 0 = c ^ 2 • fderiv ℝ (fderiv ℝ u) 0
    rw [secondFDeriv_comp_smul, smul_zero]

without_proof_info in
theorem coordinateSchrodinger_unscale
    (a : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ)
    (ε : ℝ) (hε : ε ≠ 0) (x : V) :
    coordinateSchrodinger a b q (fun y => u (ε⁻¹ • y)) x =
      ε⁻¹ ^ 2 * coordinateSchrodinger (fun z => a (ε • z))
        (fun z => ε • b (ε • z)) (fun z => ε ^ 2 * q (ε • z)) u (ε⁻¹ • x) := by
  unfold coordinateSchrodinger
  rw [secondFDeriv_comp_smul, fderiv_comp_smul]
  simp only [smul_smul, mul_inv_cancel₀ hε, one_smul, smul_apply, map_smul, smul_eq_mul,
    ← Finset.mul_sum]
  field_simp

without_proof_info in
/-- Local exact jets in ordinary normalized coordinates, with one radius for all targets. -/
theorem exists_local_coordinate_solution_with_jet
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {R : ℝ}
    (hSchauder : LocalSchauderDirichletAssumption d) (hd : 0 < d) (hR : 0 < R)
    (ha : ContDiffOn ℝ ∞ a (ball 0 R)) (hb : ContDiffOn ℝ ∞ b (ball 0 R))
    (hq : ContDiffOn ℝ ∞ q (ball 0 R)) (ha0 : a 0 = ContinuousLinearMap.id ℝ V) :
    ∃ ρ : ℝ, ∃ hρ : 0 < ρ, ∀ j : FlatJet V,
      flatCoordinateJetEquation (b 0) (q 0) j = 0 →
      ∃ v : V → ℝ, ∃ hv : ContDiffOn ℝ ∞ v (ball 0 ρ),
        (∀ x ∈ ball 0 ρ, coordinateSchrodinger a b q v x = 0) ∧
        flatJetAt v 0
          ((hv.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hρ))).of_le (by decide)) = j := by
  obtain ⟨ε, hε, hrealize⟩ := exists_scale_realizing_scaled_jets_of_localSchauder
    hSchauder hd hR ha hb hq ha0
  refine ⟨ε, hε, fun j hj => ?_⟩
  obtain ⟨u, hujet⟩ := hrealize j hj
  have hmap : MapsTo (fun x : V => ε⁻¹ • x) (ball 0 ε) (ball 0 1) := by
    intro x hx
    simp only [mem_ball_zero_iff, norm_smul, norm_inv, Real.norm_of_nonneg hε.le]
    exact (inv_mul_lt_iff₀ hε).mpr (by simpa using mem_ball_zero_iff.mp hx)
  let v : V → ℝ := fun x => u.val (ε⁻¹ • x)
  have hv : ContDiffOn ℝ ∞ v (ball 0 ε) :=
    u.property.1.comp (contDiff_const_smul ε⁻¹).contDiffOn hmap
  have hu2 : ContDiffAt ℝ 2 u.val 0 :=
    (u.property.1.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self (by norm_num)))).of_le (by decide)
  have hv2 : ContDiffAt ℝ 2 v 0 :=
    (hv.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hε))).of_le (by decide)
  refine ⟨v, hv, ?_, ?_⟩
  · intro x hx
    rw [coordinateSchrodinger_unscale a b q u.val ε hε.ne', u.property.2 _ (hmap hx), mul_zero]
  · have hjet : flatJetAt v 0 hv2 = scaledFlatJet ε⁻¹
        (coordinateSolutionCentralJet _ _ _ u) := flatJetAt_comp_smul_zero ε⁻¹ u.val hu2 hv2
    rw [hjet, hujet, scaledFlatJet_comp, inv_mul_cancel₀ hε.ne', scaledFlatJet_one]

end ConformalPoisson

end ProofPart_CoordinateJetRealization

/- Proof support: AffineJetTransport.lean, SHA256 dbfc1e598092e3808987b927c586e00783c02c74dbb0bb1d663b337634ab4ea0 -/
noncomputable section ProofPart_AffineJetTransport



/-
Actual first and second derivatives under an affine change of Euclidean
coordinates. These will center and normalize the native interior chart.
-/

open scoped ContDiff

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def affinePullback (T : E ≃L[ℝ] E) (z₀ : E) (u : E → ℝ) : E → ℝ :=
  fun x => u (z₀ + T x)

without_proof_info in
theorem fderiv_affinePullback (T : E ≃L[ℝ] E) (z₀ : E) (u : E → ℝ) (x : E) :
    fderiv ℝ (affinePullback T z₀ u) x =
      (fderiv ℝ u (z₀ + T x)).comp T.toContinuousLinearMap := by
  change fderiv ℝ ((fun z => u (z₀ + z)) ∘ T) x = _
  rw [T.comp_right_fderiv, fderiv_comp_add_left]

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
/-- Both arguments of the ordinary Hessian transform by the same linear coordinate map. -/
theorem secondFDeriv_affinePullback_apply (T : E ≃L[ℝ] E) (z₀ : E) (u : E → ℝ)
    (x v w : E) (hu : ContDiffAt ℝ 2 u (z₀ + T x)) :
    fderiv ℝ (fderiv ℝ (affinePullback T z₀ u)) x v w =
      fderiv ℝ (fderiv ℝ u) (z₀ + T x) (T v) (T w) := by
  have hψ : HasFDerivAt (fun y => z₀ + T y) T.toContinuousLinearMap x := by
    simpa only [Pi.add_def, zero_add] using (hasFDerivAt_const z₀ x).add T.hasFDerivAt
  have hDu := (hu.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  let R : (E →L[ℝ] ℝ) →L[ℝ] E →L[ℝ] ℝ :=
    (ContinuousLinearMap.compL ℝ E E ℝ).flip T.toContinuousLinearMap
  have h := R.hasFDerivAt.comp x (hDu.hasFDerivAt.comp x hψ)
  have hfirst : fderiv ℝ (affinePullback T z₀ u) =
      fun y => R (fderiv ℝ u (z₀ + T y)) :=
    funext (fderiv_affinePullback T z₀ u)
  rw [hfirst]
  simpa only [Function.comp_def, R, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.flip_apply, ContinuousLinearMap.compL_apply, ContinuousLinearEquiv.coe_coe] using
    congrArg (fun L : E →L[ℝ] E →L[ℝ] ℝ => L v w) h.fderiv

without_proof_info in
/-- The affine pullback of a smooth function is smooth on the inverse image of its domain. -/
theorem contDiffOn_affinePullback (T : E ≃L[ℝ] E) (z₀ : E) {u : E → ℝ} {U : Set E}
    (hu : ContDiffOn ℝ ∞ u U) :
    ContDiffOn ℝ ∞ (affinePullback T z₀ u) ((fun x => z₀ + T x) ⁻¹' U) :=
  hu.comp (contDiff_const.add T.contDiff).contDiffOn (fun _ hx => hx)

end ConformalPoisson

end ProofPart_AffineJetTransport

/- Proof support: MetricContraction.lean, SHA256 709a144d3e7df6686bdbef2fee36a6408cabc8d53db75d9559734219c47d2f6d -/
noncomputable section ProofPart_MetricContraction




/-
Convert contraction against an inverse coordinate metric into the principal
coefficient endomorphism used by `coordinateSchrodinger`. The coordinate basis
need not be orthonormal.
-/

open scoped BigOperators

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- Contraction of a bilinear form with an endomorphism in an orthonormal frame. -/
def principalContraction (e : OrthonormalBasis κ ℝ E) (B : E →L[ℝ] E →L[ℝ] ℝ) :
    (E →L[ℝ] E) →ₗ[ℝ] ℝ where
  toFun A := ∑ k, B (e k) (A (e k))
  map_add' A C := by simp only [add_apply, map_add, Finset.sum_add_distrib]
  map_smul' c A := by
    simp only [smul_apply, map_smul, smul_eq_mul, Finset.mul_sum, RingHom.id_apply]

without_proof_info in
theorem principalContraction_rankOne (e : OrthonormalBasis κ ℝ E)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (v w : E) :
    principalContraction e B ((innerSL ℝ v).smulRight w) = B v w := by
  change (∑ k, B (e k) (((innerSL ℝ v).smulRight w) (e k))) = B v w
  simp only [ContinuousLinearMap.smulRight_apply, innerSL_apply_apply, map_smul, smul_eq_mul]
  have h := congrArg (fun z => B z w) (e.sum_repr' v)
  simpa only [map_sum, sum_apply, map_smul, smul_apply, smul_eq_mul, real_inner_comm] using h

/-- The inverse metric tensor represented as a Euclidean principal endomorphism. -/
def inverseMetricOperator (b : ι → E) (G : Matrix ι ι ℝ) : E →L[ℝ] E :=
  ∑ i, ∑ j, G i j • (innerSL ℝ (b i)).smulRight (b j)

without_proof_info in
theorem principalContraction_inverseMetricOperator (e : OrthonormalBasis κ ℝ E)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (b : ι → E) (G : Matrix ι ι ℝ) :
    principalContraction e B (inverseMetricOperator b G) = ∑ i, ∑ j, G i j * B (b i) (b j) := by
  simp only [inverseMetricOperator, map_sum, map_smul, smul_eq_mul,
    principalContraction_rankOne]

end ConformalPoisson

end ProofPart_MetricContraction

/- Proof support: PrincipalCoordinateChange.lean, SHA256 ca6f0cbfe8a470f45a80e263a198a189e5e6f8d4b39cbd3667a93574615aa08e -/
noncomputable section ProofPart_PrincipalCoordinateChange




/-
Transformation of the actual bilinear principal contraction under an invertible
linear coordinate change. No symmetry of the test bilinear form is needed.
-/

open scoped BigOperators

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  {ι : Type*} [Fintype ι]

def bilinearPullback (T : E →L[ℝ] E) (B : E →L[ℝ] E →L[ℝ] ℝ) : E →L[ℝ] E →L[ℝ] ℝ :=
  ((ContinuousLinearMap.compL ℝ E E ℝ).flip T).comp (B.comp T)

omit [CompleteSpace E] in
without_proof_info in
@[simp] theorem bilinearPullback_apply (T : E →L[ℝ] E)
    (B : E →L[ℝ] E →L[ℝ] ℝ) (v w : E) :
    bilinearPullback T B v w = B (T v) (T w) := rfl

/-- The principal coefficient transforms by congruence with the adjoint. -/
def principalCongruence (T : E →L[ℝ] E) : (E →L[ℝ] E) →ₗ[ℝ] E →L[ℝ] E where
  toFun A := T.comp (A.comp T.adjoint)
  map_add' A C := by ext x; simp only [ContinuousLinearMap.comp_apply, add_apply, map_add]
  map_smul' c A := by ext x; simp only [ContinuousLinearMap.comp_apply, smul_apply, map_smul, RingHom.id_apply]

without_proof_info in
@[simp] theorem principalCongruence_apply (T A : E →L[ℝ] E) (x : E) :
    principalCongruence T A x = T (A (T.adjoint x)) := rfl

without_proof_info in
theorem principalCongruence_rankOne (T : E →L[ℝ] E) (v w : E) :
    principalCongruence T ((innerSL ℝ v).smulRight w) =
      (innerSL ℝ (T v)).smulRight (T w) := by
  ext x
  simp only [principalCongruence_apply, ContinuousLinearMap.smulRight_apply,
    innerSL_apply_apply, map_smul, ContinuousLinearMap.adjoint_inner_right]

omit [CompleteSpace E] in
without_proof_info in
theorem endomorphism_eq_sum_rankOne (e : OrthonormalBasis ι ℝ E) (A : E →L[ℝ] E) :
    A = ∑ i, (innerSL ℝ (e i)).smulRight (A (e i)) := by
  ext x
  have h := congrArg A (e.sum_repr' x)
  simpa only [sum_apply, ContinuousLinearMap.smulRight_apply, innerSL_apply_apply,
    map_sum, map_smul] using h.symm

without_proof_info in
theorem principalContraction_congruence (e : OrthonormalBasis ι ℝ E)
    (T A : E →L[ℝ] E) (B : E →L[ℝ] E →L[ℝ] ℝ) :
    principalContraction e (bilinearPullback T B) A =
      principalContraction e B (principalCongruence T A) := by
  symm
  calc
    principalContraction e B (principalCongruence T A) =
        principalContraction e B
          (principalCongruence T (∑ i, (innerSL ℝ (e i)).smulRight (A (e i)))) :=
      congrArg (fun C => principalContraction e B (principalCongruence T C))
        (endomorphism_eq_sum_rankOne e A)
    _ = ∑ i, B (T (e i)) (T (A (e i))) := by
      simp only [map_sum, principalCongruence_rankOne, principalContraction_rankOne]
    _ = principalContraction e (bilinearPullback T B) A := rfl

without_proof_info in
theorem principalCongruence_comp (S T A : E →L[ℝ] E) :
    principalCongruence S (principalCongruence T A) = principalCongruence (S.comp T) A := by
  ext x
  simp only [principalCongruence_apply, ContinuousLinearMap.adjoint_comp,
    ContinuousLinearMap.comp_apply]

without_proof_info in
@[simp] theorem principalCongruence_id (A : E →L[ℝ] E) :
    principalCongruence (ContinuousLinearMap.id ℝ E) A = A := by
  ext x
  simp only [principalCongruence_apply, ContinuousLinearMap.adjoint_id, ContinuousLinearMap.id_apply]

without_proof_info in
/-- Conjugating the transformed coefficient back recovers the original coefficient. -/
theorem principalCongruence_equiv_inverse (T : E ≃L[ℝ] E) (A : E →L[ℝ] E) :
    principalCongruence T.toContinuousLinearMap
        (principalCongruence T.symm.toContinuousLinearMap A) = A := by
  rw [principalCongruence_comp, T.coe_comp_coe_symm, principalCongruence_id]

end ConformalPoisson

end ProofPart_PrincipalCoordinateChange

/- Proof support: AffineCoordinateOperator.lean, SHA256 4fb772e3ae08915d947946cdb23c695d9cf430701b3599b6fdccd5ebd5da61fb -/
noncomputable section ProofPart_AffineCoordinateOperator




/-
The coordinate Schrodinger operator under the affine substitution z=z₀+Tx.
The principal, drift and potential fields are transformed with the same map.
-/

open Set
open scoped ContDiff

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def affinePrincipalCoefficient (T : V ≃L[ℝ] V) (z₀ : V) (a : V → V →L[ℝ] V) :
    V → V →L[ℝ] V :=
  fun x => principalCongruence T.symm.toContinuousLinearMap (a (z₀ + T x))

def affineDriftCoefficient (T : V ≃L[ℝ] V) (z₀ : V) (b : V → V) : V → V :=
  fun x => T.symm (b (z₀ + T x))

def affinePotentialCoefficient (T : V ≃L[ℝ] V) (z₀ : V) (q : V → ℝ) : V → ℝ :=
  fun x => q (z₀ + T x)

without_proof_info in
/-- Affine coordinate invariance with explicit transformed coefficients. -/
theorem coordinateSchrodinger_affinePullback (T : V ≃L[ℝ] V) (z₀ : V)
    (a : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ) (x : V)
    (hu : ContDiffAt ℝ 2 u (z₀ + T x)) :
    coordinateSchrodinger (affinePrincipalCoefficient T z₀ a)
        (affineDriftCoefficient T z₀ b) (affinePotentialCoefficient T z₀ q)
        (affinePullback T z₀ u) x = coordinateSchrodinger a b q u (z₀ + T x) := by
  have hsecond : fderiv ℝ (fderiv ℝ (affinePullback T z₀ u)) x =
      bilinearPullback T.toContinuousLinearMap (fderiv ℝ (fderiv ℝ u) (z₀ + T x)) := by
    ext v w
    exact secondFDeriv_affinePullback_apply T z₀ u x v w hu
  have hprincipal := principalContraction_congruence (EuclideanSpace.basisFun (Fin d) ℝ)
    T.toContinuousLinearMap (principalCongruence T.symm.toContinuousLinearMap (a (z₀ + T x)))
    (fderiv ℝ (fderiv ℝ u) (z₀ + T x))
  rw [principalCongruence_equiv_inverse] at hprincipal
  simp only [principalContraction, LinearMap.coe_mk, AddHom.coe_mk,
    EuclideanSpace.basisFun_apply] at hprincipal
  unfold coordinateSchrodinger affinePrincipalCoefficient affineDriftCoefficient
    affinePotentialCoefficient
  rw [hsecond, hprincipal, fderiv_affinePullback]
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
    ContinuousLinearEquiv.apply_symm_apply, affinePullback]

without_proof_info in
theorem affinePrincipalCoefficient_normalized (T : V ≃L[ℝ] V) (z₀ : V)
    (a : V → V →L[ℝ] V)
    (h : principalCongruence T.symm.toContinuousLinearMap (a z₀) = ContinuousLinearMap.id ℝ V) :
    affinePrincipalCoefficient T z₀ a 0 = ContinuousLinearMap.id ℝ V := by
  simpa only [affinePrincipalCoefficient, map_zero, add_zero] using h

without_proof_info in
theorem contDiffOn_affinePrincipalCoefficient (T : V ≃L[ℝ] V) (z₀ : V)
    {a : V → V →L[ℝ] V} {U : Set V} (ha : ContDiffOn ℝ ∞ a U) :
    ContDiffOn ℝ ∞ (affinePrincipalCoefficient T z₀ a) ((fun x => z₀ + T x) ⁻¹' U) := by
  have ha' : ContDiffOn ℝ ∞ (fun x => a (z₀ + T x)) ((fun x => z₀ + T x) ⁻¹' U) :=
    ha.comp (contDiff_const.add T.contDiff).contDiffOn (fun _ hx => hx)
  change ContDiffOn ℝ ∞
    (fun x => T.symm.toContinuousLinearMap.comp
      ((a (z₀ + T x)).comp T.symm.toContinuousLinearMap.adjoint)) _
  exact contDiffOn_const.clm_comp (ha'.clm_comp contDiffOn_const)

without_proof_info in
theorem contDiffOn_affineDriftCoefficient (T : V ≃L[ℝ] V) (z₀ : V)
    {b : V → V} {U : Set V} (hb : ContDiffOn ℝ ∞ b U) :
    ContDiffOn ℝ ∞ (affineDriftCoefficient T z₀ b) ((fun x => z₀ + T x) ⁻¹' U) := by
  have hb' : ContDiffOn ℝ ∞ (fun x => b (z₀ + T x)) ((fun x => z₀ + T x) ⁻¹' U) :=
    hb.comp (contDiff_const.add T.contDiff).contDiffOn (fun _ hx => hx)
  exact T.symm.contDiff.comp_contDiffOn hb'

without_proof_info in
theorem contDiffOn_affinePotentialCoefficient (T : V ≃L[ℝ] V) (z₀ : V)
    {q : V → ℝ} {U : Set V} (hq : ContDiffOn ℝ ∞ q U) :
    ContDiffOn ℝ ∞ (affinePotentialCoefficient T z₀ q) ((fun x => z₀ + T x) ⁻¹' U) :=
  hq.comp (contDiff_const.add T.contDiff).contDiffOn (fun _ hx => hx)

end ConformalPoisson

end ProofPart_AffineCoordinateOperator

/- Proof support: AffineFlatJets.lean, SHA256 877f6df241bdc66bff3668d99345435ab6b9186befcf4a374268d77cdabf00c1 -/
noncomputable section ProofPart_AffineFlatJets



/-
The same affine map transports the value, covector and ordinary Hessian of a jet.
The equation compatibility condition transforms with the actual principal and drift.
-/

open scoped BigOperators ContDiff

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def affineFlatJet (T : V ≃L[ℝ] V) : FlatJet V →ₗ[ℝ] FlatJet V where
  toFun j := ⟨j.1, j.2.1.comp T.toContinuousLinearMap,
    ⟨bilinearPullback T.toContinuousLinearMap j.2.2.val, fun v w => j.2.2.property (T v) (T w)⟩⟩
  map_add' j k := by
    refine Prod.ext rfl (Prod.ext ?_ ?_)
    · change (j.2.1 + k.2.1).comp T.toContinuousLinearMap =
        j.2.1.comp T.toContinuousLinearMap + k.2.1.comp T.toContinuousLinearMap
      ext v
      simp only [ContinuousLinearMap.comp_apply, add_apply]
    · apply Subtype.ext
      change bilinearPullback T.toContinuousLinearMap (j.2.2.val + k.2.2.val) =
        bilinearPullback T.toContinuousLinearMap j.2.2.val + bilinearPullback T.toContinuousLinearMap k.2.2.val
      ext v w
      simp only [bilinearPullback_apply, add_apply]
  map_smul' c j := by
    refine Prod.ext rfl (Prod.ext ?_ ?_)
    · change (c • j.2.1).comp T.toContinuousLinearMap = c • j.2.1.comp T.toContinuousLinearMap
      ext v
      simp only [ContinuousLinearMap.comp_apply, smul_apply]
    · apply Subtype.ext
      change bilinearPullback T.toContinuousLinearMap (c • j.2.2.val) =
        c • bilinearPullback T.toContinuousLinearMap j.2.2.val
      ext v w
      simp only [bilinearPullback_apply, smul_apply]

without_proof_info in
@[simp] theorem affineFlatJet_value (T : V ≃L[ℝ] V) (j : FlatJet V) :
    (affineFlatJet T j).1 = j.1 := rfl

without_proof_info in
@[simp] theorem affineFlatJet_covector (T : V ≃L[ℝ] V) (j : FlatJet V) (v : V) :
    (affineFlatJet T j).2.1 v = j.2.1 (T v) := rfl

without_proof_info in
@[simp] theorem affineFlatJet_hessian (T : V ≃L[ℝ] V) (j : FlatJet V) (v w : V) :
    (affineFlatJet T j).2.2.val v w = j.2.2.val (T v) (T w) := rfl

without_proof_info in
theorem affineFlatJet_inverse (T : V ≃L[ℝ] V) (j : FlatJet V) :
    affineFlatJet T.symm (affineFlatJet T j) = j := by
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · ext v
    simp only [affineFlatJet_covector, ContinuousLinearEquiv.apply_symm_apply]
  · apply Subtype.ext
    ext v w
    simp only [affineFlatJet_hessian, ContinuousLinearEquiv.apply_symm_apply]

without_proof_info in
/-- This is the actual affine transformation of the derivatives of a smooth function. -/
theorem flatJetAt_affinePullback (T : V ≃L[ℝ] V) (z₀ : V) (u : V → ℝ) (x : V)
    (hu : ContDiffAt ℝ 2 u (z₀ + T x))
    (hv : ContDiffAt ℝ 2 (affinePullback T z₀ u) x) :
    flatJetAt (affinePullback T z₀ u) x hv = affineFlatJet T (flatJetAt u (z₀ + T x) hu) := by
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact fderiv_affinePullback T z₀ u x
  · apply Subtype.ext
    ext v w
    exact secondFDeriv_affinePullback_apply T z₀ u x v w hu

/-- The pointwise equation functional before normalizing the principal coefficient. -/
def coordinateJetEquation (a₀ : V →L[ℝ] V) (b₀ : V) (q₀ : ℝ) : FlatJet V →ₗ[ℝ] ℝ where
  toFun j := -(∑ i, j.2.2.val (EuclideanSpace.single i 1) (a₀ (EuclideanSpace.single i 1))) +
    j.2.1 b₀ + q₀ * j.1
  map_add' j k := by
    change -(∑ i, (j.2.2.val + k.2.2.val) (EuclideanSpace.single i 1)
      (a₀ (EuclideanSpace.single i 1))) + (j.2.1 + k.2.1) b₀ + q₀ * (j.1 + k.1) = _
    simp only [add_apply, Finset.sum_add_distrib]
    ring
  map_smul' c j := by
    change -(∑ i, (c • j.2.2.val) (EuclideanSpace.single i 1)
      (a₀ (EuclideanSpace.single i 1))) + (c • j.2.1) b₀ + q₀ * (c * j.1) = _
    simp only [smul_apply, smul_eq_mul, ← Finset.mul_sum, RingHom.id_apply]
    ring

without_proof_info in
theorem coordinateJetEquation_id (b₀ : V) (q₀ : ℝ) (j : FlatJet V) :
    coordinateJetEquation (ContinuousLinearMap.id ℝ V) b₀ q₀ j =
      flatCoordinateJetEquation b₀ q₀ j := rfl

without_proof_info in
theorem coordinateJetEquation_affineFlatJet (T : V ≃L[ℝ] V)
    (a₀ : V →L[ℝ] V) (b₀ : V) (q₀ : ℝ) (j : FlatJet V) :
    coordinateJetEquation (principalCongruence T.symm.toContinuousLinearMap a₀)
        (T.symm b₀) q₀ (affineFlatJet T j) = coordinateJetEquation a₀ b₀ q₀ j := by
  have hprincipal := principalContraction_congruence (EuclideanSpace.basisFun (Fin d) ℝ)
    T.toContinuousLinearMap (principalCongruence T.symm.toContinuousLinearMap a₀) j.2.2.val
  rw [principalCongruence_equiv_inverse] at hprincipal
  simp only [principalContraction, LinearMap.coe_mk, AddHom.coe_mk,
    EuclideanSpace.basisFun_apply] at hprincipal
  change -(∑ i, bilinearPullback T.toContinuousLinearMap j.2.2.val
      (EuclideanSpace.single i 1)
      (principalCongruence T.symm.toContinuousLinearMap a₀ (EuclideanSpace.single i 1))) +
    j.2.1 (T (T.symm b₀)) + q₀ * j.1 = _
  rw [hprincipal, T.apply_symm_apply]
  rfl

end ConformalPoisson

end ProofPart_AffineFlatJets

/- Proof support: CovariantJetCoordinates.lean, SHA256 764650acbc8e71b9efc64dfe26fb390c8b63a836118ae1e88413113976a59d19 -/
noncomputable section ProofPart_CovariantJetCoordinates



/-
Convert a metric-raised Hessian to the ordinary Hessian in a chart. The ordinary
second derivative is the lowered covariant Hessian plus the Christoffel correction.
This is finite-dimensional tensor algebra, without an elliptic existence premise.
-/

namespace ConformalPoisson

variable {E W : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W]

def loweredHessianCoordinates (D : E ≃L[ℝ] W) (A : W →L[ℝ] W) :
    E →L[ℝ] E →L[ℝ] ℝ :=
  ((ContinuousLinearMap.compL ℝ E W ℝ).flip D.toContinuousLinearMap).comp
    (((innerSL ℝ).comp A).comp D.toContinuousLinearMap)

without_proof_info in
@[simp] theorem loweredHessianCoordinates_apply (D : E ≃L[ℝ] W)
    (A : W →L[ℝ] W) (v w : E) :
    loweredHessianCoordinates D A v w = inner ℝ (A (D v)) (D w) := rfl

def connectionJetHessian (D : E ≃L[ℝ] W) (Γ : E →L[ℝ] E →L[ℝ] E)
    (ξ : W →L[ℝ] ℝ) (A : W →L[ℝ] W) : E →L[ℝ] E →L[ℝ] ℝ :=
  loweredHessianCoordinates D A +
    (ContinuousLinearMap.compL ℝ E E ℝ (ξ.comp D.toContinuousLinearMap)).comp Γ

without_proof_info in
@[simp] theorem connectionJetHessian_apply (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) (ξ : W →L[ℝ] ℝ) (A : W →L[ℝ] W) (v w : E) :
    connectionJetHessian D Γ ξ A v w = inner ℝ (A (D v)) (D w) + ξ (D (Γ v w)) := rfl

without_proof_info in
theorem connectionJetHessian_symmetric (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) (hΓ : ∀ v w, Γ v w = Γ w v)
    (ξ : W →L[ℝ] ℝ) (A : W →L[ℝ] W)
    (hA : ∀ v w, inner ℝ (A v) w = inner ℝ v (A w)) :
    connectionJetHessian D Γ ξ A ∈ symmetricBilinearSubmodule E := by
  intro v w
  simp only [connectionJetHessian_apply]
  rw [hA (D v) (D w), real_inner_comm (D v) (A (D w)), hΓ v w]

/-- The ordinary jet corresponding to a native value, covector and self-adjoint raised Hessian. -/
def covariantJetCoordinates (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) (hΓ : ∀ v w, Γ v w = Γ w v)
    (a : ℝ) (ξ : W →L[ℝ] ℝ) (A : W →L[ℝ] W)
    (hA : ∀ v w, inner ℝ (A v) w = inner ℝ v (A w)) : FlatJet E :=
  ⟨a, ξ.comp D.toContinuousLinearMap,
    ⟨connectionJetHessian D Γ ξ A, connectionJetHessian_symmetric D Γ hΓ ξ A hA⟩⟩

without_proof_info in
@[simp] theorem covariantJetCoordinates_value (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) (hΓ : ∀ v w, Γ v w = Γ w v)
    (a : ℝ) (ξ : W →L[ℝ] ℝ) (A : W →L[ℝ] W)
    (hA : ∀ v w, inner ℝ (A v) w = inner ℝ v (A w)) :
    (covariantJetCoordinates D Γ hΓ a ξ A hA).1 = a := rfl

without_proof_info in
@[simp] theorem covariantJetCoordinates_covector (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) (hΓ : ∀ v w, Γ v w = Γ w v)
    (a : ℝ) (ξ : W →L[ℝ] ℝ) (A : W →L[ℝ] W)
    (hA : ∀ v w, inner ℝ (A v) w = inner ℝ v (A w)) (v : E) :
    (covariantJetCoordinates D Γ hΓ a ξ A hA).2.1 v = ξ (D v) := rfl

without_proof_info in
/-- Every native direction is tested: equality of coordinate pairings recovers the raised tensor. -/
theorem raisedHessian_eq_of_coordinates (D : E ≃L[ℝ] W) {A B : W →L[ℝ] W}
    (h : ∀ v w, inner ℝ (A (D v)) (D w) = inner ℝ (B (D v)) (D w)) : A = B := by
  ext v
  apply ext_inner_right ℝ
  intro w
  simpa only [D.apply_symm_apply] using h (D.symm v) (D.symm w)

without_proof_info in
theorem covector_eq_of_coordinates (D : E ≃L[ℝ] W) {ξ η : W →L[ℝ] ℝ}
    (h : ∀ v, ξ (D v) = η (D v)) : ξ = η := by
  ext v
  simpa only [D.apply_symm_apply] using h (D.symm v)

end ConformalPoisson

end ProofPart_CovariantJetCoordinates

/- Proof support: InteriorChartHessian.lean, SHA256 75810270074d0aabff633d1ad56e2a0b0cb5e62c3177c314f6d99007df239df4 -/
noncomputable section ProofPart_InteriorChartHessian




/-
The actual native Levi-Civita Christoffel map in a fixed interior chart. This gives
the coordinate correction to an ordinary second derivative, with no geometric
comparison assumed as a literature input.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]

without_proof_info in
theorem chartInverseVector_eventuallyEq_symm (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source) (w : E) :
    ∀ᶠ z in 𝓝 y, (trivializationAt E (TangentSpace I) α).symmL ℝ z w =
      (trivializationAt E (TangentSpace I) α).symm z w := by
  let e := trivializationAt E (TangentSpace I) α
  have hbase : y ∈ e.baseSet := by simpa [e] using hy
  filter_upwards [e.open_baseSet.mem_nhds hbase] with z hz
  exact e.symmL_apply hz w

variable [FiniteDimensional ℝ E]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 E (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 E (TangentSpace I : M → Type _) I]

/-- The Christoffel bilinear map of the native Levi-Civita connection. The first argument
is the coordinate value of a field; the second is its direction of differentiation. -/
def chartLeviCivitaMap (α y : M) : E →L[ℝ] E →L[ℝ] E :=
  TauCeti.Manifold.christoffelMap (Module.finBasis ℝ E)
    ((CovariantDerivative.leviCivitaConnection I M).isCovariantDerivativeOn
      (s := (trivializationAt E (TangentSpace I) α).baseSet)) y

without_proof_info in
theorem contMDiffOn_chartLeviCivitaMap {k m r : ℕ∞ω} [IsManifold I m M]
    [IsContMDiffRiemannianBundle I r E (fun y : M => TangentSpace I y)]
    (α : M) (hm : k + 2 ≤ m) (hg : k + 1 ≤ r) :
    ContMDiffOn I 𝓘(ℝ, E →L[ℝ] E →L[ℝ] E) k (chartLeviCivitaMap (I := I) α)
      (trivializationAt E (TangentSpace I) α).baseSet :=
  CovariantDerivative.contMDiffOn_christoffelMap_leviCivitaConnection
    (Module.finBasis ℝ E) hm hg

without_proof_info in
theorem chartLeviCivitaMap_comm (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source) (v w : E) :
    chartLeviCivitaMap (I := I) α y v w = chartLeviCivitaMap (I := I) α y w v := by
  let : IsManifold I (minSmoothness ℝ 2) M := by
    simpa only [minSmoothness_of_isRCLikeNormedField] using (inferInstance : IsManifold I 2 M)
  have ht : (CovariantDerivative.leviCivitaConnection I M).IsTorsionFree :=
    (CovariantDerivative.isTorsionFree_iff_torsion_eq_zero _).mpr
      (CovariantDerivative.isLeviCivitaConnection_leviCivitaConnection I).torsion
  exact TauCeti.Manifold.christoffelMap_comm ht (Module.finBasis ℝ E) α
    (by rwa [extChartAt_source]) v w

without_proof_info in
theorem covariantDerivative_chartConstantVector (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source) (v w : E) :
    CovariantDerivative.leviCivitaConnection I M
        (fun z => (trivializationAt E (TangentSpace I) α).symmL ℝ z w) y
        ((trivializationAt E (TangentSpace I) α).symmL ℝ y v) =
      (trivializationAt E (TangentSpace I) α).symmL ℝ y
        (chartLeviCivitaMap (I := I) α y w v) := by
  let e := trivializationAt E (TangentSpace I) α
  have hbase : y ∈ e.baseSet := by simpa [e] using hy
  have hfield := chartInverseVector_eventuallyEq_symm (I := I) α hy w
  have hlin := mdifferentiableAt_chartConstantVector (I := I) α hy w
  have hraw : MDifferentiableAt I I.tangent
      (fun z => (⟨z, e.symm z w⟩ : TangentBundle I M)) y :=
    hlin.congr_of_eventuallyEq (hfield.mono fun z hz => congrArg (TotalSpace.mk' E z) hz.symm)
  have hcov := (CovariantDerivative.leviCivitaConnection I M).isCovariantDerivativeOnUniv
  rw [hcov.congr_of_eventuallyEq hlin hraw Filter.univ_mem hfield,
    e.symmL_apply hbase, e.symmL_apply hbase]
  exact TauCeti.Manifold.covariantDerivative_symm_apply_symm (Module.finBasis ℝ E)
    ((CovariantDerivative.leviCivitaConnection I M).isCovariantDerivativeOn
      (s := (trivializationAt E (TangentSpace I) α).baseSet)) (by simpa [e] using hy) w v

without_proof_info in
/-- The native Hessian is the ordinary coordinate Hessian minus the Christoffel correction. -/
theorem hessian_fixedChart_christoffel (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source)
    (hint : extChartAt I α y ∈ interior (extChartAt I α).target)
    {f : M → ℝ} (hf : ContMDiffAt I 𝓘(ℝ) 2 f y) (v w : E) :
    TauCeti.Manifold.hessian I f y
        ((trivializationAt E (TangentSpace I) α).symmL ℝ y v)
        ((trivializationAt E (TangentSpace I) α).symmL ℝ y w) =
      fderiv ℝ (fderiv ℝ (f ∘ (extChartAt I α).symm)) (extChartAt I α y) v w -
        fderiv ℝ (f ∘ (extChartAt I α).symm) (extChartAt I α y)
          (chartLeviCivitaMap (I := I) α y v w) := by
  rw [hessian_fixedChart α hy hint hf v w, covariantDerivative_chartConstantVector α hy,
    mvfderiv_inverseChart_vector α hy hint (hf.mdifferentiableAt (by norm_num)),
    chartLeviCivitaMap_comm α hy w v]

end ConformalPoisson

end ProofPart_InteriorChartHessian

/- Proof support: ChartFunctionJets.lean, SHA256 402b6aaa0e29f90d1fbb37d9f4f8b46a1742a765c10adb08f73cf4b3f026fb24 -/
noncomputable section ProofPart_ChartFunctionJets




/-
Pulling an ordinary coordinate function back to a native chart, including the
germ comparison needed to identify its actual first and second derivatives.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]

def chartFunction (α : M) (P : E → ℝ) : M → ℝ := P ∘ extChartAt I α

without_proof_info in
theorem chartFunction_read_eventually (α : M) (P : E → ℝ) {z : E}
    (hz : z ∈ interior (extChartAt I α).target) :
    (chartFunction (I := I) α P ∘ (extChartAt I α).symm) =ᶠ[𝓝 z] P := by
  filter_upwards [isOpen_interior.mem_nhds hz] with w hw
  change P (extChartAt I α ((extChartAt I α).symm w)) = P w
  rw [(extChartAt I α).right_inv (interior_subset hw)]

without_proof_info in
theorem chartFunction_read_fderiv (α : M) (P : E → ℝ) {z : E}
    (hz : z ∈ interior (extChartAt I α).target) :
    fderiv ℝ (chartFunction (I := I) α P ∘ (extChartAt I α).symm) z = fderiv ℝ P z :=
  (chartFunction_read_eventually α P hz).fderiv_eq

without_proof_info in
theorem chartFunction_read_secondFDeriv (α : M) (P : E → ℝ) {z : E}
    (hz : z ∈ interior (extChartAt I α).target) :
    fderiv ℝ (fderiv ℝ (chartFunction (I := I) α P ∘ (extChartAt I α).symm)) z =
      fderiv ℝ (fderiv ℝ P) z := by
  have h := chartFunction_read_eventually (I := I) α P hz
  have hd : fderiv ℝ (chartFunction (I := I) α P ∘ (extChartAt I α).symm) =ᶠ[𝓝 z]
      fderiv ℝ P := h.eventuallyEq_nhds.mono fun _ hw => hw.fderiv_eq (𝕜 := ℝ)
  exact hd.fderiv_eq

without_proof_info in
theorem contMDiffAt_chartFunction {k : ℕ∞ω} [IsManifold I k M] (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source) {P : E → ℝ} (hP : ContDiffAt ℝ k P (extChartAt I α y)) :
    ContMDiffAt I 𝓘(ℝ) k (chartFunction (I := I) α P) y :=
  hP.contMDiffAt.comp y (contMDiffAt_extChartAt' hy)

without_proof_info in
theorem contMDiffOn_chartFunction [IsManifold I ∞ M] (α : M) {P : E → ℝ}
    (hP : ContDiff ℝ ∞ P) :
    ContMDiffOn I 𝓘(ℝ) ∞ (chartFunction (I := I) α P) (chartAt H α).source := by
  intro y hy
  exact (contMDiffAt_chartFunction α hy hP.contDiffAt).contMDiffWithinAt

variable [FiniteDimensional ℝ E] [IsManifold I 2 M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 E (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 E (TangentSpace I : M → Type _) I]

omit [FiniteDimensional ℝ E]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 E (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 E (TangentSpace I : M → Type _) I] in
without_proof_info in
theorem mvfderiv_chartFunction (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source)
    (hint : extChartAt I α y ∈ interior (extChartAt I α).target)
    {P : E → ℝ} (hP : ContDiffAt ℝ 2 P (extChartAt I α y)) (v : E) :
    mvfderiv I (chartFunction (I := I) α P) y
        ((trivializationAt E (TangentSpace I) α).symmL ℝ y v) =
      fderiv ℝ P (extChartAt I α y) v := by
  rw [mvfderiv_inverseChart_vector α hy hint
      ((contMDiffAt_chartFunction α hy hP).mdifferentiableAt (by norm_num)),
    chartFunction_read_fderiv α P hint]

without_proof_info in
theorem hessian_chartFunction (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source)
    (hint : extChartAt I α y ∈ interior (extChartAt I α).target)
    {P : E → ℝ} (hP : ContDiffAt ℝ 2 P (extChartAt I α y)) (v w : E) :
    TauCeti.Manifold.hessian I (chartFunction (I := I) α P) y
        ((trivializationAt E (TangentSpace I) α).symmL ℝ y v)
        ((trivializationAt E (TangentSpace I) α).symmL ℝ y w) =
      fderiv ℝ (fderiv ℝ P) (extChartAt I α y) v w -
        fderiv ℝ P (extChartAt I α y) (chartLeviCivitaMap (I := I) α y v w) := by
  rw [hessian_fixedChart_christoffel α hy hint (contMDiffAt_chartFunction α hy hP),
    chartFunction_read_secondFDeriv α P hint, chartFunction_read_fderiv α P hint]

end ConformalPoisson

end ProofPart_ChartFunctionJets

/- Proof support: CenteredJetPolynomial.lean, SHA256 5b04df41bb7c79263931c369bcf5ea846abc4c62a20b7d98a995f10f756a0d4b -/
noncomputable section ProofPart_CenteredJetPolynomial




/- The polynomial with a specified ordinary second jet at any coordinate center. -/

open scoped ContDiff

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def centeredJetPolynomial (z₀ : E) (j : FlatJet E) : E → ℝ :=
  fun z => flatJetPolynomial j (z + -z₀)

without_proof_info in
@[simp] theorem centeredJetPolynomial_value (z₀ : E) (j : FlatJet E) :
    centeredJetPolynomial z₀ j z₀ = j.1 := by
  simp only [centeredJetPolynomial, add_neg_cancel, flatJetPolynomial_value_zero]

without_proof_info in
@[simp] theorem centeredJetPolynomial_fderiv (z₀ : E) (j : FlatJet E) :
    fderiv ℝ (centeredJetPolynomial z₀ j) z₀ = j.2.1 := by
  change fderiv ℝ (fun z => flatJetPolynomial j (z + -z₀)) z₀ = j.2.1
  rw [fderiv_comp_add_right, add_neg_cancel, flatJetPolynomial_fderiv_zero]

without_proof_info in
@[simp] theorem centeredJetPolynomial_secondFDeriv (z₀ : E) (j : FlatJet E) :
    fderiv ℝ (fderiv ℝ (centeredJetPolynomial z₀ j)) z₀ = j.2.2.val := by
  have hfirst : fderiv ℝ (centeredJetPolynomial z₀ j) =
      fun z => fderiv ℝ (flatJetPolynomial j) (z + -z₀) :=
    funext fun _ => fderiv_comp_add_right (-z₀)
  rw [hfirst, fderiv_comp_add_right, add_neg_cancel, flatJetPolynomial_secondFDeriv]

without_proof_info in
theorem contDiff_centeredJetPolynomial (z₀ : E) (j : FlatJet E) :
    ContDiff ℝ ∞ (centeredJetPolynomial z₀ j) :=
  (contDiff_flatJetPolynomial j).comp (contDiff_id.add contDiff_const)

end ConformalPoisson

end ProofPart_CenteredJetPolynomial

/- Proof support: NativePolynomialJets.lean, SHA256 f029d43e12ce860fed91c2713351d6f0c42ccea1ce0277cb49b9742bfc6632ca -/
noncomputable section ProofPart_NativePolynomialJets






/-
Every symmetric native jet is realized by a chart quadratic. This statement has
no PDE conclusion; it supplies the smooth comparison function used to transfer
the requested native compatibility equation into normalized coordinates.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_chart_function_with_native_jet (g : Metric (n := n) (M := M))
    (x : M) (hx : (𝓡∂ (n + 1)).IsInteriorPoint x) (j : symmetricJetSubmodule g x) :
    ∃ f : M → ℝ, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f
        (chartAt (EuclideanHalfSpace (n + 1)) x).source ∧ secondJet g f x = j.val := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (n' := 1) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  let e := trivializationAt V (TangentSpace (𝓡∂ (n + 1))) x
  have hbase : x ∈ e.baseSet := FiberBundle.mem_baseSet_trivializationAt' x
  let D : V ≃L[ℝ] TangentSpace (𝓡∂ (n + 1)) x := (e.continuousLinearEquivAt ℝ x hbase).symm
  let Γ := chartLeviCivitaMap (I := 𝓡∂ (n + 1)) x x
  have hΓ : ∀ v w, Γ v w = Γ w v :=
    chartLeviCivitaMap_comm x (mem_chart_source _ x)
  have hA : ∀ v w, inner ℝ (j.val.2.2 v) w = inner ℝ v (j.val.2.2 w) := by
    intro v w
    exact j.property v w
  let J := covariantJetCoordinates D Γ hΓ j.val.1 j.val.2.1 j.val.2.2 hA
  let P := centeredJetPolynomial (extChartAt (𝓡∂ (n + 1)) x x) J
  let f := chartFunction (I := 𝓡∂ (n + 1)) x P
  have hP : ContDiff ℝ ∞ P := contDiff_centeredJetPolynomial _ J
  have hP2 : ContDiffAt ℝ 2 P (extChartAt (𝓡∂ (n + 1)) x x) := hP.contDiffAt.of_le (by decide)
  have hxi : extChartAt (𝓡∂ (n + 1)) x x ∈ interior (extChartAt (𝓡∂ (n + 1)) x).target :=
    ModelWithCorners.isInteriorPoint_iff.mp hx
  have hD : (D : V → TangentSpace (𝓡∂ (n + 1)) x) = e.symmL ℝ x :=
    e.symm_continuousLinearEquivAt_eq hbase
  refine ⟨f, contMDiffOn_chartFunction x hP, Prod.ext ?_ (Prod.ext ?_ ?_)⟩
  · change centeredJetPolynomial _ J (extChartAt (𝓡∂ (n + 1)) x x) = j.val.1
    rw [centeredJetPolynomial_value]
    rfl
  · change mvfderiv (𝓡∂ (n + 1)) f x = j.val.2.1
    apply covector_eq_of_coordinates D
    intro v
    have h := mvfderiv_chartFunction x (mem_chart_source _ x) hxi hP2 v
    rw [← hD, centeredJetPolynomial_fderiv] at h
    exact h
  · apply raisedHessian_eq_of_coordinates D
    intro v w
    have h := hessian_chartFunction x (mem_chart_source _ x) hxi hP2 v w
    rw [← hD, centeredJetPolynomial_secondFDeriv, centeredJetPolynomial_fderiv] at h
    rw [TauCeti.Manifold.hessian_def] at h
    change inner ℝ ((secondJet g f x).2.2 (D v)) (D w) = _ at h
    change inner ℝ ((secondJet g f x).2.2 (D v)) (D w) = inner ℝ (j.val.2.2 (D v)) (D w)
    exact h.trans (by
      change connectionJetHessian D Γ j.val.2.1 j.val.2.2 v w -
        (j.val.2.1.comp D.toContinuousLinearMap) (Γ v w) = _
      rw [connectionJetHessian_apply]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe, add_sub_cancel_right])

end ConformalPoisson

end ProofPart_NativePolynomialJets

/- Proof support: InverseMetricFactorization.lean, SHA256 bca86b828af210abcbd977088ff022d356b447b52a36da1d85b79490e134bdcd -/
noncomputable section ProofPart_InverseMetricFactorization




/-
The inverse coordinate metric factors through the inverse chart differential
and its adjoint. This avoids assuming a coordinate normalization theorem.
-/

open scoped BigOperators

namespace ConformalPoisson

variable {E W : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W]
  {ι κ : Type*} [Fintype ι] [Fintype κ]

without_proof_info in
theorem principalContraction_covectorProduct (e : OrthonormalBasis ι ℝ E)
    (A : E →L[ℝ] E) (v w : E) :
    principalContraction e ((innerSL ℝ v).smulRight (innerSL ℝ w)) A = inner ℝ w (A v) := by
  have h := congrArg (fun z => inner ℝ w (A z)) (e.sum_repr' v)
  simpa only [principalContraction, LinearMap.coe_mk, AddHom.coe_mk,
    ContinuousLinearMap.smulRight_apply, smul_apply, innerSL_apply_apply,
    map_sum, map_smul, inner_sum, inner_smul_right, smul_eq_mul, real_inner_comm] using h

without_proof_info in
/-- All bilinear contractions determine the principal endomorphism. -/
theorem principalContraction_separates (e : OrthonormalBasis ι ℝ E)
    {A C : E →L[ℝ] E}
    (h : ∀ B : E →L[ℝ] E →L[ℝ] ℝ, principalContraction e B A = principalContraction e B C) :
    A = C := by
  ext v
  apply ext_inner_left ℝ
  intro w
  simpa only [principalContraction_covectorProduct] using
    h ((innerSL ℝ v).smulRight (innerSL ℝ w))

variable [CompleteSpace E] [CompleteSpace W]

without_proof_info in
theorem map_comp_adjoint_eq_sum_rankOne (e : OrthonormalBasis κ ℝ W) (C : W →L[ℝ] E) :
    C.comp C.adjoint = ∑ i, (innerSL ℝ (C (e i))).smulRight (C (e i)) := by
  ext v
  have h := congrArg C (e.sum_repr' (C.adjoint v))
  simpa only [ContinuousLinearMap.comp_apply, sum_apply, ContinuousLinearMap.smulRight_apply,
    innerSL_apply_apply, map_sum, map_smul, ContinuousLinearMap.adjoint_inner_right] using h.symm

variable [FiniteDimensional ℝ E] [FiniteDimensional ℝ W]

without_proof_info in
/-- In any coordinate basis, the inverse Gram tensor is the chart map times its adjoint. -/
theorem inverseMetricOperator_eq_map_comp_adjoint [DecidableEq ι]
    (b : Module.Basis ι ℝ E) (C : W ≃L[ℝ] E) :
    inverseMetricOperator b (Matrix.gram ℝ (b.map C.symm.toLinearEquiv))⁻¹ =
      C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint := by
  let e := stdOrthonormalBasis ℝ E
  let f := stdOrthonormalBasis ℝ W
  apply principalContraction_separates e
  intro B
  let BC : W →L[ℝ] W →L[ℝ] ℝ :=
    ((ContinuousLinearMap.compL ℝ W E ℝ).flip C.toContinuousLinearMap).comp
      (B.comp C.toContinuousLinearMap)
  have hBC (v w : W) : BC v w = B (C v) (C w) := rfl
  have htrace := TauCeti.bilinFormTrace_eq_sum_inv_gram BC.toBilinForm (b.map C.symm.toLinearEquiv)
  have htrace' := TauCeti.bilinFormTrace_eq_sum BC.toBilinForm f
  rw [principalContraction_inverseMetricOperator]
  calc
    (∑ i, ∑ j, (Matrix.gram ℝ (b.map C.symm.toLinearEquiv))⁻¹ i j * B (b i) (b j)) =
        TauCeti.bilinFormTrace BC.toBilinForm := by
      rw [htrace]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      congr 1
      change B (b i) (b j) = B (C (C.symm (b i))) (C (C.symm (b j)))
      rw [C.apply_symm_apply, C.apply_symm_apply]
    _ = ∑ i, B (C (f i)) (C (f i)) := by
      rw [htrace']
      rfl
    _ = principalContraction e B (C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint) := by
      rw [map_comp_adjoint_eq_sum_rankOne f]
      simp only [map_sum, principalContraction_rankOne, ContinuousLinearEquiv.coe_coe]

without_proof_info in
/-- A factor through an inner product space of the same dimension supplies an invertible
normalizing coordinate map. One such map is chosen before any jet target. -/
theorem exists_normalizing_equiv_of_factor {d : ℕ}
    (C : W ≃L[ℝ] EuclideanSpace ℝ (Fin d))
    {A : EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)}
    (hA : A = C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint) :
    ∃ T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d),
      principalCongruence T.symm.toContinuousLinearMap A = ContinuousLinearMap.id ℝ _ := by
  have hdim : Module.finrank ℝ W = d := by
    simpa only [finrank_euclideanSpace, Fintype.card_fin] using C.toLinearEquiv.finrank_eq
  let f : OrthonormalBasis (Fin d) ℝ W :=
    (stdOrthonormalBasis ℝ W).reindex (finCongr hdim)
  let s : EuclideanSpace ℝ (Fin d) ≃ₗᵢ[ℝ] W := f.repr.symm
  let T := s.toContinuousLinearEquiv.trans C
  refine ⟨T, ?_⟩
  have hTC : T.symm.toContinuousLinearMap.comp C.toContinuousLinearMap =
      s.symm.toContinuousLinearEquiv.toContinuousLinearMap := by
    ext w
    simp only [T, ContinuousLinearMap.comp_apply, ContinuousLinearEquiv.coe_coe,
      ContinuousLinearEquiv.symm_trans_apply, ContinuousLinearEquiv.symm_apply_apply,
      LinearIsometryEquiv.coe_toContinuousLinearEquiv, LinearIsometryEquiv.coe_symm_toContinuousLinearEquiv]
  have hadj : C.toContinuousLinearMap.adjoint.comp T.symm.toContinuousLinearMap.adjoint =
      s.symm.toContinuousLinearEquiv.toContinuousLinearMap.adjoint := by
    rw [← ContinuousLinearMap.adjoint_comp, hTC]
  rw [hA]
  change T.symm.toContinuousLinearMap.comp
    ((C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint).comp
      T.symm.toContinuousLinearMap.adjoint) = _
  calc
    _ = (T.symm.toContinuousLinearMap.comp C.toContinuousLinearMap).comp
        (C.toContinuousLinearMap.adjoint.comp T.symm.toContinuousLinearMap.adjoint) := by
      simp only [ContinuousLinearMap.comp_assoc]
    _ = s.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp
        s.symm.toContinuousLinearEquiv.toContinuousLinearMap.adjoint := by rw [hTC, hadj]
    _ = ContinuousLinearMap.id ℝ _ := by
      rw [s.symm.adjoint_eq_symm]
      ext x
      simp only [ContinuousLinearMap.comp_apply, LinearIsometryEquiv.coe_toContinuousLinearEquiv,
        ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.symm_symm,
        LinearIsometryEquiv.symm_apply_apply, ContinuousLinearMap.id_apply]

end ConformalPoisson

end ProofPart_InverseMetricFactorization

/- Proof support: InteriorChartLaplacian.lean, SHA256 0b59b4243bb892fcecb35c85ed9fb0f224c394b577255b5915ea8891d0703a93 -/
noncomputable section ProofPart_InteriorChartLaplacian




/-
The native Laplace-Beltrami operator in an ordinary interior chart, contracted
against the inverse coordinate metric. The sign used by the paper is its negative.
-/

open Bundle Set
open scoped Manifold ContDiff Topology BigOperators

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 E (fun y : M => TangentSpace I y)]

/-- The actual native scalar Hessian, bundled as a covariant bilinear form. -/
def nativeHessianBilin (f : M → ℝ) (y : M) : LinearMap.BilinForm ℝ (TangentSpace I y) :=
  (innerₗ (TangentSpace I y)).compl₁₂
    (CovariantDerivative.leviCivitaConnection I M (TauCeti.Manifold.mgradient I f) y).toLinearMap
    LinearMap.id

without_proof_info in
@[simp] theorem nativeHessianBilin_apply (f : M → ℝ) (y : M) (v w : TangentSpace I y) :
    nativeHessianBilin (I := I) f y v w = TauCeti.Manifold.hessian I f y v w := by
  rw [TauCeti.Manifold.hessian_def]
  rfl

without_proof_info in
theorem laplaceBeltrami_eq_nativeHessianTrace (f : M → ℝ) (y : M) :
    TauCeti.Manifold.laplaceBeltrami I f y =
      TauCeti.bilinFormTrace (nativeHessianBilin (I := I) f y) := by
  let b := stdOrthonormalBasis ℝ (TangentSpace I y)
  rw [TauCeti.Manifold.laplaceBeltrami_eq_sum_hessian I f y b,
    TauCeti.bilinFormTrace_eq_sum _ b]
  simp only [nativeHessianBilin_apply]

variable [ContMDiffVectorBundle 1 E (TangentSpace I : M → Type _) I]

without_proof_info in
/-- The native operator contracts the ordinary coordinate Hessian minus its Christoffel
correction with the inverse coordinate metric. -/
theorem laplaceBeltrami_fixedChart (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source)
    (hint : extChartAt I α y ∈ interior (extChartAt I α).target)
    {f : M → ℝ} (hf : ContMDiffAt I 𝓘(ℝ) 2 f y) :
    TauCeti.Manifold.laplaceBeltrami I f y =
      ∑ i, ∑ j, Riemannian.Tensor.chartInvGramMatrix (I := I) α y i j *
        (fderiv ℝ (fderiv ℝ (f ∘ (extChartAt I α).symm)) (extChartAt I α y)
            (Module.finBasis ℝ E i) (Module.finBasis ℝ E j) -
          fderiv ℝ (f ∘ (extChartAt I α).symm) (extChartAt I α y)
            (chartLeviCivitaMap (I := I) α y (Module.finBasis ℝ E i) (Module.finBasis ℝ E j))) := by
  rw [laplaceBeltrami_eq_nativeHessianTrace,
    Riemannian.Tensor.bilinFormTrace_eq_sum_chartInvGramMatrix α hy]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  rw [nativeHessianBilin_apply, Riemannian.Tensor.chartLocalFrame_eq_symmL,
    Riemannian.Tensor.chartLocalFrame_eq_symmL, hessian_fixedChart_christoffel α hy hint hf]

/-- The positive drift in the paper's negative Laplacian. -/
def chartNegativeLaplacianDrift (α y : M) : E :=
  ∑ i, ∑ j, Riemannian.Tensor.chartInvGramMatrix (I := I) α y i j •
    chartLeviCivitaMap (I := I) α y (Module.finBasis ℝ E i) (Module.finBasis ℝ E j)

without_proof_info in
theorem negative_laplaceBeltrami_fixedChart (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source)
    (hint : extChartAt I α y ∈ interior (extChartAt I α).target)
    {f : M → ℝ} (hf : ContMDiffAt I 𝓘(ℝ) 2 f y) :
    -TauCeti.Manifold.laplaceBeltrami I f y =
      -(∑ i, ∑ j, Riemannian.Tensor.chartInvGramMatrix (I := I) α y i j *
        fderiv ℝ (fderiv ℝ (f ∘ (extChartAt I α).symm)) (extChartAt I α y)
          (Module.finBasis ℝ E i) (Module.finBasis ℝ E j)) +
      fderiv ℝ (f ∘ (extChartAt I α).symm) (extChartAt I α y)
        (chartNegativeLaplacianDrift (I := I) α y) := by
  rw [laplaceBeltrami_fixedChart α hy hint hf]
  simp only [chartNegativeLaplacianDrift, map_sum, map_smul, smul_eq_mul,
    mul_sub, Finset.sum_sub_distrib, neg_sub]
  ring

end ConformalPoisson

end ProofPart_InteriorChartLaplacian

/- Proof support: InteriorCoordinateOperator.lean, SHA256 f665211d3ce69c9f68144507afab35d3ea9a8e52cd5c75d02c48492b897b869a -/
noncomputable section ProofPart_InteriorCoordinateOperator




/-
Concrete coordinate coefficients for the actual native negative Laplacian plus
potential. The coordinate chart is not yet centered or linearly normalized.
-/

open Bundle Set
open scoped Manifold ContDiff Topology BigOperators

namespace ConformalPoisson

variable {d : ℕ}

variable {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

def chartPrincipalCoefficient (α : M) (z : (EuclideanSpace ℝ (Fin d))) : (EuclideanSpace ℝ (Fin d)) →L[ℝ] (EuclideanSpace ℝ (Fin d)) :=
  inverseMetricOperator (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d)))
    (Riemannian.Tensor.chartInvGramMatrix (I := I) α ((extChartAt I α).symm z))

def chartDriftCoefficient (α : M) (z : (EuclideanSpace ℝ (Fin d))) : (EuclideanSpace ℝ (Fin d)) :=
  chartNegativeLaplacianDrift (I := I) α ((extChartAt I α).symm z)

def chartPotentialCoefficient (α : M) (q : M → ℝ) (z : (EuclideanSpace ℝ (Fin d))) : ℝ :=
  q ((extChartAt I α).symm z)

without_proof_info in
/-- Exact equality with the coordinate operator used in the local Schauder construction.
No elliptic regularity, approximation, or jet-surjectivity assumption enters this identity. -/
theorem coordinateSchrodinger_eq_native (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source)
    (hint : extChartAt I α y ∈ interior (extChartAt I α).target)
    (q : M → ℝ) {f : M → ℝ} (hf : ContMDiffAt I 𝓘(ℝ) 2 f y) :
    coordinateSchrodinger (chartPrincipalCoefficient (I := I) α)
        (chartDriftCoefficient (I := I) α) (chartPotentialCoefficient (I := I) α q)
        (f ∘ (extChartAt I α).symm) (extChartAt I α y) =
      -TauCeti.Manifold.laplaceBeltrami I f y + q y * f y := by
  have hround : (extChartAt I α).symm (extChartAt I α y) = y :=
    (extChartAt I α).left_inv (by rwa [extChartAt_source])
  have hcontract := principalContraction_inverseMetricOperator
    (EuclideanSpace.basisFun (Fin d) ℝ)
    (fderiv ℝ (fderiv ℝ (f ∘ (extChartAt I α).symm)) (extChartAt I α y))
    (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))) (Riemannian.Tensor.chartInvGramMatrix (I := I) α y)
  rw [negative_laplaceBeltrami_fixedChart α hy hint hf]
  unfold coordinateSchrodinger chartPrincipalCoefficient chartDriftCoefficient
    chartPotentialCoefficient
  simp only [hround, Function.comp_apply]
  congr 2
  simpa only [principalContraction, LinearMap.coe_mk, AddHom.coe_mk,
    EuclideanSpace.basisFun_apply] using congrArg Neg.neg hcontract

end ConformalPoisson

end ProofPart_InteriorCoordinateOperator

/- Proof support: NativePrincipalNormalization.lean, SHA256 f2103a61635acb9e74da6ea54e8250231a7493a61962436597620622edd37a93 -/
noncomputable section ProofPart_NativePrincipalNormalization





/-
A normalizing linear coordinate map for the actual native metric. It is selected
at the interior chart center independently of any prescribed jet.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

omit
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I] in
without_proof_info in
/-- A concrete factorization of the inverse metric principal coefficient through the
native tangent space with its given metric. -/
theorem chartPrincipalCoefficient_factor (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source) :
    ∃ C : TangentSpace I y ≃L[ℝ] EuclideanSpace ℝ (Fin d),
      chartPrincipalCoefficient (I := I) α (extChartAt I α y) =
        C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint := by
  let e := trivializationAt (EuclideanSpace ℝ (Fin d)) (TangentSpace I) α
  have hbase : y ∈ e.baseSet := by simpa [e] using hy
  let C := e.continuousLinearEquivAt ℝ y hbase
  let b := Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))
  have hGram : Matrix.gram ℝ (b.map C.symm.toLinearEquiv) =
      Riemannian.Tensor.chartGramMatrix (I := I) α y := by
    ext i j
    simp only [Matrix.gram_apply, Module.Basis.map_apply,
      Riemannian.Tensor.chartGramMatrix_apply, Riemannian.Tensor.chartLocalFrame_eq_symmL]
    change inner ℝ (C.symm (b i)) (C.symm (b j)) =
      inner ℝ (e.symmL ℝ y (b i)) (e.symmL ℝ y (b j))
    have hsymm : (C.symm : EuclideanSpace ℝ (Fin d) → TangentSpace I y) = e.symmL ℝ y :=
      e.symm_continuousLinearEquivAt_eq hbase
    rw [hsymm]
  have hround : (extChartAt I α).symm (extChartAt I α y) = y :=
    (extChartAt I α).left_inv (by rwa [extChartAt_source])
  refine ⟨C, ?_⟩
  rw [chartPrincipalCoefficient, hround]
  rw [Riemannian.Tensor.chartInvGramMatrix_def, ← hGram]
  exact inverseMetricOperator_eq_map_comp_adjoint b C

omit
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I] in
without_proof_info in
/-- Existence of one invertible affine normalization of the actual native principal
coefficient, before any boundary datum or jet target is chosen. -/
theorem exists_native_principal_normalization (α : M) {y : M}
    (hy : y ∈ (chartAt H α).source) :
    ∃ T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d),
      affinePrincipalCoefficient T (extChartAt I α y) (chartPrincipalCoefficient (I := I) α) 0 =
        ContinuousLinearMap.id ℝ _ := by
  obtain ⟨C, hC⟩ := chartPrincipalCoefficient_factor (I := I) α hy
  obtain ⟨T, hT⟩ := exists_normalizing_equiv_of_factor C hC
  exact ⟨T, affinePrincipalCoefficient_normalized T _ _ hT⟩

end ConformalPoisson

end ProofPart_NativePrincipalNormalization

/- Proof support: InteriorCoefficientRegularity.lean, SHA256 ce5a15fa6bc267522404ea424c879e574dd13265a7636b15b7fbc3e14cbc2bde -/
noncomputable section ProofPart_InteriorCoefficientRegularity



/-
Smoothness of the actual coordinate coefficients on the interior of a chart
target. These are geometric consequences of a smooth native metric and potential.
-/

open Bundle Set
open scoped Manifold ContDiff Topology BigOperators

namespace ConformalPoisson

section ReadChart

variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]

without_proof_info in
theorem contDiffOn_read_interiorChart (α : M) {f : M → F}
    (hf : ContMDiffOn I 𝓘(ℝ, F) ∞ f (chartAt H α).source) :
    ContDiffOn ℝ ∞ (f ∘ (extChartAt I α).symm) (interior (extChartAt I α).target) := by
  intro z hz
