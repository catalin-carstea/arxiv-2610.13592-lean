      ∀ z ∈ (Ihalf).interior M \ {x}, schrodinger g q G z = 0 := by
  obtain ⟨G₀, hG₀, hG₀k, hPG₀⟩ := K.exists_classical_native_interior_row (p := p) hq hNR x
  obtain ⟨D⟩ := exists_nativePoleCutoffData x hx G₀ hG₀
  obtain ⟨w, hw, hcomp⟩ := K.cutoff_part_eq_smooth_inverse (p := p) hq hNR hp x G₀ hG₀k D
  let G : M → ℝ := D.cutoff * G₀ + w
  have hG : ContMDiffOn Ihalf 𝓘(ℝ) ∞ G ({x}ᶜ : Set M) :=
    (D.contMDiffOn_cutoff_mul hG₀).add hw.1.contMDiffOn
  have hGk : G =ᵐ[nativeVolume g] K.row x := by
    filter_upwards [hG₀k, hcomp] with z hz hc
    dsimp only [G, Pi.add_apply, Pi.mul_apply]
    rw [hz, ← hc]
    ring
  have hG0 : ∀ y : (Ihalf).boundary M, G y = 0 := by
    intro y
    have hyθ : (y : M) ∉ tsupport D.cutoff := by
      intro hy
      have hyc : (y : M) ∈ ((Ihalf).interior M)ᶜ := by
        rw [(Ihalf).compl_interior]
        exact y.property
      exact hyc (D.interior_support hy)
    change D.cutoff y * G₀ y + w y = 0
    rw [image_eq_zero_of_notMem_tsupport hyθ, hw.2.2 y, zero_mul, add_zero]
  let U : Opens M := ⟨(Ihalf).interior M \ {x},
    ((Ihalf).isOpen_interior (n := ω) (M := M) (by decide)).inter isOpen_compl_singleton⟩
  have hGU : ContMDiffOn Ihalf 𝓘(ℝ) ∞ G (U : Set M) := hG.mono (fun _ hz => hz.2)
  have heq : EqOn G G₀ U := native_continuous_eqOn_open_of_ae_eq g U G G₀
    (hG.continuousOn.mono (fun _ hz => hz.2)) hG₀.continuousOn (hGk.trans hG₀k.symm)
  refine ⟨G, hG, hGk, hG0, ?_⟩
  intro z hz
  rw [schrodinger_eq_of_eventuallyEq g q
    (((hGU z hz).contMDiffAt (U.isOpen.mem_nhds hz)).of_le (by simp))
    (((hG₀ z hz).contMDiffAt (U.isOpen.mem_nhds hz)).of_le (by simp))
    (Filter.eventually_of_mem (U.isOpen.mem_nhds hz) heq)]
  exact hPG₀ z hz

end ConformalPoisson

end ProofPart_GreenTrace_NativeBoundaryValueRows

/- Green/trace proof support: NativeClassicalValueKernel.lean, SHA256 a4d3d1441d69e798da2046961163c6e241c1dc1713781eee644907547f48950c -/
noncomputable section ProofPart_GreenTrace_NativeClassicalValueKernel


/- A pointwise native value kernel assembled from the actual inverse rows.
This records rowwise boundary smoothness and exact forcing representations;
it does NOT yet assert joint smoothness or pointwise symmetry. -/
open Bundle Set MeasureTheory TauCeti Filter TopologicalSpace
open scoped Manifold ContDiff Topology ENNReal
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

structure NativeClassicalValueKernel
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseLpRowFamily g q s) where
  kernel : M → M → ℝ
  row_ae : ∀ x, kernel x =ᵐ[nativeVolume g] K.row x
  row_smooth : ∀ x, ContMDiffOn Ihalf 𝓘(ℝ) ∞ (kernel x) ({x}ᶜ : Set M)
  boundary_first : ∀ y : (Ihalf).boundary M, ∀ z, kernel y z = 0
  boundary_second : ∀ x, ∀ y : (Ihalf).boundary M, kernel x y = 0
  row_equation : ∀ x, ∀ z ∈ (Ihalf).interior M \ {x}, schrodinger g q (kernel x) z = 0

without_proof_info in
theorem nonempty_nativeClassicalValueKernel
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
    (K : NativeInverseLpRowFamily g q s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (hNR : Nonresonant g q) (hp : p ≠ (⊤ : ℝ≥0∞)) : Nonempty (NativeClassicalValueKernel K) := by
  classical
  have hrows := fun x hx => K.exists_classical_native_boundary_row (p := p) hq hNR hp x hx
  choose! G hG hGae hG0 hGP using hrows
  let k : M → M → ℝ := fun x z => if (Ihalf).IsInteriorPoint x then G x z else 0
  have hnotI (y : (Ihalf).boundary M) : ¬ (Ihalf).IsInteriorPoint (y : M) := by
    have hy : (y : M) ∈ ((Ihalf).interior M)ᶜ := by
      rw [(Ihalf).compl_interior]
      exact y.property
    exact hy
  refine ⟨⟨k, ?_, ?_, ?_, ?_, ?_⟩⟩
  · intro x
    by_cases hx : (Ihalf).IsInteriorPoint x
    · simpa only [k, if_pos hx] using hGae x hx
    · have hxb : x ∈ (Ihalf).boundary M := by
        rw [← (Ihalf).compl_interior]
        exact hx
      have hzero : K.row x = 0 := K.boundary_row_eq_zero (p := p) hq hNR hp ⟨x, hxb⟩
      change (fun z => if (Ihalf).IsInteriorPoint x then G x z else 0) =ᵐ[nativeVolume g] K.row x
      simp only [if_neg hx]
      rw [hzero]
      exact (Lp.coeFn_zero ℝ s (nativeVolume g)).symm
  · intro x
    by_cases hx : (Ihalf).IsInteriorPoint x
    · simpa only [k, if_pos hx] using hG x hx
    · simpa only [k, if_neg hx] using
        (contMDiff_const.contMDiffOn : ContMDiffOn Ihalf 𝓘(ℝ) ∞ (fun _ : M => (0 : ℝ)) {x}ᶜ)
  · intro y z
    simp only [k, if_neg (hnotI y)]
  · intro x y
    by_cases hx : (Ihalf).IsInteriorPoint x
    · simpa only [k, if_pos hx] using hG0 x hx y
    · simp only [k, if_neg hx]
  · intro x z hz
    by_cases hx : (Ihalf).IsInteriorPoint x
    · simpa only [k, if_pos hx] using hGP x hx z hz
    · have hk : k x = (0 : M → ℝ) := by funext z; simp only [k, if_neg hx, Pi.zero_apply]
      rw [hk]
      exact schrodinger_zero g q z

without_proof_info in
theorem NativeClassicalValueKernel.representation
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    {K : NativeInverseLpRowFamily g q s} (G : NativeClassicalValueKernel K)
    (x : M) (F : C^∞⟮Ihalf, M; ℝ⟯) (u : M → ℝ)
    (hu : IsZeroDirichletSolution g q F u) :
    Integrable (fun z => G.kernel x z * F z) (nativeVolume g) ∧
      u x = ∫ z, G.kernel x z * F z ∂nativeVolume g := by
  have he : (fun z => K.row x z * F z) =ᵐ[nativeVolume g]
      (fun z => G.kernel x z * F z) :=
    (G.row_ae x).symm.mono fun z hz => congrArg (fun a => a * F z) hz
  obtain ⟨hint, hrep⟩ := K.representation x F u hu
  exact ⟨hint.congr he, hrep.trans (integral_congr_ae he)⟩

without_proof_info in
theorem NativeClassicalValueKernel.weak_equation
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    {K : NativeInverseLpRowFamily g q s} (G : NativeClassicalValueKernel K)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (x : M) (u : M → ℝ)
    (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) (hu0 : ∀ y : (Ihalf).boundary M, u y = 0) :
    Integrable (fun z => G.kernel x z * schrodinger g q u z) (nativeVolume g) ∧
      (∫ z, G.kernel x z * schrodinger g q u z ∂nativeVolume g) = u x := by
  obtain ⟨hint, hrep⟩ := G.representation x
    ⟨schrodinger g q u, contMDiff_schrodinger g q u hq hu⟩ u ⟨hu, fun _ _ => rfl, hu0⟩
  exact ⟨hint, hrep.symm⟩

without_proof_info in
theorem NativeClassicalValueKernel.pointwise_unique
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    {K : NativeInverseLpRowFamily g q s} (G H : NativeClassicalValueKernel K)
    (x z : M) (hz : z ≠ x) : G.kernel x z = H.kernel x z := by
  let U : Opens M := ⟨{x}ᶜ, isOpen_compl_singleton⟩
  have hzU : z ∈ U := by
    change z ∉ ({x} : Set M)
    exact fun h => hz (mem_singleton_iff.mp h)
  exact native_continuous_eqOn_open_of_ae_eq g U (G.kernel x) (H.kernel x)
    (G.row_smooth x).continuousOn (H.row_smooth x).continuousOn
    ((G.row_ae x).trans (H.row_ae x).symm) hzU

end ConformalPoisson

end ProofPart_GreenTrace_NativeClassicalValueKernel

/- Green/trace proof support: BasisDensityNormalization.lean, SHA256 c973bd44a03d462e649f1560120cabf8a38dd0846e2e9e01ad36c20569a1355a -/
noncomputable section ProofPart_GreenTrace_BasisDensityNormalization




/- A Gram density and its basis-normalized Haar measure transform by
reciprocal determinants. This is the exact normalization bridge needed by
native volume and surface integration in standard half-space coordinates. -/
open MeasureTheory Module Set
open scoped ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E]
  {m : ℕ}

without_proof_info in
theorem basis_addHaar_eq_inv_det_smul (b c : Basis (Fin m) ℝ E) :
    b.addHaar = (|c.det b|⁻¹).toNNReal • c.addHaar := by
  let : FiniteDimensional ℝ E := b.finiteDimensional_of_finite
  have hd : c.det b ≠ 0 := (c.isUnit_det b).ne_zero
  rw [b.addHaar_eq_iff, Measure.smul_apply, Basis.coe_parallelepiped, Measure.addHaar_parallelepiped]
  change ENNReal.ofReal |c.det b|⁻¹ * ENNReal.ofReal |c.det b| = 1
  rw [← ENNReal.ofReal_mul (by positivity)]
  simp only [inv_mul_cancel₀ (abs_ne_zero.mpr hd), ENNReal.ofReal_one]

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]

without_proof_info in
theorem sqrt_det_gram_changeBasis (b c : Basis (Fin m) ℝ E) (L : E ≃ₗ[ℝ] F) :
    Real.sqrt (Matrix.gram ℝ (b.map L)).det =
      |c.det b| * Real.sqrt (Matrix.gram ℝ (c.map L)).det := by
  let : Fact (Module.finrank ℝ F = m) := ⟨by
    simpa only [Fintype.card_fin] using (Module.finrank_eq_card_basis (c.map L))⟩
  let o := (c.map L).orientation
  have hdet : (c.map L).det (b.map L) = c.det b := by
    simp only [Basis.det_apply, Basis.toMatrix_map]
    congr 1
    ext i j
    simp only [Basis.toMatrix_apply, Function.comp_apply, Basis.map_apply, L.symm_apply_apply]
  have hc : o.volumeFormL (c.map L) = Real.sqrt (Matrix.gram ℝ (c.map L)).det := by
    rw [Orientation.volumeFormL_apply]
    exact o.volumeForm_apply_eq_sqrt_det_gram (c.map L) rfl
  calc
    _ = |o.volumeFormL (b.map L)| :=
      by rw [Orientation.volumeFormL_apply]; exact (o.abs_volumeForm_apply_eq_sqrt_det_gram (b.map L)).symm
    _ = |(c.map L).det (b.map L)| * |o.volumeFormL (c.map L)| := by
      rw [ContinuousAlternatingMap.apply_eq_det_mul, abs_mul]
    _ = _ := by rw [hdet, hc, abs_of_nonneg (Real.sqrt_nonneg _)]

without_proof_info in
theorem integral_gramDensity_changeBasis
    (b c : Basis (Fin m) ℝ E) (ρ σ : E → ℝ)
    (hρ : ∀ x, ρ x = |c.det b| * σ x) (f : E → ℝ) (S : Set E) :
    (∫ x in S, ρ x * f x ∂b.addHaar) = ∫ x in S, σ x * f x ∂c.addHaar := by
  have hd : c.det b ≠ 0 := (c.isUnit_det b).ne_zero
  rw [basis_addHaar_eq_inv_det_smul b c, Measure.restrict_smul, integral_smul_nnreal_measure]
  simp only [NNReal.smul_def, smul_eq_mul]
  have hfun : (fun x => ρ x * f x) = (fun x => |c.det b| * (σ x * f x)) := by
    funext x
    rw [hρ x, mul_assoc]
  rw [hfun, integral_const_mul, ← mul_assoc]
  have hcoef : ((|c.det b|⁻¹).toNNReal : ℝ) = |c.det b|⁻¹ :=
    Real.coe_toNNReal _ (inv_nonneg.mpr (abs_nonneg _))
  rw [hcoef, inv_mul_cancel₀ (abs_ne_zero.mpr hd), one_mul]
end ConformalPoisson

end ProofPart_GreenTrace_BasisDensityNormalization

