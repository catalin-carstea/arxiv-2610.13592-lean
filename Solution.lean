theorem NativeClassicalValueKernel.symmetric
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
