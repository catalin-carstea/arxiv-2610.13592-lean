    have hzi : z + x ∈ interior (W ∩ {x : V | 0 ≤ x 0}) := by
      rw [interior_inter, hW.interior_eq, interior_halfSpace]
      exact ⟨hmap hx, by simpa [hz0] using hx0⟩
    have hux : ContDiffAt ℝ 2 u (z + x) :=
      ((hu _ (interior_subset hzi)).contDiffAt (mem_interior_iff_mem_nhds.mp hzi)).of_le (by simp)
    have htrans := coordinateSchrodinger_affinePullback (ContinuousLinearEquiv.refl ℝ V) z A b q u x hux
    have heq : coordinateSchrodinger A' b' q' v x = coordinateSchrodinger A b q u (z + x) := by
      have hAA : affinePrincipalCoefficient (ContinuousLinearEquiv.refl ℝ V) z A = A' := by
        funext y
        simp [affinePrincipalCoefficient, A']
      have hbb : affineDriftCoefficient (ContinuousLinearEquiv.refl ℝ V) z b = b' := by
        funext y
        simp [affineDriftCoefficient, b']
      have hqq : affinePotentialCoefficient (ContinuousLinearEquiv.refl ℝ V) z q = q' := by
        funext y
        simp [affinePotentialCoefficient, q']
      have hvv : affinePullback (ContinuousLinearEquiv.refl ℝ V) z u = v := by
        funext y
        simp [affinePullback, v]
