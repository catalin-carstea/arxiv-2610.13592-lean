    iteratedGradientChain (u ∘ e) 1 x =
      (e.symm : F →L[ℝ] E) ∘L iteratedGradientChain u 1 (e x) ∘L (e : E →L[ℝ] F) := by
  have hg : gradient (u ∘ e) = e.symm ∘ (gradient u ∘ e) :=
    funext fun y => gradient_comp_linearIsometryEquiv_right e u y
