        (L.innerCap_subset_interior_target hxs.2)
    exact ((I.isInteriorPoint_iff_not_isBoundaryPoint x).mp hxinter) hx
  exact ⟨⟨⟨v, hv⟩, fun x hx => hv0 x hx⟩, hs,
    fun z hz => hread z (interior_subset (L.innerCap_subset_interior_target hz))⟩

