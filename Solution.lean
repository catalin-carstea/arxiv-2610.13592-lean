  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ∞
    (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
