theorem boundaryReflection_adjoint :
    ((boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap).adjoint =
      (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap := by
  rw [LinearIsometryEquiv.adjoint_eq_symm]
  apply ContinuousLinearMap.ext
