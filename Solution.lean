noncomputable section ProofPart_LocalClassicalZeroTrace




/- Continuous zero values on the physical face give the local Sobolev
Dirichlet condition once an actual H1 representative is available.
Compact cutoffs remove the artificial edge of the cap. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped ContDiff Gradient ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem exists_local_zeroTrace_of_continuous_face
    {Ω A : Opens V} (hΩhalf : (Ω : Set V) ⊆ {y : V | 0 < y 0})
    (hhalfA : {y : V | 0 < y 0} ∩ A ⊆ Ω)
    (hb : Bornology.IsBounded (Ω : Set V))
    {g : V → ℝ} (hg : ContinuousOn g {y : V | 0 ≤ y 0})
    (hg0 : EqOn g 0 {y : V | y 0 = 0})
    (u : W1p volume Ω 2) (hu : W1p.value u =ᵐ[volume.restrict Ω] g)
    (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψs : tsupport ψ ⊆ A) :
    ∃ v : W1p0 volume Ω 2, W1p.value v.val =ᵐ[volume.restrict Ω]
      fun x => ψ x * W1p.value u x := by
  have hcoord : Continuous (fun y : V => y 0) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous
  have hcl : closure (Ω : Set V) ⊆ {y : V | 0 ≤ y 0} :=
    closure_minimal (fun y hy => show 0 ≤ y 0 from (hΩhalf hy).le)
      (isClosed_le continuous_const hcoord)
  apply exists_local_zeroTrace_of_continuous_frontier hb (hg.mono hcl) ?_ u hu hψ hψc hψs
  intro x hx hxA
  have hxnot : x ∉ (Ω : Set V) := by
    simpa only [Ω.isOpen.interior_eq] using hx.2
  have hxnonpos : x 0 ≤ 0 := le_of_not_gt (fun hp => hxnot (hhalfA ⟨hp, hxA⟩))
  have hxface : x 0 = 0 := le_antisymm hxnonpos (hcl hx.1)
  exact hg0 hxface

end ConformalPoisson

end ProofPart_LocalClassicalZeroTrace

/- Proof support: SphereCapSobolev.lean, SHA256 8f2bbc2037d483fd8dda7287f06d4f78b80e4a983931e5ddcce5dcd94e0eeaf4 -/
noncomputable section ProofPart_SphereCapSobolev






/- Actual Sobolev data for the sphere chart. No finite-energy or
boundary-regularity hypothesis is added to the original classical ball
solution. Its H1 reading is transported by the chart, its local zero
trace follows from continuous zero face values, and the pinned flat
boundary theorem supplies actual local H2 readings. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE
open scoped NNReal ContDiff ENNReal Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" => positiveNormalHalfSpace (firstCoordinateNormal n)
local notation "B₁" => (TopologicalSpace.Opens.mk (ball (0 : V) 1) isOpen_ball)

without_proof_info in
theorem mem_chartHalfSpace_iff (y : V) : y ∈ H ↔ 0 < y 0 := by
  change 0 < ⟪firstCoordinateNormal n, y⟫_ℝ ↔ 0 < y 0
  simp [firstCoordinateNormal, EuclideanSpace.inner_single_left]

without_proof_info in
theorem exists_chartKelvin_reading_with_local_zeroTrace {A : Opens V}
    (hA : IsCompact (closure (A : Set V))) {u : V → ℝ}
    (hu : ContinuousOn u (closedBall (0 : V) 1)) (hu0 : EqOn u 0 (sphere (0 : V) 1))
    (U : W1p volume B₁ 2) (hU : W1p.value U =ᵐ[volume.restrict B₁] u) :
    ∃ v : W1p volume (A ⊓ H) 2,
      (W1p.value v =ᵐ[volume.restrict ((A ⊓ H : Opens V) : Set V)] chartKelvin u) ∧
      ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ A →
        ∃ w : W1p0 volume (A ⊓ H) 2,
          W1p.value w.val =ᵐ[volume.restrict ((A ⊓ H : Opens V) : Set V)]
            fun y => ψ y * W1p.value v y := by
  have hcoord : Continuous (fun y : V => y 0) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous
  let K := closure (A : Set V) ∩ {y : V | 0 ≤ y 0}
  have hK : IsCompact K := hA.inter_right (isClosed_le continuous_const hcoord)
  have hΩhalf : ((A ⊓ H : Opens V) : Set V) ⊆ {y : V | 0 < y 0} :=
    fun y hy => (mem_chartHalfSpace_iff y).mp hy.2
  have hΩK : ((A ⊓ H : Opens V) : Set V) ⊆ K :=
    fun y hy => ⟨subset_closure hy.1, show 0 ≤ y 0 from (hΩhalf hy).le⟩
  obtain ⟨v, hv⟩ := exists_chartKelvin_w1p hK hΩK inter_subset_right hΩhalf U hU
  refine ⟨v, hv, ?_⟩
  intro ψ hψ hψc hψs
  exact exists_local_zeroTrace_of_continuous_face hΩhalf
    (fun y hy => ⟨hy.2, (mem_chartHalfSpace_iff y).mpr hy.1⟩)
    (hA.isBounded.subset (fun y hy => subset_closure hy.1))
    (continuousOn_chartKelvin_closedHalfSpace hu) (chartKelvin_eq_zero_on_face hu0)
    v hv ψ hψ hψc hψs

without_proof_info in
theorem memLp_transformedForcing_cap {A : Opens V}
    (hA : IsCompact (closure (A : Set V))) (hα : 0 < α) (hαle : α ≤ 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) :
    MemLp (transformedForcing f) 2 (volume.restrict ((A ⊓ H : Opens V) : Set V)) := by
  obtain ⟨R, hR⟩ := hA.exists_bound_of_continuousOn (continuous_id.continuousOn)
  let C := closedBall (0 : V) R ∩ {y : V | 0 ≤ y 0}
  have hcoord : Continuous (fun y : V => y 0) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous
  have hC : IsCompact C := (isCompact_closedBall 0 R).inter_right (isClosed_le continuous_const hcoord)
  obtain ⟨K, hK⟩ := exists_holderBound_transformedForcing_closedCap hαle f (0 : V) R
  have hΩC : ((A ⊓ H : Opens V) : Set V) ⊆ C := by
    intro y hy
    exact ⟨by simpa only [mem_closedBall, dist_zero_right, id_eq] using hR y (subset_closure hy.1),
      ((mem_chartHalfSpace_iff y).mp hy.2).le⟩
  exact (hK.2.continuousOn hα).memLp_restrict_of_subset_isCompact hC
    (A ⊓ H).isOpen.measurableSet hΩC 2

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_chartKelvin_local_H2 {A D : Opens V}
    (hA : IsCompact (closure (A : Set V))) (hD : IsCompact (closure (D : Set V)))
    (hDA : closure (D : Set V) ⊆ A) (hα : 0 < α) (hαle : α ≤ 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) {u : V → ℝ}
    (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1))
    (heq : ∀ y ∈ ball (0 : V) 1, -Δ u y = DirichletHolder.domainRead (closedBall 0 1) f y)
    (v : W1p volume (A ⊓ H) 2)
    (hv : W1p.value v =ᵐ[volume.restrict ((A ⊓ H : Opens V) : Set V)] chartKelvin u)
    (hv0 : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ A →
      ∃ w : W1p0 volume (A ⊓ H) 2,
        W1p.value w.val =ᵐ[volume.restrict ((A ⊓ H : Opens V) : Set V)]
          fun y => ψ y * W1p.value v y) :
    ∃ W : Wkp volume ((A ⊓ H) ⊓ D) 2 2,
      Wkp.lowerOrder 1 W = W1p.restrictL (inf_le_left : (A ⊓ H) ⊓ D ≤ A ⊓ H) v := by
  let Ω := A ⊓ H
  have hf := memLp_transformedForcing_cap hA hα hαle f
  have huK : ContDiffOn ℝ 2 (chartKelvin u) (Ω : Set V) :=
    (contDiffOn_chartKelvin hu).mono (fun y hy => (mem_chartHalfSpace_iff y).mp hy.2)
  have heqK : ∀ y ∈ Ω, -Δ (chartKelvin u) y = transformedForcing f y := by
    intro y hy
    exact negative_laplacian_chartKelvin hu heq ((mem_chartHalfSpace_iff y).mp hy.2)
  have hΔ : MemLp (Δ (chartKelvin u)) 2 (volume.restrict (Ω : Set V)) := by
    apply hf.neg.ae_eq
    filter_upwards [ae_restrict_mem Ω.isOpen.measurableSet] with y hy
    change -(transformedForcing f y) = Δ (chartKelvin u) y
    linarith [heqK y hy]
  have hweak : ∀ w : W1p0 volume Ω 2,
      energyFormH1 (fun _ => 1) 0 0 v w.val =
        ∫ y in (Ω : Set V), (hf.toLp (transformedForcing f)) y * W1p.value w.val y := by
    intro w
    refine (energyFormH1_one_zero_zero_eq_setIntegral_neg_laplacian_mul huK hv hΔ w).trans
      (integral_congr_ae ?_)
    filter_upwards [ae_restrict_mem Ω.isOpen.measurableSet, hf.coeFn_toLp] with y hy hfy
    rw [heqK y hy, hfy]
  have hν : firstCoordinateNormal n ≠ 0 :=
    norm_ne_zero_iff.mp (by rw [norm_firstCoordinateNormal]; norm_num)
  have hH : ∀ y : V, y ∈ H ↔ (0 : ℝ) < ⟪y, firstCoordinateNormal n⟫_ℝ := by
    intro y
    change 0 < ⟪firstCoordinateNormal n, y⟫_ℝ ↔ 0 < ⟪y, firstCoordinateNormal n⟫_ℝ
    rw [real_inner_comm]
  have hΩA : (Ω : Set V) ∩ A = (H : Set V) ∩ A := by
    ext y
    change (y ∈ A ∧ y ∈ H) ∧ y ∈ A ↔ y ∈ H ∧ y ∈ A
    tauto
  have hLip : LipschitzOnWith 0 (fun _ : V => matrixBilinearForm (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ))
      ((Ω : Set V) ∩ A) := by
    intro x hx y hy
    simp only [edist_self, ENNReal.coe_zero, zero_mul, le_refl]
  exact (uniformlyEllipticOn_const_one_one ((Ω : Set V) ∩ A)).exists_lowerOrder_eq_restrictL_of_halfSpace
    hν hH hΩA hLip MemLp.zero MemLp.zero hweak hv0 hD hDA
end ConformalPoisson.SphereFlattening

end ProofPart_SphereCapSobolev

/- Proof support: SphereFlatHessian.lean, SHA256 4a17f3c1a6f9e1421284b6a667a48abc768d3b6c237baf283da73e00d95a06bc -/
noncomputable section ProofPart_SphereFlatHessian


/- The proved flat Hessian estimate applied to an actual ball solution
in sphere Kelvin coordinates. The H1, local trace, H2 and Holder forcing
obligations are all constructed from the original classical solution. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE
open scoped NNReal ContDiff ENNReal Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" => positiveNormalHalfSpace (firstCoordinateNormal n)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_holderOnWith_chartKelvin_hessian
    {A U B D : Opens V} (hA : IsCompact (closure (A : Set V)))
    (hU : IsCompact (closure (U : Set V))) (hUA : closure (U : Set V) ⊆ A)
    (hB : IsCompact (closure (B : Set V))) (hBU : closure (B : Set V) ⊆ U)
    (hD : IsCompact (closure (D : Set V))) (hDB : closure (D : Set V) ⊆ B)
    (hDrefl : MapsTo (hyperplaneReflection (firstCoordinateNormal n) 0) D D)
    (z : V) {r : ℝ} (hr : 0 ≤ r) (hz : z 0 = 0) (hAr : (A : Set V) ⊆ closedBall z r)
    {S : Set V} {R : ℝ} (hR : 0 < R) (hS : thickening R S ⊆ D)
    (hα : 0 < α) (hαlt : α < 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) (u : V → ℝ)
    (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1))
    (hc : ContinuousOn u (closedBall (0 : V) 1)) (hzero : EqOn u 0 (sphere (0 : V) 1))
    (heq : ∀ y ∈ ball (0 : V) 1, -Δ u y = DirichletHolder.domainRead (closedBall 0 1) f y) :
    ∃ K : ℝ≥0, HolderOnWith K α (fderiv ℝ (fderiv ℝ (chartKelvin u)))
      (S ∩ ((D ⊓ H : Opens V) : Set V)) := by
  obtain ⟨uB, huB, _⟩ := DirichletHolder.exists_ball_zeroTrace_representative hα f hu hc hzero heq
  obtain ⟨vA, hvA, hvA0⟩ := exists_chartKelvin_reading_with_local_zeroTrace hA hc hzero uB.val huB
  obtain ⟨W, hW⟩ := exists_chartKelvin_local_H2 hA hU hUA hα hαlt.le f hu heq vA hvA hvA0
  have hWval : Wkp.value 2 W = W1p.value (W1p.restrictL (inf_le_left : (A ⊓ H) ⊓ U ≤ A ⊓ H) vA) := by
    rw [← Wkp.value_lowerOrder_one, hW]
  have hWae : (Wkp.value 2 W : V → ℝ) =ᵐ[volume.restrict (((A ⊓ H) ⊓ U : Opens V) : Set V)]
      chartKelvin u := by
    rw [hWval]
    exact (W1p.value_restrictL_ae (inf_le_left : (A ⊓ H) ⊓ U ≤ A ⊓ H) vA).trans
      (ae_restrict_of_ae_restrict_of_subset inter_subset_left hvA)
  have hDom : (A ⊓ H) ⊓ U = U ⊓ H := by
    apply le_antisymm
    · intro y hy
      exact ⟨hy.2, hy.1.2⟩
    · intro y hy
      exact ⟨⟨hUA (subset_closure hy.1), hy.2⟩, hy.1⟩
  have hex : ∃ W : Wkp volume ((A ⊓ H) ⊓ U) 2 2,
      (Wkp.value 2 W : V → ℝ) =ᵐ[volume.restrict (((A ⊓ H) ⊓ U : Opens V) : Set V)]
        chartKelvin u := ⟨W, hWae⟩
  rw [hDom] at hex
  obtain ⟨WU, hWUae⟩ := hex
  let vU : W1p volume (U ⊓ H) 2 := Wkp.lowerOrder 1 WU
  have hWU : Wkp.value 2 WU = W1p.value vU := (Wkp.value_lowerOrder_one WU).symm
  have hvU : (W1p.value vU : V → ℝ) =ᵐ[volume.restrict ((U ⊓ H : Opens V) : Set V)] chartKelvin u := by
    rwa [← hWU]
  have hΩhalf : ((U ⊓ H : Opens V) : Set V) ⊆ {y : V | 0 < y 0} :=
    fun y hy => (mem_chartHalfSpace_iff y).mp hy.2
  have hvU0 : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ w : W1p0 volume (U ⊓ H) 2,
        W1p.value w.val =ᵐ[volume.restrict ((U ⊓ H : Opens V) : Set V)]
          fun y => ψ y * W1p.value vU y := by
    intro ψ hψ hψc hψs
    exact exists_local_zeroTrace_of_continuous_face hΩhalf
      (fun y hy => ⟨hy.2, (mem_chartHalfSpace_iff y).mpr hy.1⟩)
      (hU.isBounded.subset (fun y hy => subset_closure hy.1))
      (continuousOn_chartKelvin_closedHalfSpace hc) (chartKelvin_eq_zero_on_face hzero)
      vU hvU ψ hψ hψc hψs
  obtain ⟨K, hF⟩ := exists_holderBound_transformedForcing_closedCap hαlt.le f z r
  have hFc : HolderOnWith K α (transformedForcing f)
      (closedBall z r ∩ {y : V | 0 ≤ ⟪firstCoordinateNormal n, y⟫_ℝ}) := by
    simpa [firstCoordinateNormal, EuclideanSpace.inner_single_left] using hF.2
  have hzν : ⟪firstCoordinateNormal n, z⟫_ℝ = 0 := by
    simpa [firstCoordinateNormal, EuclideanSpace.inner_single_left] using hz
  obtain ⟨G, hG, hFG⟩ := exists_halfspace_holder_extension_of_halfBall (firstCoordinateNormal n) z hr hzν hFc
  have hUAr : (U : Set V) ⊆ closedBall z r := fun y hy => hAr (hUA (subset_closure hy))
  have heqG : EqOn (transformedForcing f) G ((U ⊓ H : Opens V) : Set V) := by
    intro y hy
    exact hFG ⟨hUAr hy.1, (show 0 < ⟪firstCoordinateNormal n, y⟫_ℝ from hy.2).le⟩
  have hfG : MemLp G 2 (volume.restrict ((U ⊓ H : Opens V) : Set V)) :=
    (memLp_transformedForcing_cap hU hα hαlt.le f).ae_eq
      (ae_restrict_of_forall_mem (U ⊓ H).isOpen.measurableSet heqG)
  have heqK : ∀ y ∈ (U ⊓ H : Opens V), -Δ (chartKelvin u) y = G y := by
    intro y hy
    exact (negative_laplacian_chartKelvin hu heq (hΩhalf hy)).trans (heqG hy)
  exact exists_holderOnWith_hessian_of_flat_dirichlet_H2 (chartKelvin u) vU WU hWU hvU
    ((contDiffOn_chartKelvin hu).mono hΩhalf) hvU0 hfG hG heqK hB hBU hD hDB hDrefl hα hαlt hR hS
end ConformalPoisson.SphereFlattening

end ProofPart_SphereFlatHessian

