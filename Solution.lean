/- Proof support: EuclideanZeroTraceValues.lean, SHA256 2662bd8837084f252bdf000febe9d4a9767a209d073f333655d269e0234bb5d0 -/
noncomputable section ProofPart_EuclideanZeroTraceValues




/- A continuous representative of an actual zero-trace Euclidean
half-space Sobolev function vanishes at every point of the face. The
trace is transported through the canonical normal splitting and Haar
identity reading; continuity removes the tangential null set. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "X" => EuclideanSpace ℝ (Fin (n + 1))
local notation "T" => EuclideanSpace ℝ (Fin n)
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

without_proof_info in
theorem continuous_eq_zero_on_face_of_zeroTrace (hp : p ≠ ⊤)
    (u : W1p0 μ (euclideanOpenHalfSpace n 0) p) {g : X → ℝ} (hg : Continuous g)
    (hu : W1p.value u.val =ᵐ[μ.restrict (euclideanOpenHalfSpace n 0 : Set X)] g) :
    ∀ z : X, z 0 = 0 → g z = 0 := by
  let e := euclideanNormalSplit n
  let H := euclideanOpenHalfSpace n 0
  let HP := normalHalfSpace (E := T) 0
  let uV := haarChangeW1pL μ volume H u.val
  have huV : uV ∈ w1p0Submodule (volume : Measure X) H p := haarChangeW1pL_zeroTrace u.property
  have huVg : W1p.value uV =ᵐ[(volume : Measure X).restrict H] g :=
    (haarChangeW1pL_value_ae (ν := volume) u.val).trans
      ((haar_restrict_absolutelyContinuous (μ := μ) (ν := volume) H).ae_eq hu)
  let uP := Wkp.compLinearIsometryEquiv (p := p) e.measurePreserving
    (normalSplit_preimage_halfSpace n 0) 1 uV
  have huP : uP ∈ w1p0Submodule (volume : Measure P) HP p := by
    have h := Wkp.compLinearIsometryEquiv_mem_wkp0Submodule e.measurePreserving
      (normalSplit_preimage_halfSpace n 0) 1
      (show uV ∈ wkp0Submodule (volume : Measure X) H p 1 by rwa [wkp0Submodule_one])
    rwa [wkp0Submodule_one] at h
  have heH : MeasurePreserving e ((volume : Measure P).restrict HP) ((volume : Measure X).restrict H) :=
    (normalSplit_preimage_halfSpace n 0) ▸ e.measurePreserving.restrict_preimage H.isOpen.measurableSet
  have huPg : W1p.value uP =ᵐ[(volume : Measure P).restrict HP] fun x => g (e x) := by
    have hv : W1p.value uP =ᵐ[(volume : Measure P).restrict HP] fun x => W1p.value uV (e x) := by
      simpa only [Wkp.value_one] using Wkp.value_compLinearIsometryEquiv_ae e.measurePreserving
        (normalSplit_preimage_halfSpace n 0) 1 uV
    exact hv.trans (heH.quasiMeasurePreserving.ae huVg)
  have htrace := W1p.halfSpaceTrace_apply_ae_of_continuousOn hp 0
    (hg.comp e.continuous).continuousOn huPg
  have htrace0 := W1p.halfSpaceTrace_eq_zero_of_w1p0 hp 0 (⟨uP, huP⟩ : W1p0 volume HP p)
  rw [htrace0] at htrace
  have hzero : (fun y : T => g (e (WithLp.toLp 2 ((0 : ℝ), y)))) =ᵐ[(volume : Measure T)] 0 := by
    filter_upwards [htrace, Lp.coeFn_zero ℝ p (volume : Measure T)] with y hy hz
    exact hy.symm.trans hz
  have hc : Continuous (fun y : T => g (e (WithLp.toLp 2 ((0 : ℝ), y)))) := by fun_prop
  have hfun := (Continuous.ae_eq_iff_eq volume hc continuous_const).1 hzero
  intro z hz
  have hfst : (e.symm z).fst = 0 := (euclideanNormalSplit_symm_fst z).trans hz
  have hPt : WithLp.toLp 2 ((0 : ℝ), (e.symm z).snd) = e.symm z := by
    apply (WithLp.ext_iff 2).2
    exact Prod.ext hfst.symm rfl
  have h := congrFun hfun (e.symm z).snd
  rw [hPt, LinearIsometryEquiv.apply_symm_apply] at h
  exact h.trans (by rfl)

without_proof_info in
theorem continuous_eq_zero_on_local_face_of_zeroTrace (hp : p ≠ ⊤)
    {Ω U D : Opens X} (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω) (hDU : D ≤ U)
    (u : W1p μ Ω p)
    (hu0 : ∀ ψ : X → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 μ Ω p, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    {g : X → ℝ} (hg : Continuous g)
    (hgu : g =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] W1p.value u) :
    ∀ z ∈ D, z 0 = 0 → g z = 0 := by
  intro z hzD hz
  obtain ⟨ψ, N, hψ, _, hψ1, hψc, hψD, _, _, _⟩ :=
    (isCompact_singleton : IsCompact ({z} : Set X)).exists_contDiff_cutoff_with_bounds
      D.isOpen (singleton_subset_iff.mpr hzD)
  have hψz : ψ z = 1 := interior_subset (hψ1 (by simp))
  have hχD : ∀ x, ψ x ≠ 0 → x ∈ D := fun x hx =>
    hψD (subset_tsupport ψ (Function.mem_support.mpr hx))
  obtain ⟨v, hv⟩ := hu0 ψ hψ hψc (hψD.trans (SetLike.coe_subset_coe.mpr hDU))
  let w := W1p0.extendByZeroL hΩH v
  have hw : W1p.value w.val =ᵐ[μ.restrict (euclideanOpenHalfSpace n 0 : Set X)]
      (Ω : Set X).indicator (W1p.value v.val) := by
    rw [W1p0.value_extendByZeroL]
    exact coeFn_extendByZeroLpₗᵢ ℝ Ω.isOpen.measurableSet
      (SetLike.coe_subset_coe.mpr hΩH) (W1p.value v.val)
  have hv' := (ae_restrict_iff' Ω.isOpen.measurableSet).1 hv
  have hgu' := (ae_restrict_iff' (Ω ⊓ D).isOpen.measurableSet).1 hgu
  have hwr : W1p.value w.val =ᵐ[μ.restrict (euclideanOpenHalfSpace n 0 : Set X)]
      fun x => ψ x * g x := by
    filter_upwards [hw, ae_restrict_of_ae hv', ae_restrict_of_ae hgu',
      ae_restrict_mem (euclideanOpenHalfSpace n 0).isOpen.measurableSet] with x hwx hvx hgx hxH
    rw [hwx]
    by_cases hxΩ : x ∈ (Ω : Set X)
    · rw [indicator_of_mem hxΩ, hvx hxΩ]
      by_cases hψ0 : ψ x = 0
      · simp only [hψ0, zero_mul]
      · rw [hgx ⟨hxΩ, hχD x hψ0⟩]
    · have hψ0 : ψ x = 0 := by
        by_contra h
        exact hxΩ (hHU ⟨hxH, hDU (hχD x h)⟩)
      rw [indicator_of_notMem hxΩ, hψ0, zero_mul]
  have hzero := continuous_eq_zero_on_face_of_zeroTrace hp w (g := fun x => ψ x * g x)
    (hψ.continuous.mul hg) hwr z hz
  rw [hψz, one_mul] at hzero
  exact hzero
end ConformalPoisson

end ProofPart_EuclideanZeroTraceValues

/- Proof support: NativeBoundaryZero.lean, SHA256 3ebc5991e1d701feda123f59f790a95c6f305761f56ab8856d9de59f9281be53 -/
