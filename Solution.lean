noncomputable section ProofPart_BoundaryAnalytic_ScalarNormalEquationReadback


/- Exact signed scalar normal-form equation from the coordinate operator.
In particular the solved normal forcing is MINUS the operator forcing. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

set_option maxHeartbeats 1400000 in
without_proof_info in
theorem scalar_normal_equation_of_coordinate_equation
    {S : Set V} (hS : UniqueDiffOn ℝ S)
    (A : V → V →L[ℝ] V) (b : V → V) (q u F : V → ℝ)
    (hu : ContDiffOn ℝ ∞ u S) {x : V} (hx : x ∈ S)
    (hAn : A x e = e) (hA0 : ∀ v : V, A x v 0 = v 0)
    (hLu : relativeCoordinateSchrodinger S A b q u x = F x) :
    normalDerivativeWithin S e 2 u x = -F x +
      ∑ i : ScalarNormalTermIndex n, scalarNormalTermCoefficient A b q i x *
        iteratedFDerivWithinAlong S (scalarNormalTermDirections i)
          (normalDerivativeWithin S e (scalarNormalTermOrder i) u) x := by
  classical
  let H := fderivWithin ℝ (fderivWithin ℝ u S) S x
  let D := fderivWithin ℝ u S x
  have hword (v w : V) : iteratedFDerivWithinAlong S [v, w] u x = H v w := by
    have h := iteratedFDerivWithinAlong_ofFn hS hu ![v, w] hx
    rw [iteratedFDerivWithin_two_apply' u hS hx] at h
    simpa [List.ofFn_succ] using h
  have hword1 (v : V) : iteratedFDerivWithinAlong S [v] u x = D v := rfl
  have hN0 : normalDerivativeWithin S e 0 u = u := rfl
  have hN1 : normalDerivativeWithin S e 1 u = fun y => fderivWithin ℝ u S y e := rfl
  have hN2 : normalDerivativeWithin S e 2 u x = H e e := by
    exact hword e e
  have hprincipal : (∑ i : Fin (n + 1), iteratedFDerivWithin ℝ 2 u S x
      ![EuclideanSpace.single i 1, A x (EuclideanSpace.single i 1)]) =
      H e e + ∑ i : Fin n, ∑ j : Fin n,
        A x (EuclideanSpace.single i.succ 1) j.succ *
          H (EuclideanSpace.single i.succ 1) (EuclideanSpace.single j.succ 1) := by
    simp_rw [iteratedFDerivWithin_two_apply' u hS hx]
    rw [Fin.sum_univ_succ, hAn]
    apply congrArg (fun z : ℝ => H e e + z)
    apply Finset.sum_congr rfl
    intro i _
    have hnormal : A x (EuclideanSpace.single i.succ 1) 0 = 0 := by rw [hA0]; simp
    nth_rw 1 [tangent_vector_eq_sum_coordinate (A x (EuclideanSpace.single i.succ 1)) hnormal]
    simp only [map_sum, map_smul, smul_eq_mul, H]
  have hbvec : b x = b x 0 • e + ∑ i : Fin n, b x i.succ • EuclideanSpace.single i.succ 1 := by
    have h := (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).sum_repr (b x)
    simpa only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply, Fin.sum_univ_succ] using h.symm
  have hfirst : D (b x) = b x 0 * D e + ∑ i : Fin n, b x i.succ * D (EuclideanSpace.single i.succ 1) := by
    nth_rw 1 [hbvec]
    simp only [map_add, map_sum, map_smul, smul_eq_mul]
  have hterms : (∑ i : ScalarNormalTermIndex n, scalarNormalTermCoefficient A b q i x *
      iteratedFDerivWithinAlong S (scalarNormalTermDirections i)
        (normalDerivativeWithin S e (scalarNormalTermOrder i) u) x) =
      -(∑ i : Fin n, ∑ j : Fin n, A x (EuclideanSpace.single i.succ 1) j.succ *
        H (EuclideanSpace.single i.succ 1) (EuclideanSpace.single j.succ 1)) +
      (∑ i : Fin n, b x i.succ * D (EuclideanSpace.single i.succ 1)) +
      (q x * u x + b x 0 * D e) := by
    simp only [Fintype.sum_sum_type, Fintype.sum_prod_type, Fintype.sum_bool,
      scalarNormalTermCoefficient, scalarNormalTermDirections, scalarNormalTermOrder,
      Bool.false_eq_true, ite_false, ite_true, hN0, hN1, iteratedFDerivWithinAlong_nil,
      hword, hword1, neg_mul, Finset.sum_neg_distrib]
    <;> ring
  change -(∑ i : Fin (n + 1), iteratedFDerivWithin ℝ 2 u S x
    ![EuclideanSpace.single i 1, A x (EuclideanSpace.single i 1)]) + D (b x) + q x * u x = F x at hLu
  rw [hprincipal, hfirst] at hLu
  rw [hN2, hterms]
  linarith

end ConformalPoisson

end ProofPart_BoundaryAnalytic_ScalarNormalEquationReadback

