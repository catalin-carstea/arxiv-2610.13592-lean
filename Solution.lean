    (hdf : ∀ y ∈ W, mvfderiv (𝓡∂ (n + 1)) f (EuclideanHalfSpace.boundaryParam n y) = 0)
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W) :
    ∀ y ∈ W, f (EuclideanHalfSpace.boundaryParam n y) = f (EuclideanHalfSpace.boundaryParam n x) := by
  have hdiff : DifferentiableOn ℝ (f ∘ EuclideanHalfSpace.boundaryParam n) W := by
    intro y hy
    obtain ⟨H, hH, _, hHb, _⟩ := exists_native_normal_representative (hf y hy)
    have he : (f ∘ EuclideanHalfSpace.boundaryParam n) = (fun z => H (z, 0)) := by
      funext z
      exact (hHb z).symm
    rw [he]
    have hp : AnalyticAt ℝ (fun z : EuclideanSpace ℝ (Fin n) => (z, (0 : ℝ))) y :=
      analyticAt_id.prod analyticAt_const
    have hhH : AnalyticAt ℝ H (y, 0) := hH
    have hcomp : AnalyticAt ℝ (fun z : EuclideanSpace ℝ (Fin n) => H (z, 0)) y :=
      hhH.comp_of_eq hp rfl
