  have hfrontier : ∀ x ∈ frontier (ball (0 : V) 1), u x = 0 := by
    rw [frontier_ball (0 : V) (by norm_num : (1 : ℝ) ≠ 0)]
    exact hzero
  obtain ⟨U, hUv, _⟩ := exists_isWeakSolutionDirichlet_laplacian_of_contDiffOn
    (Omega := B) (mu := volume) isBounded_ball hu hclosure hfrontier hΔ
  refine ⟨U, hUv, ?_⟩
  intro v
  refine (energyFormH1_one_zero_zero_eq_setIntegral_neg_laplacian_mul hu hUv hΔ v).trans ?_
  apply integral_congr_ae
  filter_upwards [self_mem_ae_restrict measurableSet_ball] with x hx
  rw [heq x hx]

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_ball_classical_and_weak_zeroDirichlet (hα : 0 < α) (hαlt : α < 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) :
    ∃ (u : V → ℝ) (U : W1p0 volume B 2), ContDiffOn ℝ 2 u (ball 0 1) ∧
      ContinuousOn u (closedBall 0 1) ∧ EqOn u 0 (sphere 0 1) ∧
      (∀ x ∈ ball 0 1, -Δ u x = domainRead (closedBall 0 1) f x) ∧
      (W1p.value U.val : V → ℝ) =ᵐ[volume.restrict (ball (0 : V) 1)] u ∧
      ∀ v : W1p0 volume B 2, energyFormH1 (fun _ => 1) 0 0 U.val (v : W1p volume B 2) =
        ∫ x in ball (0 : V) 1, domainRead (closedBall 0 1) f x * W1p.value (v : W1p volume B 2) x := by
  obtain ⟨u, hu, hc, hzero, heq⟩ := exists_ball_classical_zeroDirichlet (n := n) hα hαlt f
  obtain ⟨U, hUv, hweak⟩ := exists_ball_zeroTrace_representative (n := n) hα f hu hc hzero heq
  exact ⟨u, U, hu, hc, hzero, heq, hUv, hweak⟩
end ConformalPoisson.DirichletHolder

end ProofPart_BallClassicalSobolev

/- Proof support: FlatDirichletHessianHolder.lean, SHA256 2a04867971e513974594ac34424fbf301f33120ceb5766151b1323ab9c1d13a4 -/
noncomputable section ProofPart_FlatDirichletHessianHolder


/- Full flat-boundary Hessian Holder regularity for an actual C2
representative of a zero-Dirichlet H2 weak reading. The tangential
extension, reflected equation, classical readback, symmetry, trace and
operator-norm assembly are proved in the imported chain. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def firstCoordinateNormal (n : ℕ) : EuclideanSpace ℝ (Fin (n + 1)) := EuclideanSpace.single 0 1

without_proof_info in
theorem norm_firstCoordinateNormal (n : ℕ) : ‖firstCoordinateNormal n‖ = 1 := by
  simp only [firstCoordinateNormal, EuclideanSpace.single, PiLp.norm_single, norm_one]

without_proof_info in
theorem positiveNormalHalfSpace_firstCoordinate (n : ℕ) :
    positiveNormalHalfSpace (firstCoordinateNormal n) = euclideanOpenHalfSpace n 0 := by
  ext x
  change 0 < ⟪firstCoordinateNormal n, x⟫_ℝ ↔ 0 < x 0
  simp [firstCoordinateNormal, EuclideanSpace.inner_single_left]

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem exists_holderOnWith_hessian_of_flat_dirichlet_H2
    {U B D : Opens V} (u : V → ℝ)
    (vU : W1p volume (U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n)) 2)
    (W : Wkp volume (U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n)) 2 2)
    (hW : Wkp.value 2 W = W1p.value vU)
    (hvu : (W1p.value vU : V → ℝ) =ᵐ[volume.restrict
      ((U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n) : Opens V) : Set V)] u)
    (hu : ContDiffOn ℝ 2 u ((U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n) : Opens V) : Set V))
    (hu0 : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 volume (U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n)) 2,
        W1p.value v.val =ᵐ[volume.restrict
          ((U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n) : Opens V) : Set V)]
          fun x => ψ x * W1p.value vU x)
    {f : V → ℝ} {K α : ℝ≥0}
    (hf : MemLp f 2 (volume.restrict
      ((U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n) : Opens V) : Set V)))
    (hfHolder : HolderOnWith K α f {x | 0 ≤ ⟪firstCoordinateNormal n, x⟫_ℝ})
    (heq : ∀ x ∈ (U ⊓ positiveNormalHalfSpace (firstCoordinateNormal n) : Opens V), -Δ u x = f x)
    (hB : IsCompact (closure (B : Set V))) (hBU : closure (B : Set V) ⊆ U)
    (hD : IsCompact (closure (D : Set V))) (hDB : closure (D : Set V) ⊆ B)
    (hDrefl : MapsTo (hyperplaneReflection (firstCoordinateNormal n) 0) D D)
    {S : Set V} {R : ℝ} (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R)
    (hS : thickening R S ⊆ D) :
    ∃ L : ℝ≥0, HolderOnWith L α (fderiv ℝ (fderiv ℝ u))
      (S ∩ (D ⊓ positiveNormalHalfSpace (firstCoordinateNormal n) : Opens V)) := by
  let ν := firstCoordinateNormal n
  let H := positiveNormalHalfSpace ν
  let Ω := U ⊓ H
  let DP := D ⊓ H
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  have hDU : D ≤ U := fun x hx => hBU (subset_closure (hDB (subset_closure hx)))
  have hDom : DP ≤ Ω := fun x hx => ⟨hDU hx.1, hx.2⟩
  let vD := W1p.restrictL hDom vU
  have hvuD : (W1p.value vD : V → ℝ) =ᵐ[volume.restrict (DP : Set V)] u :=
    (W1p.value_restrictL_ae hDom vU).trans (ae_restrict_of_ae_restrict_of_subset hDom hvu)
  have huD : ContDiffOn ℝ 2 u (DP : Set V) := hu.mono hDom
  have hfD : MemLp f 2 (volume.restrict (DP : Set V)) :=
    hf.mono_measure (Measure.restrict_mono hDom le_rfl)
  have hΔae : (Δ u : V → ℝ) =ᵐ[volume.restrict (DP : Set V)] fun x => -f x := by
    filter_upwards [ae_restrict_mem DP.isOpen.measurableSet] with x hx
    linarith [heq x (hDom hx)]
  have hΔ : MemLp (Δ u) 2 (volume.restrict (DP : Set V)) := hfD.neg.ae_eq hΔae.symm
  have hweak : ∀ φ : 𝓓(DP, ℝ),
      energyFormH1 (fun _ => 1) 0 0 vD (W1p.ofTestFunctionₗ volume DP 2 φ) =
        ∫ x in (DP : Set V), f x * φ x := by
    intro φ
    have hh := energyFormH1_one_zero_zero_eq_setIntegral_neg_laplacian_mul huD hvuD hΔ
      (⟨_, W1p.ofTestFunctionₗ_mem_w1p0Submodule φ⟩ : W1p0 volume DP 2)
    refine hh.trans (integral_congr_ae ?_)
    filter_upwards [ae_restrict_mem DP.isOpen.measurableSet,
      W1p.value_ofTestFunctionₗ_ae (mu := volume) (p := 2) φ] with x hx hφx
    rw [heq x (hDom hx), hφx]
  have htan : ∀ j : Fin n, ∃ C : ℝ≥0, HolderOnWith C α
      (fun x => ∇ (fun y => fderiv ℝ u y (b j.succ)) x) (S ∩ (DP : Set V)) := by
    intro j
    obtain ⟨d, hd, _⟩ := Wkp.exists_hasWeakLineDerivOn_value_and_inner_gradient_ae_eq W (b j.succ)
    rw [hW] at hd
    have hτ : (b j.succ) 0 = 0 := by
      simp [b, EuclideanSpace.basisFun_apply, EuclideanSpace.single]
    have hΩH : Ω ≤ euclideanOpenHalfSpace n 0 := by
      rw [← positiveNormalHalfSpace_firstCoordinate n]
      exact inf_le_right
    have hHU : (euclideanOpenHalfSpace n 0 : Set V) ∩ U ⊆ Ω := by
      rw [← positiveNormalHalfSpace_firstCoordinate n]
      exact fun x hx => ⟨hx.2, hx.1⟩
    obtain ⟨w, hw0, hwval⟩ := exists_local_zeroExterior_tangential_derivative_H2
      hΩH hHU vU W hW hu0 hB hBU hD hDB (b j.succ) hτ d hd
    have hw0' : ∀ᵐ x ∂volume.restrict (D : Set V), x ∉ H → W1p.value w x = 0 := by
      simpa only [H, ν, positiveNormalHalfSpace_firstCoordinate] using hw0
    have hwval' : (W1p.value w : V → ℝ) =ᵐ[volume.restrict (DP : Set V)] (W1p.value d : V → ℝ) := by
      simpa only [DP, H, ν, positiveNormalHalfSpace_firstCoordinate] using hwval
    let dD := W1p.restrictL hDom d
    have hdD : HasWeakLineDerivOn volume DP (W1p.value vD) (W1p.value dD) (b j.succ) :=
      ((hd.mono hDom).congr_ae (W1p.value_restrictL_ae hDom vU).symm).congr_ae_deriv
        (W1p.value_restrictL_ae hDom d).symm
    have hwd : W1p.value (W1p.restrictL (inf_le_left : DP ≤ D) w) = W1p.value dD := by
      apply Lp.ext
      exact (W1p.value_restrictL_ae (inf_le_left : DP ≤ D) w).trans
        (hwval'.trans (W1p.value_restrictL_ae hDom d).symm)
    exact exists_holderOnWith_classical_gradient_of_halfspace_derivative ν (norm_firstCoordinateNormal n)
      hDrefl vD dD w hw0' hwd hα hαlt hR hS hfHolder hfD hweak (b j.succ) (b.norm_eq_one _)
      hdD (continuousOn_gradient_classical_directional huD _)
      (weak_directional_gradient_ae_eq_classical huD hvuD hdD)
  have hΔHolder : HolderOnWith K α (fun x => Δ u x) (S ∩ (DP : Set V)) := by
    intro x hx y hy
    have hDx : Δ u x = -f x := by linarith [heq x (hDom hx.2)]
    have hDy : Δ u y = -f y := by linarith [heq y (hDom hy.2)]
    change edist (Δ u x) (Δ u y) ≤ _
    rw [hDx, hDy, edist_neg_neg]
    exact hfHolder x (show 0 ≤ ⟪ν, x⟫_ℝ from (show 0 < ⟪ν, x⟫_ℝ from hx.2.2).le)
      y (show 0 ≤ ⟪ν, y⟫_ℝ from (show 0 < ⟪ν, y⟫_ℝ from hy.2.2).le)
  exact exists_holderOnWith_hessian_of_tangential_gradients huD inter_subset_right ⟨K, hΔHolder⟩ htan
end ConformalPoisson

end ProofPart_FlatDirichletHessianHolder

/- Proof support: ConformalLaplacianChain.lean, SHA256 1aa676e3d84dc6efbc5b10b302e0002134a5f97c1c785807c5dcc0004a08fc9e -/
noncomputable section ProofPart_ConformalLaplacianChain



/- The classical Laplacian chain rule at a conformal differential.
This is the geometric calculation required for the Kelvin transform;
the map's own Laplacian is retained explicitly until it is computed. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem laplacian_eq_sum_secondFDeriv_basis {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {ι : Type*} [Fintype ι] (b : OrthonormalBasis ι ℝ V) (g : V → F) (x : V) :
    Δ g x = ∑ i, fderiv ℝ (fderiv ℝ g) x (b i) (b i) := by
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis g b]
  simp only [iteratedFDeriv_two_apply, Matrix.cons_val_zero, Matrix.cons_val_one]

set_option maxHeartbeats 400000 in
without_proof_info in
theorem laplacian_comp_of_conformal_differential {g : V → ℝ} {Φ : V → V} {x : V}
    (hg : ContDiffAt ℝ 2 g (Φ x)) (hΦ : ContDiffAt ℝ 2 Φ x)
    (R : V ≃ₗᵢ[ℝ] V) (κ : ℝ) (hD : fderiv ℝ Φ x = κ • (R : V →L[ℝ] V)) :
    Δ (g ∘ Φ) x = κ ^ 2 * Δ g (Φ x) + fderiv ℝ g (Φ x) (Δ Φ x) := by
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  have hquad (i : Fin (n + 1)) :
      fderiv ℝ (fderiv ℝ g) (Φ x) (fderiv ℝ Φ x (b i)) (fderiv ℝ Φ x (b i)) =
        κ ^ 2 * fderiv ℝ (fderiv ℝ g) (Φ x) (R (b i)) (R (b i)) := by
    rw [hD]
    simp only [smul_apply, map_smul, smul_eq_mul, LinearIsometryEquiv.coe_coe'']
    ring
  have hrot := laplacian_eq_sum_secondFDeriv_basis (b.map R) g (Φ x)
  simp only [OrthonormalBasis.map_apply] at hrot
  calc
    Δ (g ∘ Φ) x = ∑ i, (fderiv ℝ (fderiv ℝ g) (Φ x)
        (fderiv ℝ Φ x (b i)) (fderiv ℝ Φ x (b i)) +
        fderiv ℝ g (Φ x) (fderiv ℝ (fderiv ℝ Φ) x (b i) (b i))) := by
      rw [laplacian_eq_sum_secondFDeriv_basis b]
      apply Finset.sum_congr rfl
      intro i hi
      exact fderiv_fderiv_comp_apply hg hΦ (b i) (b i)
    _ = κ ^ 2 * (∑ i, fderiv ℝ (fderiv ℝ g) (Φ x) (R (b i)) (R (b i))) +
        fderiv ℝ g (Φ x) (∑ i, fderiv ℝ (fderiv ℝ Φ) x (b i) (b i)) := by
      simp_rw [hquad]
      rw [Finset.sum_add_distrib, Finset.mul_sum, map_sum]
    _ = _ := by rw [← hrot, ← laplacian_eq_sum_secondFDeriv_basis b Φ x]
end ConformalPoisson

end ProofPart_ConformalLaplacianChain

/- Proof support: UnitInversionLaplacian.lean, SHA256 798c3eddc3c2ae895c0a047a1c049f6ce96d2245bc80cef3be6e60a43b97f9a0 -/
noncomputable section ProofPart_UnitInversionLaplacian




/- The actual classical differential and Laplacian of unit-sphere
inversion, and the gradient of its Kelvin weight. All identities are
away from the inversion center. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace EuclideanGeometry
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem inversion_zero_one_eq_rpow_smul (x : V) :
    inversion (0 : V) 1 x = ‖x‖ ^ (-2 : ℝ) • x := by
  simp [inversion, dist_eq_norm, one_div, Real.rpow_neg_ofNat, zpow_neg, zpow_ofNat]

without_proof_info in
theorem fderiv_unitInversion {x : V} (hx : x ≠ 0) :
    fderiv ℝ (inversion (0 : V) 1) x =
      ‖x‖ ^ (-2 : ℝ) • ((ℝ ∙ x)ᗮ.reflection : V →L[ℝ] V) := by
  simpa [dist_eq_norm, one_div, Real.rpow_neg_ofNat, zpow_neg, zpow_ofNat] using
    (EuclideanGeometry.hasFDerivAt_inversion (c := (0 : V)) (R := 1) hx).fderiv

without_proof_info in
theorem gradient_norm_rpow_eq_smul (p : ℝ) {x : V} (hx : x ≠ 0) :
    ∇ (fun y : V => ‖y‖ ^ p) x = (p * ‖x‖ ^ (p - 2)) • x := by
  apply ext_inner_left ℝ
  intro v
  calc
    ⟪v, ∇ (fun y : V => ‖y‖ ^ p) x⟫_ℝ = ⟪∇ (fun y : V => ‖y‖ ^ p) x, v⟫_ℝ := real_inner_comm _ _
    _ = fderiv ℝ (fun y : V => ‖y‖ ^ p) x v := inner_gradient_left
    _ = (p * ‖x‖ ^ (p - 2)) * ⟪x, v⟫_ℝ := by
      rw [fderiv_norm_rpow_of_ne p hx]
      simp only [smul_apply, innerSL_apply_apply, smul_eq_mul]
    _ = ⟪v, (p * ‖x‖ ^ (p - 2)) • x⟫_ℝ := by
      rw [inner_smul_right, real_inner_comm v x]

set_option maxHeartbeats 400000 in
without_proof_info in
theorem laplacian_unitInversion {x : V} (hx : x ≠ 0) :
    Δ (inversion (0 : V) 1) x =
      ((4 - 2 * ((n : ℝ) + 1)) * ‖x‖ ^ (-4 : ℝ)) • x := by
  have hI : ContDiffAt ℝ 2 (inversion (0 : V) 1) x := EuclideanGeometry.contDiffAt_inversion hx
  apply ext_inner_left ℝ
  intro a
  have hlin := hI.laplacian_CLM_comp_left (l := innerSL ℝ a)
  dsimp only [Function.comp_apply] at hlin
  have heq : (innerSL ℝ a) ∘ inversion (0 : V) 1 = fun y => ⟪a, y⟫_ℝ * ‖y‖ ^ (-2 : ℝ) := by
    funext y
    simp only [Function.comp_apply, inversion_zero_one_eq_rpow_smul, innerSL_apply_apply, inner_smul_right]
    ring
  change (innerSL ℝ a) (Δ (inversion (0 : V) 1) x) = _
  rw [← hlin, heq, laplacian_inner_mul_norm_rpow_of_ne a (-2) hx, inner_smul_right,
    finrank_euclideanSpace_fin]
  push_cast
  norm_num
  ring

set_option maxHeartbeats 400000 in
without_proof_info in
theorem laplacian_comp_unitInversion {u : V → ℝ} {x : V} (hx : x ≠ 0)
    (hu : ContDiffAt ℝ 2 u (inversion (0 : V) 1 x)) :
    Δ (u ∘ inversion (0 : V) 1) x = (‖x‖ ^ (-2 : ℝ)) ^ 2 * Δ u (inversion (0 : V) 1 x) +
      ((4 - 2 * ((n : ℝ) + 1)) * ‖x‖ ^ (-4 : ℝ)) * fderiv ℝ u (inversion (0 : V) 1 x) x := by
  have h := laplacian_comp_of_conformal_differential hu
    (EuclideanGeometry.contDiffAt_inversion hx) (ℝ ∙ x)ᗮ.reflection (‖x‖ ^ (-2 : ℝ)) (fderiv_unitInversion hx)
  simpa only [laplacian_unitInversion hx, map_smul, smul_eq_mul] using h
end ConformalPoisson

end ProofPart_UnitInversionLaplacian

/- Proof support: KelvinLaplacian.lean, SHA256 d72528c00bb849b637fe22a29d0bf30e97fab13bd8534232ff531263588c31f2 -/
noncomputable section ProofPart_KelvinLaplacian


/- The actual Kelvin-Laplacian identity. The radial weight cancels
the first-order term in the conformal inversion chain rule. No
invariance or boundary regularity result is assumed. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace EuclideanGeometry
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 400000 in
without_proof_info in
theorem inner_gradient_radial_inversion (p : ℝ) {u : V → ℝ} {x : V} (hx : x ≠ 0)
    (hu : ContDiffAt ℝ 2 u (inversion (0 : V) 1 x)) :
    ⟪∇ (fun y : V => ‖y‖ ^ p) x, ∇ (u ∘ inversion (0 : V) 1) x⟫_ℝ =
      -(p * ‖x‖ ^ (p - 4)) * fderiv ℝ u (inversion (0 : V) 1 x) x := by
  have hn : 0 < ‖x‖ := norm_pos_iff.2 hx
  have hI : DifferentiableAt ℝ (inversion (0 : V) 1) x :=
    (EuclideanGeometry.hasFDerivAt_inversion (c := (0 : V)) (R := 1) hx).differentiableAt
  have hIx : fderiv ℝ (inversion (0 : V) 1) x x = (-‖x‖ ^ (-2 : ℝ)) • x := by
    rw [fderiv_unitInversion hx, smul_apply, LinearIsometryEquiv.coe_coe'',
      Submodule.reflection_orthogonalComplement_singleton_eq_neg]
    simp only [smul_neg, neg_smul]
  have hDIgrad : fderiv ℝ (inversion (0 : V) 1) x (∇ (fun y : V => ‖y‖ ^ p) x) =
      ((p * ‖x‖ ^ (p - 2)) * (-‖x‖ ^ (-2 : ℝ))) • x := by
    rw [gradient_norm_rpow_eq_smul p hx, map_smul, hIx, smul_smul]
  have hpow : ‖x‖ ^ (p - 2) * ‖x‖ ^ (-2 : ℝ) = ‖x‖ ^ (p - 4) := by
    rw [← Real.rpow_add hn]
    congr 1; ring
  calc
    _ = fderiv ℝ u (inversion (0 : V) 1 x)
        (fderiv ℝ (inversion (0 : V) 1) x (∇ (fun y : V => ‖y‖ ^ p) x)) := by
      rw [inner_gradient_right, conj_trivial,
        fderiv_comp x (hu.differentiableAt (by norm_num)) hI, ContinuousLinearMap.comp_apply]
    _ = ((p * ‖x‖ ^ (p - 2)) * (-‖x‖ ^ (-2 : ℝ))) * fderiv ℝ u (inversion (0 : V) 1 x) x := by
      rw [hDIgrad, map_smul, smul_eq_mul]
    _ = -(p * (‖x‖ ^ (p - 2) * ‖x‖ ^ (-2 : ℝ))) * fderiv ℝ u (inversion (0 : V) 1 x) x := by ring
    _ = _ := by rw [hpow]

def kelvinTransform (u : V → ℝ) : V → ℝ :=
  fun x => ‖x‖ ^ (2 - ((n : ℝ) + 1)) * u (inversion (0 : V) 1 x)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem laplacian_kelvinTransform {u : V → ℝ} {x : V} (hx : x ≠ 0)
    (hu : ContDiffAt ℝ 2 u (inversion (0 : V) 1 x)) :
    Δ (kelvinTransform u) x = ‖x‖ ^ (-((n : ℝ) + 1) - 2) * Δ u (inversion (0 : V) 1 x) := by
  let p : ℝ := 2 - ((n : ℝ) + 1)
  have hn : 0 < ‖x‖ := norm_pos_iff.2 hx
  have hw : ContDiffAt ℝ 2 (fun y : V => ‖y‖ ^ p) x :=
    (contDiffAt_norm ℝ hx).rpow_const_of_ne (norm_ne_zero_iff.2 hx)
  have hI : ContDiffAt ℝ 2 (inversion (0 : V) 1) x := EuclideanGeometry.contDiffAt_inversion hx
  have hc : ContDiffAt ℝ 2 (u ∘ inversion (0 : V) 1) x := hu.comp x hI
  have hΔw : Δ (fun y : V => ‖y‖ ^ p) x = 0 := by
    rw [laplacian_norm_rpow_of_ne p hx, finrank_euclideanSpace_fin]
    dsimp only [p]
    push_cast
    ring
  have hpow2 : (‖x‖ ^ (-2 : ℝ)) ^ 2 = ‖x‖ ^ (-4 : ℝ) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hn.le]
    norm_num
  have hpow : ‖x‖ ^ p * ‖x‖ ^ (-4 : ℝ) = ‖x‖ ^ (p - 4) := by
    rw [← Real.rpow_add hn]
    congr 1
  change Δ (fun y : V => ‖y‖ ^ p * (u ∘ inversion (0 : V) 1) y) x = _
  rw [hw.laplacian_fun_mul hc, hΔw, mul_zero, add_zero,
    laplacian_comp_unitInversion hx hu, inner_gradient_radial_inversion p hx hu]
  calc
    _ = (‖x‖ ^ p * ‖x‖ ^ (-4 : ℝ)) * Δ u (inversion (0 : V) 1 x) +
        (4 - 2 * ((n : ℝ) + 1)) * (‖x‖ ^ p * ‖x‖ ^ (-4 : ℝ)) *
          fderiv ℝ u (inversion (0 : V) 1 x) x -
        2 * p * ‖x‖ ^ (p - 4) * fderiv ℝ u (inversion (0 : V) 1 x) x := by
      rw [hpow2]
      ring
    _ = ‖x‖ ^ (p - 4) * Δ u (inversion (0 : V) 1 x) := by
      rw [hpow]
      dsimp only [p]
      ring
    _ = _ := by
      congr 2
      dsimp only [p]
      ring
end ConformalPoisson

end ProofPart_KelvinLaplacian

/- Proof support: CenteredKelvinLaplacian.lean, SHA256 8d1955e6c09df4b2e59db5674901248e96444b544430a58975eedaccd71ea48d -/
noncomputable section ProofPart_CenteredKelvinLaplacian


/- The Kelvin identity at an arbitrary center and radius. Translation
and dilation transfer the proved unit inversion formula to the actual
inversion used by the sphere-to-half-space chart. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace EuclideanGeometry
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem inversion_eq_center_add_unit (c : V) (r : ℝ) (x : V) :
    inversion c r x = c + r ^ 2 • inversion (0 : V) 1 (x - c) := by
  rw [inversion_zero_one_eq_rpow_smul]
  simp [inversion, dist_eq_norm, Real.rpow_neg_ofNat,
    zpow_neg, zpow_ofNat, smul_smul, div_eq_mul_inv, mul_pow, inv_pow, add_comm]

def kelvinTransformAt (c : V) (r : ℝ) (u : V → ℝ) : V → ℝ :=
  fun x => ‖x - c‖ ^ (2 - ((n : ℝ) + 1)) * u (inversion c r x)

without_proof_info in
theorem contDiffAt_norm_sub_rpow (c : V) (p : ℝ) {x : V} {k : ℕ∞ω} (hx : x ≠ c) :
    ContDiffAt ℝ k (fun y : V => ‖y - c‖ ^ p) x := by
  have hsub : x - c ≠ 0 := sub_ne_zero.2 hx
  have hA : ContDiffAt ℝ k (fun y : V => y - c) x := contDiffAt_id.sub contDiffAt_const
  exact ((contDiffAt_norm ℝ hsub).rpow_const_of_ne (norm_ne_zero_iff.2 hsub)).comp x hA

without_proof_info in
theorem contDiffAt_kelvinTransformAt (c : V) (r : ℝ) {u : V → ℝ} {x : V} {k : ℕ∞ω}
    (hx : x ≠ c) (hu : ContDiffAt ℝ k u (inversion c r x)) :
    ContDiffAt ℝ k (kelvinTransformAt c r u) x :=
  (contDiffAt_norm_sub_rpow c (2 - ((n : ℝ) + 1)) hx).mul
    (hu.comp x (EuclideanGeometry.contDiffAt_inversion hx))

set_option maxHeartbeats 400000 in
without_proof_info in
theorem laplacian_kelvinTransformAt (c : V) (r : ℝ) {u : V → ℝ} {x : V} (hx : x ≠ c)
    (hu : ContDiffAt ℝ 2 u (inversion c r x)) :
    Δ (kelvinTransformAt c r u) x =
      r ^ 4 * ‖x - c‖ ^ (-((n : ℝ) + 1) - 2) * Δ u (inversion c r x) := by
  let g : V → ℝ := fun z => u (c + r ^ 2 • z)
  have himage : c + r ^ 2 • inversion (0 : V) 1 (x - c) = inversion c r x :=
    (inversion_eq_center_add_unit c r x).symm
  have hu' : ContDiffAt ℝ 2 u (c + r ^ 2 • inversion (0 : V) 1 (x - c)) := by
    simpa only [himage] using hu
  have hA : ContDiffAt ℝ 2 (fun z : V => c + r ^ 2 • z) (inversion (0 : V) 1 (x - c)) := by
    fun_prop
  have hg : ContDiffAt ℝ 2 g (inversion (0 : V) 1 (x - c)) := by
    change ContDiffAt ℝ 2 (u ∘ (fun z : V => c + r ^ 2 • z)) (inversion (0 : V) 1 (x - c))
    exact ContDiffAt.comp (f := fun z : V => c + r ^ 2 • z) (g := u)
      (inversion (0 : V) 1 (x - c)) hu' hA
  have hfun : kelvinTransformAt c r u = fun y => kelvinTransform g (y - c) := by
    funext y
    change ‖y - c‖ ^ (2 - ((n : ℝ) + 1)) * u (inversion c r y) =
      ‖y - c‖ ^ (2 - ((n : ℝ) + 1)) * u (c + r ^ 2 • inversion (0 : V) 1 (y - c))
    rw [inversion_eq_center_add_unit c r y]
  have htranslate : Δ (fun y => kelvinTransform g (y - c)) x = Δ (kelvinTransform g) (x - c) := by
    simpa only [sub_eq_add_neg] using congrFun (laplacian_comp_add_right (kelvinTransform g) (-c)) x
  have hscale (z : V) : Δ g z = r ^ 4 * Δ u (c + r ^ 2 • z) := by
    have hgfun : g = fun z => u (r ^ 2 • z + c) := by
      funext z
      dsimp only [g]
      rw [add_comm c]
    have hs := congrFun (laplacian_comp_smul_right (r ^ 2) (fun y : V => u (y + c))) z
    have ht := congrFun (laplacian_comp_add_right u c) (r ^ 2 • z)
    change Δ (fun z : V => u (r ^ 2 • z + c)) z =
      (r ^ 2) ^ 2 * Δ (fun y : V => u (y + c)) (r ^ 2 • z) at hs
    rw [ht] at hs
    rw [hgfun, hs, add_comm c]
    ring
  rw [hfun, htranslate, laplacian_kelvinTransform (sub_ne_zero.2 hx) hg, hscale, himage]
  ring
end ConformalPoisson

end ProofPart_CenteredKelvinLaplacian

