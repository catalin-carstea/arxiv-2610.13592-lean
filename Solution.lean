noncomputable section ProofPart_GreenTrace_NativeValueControlledH1






/- The native local homogeneous H1 reading is bounded by the OUTER L2
VALUE alone. Both source and target use the original basis Haar measure.
This is the quantitative input for the Hilbert closure of local smooth
solutions, rather than only for a previously bounded Green row family. -/
open Bundle Set Metric MeasureTheory TauCeti Filter TopologicalSpace Module
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

set_option maxHeartbeats 1600000 in
without_proof_info in
theorem exists_native_value_controlled_h1_reading_below
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : Continuous q)
    (c : M) (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ R₀ > 0, R₀ ≤ rMax ∧
      (closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∀ R : ℝ, 0 < R → R ≤ R₀ →
      ∃ C ≥ 0, ∀ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ u →
      (∀ x, (𝓡∂ (n + 1)).IsBoundaryPoint x → u x = 0) →
      (∀ z ∈ (boundaryChartCap (I := Ihalf) c R : Set V),
        schrodinger g q u ((extChartAt Ihalf c).symm z) = 0) →
      ∃ w : W1p (Module.finBasis ℝ V).addHaar (boundaryChartCap (I := Ihalf) c (R / 4)) 2,
        W1p.value w =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c (R / 4) : Set V)]
          u ∘ (extChartAt Ihalf c).symm ∧
        ‖w‖ ≤ C * lpNorm (u ∘ (extChartAt Ihalf c).symm) 2
          ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c R : Set V)) := by
  obtain ⟨R₀, hR₀, hRMax, htarget, hH⟩ := exists_native_halfBall_homogeneous_bound_below
    (p := (2 : ℝ≥0∞)) (by norm_num) (by norm_num) g q hq c rMax hMax
  refine ⟨R₀, hR₀, hRMax, htarget, fun R hR hRR₀ => ?_⟩
  obtain ⟨D, hD, hDall⟩ := hH R hR hRR₀
  let e := euclideanNormalSplit n
  let x₀ := e.symm (extChartAt Ihalf c c)
  let ΩP := splitBoundaryChartCap (n := n) c R
  let Ωp := splitBoundaryChartCap (n := n) c (R / 4)
  let Ωv := boundaryChartCap (I := Ihalf) c (R / 4)
  let μ : Measure V := (Module.finBasis ℝ V).addHaar
  have htargetR : closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target :=
    fun z hz => htarget ⟨closedBall_subset_closedBall hRR₀ hz.1, hz.2⟩
  obtain ⟨B, hB, hreading⟩ := exists_halfBall_value_controlled_h1_reading (p := (2 : ℝ≥0∞))
