theorem coordinatePushforward_hasCompactSupport
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (f : H → F) (hf : HasCompactSupport f) (hs : tsupport f ⊆ χ.source) :
    HasCompactSupport (coordinatePushforward χ f) :=
  (hf.image_of_continuousOn (χ.contMDiffOn_toFun.continuousOn.mono hs)).of_isClosed_subset
    (isClosed_tsupport _) (tsupport_coordinatePushforward_subset_image χ f hf hs)

