    (IB := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) (n := ∞)

local instance : LocallyCompactSpace D := D.isOpen.locallyCompactSpace

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem exists_ambient_weighted_carleman_estimate
    (p : D) (hp : (p : EuclideanSpace ℝ (Fin (n + 1))) 0 = 0)
    {q : D → ℝ} (hq : Continuous q) :
    ∃ (b η T : ℝ) (U : Opens D), 0 ≤ b ∧ 0 < η ∧ 1 ≤ T ∧ p ∈ U ∧
      ambientCarlemanWeight D p b p = 0 ∧
      (∀ x ∈ U, 0 ≤ (x : EuclideanSpace ℝ (Fin (n + 1))) 0 →
        ambientCarlemanWeight D p b x ≤ -(x : EuclideanSpace ℝ (Fin (n + 1))) 0 / 2 -
          ‖(x : EuclideanSpace ℝ (Fin (n + 1))) - (p : EuclideanSpace ℝ (Fin (n + 1)))‖ ^ 2) ∧
      ∀ τ : ℝ, T ≤ τ → ∀ u : D → ℝ,
        ContMDiff 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) 𝓘(ℝ) ∞ u →
        HasCompactSupport u → tsupport u ⊆ (U : Set D) →
        η * τ ^ 3 *
          (∫ x, Real.exp (2 * τ * ambientCarlemanWeight D p b x) * u x ^ 2
            ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) D) ≤
          ∫ x, Real.exp (2 * τ * ambientCarlemanWeight D p b x) *
            (laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) u x - q x * u x) ^ 2
              ∂riemannianVolume 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) D := by
  obtain ⟨b, c, h, w, U, hpU, hb, hc, hgap, hgeom⟩ :=
    exists_ambient_carleman_weight_bounds D p hp
  let φ := ambientCarlemanWeight D p b
  have hφ : ContMDiff 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) 𝓘(ℝ) ∞ φ :=
    contMDiff_ambientCarlemanWeight D p b
  let B := laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
    (laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) φ)
  let d : ℝ := |B p| + 1
  let Q : ℝ := |q p| + 1
  have hd : 0 ≤ d := by dsimp only [d]; positivity
  have hQ : 0 ≤ Q := by dsimp only [Q]; positivity
  have hBcont : Continuous B := (smooth_laplaceBeltrami (smooth_laplaceBeltrami hφ)).continuous
  have hBev : ∀ᶠ x in 𝓝 p, |B x| < d :=
    ((hBcont.abs).tendsto p).eventually_lt_const (by dsimp only [d]; linarith)
  have hqev : ∀ᶠ x in 𝓝 p, |q x| < Q :=
    ((hq.abs).tendsto p).eventually_lt_const (by dsimp only [Q]; linarith)
  have hall : ∀ᶠ x in 𝓝 p, x ∈ U ∧ |B x| < d ∧ |q x| < Q ∧
      b * (x : EuclideanSpace ℝ (Fin (n + 1))) 0 < 1 / 2 := by
    filter_upwards [U.isOpen.mem_nhds hpU, hBev, hqev,
      eventually_ambientCarlemanWeight_small D p b hp] with x hx hBx hqx hsmall
    exact ⟨hx, hBx, hqx, hsmall⟩
  obtain ⟨W, hW, hWopen, hpW⟩ := mem_nhds_iff.mp hall
  let W' : Opens D := ⟨W, hWopen⟩
  obtain ⟨T, hT, hestimate⟩ := exists_weighted_carleman_schrodinger_estimate_on hφ hq W
    hc hd hgap hQ (fun x hx => (hW hx).2.2.1.le)
    (fun x hx ξ => (hgeom x (hW hx).1).1 ξ)
    (fun x hx => (hgeom x (hW hx).1).2.1)
    (fun x hx => (hgeom x (hW hx).1).2.2)
    (fun x hx => (hW hx).2.1.le)
  refine ⟨b, (h - c * w) / 4, T, W', hb, div_pos hgap (by norm_num), hT, hpW,
    ambientCarlemanWeight_base D p b hp, ?_, hestimate⟩
  intro x hx ht
  exact ambientCarlemanWeight_le D p x b ht (hW hx).2.2.2.le
end ConformalPoisson

end ProofPart_AmbientCarlemanEstimate

/- Proof support: AmbientH2CarlemanEstimate.lean, SHA256 65bb75c5c5c116e4b18d6cb8e64c3435907f4a51e2d228ac458287dbdabe235d -/
noncomputable section ProofPart_AmbientH2CarlemanEstimate



/- A constructed local Carleman estimate for every H2_0 element in
one actual compact ambient chart cap. The coefficient witness and
parameter threshold are chosen before tau and the H2 element. There
is no unproved smooth-test, density, weight or operator premise. -/
open Bundle Set MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology ENNReal
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {n : ℕ} (D : Opens (EuclideanSpace ℝ (Fin (n + 1))))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ∞
    (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
  [MeasurableSpace D] [BorelSpace D]

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem exists_ambient_H2_weighted_carleman_estimate
    (p : D) (hp : (p : EuclideanSpace ℝ (Fin (n + 1))) 0 = 0)
    {q : D → ℝ} (hq : Continuous q) :
    ∃ (b η T : ℝ) (U : Opens (EuclideanSpace ℝ (Fin (n + 1))))
      (C : H2CoordinateCoefficients
        (ν := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar) (U := U)
        (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
        (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
        (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p q)),
      0 ≤ b ∧ 0 < η ∧ 1 ≤ T ∧ (p : EuclideanSpace ℝ (Fin (n + 1))) ∈ U ∧
      IsCompact (closure (U : Set (EuclideanSpace ℝ (Fin (n + 1))))) ∧
      closure (U : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆ D ∧
      ambientCarlemanWeight D p b p = 0 ∧
      (∀ x : D, (x : EuclideanSpace ℝ (Fin (n + 1))) ∈ U →
        0 ≤ (x : EuclideanSpace ℝ (Fin (n + 1))) 0 →
        ambientCarlemanWeight D p b x ≤ -(x : EuclideanSpace ℝ (Fin (n + 1))) 0 / 2 -
          ‖(x : EuclideanSpace ℝ (Fin (n + 1))) - (p : EuclideanSpace ℝ (Fin (n + 1)))‖ ^ 2) ∧
      ∀ τ : ℝ, T ≤ τ →
        ∀ u : Wkp (Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar U 2 2,
          u ∈ wkp0Submodule (Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar U 2 2 →
          η * τ ^ 3 *
            (∫ z in (U : Set _),
              ambientDensityExponentialWeight D p (ambientCarlemanWeight D p b) τ z ^ 2 *
                Wkp.value 2 u z ^ 2 ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar) ≤
            ∫ z in (U : Set _),
              ambientDensityExponentialWeight D p (ambientCarlemanWeight D p b) τ z ^ 2 *
                C.operator u z ^ 2 ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar := by
  obtain ⟨b, η, T, S, hb, hη, hT, hpS, hbase, hshape, hnative⟩ :=
    exists_ambient_weighted_carleman_estimate D p hp hq
  obtain ⟨U, hpU, hK, hKD, hUS⟩ := exists_ambient_compact_cap D p S hpS
  have hUK : (U : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆
      closure (U : Set (EuclideanSpace ℝ (Fin (n + 1)))) := fun z hz => subset_closure hz
  obtain ⟨C⟩ := exists_ambient_h2CoordinateCoefficients D
    (ν := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin (n + 1)))).addHaar)
    (U := U) (K := closure (U : Set (EuclideanSpace ℝ (Fin (n + 1)))))
    p hK hUK hKD hq
  refine ⟨b, η, T, U, C, hb, hη, hT, hpU, hK, hKD, hbase, ?_, ?_⟩
  · intro x hx ht
    exact hshape x (hUS x hx) ht
  · intro τ hτ u hu
    exact ambient_h2_weighted_coercivity_of_smooth D p
      (contMDiff_ambientCarlemanWeight D p b).continuous q hK hUK hKD C S hUS τ (η * τ ^ 3)
      (hnative τ hτ) u hu
end ConformalPoisson

end ProofPart_AmbientH2CarlemanEstimate

/- Proof support: H2LocalOperator.lean, SHA256 1c2b840e974bc4a80060fe851032ea9d0ac05f45a3dc348946a565de0b8367dc -/
noncomputable section ProofPart_H2LocalOperator



/- Local classical readback of the same bounded H2 operator. A single
coefficient witness on the outer cap is retained on every smaller open set;
the H2 representative need only be C2 on that smaller set. -/
open Set MeasureTheory TopologicalSpace TauCeti InnerProductSpace
open scoped ENNReal InnerProductSpace ContDiff Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {U V : Opens E}
  {ι : Type*} [Fintype ι]

without_proof_info in
theorem firstOrder_restrictL_two (hV : V ≤ U) (u : Wkp μ U 2 2) :
    Wkp.firstOrder 1 (Wkp.restrictL hV 2 u) =
      W1p.restrictL hV (Wkp.firstOrder 1 u) := by
  apply W1p.ext_value
  apply Lp.ext
  rw [Wkp.value_firstOrder]
  have hr := W1p.value_restrictL_ae hV (Wkp.firstOrder 1 u)
  rw [Wkp.value_firstOrder] at hr
  exact (Wkp.value_restrictL_ae hV 2 u).trans hr.symm

set_option maxHeartbeats 600000 in
without_proof_info in
theorem h2CoefficientOperator_of_contDiffOn_subdomain (hV : V ≤ U) (e : ι → E)
    (a : ι → ι → Lp ℝ ∞ (μ.restrict U)) (b : ι → Lp ℝ ∞ (μ.restrict U))
    (q : Lp ℝ ∞ (μ.restrict U)) (u : Wkp μ U 2 2)
    {f : E → ℝ} (hf : ContDiffOn ℝ 2 f V)
    (hu : Wkp.value 2 u =ᵐ[μ.restrict V] f) :
    h2CoefficientOperator e a b q u =ᵐ[μ.restrict V] fun x =>
      -(∑ i, ∑ j, a i j x * fderiv ℝ (fderiv ℝ f) x (e i) (e j)) +
      (∑ i, b i x * fderiv ℝ f x (e i)) + q x * f x := by
  let ur := Wkp.restrictL hV 2 u
  have hur : Wkp.value 2 ur =ᵐ[μ.restrict V] f :=
    (Wkp.value_restrictL_ae hV 2 u).trans hu
  have hur1 : W1p.value (Wkp.firstOrder 1 ur) =ᵐ[μ.restrict V] f := by
    rw [Wkp.value_firstOrder]
    exact hur
  have hGclass := W1p.gradient_ae_eq_of_contDiffOn (Wkp.firstOrder 1 ur)
    (hf.of_le (by norm_num)) hur1
  have hGrest : W1p.gradient (Wkp.firstOrder 1 ur) =ᵐ[μ.restrict V]
      W1p.gradient (Wkp.firstOrder 1 u) := by
    rw [show Wkp.firstOrder 1 ur = W1p.restrictL hV (Wkp.firstOrder 1 u) from
      firstOrder_restrictL_two hV u]
    exact W1p.gradient_restrictL_ae hV _
  have hG := hGrest.symm.trans hGclass
  have hHclass := Wkp.iteratedGradient_ae_eq_of_contDiffOn 1 ur
    (hf.of_le (by norm_num)) hur
  have hH := (Wkp.iteratedGradient_restrictL_ae hV 1 u).symm.trans hHclass
  have hOp := ae_restrict_of_ae_restrict_of_subset
    (SetLike.coe_subset_coe.mpr hV) (h2CoefficientOperator_ae e a b q u)
  filter_upwards [hOp, hG, hH, hu] with x hx hGx hHx hux
  rw [hx, hGx, hHx, hux]
  simp only [inner_gradient_left]
  have hs : (∑ i, ∑ j, a i j x * ⟪iteratedGradientChain f 1 x (e i), e j⟫_ℝ) =
      ∑ i, ∑ j, a i j x * fderiv ℝ (fderiv ℝ f) x (e i) (e j) := by
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    exact congrArg (fun t : ℝ => a i j x * t) (inner_iteratedGradientChain_one f x (e i) (e j))
  rw [hs]

section Euclidean
variable {d : ℕ} {ν : Measure (EuclideanSpace ℝ (Fin d))} [ν.IsAddHaarMeasure]
  {U V : Opens (EuclideanSpace ℝ (Fin d))}
  {A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)}
  {B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)}
  {Q : EuclideanSpace ℝ (Fin d) → ℝ}

set_option maxHeartbeats 600000 in
without_proof_info in
theorem H2CoordinateCoefficients.operator_of_contDiffOn_subdomain
    (C : H2CoordinateCoefficients (ν := ν) (U := U) A B Q)
    (hV : V ≤ U) (u : Wkp ν U 2 2) {f : EuclideanSpace ℝ (Fin d) → ℝ}
    (hf : ContDiffOn ℝ 2 f V) (hu : Wkp.value 2 u =ᵐ[ν.restrict V] f) :
    C.operator u =ᵐ[ν.restrict V] coordinateSchrodinger A B Q f := by
  have hAall : ∀ᵐ x ∂ν.restrict V, ∀ i j,
      C.principal i j x = (A x (EuclideanSpace.basisFun (Fin d) ℝ i)) j :=
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hV)
      (ae_all_iff.mpr fun i => ae_all_iff.mpr (C.readPrincipal i))
  have hBall : ∀ᵐ x ∂ν.restrict V, ∀ i, C.drift i x = B x i :=
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hV)
      (ae_all_iff.mpr C.readDrift)
  have hQ := ae_restrict_of_ae_restrict_of_subset
    (SetLike.coe_subset_coe.mpr hV) C.readPotential
  filter_upwards [h2CoefficientOperator_of_contDiffOn_subdomain hV
    (EuclideanSpace.basisFun (Fin d) ℝ) C.principal C.drift C.potential u hf hu,
    hAall, hBall, hQ] with x hx hax hbx hqx
  change h2CoefficientOperator _ _ _ _ u x = _
  rw [hx, coordinateSchrodinger_eq_matrix_entries]
  simp only [hax, hbx, hqx]

end Euclidean
end ConformalPoisson

end ProofPart_H2LocalOperator

/- Proof support: H2CutoffError.lean, SHA256 f50694199b66516c6d170c644cd32047aa35be10fdf51e215ebd720a5beeeef0 -/
noncomputable section ProofPart_H2CutoffError



/- The actual H2 cutoff error is confined below a negative weight
level. On the positive inner cap it equals the classical equation;
on the negative side it vanishes by locality of weak derivatives.
The separating face has Haar measure zero. No commutator estimate
or smooth continuation of the solution across that face is assumed. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ENNReal InnerProductSpace ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem ae_ne_zero_linear_functional
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    (μ : Measure E) [μ.IsAddHaarMeasure] (ℓ : E →L[ℝ] ℝ) (hℓ : ℓ ≠ 0) :
    ∀ᵐ x ∂μ, ℓ x ≠ 0 := by
  have hker : LinearMap.ker (ℓ : E →ₗ[ℝ] ℝ) ≠ ⊤ := by
    intro hk
    apply hℓ
    ext x
    have hx : x ∈ LinearMap.ker (ℓ : E →ₗ[ℝ] ℝ) := by rw [hk]; trivial
    exact hx
  have hz : μ {x : E | ℓ x = 0} = 0 := Measure.addHaar_submodule μ _ hker
  simpa only [ae_iff, not_not] using hz

variable {d : ℕ} {ν : Measure (EuclideanSpace ℝ (Fin d))} [ν.IsAddHaarMeasure]
  {U Ω : Opens (EuclideanSpace ℝ (Fin d))}
  {A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)}
  {B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)}
  {Q : EuclideanSpace ℝ (Fin d) → ℝ}

without_proof_info in
theorem H2CoordinateCoefficients.operator_eq_zero_on_subdomain
    (C : H2CoordinateCoefficients (ν := ν) (U := U) A B Q)
    {V : Opens (EuclideanSpace ℝ (Fin d))} (hV : V ≤ U)
    (u : Wkp ν U 2 2) {f : EuclideanSpace ℝ (Fin d) → ℝ}
    (hf : ContDiffOn ℝ 2 f V) (hu : Wkp.value 2 u =ᵐ[ν.restrict V] f)
    (hP : ∀ x ∈ V, coordinateSchrodinger A B Q f x = 0) :
    C.operator u =ᵐ[ν.restrict V] 0 := by
  filter_upwards [C.operator_of_contDiffOn_subdomain hV u hf hu,
    ae_restrict_mem V.isOpen.measurableSet] with x hx hxV
  exact hx.trans (hP x hxV)

set_option maxHeartbeats 900000 in
without_proof_info in
theorem H2CoordinateCoefficients.cutoff_error_weight_level
    (C : H2CoordinateCoefficients (ν := ν) (U := U) A B Q)
    (u : Wkp ν U 2 2) (ℓ : EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ) (hℓ : ℓ ≠ 0)
    {p : EuclideanSpace ℝ (Fin d)} {r : ℝ} (hr : 0 < r)
    {χ F φ : EuclideanSpace ℝ (Fin d) → ℝ}
    (hF : ContDiffOn ℝ 2 F Ω)
    (hP : ∀ x ∈ Ω, coordinateSchrodinger A B Q F x = 0)
    (hpos : ∀ x ∈ U, 0 < ℓ x → x ∈ Ω)
    (hneg : ∀ x ∈ U, ℓ x < 0 → x ∉ Ω)
    (hχ : ∀ x ∈ Metric.ball p r, χ x = 1)
    (hu : Wkp.value 2 u =ᵐ[ν.restrict U] (Ω : Set _).indicator (fun x => χ x * F x))
    (hφ : ∀ x ∈ U, 0 ≤ ℓ x → φ x ≤ -ℓ x / 2 - ‖x - p‖ ^ 2) :
    ∀ᵐ x ∂ν.restrict U, C.operator u x ≠ 0 → φ x ≤ -(r ^ 2) := by
  let V : Opens (EuclideanSpace ℝ (Fin d)) :=
    ⟨(U : Set _) ∩ {x | 0 < ℓ x} ∩ Metric.ball p r,
      (U.isOpen.inter (isOpen_lt continuous_const ℓ.continuous)).inter Metric.isOpen_ball⟩
  let N : Opens (EuclideanSpace ℝ (Fin d)) :=
    ⟨(U : Set _) ∩ {x | ℓ x < 0}, U.isOpen.inter (isOpen_lt ℓ.continuous continuous_const)⟩
  have hVU : V ≤ U := fun _ hx => hx.1.1
  have hNU : N ≤ U := fun _ hx => hx.1
  have hVΩ : (V : Set (EuclideanSpace ℝ (Fin d))) ⊆ Ω := fun x hx => hpos x hx.1.1 hx.1.2
  have hvalV : Wkp.value 2 u =ᵐ[ν.restrict V] F := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hVU) hu,
      ae_restrict_mem V.isOpen.measurableSet] with x hx hxV
    rw [hx, indicator_of_mem (hVΩ hxV), hχ x hxV.2, one_mul]
  have hvalN : Wkp.value 2 u =ᵐ[ν.restrict N] (fun _ => (0 : ℝ)) := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hNU) hu,
      ae_restrict_mem N.isOpen.measurableSet] with x hx hxN
    rw [hx, indicator_of_notMem (hneg x hxN.1 hxN.2)]
  have hzeroV : C.operator u =ᵐ[ν.restrict V] 0 :=
    C.operator_eq_zero_on_subdomain hVU u (hF.mono hVΩ) hvalV (fun x hx => hP x (hVΩ hx))
  have hzeroN : C.operator u =ᵐ[ν.restrict N] 0 := by
    apply C.operator_eq_zero_on_subdomain hNU u contDiffOn_const hvalN
    intro x _
    simp [coordinateSchrodinger]
  have hzeroV' := (ae_restrict_iff' V.isOpen.measurableSet).mp hzeroV
  have hzeroN' := (ae_restrict_iff' N.isOpen.measurableSet).mp hzeroN
  filter_upwards [ae_restrict_of_ae hzeroV', ae_restrict_of_ae hzeroN',
    ae_restrict_of_ae (ae_ne_zero_linear_functional ν ℓ hℓ),
    ae_restrict_mem U.isOpen.measurableSet] with x hxV hxN hxℓ hxU
  intro hxOp
  have ht : 0 < ℓ x := by
    rcases lt_or_gt_of_ne hxℓ with hn | hp
    · exact False.elim (hxOp (hxN ⟨hxU, hn⟩))
    · exact hp
  have hxnot : x ∉ Metric.ball p r := by
    intro hxball
    exact hxOp (hxV ⟨⟨hxU, ht⟩, hxball⟩)
  have hrnorm : r ≤ ‖x - p‖ := by
    simpa only [Metric.mem_ball, dist_eq_norm, not_lt] using hxnot
  have hsq : r ^ 2 ≤ ‖x - p‖ ^ 2 := by nlinarith [norm_nonneg (x - p)]
  have hshape := hφ x hxU ht.le
  linarith

end ConformalPoisson

end ProofPart_H2CutoffError

/- Proof support: CarlemanCutoffLimit.lean, SHA256 6e6a95c1d9e588fb467a89296451e0d140e4f916f40585919ba8b18583bc787a -/
noncomputable section ProofPart_CarlemanCutoffLimit


/- The weighted cutoff limit. A cutoff error supported below one
weight level cannot coexist with nonzero solution mass above that
level. The cubic Carleman gain gives the contradiction directly by
choosing a large real parameter, without an asymptotic premise. -/
open Set MeasureTheory Filter
open scoped Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem mass_eq_zero_of_cubic_bound {η I J T : ℝ} (hη : 0 < η) (hI : 0 ≤ I)
    (h : ∀ τ : ℝ, T ≤ τ → 1 ≤ τ → η * τ ^ 3 * I ≤ J) : I = 0 := by
  by_contra hI0
  have hIp : 0 < I := lt_of_le_of_ne hI (Ne.symm hI0)
  have hηI : 0 < η * I := mul_pos hη hIp
  let τ := max T (max 1 ((J + 1) / (η * I)))
  have hτT : T ≤ τ := le_max_left _ _
  have hτ1 : 1 ≤ τ := (le_max_left _ _).trans (le_max_right _ _)
  have hfrac : (J + 1) / (η * I) ≤ τ := (le_max_right _ _).trans (le_max_right _ _)
  have hgain : J + 1 ≤ τ * (η * I) := (div_le_iff₀ hηI).mp hfrac
  have hτ2 : 1 ≤ τ ^ 2 := by nlinarith [sq_nonneg (τ - 1)]
  have hτ3 : τ ≤ τ ^ 3 := by
    nlinarith [mul_nonneg (show 0 ≤ τ by linarith) (sub_nonneg.mpr hτ2)]
  have hmono := mul_le_mul_of_nonneg_right hτ3 hηI.le
  have hupper := h τ hτT hτ1
  nlinarith

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

set_option maxHeartbeats 800000 in
without_proof_info in
theorem weighted_mass_eq_zero_of_carleman_cutoff
    {ρ φ f g : X → ℝ} {S : Set X} {η T level : ℝ}
    (hη : 0 < η) (hρ : ∀ᵐ x ∂μ, 0 ≤ ρ x)
    (hf : Integrable (fun x => ρ x * f x ^ 2) μ)
    (hg : Integrable (fun x => ρ x * g x ^ 2) μ)
    (hφS : ∀ᵐ x ∂μ.restrict S, level ≤ φ x)
    (hφg : ∀ᵐ x ∂μ, g x ≠ 0 → φ x ≤ level)
    (hEstimate : ∀ τ : ℝ, T ≤ τ → 1 ≤ τ →
      Integrable (fun x => Real.exp (2 * τ * φ x) * (ρ x * f x ^ 2)) μ ∧
      Integrable (fun x => Real.exp (2 * τ * φ x) * (ρ x * g x ^ 2)) μ ∧
      η * τ ^ 3 * (∫ x, Real.exp (2 * τ * φ x) * (ρ x * f x ^ 2) ∂μ) ≤
        ∫ x, Real.exp (2 * τ * φ x) * (ρ x * g x ^ 2) ∂μ) :
    (∫ x in S, ρ x * f x ^ 2 ∂μ) = 0 := by
  have hmass : 0 ≤ ∫ x in S, ρ x * f x ^ 2 ∂μ :=
    integral_nonneg_of_ae ((ae_restrict_of_ae hρ).mono fun x hx => mul_nonneg hx (sq_nonneg _))
  apply mass_eq_zero_of_cubic_bound (J := ∫ x, ρ x * g x ^ 2 ∂μ) (T := T) hη hmass
  intro τ hτT hτ1
  obtain ⟨hF, hG, hcarleman⟩ := hEstimate τ hτT hτ1
  have hτ0 : 0 ≤ 2 * τ := by linarith
  have hleft : Real.exp (2 * τ * level) * (∫ x in S, ρ x * f x ^ 2 ∂μ) ≤
      ∫ x, Real.exp (2 * τ * φ x) * (ρ x * f x ^ 2) ∂μ := by
    calc
      _ ≤ ∫ x in S, Real.exp (2 * τ * φ x) * (ρ x * f x ^ 2) ∂μ := by
        rw [← integral_const_mul]
        apply integral_mono_ae ((hf.restrict (s := S)).const_mul _) (hF.restrict (s := S))
        filter_upwards [hφS, ae_restrict_of_ae hρ] with x hx hρx
        exact mul_le_mul_of_nonneg_right
          (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hx hτ0))
          (mul_nonneg hρx (sq_nonneg _))
      _ ≤ _ := setIntegral_le_integral hF (hρ.mono fun x hx =>
        mul_nonneg (Real.exp_pos _).le (mul_nonneg hx (sq_nonneg _)))
  have hright : (∫ x, Real.exp (2 * τ * φ x) * (ρ x * g x ^ 2) ∂μ) ≤
      Real.exp (2 * τ * level) * (∫ x, ρ x * g x ^ 2 ∂μ) := by
    rw [← integral_const_mul]
    apply integral_mono_ae hG (hg.const_mul _)
    filter_upwards [hφg, hρ] with x hx hρx
    by_cases hgx : g x = 0
    · simp only [hgx, zero_pow (by decide : 2 ≠ 0), mul_zero, le_refl]
    · exact mul_le_mul_of_nonneg_right
        (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left (hx hgx) hτ0))
        (mul_nonneg hρx (sq_nonneg _))
  have hcombined : Real.exp (2 * τ * level) *
      (η * τ ^ 3 * (∫ x in S, ρ x * f x ^ 2 ∂μ)) ≤
      Real.exp (2 * τ * level) * (∫ x, ρ x * g x ^ 2 ∂μ) := by
    calc
      _ = η * τ ^ 3 * (Real.exp (2 * τ * level) * (∫ x in S, ρ x * f x ^ 2 ∂μ)) := by ring
      _ ≤ η * τ ^ 3 * (∫ x, Real.exp (2 * τ * φ x) * (ρ x * f x ^ 2) ∂μ) :=
        mul_le_mul_of_nonneg_left hleft (by positivity)
      _ ≤ _ := hcarleman.trans hright
  exact (mul_le_mul_iff_right₀ (Real.exp_pos (2 * τ * level))).mp hcombined

without_proof_info in
theorem ae_eq_zero_of_integral_weighted_sq_eq_zero
    {ρ f : X → ℝ} {S : Set X}
    (hρ : ∀ᵐ x ∂μ.restrict S, 0 < ρ x)
    (hf : Integrable (fun x => ρ x * f x ^ 2) (μ.restrict S))
    (hzero : (∫ x in S, ρ x * f x ^ 2 ∂μ) = 0) :
    f =ᵐ[μ.restrict S] 0 := by
  have hnonneg : 0 ≤ᵐ[μ.restrict S] (fun x => ρ x * f x ^ 2) :=
    hρ.mono fun x hx => mul_nonneg hx.le (sq_nonneg _)
  have hz := (integral_eq_zero_iff_of_nonneg_ae hnonneg hf).mp hzero
  filter_upwards [hz, hρ] with x hx hρx
  change f x = 0
  have hx0 : ρ x * f x ^ 2 = 0 := hx
  exact sq_eq_zero_iff.mp ((mul_eq_zero.mp hx0).resolve_left (ne_of_gt hρx))

end ConformalPoisson

end ProofPart_CarlemanCutoffLimit

/- Proof support: AmbientH2CutoffVanishing.lean, SHA256 73aad8a44a99fd41fc3b76b085b05911a2bdbd89fcca05ccf1eb604e480681a8 -/
noncomputable section ProofPart_AmbientH2CutoffVanishing




/- Actual weighted H2 cutoff vanishing in the ambient metric. All
weighted integrability and positivity are supplied by the same chart
density and compact cap as the constructed Carleman estimate. -/
open Bundle Set MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold Filter
open scoped Manifold ContDiff Topology ENNReal
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {d : ℕ} (D : Opens (EuclideanSpace ℝ (Fin d)))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) ∞
    (EuclideanSpace ℝ (Fin d)) (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [MeasurableSpace D] [BorelSpace D]

local instance : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d))
    (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle
    (IB := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) (n := ∞)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integrable_ambient_H2_weighted_sq
    (p : D) {U : Opens (EuclideanSpace ℝ (Fin d))} {K : Set (EuclideanSpace ℝ (Fin d))}
    (hK : IsCompact K) (hUK : (U : Set _) ⊆ K) (hKD : K ⊆ D)
    {φ : D → ℝ} (hφ : Continuous φ) (τ : ℝ)
    (v : Lp ℝ 2 ((Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar.restrict U)) :
    Integrable (fun z =>
      Real.exp (2 * τ * φ ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm z)) *
        (chartVolumeDensity (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p
          ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm z) * v z ^ 2))
      ((Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar.restrict U) := by
  obtain ⟨w, hw⟩ := exists_ambientDensityExponentialWeight_reading D p hK hUK hKD hφ τ
  apply (integrable_sq_h2ScalarMultiplier_reading w v hw EventuallyEq.rfl).congr
  exact Eventually.of_forall fun z => by
    dsimp only
    rw [ambientDensityExponentialWeight_sq]
    ring

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem ambient_H2_ae_zero_above_error_level
    (p : D) {U : Opens (EuclideanSpace ℝ (Fin d))} {K : Set (EuclideanSpace ℝ (Fin d))}
    (hK : IsCompact K) (hUK : (U : Set _) ⊆ K) (hKD : K ⊆ D)
    {φ : D → ℝ} (hφ : Continuous φ) {q : D → ℝ}
    (C : H2CoordinateCoefficients
      (ν := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar) (U := U)
      (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q))
    (u : Wkp (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar U 2 2)
    {η T level : ℝ} (hη : 0 < η)
    (hError : ∀ᵐ z ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar.restrict U,
      C.operator u z ≠ 0 → φ ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm z) ≤ level)
    (hEstimate : ∀ τ : ℝ, T ≤ τ →
      η * τ ^ 3 * (∫ z in (U : Set _),
        ambientDensityExponentialWeight D p φ τ z ^ 2 * Wkp.value 2 u z ^ 2
          ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar) ≤
        ∫ z in (U : Set _), ambientDensityExponentialWeight D p φ τ z ^ 2 * C.operator u z ^ 2
          ∂(Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar) :
    Wkp.value 2 u =ᵐ[
      ((Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar.restrict U).restrict
        {z | level ≤ φ ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm z)}] 0 := by
  let μ := (Module.finBasis ℝ (EuclideanSpace ℝ (Fin d))).addHaar.restrict U
  let ρ := fun z => chartVolumeDensity (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p
    ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm z)
  let Φ := fun z => φ ((extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm z)
  let S := {z | level ≤ Φ z}
  have hρpos (z : EuclideanSpace ℝ (Fin d)) : 0 < ρ z := by
    apply chartVolumeDensity_pos
    rw [TangentBundle.trivializationAt_baseSet, ← extChartAt_source 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p,
      ambient_extChartAt_source]
    trivial
  have hweighted (τ : ℝ) (v : Lp ℝ 2 μ) :
      Integrable (fun z => Real.exp (2 * τ * Φ z) * (ρ z * v z ^ 2)) μ :=
    integrable_ambient_H2_weighted_sq D p hK hUK hKD hφ τ v
  have hbase (v : Lp ℝ 2 μ) : Integrable (fun z => ρ z * v z ^ 2) μ := by
    simpa only [zero_mul, mul_zero, Real.exp_zero, one_mul] using hweighted 0 v
  have hΦcont : ContinuousOn Φ (U : Set (EuclideanSpace ℝ (Fin d))) := by
    have hh := hφ.comp_continuousOn
      (continuousOn_extChartAt_symm (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
    rw [ambient_extChartAt_target] at hh
    exact hh.mono (hUK.trans hKD)
  have hSm : NullMeasurableSet S μ :=
    nullMeasurableSet_le aemeasurable_const (hΦcont.aemeasurable U.isOpen.measurableSet)
  have hz : (∫ z in S, ρ z * Wkp.value 2 u z ^ 2 ∂μ) = 0 := by
    refine weighted_mass_eq_zero_of_carleman_cutoff (μ := μ) (φ := Φ) (T := T) (level := level) hη
      (Eventually.of_forall fun z => (hρpos z).le) (hbase (Wkp.value 2 u))
      (hbase (C.operator u)) ?_ hError ?_
    · exact ae_restrict_mem₀ hSm
    · intro τ hτ _
      refine ⟨hweighted τ (Wkp.value 2 u), hweighted τ (C.operator u), ?_⟩
      have heq (v : Lp ℝ 2 μ) :
          (∫ z, ambientDensityExponentialWeight D p φ τ z ^ 2 * v z ^ 2 ∂μ) =
            ∫ z, Real.exp (2 * τ * Φ z) * (ρ z * v z ^ 2) ∂μ := by
        apply integral_congr_ae
        exact Eventually.of_forall fun z => by
          dsimp only
          rw [ambientDensityExponentialWeight_sq]
          dsimp [ρ, Φ]
          ring
      have hh := hEstimate τ hτ
      change η * τ ^ 3 * (∫ z, ambientDensityExponentialWeight D p φ τ z ^ 2 * Wkp.value 2 u z ^ 2 ∂μ) ≤
        ∫ z, ambientDensityExponentialWeight D p φ τ z ^ 2 * C.operator u z ^ 2 ∂μ at hh
      rw [heq (Wkp.value 2 u), heq (C.operator u)] at hh
      exact hh
  exact ae_eq_zero_of_integral_weighted_sq_eq_zero
    (Eventually.of_forall hρpos) ((hbase (Wkp.value 2 u)).restrict (s := S)) hz

end ConformalPoisson

end ProofPart_AmbientH2CutoffVanishing

