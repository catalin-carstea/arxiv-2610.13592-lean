  rw [(K.cutoff_weak_moment hq x D.cutoff D.smooth D.cutoff_center u hu hu0).2,
    integral_congr_ae (D.row_commutator_ae g q hGk u hu)]
  exact nativeCutoffCommutator_pairing g q D.cutoff u D.extension hq hNR
    D.smooth hu D.extension_smooth hu0 D.extension_zero_boundary

