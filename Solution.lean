noncomputable section ProofPart_InteriorAnalytic_PreconditionedInverse



/- Invertibility of the actual preconditioned local operator from the
same bounded Laplacian inverse and an explicit small perturbation. -/
namespace ConformalPoisson
variable {X Y : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

without_proof_info in
theorem isInvertible_preconditioned_of_small_perturbation
    (L : X →L[ℝ] Y) (T : Y →L[ℝ] X)
    (hleft : T.comp L = ContinuousLinearMap.id ℝ X)
    (R : X →L[ℝ] Y) (hsmall : ‖T‖ * ‖R‖ < 1) :
    (T.comp (L + R)).IsInvertible := by
  have hn : ‖-(T.comp R)‖ < 1 := by
    rw [norm_neg]
    exact (T.opNorm_comp_le R).trans_lt hsmall
  have hu : IsUnit (1 + T.comp R) := by
    simpa only [sub_neg_eq_add] using isUnit_one_sub_of_norm_lt_one hn
  have heq : T.comp (L + R) = 1 + T.comp R := by
    rw [ContinuousLinearMap.comp_add, hleft]
    rfl
  rw [← heq] at hu
  have hb := ContinuousLinearMap.isUnit_iff_bijective.mp hu
  exact ⟨ContinuousLinearEquiv.ofBijective _
    (LinearMap.ker_eq_bot.mpr hb.injective) (LinearMap.range_eq_top.mpr hb.surjective), rfl⟩

end ConformalPoisson

end ProofPart_InteriorAnalytic_PreconditionedInverse

