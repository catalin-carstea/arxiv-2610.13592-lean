  rw [Wkp.value_firstOrder] at h1
  rw [Wkp.value_firstOrder]
  exact h2.trans h1.symm

without_proof_info in
theorem cutoff_zeroTrace_restrict
    {Ω V : Opens E} (η : E → ℝ) (hηc : HasCompactSupport η) (hηV : tsupport η ⊆ V)
