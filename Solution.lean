namespace ConformalPoisson.LocalDN
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem commonGramAnalytic₁ (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω C.metricField₁.gram C.coefficientDomain :=
  fun z hz => (C.metricField₁_analytic P.metricAnalyticOn₁ hz).1.contMDiffWithinAt

without_proof_info in
theorem commonInverseAnalytic₁ (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω C.metricField₁.inverse C.coefficientDomain :=
  fun z hz => (C.metricField₁_analytic P.metricAnalyticOn₁ hz).2.contMDiffWithinAt

without_proof_info in
theorem commonGramAnalytic₂ (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω C.metricField₂.gram C.coefficientDomain :=
  fun z hz => (C.metricField₂_analytic P.metricAnalyticOn₂ hz).1.contMDiffWithinAt

without_proof_info in
theorem commonInverseAnalytic₂ (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω C.metricField₂.inverse C.coefficientDomain :=
  fun z hz => (C.metricField₂_analytic P.metricAnalyticOn₂ hz).2.contMDiffWithinAt

structure NativePairedLayerSetup (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) where
  normal₁ : GaussianNormalExtension P.metric₁ C.chart₁ (EuclideanHalfSpace.boundaryParam n C.boundaryBase)
  normal₂ : GaussianNormalExtension P.metric₂ C.chart₂ (EuclideanHalfSpace.boundaryParam n C.boundaryBase)
  collar : NativeLayerCollar C.metricField₁ C.metricField₂ C.boundaryBase
  inside₁ : MapsTo (euclideanHalfSpaceBoundaryNormalEquiv n) collar.domain normal₁.domain
  inside₂ : MapsTo (euclideanHalfSpaceBoundaryNormalEquiv n) collar.domain normal₂.domain

without_proof_info in
theorem nonempty_nativePairedLayerSetup (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    Nonempty (NativePairedLayerSetup P C) := by
  have hb₁ : EuclideanHalfSpace.boundaryParam n C.boundaryBase ∈ C.chart₁.source := C.boundaryBase_mem
  have hb₂ : EuclideanHalfSpace.boundaryParam n C.boundaryBase ∈ C.chart₂.source := C.source_eq ▸ hb₁
  obtain ⟨R₁⟩ := exists_gaussianNormalExtension P.gauge₁.neighborhood P.metricAnalyticOn₁ hb₁
    (C.target₁ (C.chart₁.map_source hb₁))
  obtain ⟨R₂⟩ := exists_gaussianNormalExtension P.gauge₂.neighborhood P.metricAnalyticOn₂ hb₂
    (C.target₂ (C.chart₂.map_source hb₂))
  obtain ⟨R⟩ := nonempty_nativeLayerCollar C.metricField₁ C.metricField₂
    (commonGramAnalytic₁ P C) (commonInverseAnalytic₁ P C) (commonGramAnalytic₂ P C) (commonInverseAnalytic₂ P C)
    C.boundaryBase hb₁
  let Q := euclideanHalfSpaceBoundaryNormalEquiv n
  let O : TopologicalSpace.Opens (Y × ℝ) :=
    ⟨Q ⁻¹' ((R₁.domain : Set _) ∩ R₂.domain), (R₁.domain.isOpen.inter R₂.domain.isOpen).preimage Q.continuous⟩
  have hQ : Q (C.boundaryBase, 0) = (EuclideanHalfSpace.boundaryParam n C.boundaryBase).val := by
    simpa only [Q, EuclideanHalfSpace.boundaryParam_coe] using euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam n C.boundaryBase
  have hbO : (C.boundaryBase, (0 : ℝ)) ∈ O := by
    change Q (C.boundaryBase, 0) ∈ (R₁.domain : Set _) ∩ R₂.domain
    rw [hQ]
    exact ⟨R₁.base_mem, R₂.base_mem⟩
  obtain ⟨R', hdom, _, _⟩ := R.exists_restrict O hbO
  refine ⟨⟨R₁, R₂, R', ?_, ?_⟩⟩
  · intro w hw
    have hO : w ∈ O := (hdom ▸ hw).2
    exact hO.1
  · intro w hw
    have hO : w ∈ O := (hdom ▸ hw).2
    exact hO.2

