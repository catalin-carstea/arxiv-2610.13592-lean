noncomputable section ProofPart_GreenTrace_BasisNormalFlux



/- The unsigned boundary flux in an arbitrary coordinate frame. A unit
normal orthogonal to the tail and pointing toward negative first coordinate
identifies the induced Gram density with the first coordinate flux. -/
open Module Set
open scoped InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {n : ℕ}

set_option maxHeartbeats 500000 in
without_proof_info in
theorem basis_normal_flux_density (b : Basis (Fin (n + 1)) ℝ E) (ν : E)
    (hunit : ⟪ν, ν⟫_ℝ = 1) (horth : ∀ i : Fin n, ⟪ν, b i.succ⟫_ℝ = 0)
    (hout : b.repr ν 0 < 0) (X : E) :
    Real.sqrt (Matrix.gram ℝ (fun i : Fin n => b i.succ)).det * ⟪ν, X⟫_ℝ =
      -Real.sqrt (Matrix.gram ℝ b).det * b.repr X 0 := by
  let : Fact (Module.finrank ℝ E = n + 1) := ⟨by
    simpa only [Fintype.card_fin] using Module.finrank_eq_card_basis b⟩
  let o := b.orientation
  let v : Fin (n + 1) → E := Fin.cons ν (fun i : Fin n => b i.succ)
  have hdet : (Matrix.gram ℝ v).det = (Matrix.gram ℝ (fun i : Fin n => b i.succ)).det := by
    rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
    simp only [v, Matrix.gram_apply, Fin.cons_zero, Fin.cons_succ, hunit, horth,
      Fin.val_zero, pow_zero, mul_one, one_mul, mul_zero, zero_mul, Finset.sum_const_zero, add_zero]
    congr 1
  have hωb : o.volumeFormL b = Real.sqrt (Matrix.gram ℝ b).det := by
    rw [Orientation.volumeFormL_apply]
    exact o.volumeForm_apply_eq_sqrt_det_gram b rfl
  have hωv : o.volumeFormL v = b.repr ν 0 * Real.sqrt (Matrix.gram ℝ b).det := by
    have h := (o.volumeFormL.toAlternatingMap).map_vecCons_removeNth_basis b ν 0
    simp only [Fin.removeNth_zero] at h
    have htail : Fin.tail (b : Fin (n + 1) → E) = (fun i : Fin n => b i.succ) := rfl
    rw [htail] at h
    simpa only [ContinuousAlternatingMap.coe_toAlternatingMap, Fin.val_zero, pow_zero,
      one_mul, smul_eq_mul, Fin.removeNth_zero, Fin.tail, hωb, v, Matrix.vecCons] using h
  have hρ : Real.sqrt (Matrix.gram ℝ (fun i : Fin n => b i.succ)).det =
      -(b.repr ν 0) * Real.sqrt (Matrix.gram ℝ b).det := by
    have h := o.abs_volumeForm_apply_eq_sqrt_det_gram v
    rw [← Orientation.volumeFormL_apply, hωv, hdet, abs_mul,
      abs_of_neg hout, abs_of_nonneg (Real.sqrt_nonneg _)] at h
    exact h.symm
  have hinner (u : E) : ⟪ν, u⟫_ℝ = b.repr u 0 * ⟪ν, b 0⟫_ℝ := by
    conv_lhs => rw [← b.sum_repr u]
    rw [inner_sum, Fin.sum_univ_succ]
    simp only [inner_smul_right, horth, mul_zero, Finset.sum_const_zero, add_zero]
  have hν : b.repr ν 0 * ⟪ν, b 0⟫_ℝ = 1 := (hinner ν).symm.trans hunit
  have hX : b.repr ν 0 * ⟪ν, X⟫_ℝ = b.repr X 0 := by
