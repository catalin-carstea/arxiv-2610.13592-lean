without_proof_info in
theorem exists_native_analytic_chart_extension {f : M → ℝ} {x : M}
    (hf : ContMDiffAt I 𝓘(ℝ) ω f x) :
    ∃ G : E → ℝ, AnalyticAt ℝ G (extChartAt I x x) ∧
      EqOn (f ∘ (extChartAt I x).symm) G (range I) ∧ G (extChartAt I x x) = f x := by
