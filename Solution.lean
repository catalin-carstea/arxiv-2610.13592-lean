without_proof_info in
theorem exists_holderOnWith_classical_gradient_of_halfspace_derivative {U : Opens V}
    (ν : V) (hν : ‖ν‖ = 1) (hU : MapsTo (hyperplaneReflection ν 0) U U)
    (u d : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) (w : W1p volume U 2)
    (hw0 : ∀ᵐ x ∂volume.restrict (U : Set V), x ∉ positiveNormalHalfSpace ν → W1p.value w x = 0)
    (hwd : W1p.value (W1p.restrictL (inf_le_left : U ⊓ positiveNormalHalfSpace ν ≤ U) w) = W1p.value d)
    {f : V → ℝ} {K α : ℝ≥0} {S : Set V} {R : ℝ}
    (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R) (hS : thickening R S ⊆ U)
    (hfHolder : HolderOnWith K α f {x | 0 ≤ ⟪ν, x⟫_ℝ})
    (hf : MemLp f 2 (volume.restrict ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V)))
    (hu : ∀ φ : 𝓓(U ⊓ positiveNormalHalfSpace ν, ℝ),
      energyFormH1 (fun _ => 1) 0 0 u (W1p.ofTestFunctionₗ volume (U ⊓ positiveNormalHalfSpace ν) 2 φ) =
        ∫ x in ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V), f x * φ x)
    (e : V) (he : ‖e‖ = 1)
    (hd : HasWeakLineDerivOn volume (U ⊓ positiveNormalHalfSpace ν) (W1p.value u) (W1p.value d) e)
    {G : V → V} (hG : ContinuousOn G ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V))
    (hgrad : (W1p.gradient d : V → V) =ᵐ[volume.restrict ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V)] G) :
    ∃ L : ℝ≥0, HolderOnWith L α G (S ∩ (U ⊓ positiveNormalHalfSpace ν : Opens V)) := by
  have hν0 : ν ≠ 0 := norm_ne_zero_iff.mp (by rw [hν]; exact one_ne_zero)
  have hEq : W1p.restrictL (inf_le_left : U ⊓ positiveNormalHalfSpace ν ≤ U) w = d := W1p.ext_value hwd
  have hweak : ∀ v : W1p0 volume (U ⊓ positiveNormalHalfSpace ν) 2,
      energyFormH1 (fun _ => 1) 0 0 (W1p.restrictL (inf_le_left : U ⊓ positiveNormalHalfSpace ν ≤ U) w)
        (v : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) =
      ∫ x in ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V),
        ⟪(-f x) • e, W1p.gradient (v : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) x⟫_ℝ := by
    rw [hEq]
