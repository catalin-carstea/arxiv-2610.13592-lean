/- One fixed contractive projection serves the tangential parameter family,
face restrictions and the final normal/tangential derivative decomposition. -/
open Set Metric
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def boundaryTangentialProjection : V →L[ℝ] V :=
  (1 / 2 : ℝ) • (ContinuousLinearMap.id ℝ V +
    (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap)

without_proof_info in
theorem boundaryTangentialProjection_apply (x : V) :
    boundaryTangentialProjection x = (1 / 2 : ℝ) • (x + boundaryReflection n x) := by
  simp [boundaryTangentialProjection]

without_proof_info in
@[simp] theorem boundaryTangentialProjection_normal (x : V) :
    boundaryTangentialProjection x 0 = 0 := by
  simp [boundaryTangentialProjection_apply]

without_proof_info in
theorem boundaryTangentialProjection_eq_self (x : V) (hx : x 0 = 0) :
    boundaryTangentialProjection x = x := by
  rw [boundaryTangentialProjection_apply, boundaryReflection_eq_self_of_tangent x hx]
  rw [smul_add, ← add_smul]
  norm_num

without_proof_info in
theorem norm_boundaryTangentialProjection_le (x : V) :
    ‖boundaryTangentialProjection x‖ ≤ ‖x‖ := by
  rw [boundaryTangentialProjection_apply, norm_smul]
  have h := norm_add_le x (boundaryReflection n x)
  rw [norm_boundaryReflection] at h
  norm_num
  linarith

without_proof_info in
theorem boundaryTangentialProjection_normal_decomposition (x : V) :
    x = boundaryTangentialProjection x + x 0 • EuclideanSpace.single 0 1 := by
  ext i
  rw [boundaryTangentialProjection_apply]
  by_cases hi : i = 0
  · subst i
    simp
  · simp [hi, Ne.symm hi]
    ring

without_proof_info in
@[simp] theorem boundaryTangentialProjection_reflection (x : V) :
    boundaryTangentialProjection (boundaryReflection n x) = boundaryTangentialProjection x := by
  simp [boundaryTangentialProjection_apply, add_comm]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryTangentialProjection

