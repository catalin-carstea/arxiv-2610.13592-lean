without_proof_info in
theorem energyFormH1_derivative_eq_divergence_forcing {Ω : Opens V}
    {u d : W1p volume Ω 2} {f : V → ℝ} {e : V}
    (hf : MemLp f 2 (volume.restrict (Ω : Set V)))
    (hu : ∀ φ : 𝓓(Ω, ℝ), energyFormH1 (fun _ => 1) 0 0 u (W1p.ofTestFunctionₗ volume Ω 2 φ) =
      ∫ x in (Ω : Set V), f x * φ x)
    (hd : HasWeakLineDerivOn volume Ω (W1p.value u) (W1p.value d) e)
