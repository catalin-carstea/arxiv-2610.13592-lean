without_proof_info in
theorem contDiffOn_chartDensity_target (c : M) :
    ContDiffOn ℝ ∞ (fun z => chartVolumeDensity (I := I) c ((extChartAt I c).symm z))
      (extChartAt I c).target := by
  apply contDiffOn_read_relativeChart (I := I) c (f := chartVolumeDensity (I := I) c)
  simpa only [TangentBundle.trivializationAt_baseSet, extChartAt_source] using
    contMDiffOn_chartVolumeDensity (I := I) (n := ∞) c

without_proof_info in
theorem contDiffOn_chartPrincipal_target (c : M) :
    ContDiffOn ℝ ∞ (chartPrincipalCoefficient (I := I) c) (extChartAt I c).target := by
  unfold chartPrincipalCoefficient inverseMetricOperator
  apply ContDiffOn.sum
  intro i hi
  apply ContDiffOn.sum
  intro j hj
  exact (contDiffOn_chartInvGram_target c i j).smul contDiffOn_const

without_proof_info in
theorem contDiffOn_chartWeightedPrincipal_entries_target (c : M) (i j : Fin d) :
    ContDiffOn ℝ ∞ (fun z => chartWeightedPrincipal (I := I) c z i j) (extChartAt I c).target :=
  coordinatePrincipalMatrix_entry_contDiffOn
