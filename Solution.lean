  [T2Space M] [SigmaCompactSpace M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
local notation "μ" => riemannianVolume I M

set_option maxHeartbeats 800000 in
without_proof_info in
theorem integral_carleman_commutator {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hc : HasCompactSupport v) (τ : ℝ) :
    (∫ x, 2 * carlemanSymmetricPart I φ τ v x * carlemanSkewPart I φ τ v x ∂μ) =
      4 * τ * (∫ x, hessian I φ x (mgradient I v x) (mgradient I v x) ∂μ) +
      4 * τ ^ 3 * (∫ x, hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2 ∂μ) -
      τ * ∫ x, v x ^ 2 * laplaceBeltrami I (laplaceBeltrami I φ) x ∂μ := by
  let T1 : M → ℝ := fun x => laplaceBeltrami I v x * ⟪mgradient I φ x, mgradient I v x⟫_ℝ
  let T2 : M → ℝ := fun x => laplaceBeltrami I v x * laplaceBeltrami I φ x * v x
  let T3 : M → ℝ := fun x => ‖mgradient I φ x‖ ^ 2 * v x * ⟪mgradient I φ x, mgradient I v x⟫_ℝ
  let T4 : M → ℝ := fun x => ‖mgradient I φ x‖ ^ 2 * laplaceBeltrami I φ x * v x ^ 2
  have hΔv := smooth_laplaceBeltrami hv
  have hΔφ := smooth_laplaceBeltrami hφ
  have hq := smooth_normSq_mgradient hφ
  have hF := smooth_inner_mgradients hφ hv
  have h1 : Integrable T1 μ :=
    (hΔv.continuous.mul hF.continuous).integrable_of_hasCompactSupport (hc.laplaceBeltrami I).mul_right
  have h2 : Integrable T2 μ :=
    ((hΔv.continuous.mul hΔφ.continuous).mul hv.continuous).integrable_of_hasCompactSupport hc.mul_left
  have h3 : Integrable T3 μ :=
    ((hq.continuous.mul hv.continuous).mul hF.continuous).integrable_of_hasCompactSupport hc.mul_left.mul_right
  have h4 : Integrable T4 μ :=
    ((hq.continuous.mul hΔφ.continuous).mul (hv.pow 2).continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_square hc).mul_left
  have hexpand : (fun x => 2 * carlemanSymmetricPart I φ τ v x * carlemanSkewPart I φ τ v x) =
      (fun x => (-4 * τ) * T1 x + (-2 * τ) * T2 x + (-4 * τ ^ 3) * T3 x + (-2 * τ ^ 3) * T4 x) := by
    funext x
    dsimp only [carlemanSymmetricPart, carlemanSkewPart, T1, T2, T3, T4]
    ring
  have hadd1 : (∫ x, (-4 * τ) * T1 x + (-2 * τ) * T2 x + (-4 * τ ^ 3) * T3 x + (-2 * τ ^ 3) * T4 x ∂μ) =
      (∫ x, (-4 * τ) * T1 x + (-2 * τ) * T2 x + (-4 * τ ^ 3) * T3 x ∂μ) +
      ∫ x, (-2 * τ ^ 3) * T4 x ∂μ := by
    simpa only [Pi.add_apply] using
      integral_add (((h1.const_mul (-4 * τ)).add (h2.const_mul (-2 * τ))).add (h3.const_mul (-4 * τ ^ 3)))
        (h4.const_mul (-2 * τ ^ 3))
  have hadd2 : (∫ x, (-4 * τ) * T1 x + (-2 * τ) * T2 x + (-4 * τ ^ 3) * T3 x ∂μ) =
      (∫ x, (-4 * τ) * T1 x + (-2 * τ) * T2 x ∂μ) + ∫ x, (-4 * τ ^ 3) * T3 x ∂μ := by
    simpa only [Pi.add_apply] using integral_add
      ((h1.const_mul (-4 * τ)).add (h2.const_mul (-2 * τ))) (h3.const_mul (-4 * τ ^ 3))
  rw [hexpand, hadd1, hadd2, integral_add (h1.const_mul (-4 * τ)) (h2.const_mul (-2 * τ)),
    integral_const_mul, integral_const_mul,
    integral_const_mul, integral_const_mul]
  dsimp only [T1, T2, T3, T4]
  rw [integral_laplacian_gradient_transport hφ hv hc,
    integral_laplacian_weight_laplacian hφ hv hc,
    integral_weight_gradient_transport hφ hv hc]
  have hcomm : (∫ x, ‖mgradient I v x‖ ^ 2 * laplaceBeltrami I φ x ∂μ) =
      ∫ x, laplaceBeltrami I φ x * ‖mgradient I v x‖ ^ 2 ∂μ :=
    integral_congr_ae (Filter.Eventually.of_forall fun x => mul_comm _ _)
  rw [hcomm]
  ring
end ConformalPoisson

end ProofPart_CarlemanCommutator

/- Proof support: CarlemanAbsorption.lean, SHA256 6fa17f2e01d2f13eeaf18020975cfe101cdc57a62a0dfe462cd0d74e51b4a2a1 -/
noncomputable section ProofPart_CarlemanAbsorption




/- The quantitative Hilbert-space absorption in the local Carleman
argument. The commutator and energy identities remain explicit data
to be proved for the actual differential operator. -/
open scoped InnerProductSpace
namespace ConformalPoisson
without_proof_info in
theorem exists_carleman_parameter_threshold {η c d Q : ℝ} (hη : 0 < η) :
    ∃ T : ℝ, 1 ≤ T ∧ ∀ τ : ℝ, T ≤ τ →
      1 ≤ τ ∧ 8 * c ^ 2 + d ≤ 2 * η * τ ∧ 4 * Q ^ 2 ≤ η * τ ^ 3 := by
  let T := max 1 (max ((8 * c ^ 2 + d) / (2 * η)) ((4 * Q ^ 2) / η))
  refine ⟨T, le_max_left _ _, ?_⟩
  intro τ hτ
  have hτ1 : 1 ≤ τ := (le_max_left 1 _).trans hτ
  have hdiv1 : (8 * c ^ 2 + d) / (2 * η) ≤ τ :=
    (le_max_left _ _).trans ((le_max_right _ _).trans hτ)
  have hdiv2 : (4 * Q ^ 2) / η ≤ τ :=
    (le_max_right _ _).trans ((le_max_right _ _).trans hτ)
  have h1 := (div_le_iff₀ (show 0 < 2 * η by positivity)).mp hdiv1
  have h2 := (div_le_iff₀ hη).mp hdiv2
  have hτ3 : τ ≤ τ ^ 3 := by nlinarith [sq_nonneg (τ - 1)]
  have hm := mul_le_mul_of_nonneg_left hτ3 hη.le
  refine ⟨hτ1, ?_, ?_⟩ <;> nlinarith

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]

set_option maxHeartbeats 500000 in
without_proof_info in
theorem carleman_coercivity_of_commutator {v A B : F} {τ c h w d G W : ℝ}
    (hτ : 1 ≤ τ) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hgap : 0 < h - c * w)
    (hlarge : 8 * c ^ 2 + d ≤ 2 * (h - c * w) * τ)
    (hW : W ≤ w * ‖v‖ ^ 2)
    (henergy : G = -⟪v, A⟫_ℝ + τ ^ 2 * W)
    (hcomm : -4 * c * τ * G + 4 * h * τ ^ 3 * ‖v‖ ^ 2 - d * τ * ‖v‖ ^ 2 ≤
      2 * ⟪A, B⟫_ℝ) :
    (h - c * w) * τ ^ 3 * ‖v‖ ^ 2 ≤ ‖A + B‖ ^ 2 := by
  have hτ0 : 0 ≤ τ := by linarith
  have hcs := abs_real_inner_le_norm v A
  have hyoung : 4 * c * τ * |⟪v, A⟫_ℝ| ≤
      (1 / 2 : ℝ) * ‖A‖ ^ 2 + 8 * c ^ 2 * τ ^ 2 * ‖v‖ ^ 2 := by
    have hm := mul_le_mul_of_nonneg_left hcs (show 0 ≤ 4 * c * τ by positivity)
    nlinarith [sq_nonneg (‖A‖ - 4 * c * τ * ‖v‖)]
  have hi := mul_le_mul_of_nonneg_left (neg_abs_le ⟪v, A⟫_ℝ)
    (show 0 ≤ 4 * c * τ by positivity)
  have hw := mul_le_mul_of_nonneg_left hW (show 0 ≤ 4 * c * τ ^ 3 by positivity)
  have hcross : -(1 / 2 : ℝ) * ‖A‖ ^ 2 +
      (4 * (h - c * w) * τ ^ 3 - 8 * c ^ 2 * τ ^ 2 - d * τ) * ‖v‖ ^ 2 ≤
        2 * ⟪A, B⟫_ℝ := by
    rw [henergy] at hcomm
    nlinarith [hyoung, hi, hw]
  have hτsq : τ ≤ τ ^ 2 := by nlinarith
  have hdτ := mul_le_mul_of_nonneg_left hτsq hd
  have hbig := mul_le_mul_of_nonneg_right hlarge (sq_nonneg τ)
  have hcoefficient : 2 * (h - c * w) * τ ^ 3 ≤
      4 * (h - c * w) * τ ^ 3 - 8 * c ^ 2 * τ ^ 2 - d * τ := by
    nlinarith [hbig, hdτ]
  have hcoefficientV := mul_le_mul_of_nonneg_right hcoefficient (sq_nonneg ‖v‖)
  rw [norm_add_sq_real]
  have hgapτ : 0 ≤ (h - c * w) * τ ^ 3 * ‖v‖ ^ 2 := by positivity
  nlinarith [hcross, hcoefficientV, sq_nonneg ‖A‖, sq_nonneg ‖B‖]

without_proof_info in
theorem carleman_absorb_bounded_potential {v P Qv : F} {a Q : ℝ}
    (hQ : 0 ≤ Q) (hlarge : 4 * Q ^ 2 ≤ a)
    (hcoercive : a * ‖v‖ ^ 2 ≤ ‖P‖ ^ 2) (hpotential : ‖Qv‖ ≤ Q * ‖v‖) :
    (a / 4) * ‖v‖ ^ 2 ≤ ‖P - Qv‖ ^ 2 := by
  have htriangle := norm_add_le (P - Qv) Qv
  rw [sub_add_cancel] at htriangle
  have hsquare : ‖P‖ ^ 2 ≤ (‖P - Qv‖ + ‖Qv‖) ^ 2 := by
    nlinarith [norm_nonneg P, norm_nonneg (P - Qv), norm_nonneg Qv]
  have hsum : ‖P‖ ^ 2 ≤ 2 * ‖P - Qv‖ ^ 2 + 2 * ‖Qv‖ ^ 2 := by
    nlinarith [sq_nonneg (‖P - Qv‖ - ‖Qv‖)]
  have hpot : ‖Qv‖ ^ 2 ≤ Q ^ 2 * ‖v‖ ^ 2 := by
    nlinarith [norm_nonneg Qv, norm_nonneg v, mul_nonneg hQ (norm_nonneg v)]
  have hlargeV := mul_le_mul_of_nonneg_right hlarge (sq_nonneg ‖v‖)
  nlinarith
end ConformalPoisson

end ProofPart_CarlemanAbsorption

/- Proof support: CarlemanEnergy.lean, SHA256 a2e09ea1a8bc84ac2cea1a814847d9b229c21a1075793e079af577959095b531 -/
noncomputable section ProofPart_CarlemanEnergy




/- Actual L2 data and the energy identity for the conjugated
Laplace--Beltrami operator. Compactly supported smooth functions give
all three L2 elements; none is introduced as an independent reading. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M] [SigmaCompactSpace M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
local notation "μ" => riemannianVolume I M

without_proof_info in
theorem memLp_carleman_parts {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hc : HasCompactSupport v) (τ : ℝ) :
    MemLp v 2 μ ∧ MemLp (carlemanSymmetricPart I φ τ v) 2 μ ∧
      MemLp (carlemanSkewPart I φ τ v) 2 μ := by
  have hA : Continuous (carlemanSymmetricPart I φ τ v) :=
    (smooth_laplaceBeltrami hv).continuous.add
      ((continuous_const.mul (smooth_normSq_mgradient hφ).continuous).mul hv.continuous)
  have hcA : HasCompactSupport (carlemanSymmetricPart I φ τ v) :=
    (hc.laplaceBeltrami I).add hc.mul_left
  have hB : Continuous (carlemanSkewPart I φ τ v) :=
    (continuous_const.mul (smooth_inner_mgradients hφ hv).continuous).sub
      ((continuous_const.mul (smooth_laplaceBeltrami hφ).continuous).mul hv.continuous)
  have hcB : HasCompactSupport (carlemanSkewPart I φ τ v) :=
    (hasCompactSupport_inner_mgradients_right hc).mul_left.sub hc.mul_left
  exact ⟨hv.continuous.memLp_of_hasCompactSupport hc,
    hA.memLp_of_hasCompactSupport hcA, hB.memLp_of_hasCompactSupport hcB⟩

set_option maxHeartbeats 500000 in
without_proof_info in
theorem integral_carleman_energy {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hc : HasCompactSupport v) (τ : ℝ) :
    (∫ x, ‖mgradient I v x‖ ^ 2 ∂μ) =
      -(∫ x, v x * carlemanSymmetricPart I φ τ v x ∂μ) +
        τ ^ 2 * ∫ x, ‖mgradient I φ x‖ ^ 2 * v x ^ 2 ∂μ := by
  have h1 : Integrable (fun x => v x * laplaceBeltrami I v x) μ :=
    (hv.continuous.mul (smooth_laplaceBeltrami hv).continuous).integrable_of_hasCompactSupport hc.mul_right
  have h2 : Integrable (fun x => ‖mgradient I φ x‖ ^ 2 * v x ^ 2) μ :=
    ((smooth_normSq_mgradient hφ).continuous.mul (hv.pow 2).continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_square hc).mul_left
  have hgreen := integral_mul_laplaceBeltrami (hv.of_le (by simp)) hc (hv.of_le (by simp))
  simp only [real_inner_self_eq_norm_sq] at hgreen
  have hexpand : (fun x => v x * carlemanSymmetricPart I φ τ v x) =
      (fun x => v x * laplaceBeltrami I v x + τ ^ 2 * (‖mgradient I φ x‖ ^ 2 * v x ^ 2)) := by
    funext x
    dsimp only [carlemanSymmetricPart]
    ring
  rw [hexpand, integral_add h1 (h2.const_mul _), integral_const_mul]
  linarith
end ConformalPoisson

end ProofPart_CarlemanEnergy

/- Proof support: CarlemanCoercivity.lean, SHA256 dca2ab05ac9192e38e7d6cfbee27410156da6eb1b5d73fe954c1e70a36a06179 -/
noncomputable section ProofPart_CarlemanCoercivity


/- A quantitative Carleman estimate under explicit geometric weight
bounds. The weight is not postulated to exist: constructing it on the
actual extended boundary chart is a separate open producer. The
commutator, L2 readings and absorption used here are all proved. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace ENNReal Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M] [SigmaCompactSpace M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
local notation "μ" => riemannianVolume I M

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integral_carleman_coercivity_of_tsupport_subset {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hvc : HasCompactSupport v)
    {S : Set M} (hvs : tsupport v ⊆ S)
    {τ c h w d : ℝ} (hτ : 1 ≤ τ) (hc : 0 ≤ c) (hd : 0 ≤ d) (hgap : 0 < h - c * w)
    (hlarge : 8 * c ^ 2 + d ≤ 2 * (h - c * w) * τ)
    (hHess : ∀ x ∈ S, ∀ (ξ : TangentSpace I x), -c * ‖ξ‖ ^ 2 ≤ hessian I φ x ξ ξ)
    (hNormal : ∀ x ∈ S, h ≤ hessian I φ x (mgradient I φ x) (mgradient I φ x))
    (hGrad : ∀ x ∈ S, ‖mgradient I φ x‖ ^ 2 ≤ w)
    (hBiLap : ∀ x ∈ S, |laplaceBeltrami I (laplaceBeltrami I φ) x| ≤ d) :
    (h - c * w) * τ ^ 3 * (∫ x, v x ^ 2 ∂μ) ≤
      ∫ x, (carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x) ^ 2 ∂μ := by
  obtain ⟨hvLp, hALp, hBLp⟩ := memLp_carleman_parts hφ hv hvc τ
  let vL : Lp ℝ 2 μ := hvLp.toLp v
  let A : Lp ℝ 2 μ := hALp.toLp (carlemanSymmetricPart I φ τ v)
  let B : Lp ℝ 2 μ := hBLp.toLp (carlemanSkewPart I φ τ v)
  have hvread : (vL : M → ℝ) =ᵐ[μ] v := hvLp.coeFn_toLp
  have hAread : (A : M → ℝ) =ᵐ[μ] carlemanSymmetricPart I φ τ v := hALp.coeFn_toLp
  have hBread : (B : M → ℝ) =ᵐ[μ] carlemanSkewPart I φ τ v := hBLp.coeFn_toLp
  have hV := normSq_L2_eq_integral_of_ae hvread
  have hVA := inner_L2_eq_integral_of_ae hvread hAread
  have hAB := inner_L2_eq_integral_of_ae hAread hBread
  have hsum : (A + B : Lp ℝ 2 μ) =ᵐ[μ]
      fun x => carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x := by
    filter_upwards [Lp.coeFn_add A B, hAread, hBread] with x hx hax hbx
    rw [hx, Pi.add_apply, hax, hbx]
  have hsumNorm := normSq_L2_eq_integral_of_ae hsum
  have hGint : Integrable (fun x => ‖mgradient I v x‖ ^ 2) μ :=
    (smooth_normSq_mgradient hv).continuous.integrable_of_hasCompactSupport (hasCompactSupport_normSq_mgradient hvc)
  have hVint : Integrable (fun x => v x ^ 2) μ :=
    (hv.pow 2).continuous.integrable_of_hasCompactSupport (hasCompactSupport_square hvc)
  have hH1int : Integrable (fun x => hessian I φ x (mgradient I v x) (mgradient I v x)) μ :=
    (contMDiff_hessian_gradient_pair hφ hv hv).continuous.integrable_of_hasCompactSupport
      (hasCompactSupport_hessian_gradient_pair hvc)
  have hH2int : Integrable (fun x => hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2) μ :=
    ((contMDiff_hessian_gradient_pair hφ hφ hφ).continuous.mul (hv.pow 2).continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_square hvc).mul_left
  have hJint : Integrable (fun x => v x ^ 2 * laplaceBeltrami I (laplaceBeltrami I φ) x) μ :=
    ((hv.pow 2).continuous.mul (smooth_laplaceBeltrami (smooth_laplaceBeltrami hφ)).continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_square hvc).mul_right
  have hWint : Integrable (fun x => ‖mgradient I φ x‖ ^ 2 * v x ^ 2) μ :=
    ((smooth_normSq_mgradient hφ).continuous.mul (hv.pow 2).continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_square hvc).mul_left
  have hvzero (x : M) (hx : x ∉ S) : v x = 0 :=
    image_eq_zero_of_notMem_tsupport (fun ht => hx (hvs ht))
  have hgzero (x : M) (hx : x ∉ S) : mgradient I v x = 0 := by
    apply mgradient_eq_zero_iff.mpr
    have hev : v =ᶠ[𝓝 x] 0 := notMem_tsupport_iff_eventuallyEq.mp (fun ht => hx (hvs ht))
    exact hev.mvfderiv_eq.trans mvfderiv_zero
  have hH1 : -c * (∫ x, ‖mgradient I v x‖ ^ 2 ∂μ) ≤
      ∫ x, hessian I φ x (mgradient I v x) (mgradient I v x) ∂μ := by
    rw [← integral_const_mul]
    apply integral_mono (hGint.const_mul _) hH1int
    intro x
    by_cases hx : x ∈ S
    · exact hHess x hx _
    · simp only [hgzero x hx, norm_zero, zero_pow (by decide : 2 ≠ 0), mul_zero,
        hessian_zero_left, le_refl]
  have hH2 : h * (∫ x, v x ^ 2 ∂μ) ≤
      ∫ x, hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2 ∂μ := by
    rw [← integral_const_mul]
    apply integral_mono (hVint.const_mul _) hH2int
    intro x
    by_cases hx : x ∈ S
    · exact mul_le_mul_of_nonneg_right (hNormal x hx) (sq_nonneg _)
    · simp only [hvzero x hx, zero_pow (by decide : 2 ≠ 0), mul_zero, le_refl]
  have hJ : (∫ x, v x ^ 2 * laplaceBeltrami I (laplaceBeltrami I φ) x ∂μ) ≤
      d * ∫ x, v x ^ 2 ∂μ := by
    rw [← integral_const_mul]
    apply integral_mono hJint (hVint.const_mul _)
    intro x
    by_cases hx : x ∈ S
    · have hj := (le_abs_self (laplaceBeltrami I (laplaceBeltrami I φ) x)).trans (hBiLap x hx)
      nlinarith [mul_le_mul_of_nonneg_left hj (sq_nonneg (v x))]
    · simp only [hvzero x hx, zero_pow (by decide : 2 ≠ 0), mul_zero, zero_mul, le_refl]
  have hW : (∫ x, ‖mgradient I φ x‖ ^ 2 * v x ^ 2 ∂μ) ≤ w * ‖vL‖ ^ 2 := by
    rw [hV, ← integral_const_mul]
    apply integral_mono hWint (hVint.const_mul _)
    intro x
    by_cases hx : x ∈ S
    · exact mul_le_mul_of_nonneg_right (hGrad x hx) (sq_nonneg _)
    · simp only [hvzero x hx, zero_pow (by decide : 2 ≠ 0), mul_zero, le_refl]
  have henergy : (∫ x, ‖mgradient I v x‖ ^ 2 ∂μ) = -⟪vL, A⟫_ℝ +
      τ ^ 2 * ∫ x, ‖mgradient I φ x‖ ^ 2 * v x ^ 2 ∂μ := by
    rw [hVA]
    exact integral_carleman_energy hφ hv hvc τ
  have hcross : 2 * ⟪A, B⟫_ℝ =
      4 * τ * (∫ x, hessian I φ x (mgradient I v x) (mgradient I v x) ∂μ) +
      4 * τ ^ 3 * (∫ x, hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2 ∂μ) -
      τ * ∫ x, v x ^ 2 * laplaceBeltrami I (laplaceBeltrami I φ) x ∂μ := by
    rw [hAB, ← integral_const_mul]
    convert integral_carleman_commutator hφ hv hvc τ using 1
    congr 1
    funext x
    ring
  have hτ0 : 0 ≤ τ := by linarith
  have hcomm : -4 * c * τ * (∫ x, ‖mgradient I v x‖ ^ 2 ∂μ) +
      4 * h * τ ^ 3 * ‖vL‖ ^ 2 - d * τ * ‖vL‖ ^ 2 ≤ 2 * ⟪A, B⟫_ℝ := by
    rw [hV, hcross]
    have hg := mul_le_mul_of_nonneg_left hH1 (show 0 ≤ 4 * τ by positivity)
    have hn := mul_le_mul_of_nonneg_left hH2 (show 0 ≤ 4 * τ ^ 3 by positivity)
    have hj := mul_le_mul_of_nonneg_left hJ hτ0
    nlinarith
  have hcoercive := carleman_coercivity_of_commutator hτ hc hd hgap hlarge hW henergy hcomm
  rwa [hV, hsumNorm] at hcoercive

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integral_carleman_coercivity {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hvc : HasCompactSupport v)
