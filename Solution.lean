/- Green/trace proof support: NativeL2ChartInverseBound.lean, SHA256 c204cb5411acb0cf08c3e49818f0b5c7fd9b0a49f198db1c913b7bbb625874f5 -/
noncomputable section ProofPart_GreenTrace_NativeL2ChartInverseBound






/- Boundedness of the existing signed nonresonant native inverse in L2.
The weak-kernel derivation is extracted from the local hker proof in
NativeWeakValueRegularity.exists_zeroDirichletSolution_of_weak_value_regularity,
with its regularity input supplied by the already proved native producer.
The same actual weak producer supplies local classical L2 chart bounds through
the proved inner reading maps. No H1 value-injectivity premise is used. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Gradient InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

/-- Scalar reciprocity of the SAME signed native zero-Dirichlet inverse. -/
def NativeInverseReciprocity (g : Metric (n := n) (M := M)) (q : M → ℝ) : Prop :=
  ∀ F H u v : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F → ContMDiff Ihalf 𝓘(ℝ) ∞ H →
    IsZeroDirichletSolution g q F u → IsZeroDirichletSolution g q H v →
      (∫ x, F x * v x ∂nativeVolume g) = ∫ x, H x * u x ∂nativeVolume g

set_option maxHeartbeats 800000 in
without_proof_info in
/-- One actual weak inverse supplies native L2 and local chart L2 controls. -/
theorem native_inverse_bounds_and_reciprocity_of_value_regularity
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hregularity : NativeWeakDirichletValueRegularity g q hq) :
    (∃ C ≥ 0,
      (∀ F u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F → IsZeroDirichletSolution g q F u →
        (eLpNorm u 2 (nativeVolume g)).toReal ≤ C * (eLpNorm F 2 (nativeVolume g)).toReal) ∧
      ∀ c : M, ∃ ρ > 0, ∃ D ≥ 0,
        (Metric.closedBall (extChartAt Ihalf c c) ρ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
        ∀ F u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F → IsZeroDirichletSolution g q F u →
          lpNorm (u ∘ (extChartAt Ihalf c).symm) 2
              ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c ρ : Set V)) +
            lpNorm (∇ (u ∘ (extChartAt Ihalf c).symm)) 2
              ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c ρ : Set V)) ≤
            D * (eLpNorm F 2 (nativeVolume g)).toReal) ∧ NativeInverseReciprocity g q := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let B := (Ihalf).boundary M
  let Q := ContinuousMap.toLp ⊤ (riemannianVolume Ihalf M) ℝ ⟨q, hq.continuous⟩
  have hker : ∀ u : DirichletSobolev.zeroTraceSubmodule (I := Ihalf) B,
      (∀ v, DirichletSobolev.schrodingerForm B Q u v = 0) → u = 0 := by
    intro u hu
    have hweak : ∀ v, DirichletSobolev.schrodingerForm B Q u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ
          (⟨(0 : M → ℝ), continuous_const⟩ : C(M, ℝ)), DirichletSobolev.valueL B v⟫_ℝ := by
      intro v
      have hzero : ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ
          (⟨(0 : M → ℝ), continuous_const⟩ : C(M, ℝ)) = 0 := by
        change ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ 0 = 0
        exact map_zero _
      rw [hzero, inner_zero_left]
      exact hu v
    obtain ⟨w, hw, hvalue⟩ := hregularity 0 contMDiff_const u hweak
    have hwzero : w = 0 := hNR w ⟨hw.1, hw.2.1, hw.2.2⟩
    have hc : (⟨w, hw.1.continuous⟩ : C(M, ℝ)) = 0 := by
      ext x
      exact congrFun hwzero x
    have hvaluezero : DirichletSobolev.valueL B u = 0 := by rw [hvalue, hc, map_zero]
    have hgarding := DirichletSobolev.schrodingerForm_garding B Q u
    rw [hu u, hvaluezero, norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0),
      mul_zero, add_zero] at hgarding
    exact norm_eq_zero.mp (by nlinarith [norm_nonneg u])
  obtain ⟨C, hC, hbound⟩ := norm_weak_solution_le_mul_forcing_of_garding
    (C₀ := 1) (β := ‖Q‖ + 1) (B := DirichletSobolev.schrodingerForm B Q)
    (nativeZeroTraceCompactness g) (by norm_num)
    (fun u => by simpa only [one_mul] using DirichletSobolev.schrodingerForm_garding B Q u) hker
  have hlift : ∀ (F u : M → ℝ), ∀ (hF : ContMDiff Ihalf 𝓘(ℝ) ∞ F)
      (hu : IsZeroDirichletSolution g q F u),
      ∃ U : DirichletSobolev.zeroTraceSubmodule (I := Ihalf) B,
        (∀ v, DirichletSobolev.schrodingerForm B Q U v =
          ⟪ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ ⟨F, hF.continuous⟩,
            DirichletSobolev.valueL B v⟫_ℝ) ∧
        ‖U‖ ≤ C * (eLpNorm F 2 (nativeVolume g)).toReal ∧
        (DirichletSobolev.valueL B U : M → ℝ) =ᵐ[riemannianVolume Ihalf M] u := by
    intro F u hF hu
    let F₂ := ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ ⟨F, hF.continuous⟩
    obtain ⟨U, hU, _⟩ := DirichletSobolev.existsUnique_weakSolution_of_compact_value_of_trivial_kernel
      B Q (nativeZeroTraceCompactness g) hker F₂
    obtain ⟨w, hw, hvalue⟩ := hregularity F hF U hU
    have hwu : w = u := hNR.zeroDirichlet_solution_unique hw hu
    have hFnorm : ‖F₂‖ = (eLpNorm F 2 (nativeVolume g)).toReal := by
      exact norm_continuousMap_toLp ⟨F, hF.continuous⟩
    refine ⟨U, hU, ?_, ?_⟩
    · rw [← hFnorm]
      exact hbound F₂ U hU
