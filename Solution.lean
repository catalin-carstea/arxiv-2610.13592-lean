without_proof_info in
theorem principal_factor_of_normalized
    (A : V →L[ℝ] V) (T : V ≃L[ℝ] V)
    (hT : principalCongruence T.symm.toContinuousLinearMap A = ContinuousLinearMap.id ℝ V) :
    A = T.toContinuousLinearMap.comp T.toContinuousLinearMap.adjoint := by
  have h := congrArg (principalCongruence T.toContinuousLinearMap) hT
  rw [principalCongruence_equiv_inverse] at h
  apply h.trans
  apply ContinuousLinearMap.ext
  intro v
  simp [principalCongruence_apply]

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem exists_boundary_preserving_principal_normalization
    (A : V →L[ℝ] V) (T : V ≃L[ℝ] V)
    (hT : principalCongruence T.symm.toContinuousLinearMap A = ContinuousLinearMap.id ℝ V)
    (hAn : A e = e) :
    ∃ T' : V ≃L[ℝ] V,
      principalCongruence T'.symm.toContinuousLinearMap A = ContinuousLinearMap.id ℝ V ∧
      T' e = e ∧ ∀ v : V, T' v 0 = v 0 := by
  let v : V := T.toContinuousLinearMap.adjoint e
  have hfactor := principal_factor_of_normalized A T hT
  have hTv : T v = e := by
    change (T.toContinuousLinearMap.comp T.toContinuousLinearMap.adjoint) e = e
    rw [← hfactor, hAn]
  have hvinner : ⟪v, v⟫_ℝ = 1 := by
    change ⟪T.toContinuousLinearMap.adjoint e, v⟫_ℝ = 1
    rw [ContinuousLinearMap.adjoint_inner_left]
    change ⟪e, T v⟫_ℝ = 1
    rw [hTv]
    simp
  have hvnorm : ‖v‖ = 1 := by
    rw [real_inner_self_eq_norm_sq] at hvinner
    nlinarith [norm_nonneg v]
  let U : V ≃ₗᵢ[ℝ] V := (ℝ ∙ (e - v))ᗮ.reflection
  have hUe : U e = v := Submodule.reflection_sub (by simpa using hvnorm.symm)
  let T' : V ≃L[ℝ] V := U.toContinuousLinearEquiv.trans T
  have hT'e : T' e = e := by
    change T (U e) = e
    rw [hUe, hTv]
  have hinverse : T'.symm.toContinuousLinearMap =
      U.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp T.symm.toContinuousLinearMap := by
    apply ContinuousLinearMap.ext
    intro z
    simp [T']
  have hAdjU : (U.symm.toContinuousLinearEquiv.toContinuousLinearMap).adjoint =
      U.toContinuousLinearEquiv.toContinuousLinearMap := by
    rw [LinearIsometryEquiv.adjoint_eq_symm]
    rfl
  have hT' : principalCongruence T'.symm.toContinuousLinearMap A = ContinuousLinearMap.id ℝ V := by
    rw [hinverse, ← principalCongruence_comp, hT]
    apply ContinuousLinearMap.ext
    intro z
    rw [principalCongruence_apply, hAdjU]
    change U.symm (U z) = z
    exact U.symm_apply_apply z
  have hfactor' := principal_factor_of_normalized A T' hT'
  have hadj : T'.toContinuousLinearMap.adjoint e = e := by
    apply T'.injective
    change (T'.toContinuousLinearMap.comp T'.toContinuousLinearMap.adjoint) e = T' e
    rw [← hfactor', hAn, hT'e]
  refine ⟨T', hT', hT'e, ?_⟩
  intro z
  have h := T'.toContinuousLinearMap.adjoint_inner_left z e
  rw [hadj] at h
  simpa [EuclideanSpace.inner_single_left] using h.symm

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryPrincipalNormalization

/- Boundary analytic support: BoundaryLinearCongruence.lean, SHA256 d5265e6b26f85a14f64c08f9bcac1628ca5f041602e97e1aa3047c02d062661c -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryLinearCongruence




/- The normal block of the principal coefficient is preserved by the
actual boundary-preserving affine normalization. -/
open Set InnerProductSpace
open scoped InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

without_proof_info in
theorem adjoint_normal_of_preserves_normal_coordinate
    (L : V →L[ℝ] V) (hL : ∀ v : V, L v 0 = v 0) : L.adjoint e = e := by
  apply ext_inner_right ℝ
  intro v
  rw [ContinuousLinearMap.adjoint_inner_left]
  simp [EuclideanSpace.inner_single_left, hL]

without_proof_info in
theorem preserves_normal_coordinate_of_adjoint_normal
    (L : V →L[ℝ] V) (hL : L.adjoint e = e) (v : V) : L v 0 = v 0 := by
  have h := L.adjoint_inner_left v e
  rw [hL] at h
  simpa [EuclideanSpace.inner_single_left] using h.symm

without_proof_info in
theorem boundary_linear_inverse_normal (T : V ≃L[ℝ] V) (hT : T e = e) : T.symm e = e := by
  apply T.injective
  rw [T.apply_symm_apply, hT]

without_proof_info in
theorem boundary_linear_inverse_coordinate (T : V ≃L[ℝ] V)
    (hT : ∀ v : V, T v 0 = v 0) (v : V) : T.symm v 0 = v 0 := by
  have h := hT (T.symm v)
  simpa only [T.apply_symm_apply] using h.symm

without_proof_info in
theorem principalCongruence_preserves_boundary_normal
    (A : V →L[ℝ] V) (T : V ≃L[ℝ] V)
    (hTn : T e = e) (hTc : ∀ v : V, T v 0 = v 0)
    (hAn : A e = e) (hAc : ∀ v : V, A v 0 = v 0) :
    principalCongruence T.symm.toContinuousLinearMap A e = e ∧
      ∀ v : V, principalCongruence T.symm.toContinuousLinearMap A v 0 = v 0 := by
  let L := T.symm.toContinuousLinearMap
  have hLc : ∀ v : V, L v 0 = v 0 := boundary_linear_inverse_coordinate T hTc
  have hLn : L e = e := boundary_linear_inverse_normal T hTn
  have hLa := adjoint_normal_of_preserves_normal_coordinate L hLc
  constructor
  · rw [principalCongruence_apply, hLa, hAn, hLn]
  · intro v
    rw [principalCongruence_apply, hLc, hAc]
    exact preserves_normal_coordinate_of_adjoint_normal L.adjoint
      (by rw [ContinuousLinearMap.adjoint_adjoint]; exact hLn) v

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryLinearCongruence

/- Boundary analytic support: BoundaryFaceTaylor.lean, SHA256 3a7a86510cdbb849444b9d192b35c376befecdcf2fd1c61909b699f34f9665f7 -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryFaceTaylor



/- Taylor coefficients after an actual affine restriction to a zero face.
No ambient extension or analyticity of the unknown is assumed. -/
open Set Metric
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem taylorCoefficient_affine_restriction_eq_zero
    {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    [NormedAddCommGroup G] [NormedSpace ℝ G]
    {N : ℕ∞ω} {f : E → F} {p : E → FormalMultilinearSeries ℝ E F}
    {S : Set E} (hp : HasFTaylorSeriesUpToOn N f p S)
    (g : G →ᴬ[ℝ] E) {U : Set G} (hU : IsOpen U)
    (hg : MapsTo g U S) (hzero : ∀ y ∈ U, f (g y) = 0)
    {z : G} (hz : z ∈ U) {k : ℕ} (hk : k ≤ N) :
    (p (g z) k).compContinuousLinearMap (fun _ => g.contLinear) = 0 := by
  have hseries := (hp.comp_continuousAffineMap g).mono hg
  have hzeroSeries : HasFTaylorSeriesUpToOn N (fun _ : G => (0 : F))
      (fun y j => (p (g y) j).compContinuousLinearMap (fun _ => g.contLinear)) U :=
    hseries.congr (fun y hy => (hzero y hy).symm)
  have heq := hzeroSeries.eq_iteratedFDerivWithin_of_uniqueDiffOn hk hU.uniqueDiffOn hz
  simpa using heq

variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def boundaryFaceAffine (x : V) : V →ᴬ[ℝ] V :=
  ContinuousAffineMap.const ℝ V x +
    (boundaryTangentialProjection : V →L[ℝ] V).toContinuousAffineMap

without_proof_info in
@[simp] theorem boundaryFaceAffine_apply (x y : V) :
    boundaryFaceAffine x y = x + boundaryTangentialProjection y := by
  rfl

without_proof_info in
@[simp] theorem boundaryFaceAffine_zero (x : V) : boundaryFaceAffine x 0 = x := by
  simp

without_proof_info in
@[simp] theorem boundaryFaceAffine_contLinear (x : V) :
    (boundaryFaceAffine x).contLinear = boundaryTangentialProjection := by
  simp [boundaryFaceAffine, ContinuousAffineMap.add_contLinear]

without_proof_info in
theorem boundaryFaceTaylor_eq_zero
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {N : ℕ∞ω} {u : V → F} {p : V → FormalMultilinearSeries ℝ V F} {r : ℝ}
    (hp : HasFTaylorSeriesUpToOn N u p (ball 0 r ∩ {x : V | 0 ≤ x 0}))
    (hzero : ∀ x ∈ ball (0 : V) r, x 0 = 0 → u x = 0)
    {x : V} (hx : x ∈ ball (0 : V) r) (hx0 : x 0 = 0)
    {k : ℕ} (hk : k ≤ N) :
    (p x k).compContinuousLinearMap (fun _ => boundaryTangentialProjection) = 0 := by
  let g := boundaryFaceAffine x
  let U : Set V := g ⁻¹' ball 0 r
  have hU : IsOpen U := isOpen_ball.preimage g.continuous
  have h0 : (0 : V) ∈ U := by simpa [U, g] using hx
  have hg0 (y : V) : (g y) 0 = 0 := by simp [g, hx0]
  have hg : MapsTo g U (ball 0 r ∩ {x : V | 0 ≤ x 0}) := by
    intro y hy
    exact ⟨hy, le_of_eq (hg0 y).symm⟩
  have hz : ∀ y ∈ U, u (g y) = 0 := fun y hy => hzero (g y) hy (hg0 y)
  simpa [g] using taylorCoefficient_affine_restriction_eq_zero hp g hU hg hz h0 hk

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryFaceTaylor

/- Boundary analytic support: RelativeDirectionalDerivatives.lean, SHA256 389e16a847004b961ea7bc167a2fc3e42ca77164b34b1ab692ccf21b8f7dbe6d -/
noncomputable section ProofPart_BoundaryAnalytic_RelativeDirectionalDerivatives




/- Smooth relative directional derivatives commute on a domain accumulated
by its interior. No analyticity of the unknown is used. Both finite reflection
jets and the normal-order induction need this same relative calculus. -/
open Set
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

def iteratedFDerivWithinAlong (S : Set E) : List E → (E → F) → E → F
  | [], f => f
  | v :: vs, f => fun x => fderivWithin ℝ (iteratedFDerivWithinAlong S vs f) S x v

without_proof_info in
@[simp] theorem iteratedFDerivWithinAlong_nil (S : Set E) (f : E → F) :
    iteratedFDerivWithinAlong S [] f = f := rfl

without_proof_info in
theorem iteratedFDerivWithinAlong_cons (S : Set E) (v : E) (vs : List E) (f : E → F) :
    iteratedFDerivWithinAlong S (v :: vs) f =
      fun x => fderivWithin ℝ (iteratedFDerivWithinAlong S vs f) S x v := rfl

without_proof_info in
theorem contDiffOn_iteratedFDerivWithinAlong {S : Set E} (hS : UniqueDiffOn ℝ S)
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) (vs : List E) :
    ContDiffOn ℝ ∞ (iteratedFDerivWithinAlong S vs f) S := by
  induction vs with
  | nil => exact hf
  | cons v vs ih => exact relative_smooth_directional_derivative hS ih v

without_proof_info in
theorem iteratedFDerivWithinAlong_congr {S : Set E} {f g : E → F}
    (hfg : EqOn f g S) (vs : List E) :
    EqOn (iteratedFDerivWithinAlong S vs f) (iteratedFDerivWithinAlong S vs g) S := by
  induction vs with
  | nil => exact hfg
  | cons v vs ih =>
    intro x hx
    simp only [iteratedFDerivWithinAlong_cons]
    rw [fderivWithin_congr' ih hx]

without_proof_info in
theorem relative_second_directional_derivative_comm {S : Set E}
    (hS : UniqueDiffOn ℝ S) (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) {x : E} (hx : x ∈ S) (v w : E) :
    fderivWithin ℝ (fun y => fderivWithin ℝ f S y w) S x v =
      fderivWithin ℝ (fun y => fderivWithin ℝ f S y v) S x w := by
  have hD : DifferentiableWithinAt ℝ (fderivWithin ℝ f S) S x :=
    ((hf.fderivWithin hS (m := ∞) (by simp)).differentiableOn (by simp)) x hx
  rw [fderivWithin_clm_apply (hS x hx) hD (differentiableWithinAt_const w),
    fderivWithin_clm_apply (hS x hx) hD (differentiableWithinAt_const v)]
  have hv0 : fderivWithin ℝ (fun _ : E => v) S x = 0 :=
    (hasFDerivAt_const v x).hasFDerivWithinAt.fderivWithin (hS x hx)
  have hw0 : fderivWithin ℝ (fun _ : E => w) S x = 0 :=
    (hasFDerivAt_const w x).hasFDerivWithinAt.fderivWithin (hS x hx)
  rw [hv0, hw0]
  simp only [ContinuousLinearMap.comp_zero, zero_add, ContinuousLinearMap.flip_apply]
  exact (hf x hx).isSymmSndFDerivWithinAt (by simp) hS
    (hclosure x hx) hx v w

without_proof_info in
theorem iteratedFDerivWithinAlong_eq_of_perm {S : Set E}
    (hS : UniqueDiffOn ℝ S) (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) {vs ws : List E} (h : vs.Perm ws) :
    EqOn (iteratedFDerivWithinAlong S vs f) (iteratedFDerivWithinAlong S ws f) S := by
  induction h with
  | nil => exact fun _ _ => rfl
  | cons v _ ih =>
    intro x hx
    simp only [iteratedFDerivWithinAlong_cons]
    rw [fderivWithin_congr' ih hx]
  | swap v w vs =>
    intro x hx
    exact relative_second_directional_derivative_comm hS hclosure
      (contDiffOn_iteratedFDerivWithinAlong hS hf vs) hx w v
  | trans _ _ ih₁ ih₂ => exact fun x hx => (ih₁ hx).trans (ih₂ hx)

without_proof_info in
theorem iteratedFDerivWithinAlong_ofFn {S : Set E} (hS : UniqueDiffOn ℝ S)
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) {k : ℕ} (m : Fin k → E)
    {x : E} (hx : x ∈ S) :
    iteratedFDerivWithinAlong S (List.ofFn m) f x = iteratedFDerivWithin ℝ k f S x m := by
  induction k generalizing x with
  | zero => simp [iteratedFDerivWithinAlong, iteratedFDerivWithin_zero_apply]
  | succ k ih =>
    rw [List.ofFn_succ, iteratedFDerivWithinAlong_cons]
    change fderivWithin ℝ (iteratedFDerivWithinAlong S (List.ofFn (fun i => m i.succ)) f)
      S x (m 0) = _
    have heq : EqOn (iteratedFDerivWithinAlong S (List.ofFn (fun i => m i.succ)) f)
        (fun y => iteratedFDerivWithin ℝ k f S y (fun i => m i.succ)) S :=
      fun y hy => ih (fun i => m i.succ) hy
    rw [fderivWithin_congr' heq hx]
    have hk : (k : ℕ∞ω) < (∞ : ℕ∞ω) := by exact_mod_cast ENat.natCast_lt_top k
    rw [fderivWithin_continuousMultilinear_apply_const_apply (hS x hx)
      ((hf.differentiableOn_iteratedFDerivWithin (m := k) hk hS) x hx)]
    rw [iteratedFDerivWithin_succ_apply_left]
    rfl

end ConformalPoisson

end ProofPart_BoundaryAnalytic_RelativeDirectionalDerivatives

/- Boundary analytic support: RelativeBoundaryJets.lean, SHA256 f3d5d6504dd28e0a72a76129054a01be0a38ba14ae8c58941887a731f3db84ae -/
noncomputable section ProofPart_BoundaryAnalytic_RelativeBoundaryJets



/- Actual relative jets at a flat physical face. Tangential derivatives of
zero trace and of zero second normal trace vanish without an extension. -/
open Set Metric
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem boundary_tangent_iteratedFDerivWithin_eq_zero
    {S : Set V} (hS : UniqueDiffOn ℝ S) {u : V → F}
    (hu : ContDiffOn ℝ ∞ u S) {r : ℝ}
    (hcap : ball (0 : V) r ∩ {x : V | 0 ≤ x 0} ⊆ S)
    (hzero : ∀ x ∈ ball (0 : V) r, x 0 = 0 → u x = 0)
    {x : V} (hx : x ∈ ball (0 : V) r) (hx0 : x 0 = 0)
    {k : ℕ} (m : Fin k → V) (hm : ∀ i, m i 0 = 0) :
    iteratedFDerivWithin ℝ k u S x m = 0 := by
  have hp := (hu.ftaylorSeriesWithin hS).mono hcap
  have hz := boundaryFaceTaylor_eq_zero hp hzero hx hx0 (k := k) (by simp)
  have heval := congrArg (fun A => A m) hz
  have heq : (fun i => boundaryTangentialProjection (m i)) = m := by
    funext i
    exact boundaryTangentialProjection_eq_self (m i) (hm i)
  simpa only [ContinuousMultilinearMap.compContinuousLinearMap_apply,
    ContinuousMultilinearMap.zero_apply, ftaylorSeriesWithin, heq] using heval

without_proof_info in
theorem boundary_tangent_fderivWithin_eq_zero
    {S : Set V} (hS : UniqueDiffOn ℝ S) {u : V → F}
    (hu : ContDiffOn ℝ ∞ u S) {r : ℝ}
    (hcap : ball (0 : V) r ∩ {x : V | 0 ≤ x 0} ⊆ S)
    (hzero : ∀ x ∈ ball (0 : V) r, x 0 = 0 → u x = 0)
    {x : V} (hx : x ∈ ball (0 : V) r) (hx0 : x 0 = 0)
    {v : V} (hv : v 0 = 0) : fderivWithin ℝ u S x v = 0 := by
  have hxS : x ∈ S := hcap ⟨hx, le_of_eq hx0.symm⟩
  have h := boundary_tangent_iteratedFDerivWithin_eq_zero hS hu hcap hzero hx hx0
    (fun _ : Fin 1 => v) (fun _ => hv)
  simpa only [iteratedFDerivWithin_one_apply (hS x hxS)] using h

without_proof_info in
theorem boundary_third_normal_normal_tangent_eq_zero
    {S : Set V} (hS : UniqueDiffOn ℝ S) {u : V → F}
    (hu : ContDiffOn ℝ ∞ u S) {r : ℝ}
    (hcap : ball (0 : V) r ∩ {x : V | 0 ≤ x 0} ⊆ S)
    (hnn : ∀ x ∈ ball (0 : V) r, x 0 = 0 →
      iteratedFDerivWithinAlong S
        [EuclideanSpace.single 0 1, EuclideanSpace.single 0 1] u x = 0)
    {x : V} (hx : x ∈ ball (0 : V) r) (hx0 : x 0 = 0)
    {v : V} (hv : v 0 = 0) :
    iteratedFDerivWithinAlong S
      [v, EuclideanSpace.single 0 1, EuclideanSpace.single 0 1] u x = 0 := by
  exact boundary_tangent_fderivWithin_eq_zero hS
    (contDiffOn_iteratedFDerivWithinAlong hS hu
      [EuclideanSpace.single 0 1, EuclideanSpace.single 0 1]) hcap hnn hx hx0 hv

end ConformalPoisson

end ProofPart_BoundaryAnalytic_RelativeBoundaryJets

/- Boundary analytic support: BoundaryReflectionParity.lean, SHA256 80e0c1f1287795763b6c64fb33d290ff168dde2a8c540ebdd53364803f400953 -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryReflectionParity



/- Reflection parity tested on the canonical Euclidean basis. Only even
normal-slot components need vanish in the odd-reflection compatibility. -/
open Set
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n k : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem boundaryReflection_single (i : Fin (n + 1)) :
    boundaryReflection n (EuclideanSpace.single i 1) =
      (if i = 0 then (-1 : ℝ) else 1) • EuclideanSpace.single i 1 := by
  ext j
  by_cases hi : i = 0 <;> by_cases hj : j = 0 <;>
    simp [hi, hj]

without_proof_info in
theorem odd_reflection_jet_compatibility
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (A : ContinuousMultilinearMap ℝ (fun _ : Fin k => V) F)
    (heven : ∀ m : Fin k → Fin (n + 1),
      Even (Finset.univ.filter (fun i => m i = 0)).card →
        A (fun i => EuclideanSpace.single (m i) 1) = 0) :
    A = -A.compContinuousLinearMap
      (fun _ => (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap) := by
  classical
  apply ContinuousMultilinearMap.toMultilinearMap_injective
  apply Module.Basis.ext_multilinear (fun _ => (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis)
  intro m
  simp only [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply]
  change A (fun i => EuclideanSpace.single (m i) 1) =
    -A (fun i => boundaryReflection n (EuclideanSpace.single (m i) 1))
  simp_rw [boundaryReflection_single]
  rw [A.map_smul_univ]
  have hprod : (∏ i : Fin k, if m i = 0 then (-1 : ℝ) else 1) =
      (-1 : ℝ) ^ (Finset.univ.filter (fun i => m i = 0)).card := by
    rw [Finset.prod_ite]
    simp
  rw [hprod]
  obtain h | h := Nat.even_or_odd (Finset.univ.filter (fun i => m i = 0)).card
  · rw [h.neg_one_pow, one_smul, heven m h, neg_zero]
  · rw [h.neg_one_pow, neg_one_smul, neg_neg]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryReflectionParity

/- Boundary analytic support: BoundaryThreeJetParity.lean, SHA256 db599f50ffd0e34034b45cb82d5443e244b1938b44a5becdb827abe829833c0c -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryThreeJetParity



/- For the C3 reflection only zero tangential jets and the second-normal
trace with its first tangential derivatives are required. -/
open Set
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem odd_reflection_three_jet_compatibility
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (p : FormalMultilinearSeries ℝ V F)
    (htan : ∀ k : ℕ, k ≤ 3 → ∀ m : Fin k → V,
      (∀ i, m i 0 = 0) → p k m = 0)
    (h2 : p 2 ![e, e] = 0)
    (h3a : ∀ v : V, v 0 = 0 → p 3 ![v, e, e] = 0)
    (h3b : ∀ v : V, v 0 = 0 → p 3 ![e, v, e] = 0)
    (h3c : ∀ v : V, v 0 = 0 → p 3 ![e, e, v] = 0)
    (k : ℕ) (hk : k ≤ 3) :
    p k = -(p k).compContinuousLinearMap
      (fun _ => (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap) := by
  classical
  apply odd_reflection_jet_compatibility
  intro m heven
  interval_cases k
  · exact htan 0 (by omega) _ (fun i => Fin.elim0 i)
  · by_cases h0 : m 0 = 0
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0] at heven
    · apply htan 1 (by omega)
      intro i
      fin_cases i
      simp [h0, Ne.symm h0]
  · by_cases h0 : m 0 = 0 <;> by_cases h1 : m 1 = 0
    · convert h2 using 1
      congr 1
      funext i
      fin_cases i <;> simp [h0, h1]
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0, h1] at heven
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0, h1] at heven
    · apply htan 2 (by omega)
      intro i
      fin_cases i <;> simp [h0, h1, Ne.symm h0, Ne.symm h1]
  · by_cases h0 : m 0 = 0 <;> by_cases h1 : m 1 = 0 <;> by_cases h2' : m 2 = 0
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0, h1, h2'] at heven
      rcases heven with ⟨j, hj⟩
      omega
    · have hv : (EuclideanSpace.single (m 2) 1 : V) 0 = 0 := by
        simp [h2', Ne.symm h2']
      convert h3c (EuclideanSpace.single (m 2) 1) hv using 1
      congr 1
      funext i
      fin_cases i <;> simp [h0, h1]
    · have hv : (EuclideanSpace.single (m 1) 1 : V) 0 = 0 := by
        simp [h1, Ne.symm h1]
      convert h3b (EuclideanSpace.single (m 1) 1) hv using 1
      congr 1
      funext i
      fin_cases i <;> simp [h0, h2']
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0, h1, h2'] at heven
    · have hv : (EuclideanSpace.single (m 0) 1 : V) 0 = 0 := by
        simp [h0, Ne.symm h0]
      convert h3a (EuclideanSpace.single (m 0) 1) hv using 1
      congr 1
      funext i
      fin_cases i <;> simp [h1, h2']
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0, h1, h2'] at heven
    · simp [Fin.card_filter_univ_succ, Finset.filter_singleton, h0, h1, h2'] at heven
    · apply htan 3 (by omega)
      intro i
      fin_cases i <;> simp [h0, h1, h2', Ne.symm h0, Ne.symm h1, Ne.symm h2']

