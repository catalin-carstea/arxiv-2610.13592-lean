without_proof_info in
theorem exists_ball_zeroTrace_representative (hα : 0 < α)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) {u : V → ℝ}
    (hu : ContDiffOn ℝ 2 u (ball 0 1)) (hc : ContinuousOn u (closedBall 0 1))
    (hzero : EqOn u 0 (sphere 0 1))
    (heq : ∀ x ∈ ball 0 1, -Δ u x = domainRead (closedBall 0 1) f x) :
