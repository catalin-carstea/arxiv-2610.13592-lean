/- Proof support: NormalizedNativeCoefficients.lean, SHA256 ac6a767a74db29a00450ef62dc5ec5038309f4155f065349712811c995deae10 -/
noncomputable section ProofPart_NormalizedNativeCoefficients




/-
One centered, normalized coordinate ball for a native interior point. Both the
normalizing map and the radius are chosen before any prescribed jet.
-/

open Bundle Set Metric
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M] [IsManifold I ∞ M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

without_proof_info in
theorem exists_normalized_native_coordinate_ball (x : M) (hx : I.IsInteriorPoint x)
    {q : M → ℝ} (hq : ContMDiffOn I 𝓘(ℝ) ∞ q (chartAt H x).source) :
    ∃ T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d), ∃ R : ℝ, 0 < R ∧
      affinePrincipalCoefficient T (extChartAt I x x) (chartPrincipalCoefficient (I := I) x) 0 =
        ContinuousLinearMap.id ℝ _ ∧
      MapsTo (fun z => extChartAt I x x + T z) (ball 0 R) (interior (extChartAt I x).target) ∧
      ContDiffOn ℝ ∞
        (affinePrincipalCoefficient T (extChartAt I x x) (chartPrincipalCoefficient (I := I) x))
        (ball 0 R) ∧
      ContDiffOn ℝ ∞
        (affineDriftCoefficient T (extChartAt I x x) (chartDriftCoefficient (I := I) x))
        (ball 0 R) ∧
      ContDiffOn ℝ ∞
        (affinePotentialCoefficient T (extChartAt I x x) (chartPotentialCoefficient (I := I) x q))
        (ball 0 R) := by
  obtain ⟨T, hT⟩ := exists_native_principal_normalization (I := I) x (mem_chart_source H x)
  have hxi : extChartAt I x x ∈ interior (extChartAt I x).target :=
    ModelWithCorners.isInteriorPoint_iff.mp hx
  let U := (fun z => extChartAt I x x + T z) ⁻¹' interior (extChartAt I x).target
  have hU : IsOpen U :=
    isOpen_interior.preimage (continuous_const.add T.continuous)
  have h0 : (0 : EuclideanSpace ℝ (Fin d)) ∈ U := by
    simpa only [U, mem_preimage, map_zero, add_zero] using hxi
  obtain ⟨R, hR, hsub⟩ := Metric.isOpen_iff.mp hU 0 h0
  refine ⟨T, R, hR, hT, hsub, ?_, ?_, ?_⟩
  · exact (contDiffOn_affinePrincipalCoefficient T _ (contDiffOn_chartPrincipalCoefficient x)).mono hsub
  · exact (contDiffOn_affineDriftCoefficient T _ (contDiffOn_chartDriftCoefficient x)).mono hsub
  · exact (contDiffOn_affinePotentialCoefficient T _ (contDiffOn_chartPotentialCoefficient x hq)).mono hsub

end ConformalPoisson

end ProofPart_NormalizedNativeCoefficients

/- Proof support: NormalizedNativeJets.lean, SHA256 4df1169e2e92366eace940694c857d6f84f44cdb51266cfb441fd93c7513f3d6 -/
noncomputable section ProofPart_NormalizedNativeJets




/-
Apply the checked local coordinate jet construction to the actual normalized
native coefficients, retaining one chart-valid radius for all compatible jets.
Transport of the requested native raised Hessian into these ordinary jets remains
a separate geometric proof obligation.
-/

open Bundle Set Metric
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M] [IsManifold I ∞ M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

without_proof_info in
theorem exists_normalized_native_coordinate_jets
    (hSchauder : LocalSchauderDirichletAssumption d) (hd : 0 < d)
    (x : M) (hx : I.IsInteriorPoint x) {q : M → ℝ}
    (hq : ContMDiffOn I 𝓘(ℝ) ∞ q (chartAt H x).source) :
    ∃ T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d),
      ∃ ρ : ℝ, ∃ hρ : 0 < ρ,
        MapsTo (fun z => extChartAt I x x + T z) (ball 0 ρ) (interior (extChartAt I x).target) ∧
        affinePrincipalCoefficient T (extChartAt I x x) (chartPrincipalCoefficient (I := I) x) 0 =
          ContinuousLinearMap.id ℝ _ ∧
        ∀ j : FlatJet (EuclideanSpace ℝ (Fin d)),
          flatCoordinateJetEquation
            (affineDriftCoefficient T (extChartAt I x x) (chartDriftCoefficient (I := I) x) 0)
            (affinePotentialCoefficient T (extChartAt I x x) (chartPotentialCoefficient (I := I) x q) 0)
            j = 0 →
          ∃ v : EuclideanSpace ℝ (Fin d) → ℝ, ∃ hv : ContDiffOn ℝ ∞ v (ball 0 ρ),
            (∀ z ∈ ball 0 ρ,
              coordinateSchrodinger
                (affinePrincipalCoefficient T (extChartAt I x x) (chartPrincipalCoefficient (I := I) x))
                (affineDriftCoefficient T (extChartAt I x x) (chartDriftCoefficient (I := I) x))
                (affinePotentialCoefficient T (extChartAt I x x) (chartPotentialCoefficient (I := I) x q))
                v z = 0) ∧
            flatJetAt v 0
              ((hv.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hρ))).of_le (by decide)) = j := by
  obtain ⟨T, R, hR, ha0, hmap, ha, hb, hqc⟩ :=
    exists_normalized_native_coordinate_ball (I := I) x hx hq
  obtain ⟨r, hr, hrealize⟩ := exists_local_coordinate_solution_with_jet hSchauder hd hR ha hb hqc ha0
  let ρ := min r R
  have hρ : 0 < ρ := lt_min hr hR
  have hsubr : ball (0 : EuclideanSpace ℝ (Fin d)) ρ ⊆ ball 0 r :=
    ball_subset_ball (min_le_left r R)
  have hsubR : ball (0 : EuclideanSpace ℝ (Fin d)) ρ ⊆ ball 0 R :=
    ball_subset_ball (min_le_right r R)
  refine ⟨T, ρ, hρ, hmap.mono_left hsubR, ha0, fun j hj => ?_⟩
  obtain ⟨v, hv, hLv, hjet⟩ := hrealize j hj
  refine ⟨v, hv.mono hsubr, fun z hz => hLv z (hsubr hz), ?_⟩
  exact hjet

end ConformalPoisson

end ProofPart_NormalizedNativeJets

/- Proof support: NormalizedChartPullback.lean, SHA256 6b8f419a6980036c500451f3ebca7b43526fcfec643afbec5c3eebd6f0b019e6 -/
noncomputable section ProofPart_NormalizedChartPullback




/-
A coordinate solution pulled back by the inverse affine chart. Its native domain
is explicitly open, contains the chosen point, and lies in the manifold interior.
-/

open Bundle Set Metric
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

section AffineInverse

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def inverseAffine (T : E ≃L[ℝ] E) (z₀ : E) (z : E) : E := T.symm (z - z₀)

without_proof_info in
@[simp] theorem inverseAffine_apply_affine (T : E ≃L[ℝ] E) (z₀ z : E) :
    inverseAffine T z₀ (z₀ + T z) = z := by
  simp only [inverseAffine, add_sub_cancel_left, T.symm_apply_apply]

without_proof_info in
@[simp] theorem affine_apply_inverseAffine (T : E ≃L[ℝ] E) (z₀ z : E) :
    z₀ + T (inverseAffine T z₀ z) = z := by
  simp only [inverseAffine, T.apply_symm_apply, add_sub_cancel]

without_proof_info in
theorem contDiff_inverseAffine (T : E ≃L[ℝ] E) (z₀ : E) : ContDiff ℝ ∞ (inverseAffine T z₀) :=
  T.symm.contDiff.comp (contDiff_id.sub contDiff_const)

end AffineInverse

variable {d : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]

def normalizedChartCoordinates (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) : M → EuclideanSpace ℝ (Fin d) :=
  inverseAffine T (extChartAt I x x) ∘ extChartAt I x

def normalizedChartFunction (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d))
    (v : EuclideanSpace ℝ (Fin d) → ℝ) : M → ℝ :=
  v ∘ normalizedChartCoordinates (I := I) x T

def normalizedRead (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (f : M → ℝ) :
    EuclideanSpace ℝ (Fin d) → ℝ :=
  affinePullback T (extChartAt I x x) (f ∘ (extChartAt I x).symm)

without_proof_info in
theorem contDiffAt_chartReading (x : M) (hx : I.IsInteriorPoint x) {f : M → ℝ}
    (hf : ContMDiffAt I 𝓘(ℝ) ∞ f x) :
    ContDiffAt ℝ ∞ (f ∘ (extChartAt I x).symm) (extChartAt I x x) := by
  have hxi := ModelWithCorners.isInteriorPoint_iff.mp hx
  have hinv : ContMDiffAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) I ∞
      (extChartAt I x).symm (extChartAt I x x) :=
    (contMDiffOn_extChartAt_symm x _ (interior_subset hxi)).contMDiffAt
      (Filter.mem_of_superset (isOpen_interior.mem_nhds hxi) interior_subset)
  have hround : (extChartAt I x).symm (extChartAt I x x) = x :=
    (extChartAt I x).left_inv (mem_extChartAt_source x)
  exact ((hround.symm ▸ hf).comp _ hinv).contDiffAt

without_proof_info in
theorem contDiffAt_normalizedRead (x : M) (hx : I.IsInteriorPoint x)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) {f : M → ℝ}
    (hf : ContMDiffAt I 𝓘(ℝ) ∞ f x) : ContDiffAt ℝ ∞ (normalizedRead (I := I) x T f) 0 := by
  have hF : ContDiffAt ℝ ∞ (f ∘ (extChartAt I x).symm) (extChartAt I x x + T 0) := by
    simpa only [map_zero, add_zero] using contDiffAt_chartReading x hx hf
  have hAff : ContDiffAt ℝ ∞ (fun z => extChartAt I x x + T z) 0 :=
    (contDiff_const.add T.contDiff).contDiffAt
  have hh : ContDiffAt ℝ ∞
      ((f ∘ (extChartAt I x).symm) ∘ (fun z => extChartAt I x x + T z)) 0 := hF.comp 0 hAff
  exact hh

omit [IsManifold I ∞ M] in
without_proof_info in
theorem normalizedRead_pullback_eventually (x : M) (hx : I.IsInteriorPoint x)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d))
    (v : EuclideanSpace ℝ (Fin d) → ℝ) :
    normalizedRead (I := I) x T (normalizedChartFunction (I := I) x T v) =ᶠ[𝓝 0] v := by
  have hxi := ModelWithCorners.isInteriorPoint_iff.mp hx
  have hread := chartFunction_read_eventually (I := I) x
    (v ∘ inverseAffine T (extChartAt I x x)) hxi
  have haff : Filter.Tendsto (fun z => extChartAt I x x + T z) (𝓝 0) (𝓝 (extChartAt I x x)) := by
    have hc : Continuous (fun z => extChartAt I x x + T z) := continuous_const.add T.continuous
    simpa only [map_zero, add_zero] using (hc.tendsto 0)
  have h := hread.comp_tendsto haff
  change (fun z => v (inverseAffine T (extChartAt I x x)
    (extChartAt I x ((extChartAt I x).symm (extChartAt I x x + T z))))) =ᶠ[𝓝 0] v
  simpa only [chartFunction, Function.comp_def, inverseAffine_apply_affine] using h

def normalizedChartDomain (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (ρ : ℝ) :
    TopologicalSpace.Opens M :=
  ⟨((chartAt H x).source ∩ extChartAt I x ⁻¹'
      (interior (extChartAt I x).target ∩ inverseAffine T (extChartAt I x x) ⁻¹' ball 0 ρ)) ∩
      I.interior M,
    (isOpen_extChartAt_preimage x (isOpen_interior.inter
      (isOpen_ball.preimage (contDiff_inverseAffine T _).continuous))).inter
      (I.isOpen_interior (n := ∞) (by decide))⟩

without_proof_info in
theorem normalizedChartDomain_contains_center (x : M) (hx : I.IsInteriorPoint x)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) {ρ : ℝ} (hρ : 0 < ρ) :
    x ∈ normalizedChartDomain (I := I) x T ρ := by
  refine ⟨⟨mem_chart_source H x, ModelWithCorners.isInteriorPoint_iff.mp hx, ?_⟩, hx⟩
  simpa only [mem_preimage, inverseAffine, sub_self, map_zero] using mem_ball_self hρ

without_proof_info in
theorem normalizedChartDomain_subset_interior (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) (ρ : ℝ) :
    (normalizedChartDomain (I := I) x T ρ : Set M) ⊆ I.interior M := fun _ hy => hy.2

without_proof_info in
theorem contMDiffOn_normalizedChartFunction (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) {ρ : ℝ}
    {v : EuclideanSpace ℝ (Fin d) → ℝ} (hv : ContDiffOn ℝ ∞ v (ball 0 ρ)) :
    ContMDiffOn I 𝓘(ℝ) ∞ (normalizedChartFunction (I := I) x T v)
      (normalizedChartDomain (I := I) x T ρ) := by
  intro y hy
  have hvc : ContDiffAt ℝ ∞ v (normalizedChartCoordinates (I := I) x T y) :=
    hv.contDiffAt (isOpen_ball.mem_nhds hy.1.2.2)
  have hcoord : ContMDiffAt I 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) ∞
      (normalizedChartCoordinates (I := I) x T) y :=
    (contDiff_inverseAffine T _).contMDiff.contMDiffAt.comp y (contMDiffAt_extChartAt' hy.1.1)
  exact (hvc.contMDiffAt.comp y hcoord).contMDiffWithinAt

end ConformalPoisson

end ProofPart_NormalizedChartPullback

/- Proof support: CoordinateOperatorLocality.lean, SHA256 45c319e9202a22a23319707d41575b30783c13efe35c0ab29f9294e8400ce3de -/
noncomputable section ProofPart_CoordinateOperatorLocality



/- The coordinate differential operator depends only on the function's germ. -/

open scoped Topology

namespace ConformalPoisson

without_proof_info in
theorem coordinateSchrodinger_eq_of_eventuallyEq {d : ℕ}
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)) (q : EuclideanSpace ℝ (Fin d) → ℝ)
    {u v : EuclideanSpace ℝ (Fin d) → ℝ} {x : EuclideanSpace ℝ (Fin d)}
    (h : u =ᶠ[𝓝 x] v) : coordinateSchrodinger a b q u x = coordinateSchrodinger a b q v x := by
  have hfirst : fderiv ℝ u =ᶠ[𝓝 x] fderiv ℝ v :=
    h.eventuallyEq_nhds.mono fun _ hw => hw.fderiv_eq
  unfold coordinateSchrodinger
  rw [hfirst.fderiv_eq, h.fderiv_eq, h.eq_of_nhds]

end ConformalPoisson

end ProofPart_CoordinateOperatorLocality

/- Proof support: NormalizedPullbackEquation.lean, SHA256 d298b08e5a701e257c21225a7e98ce011b561e23d9753b925410d7c8a26a6398 -/
noncomputable section ProofPart_NormalizedPullbackEquation




/-
A homogeneous solution for the actual normalized coordinate coefficients pulls
back to a homogeneous solution of the actual native operator on its open domain.
-/

open Bundle Set Metric
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {d : ℕ}
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M] [IsManifold I ∞ M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

without_proof_info in
theorem normalizedRead_equation (x : M) (hx : I.IsInteriorPoint x)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d))
    (q : M → ℝ) {f : M → ℝ} (hf : ContMDiffAt I 𝓘(ℝ) ∞ f x) :
    coordinateSchrodinger
        (affinePrincipalCoefficient T (extChartAt I x x) (chartPrincipalCoefficient (I := I) x))
        (affineDriftCoefficient T (extChartAt I x x) (chartDriftCoefficient (I := I) x))
        (affinePotentialCoefficient T (extChartAt I x x) (chartPotentialCoefficient (I := I) x q))
        (normalizedRead (I := I) x T f) 0 =
      -TauCeti.Manifold.laplaceBeltrami I f x + q x * f x := by
  have hF : ContDiffAt ℝ 2 (f ∘ (extChartAt I x).symm) (extChartAt I x x + T 0) := by
    simpa only [map_zero, add_zero] using
      (contDiffAt_chartReading x hx hf).of_le (show (2 : ℕ∞ω) ≤ ∞ by decide)
  have hAffine := coordinateSchrodinger_affinePullback T (extChartAt I x x)
    (chartPrincipalCoefficient (I := I) x) (chartDriftCoefficient (I := I) x)
    (chartPotentialCoefficient (I := I) x q) (f ∘ (extChartAt I x).symm) 0 hF
  simp only [map_zero, add_zero] at hAffine
  exact hAffine.trans (coordinateSchrodinger_eq_native x (mem_chart_source H x)
    (ModelWithCorners.isInteriorPoint_iff.mp hx) q (hf.of_le (by decide)))

without_proof_info in
theorem nativeEquation_normalizedChartFunction (x : M)
    (T : EuclideanSpace ℝ (Fin d) ≃L[ℝ] EuclideanSpace ℝ (Fin d)) {ρ : ℝ}
    (q : M → ℝ) {v : EuclideanSpace ℝ (Fin d) → ℝ} (hv : ContDiffOn ℝ ∞ v (ball 0 ρ))
    (hLv : ∀ z ∈ ball 0 ρ,
      coordinateSchrodinger
        (affinePrincipalCoefficient T (extChartAt I x x) (chartPrincipalCoefficient (I := I) x))
        (affineDriftCoefficient T (extChartAt I x x) (chartDriftCoefficient (I := I) x))
        (affinePotentialCoefficient T (extChartAt I x x) (chartPotentialCoefficient (I := I) x q)) v z = 0) :
    ∀ y ∈ normalizedChartDomain (I := I) x T ρ,
      -TauCeti.Manifold.laplaceBeltrami I (normalizedChartFunction (I := I) x T v) y +
        q y * normalizedChartFunction (I := I) x T v y = 0 := by
  intro y hy
  let z₀ := extChartAt I x x
  let P := v ∘ inverseAffine T z₀
  have hvc : ContDiffAt ℝ ∞ v (inverseAffine T z₀ (extChartAt I x y)) :=
    hv.contDiffAt (isOpen_ball.mem_nhds hy.1.2.2)
  have hP : ContDiffAt ℝ 2 P (extChartAt I x y) :=
    (hvc.comp _ (contDiff_inverseAffine T z₀).contDiffAt).of_le (by decide)
  have hfnative := ((contMDiffOn_normalizedChartFunction x T hv).contMDiffAt
    ((normalizedChartDomain (I := I) x T ρ).isOpen.mem_nhds hy)).of_le (show (2 : ℕ∞ω) ≤ ∞ by decide)
  rw [← coordinateSchrodinger_eq_native x hy.1.1 hy.1.2.1 q hfnative]
  have hread : (normalizedChartFunction (I := I) x T v ∘ (extChartAt I x).symm) =ᶠ[𝓝 (extChartAt I x y)] P :=
    chartFunction_read_eventually x P hy.1.2.1
  rw [coordinateSchrodinger_eq_of_eventuallyEq _ _ _ hread]
  have hP' : ContDiffAt ℝ 2 P (z₀ + T (inverseAffine T z₀ (extChartAt I x y))) := by
    simpa only [affine_apply_inverseAffine] using hP
  have hAffine := coordinateSchrodinger_affinePullback T z₀
    (chartPrincipalCoefficient (I := I) x) (chartDriftCoefficient (I := I) x)
    (chartPotentialCoefficient (I := I) x q) P (inverseAffine T z₀ (extChartAt I x y)) hP'
  have hfun : affinePullback T z₀ P = v := by
    funext z
    change v (inverseAffine T z₀ (z₀ + T z)) = v z
    rw [inverseAffine_apply_affine]
  rw [hfun, affine_apply_inverseAffine] at hAffine
  rw [← hAffine]
  exact hLv _ hy.1.2.2

end ConformalPoisson

end ProofPart_NormalizedPullbackEquation

/- Proof support: NativeJetComparison.lean, SHA256 27db281202990a589a3391f8c6cd54e76c488689fb4a9544ea451c7e97af715e -/
noncomputable section ProofPart_NativeJetComparison





/-
Native second jets are determined by their ordinary derivatives in an interior
chart. The comparison uses the same metric and native Levi-Civita connection.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem secondJet_eq_of_coordinate_derivatives (g : Metric (n := n) (M := M))
    (x : M) (hx : (𝓡∂ (n + 1)).IsInteriorPoint x) {f u : M → ℝ}
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 f x)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u x)
    (hvalue : f x = u x)
    (hfirst : fderiv ℝ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) (extChartAt (𝓡∂ (n + 1)) x x) =
      fderiv ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) (extChartAt (𝓡∂ (n + 1)) x x))
    (hsecond : fderiv ℝ (fderiv ℝ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm))
        (extChartAt (𝓡∂ (n + 1)) x x) =
      fderiv ℝ (fderiv ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) x).symm))
        (extChartAt (𝓡∂ (n + 1)) x x)) : secondJet g f x = secondJet g u x := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (n' := 1) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  let e := trivializationAt V (TangentSpace (𝓡∂ (n + 1))) x
  have hbase : x ∈ e.baseSet := FiberBundle.mem_baseSet_trivializationAt' x
  let D : V ≃L[ℝ] TangentSpace (𝓡∂ (n + 1)) x := (e.continuousLinearEquivAt ℝ x hbase).symm
  have hD : (D : V → TangentSpace (𝓡∂ (n + 1)) x) = e.symmL ℝ x :=
    e.symm_continuousLinearEquivAt_eq hbase
  have hxi : extChartAt (𝓡∂ (n + 1)) x x ∈ interior (extChartAt (𝓡∂ (n + 1)) x).target :=
    ModelWithCorners.isInteriorPoint_iff.mp hx
  refine Prod.ext hvalue (Prod.ext ?_ ?_)
  · change mvfderiv (𝓡∂ (n + 1)) f x = mvfderiv (𝓡∂ (n + 1)) u x
    apply covector_eq_of_coordinates D
    intro v
    rw [hD]
    rw [mvfderiv_inverseChart_vector x (mem_chart_source _ x) hxi (hf.mdifferentiableAt (by decide)),
      mvfderiv_inverseChart_vector x (mem_chart_source _ x) hxi (hu.mdifferentiableAt (by decide)), hfirst]
  · apply raisedHessian_eq_of_coordinates D
    intro v w
    have h : TauCeti.Manifold.hessian (𝓡∂ (n + 1)) f x (D v) (D w) =
        TauCeti.Manifold.hessian (𝓡∂ (n + 1)) u x (D v) (D w) := by
      rw [hD]
      rw [hessian_fixedChart_christoffel x (mem_chart_source _ x) hxi hf,
        hessian_fixedChart_christoffel x (mem_chart_source _ x) hxi hu, hfirst, hsecond]
    rw [TauCeti.Manifold.hessian_def, TauCeti.Manifold.hessian_def] at h
    exact h

end ConformalPoisson

end ProofPart_NativeJetComparison

/- Proof support: NormalizedNativeJetComparison.lean, SHA256 fcb5233068bfdd1171147fa5b0a5d2b0b811ac2a3431d1cb3339f8ee05e57be7 -/
noncomputable section ProofPart_NormalizedNativeJetComparison




/- Equality of normalized ordinary jets recovers equality of the native jets. -/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

without_proof_info in
theorem flatJetAt_eq_of_eventuallyEq {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {u v : E → ℝ} {x : E} (hu : ContDiffAt ℝ 2 u x) (hv : ContDiffAt ℝ 2 v x)
    (h : u =ᶠ[𝓝 x] v) : flatJetAt u x hu = flatJetAt v x hv := by
  refine Prod.ext h.eq_of_nhds (Prod.ext h.fderiv_eq ?_)
  apply Subtype.ext
  have hd : fderiv ℝ u =ᶠ[𝓝 x] fderiv ℝ v :=
    h.eventuallyEq_nhds.mono fun _ hw => hw.fderiv_eq
  exact hd.fderiv_eq

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem secondJet_eq_of_normalized_jet (g : Metric (n := n) (M := M)) (x : M)
    (hx : (𝓡∂ (n + 1)).IsInteriorPoint x) (T : V ≃L[ℝ] V) {f u : M → ℝ}
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f x)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u x)
    (hNF : ContDiffAt ℝ 2 (normalizedRead (I := 𝓡∂ (n + 1)) x T f) 0)
    (hNU : ContDiffAt ℝ 2 (normalizedRead (I := 𝓡∂ (n + 1)) x T u) 0)
    (hjet : flatJetAt (normalizedRead (I := 𝓡∂ (n + 1)) x T f) 0 hNF =
      flatJetAt (normalizedRead (I := 𝓡∂ (n + 1)) x T u) 0 hNU) : secondJet g f x = secondJet g u x := by
  let z₀ := extChartAt (𝓡∂ (n + 1)) x x
  have hF : ContDiffAt ℝ 2 (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) (z₀ + T 0) := by
    simpa only [map_zero, add_zero] using (contDiffAt_chartReading x hx hf).of_le (show (2 : ℕ∞ω) ≤ ∞ by decide)
  have hU : ContDiffAt ℝ 2 (u ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) (z₀ + T 0) := by
    simpa only [map_zero, add_zero] using (contDiffAt_chartReading x hx hu).of_le (show (2 : ℕ∞ω) ≤ ∞ by decide)
  have hraw := hjet
  change flatJetAt (affinePullback T z₀ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm)) 0 hNF =
    flatJetAt (affinePullback T z₀ (u ∘ (extChartAt (𝓡∂ (n + 1)) x).symm)) 0 hNU at hraw
  rw [flatJetAt_affinePullback T z₀ _ 0 hF hNF,
    flatJetAt_affinePullback T z₀ _ 0 hU hNU] at hraw
  have hraw' := congrArg (affineFlatJet T.symm) hraw
  rw [affineFlatJet_inverse, affineFlatJet_inverse] at hraw'
  simp only [map_zero, add_zero] at hraw'
  apply secondJet_eq_of_coordinate_derivatives g x hx (hf.of_le (by decide)) (hu.of_le (by decide))
  · have h := congrArg (fun j : FlatJet V => j.1) hraw'
    have hround : (extChartAt (𝓡∂ (n + 1)) x).symm z₀ = x :=
      (extChartAt (𝓡∂ (n + 1)) x).left_inv (mem_extChartAt_source x)
    simpa only [flatJetAt, Function.comp_apply, hround] using h
  · exact congrArg (fun j : FlatJet V => j.2.1) hraw'
  · exact congrArg (fun j : FlatJet V => j.2.2.val) hraw'

end ConformalPoisson

end ProofPart_NormalizedNativeJetComparison

/- Proof support: LocalNativeJetRealization.lean, SHA256 d4a1c63a11f00500e5c2977ff46bd36515f7612c2a0fc20a906eef35e1df1fa4 -/
noncomputable section ProofPart_LocalNativeJetRealization







/-
The native local compatible-jet producer, proved from the approved forward
Schauder input. The metric, potential and actual native derivatives are retained.
-/

open Bundle Set Metric
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 600000 in
without_proof_info in
theorem localCompatibleJetRealization_of_schauder
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) : LocalCompatibleJetRealization g q := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (n' := 1) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  intro x hx j
  obtain ⟨T, ρ, hρ, hmap, ha0, hrealize⟩ := exists_normalized_native_coordinate_jets
    hSchauder (Nat.succ_pos n) x hx hq.contMDiffOn
  obtain ⟨f, hf, hjf⟩ := exists_chart_function_with_native_jet g x hx ⟨j.val, j.property.1⟩
  have hfx : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f x :=
    hf.contMDiffAt ((chartAt (EuclideanHalfSpace (n + 1)) x).open_source.mem_nhds (mem_chart_source _ x))
  have hNF : ContDiffAt ℝ 2 (normalizedRead (I := 𝓡∂ (n + 1)) x T f) 0 :=
    (contDiffAt_normalizedRead x hx T hfx).of_le (by decide)
  let J := flatJetAt (normalizedRead (I := 𝓡∂ (n + 1)) x T f) 0 hNF
  have hJ : flatCoordinateJetEquation
      (affineDriftCoefficient T (extChartAt (𝓡∂ (n + 1)) x x)
        (chartDriftCoefficient (I := 𝓡∂ (n + 1)) x) 0)
      (affinePotentialCoefficient T (extChartAt (𝓡∂ (n + 1)) x x)
        (chartPotentialCoefficient (I := 𝓡∂ (n + 1)) x q) 0) J = 0 := by
    rw [flatCoordinateJetEquation_flatJetAt _ _ _ ha0 hNF, normalizedRead_equation x hx T q hfx]
    change schrodinger g q f x = 0
    rw [← jetEquation_secondJet, hjf]
    exact j.property.2
  obtain ⟨v, hv, hLv, hjv⟩ := hrealize J hJ
  let U := normalizedChartDomain (I := 𝓡∂ (n + 1)) x T ρ
  let u := normalizedChartFunction (I := 𝓡∂ (n + 1)) x T v
  have hxU : x ∈ U := normalizedChartDomain_contains_center x hx T hρ
  have hu : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u U :=
    contMDiffOn_normalizedChartFunction x T hv
  have hux := hu.contMDiffAt (U.isOpen.mem_nhds hxU)
  have hNU : ContDiffAt ℝ 2 (normalizedRead (I := 𝓡∂ (n + 1)) x T u) 0 :=
    (contDiffAt_normalizedRead x hx T hux).of_le (by decide)
  have hv2 : ContDiffAt ℝ 2 v 0 :=
    (hv.contDiffAt (isOpen_ball.mem_nhds (mem_ball_self hρ))).of_le (by decide)
  have hjuf : flatJetAt (normalizedRead (I := 𝓡∂ (n + 1)) x T u) 0 hNU = J :=
    (flatJetAt_eq_of_eventuallyEq hNU hv2 (normalizedRead_pullback_eventually x hx T v)).trans hjv
  refine ⟨U, hxU, normalizedChartDomain_subset_interior x T ρ, u, hu, ?_, ?_⟩
  · exact nativeEquation_normalizedChartFunction x T q hv hLv
  · exact (secondJet_eq_of_normalized_jet g x hx T hux hfx hNU hNF hjuf).trans hjf

end ConformalPoisson

end ProofPart_LocalNativeJetRealization

/- Proof support: ExactNativeJets.lean, SHA256 eb3042d168a26d8a8f94f937c24df894302b6a302418335b2c7a4f74f1bbe8dd -/
noncomputable section ProofPart_ExactNativeJets



/-
Exact simultaneous native jets from the approved forward Schauder and Runge inputs.
The local native jet producer is supplied by its project proof, rather than a hypothesis.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

without_proof_info in
theorem exists_datum_with_compatible_jets_of_schauder
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (jets : (i : Fin N) → compatibleJetSubmodule g q (points i)) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∀ i, secondJet g (S.solve f.val) (points i) = (jets i).val := by
  exact exists_datum_with_compatible_jets hRunge hdim hcompact hconnected hq hNR
    (localCompatibleJetRealization_of_schauder hSchauder g q hq) S Γ hΓ N points hinj hpoints jets

without_proof_info in
theorem exists_datum_with_values_of_schauder
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (N : ℕ) (points : Fin N → M) (hinj : Function.Injective points)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M) (values : Fin N → ℝ) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∀ i, S.solve f.val (points i) = values i := by
  exact exists_datum_with_values hRunge hdim hcompact hconnected hq hNR
    (localCompatibleJetRealization_of_schauder hSchauder g q hq) S Γ hΓ N points hinj hpoints values

end ConformalPoisson

end ProofPart_ExactNativeJets

/- Proof support: InteriorSeparation.lean, SHA256 c1abab8283959474a1ac2345e68372308066d82dae34aaae6836b9645db403fb -/
noncomputable section ProofPart_InteriorSeparation





/-
Actual projective separation in the interior from the proved finite-jet producer.
The same arbitrary observed boundary patch supplies every datum used here.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {q : M → ℝ}
  (hSchauder : LocalSchauderDirichletAssumption (n + 1))
  (hRunge : RungeJetApproximationFor g q)
  (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
  (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
  (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
  (S : DirichletSolver g q)
  (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
  (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)

include hSchauder hRunge hdim hcompact hconnected hq hNR hΓ

without_proof_info in
/-- Values and first derivatives are unrestricted at each interior point. -/
theorem exists_datum_with_value_and_covector
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M) (a : ℝ)
    (ξ : TangentSpace (𝓡∂ (n + 1)) x →L[ℝ] ℝ) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      S.solve f.val x = a ∧ mvfderiv (𝓡∂ (n + 1)) (S.solve f.val) x = ξ := by
  obtain ⟨f, hf⟩ := exists_datum_with_compatible_jets_of_schauder
    hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ
    1 (fun _ => x) (fun i j _ => Subsingleton.elim i j) (fun _ => hx)
    (fun _ => compatibleValueJet g q x a ξ)
  exact ⟨f, congrArg (fun j : JetSpace g x => j.1) (hf 0),
    congrArg (fun j : JetSpace g x => j.2.1) (hf 0)⟩

without_proof_info in
/-- Each evaluation is nonzero, with a datum normalized to value one. -/
theorem exists_datum_with_value_one
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)), S.solve f.val x = 1 := by
  obtain ⟨f, hf, _⟩ := exists_datum_with_value_and_covector hSchauder hRunge hdim hcompact
    hconnected hq hNR S Γ hΓ x hx 1 0
  exact ⟨f, hf⟩

without_proof_info in
/-- Distinct interior points have a common supported datum with values zero and one. -/
theorem exists_datum_separating_interior_points
    (x y : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (hy : y ∈ (𝓡∂ (n + 1)).interior M) (hxy : x ≠ y) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      S.solve f.val x = 0 ∧ S.solve f.val y = 1 := by
  obtain ⟨f, hf⟩ := exists_datum_with_values_of_schauder
    hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ
    2 ![x, y] (Matrix.injective_pair_iff_ne.mpr hxy)
    (by intro i; fin_cases i <;> assumption) ![0, 1]
  exact ⟨f, hf 0, hf 1⟩

without_proof_info in
/-- The actual native solution family separates interior points and nonzero multipliers. -/
theorem separatesPointAndScale_interior :
    SeparatesPointAndScale
      (fun (f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)))
        (x : (𝓡∂ (n + 1)).interior M) => S.solve f.val x) := by
  intro x y a b _ha hb hrel
  have hxy : x = y := by
    by_contra hne
    have hne' : (x : M) ≠ (y : M) := fun h => hne (Subtype.ext h)
    obtain ⟨f, hx, hy⟩ := exists_datum_separating_interior_points
      hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ
      x y x.property y.property hne'
    have h := hrel f
    change a * S.solve f.val x = b * S.solve f.val y at h
    rw [hx, hy, mul_zero, mul_one] at h
    exact hb h.symm
  subst y
  obtain ⟨f, hf⟩ := exists_datum_with_value_one hSchauder hRunge hdim hcompact
    hconnected hq hNR S Γ hΓ x x.property
  exact ⟨rfl, by simpa only [hf, mul_one] using hrel f⟩

end ConformalPoisson

end ProofPart_InteriorSeparation

/- Proof support: QuotientDifferential.lean, SHA256 12d956ded7325508e20340e774bacec1ae92bd6fe4cc0abdb05dd321b6dd60f9 -/
noncomputable section ProofPart_QuotientDifferential




/- Differential of the actual solution quotients used for conformal Poisson coordinates. -/

open scoped Manifold ContDiff

namespace ConformalPoisson

def quotientCoordinates {ι M : Type*} (u : ι → M → ℝ) (w : M → ℝ) (x : M) : ι → ℝ :=
  fun i => u i x / w x

without_proof_info in
/-- A common nonzero multiplier cancels from every quotient, even when a denominator is zero. -/
theorem quotientCoordinates_eq_of_scaled_evaluations {D ι X Y : Type*}
    (u : D → X → ℝ) (v : D → Y → ℝ) (denominator : D) (numerators : ι → D)
    (x : X) (y : Y) (a : ℝ) (ha : a ≠ 0) (hrel : ∀ f, u f x = a * v f y) :
    quotientCoordinates (fun i => u (numerators i)) (u denominator) x =
      quotientCoordinates (fun i => v (numerators i)) (v denominator) y := by
  funext i
  change u (numerators i) x / u denominator x = v (numerators i) y / v denominator y
  rw [hrel (numerators i), hrel denominator, mul_div_mul_left _ _ ha]

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]

without_proof_info in
/-- At a zero numerator, division scales the actual native covector by
the reciprocal of the SAME nonzero denominator value. -/
theorem mvfderiv_div_at_zero {u w : M → ℝ} (x : M)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 u x)
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 w x) (hux : u x = 0) (hwx : w x ≠ 0) :
    mvfderiv (𝓡∂ (n + 1)) (u / w) x = (w x)⁻¹ • mvfderiv (𝓡∂ (n + 1)) u x := by
  have hdiv : u / w = u * (fun y => (w y)⁻¹) := by
    funext y
    exact div_eq_mul_inv (u y) (w y)
  rw [hdiv, mvfderiv_mul (hu.mdifferentiableAt one_ne_zero)
    ((hw.inv₀ hwx).mdifferentiableAt one_ne_zero)]
  simp only [hux, zero_smul, zero_add]

without_proof_info in
/-- At a zero numerator and unit denominator, division preserves the actual native covector. -/
theorem mvfderiv_div_at_zero_unit {u w : M → ℝ} (x : M)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 u x)
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 w x) (hux : u x = 0) (hwx : w x = 1) :
    mvfderiv (𝓡∂ (n + 1)) (u / w) x = mvfderiv (𝓡∂ (n + 1)) u x := by
  simpa only [hwx, inv_one, one_smul] using
    mvfderiv_div_at_zero x hu hw hux (by rw [hwx]; exact one_ne_zero)

without_proof_info in
theorem mvfderiv_quotientCoordinates_apply_nonzero {ι : Type*} [Fintype ι]
    (u : ι → M → ℝ) (w : M → ℝ) (x : M)
    (hu : ∀ i, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 (u i) x)
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 w x)
    (hux : ∀ i, u i x = 0) (hwx : w x ≠ 0)
    (v : TangentSpace (𝓡∂ (n + 1)) x) (i : ι) :
    mvfderiv (𝓡∂ (n + 1)) (quotientCoordinates u w) x v i =
      (w x)⁻¹ * mvfderiv (𝓡∂ (n + 1)) (u i) x v := by
  have hQ : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, ι → ℝ) 1 (quotientCoordinates u w) x :=
    contMDiffAt_pi_module_iff.mpr fun i => (hu i).div₀ hw hwx
  have h := congrArg (fun L => L v) (TauCeti.mvfderiv_apply (hQ.mdifferentiableAt one_ne_zero) i)
  change mvfderiv (𝓡∂ (n + 1)) (u i / w) x v =
    mvfderiv (𝓡∂ (n + 1)) (quotientCoordinates u w) x v i at h
  rw [mvfderiv_div_at_zero x (hu i) hw (hux i) hwx, smul_apply, smul_eq_mul] at h
  exact h.symm

without_proof_info in
/-- The derivative of a vector of such quotients evaluates the prescribed numerator covectors. -/
theorem mvfderiv_quotientCoordinates_apply {ι : Type*} [Fintype ι]
    (u : ι → M → ℝ) (w : M → ℝ) (x : M)
    (hu : ∀ i, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 (u i) x)
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 w x)
    (hux : ∀ i, u i x = 0) (hwx : w x = 1)
    (v : TangentSpace (𝓡∂ (n + 1)) x) (i : ι) :
    mvfderiv (𝓡∂ (n + 1)) (quotientCoordinates u w) x v i =
      mvfderiv (𝓡∂ (n + 1)) (u i) x v := by
  simpa only [hwx, inv_one, one_mul] using
    mvfderiv_quotientCoordinates_apply_nonzero u w x hu hw hux (by rw [hwx]; exact one_ne_zero) v i

without_proof_info in
/-- A complete prescribed covector frame makes the quotient differential injective. -/
theorem injective_mvfderiv_quotientCoordinates
    (u : Fin (n + 1) → M → ℝ) (w : M → ℝ) (x : M)
    (hu : ∀ i, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 (u i) x)
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 w x)
    (hux : ∀ i, u i x = 0) (hwx : w x = 1)
    (hdu : ∀ i, mvfderiv (𝓡∂ (n + 1)) (u i) x =
      (EuclideanSpace.proj i : EuclideanSpace ℝ (Fin (n + 1)) →L[ℝ] ℝ)) :
    Function.Injective (mvfderiv (𝓡∂ (n + 1)) (quotientCoordinates u w) x) := by
  intro v v' heq
  change (show EuclideanSpace ℝ (Fin (n + 1)) from v) =
    (show EuclideanSpace ℝ (Fin (n + 1)) from v')
  apply PiLp.ext
  intro i
  have h := congrFun heq i
  rw [mvfderiv_quotientCoordinates_apply u w x hu hw hux hwx v i,
    mvfderiv_quotientCoordinates_apply u w x hu hw hux hwx v' i, hdu i] at h
  exact h

without_proof_info in
theorem injective_mvfderiv_quotientCoordinates_scaled
    (u : Fin (n + 1) → M → ℝ) (w : M → ℝ) (x : M)
    (hu : ∀ i, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 (u i) x)
    (hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 1 w x)
    (hux : ∀ i, u i x = 0) (hwx : w x ≠ 0)
    (hdu : ∀ i, mvfderiv (𝓡∂ (n + 1)) (u i) x =
      w x • (EuclideanSpace.proj i : EuclideanSpace ℝ (Fin (n + 1)) →L[ℝ] ℝ)) :
    Function.Injective (mvfderiv (𝓡∂ (n + 1)) (quotientCoordinates u w) x) := by
  intro v v' heq
  change (show EuclideanSpace ℝ (Fin (n + 1)) from v) =
    (show EuclideanSpace ℝ (Fin (n + 1)) from v')
  apply PiLp.ext
  intro i
  have h := congrFun heq i
  rw [mvfderiv_quotientCoordinates_apply_nonzero u w x hu hw hux hwx v i,
    mvfderiv_quotientCoordinates_apply_nonzero u w x hu hw hux hwx v' i, hdu i] at h
  change (w x)⁻¹ * (w x * (show EuclideanSpace ℝ (Fin (n + 1)) from v) i) =
    (w x)⁻¹ * (w x * (show EuclideanSpace ℝ (Fin (n + 1)) from v') i) at h
  simpa only [← mul_assoc, inv_mul_cancel₀ hwx, one_mul] using h

end ConformalPoisson

end ProofPart_QuotientDifferential

