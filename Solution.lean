theorem schauderDirichletC2Estimate_mono {δ₁ δ₂ C : ℝ≥0}
    (h : SchauderDirichletC2Estimate d α δ₂ C) (hδ : δ₁ ≤ δ₂) :
    SchauderDirichletC2Estimate d α δ₁ C := by
  intro a b q ha hb hq haδ hbδ hqδ F K hF hFK
  exact h a b q ha hb hq (haδ.mono hδ) (hbδ.mono hδ) (hqδ.mono hδ) F K hF hFK

without_proof_info in
theorem schauderDirichletEstimate_of_C2 {δ C : ℝ≥0} (hδ : (δ : ℝ) ≤ 1 / 2)
    (h : SchauderDirichletC2Estimate d α δ C) : SchauderDirichletEstimate d α δ C := by
  intro a b q ha hb hq haδ hbδ hqδ F K hF hFK
  obtain ⟨u, hu, hcont, hbd, heq, hbound⟩ := h a b q ha hb hq haδ hbδ hqδ F K hF hFK
  have hsmall : ∀ x ∈ ball (0 : V) 1, ‖a x - ContinuousLinearMap.id ℝ V‖ ≤ 1 / 2 :=
    fun x hx => (haδ.1 x (ball_subset_closedBall hx)).trans hδ
  have hsmooth := coordinate_classical_contDiffOn isOpen_ball
    (ha.mono ball_subset_closedBall) (hb.mono ball_subset_closedBall)
    (hq.mono ball_subset_closedBall) (hF.mono ball_subset_closedBall) hu hsmall heq
  exact ⟨u, hsmooth, hcont, hbd, heq, hbound⟩

without_proof_info in
/-- All smooth forward-estimate constants are chosen before the
coefficients or forcing; only the constant-coefficient boundary inverse
remains to be constructed. -/
theorem exists_uniform_schauder_constants_of_ball_inverse (hα : α ≤ 1)
    (T : (H ℝ) →L[ℝ] BallSpace α V ℝ)
    (hT : ∀ F : H ℝ, ballLaplacian (d := d) hα (T F) = F) :
    ∃ δ C : ℝ≥0, 0 < δ ∧ 0 < C ∧ SchauderDirichletEstimate d α δ C := by
  obtain ⟨δ, C, hδ, hC, hC2⟩ := exists_uniform_schauder_C2_constants_of_ball_inverse hα T hT
  refine ⟨min δ (1 / 2), C, lt_min hδ (by norm_num), hC, ?_⟩
  apply schauderDirichletEstimate_of_C2
    (show ((min δ (1 / 2) : ℝ≥0) : ℝ) ≤ 1 / 2 by exact_mod_cast min_le_right δ (1 / 2))
  exact schauderDirichletC2Estimate_mono hC2 (min_le_left _ _)

without_proof_info in
/-- A checked reduction of the full local Schauder input to one
canonical bounded Dirichlet Laplacian inverse at each selected exponent.
The displayed inverse family is not currently proved. -/
theorem localSchauder_of_ball_laplacian_inverse
    (hinverse : ∀ β : ℝ≥0, 0 < β → ∀ hβ : β < 1,
      ∃ T : TauCeti.HolderSpace β (closedBall (0 : V) 1) ℝ →L[ℝ] BallSpace β V ℝ,
        ∀ F : TauCeti.HolderSpace β (closedBall (0 : V) 1) ℝ,
          ballLaplacian (d := d) hβ.le (T F) = F) :
    LocalSchauderDirichletAssumption d := by
  intro _ β hβ hβlt
  obtain ⟨T, hT⟩ := hinverse β hβ hβlt
  exact exists_uniform_schauder_constants_of_ball_inverse hβlt.le T hT

end ConformalPoisson.DirichletHolder

