  intro U hU B hB hres
  have hUr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun x => (U x).re) := Complex.reCLM.contDiff.contMDiff.comp hU
  have hUi : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun x => (U x).im) := Complex.imCLM.contDiff.contMDiff.comp hU
  refine ⟨hb _ hUr B hB ?_, hb _ hUi B hB ?_⟩
  · intro x
    change |(complexSchrodinger g q U x).re| ≤ B
    exact (Complex.abs_re_le_norm _).trans (hres x)
  · intro x
    change |(complexSchrodinger g q U x).im| ≤ B
    exact (Complex.abs_im_le_norm _).trans (hres x)

without_proof_info in
theorem residual_depth_bound {C h : ℝ} (hC : 0 ≤ C) (hh : 0 < h) (hh1 : h ≤ 1) (N : ℕ) :
    C * h ^ ((N + 2) + 1) / h ^ 2 ≤ C * h ^ N := by
  have he : C * h ^ ((N + 2) + 1) / h ^ 2 = C * h ^ N * h := by
    rw [show (N + 2) + 1 = N + 3 by omega, pow_add]
    field_simp
    all_goals ring
  rw [he]
  exact (mul_le_mul_of_nonneg_left hh1 (mul_nonneg hC (pow_nonneg hh.le N))).trans_eq (mul_one _)

