noncomputable section ProofPart_GreenTrace_LocalizeScalarSymbol


/- Scalar spatial localization of an actual symbol, retaining its order,
compact spatial support and exact quantization at each position. -/
open TauCeti
open scoped ContDiff SchwartzMap
namespace ConformalPoisson
variable {d : ℕ} {m : ℝ}

def scalarCutoffCoefficient (χ : CoordinateSpace d → ℝ) (x : CoordinateSpace d) : ℂ →L[ℂ] ℂ :=
  (χ x : ℂ) • ContinuousLinearMap.id ℂ ℂ

without_proof_info in
theorem contDiff_scalarCutoffCoefficient {χ : CoordinateSpace d → ℝ}
    (hχ : ContDiff ℝ ∞ χ) : ContDiff ℝ ∞ (scalarCutoffCoefficient χ) := by
  change ContDiff ℝ ∞ (fun x => Complex.ofRealCLM (χ x) • ContinuousLinearMap.id ℂ ℂ)
  exact (Complex.ofRealCLM.contDiff.comp hχ).smul contDiff_const

def localizeScalarSymbol (p : Symbol d ℂ ℂ m) (χ : CoordinateSpace d → ℝ)
    (hχ : ContDiff ℝ ∞ χ) : Symbol d ℂ ℂ m :=
  Symbol.inclusion (by simp : (0 : ℝ) + m ≤ m)
    ((Symbol.ofSpatial (scalarCutoffCoefficient χ) (contDiff_scalarCutoffCoefficient hχ)).comp p)

without_proof_info in
theorem localizeScalarSymbol_coefficient (p : Symbol d ℂ ℂ m)
    (χ : CoordinateSpace d → ℝ) (hχ : ContDiff ℝ ∞ χ) (x ξ : CoordinateSpace d) :
    (localizeScalarSymbol p χ hχ).coefficient (x, ξ) = (χ x : ℂ) • p.coefficient (x, ξ) := by
  rw [localizeScalarSymbol, Symbol.coefficient_inclusion, Symbol.coefficient_comp,
    Symbol.coefficient_ofSpatial]
  apply ContinuousLinearMap.ext
  intro z
  simp only [scalarCutoffCoefficient, ContinuousLinearMap.comp_apply, smul_apply,
    ContinuousLinearMap.id_apply]

without_proof_info in
theorem localizeScalarSymbol_hasCompactSpatialSupport (p : Symbol d ℂ ℂ m)
    (χ : CoordinateSpace d → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχc : HasCompactSupport χ) :
    (localizeScalarSymbol p χ hχ).HasCompactSpatialSupport := by
  have hC : HasCompactSupport (scalarCutoffCoefficient χ) := by
    exact hχc.comp_left (g := fun r : ℝ => (r : ℂ) • ContinuousLinearMap.id ℂ ℂ)
      (by apply ContinuousLinearMap.ext; intro z; simp)
  have hF := (Symbol.hasCompactSpatialSupport_ofSpatial_iff (contDiff_scalarCutoffCoefficient hχ)).mpr hC
  rw [localizeScalarSymbol]
  exact (hF.comp_right p).inclusion (by simp)

without_proof_info in
theorem localizeScalarSymbol_quantize (p : Symbol d ℂ ℂ m)
    (χ : CoordinateSpace d → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (u : 𝓢(CoordinateSpace d, ℂ)) (x : CoordinateSpace d) :
    quantizeSchwartzValue (localizeScalarSymbol p χ hχ).coefficient u x =
      (χ x : ℂ) * quantizeSchwartzValue p.coefficient u x := by
  calc
    _ = quantizeSchwartzValue ((χ x : ℂ) • p.coefficient) u x := by
      apply quantizeSchwartzValue_congr_left
      intro ξ
      rw [localizeScalarSymbol_coefficient]
      rfl
    _ = _ := quantizeSchwartzValue_smul_left _ _ _ _

without_proof_info in
theorem localizeScalarSymbol_coefficient_eq_of_one (p : Symbol d ℂ ℂ m)
    (χ : CoordinateSpace d → ℝ) (hχ : ContDiff ℝ ∞ χ)
    {x : CoordinateSpace d} (hx : χ x = 1) (ξ : CoordinateSpace d) :
    (localizeScalarSymbol p χ hχ).coefficient (x, ξ) = p.coefficient (x, ξ) := by
  rw [localizeScalarSymbol_coefficient, hx, Complex.ofReal_one, one_smul]

end ConformalPoisson

end ProofPart_GreenTrace_LocalizeScalarSymbol

