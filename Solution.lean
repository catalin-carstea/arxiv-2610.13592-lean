noncomputable section ProofPart_DNSymbol_DNDirectionalLinearReadings



/- Assignment268, /root. Ordinary directional first/second derivatives
commute with the actual fixed linear changes and real/imag readings used in
native scalar operator identification. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set
open scoped ContDiff
namespace ConformalPoisson.LocalDN
variable {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G]

without_proof_info in
theorem clm_post_fderiv_direction (L : F →L[ℝ] G) {f : E → F} {x : E}
    (hf : DifferentiableAt ℝ f x) (v : E) :
    fderiv ℝ (L ∘ f) x v = L (fderiv ℝ f x v) := by
  rw [(L.hasFDerivAt.comp x hf.hasFDerivAt).fderiv]
  rfl

without_proof_info in
theorem clm_pre_fderiv_direction (T : E →L[ℝ] F) {f : F → G} {x : E}
    (hf : DifferentiableAt ℝ f (T x)) (v : E) :
    fderiv ℝ (f ∘ T) x v = fderiv ℝ f (T x) (T v) := by
  rw [(hf.hasFDerivAt.comp x T.hasFDerivAt).fderiv]
  rfl

without_proof_info in
theorem directional_fderiv_contDiff {f : E → F} (hf : ContDiff ℝ ∞ f) (v : E) :
    ContDiff ℝ ∞ (fun x => fderiv ℝ f x v) :=
  (hf.fderiv_right (by simp : (∞ : ℕ∞ω) + 1 ≤ ∞)).clm_apply contDiff_const

without_proof_info in
theorem clm_post_fderiv_twice_direction (L : F →L[ℝ] G) {f : E → F}
    (hf : ContDiff ℝ ∞ f) (x u v : E) :
    fderiv ℝ (fun y => fderiv ℝ (L ∘ f) y v) x u =
      L (fderiv ℝ (fun y => fderiv ℝ f y v) x u) := by
  have he : (fun y => fderiv ℝ (L ∘ f) y v) = L ∘ (fun y => fderiv ℝ f y v) :=
    funext (fun y => clm_post_fderiv_direction L (hf.differentiable (by decide) y) v)
  rw [he]
  exact clm_post_fderiv_direction L ((directional_fderiv_contDiff hf v).differentiable (by decide) x) u

without_proof_info in
theorem clm_pre_fderiv_twice_direction (T : E →L[ℝ] F) {f : F → G}
    (hf : ContDiff ℝ ∞ f) (x u v : E) :
    fderiv ℝ (fun y => fderiv ℝ (f ∘ T) y v) x u =
      fderiv ℝ (fun y => fderiv ℝ f y (T v)) (T x) (T u) := by
  have he : (fun y => fderiv ℝ (f ∘ T) y v) = (fun z => fderiv ℝ f z (T v)) ∘ T :=
    funext (fun y => clm_pre_fderiv_direction T (hf.differentiable (by decide) (T y)) v)
  rw [he]
  exact clm_pre_fderiv_direction T ((directional_fderiv_contDiff hf (T v)).differentiable (by decide) (T x)) u

without_proof_info in
theorem fderiv_fderiv_apply_eq_directional {f : E → F} (hf : ContDiff ℝ ∞ f) (x u v : E) :
    fderiv ℝ (fderiv ℝ f) x u v = fderiv ℝ (fun y => fderiv ℝ f y v) x u := by
  have hd : DifferentiableAt ℝ (fderiv ℝ f) x :=
    (hf.fderiv_right (by simp : (∞ : ℕ∞ω) + 1 ≤ ∞)).differentiable (by decide) x
  have he := fderiv_clm_apply hd (differentiableAt_const (c := v))
  have hz : fderiv ℝ (fun _ : E => v) x = 0 := fderiv_const_apply v
  rw [hz] at he
  have hv := congrArg (fun A : E →L[ℝ] F => A u) he
  simpa only [fderiv_const, ContinuousLinearMap.comp_zero, zero_add,
    ContinuousLinearMap.add_apply, ContinuousLinearMap.zero_apply, ContinuousLinearMap.flip_apply] using hv.symm

