    List.map_eq_replicate_iff.mpr (fun i hi => by rw [hz0 i hi])
  have hperm : (vs ++ List.replicate z.length e).Perm (is.map b) := by
    have hp := hparts.map b
    rw [List.map_append, hzmap] at hp
