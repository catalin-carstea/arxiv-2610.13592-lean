/- Proof support: GreenPoissonJetRepresentation.lean, SHA256 51fe1935e06bf2947a70259b9c6d14fb1b9d5858b41977f2df82d1b7b7919820 -/
noncomputable section ProofPart_GreenPoissonJetRepresentation




/- Differentiate the supplied Poisson representation in a common open
interior chart, with the actual compact boundary surface measure. -/
open Set Filter Function MeasureTheory
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance poissonJetBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local instance poissonJetBoundaryAnalytic : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M) :=
  TauCeti.isManifold_boundary M (by decide)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.chartOrdinaryJet_poisson_representation
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (f : (𝓡∂ (n + 1)).boundary M → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f)
    {x : M} (hx : x ∈ (𝓡∂ (n + 1)).interior M) :
    Integrable (fun y => chartOrdinarySecondJet (n := n) x
      (fun z => boundaryPoissonSection ν G.kernel y z * f y)) (nativeSurfaceMeasure g) ∧
    chartOrdinarySecondJet (n := n) x (S.solve f) =
      ∫ y, chartOrdinarySecondJet (n := n) x
        (fun z => boundaryPoissonSection ν G.kernel y z * f y) ∂nativeSurfaceMeasure g := by
  let := nativeSurfaceMeasure_isLocallyFiniteMeasure g
  letI : IsFiniteMeasure (nativeSurfaceMeasure g) := inferInstance
  let c := extChartAt (𝓡∂ (n + 1)) x
  let A : V → (𝓡∂ (n + 1)).boundary M → ℝ :=
    fun z y => boundaryPoissonSection ν G.kernel y (c.symm z) * f y
  have hround : c.symm (c x) = x := c.left_inv (mem_extChartAt_source x)
  obtain ⟨U, hxU, hUI, hP⟩ := G.exists_poisson_chart_domain g q ν hν S hx
  have hA : ContMDiffOn (𝓘(ℝ, V).prod (𝓡 n)) 𝓘(ℝ) ∞ (uncurry A)
      ((U : Set V) ×ˢ univ) :=
    hP.mul (hf.comp contMDiff_snd).contMDiffOn
  have hjet := ordinaryJet_compact_integral_of_contMDiffOn (μ := nativeSurfaceMeasure g)
    (F := A) U.isOpen hxU hA
  have hread : (S.solve f ∘ c.symm) =ᶠ[𝓝 (c x)]
      (fun z => ∫ y, A z y ∂nativeSurfaceMeasure g) := by
    filter_upwards [U.isOpen.mem_nhds hxU] with z hz
    exact (G.poisson_representation f hf (c.symm z) (hUI z hz)).2
  have hd := hread.fderiv_eq (𝕜 := ℝ)
  have hdg : fderiv ℝ (S.solve f ∘ c.symm) =ᶠ[𝓝 (c x)]
      fderiv ℝ (fun z => ∫ y, A z y ∂nativeSurfaceMeasure g) :=
    hread.eventuallyEq_nhds.mono (fun z hz => hz.fderiv_eq (𝕜 := ℝ))
  have hdd := hdg.fderiv_eq (𝕜 := ℝ)
  have hval : S.solve f x = ∫ y, A (c x) y ∂nativeSurfaceMeasure g := by
    simpa only [A, hround] using (G.poisson_representation f hf x hx).2
  have hJ : (fun y => ordinaryJet (A (c x) y) (fderiv ℝ (fun z => A z y) (c x))
      (fderiv ℝ (fderiv ℝ (fun z => A z y)) (c x))) =
      (fun y => chartOrdinarySecondJet (n := n) x
        (fun z => boundaryPoissonSection ν G.kernel y z * f y)) := by
    funext y
    simp only [chartOrdinarySecondJet, A, hround, c]
    rfl
  refine ⟨hJ ▸ hjet.1, ?_⟩
  calc
    chartOrdinarySecondJet (n := n) x (S.solve f) =
        ordinaryJet (∫ y, A (c x) y ∂nativeSurfaceMeasure g)
          (fderiv ℝ (fun z => ∫ y, A z y ∂nativeSurfaceMeasure g) (c x))
          (fderiv ℝ (fderiv ℝ (fun z => ∫ y, A z y ∂nativeSurfaceMeasure g)) (c x)) := by
      change ordinaryJet (S.solve f x) (fderiv ℝ (S.solve f ∘ c.symm) (c x))
        (fderiv ℝ (fderiv ℝ (S.solve f ∘ c.symm)) (c x)) = _
      rw [hval, hd, hdd]
    _ = _ := hjet.2.trans (congrArg (fun F => ∫ y, F y ∂nativeSurfaceMeasure g) hJ)

end ConformalPoisson

end ProofPart_GreenPoissonJetRepresentation

/- Proof support: GreenNormalMoment.lean, SHA256 18573a77f151e98cec89d5d06b27d96f6b249009cd422d88ea276a7876c6404a -/
noncomputable section ProofPart_GreenNormalMoment



/- The boundary moment of the actual Green-jet combination. No Runge or
interior uniqueness premise enters the differentiation of the representation. -/
open Set Filter Function MeasureTheory
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenNormalMomentBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.nativeJet_poisson_moment
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {N : ℕ} (points : Fin N → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : Fin N) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    (f : (𝓡∂ (n + 1)).boundary M → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f) :
    Integrable (fun y => ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y)
        (points i)) * f y) (nativeSurfaceMeasure g) ∧
      ℓ (fun i => secondJet g (S.solve f) (points i)) =
        ∫ y, ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) * f y
          ∂nativeSurfaceMeasure g := by
  classical
  obtain ⟨L, hLift⟩ := exists_simultaneous_continuous_ordinary_jet_functional g points ℓ
  let J : (𝓡∂ (n + 1)).boundary M → Fin N → OrdinaryJet V := fun y i =>
    chartOrdinarySecondJet (n := n) (points i) (fun z => boundaryPoissonSection ν G.kernel y z * f y)
  have hm (i : Fin N) := G.chartOrdinaryJet_poisson_representation g q ν hν S f hf (hpoints i)
  have hInt : Integrable J (nativeSurfaceMeasure g) := Integrable.of_eval fun i => (hm i).1
  have hw := (S.correct f hf).1
  have hWread : (fun i => nativeChartJetLinearMap g (points i) (secondJet g (S.solve f) (points i))) =
      (fun i => chartOrdinarySecondJet (n := n) (points i) (S.solve f)) := by
    funext i
    exact nativeChartJetLinearMap_secondJet g (points i) (hpoints i)
      (hw.of_le (by decide)).contMDiffAt
  have hMoment : (fun i => chartOrdinarySecondJet (n := n) (points i) (S.solve f)) =
      ∫ y, J y ∂nativeSurfaceMeasure g := by
    funext i
    exact (hm i).2.trans (eval_integral (fun i => (hm i).1) i).symm
  have hP (y : (𝓡∂ (n + 1)).boundary M) (i : Fin N) :
      ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (boundaryPoissonSection ν G.kernel y) (points i) := by
    have hne : points i ≠ (y : M) := by
      intro heq
      exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary
        (heq ▸ hpoints i) y.property
    exact ((G.poisson_section_smooth y (points i) hne).contMDiffAt
      (isOpen_compl_singleton.mem_nhds hne)).of_le (by decide)
  have hIntegrand (y : (𝓡∂ (n + 1)).boundary M) :
      L (J y) = ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) * f y := by
    have hProductRead :
        (fun i => nativeChartJetLinearMap g (points i)
          (secondJet g (fun z => boundaryPoissonSection ν G.kernel y z * f y) (points i))) = J y := by
      funext i
      exact nativeChartJetLinearMap_secondJet g (points i) (hpoints i) ((hP y i).mul contMDiffAt_const)
    have hsplit : (fun i => secondJet g
        (fun z => boundaryPoissonSection ν G.kernel y z * f y) (points i)) =
        f y • (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) := by
      funext i
      have hfun : (fun z => boundaryPoissonSection ν G.kernel y z * f y) =
          f y • boundaryPoissonSection ν G.kernel y := by funext z; exact mul_comm _ _
      rw [hfun]
      exact secondJet_smul_at g (f y) (hP y i)
    calc
      L (J y) = L (fun i => nativeChartJetLinearMap g (points i)
          (secondJet g (fun z => boundaryPoissonSection ν G.kernel y z * f y) (points i))) :=
        congrArg L hProductRead.symm
      _ = ℓ (fun i => secondJet g (fun z => boundaryPoissonSection ν G.kernel y z * f y) (points i)) :=
        hLift _
      _ = f y * ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) := by
        rw [hsplit, map_smul]
        rfl
      _ = _ := mul_comm _ _
  have hFun : (fun y => L (J y)) =
      (fun y => ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) * f y) :=
    funext hIntegrand
  refine ⟨hFun ▸ L.integrable_comp hInt, ?_⟩
  calc
    ℓ (fun i => secondJet g (S.solve f) (points i)) =
        L (fun i => nativeChartJetLinearMap g (points i) (secondJet g (S.solve f) (points i))) :=
      (hLift _).symm
    _ = L (fun i => chartOrdinarySecondJet (n := n) (points i) (S.solve f)) := congrArg L hWread
    _ = L (∫ y, J y ∂nativeSurfaceMeasure g) := congrArg L hMoment
    _ = ∫ y, L (J y) ∂nativeSurfaceMeasure g := (L.integral_comp_comm hInt).symm
    _ = _ := congrArg (fun F => ∫ y, F y ∂nativeSurfaceMeasure g) hFun

without_proof_info in
theorem DirichletGreenKernel.greenJetSection_normal_moment
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {N : ℕ} (points : Fin N → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : Fin N) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    (Γ : Set ((𝓡∂ (n + 1)).boundary M)) (f : BoundaryDatum Γ) :
    Integrable (fun y => normalDerivative ν (greenJetSection g points ℓ G.kernel) y * f.val y)
      (nativeSurfaceMeasure g) ∧
    ℓ (fun i => secondJet g (S.solve f.val) (points i)) =
      -∫ y, normalDerivative ν (greenJetSection g points ℓ G.kernel) y * f.val y
        ∂nativeSurfaceMeasure g := by
  have hm := G.nativeJet_poisson_moment g q ν hν S points hpoints ℓ f.val f.property.1
  have hfun : (fun y => normalDerivative ν (greenJetSection g points ℓ G.kernel) y * f.val y) =
      -(fun y => ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) * f.val y) := by
    funext y
    rw [G.greenJetSection_normal_eq_poisson_jets g q ν S points hpoints ℓ y]
    exact neg_mul _ _
  refine ⟨hfun ▸ hm.1.neg, ?_⟩
  rw [hfun]
  change ℓ (fun i => secondJet g (S.solve f.val) (points i)) =
    -∫ y, -(ℓ (fun i => secondJet g (boundaryPoissonSection ν G.kernel y) (points i)) * f.val y)
      ∂nativeSurfaceMeasure g
  rw [integral_neg, neg_neg]
  exact hm.2

end ConformalPoisson

