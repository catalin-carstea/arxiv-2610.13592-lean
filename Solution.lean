  have hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u :=
    (S.correct f.val f.property.1).1.comp contMDiff_subtype_val
  have hv : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ v := hu.div₀ hc (fun y => (hcpos y).ne')
  have hvx : v x ≠ 0 := by
    change S.solve f.val x / c x ≠ 0
    rw [hf]
    exact div_ne_zero one_ne_zero (hcpos x).ne'
  have hmul : c * v = u := by
    funext y
    exact mul_div_cancel₀ (u y) (hcpos y).ne'
