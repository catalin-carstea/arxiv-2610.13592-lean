noncomputable section ProofPart_ConformalCombination




/-
The recovered first-order covector identity makes r*a^((d-2)/4) constant on a
connected domain. This is the actual differential/connectedness integration,
without presupposing a conformal power or constant factor.
-/

open Bundle
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

omit [IsManifold (𝓡∂ (n + 1)) ω M] in
set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem mvfderiv_conformal_combination_eq_zero
    (a r : M → ℝ) (ha : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a)
    (hapos : ∀ x, 0 < a x) (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r)
    (hfirst : ∀ x, (2 : ℝ) • mvfderiv (𝓡∂ (n + 1)) r x +
      ((((n + 1 : ℝ) - 2) / (2 * a x)) * r x) • mvfderiv (𝓡∂ (n + 1)) a x = 0) :
    ∀ x, mvfderiv (𝓡∂ (n + 1))
      (fun y => r y * (a y) ^ (((n + 1 : ℝ) - 2) / 4)) x = 0 := by
  intro x
  let t : ℝ := ((n + 1 : ℝ) - 2) / 4
  have hp := ha.rpow_const_of_ne (fun y => (hapos y).ne') t
  have hφ := Real.hasDerivAt_rpow_const (p := t) (Or.inl (hapos x).ne')
  have hD := TauCeti.mvfderiv_scalar_comp (ha.mdifferentiable (by decide) x) hφ.differentiableAt
  change mvfderiv (𝓡∂ (n + 1)) (r * (fun y => (a y) ^ t)) x = 0
  rw [mvfderiv_mul (hr.mdifferentiable (by decide) x) (hp.mdifferentiable (by decide) x)]
  change mvfderiv (𝓡∂ (n + 1)) (fun y => (a y) ^ t) x =
    deriv (fun s : ℝ => s ^ t) (a x) • mvfderiv (𝓡∂ (n + 1)) a x at hD
  rw [hD, hφ.deriv]
  ext v
  simp only [add_apply, smul_apply, smul_eq_mul, zero_apply]
  rw [Real.rpow_sub_one (hapos x).ne' t]
  have hv := congrArg (fun L => L v) (hfirst x)
  simp only [add_apply, smul_apply, smul_eq_mul, zero_apply] at hv
  convert congrArg (fun z : ℝ => (a x) ^ t / 2 * z) hv using 1 <;>
    dsimp only [t] <;> field_simp [(hapos x).ne'] <;> ring

without_proof_info in
theorem exists_positive_constant_conformal_combination [PreconnectedSpace M]
    (a r : M → ℝ) (ha : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a)
    (hapos : ∀ x, 0 < a x) (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r)
    (hrpos : ∀ x, 0 < r x) (x₀ : M)
    (hfirst : ∀ x, (2 : ℝ) • mvfderiv (𝓡∂ (n + 1)) r x +
      ((((n + 1 : ℝ) - 2) / (2 * a x)) * r x) • mvfderiv (𝓡∂ (n + 1)) a x = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ x, r x * (a x) ^ (((n + 1 : ℝ) - 2) / 4) = C := by
  let F : M → ℝ := fun x => r x * (a x) ^ (((n + 1 : ℝ) - 2) / 4)
  have hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F :=
    hr.mul (ha.rpow_const_of_ne (fun x => (hapos x).ne') _)
  have hzero := mvfderiv_conformal_combination_eq_zero a r ha hapos hr hfirst
  refine ⟨F x₀, mul_pos (hrpos x₀) (Real.rpow_pos_of_pos (hapos x₀) _), ?_⟩
  intro x
  exact (hF.mdifferentiable (by decide)).apply_eq_of_mfderiv_eq_zero hzero x x₀

end ConformalPoisson

end ProofPart_ConformalCombination

