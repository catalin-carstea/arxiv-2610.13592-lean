noncomputable section ProofPart_GreenTrace_SplitChartL2InverseBound





/- The actual chart inverse bounds in precisely the canonical split-volume
norms appearing in the quantitative boundary estimate. -/
open Bundle Set Metric MeasureTheory TopologicalSpace Filter TauCeti Module
open scoped Manifold ContDiff Topology Gradient ENNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

without_proof_info in
theorem native_zero_dirichlet_split_chart_l2_bounds
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) :
    ∀ c : M, ∃ ρ > 0, ∃ D ≥ 0,
      (closedBall (extChartAt Ihalf c c) ρ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∀ F u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F → IsZeroDirichletSolution g q F u →
        lpNorm (fun t : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))) 2
            (volume.restrict (splitBoundaryChartCap (n := n) c ρ : Set P)) +
          lpNorm (∇ (fun t : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t)))) 2
            (volume.restrict (splitBoundaryChartCap (n := n) c ρ : Set P)) ≤
          D * (eLpNorm F 2 (nativeVolume g)).toReal := by
  obtain ⟨_, _, _, hchart⟩ := native_zero_dirichlet_l2_and_chart_bounds g q hq hNR
  obtain ⟨CV, hCV, hvalfactor⟩ := exists_haar_lpNorm_factor (F := ℝ)
    (volume : Measure V) (Module.finBasis ℝ V).addHaar (p := 2) (by norm_num)
  obtain ⟨CG, hCG, hgradfactor⟩ := exists_haar_lpNorm_factor (F := V)
    (volume : Measure V) (Module.finBasis ℝ V).addHaar (p := 2) (by norm_num)
  intro c
  obtain ⟨ρ, hρ, D, hD, htarget, hbound⟩ := hchart c
  let K := max CV CG
  have hK : 0 ≤ K := hCV.trans (le_max_left _ _)
  refine ⟨ρ, hρ, K * D, mul_nonneg hK hD, htarget, fun F u hF hu => ?_⟩
  let f : V → ℝ := u ∘ (extChartAt Ihalf c).symm
  let e := euclideanNormalSplit n
  let Ω := boundaryChartCap (I := Ihalf) c ρ
  let ΩP := splitBoundaryChartCap (n := n) c ρ
  have he : MeasurePreserving e (volume : Measure P) (volume : Measure V) := e.measurePreserving
  have hcap : (ΩP : Set P) = e ⁻¹' (Ω : Set V) := rfl
  have her := hcap ▸ he.restrict_preimage Ω.isOpen.measurableSet
  obtain ⟨U, hU⟩ := exists_Wkp_boundary_chart_reading (μ := (volume : Measure V))
    (p := 2) c htarget hu.1 1
  have hUv : W1p.value U =ᵐ[volume.restrict (Ω : Set V)] f := by
    rw [Wkp.value_one] at hU
    exact hU
  have hfSmooth : ContDiffOn ℝ ∞ f Ω := by
    have huS : ContMDiffOn Ihalf 𝓘(ℝ) ∞ u (extChartAt Ihalf c).source := hu.1.contMDiffOn
    have hs : ContDiffOn ℝ ∞ f (extChartAt Ihalf c).target :=
      ((huS.comp (contMDiffOn_extChartAt_symm c)
        (fun z hz => (extChartAt Ihalf c).map_target hz)).contDiffOn)
    exact hs.mono ((boundaryChartCap_subset_interior_target c htarget).trans interior_subset)
  have hUg := W1p.gradient_ae_eq_of_contDiffOn U (hfSmooth.of_le (by simp)) hUv
  have hfm : AEStronglyMeasurable f (volume.restrict (Ω : Set V)) :=
    (Lp.aestronglyMeasurable (W1p.value U)).congr hUv
  have hgm : AEStronglyMeasurable (∇ f) (volume.restrict (Ω : Set V)) :=
    (Lp.aestronglyMeasurable (W1p.gradient U)).congr hUg
  have hval : lpNorm (f ∘ e) 2 (volume.restrict (ΩP : Set P)) =
      lpNorm f 2 (volume.restrict (Ω : Set V)) := by
    unfold lpNorm
    rw [eLpNorm_comp_measurePreserving hfm her]
  have hgrad := lpNorm_gradient_comp_isometry e her (p := 2) hgm
  change lpNorm (f ∘ e) 2 (volume.restrict (ΩP : Set P)) +
    lpNorm (∇ (f ∘ e)) 2 (volume.restrict (ΩP : Set P)) ≤
      K * D * (eLpNorm F 2 (nativeVolume g)).toReal
  rw [hval, hgrad, hvalfactor, hgradfactor]
  have hvK := mul_le_mul_of_nonneg_right (le_max_left CV CG)
    (lpNorm_nonneg (f := f) (p := 2) (μ := (Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)))
  have hgK := mul_le_mul_of_nonneg_right (le_max_right CV CG)
    (lpNorm_nonneg (f := ∇ f) (p := 2) (μ := (Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)))
  refine (add_le_add hvK hgK).trans ?_
  calc
    max CV CG * lpNorm f 2 ((Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)) +
        max CV CG * lpNorm (∇ f) 2 ((Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)) =
        K * (lpNorm f 2 ((Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)) +
          lpNorm (∇ f) 2 ((Module.finBasis ℝ V).addHaar.restrict (Ω : Set V))) := by
      dsimp only [K]
      ring
    _ ≤ K * (D * (eLpNorm F 2 (nativeVolume g)).toReal) :=
      mul_le_mul_of_nonneg_left (hbound F u hF hu) hK
    _ = _ := by ring

end ConformalPoisson

