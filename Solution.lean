    TangentBundle.contMDiffVectorBundle
  obtain ⟨X, hX, hXx⟩ := FiberBundle.exists_contMDiff_section_eq Ihalf V ∞ v
  have hswap : ContMDiffOn (J.prod (𝓡∂ (n + 1))) 𝓘(ℝ) ∞
      (fun p : Y × M => F p.2 p.1) (univ ×ˢ U) :=
    hF.comp (contMDiff_snd.prodMk contMDiff_fst).contMDiffOn (fun p (hp : p ∈ (univ : Set Y) ×ˢ U) => ⟨hp.2, mem_univ _⟩)
  have hA : ContMDiff (J.prod (𝓡∂ (n + 1))) ((𝓡∂ (n + 1)).tangent) ∞
      (fun p : Y × M => (TotalSpace.mk' V p.2 (X p.2) : TangentBundle Ihalf M)) :=
    hX.comp contMDiff_snd
  have hDswap := hswap.contMDiffOn_mvfderiv_snd_apply (isOpen_univ.prod hU)
    hA.contMDiffOn (by simp : (∞ : ℕ∞ω) + 1 ≤ (∞ : ℕ∞ω))
  have hD : ContMDiffOn ((𝓡∂ (n + 1)).prod J) 𝓘(ℝ) ∞
      (fun p : M × Y => mvfderiv Ihalf (fun z => F z p.2) p.1 (X p.1)) (U ×ˢ univ) :=
    hDswap.comp (contMDiff_snd.prodMk contMDiff_fst).contMDiffOn (fun p (hp : p ∈ U ×ˢ (univ : Set Y)) => ⟨mem_univ _, hp.1⟩)
  have hInt (z : M) (hz : z ∈ U) :
      Integrable (fun y => mvfderiv Ihalf (fun z => F z y) z (X z)) μ := by
    simpa only [integrableOn_univ] using
      ContinuousOn.integrableOn_compact (μ := μ) isCompact_univ
        (hD.continuousOn.uncurry_left (f := fun z y => mvfderiv Ihalf (fun z => F z y) z (X z)) z hz)
  have hHc : Continuous (fun p : U × Y =>
      mvfderiv Ihalf (fun z => F z p.2) (p.1 : M) (X (p.1 : M))) :=
    hD.continuousOn.comp_continuous
      ((continuous_subtype_val.comp continuous_fst).prodMk continuous_snd)
      (fun p => ⟨p.1.property, mem_univ _⟩)
  have hIntegral : ContinuousOn
      (fun z => ∫ y, mvfderiv Ihalf (fun z => F z y) z (X z) ∂μ) U := by
    rw [continuousOn_iff_continuous_domRestrict]
    change Continuous (fun z : U => ∫ y, mvfderiv Ihalf (fun z => F z y) (z : M) (X (z : M)) ∂μ)
    simpa only [Measure.restrict_univ] using
      continuous_parametric_integral_of_continuous (μ := μ)
        (f := fun (z : U) (y : Y) => mvfderiv Ihalf (fun z => F z y) (z : M) (X (z : M)))
        hHc isCompact_univ
  have hNative : ContinuousOn (fun z => mvfderiv Ihalf u z (X z)) U :=
    (hu.contMDiffOn_mvfderiv_apply hU hX.contMDiffOn
      (by simp : (∞ : ℕ∞ω) + 1 ≤ (∞ : ℕ∞ω))).continuousOn
  have hEqI : EqOn (fun z => mvfderiv Ihalf u z (X z))
      (fun z => ∫ y, mvfderiv Ihalf (fun z => F z y) z (X z) ∂μ)
      (U ∩ (Ihalf).interior M) := by
    intro z hz
    exact (native_interior_compact_integral_derivative hU hF hu heq hz.1 hz.2 (X z)).2
  have hEq := hEqI.of_subset_closure hNative hIntegral inter_subset_left
    (subset_closure_inter_of_open_dense (native_interior_dense g) hU)
  simpa only [hXx] using And.intro (hInt x hx) (hEq hx)
end ConformalPoisson

