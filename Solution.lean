noncomputable section ProofPart_BoundaryAnalytic_BoundaryNormalDrift


/- The analytic drift before reflection, and its actual rescaled normal
factor. This keeps the extra normal-coordinate scale explicit. -/
open Set
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

without_proof_info in
@[simp] theorem boundaryTangentialProjection_normal_vector (c : ℝ) :
    boundaryTangentialProjection (c • e) = (0 : V) := by
  rw [map_smul, boundaryTangentialProjection_apply]
  rw [boundaryReflection_single]
  simp

without_proof_info in
@[simp] theorem boundaryTangentialProjection_idem (v : V) :
    boundaryTangentialProjection (boundaryTangentialProjection v) = boundaryTangentialProjection v :=
  boundaryTangentialProjection_eq_self _ (boundaryTangentialProjection_normal v)

def boundaryNormalDrift (β : V → V) (x : V) : V :=
  boundaryTangentialProjection (β x) + (x 0 * (β x) 0) • e

without_proof_info in
@[simp] theorem boundaryNormalDrift_normal (β : V → V) (x : V) :
    boundaryNormalDrift β x 0 = x 0 * (β x) 0 := by simp [boundaryNormalDrift]

without_proof_info in
theorem boundaryNormalDrift_analyticOnNhd (β : V → V) {W : Set V}
    (hβ : AnalyticOnNhd ℝ β W) : AnalyticOnNhd ℝ (boundaryNormalDrift β) W := by
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  intro x hx
  exact ((boundaryTangentialProjection.analyticAt _).comp (hβ x hx)).add
    (((N.analyticAt x).mul ((N.analyticAt _).comp (hβ x hx))).smul analyticAt_const)

def boundaryRescaledDriftBundle (ε : ℝ) (β : V → V) (x : V) : V :=
  ε • boundaryTangentialProjection (β (ε • x)) + (ε ^ 2 * (β (ε • x)) 0) • e

without_proof_info in
theorem boundaryRescaledDriftBundle_analyticOnNhd (ε : ℝ) (β : V → V) {W U : Set V}
    (hmap : MapsTo (fun x : V => ε • x) U W) (hβ : AnalyticOnNhd ℝ β W) :
    AnalyticOnNhd ℝ (boundaryRescaledDriftBundle ε β) U := by
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  intro x hx
  have hg := (hβ _ (hmap hx)).comp (analyticAt_id.const_smul (c := ε))
  exact (((boundaryTangentialProjection.analyticAt _).comp hg).const_smul (c := ε)).add
    ((analyticAt_const.mul ((N.analyticAt _).comp hg)).smul analyticAt_const)

without_proof_info in
theorem boundaryNormalDrift_rescale (ε : ℝ) (β : V → V) (x : V) :
    boundaryNormalDrift (boundaryRescaledDriftBundle ε β) x =
      ε • boundaryNormalDrift β (ε • x) := by
  have he : boundaryTangentialProjection e = (0 : V) := by
    simpa using boundaryTangentialProjection_normal_vector (n := n) (1 : ℝ)
  simp [boundaryNormalDrift, boundaryRescaledDriftBundle, he, smul_smul]
  ring

without_proof_info in
theorem normalFactorReflectedDrift_rescaledBundle (ε : ℝ) (β : V → V) (x : V) :
    normalFactorReflectedDrift (boundaryRescaledDriftBundle ε β) x =
      boundaryTangentialProjection (ε • β (ε • boundaryFold x)) +
        (ε * x 0 * (ε • β (ε • boundaryFold x)) 0) • e := by
  have he : boundaryTangentialProjection e = (0 : V) := by
    simpa using boundaryTangentialProjection_normal_vector (n := n) (1 : ℝ)
  simp [normalFactorReflectedDrift, boundaryRescaledDriftBundle,
    he]
  ring

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryNormalDrift

/- Boundary analytic support: BoundaryAnalyticDriftGauge.lean, SHA256 e4bf95cf4a97624f7e9fd5c9d56aa0491e7767bc98b4aa3849e131bb26323649 -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryAnalyticDriftGauge




/- An explicit analytic multiplier removes the normal drift on the face.
It is constructed directly from the coefficient and does not use analytic
regularity of any solution or a potential-killing PDE gauge. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem principalCrossVector_normal
    (A : V →L[ℝ] V) (ξ : V →L[ℝ] ℝ) (hAn : A e = e)
    (hrow : ∀ v : V, A v 0 = v 0) : principalCrossVector A ξ 0 = 2 * ξ e := by
  classical
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  change N (principalCrossVector A ξ) = _
  rw [covector_principalCrossVector, Finset.sum_eq_single 0]
  · simp [N, hAn]
    ring
  · intro i _ hi
    have hr : N (A (EuclideanSpace.single i 1)) = 0 := by
      change A (EuclideanSpace.single i 1) 0 = 0
      rw [hrow]
      simp [Ne.symm hi]
    simp [hr, N, Ne.symm hi]
  · simp

def boundaryDriftGauge (b : V → V) (x : V) : ℝ :=
  Real.exp (x 0 * ((b (boundaryTangentialProjection x)) 0 / 2))

without_proof_info in
theorem boundaryDriftGauge_pos (b : V → V) (x : V) : 0 < boundaryDriftGauge b x := Real.exp_pos _

without_proof_info in
theorem boundaryDriftGauge_face (b : V → V) (x : V) (hx : x 0 = 0) :
    boundaryDriftGauge b x = 1 := by simp [boundaryDriftGauge, hx]

without_proof_info in
theorem boundaryDriftGauge_analyticAt (b : V → V) (x : V)
    (hb : AnalyticAt ℝ b (boundaryTangentialProjection x)) : AnalyticAt ℝ (boundaryDriftGauge b) x := by
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  exact ((N.analyticAt x).mul
    ((((N.analyticAt _).comp (hb.comp (boundaryTangentialProjection.analyticAt x))).div_const))).rexp'

set_option maxHeartbeats 800000 in
without_proof_info in
theorem boundaryDriftGauge_normal_derivative (b : V → V) (x : V)
    (hb : DifferentiableAt ℝ b (boundaryTangentialProjection x)) :
    fderiv ℝ (boundaryDriftGauge b) x e =
      boundaryDriftGauge b x * ((b (boundaryTangentialProjection x)) 0 / 2) := by
  let P : V →L[ℝ] V := boundaryTangentialProjection
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  have he : P e = 0 := by simpa [P] using boundaryTangentialProjection_normal_vector (n := n) (1 : ℝ)
  have hread : HasFDerivAt (fun y : V => (b (P y)) 0)
      (N.comp ((fderiv ℝ b (P x)).comp P)) x :=
    N.hasFDerivAt.comp x (hb.hasFDerivAt.comp x P.hasFDerivAt)
  have hhalf : HasFDerivAt (fun y : V => (b (P y)) 0 / 2)
      ((1 / 2 : ℝ) • (N.comp ((fderiv ℝ b (P x)).comp P))) x := by
    simpa only [Pi.smul_def, smul_eq_mul, one_div, div_eq_mul_inv, one_mul, mul_comm]
      using hread.const_smul (1 / 2 : ℝ)
  have hf := (N.hasFDerivAt.mul hhalf).exp
  have hd := congrArg (fun L : V →L[ℝ] ℝ => L e) hf.fderiv
  change (fderiv ℝ (fun y : V => Real.exp (y 0 * ((b (boundaryTangentialProjection y)) 0 / 2))) x) e = _
  simpa [Pi.mul_apply, boundaryDriftGauge, N, he, P] using hd

def boundaryGaugeDrift (A : V → V →L[ℝ] V) (b : V → V) (x : V) : V :=
  b x - (boundaryDriftGauge b x)⁻¹ • principalCrossVector (A x) (fderiv ℝ (boundaryDriftGauge b) x)

without_proof_info in
theorem boundaryGaugeDrift_normal_face
    (A : V → V →L[ℝ] V) (b : V → V) (x : V) (hx : x 0 = 0)
    (hb : DifferentiableAt ℝ b x) (hAn : A x e = e) (hrow : ∀ v : V, A x v 0 = v 0) :
    boundaryGaugeDrift A b x 0 = 0 := by
  have hPx : boundaryTangentialProjection x = x := boundaryTangentialProjection_eq_self x hx
  simp only [boundaryGaugeDrift, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul,
    boundaryDriftGauge_face b x hx, inv_one, one_mul,
    principalCrossVector_normal (A x) _ hAn hrow]
  rw [boundaryDriftGauge_normal_derivative b x (hPx.symm ▸ hb),
    boundaryDriftGauge_face b x hx, hPx]
  ring

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryAnalyticDriftGauge

/- Boundary analytic support: BoundaryGaugeOperator.lean, SHA256 54ac3ab15b136b2cd67cb3e0ac6acae8ed75eaf507cefd702aeb41dc22142cc6 -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryGaugeOperator



/- Exact conjugation by the explicit analytic boundary drift multiplier. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def boundaryGaugePotential (A : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) (x : V) : ℝ :=
  (boundaryDriftGauge b x)⁻¹ * coordinateSchrodinger A b q (boundaryDriftGauge b) x

without_proof_info in
theorem boundaryGaugeDrift_analyticAt
    {A : V → V →L[ℝ] V} {b : V → V} {x : V}
    (hA : AnalyticAt ℝ A x) (hb : AnalyticAt ℝ b x)
    (hbP : AnalyticAt ℝ b (boundaryTangentialProjection x)) :
    AnalyticAt ℝ (boundaryGaugeDrift A b) x := by
  have hγ := boundaryDriftGauge_analyticAt b x hbP
  exact hb.sub ((hγ.inv (boundaryDriftGauge_pos b x).ne').smul
    (principalCrossVector_analyticAt hA hγ.fderiv))

without_proof_info in
theorem boundaryGaugePotential_analyticAt
    {A : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ} {x : V}
    (hA : AnalyticAt ℝ A x) (hb : AnalyticAt ℝ b x) (hq : AnalyticAt ℝ q x)
    (hbP : AnalyticAt ℝ b (boundaryTangentialProjection x)) :
    AnalyticAt ℝ (boundaryGaugePotential A b q) x := by
  have hγ := boundaryDriftGauge_analyticAt b x hbP
  exact (hγ.inv (boundaryDriftGauge_pos b x).ne').mul (coordinateSchrodinger_analyticAt hA hb hq hγ)

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem coordinateSchrodinger_boundaryDriftGauge_mul
    (A : V → V →L[ℝ] V) (b : V → V) (q v : V → ℝ) (x : V)
    (hγ : ContDiffAt ℝ 2 (boundaryDriftGauge b) x) (hv : ContDiffAt ℝ 2 v x) :
    coordinateSchrodinger A b q ((boundaryDriftGauge b) * v) x =
      boundaryDriftGauge b x *
        coordinateSchrodinger A (boundaryGaugeDrift A b) (boundaryGaugePotential A b q) v x := by
  rw [coordinateSchrodinger_mul A b q (boundaryDriftGauge b) v x hγ hv]
  let γ := boundaryDriftGauge b
  change -(∑ i, fderiv ℝ (fderiv ℝ v) x (EuclideanSpace.single i 1)
      ((γ x • A x) (EuclideanSpace.single i 1))) +
      fderiv ℝ v x (γ x • b x - principalCrossVector (A x) (fderiv ℝ γ x)) +
      coordinateSchrodinger A b q γ x * v x =
    γ x * (-(∑ i, fderiv ℝ (fderiv ℝ v) x (EuclideanSpace.single i 1)
      (A x (EuclideanSpace.single i 1))) +
      fderiv ℝ v x (b x - (γ x)⁻¹ • principalCrossVector (A x) (fderiv ℝ γ x)) +
      ((γ x)⁻¹ * coordinateSchrodinger A b q γ x) * v x)
  simp only [smul_apply, map_smul, map_sub, smul_eq_mul, ← Finset.mul_sum]
  have hγ0 : γ x ≠ 0 := (boundaryDriftGauge_pos b x).ne'
  field_simp
  <;> ring

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryGaugeOperator

/- Boundary analytic support: BoundaryHalfBallGeometry.lean, SHA256 3754693a91f43d6f7780a96eb31f7fc2ac83c74010f23fa4521baa572fc9f59a -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryHalfBallGeometry





/- The physical one-sided balls used by the boundary argument. -/
open Set Metric Filter Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def boundaryHalfBall (r : ℝ) : Set V := ball 0 r ∩ {x : V | 0 ≤ x 0}

without_proof_info in
theorem interior_boundaryHalfBall (r : ℝ) :
    interior (boundaryHalfBall (n := n) r) = ball 0 r ∩ {x : V | 0 < x 0} := by
  rw [boundaryHalfBall, interior_inter, isOpen_ball.interior_eq, interior_halfSpace]

without_proof_info in
theorem convex_boundaryHalfBall (r : ℝ) : Convex ℝ (boundaryHalfBall (n := n) r) := by
  have hlin : IsLinearMap ℝ (fun x : V => x 0) := ⟨fun _ _ => rfl, fun _ _ => rfl⟩
  exact (convex_ball 0 r).inter (convex_halfSpace_ge hlin 0)

without_proof_info in
theorem nonempty_interior_boundaryHalfBall {r : ℝ} (hr : 0 < r) :
    (interior (boundaryHalfBall (n := n) r)).Nonempty := by
  rw [interior_boundaryHalfBall]
  refine ⟨(r / 2) • (EuclideanSpace.single 0 1 : V), ?_, ?_⟩
  · rw [mem_ball_zero_iff, norm_smul]
    simp [Real.norm_eq_abs, abs_of_pos hr, EuclideanSpace.single]
    linarith
  · simpa using (show 0 < r / 2 by positivity)

without_proof_info in
theorem uniqueDiffOn_boundaryHalfBall {r : ℝ} (hr : 0 < r) :
    UniqueDiffOn ℝ (boundaryHalfBall (n := n) r) :=
  uniqueDiffOn_convex (convex_boundaryHalfBall r) (nonempty_interior_boundaryHalfBall hr)

without_proof_info in
theorem boundaryHalfBall_subset_closure_interior {r : ℝ} (hr : 0 < r) :
    boundaryHalfBall (n := n) r ⊆ closure (interior (boundaryHalfBall r)) := by
  rw [(convex_boundaryHalfBall r).closure_interior_eq_closure_of_nonempty_interior
    (nonempty_interior_boundaryHalfBall hr)]
  exact subset_closure

without_proof_info in
theorem boundaryHalfBall_mem_nhdsWithin {r : ℝ} (hr : 0 < r) :
    boundaryHalfBall (n := n) r ∈ 𝓝[{x : V | 0 ≤ x 0}] 0 :=
  inter_mem (mem_nhdsWithin_of_mem_nhds (ball_mem_nhds 0 hr)) self_mem_nhdsWithin

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryHalfBallGeometry

/- Boundary analytic support: BoundaryFiniteTraceLift.lean, SHA256 4f9043a3ab4aac0e302ecfb6d6fdcae1d4b7abeca8e63ff853daac9b57679b37 -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryFiniteTraceLift





/- A finite quadratic lift of the analytic trace. Only its value and its
operator value on the face are prescribed; no infinite jet extension is
required by the reflection argument. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

def boundaryNormalBilinear : V →L[ℝ] V →L[ℝ] ℝ :=
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  N.smulRight N

without_proof_info in
@[simp] theorem boundaryNormalBilinear_apply (v w : V) :
    boundaryNormalBilinear v w = v 0 * w 0 := rfl

without_proof_info in
theorem boundaryNormalBilinear_symm (v w : V) :
    boundaryNormalBilinear v w = boundaryNormalBilinear w v := by simp [mul_comm]

def boundaryNormalQuadratic : V → ℝ := quadraticPolynomial 0 0 boundaryNormalBilinear

without_proof_info in
@[simp] theorem boundaryNormalQuadratic_apply (x : V) :
    boundaryNormalQuadratic x = (1 / 2 : ℝ) * (x 0 * x 0) := by
  simp [boundaryNormalQuadratic, quadraticPolynomial]

without_proof_info in
theorem boundaryNormalQuadratic_analyticAt (x : V) : AnalyticAt ℝ boundaryNormalQuadratic x := by
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  rw [show boundaryNormalQuadratic = (fun y : V => (1 / 2 : ℝ) * (y 0 * y 0)) from
    funext boundaryNormalQuadratic_apply]
  have hc : AnalyticAt ℝ (fun _ : V => (1 / 2 : ℝ)) x := analyticAt_const
  simpa [Pi.mul_def, N] using hc.mul ((N.analyticAt x).mul (N.analyticAt x))

without_proof_info in
theorem fderiv_boundaryNormalQuadratic (x : V) :
    fderiv ℝ boundaryNormalQuadratic x = boundaryNormalBilinear x := by
  exact (fderiv_quadraticPolynomial 0 0 boundaryNormalBilinear boundaryNormalBilinear_symm x).trans (zero_add _)

without_proof_info in
theorem secondFDeriv_boundaryNormalQuadratic (x : V) :
    fderiv ℝ (fderiv ℝ boundaryNormalQuadratic) x = boundaryNormalBilinear :=
  secondFDeriv_quadraticPolynomial 0 0 boundaryNormalBilinear boundaryNormalBilinear_symm x

without_proof_info in
theorem fderiv_boundaryNormalQuadratic_face {x : V} (hx : x 0 = 0) :
    fderiv ℝ boundaryNormalQuadratic x = 0 := by
  rw [fderiv_boundaryNormalQuadratic]
  apply ContinuousLinearMap.ext
  intro v
  simp [hx]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem coordinateSchrodinger_boundaryNormalQuadratic_face
    (A : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) (x : V)
    (hx : x 0 = 0) (hAn : A x e = e) :
    coordinateSchrodinger A b q boundaryNormalQuadratic x = -1 := by
  classical
  unfold coordinateSchrodinger
  rw [secondFDeriv_boundaryNormalQuadratic, fderiv_boundaryNormalQuadratic_face hx,
    boundaryNormalQuadratic_apply, hx]
  simp only [boundaryNormalBilinear_apply, ContinuousLinearMap.zero_apply, mul_zero, zero_mul, add_zero]
  rw [Finset.sum_eq_single 0]
  · simp [hAn]
  · intro i _ hi
    simp [Ne.symm hi]
  · simp

set_option maxHeartbeats 800000 in
without_proof_info in
theorem coordinateSchrodinger_quadratic_trace_correction_face
    (A : V → V →L[ℝ] V) (b : V → V) (q K : V → ℝ) (x : V)
    (hx : x 0 = 0) (hAn : A x e = e) (hK : ContDiffAt ℝ 2 K x) :
    coordinateSchrodinger A b q (boundaryNormalQuadratic * K) x = -K x := by
  rw [coordinateSchrodinger_mul A b q boundaryNormalQuadratic K x
    (boundaryNormalQuadratic_analyticAt x).contDiffAt hK]
  rw [coordinateSchrodinger_boundaryNormalQuadratic_face A b q x hx hAn,
    fderiv_boundaryNormalQuadratic_face hx]
  simp [boundaryNormalQuadratic_apply, hx, principalCrossVector, coordinateJetEquation, flatJetAt]

def boundaryFiniteTraceLift (A : V → V →L[ℝ] V) (b : V → V) (q f : V → ℝ) : V → ℝ :=
  fun x => f x + boundaryNormalQuadratic x * coordinateSchrodinger A b q f (boundaryTangentialProjection x)

without_proof_info in
theorem boundaryFiniteTraceLift_face
    (A : V → V →L[ℝ] V) (b : V → V) (q f : V → ℝ) (x : V) (hx : x 0 = 0) :
    boundaryFiniteTraceLift A b q f x = f x := by simp [boundaryFiniteTraceLift, hx]

without_proof_info in
theorem boundaryFiniteTraceLift_analyticAt_zero
    {A : V → V →L[ℝ] V} {b : V → V} {q f : V → ℝ}
    (hA : AnalyticAt ℝ A 0) (hb : AnalyticAt ℝ b 0)
    (hq : AnalyticAt ℝ q 0) (hf : AnalyticAt ℝ f 0) :
    AnalyticAt ℝ (boundaryFiniteTraceLift A b q f) 0 := by
  have hK := (coordinateSchrodinger_analyticAt hA hb hq hf).comp_of_eq
    (boundaryTangentialProjection.analyticAt 0) boundaryTangentialProjection.map_zero
  exact hf.add ((boundaryNormalQuadratic_analyticAt 0).mul hK)

without_proof_info in
theorem coordinateSchrodinger_boundaryFiniteTraceLift_face
    (A : V → V →L[ℝ] V) (b : V → V) (q f : V → ℝ) (x : V)
    (hx : x 0 = 0) (hAn : A x e = e) (hf : ContDiffAt ℝ 2 f x)
    (hK : ContDiffAt ℝ 2 (coordinateSchrodinger A b q f ∘ boundaryTangentialProjection) x) :
    coordinateSchrodinger A b q (boundaryFiniteTraceLift A b q f) x = 0 := by
  have heq : boundaryFiniteTraceLift A b q f =
      f + boundaryNormalQuadratic * (coordinateSchrodinger A b q f ∘ boundaryTangentialProjection) := by
    funext y
    rfl
  rw [heq]
  let K := coordinateSchrodinger A b q f ∘ boundaryTangentialProjection
  have hprod : ContDiffAt ℝ 2 (boundaryNormalQuadratic * K) x := by
    simpa only [Pi.mul_def] using (boundaryNormalQuadratic_analyticAt x).contDiffAt.mul hK
  rw [coordinateSchrodinger_add A b q f (boundaryNormalQuadratic * K) x hf hprod,
    coordinateSchrodinger_quadratic_trace_correction_face A b q K x hx hAn hK]
  simp [K, Function.comp_def, boundaryTangentialProjection_eq_self x hx]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryFiniteTraceLift

/- Boundary analytic support: BoundaryGaugeEquation.lean, SHA256 d014863015726ef3daadd3649723e133958fe8acbd2d22ee2bad2f5bd3d8be9e -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryGaugeEquation



/- Exact equations for the SAME unknown under the analytic multiplier
and the finite trace correction. -/
open Set
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem coordinateSchrodinger_sub
    (A : V → V →L[ℝ] V) (b : V → V) (q u v : V → ℝ) (x : V)
    (hu : ContDiffAt ℝ 2 u x) (hv : ContDiffAt ℝ 2 v x) :
    coordinateSchrodinger A b q (u - v) x =
      coordinateSchrodinger A b q u x - coordinateSchrodinger A b q v x := by
  have heq : u - v = u + (-1 : ℝ) • v := by funext y; simp [sub_eq_add_neg]
  have hneg : ContDiffAt ℝ 2 ((-1 : ℝ) • v) x := by
    simpa only [Pi.smul_def] using hv.const_smul (-1 : ℝ)
  rw [heq, coordinateSchrodinger_add A b q u ((-1 : ℝ) • v) x hu hneg,
    coordinateSchrodinger_smul]
  ring

def boundaryGaugeUnknown (b : V → V) (u : V → ℝ) (x : V) : ℝ :=
  (boundaryDriftGauge b x)⁻¹ * u x

without_proof_info in
theorem boundaryGaugeUnknown_recovery (b : V → V) (u : V → ℝ) :
    boundaryDriftGauge b * boundaryGaugeUnknown b u = u := by
  funext x
  simp [Pi.mul_apply, boundaryGaugeUnknown, ← mul_assoc, (boundaryDriftGauge_pos b x).ne']

without_proof_info in
theorem boundaryGaugeUnknown_face (b : V → V) (u : V → ℝ) (x : V) (hx : x 0 = 0) :
    boundaryGaugeUnknown b u x = u x := by
  simp [boundaryGaugeUnknown, boundaryDriftGauge_face b x hx]

without_proof_info in
theorem coordinateSchrodinger_boundaryGaugeUnknown
    (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ) (x : V)
    (hγ : ContDiffAt ℝ 2 (boundaryDriftGauge b) x) (hu : ContDiffAt ℝ 2 u x) :
    coordinateSchrodinger A (boundaryGaugeDrift A b) (boundaryGaugePotential A b q)
      (boundaryGaugeUnknown b u) x =
        (boundaryDriftGauge b x)⁻¹ * coordinateSchrodinger A b q u x := by
  have hv : ContDiffAt ℝ 2 (boundaryGaugeUnknown b u) x :=
    (hγ.inv (boundaryDriftGauge_pos b x).ne').mul hu
  have hp := coordinateSchrodinger_boundaryDriftGauge_mul A b q (boundaryGaugeUnknown b u) x hγ hv
  rw [boundaryGaugeUnknown_recovery] at hp
  rw [hp, ← mul_assoc, inv_mul_cancel₀ (boundaryDriftGauge_pos b x).ne', one_mul]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryGaugeEquation

/- Boundary analytic support: BoundaryFaceDensity.lean, SHA256 523fa2802f48feb2dfd81bf23ad5983fe70a51fd96198514503c97e73fd9e69c -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryFaceDensity



/- Continuity fills the reflection face after the equation is verified
on its two open sides. No equation outside the physical side is assumed. -/
open Set
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem boundary_normal_ne_zero_dense : Dense {x : V | x 0 ≠ 0} := by
  let L : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  have hsurj : Function.Surjective L := by
    intro c
    exact ⟨c • EuclideanSpace.single 0 1, by simp [L]⟩
  have hopen : IsOpenMap (fun x : V => x 0) := L.isOpenMap hsurj
  have hd : Dense ((fun x : V => x 0) ⁻¹' ({0}ᶜ : Set ℝ)) :=
    (dense_compl_singleton (0 : ℝ)).preimage hopen
  exact hd

without_proof_info in
theorem eqOn_open_of_eqOn_away_boundary_face
    {F : Type*} [TopologicalSpace F] [T2Space F]
    {U : Set V} (hU : IsOpen U) {f g : V → F}
    (hf : ContinuousOn f U) (hg : ContinuousOn g U)
    (hfg : ∀ x ∈ U, x 0 ≠ 0 → f x = g x) : EqOn f g U := by
  have heq : EqOn f g (U ∩ {x : V | x 0 ≠ 0}) := fun x hx => hfg x hx.1 hx.2
  apply heq.of_subset_closure hf hg inter_subset_left
  intro x hx
  exact hU.inter_closure ⟨hx, boundary_normal_ne_zero_dense x⟩

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryFaceDensity

/- Boundary analytic support: BoundaryReflectedPDE.lean, SHA256 b37d28dac06c526faf0883a98354f76eaa2510426c6d05cb7fa6ddb573f258cd -/
noncomputable section ProofPart_BoundaryAnalytic_BoundaryReflectedPDE



/- The C3 odd reflection solves an ACTUAL inhomogeneous equation on the
whole ball. Coefficients are folded analytic germs, with explicit normal
factors in drift and forcing. Their reflected spatial analyticity is unused. -/
open Set Metric
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

without_proof_info in
theorem coordinateSchrodinger_congr_coefficients_at
    {A A' : V → V →L[ℝ] V} {b b' : V → V} {q q' : V → ℝ}
    (u : V → ℝ) (x : V) (hA : A x = A' x) (hb : b x = b' x) (hq : q x = q' x) :
    coordinateSchrodinger A b q u x = coordinateSchrodinger A' b' q' u x := by
  simp only [coordinateSchrodinger, hA, hb, hq]

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem coordinateSchrodinger_boundaryOddReflection_on_ball
    {R : ℝ} (A : V → V →L[ℝ] V) (b β : V → V) (q G u : V → ℝ)
    (hA : ContinuousOn A (ball 0 R)) (hβ : ContinuousOn β (ball 0 R))
    (hq : ContinuousOn q (ball 0 R)) (hG : ContinuousOn G (ball 0 R))
    (hAn : ∀ y ∈ ball (0 : V) R, 0 < y 0 → A y e = e)
    (hA0 : ∀ y ∈ ball (0 : V) R, 0 < y 0 → ∀ v : V, A y v 0 = v 0)
    (hb : ∀ y ∈ ball (0 : V) R, 0 < y 0 →
      b y = boundaryTangentialProjection (β y) + (y 0 * (β y) 0) • e)
    (hu : ∀ y ∈ ball (0 : V) R, 0 < y 0 → ContDiffAt ℝ 2 u y)
    (hLu : ∀ y ∈ ball (0 : V) R, 0 < y 0 →
      coordinateSchrodinger A b q u y = y 0 * G y)
    (hw : ContDiffOn ℝ 3 (boundaryOddReflection u) (ball (0 : V) R)) :
    ∀ x ∈ ball (0 : V) R,
      coordinateSchrodinger (fun y => A (boundaryFold y))
        (normalFactorReflectedDrift β) (fun y => q (boundaryFold y))
        (boundaryOddReflection u) x = x 0 * G (boundaryFold x) := by
  let AF : V → V →L[ℝ] V := fun y => A (boundaryFold y)
  let BF : V → V := normalFactorReflectedDrift β
  let QF : V → ℝ := fun y => q (boundaryFold y)
  let FF : V → ℝ := fun y => y 0 * G (boundaryFold y)
  have hfold : MapsTo (boundaryFold (n := n)) (ball 0 R) (ball 0 R) := by
    intro x hx
    simpa only [mem_ball_zero_iff, norm_boundaryFold] using hx
  have hcFold : Continuous (boundaryFold (n := n)) := boundaryFold_lipschitz.continuous
  have hAF : ContinuousOn AF (ball 0 R) := hA.comp hcFold.continuousOn hfold
  have hβF : ContinuousOn (fun y => β (boundaryFold y)) (ball 0 R) :=
    hβ.comp hcFold.continuousOn hfold
  have hQF : ContinuousOn QF (ball 0 R) := hq.comp hcFold.continuousOn hfold
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  have hN : Continuous (fun x : V => x 0) := N.continuous
  have hBF : ContinuousOn BF (ball 0 R) :=
    (boundaryTangentialProjection.continuous.comp_continuousOn hβF).add
      ((hN.continuousOn.mul (N.continuous.comp_continuousOn hβF)).smul continuousOn_const)
  have hFF : ContinuousOn FF (ball 0 R) :=
    hN.continuousOn.mul (hG.comp hcFold.continuousOn hfold)
  have hoperator : ContinuousOn
      (coordinateSchrodinger AF BF QF (boundaryOddReflection u)) (ball 0 R) :=
    continuousOn_coordinateSchrodinger_of_c2 isOpen_ball hAF hBF hQF (hw.of_le (by norm_num))
  apply eqOn_open_of_eqOn_away_boundary_face isOpen_ball hoperator hFF
  intro x hx hx0
  rcases lt_or_gt_of_ne hx0 with hneg | hpos
  · have hxR : boundaryReflection n x ∈ ball (0 : V) R := by
      simpa only [mem_ball_zero_iff, norm_boundaryReflection] using hx
    have hposR : 0 < (boundaryReflection n x) 0 := by simpa using neg_pos.mpr hneg
    have hAp := affinePrincipalCoefficient_boundaryReflection A x
      (hAn _ hxR hposR) (hA0 _ hxR hposR)
    have hBp : affineDriftCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 b x = BF x := by
      rw [affineDriftCoefficient_boundaryReflection, hb _ hxR hposR]
      exact (normalFactorReflectedDrift_eq_reflected_of_nonpos β hneg.le).symm
    have hQp : affinePotentialCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 q x = QF x := by
      simp [QF, affinePotentialCoefficient, boundaryFold_eq_reflection x hneg.le,
        LinearIsometryEquiv.coe_toContinuousLinearEquiv]
    have hc := coordinateSchrodinger_congr_coefficients_at (boundaryOddReflection u) x
      (show AF x = affinePrincipalCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 A x by
        simpa only [AF, boundaryFold_eq_reflection x hneg.le] using hAp.symm)
      hBp.symm hQp.symm
    rw [hc, coordinateSchrodinger_odd_reflection_negative A b q u hneg (hu _ hxR hposR),
      hLu _ hxR hposR]
    simp [FF, boundaryFold_eq_reflection x hneg.le]
  · have hc := coordinateSchrodinger_congr_coefficients_at (boundaryOddReflection u) x
      (show AF x = A x by simp [AF, boundaryFold_eq_self x hpos.le])
      (show BF x = b x by
        rw [hb x hx hpos]
        exact normalFactorReflectedDrift_eq_of_nonneg β hpos.le)
      (show QF x = q x by simp [QF, boundaryFold_eq_self x hpos.le])
    rw [hc, coordinateSchrodinger_odd_reflection_positive A b q u hpos, hLu x hx hpos]
    simp [FF, boundaryFold_eq_self x hpos.le]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryReflectedPDE

/- Boundary analytic support: FiniteHolderJet.lean, SHA256 836d5877c38524ce0f59c8d6131e61c2b6756549860d65b57dbb6338ace3c4a5 -/
noncomputable section ProofPart_BoundaryAnalytic_FiniteHolderJet


/- The fixed Holder jet needs only C3, the regularity actually supplied by
the odd boundary reflection. The same values and derivatives are retained. -/
open Set Metric
open scoped NNReal ContDiff
