without_proof_info in
theorem exists_native_coordinate_test_lift
    (c : M) {Ω : Set V} (hΩ : IsOpen Ω) (hΩt : Ω ⊆ (extChartAt Ihalf c).target)
    (φ : V → ℝ) (hφ : ContDiff ℝ ∞ φ) (hφc : HasCompactSupport φ) (hφΩ : tsupport φ ⊆ Ω) :
    ∃ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ u ∧ HasCompactSupport u ∧
      tsupport u ⊆ (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' Ω ∧
      tsupport u ⊆ (Ihalf).interior M ∧
      (∀ y : (Ihalf).boundary M, u y = 0) ∧
      ∀ z ∈ Ω, u ((extChartAt Ihalf c).symm z) = φ z := by
  let K : Set M := (extChartAt Ihalf c).symm '' tsupport φ
  have hKt : tsupport φ ⊆ (extChartAt Ihalf c).target := hφΩ.trans hΩt
  have hK : IsCompact K := hφc.image_of_continuousOn ((continuousOn_extChartAt_symm c).mono hKt)
  have hKs : K ⊆ (extChartAt Ihalf c).source := by
    rintro x ⟨z, hz, rfl⟩
    exact (extChartAt Ihalf c).map_target (hKt hz)
  have hKΩ : K ⊆ (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' Ω := by
    rintro x ⟨z, hz, rfl⟩
    refine ⟨(extChartAt Ihalf c).map_target (hKt hz), ?_⟩
    change extChartAt Ihalf c ((extChartAt Ihalf c).symm z) ∈ Ω
    rw [(extChartAt Ihalf c).right_inv (hKt hz)]
    exact hφΩ hz
  have hKi : K ⊆ (Ihalf).interior M := by
    rintro x ⟨z, hz, rfl⟩
    have hx := (extChartAt Ihalf c).map_target (hKt hz)
    apply ((Ihalf).isInteriorPoint_iff_of_mem_atlas (n := ω) (by decide)
      (chart_mem_atlas (EuclideanHalfSpace (n + 1)) c)
      (by simpa only [extChartAt_source] using hx)).mpr
    change extChartAt Ihalf c ((extChartAt Ihalf c).symm z) ∈ interior (extChartAt Ihalf c).target
    rw [(extChartAt Ihalf c).right_inv (hKt hz)]
    apply interior_mono hΩt
    simpa only [hΩ.interior_eq] using hφΩ hz
  obtain ⟨χ, hχ, hχone, hχc, hχs, _⟩ := hK.exists_contMDiff_one_nhds_tsupport_subset
    Ihalf (isOpen_extChartAt_source c) hKs
  let f : M → ℝ := fun x => φ (extChartAt Ihalf c x)
  have hf : ContMDiffOn Ihalf 𝓘(ℝ) ∞ f (extChartAt Ihalf c).source := by
    simpa only [f, Function.comp_def, extChartAt_source] using hφ.contMDiff.comp_contMDiffOn
      (contMDiffOn_extChartAt (I := Ihalf) (x := c))
