  rw [map_add, map_smul,
    boundaryReflection_eq_self_of_tangent _ (boundaryTangentialProjection_normal v),
    boundaryReflection_single]
  simp [sub_eq_add_neg]

def normalFactorReflectedDrift (β : V → V) (x : V) : V :=
