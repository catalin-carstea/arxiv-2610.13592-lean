theorem NativeClassicalValueKernel.integrable_on_disjoint_opens
    (G : NativeClassicalValueKernel K) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (hNR : Nonresonant g q) (hp : p ≠ (⊤ : ℝ≥0∞))
    (U V : Opens M) (hUV : Disjoint (U : Set M) (V : Set M)) :
    Integrable (fun t : U × V => G.kernel t.1 t.2)
      (((nativeVolume g).comap (Subtype.val : U → M)).prod
        ((nativeVolume g).comap (Subtype.val : V → M))) := by
