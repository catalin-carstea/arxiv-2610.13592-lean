noncomputable section ProofPart_NativeJetLinearChartRead




/- Reading a native second jet by ordinary coordinate derivatives is linear
and injective. The Levi-Civita correction is retained in the map. -/
open Bundle Set
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def nativeChartJetLinearMap (g : Metric (n := n) (M := M)) (x : M) :
    JetSpace g x →ₗ[ℝ] OrdinaryJet V := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (n' := 1) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  let e := trivializationAt V (TangentSpace (𝓡∂ (n + 1))) x
  exact covariantJetCoordinateLinearMap
    (e.continuousLinearEquivAt ℝ x (FiberBundle.mem_baseSet_trivializationAt' x)).symm
    (chartLeviCivitaMap (I := 𝓡∂ (n + 1)) x x)

without_proof_info in
theorem nativeChartJetLinearMap_injective (g : Metric (n := n) (M := M)) (x : M) :
    Function.Injective (nativeChartJetLinearMap g x) := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  unfold nativeChartJetLinearMap
  exact covariantJetCoordinateLinearMap_injective _ _

def simultaneousNativeChartJetMap (g : Metric (n := n) (M := M)) {ι : Type*}
    (points : ι → M) : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] (ι → OrdinaryJet V) :=
  LinearMap.pi fun i => (nativeChartJetLinearMap g (points i)).comp (LinearMap.proj i)

without_proof_info in
theorem simultaneousNativeChartJetMap_injective (g : Metric (n := n) (M := M))
    {ι : Type*} (points : ι → M) : Function.Injective (simultaneousNativeChartJetMap g points) := by
  intro j k h
  funext i
  apply nativeChartJetLinearMap_injective g (points i)
  exact congrFun h i

without_proof_info in
theorem exists_simultaneous_ordinary_jet_functional (g : Metric (n := n) (M := M))
    {ι : Type*} (points : ι → M)
    (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ) :
    ∃ L : (ι → OrdinaryJet V) →ₗ[ℝ] ℝ,
      ∀ j, L (fun i => nativeChartJetLinearMap g (points i) (j i)) = ℓ j := by
  obtain ⟨L, hL⟩ := exists_functional_extension_of_injective
    (simultaneousNativeChartJetMap g points) (simultaneousNativeChartJetMap_injective g points) ℓ
  exact ⟨L, fun j => DFunLike.congr_fun hL j⟩

without_proof_info in
theorem exists_simultaneous_continuous_ordinary_jet_functional
    (g : Metric (n := n) (M := M)) {ι : Type*} [Fintype ι] (points : ι → M)
    (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ) :
    ∃ L : (ι → OrdinaryJet V) →L[ℝ] ℝ,
      ∀ j, L (fun i => nativeChartJetLinearMap g (points i) (j i)) = ℓ j := by
  exact exists_continuous_functional_extension_of_injective
    (simultaneousNativeChartJetMap g points) (simultaneousNativeChartJetMap_injective g points) ℓ

def chartOrdinarySecondJet (x : M) (f : M → ℝ) : OrdinaryJet V :=
  ordinaryJet (f x)
    (fderiv ℝ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) (extChartAt (𝓡∂ (n + 1)) x x))
    (fderiv ℝ (fderiv ℝ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm))
      (extChartAt (𝓡∂ (n + 1)) x x))

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem nativeChartJetLinearMap_secondJet (g : Metric (n := n) (M := M))
    (x : M) (hx : (𝓡∂ (n + 1)).IsInteriorPoint x) {f : M → ℝ}
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 f x) :
    nativeChartJetLinearMap g x (secondJet g f x) =
      (f x,
        fderiv ℝ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) (extChartAt (𝓡∂ (n + 1)) x x),
        fderiv ℝ (fderiv ℝ (f ∘ (extChartAt (𝓡∂ (n + 1)) x).symm))
          (extChartAt (𝓡∂ (n + 1)) x x)) := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (n' := 1) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  let e := trivializationAt V (TangentSpace (𝓡∂ (n + 1))) x
  have hbase : x ∈ e.baseSet := FiberBundle.mem_baseSet_trivializationAt' x
  let D : V ≃L[ℝ] TangentSpace (𝓡∂ (n + 1)) x := (e.continuousLinearEquivAt ℝ x hbase).symm
  have hD : (D : V → TangentSpace (𝓡∂ (n + 1)) x) = e.symmL ℝ x :=
    e.symm_continuousLinearEquivAt_eq hbase
  have hxi : extChartAt (𝓡∂ (n + 1)) x x ∈ interior (extChartAt (𝓡∂ (n + 1)) x).target :=
    ModelWithCorners.isInteriorPoint_iff.mp hx
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · ext v
    change mvfderiv (𝓡∂ (n + 1)) f x (D v) = _
    rw [hD]
    exact mvfderiv_inverseChart_vector x (mem_chart_source _ x) hxi
      (hf.mdifferentiableAt (by decide)) v
  · ext v w
    change inner ℝ ((secondJet g f x).2.2 (D v)) (D w) +
      mvfderiv (𝓡∂ (n + 1)) f x
        (D (chartLeviCivitaMap (I := 𝓡∂ (n + 1)) x x v w)) = _
    have hH := hessian_fixedChart_christoffel x (mem_chart_source _ x) hxi hf v w
    rw [← hD, TauCeti.Manifold.hessian_def] at hH
    have hfirst := mvfderiv_inverseChart_vector x (mem_chart_source _ x) hxi
      (hf.mdifferentiableAt (by decide)) (chartLeviCivitaMap (I := 𝓡∂ (n + 1)) x x v w)
    rw [← hD] at hfirst
    rw [hfirst]
    exact (eq_sub_iff_add_eq.mp hH)

end ConformalPoisson

end ProofPart_NativeJetLinearChartRead

