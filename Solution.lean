/-- Extending a value by zero and then restricting cannot increase its Lp norm. -/
theorem norm_lp_le_of_ae_eq_indicator {F : Type*} [NormedAddCommGroup F]
    (u : Lp F p (μ.restrict Ω)) (w : Lp F p (μ.restrict V))
