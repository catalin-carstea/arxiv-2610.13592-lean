/- Proof support: GreenPoissonChart.lean, SHA256 c57ce7e49230ba9a0a7b36967189ec4f9bf8b46028fe811a26780a8fbe4c11ae -/
noncomputable section ProofPart_GreenPoissonChart



/- The actual Poisson kernel is jointly smooth over a common open interior
coordinate neighborhood and the entire compact boundary. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance poissonChartBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local instance poissonChartBoundaryAnalytic : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M) :=
  TauCeti.isManifold_boundary M (by decide)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.exists_poisson_chart_domain
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {x : M} (hx : x ∈ (𝓡∂ (n + 1)).interior M) :
    ∃ U : TopologicalSpace.Opens V,
      extChartAt (𝓡∂ (n + 1)) x x ∈ U ∧
      (∀ z ∈ U, (extChartAt (𝓡∂ (n + 1)) x).symm z ∈ (𝓡∂ (n + 1)).interior M) ∧
      ContMDiffOn (𝓘(ℝ, V).prod (𝓡 n)) 𝓘(ℝ) ∞
        (fun p : V × (𝓡∂ (n + 1)).boundary M =>
          boundaryPoissonSection ν G.kernel p.2 ((extChartAt (𝓡∂ (n + 1)) x).symm p.1))
        ((U : Set V) ×ˢ univ) := by
  let c := extChartAt (𝓡∂ (n + 1)) x
  let P : Set M := (𝓡∂ (n + 1)).interior M
  have hP : IsOpen P := (𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)
  have hc : ContMDiffOn 𝓘(ℝ, V) (𝓡∂ (n + 1)) ∞ c.symm (interior c.target) :=
    (contMDiffOn_extChartAt_symm x).mono interior_subset
  let U : TopologicalSpace.Opens V := ⟨interior c.target ∩ c.symm ⁻¹' P,
    hc.continuousOn.isOpen_inter_preimage isOpen_interior hP⟩
  have hcx : c x ∈ interior c.target := ModelWithCorners.isInteriorPoint_iff.mp hx
  have hround : c.symm (c x) = x := c.left_inv (mem_extChartAt_source x)
  refine ⟨U, ⟨hcx, ?_⟩, fun z hz => hz.2, ?_⟩
  · change c.symm (c x) ∈ P
    rw [hround]
    exact hx
  · intro p hp
    have hcAt : ContMDiffAt 𝓘(ℝ, V) (𝓡∂ (n + 1)) ∞ c.symm p.1 :=
      (hc p.1 hp.1.1).contMDiffAt (isOpen_interior.mem_nhds hp.1.1)
    have hne : c.symm p.1 ≠ (p.2 : M) := by
      intro heq
      exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary
        (heq ▸ hp.1.2) p.2.property
    have hG := (G.smooth_off_diagonal (c.symm p.1, (p.2 : M)) hne).contMDiffAt
      ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hne)
    have hGchart := hG.comp (p.1, (p.2 : M))
      ((hcAt.comp (p.1, (p.2 : M)) contMDiffAt_fst).prodMk contMDiffAt_snd)
    have hnormal := contMDiffAt_parametric_normalDerivative g ν hν
      (G := fun a r => G.kernel (c.symm a) r) hGchart
    exact hnormal.neg.contMDiffWithinAt

end ConformalPoisson

