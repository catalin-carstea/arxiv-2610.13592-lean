    simpa only [Wkp.value_one] using hw
  obtain ⟨Z, hZ⟩ := exists_wholeSpace_extension_euclidean_halfSpace w
  have hsub : (Ω ⊓ D : Opens X) ≤ euclideanOpenHalfSpace n 0 :=
    (inf_le_left : Ω ⊓ D ≤ Ω).trans hΩH
  refine ⟨Z, ?_⟩
  filter_upwards [ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hsub) hZ,
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hsub) hwv,
    ae_restrict_mem (Ω ⊓ D).isOpen.measurableSet] with x hz hwx hx
