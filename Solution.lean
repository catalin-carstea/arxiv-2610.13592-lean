    L.symm.contDiff.comp_contDiffOn (hF.comp L.contDiff.contDiffOn hmap)
  have hcη : HasCompactSupport η := (hc.comp_homeomorph L.toHomeomorph).comp_left L.symm.map_zero
  have hr := hη.integral_divergence_coordinate_halfSpace hcη
