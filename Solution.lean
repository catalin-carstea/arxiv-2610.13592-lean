noncomputable section ProofPart_BoundaryAnalytic_PrincipalActualFrameFactor


/- The existing principal factorization with its actual coordinate-frame
witness exposed, for the normal-coordinate readback. The proof is adapted
from the project's previously checked chartPrincipalCoefficient_factor. -/
open Bundle Set
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem chartPrincipalCoefficient_actualFrame_factor (p : M) {x : M}
    (hx : x ∈ (chartAt H p).source) :
    let e := trivializationAt V (TangentSpace I) p
    let hbase : x ∈ e.baseSet := by simpa only [e, TangentBundle.trivializationAt_baseSet] using hx
    let C := e.continuousLinearEquivAt ℝ x hbase
    chartPrincipalCoefficient (I := I) p (extChartAt I p x) =
      C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint := by
  let e := trivializationAt V (TangentSpace I) p
  have hbase : x ∈ e.baseSet := by simpa [e] using hx
  let C := e.continuousLinearEquivAt ℝ x hbase
  let b := Module.finBasis ℝ V
  have hGram : Matrix.gram ℝ (b.map C.symm.toLinearEquiv) =
      Riemannian.Tensor.chartGramMatrix (I := I) p x := by
    ext i j
    simp only [Matrix.gram_apply, Module.Basis.map_apply,
      Riemannian.Tensor.chartGramMatrix_apply, Riemannian.Tensor.chartLocalFrame_eq_symmL]
    change inner ℝ (C.symm (b i)) (C.symm (b j)) =
      inner ℝ (e.symmL ℝ x (b i)) (e.symmL ℝ x (b j))
    rw [e.symm_continuousLinearEquivAt_eq hbase]
  have hround : (extChartAt I p).symm (extChartAt I p x) = x :=
    (extChartAt I p).left_inv (by rwa [extChartAt_source])
  change chartPrincipalCoefficient (I := I) p (extChartAt I p x) = C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint
  rw [chartPrincipalCoefficient, hround, Riemannian.Tensor.chartInvGramMatrix_def, ← hGram]
  exact inverseMetricOperator_eq_map_comp_adjoint b C

end ConformalPoisson

end ProofPart_BoundaryAnalytic_PrincipalActualFrameFactor

