noncomputable section ProofPart_InteriorAnalytic_LocalAnalyticPreconditioner




/- Produce the actual local inverse required by the analytic argument,
from the already proved Dirichlet ball Laplacian and small Holder coefficients.
The preconditioner and threshold are chosen before those coefficients. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "BX" => BallSpace α V ℝ

without_proof_info in
theorem exists_uniform_analytic_ball_preconditioner (hα : 0 < α) (hαlt : α < 1) :
    ∃ T : (H ℝ) →L[ℝ] BX, ∃ δ : ℝ≥0, 0 < δ ∧
      ∀ (A : H (V →L[ℝ] V)) (B : H V) (Q : H ℝ),
        ‖A - TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)‖ ≤ δ →
        ‖B‖ ≤ δ → ‖Q‖ ≤ δ → (T.comp (ballSchrodinger hαlt.le A B Q)).IsInvertible := by
  obtain ⟨T, hT⟩ := exists_ballLaplacian_inverse_of_hessian_regularity (n := n) hα hαlt
    (ballHessianRegularity (n := n) hα hαlt)
  have hleft : T.comp (ballLaplacian (d := n + 1) hαlt.le) = ContinuousLinearMap.id ℝ BX :=
    clm_leftInverse_of_rightInverse _ T
      (ballLaplacian_injective (by omega : 0 < n + 1) hαlt.le) hT
  let D : ℝ := ballCoefficientBound (d := n + 1)
  have hD : 0 < D := ballCoefficientBound_pos (d := n + 1)
  obtain ⟨δ, hδ, hthreshold⟩ := exists_operator_perturbation_threshold T hD
  refine ⟨T, δ, hδ, ?_⟩
  intro A B Q hA hB hQ
  have hop : ‖ballSchrodinger hαlt.le A B Q - ballLaplacian (d := n + 1) hαlt.le‖ ≤
      D * δ := norm_ballSchrodinger_sub_laplacian_le hαlt.le δ.coe_nonneg A B Q hA hB hQ
  exact isInvertible_preconditioned_of_norm_sub_lt
    (ballLaplacian (d := n + 1) hαlt.le) (ballSchrodinger hαlt.le A B Q) T hleft
    (hthreshold _ hop)

end ConformalPoisson.DirichletHolder

end ProofPart_InteriorAnalytic_LocalAnalyticPreconditioner

/- Interior analytic support: NormalizedInteriorAnalytic.lean, SHA256 b660f6b9b78fe33757595e912f4beb776c66ee76e28ef485df246346019dd9c2 -/
noncomputable section ProofPart_InteriorAnalytic_NormalizedInteriorAnalytic





/- The needed normalized local scalar consequence, with no inverse or
analytic-estimate premise. A sufficiently small scale is chosen from the
actual coefficient germs. Only analyticity at the supplied center is claimed.
-/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder

without_proof_info in
theorem eventually_rescale_ball_three {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {R : ℝ} (hR : 0 < R) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), MapsTo (fun x : E => ε • x) (ball 0 3) (ball 0 R) := by
  filter_upwards [ball_mem_nhds (0 : ℝ) (div_pos hR (by norm_num : (0 : ℝ) < 4))]
    with ε hε x hx
  have he : ‖ε‖ < R / 4 := mem_ball_zero_iff.mp hε
  have hxn : ‖x‖ < 3 := mem_ball_zero_iff.mp hx
  rw [mem_ball_zero_iff, norm_smul]
  have hb : ‖ε‖ * ‖x‖ ≤ ‖ε‖ * 3 := mul_le_mul_of_nonneg_left hxn.le (norm_nonneg ε)
  nlinarith

without_proof_info in
theorem analyticAt_of_rescaled_function {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (u : E → ℝ) {ε : ℝ} (hε : ε ≠ 0)
    (hu : AnalyticAt ℝ (fun x => u (ε • x)) 0) : AnalyticAt ℝ u 0 := by
  have hs : AnalyticAt ℝ (fun x : E => ε⁻¹ • x) 0 := analyticAt_id.const_smul (c := ε⁻¹)
  have h := hu.comp_of_eq hs (smul_zero ε⁻¹)
  change AnalyticAt ℝ (fun x : E => u (ε • (ε⁻¹ • x))) 0 at h
  simpa only [smul_smul, mul_inv_cancel₀ hε, one_smul] using h

variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem coordinateSchrodinger_rescale
    (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ) (ε : ℝ) (x : V) :
    coordinateSchrodinger (fun z => A (ε • z)) (fun z => ε • b (ε • z))
      (fun z => ε ^ 2 * q (ε • z)) (fun z => u (ε • z)) x =
        ε ^ 2 * coordinateSchrodinger A b q u (ε • x) := by
  unfold coordinateSchrodinger
  rw [secondFDeriv_comp_smul, fderiv_comp_smul]
  simp only [smul_apply, map_smul, smul_eq_mul, ← Finset.mul_sum]
  ring

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem analyticAt_of_normalized_coordinate_equation
    (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ) {R : ℝ} (hR : 0 < R)
    (hA : AnalyticOnNhd ℝ A (ball 0 R)) (hb : AnalyticOnNhd ℝ b (ball 0 R))
    (hq : AnalyticOnNhd ℝ q (ball 0 R)) (hu : ContDiffOn ℝ ∞ u (ball 0 R))
    (hA0 : A 0 = ContinuousLinearMap.id ℝ V)
    (hLu : ∀ x ∈ ball (0 : V) R, coordinateSchrodinger A b q u x = 0) :
    AnalyticAt ℝ u 0 := by
  let β : ℝ≥0 := 1 / 2
  have hβ : 0 < β := by norm_num [β]
  have hβlt : β < 1 := by norm_num [β]
  obtain ⟨T, δ, hδ, hprecondition⟩ := exists_uniform_analytic_ball_preconditioner (n := n) hβ hβlt
  have hc : ∀ᶠ ε in 𝓝 (0 : ℝ),
      holderBound β (closedBall (0 : V) 1)
        (fun x => A (ε • x) - ContinuousLinearMap.id ℝ V) (δ / 2) ∧
      holderBound β (closedBall (0 : V) 1) (fun x => ε • b (ε • x)) (δ / 2) ∧
      holderBound β (closedBall (0 : V) 1) (fun x => ε ^ 2 * q (ε • x)) (δ / 2) :=
    eventually_rescaled_coefficient_bounds
      (hA 0 (mem_ball_self hR)).contDiffAt (hb 0 (mem_ball_self hR)).contDiffAt
      (hq 0 (mem_ball_self hR)).contDiffAt hA0 hβlt.le (div_pos hδ (by norm_num))
  obtain ⟨ε, hε, hmap, hcoeff⟩ := exists_pos_of_eventually_zero
    ((eventually_rescale_ball_three (E := V) hR).and hc)
  let Aε : V → V →L[ℝ] V := fun x => A (ε • x)
  let bε : V → V := fun x => ε • b (ε • x)
  let qε : V → ℝ := fun x => ε ^ 2 * q (ε • x)
  let uε : V → ℝ := fun x => u (ε • x)
  have hs (x : V) : AnalyticAt ℝ (fun y : V => ε • y) x := analyticAt_id.const_smul (c := ε)
  have hAε : AnalyticOnNhd ℝ Aε (ball 0 3) := fun x hx => (hA _ (hmap hx)).comp (hs x)
  have hbε : AnalyticOnNhd ℝ bε (ball 0 3) :=
    fun x hx => ((hb _ (hmap hx)).comp (hs x)).const_smul (c := ε)
  have hqε : AnalyticOnNhd ℝ qε (ball 0 3) :=
    fun x hx => analyticAt_const.mul ((hq _ (hmap hx)).comp (hs x))
  have huε : ContDiffOn ℝ ∞ uε (ball 0 3) :=
    hu.comp (contDiff_const_smul ε).contDiffOn hmap
  have hK3 : closedBall (0 : V) 1 ⊆ ball 0 3 :=
    closedBall_subset_ball (by norm_num : (1 : ℝ) < 3)
  have hAc : ContinuousOn Aε (closedBall (0 : V) 1) := hAε.continuousOn.mono hK3
  have hbc : ContinuousOn bε (closedBall (0 : V) 1) := hbε.continuousOn.mono hK3
  have hqc : ContinuousOn qε (closedBall (0 : V) 1) := hqε.continuousOn.mono hK3
  let AR : TauCeti.HolderSpace β (closedBall (0 : V) 1) (V →L[ℝ] V) :=
    closedBallHolderRestriction (fun x => Aε x - ContinuousLinearMap.id ℝ V)
      (hAc.sub continuousOn_const) hcoeff.1
  let A0 := AR + TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)
  let B0 := closedBallHolderRestriction bε hbc hcoeff.2.1
  let Q0 := closedBallHolderRestriction qε hqc hcoeff.2.2
  have hAread (x : closedBall (0 : V) 1) : A0 x = Aε x := by simp [A0, AR]
  have hBread (x : closedBall (0 : V) 1) : B0 x = bε x := by simp [B0]
  have hQread (x : closedBall (0 : V) 1) : Q0 x = qε x := by simp [Q0]
  have htwo : 2 * ((δ / 2 : ℝ≥0) : ℝ) = (δ : ℝ) := by push_cast; ring
  have hAnorm : ‖A0 - TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)‖ ≤ (δ : ℝ) := by
    have hn := norm_closedBallHolderRestriction_le (fun x => Aε x - ContinuousLinearMap.id ℝ V)
      (hAc.sub continuousOn_const) hcoeff.1
    simpa only [A0, add_sub_cancel_right, ← htwo] using hn
  have hBnorm : ‖B0‖ ≤ (δ : ℝ) :=
    (norm_closedBallHolderRestriction_le bε hbc hcoeff.2.1).trans_eq htwo
  have hQnorm : ‖Q0‖ ≤ (δ : ℝ) :=
    (norm_closedBallHolderRestriction_le qε hqc hcoeff.2.2).trans_eq htwo
  have hLuε (x : V) (hx : x ∈ ball (0 : V) 3) : coordinateSchrodinger Aε bε qε uε x = 0 := by
    change coordinateSchrodinger (fun z => A (ε • z)) (fun z => ε • b (ε • z))
      (fun z => ε ^ 2 * q (ε • z)) (fun z => u (ε • z)) x = 0
    rw [coordinateSchrodinger_rescale, hLu _ (hmap hx), mul_zero]
  have han : AnalyticAt ℝ uε 0 := analyticAt_of_local_schrodinger_inverse hβlt.le Aε bε qε uε
    hAε hbε hqε huε hLuε A0 B0 Q0 hAread hBread hQread T
    (hprecondition A0 B0 Q0 hAnorm hBnorm hQnorm)
  exact analyticAt_of_rescaled_function u hε.ne' han

end ConformalPoisson

end ProofPart_InteriorAnalytic_NormalizedInteriorAnalytic

