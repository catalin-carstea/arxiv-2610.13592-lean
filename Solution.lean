noncomputable section ProofPart_GreenTrace_IsometryGradientLp



/- Exact classical first-gradient Lp transport through the volume-preserving
normal-coordinate isometry, valid at every exponent. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti
open scoped ENNReal Gradient
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
  [MeasurableSpace E] [BorelSpace E] [MeasurableSpace F] [BorelSpace F]
  {μ : Measure E} {ν : Measure F} {p : ℝ≥0∞}

without_proof_info in
theorem lpNorm_gradient_comp_isometry (e : E ≃ₗᵢ[ℝ] F)
    (he : MeasurePreserving e μ ν) {f : F → ℝ}
    (hf : AEStronglyMeasurable (∇ f) ν) :
    lpNorm (∇ (f ∘ e)) p μ = lpNorm (∇ f) p ν := by
  have hcomp : AEStronglyMeasurable ((∇ f) ∘ e) μ := hf.comp_measurePreserving he
  have hgrad : ∇ (f ∘ e) = e.symm ∘ ((∇ f) ∘ e) :=
    funext fun x => gradient_comp_linearIsometryEquiv_right e f x
  have hmeas : AEStronglyMeasurable (∇ (f ∘ e)) μ := by
    rw [hgrad]
    exact e.symm.continuous.comp_aestronglyMeasurable hcomp
  unfold lpNorm
  rw [eLpNorm_congr_norm_ae hmeas hcomp (Eventually.of_forall fun x => by
    rw [gradient_comp_linearIsometryEquiv_right, e.symm.norm_map]
    rfl)]
  rw [eLpNorm_comp_measurePreserving hf he]

end ConformalPoisson

