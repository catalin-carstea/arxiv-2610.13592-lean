/- Shared value/gradient bounds for compact smooth cutoff multipliers. -/
open Set MeasureTheory TauCeti
open scoped ContDiff Gradient
namespace ConformalPoisson
without_proof_info in
theorem exists_compact_smooth_multiplier_bound {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] {ψ : E → ℝ}
    (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ) :
    ∃ N : ℝ, 0 ≤ N ∧ (∀ x, |ψ x| ≤ N) ∧ ∀ x, ‖∇ ψ x‖ ≤ N := by
  obtain ⟨A, hA⟩ := hψc.exists_bound_of_continuous hψ.continuous
  obtain ⟨B, hB⟩ := hψc.gradient.exists_bound_of_continuous
    (hψ.gradient_right (m := ∞) (by simp)).continuous
  refine ⟨max 0 (max A B), le_max_left _ _, ?_, ?_⟩
  · intro x
    exact (show |ψ x| ≤ A by simpa only [Real.norm_eq_abs] using hA x).trans
      ((le_max_left A B).trans (le_max_right 0 (max A B)))
  · intro x
    exact (hB x).trans ((le_max_right A B).trans (le_max_right 0 (max A B)))
end ConformalPoisson

