    {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    (y : Y) (hy : EuclideanHalfSpace.boundaryParam n y ∈ S) :
    ∃ G : Y × ℝ → Z, ∃ r : ℝ, 0 < r ∧ AnalyticOnNhd ℝ G (Metric.ball (y, 0) r) ∧
      ∀ z : H, normalCoefficientBundle F z = G (nativeNormalCoordinates z) := by
  obtain ⟨G, hGω, hread, _, _⟩ := exists_native_normal_representative
    (((normalCoefficientBundle_analyticOn F hG hA) _ hy).contMDiffAt (S.isOpen.mem_nhds hy))
  obtain ⟨r, hr, hball⟩ := hGω.exists_ball_analyticOnNhd
  exact ⟨G, r, hr, hball, hread⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

without_proof_info in
theorem normalJet_of_product_representative
    {f : H → E} {G : Y × ℝ → E} (hread : ∀ z, f z = G (nativeNormalCoordinates z))
    (y : Y) (hG : AnalyticAt ℝ G (y, 0)) (l : ℕ) :
    normalJet l f (EuclideanHalfSpace.boundaryParam n y) = iteratedDeriv l (fun t : ℝ => G (y, t)) 0 := by
  let Q := euclideanHalfSpaceBoundaryNormalEquiv n
  let z := EuclideanHalfSpace.boundaryParam n y
  have hpoint : Q.symm ((𝓡∂ (n + 1)) z) = (y, 0) := nativeNormalCoordinates_boundary y
  let A := G ∘ Q.symm
  have hA : AnalyticAt ℝ A ((𝓡∂ (n + 1)) z) :=
    (hpoint.symm ▸ hG).comp (Q.symm.toContinuousLinearMap.analyticAt _)
  have heq : f = A ∘ (𝓡∂ (n + 1)) := funext hread
  rw [heq, normalJet_ambient_line hA l]
  congr 1
  funext t
  change G (Q.symm ((𝓡∂ (n + 1)) z + t • Q (0, 1))) = G (y, t)
  congr 1
  change Q.symm ((𝓡∂ (n + 1)) z + t • Q (0, 1)) = (y, t)
  rw [map_add, map_smul, Q.symm_apply_apply, hpoint]
  simp

end ConformalPoisson.LocalDN

