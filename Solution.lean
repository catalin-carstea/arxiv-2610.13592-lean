    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (hx : x ∈ (𝓡∂ (n + 1)).interior M₁)
    (b : (𝓡∂ (n + 1)).boundary M₂) (hb : (b : M₂) ∉ V₂)
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hJ : J.source ⊆ (𝓡∂ (n + 1)).interior M₁) (c : M₁ → ℝ)
    (k : ℝ) (hk : 0 < k) (hc : ∀ y ∈ J.source, 0 < c y)
    (hmetric : ∀ y ∈ J.source, ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
      A₂.smoothMetric.inner (J y) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y w) =
          k * c y ^ conformalGaugeExponent n * A₁.smoothMetric.inner y v w)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ y ∈ J.source,
      D.solver₁.solve f.val y = c y * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J y))
    {xs : ℕ → M₁} (hxs : Tendsto xs atTop (𝓝 x)) (hs : ∀ k, xs k ∈ J.source)
    (hys : Tendsto (J ∘ xs) atTop (𝓝 (b : M₂))) : False := by
  obtain ⟨R⟩ := exists_remoteQuotientData hSchauder hRunge₁ hReg₁ hReg₂ hBoundaryReg₂
    hGreen₂ hInverse₂ hEstimate₂ hn hcompact₁ hconnected₁ hconnected₂
    A₁ A₂ V₁ V₂ D x hx b hb
  have hbase := R.base_eq_of_sequence J hJ c (fun y hy => (hc y hy).ne') hrel hxs hs hys
  obtain ⟨N⟩ := exists_remoteInverseNeighborhood R hbase hReg₁ hBoundaryReg₂ hx hb
  exact N.sequence_impossible hn R J hJ c k hk hc hmetric hrel hxs hs hys
end ConformalPoisson

end ProofPart_UnobservedBoundaryNoEscape

/- Proof support: ObservedSeparation.lean, SHA256 a4810be163b238cd5b2eee7af36a53f2f514c7d4ac439019d039092ab591eccd -/
noncomputable section ProofPart_ObservedSeparation




/- Projective separation on the whole interior plus observed boundary. -/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {q : M → ℝ}
  (hSchauder : LocalSchauderDirichletAssumption (n + 1))
  (hRunge : RungeJetApproximationFor g q)
  (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
  (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
  (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
  (S : DirichletSolver g q)
  (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
  (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)

include hSchauder hRunge hdim hcompact hconnected hq hNR hΓ

without_proof_info in
/-- Smaller-patch Runge separates an interior point from any boundary point. -/
theorem exists_datum_interior_one_boundary_zero
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (y : (𝓡∂ (n + 1)).boundary M) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      S.solve f.val x = 1 ∧ S.solve f.val y = 0 := by
  let : NeZero n := ⟨by omega⟩
  let W : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M) :=
    ⟨(Γ : Set _) ∩ {y}ᶜ, Γ.isOpen.inter isClosed_singleton.isOpen_compl⟩
  obtain ⟨z, hz, hzy⟩ := exists_boundary_point_in_patch_ne Γ hΓ y
  have hW : (W : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty := ⟨z, hz, hzy⟩
  obtain ⟨f, hf⟩ := exists_datum_with_value_one hSchauder hRunge hdim hcompact
    hconnected hq hNR S W hW x hx
  refine ⟨⟨f.val, f.property.1, f.property.2.1, f.property.2.2.trans inter_subset_left⟩,
    hf, ?_⟩
  exact ((S.correct f.val f.property.1).2.2 y).trans
    (boundaryDatum_eq_zero_outside f y (by simp [W]))

variable (V : TopologicalSpace.Opens M)

/-- The arbitrary relatively open patch, in its ambient-open representation. -/
def observedPatchOpen : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M) :=
  ⟨observedPatch (n := n) V, V.isOpen.preimage continuous_subtype_val⟩

omit hSchauder hRunge hdim hcompact hconnected hq hNR hΓ [T2Space M] in
without_proof_info in
theorem boundary_mem_patch_of_mem_observedDomain
    (x : observedDomain (𝓡∂ (n + 1)) V)
    (hx : (x : M) ∉ (𝓡∂ (n + 1)).interior M) :
    ∃ y : (𝓡∂ (n + 1)).boundary M, (y : M) = x ∧ y ∈ observedPatch (n := n) V := by
  have hb : (x : M) ∈ (𝓡∂ (n + 1)).boundary M := by
    rwa [← (𝓡∂ (n + 1)).compl_interior]
  refine ⟨⟨x, hb⟩, rfl, ?_⟩
  exact x.property.resolve_left hx

omit hΓ in
without_proof_info in
/-- Every evaluation on the observed domain has a datum of value one. -/
theorem exists_datum_observed_value_one
    (hV : (observedPatch (n := n) V).Nonempty)
    (x : observedDomain (𝓡∂ (n + 1)) V) :
    ∃ f : BoundaryDatum (observedPatch (n := n) V), S.solve f.val x = 1 := by
  by_cases hx : (x : M) ∈ (𝓡∂ (n + 1)).interior M
  · exact exists_datum_with_value_one hSchauder hRunge hdim hcompact hconnected hq hNR S (observedPatchOpen V) hV x hx
  · obtain ⟨y, hy, hyV⟩ := boundary_mem_patch_of_mem_observedDomain V x hx
    obtain ⟨f, hf⟩ := exists_boundaryDatum_value_one (observedPatchOpen V) y hyV
    exact ⟨f, hy ▸ ((S.correct f.val f.property.1).2.2 y).trans hf⟩

omit hΓ in
without_proof_info in
/-- The actual Poisson evaluation family separates points and scales on the observed domain. -/
theorem separatesPointAndScale_observedDomain
    (hV : (observedPatch (n := n) V).Nonempty) :
    SeparatesPointAndScale
      (fun (f : BoundaryDatum (observedPatch (n := n) V))
        (x : observedDomain (𝓡∂ (n + 1)) V) => S.solve f.val x) := by
  intro x y a b ha hb hrel
  have hxy : x = y := by
    by_contra hne
    have hne' : (x : M) ≠ (y : M) := fun h => hne (Subtype.ext h)
    by_cases hx : (x : M) ∈ (𝓡∂ (n + 1)).interior M
    · by_cases hy : (y : M) ∈ (𝓡∂ (n + 1)).interior M
      · obtain ⟨f, hf0, hf1⟩ := exists_datum_separating_interior_points hSchauder hRunge
          hdim hcompact hconnected hq hNR S (observedPatchOpen V) hV x y hx hy hne'
        have h : a * S.solve f.val x = b * S.solve f.val y := hrel f
        rw [hf0, hf1, mul_zero, mul_one] at h
        exact hb h.symm
      · obtain ⟨z, hz, _⟩ := boundary_mem_patch_of_mem_observedDomain V y hy
        obtain ⟨f, hf1, hf0⟩ := exists_datum_interior_one_boundary_zero hSchauder hRunge
          hdim hcompact hconnected hq hNR S (observedPatchOpen V) hV x hx z
        have h : a * S.solve f.val x = b * S.solve f.val y := hrel f
        rw [hf1, ← hz, hf0, mul_one, mul_zero] at h
        exact ha h
    · obtain ⟨z, hz, hzV⟩ := boundary_mem_patch_of_mem_observedDomain V x hx
      by_cases hy : (y : M) ∈ (𝓡∂ (n + 1)).interior M
      · obtain ⟨f, hf1, hf0⟩ := exists_datum_interior_one_boundary_zero hSchauder hRunge
          hdim hcompact hconnected hq hNR S (observedPatchOpen V) hV y hy z
        have h : a * S.solve f.val x = b * S.solve f.val y := hrel f
        rw [← hz, hf0, hf1, mul_zero, mul_one] at h
        exact hb h.symm
      · obtain ⟨w, hw, hwV⟩ := boundary_mem_patch_of_mem_observedDomain V y hy
        have hwz : w ≠ z := by
          intro h
          exact hne' (hz.symm.trans ((congrArg Subtype.val h).symm.trans hw))
        obtain ⟨f, hf1, hf0⟩ := exists_boundaryDatum_separating_points
          (observedPatchOpen V) w z hwV hwz
        have h : a * S.solve f.val x = b * S.solve f.val y := hrel f
        rw [← hz, ← hw, (S.correct f.val f.property.1).2.2 z,
          (S.correct f.val f.property.1).2.2 w, hf0, hf1, mul_zero, mul_one] at h
        exact hb h.symm
  subst y
  obtain ⟨f, hf⟩ := exists_datum_observed_value_one hSchauder hRunge hdim hcompact
    hconnected hq hNR S V hV x
  exact ⟨rfl, by simpa only [hf, mul_one] using hrel f⟩

end ConformalPoisson

end ProofPart_ObservedSeparation

/- Proof support: ObservedBoundaryNoEscape.lean, SHA256 95625004b7b47e2d785333d0c3c176b7fc85537846fbc11185e47d076e97c178 -/
noncomputable section ProofPart_ObservedBoundaryNoEscape





/- An actual scaled original-data relation cannot send a sequence with
an interior source limit to an OBSERVED boundary point. This branch uses
source separation and traces, not analytic boundary rigidity. -/
open Set Filter
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem scaled_relation_no_observed_boundary_limit
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hn : 2 ≤ n) (hcompact : IsCompact (univ : Set M₁))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {xs : ℕ → M₁} {ys : ℕ → M₂} {c : ℕ → ℝ} {x : M₁}
    (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) (hxs : Tendsto xs atTop (𝓝 x))
    (hc : ∀ k, 0 < c k)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ k,
      D.solver₁.solve f.val (xs k) = c k * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (ys k))
    (b : (𝓡∂ (n + 1)).boundary M₂) (hb : (b : M₂) ∈ V₂)
    (hys : Tendsto ys atTop (𝓝 (b : M₂))) : False := by
  let a := D.boundaryIdentification.symm b
  have ha : a ∈ observedPatch (n := n) V₁ :=
    (D.patches_match a).mpr (by simpa only [a, Diffeomorph.apply_symm_apply] using hb)
  obtain ⟨f₀, hf₀⟩ := exists_boundaryDatum_value_one (observedPatchOpen V₁) a ha
  obtain ⟨fsep, hfsep, hfsepB⟩ := exists_datum_interior_one_boundary_zero
    hSchauder (hRunge A₁) hn hcompact hconnected
    (A₁.analytic_potential.of_le (by decide)) A₁.nonresonant D.solver₁
    (observedPatchOpen V₁) D.patch_nonempty x hx a
  let u := fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val
  let v := fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
    D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)
  have hv (f : BoundaryDatum (observedPatch (n := n) V₁)) : ContinuousAt (v f) (b : M₂) := by
    let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
      transportBoundaryDatum D.boundaryIdentification D.patches_match f
    exact (D.solver₂.correct f₂.val f₂.property.1).1.continuous.continuousAt
  have htrace (f : BoundaryDatum (observedPatch (n := n) V₁)) : v f (b : M₂) = f.val a := by
    let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
      transportBoundaryDatum D.boundaryIdentification D.patches_match f
    exact (D.solver₂.correct f₂.val f₂.property.1).2.2 b
  have hv₀ : v f₀ (b : M₂) = 1 := (htrace f₀).trans hf₀
  obtain ⟨_, _, hlimit⟩ := positive_scaled_relation_limit hxs hys
    (fun f => (D.solver₁.correct f.val f.property.1).1.continuous.continuousAt) hv hc hrel
    ⟨fsep, by simpa only [u, hfsep] using (one_ne_zero : (1 : ℝ) ≠ 0)⟩ f₀ hv₀
  have hvsep : v fsep (b : M₂) = 0 := (htrace fsep).trans
    (((D.solver₁.correct fsep.val fsep.property.1).2.2 a).symm.trans hfsepB)
  have h := hlimit fsep
  change D.solver₁.solve fsep.val x = D.solver₁.solve f₀.val x * v fsep (b : M₂) at h
  exact (one_ne_zero : (1 : ℝ) ≠ 0) (by simpa only [hfsep, hvsep, mul_zero] using h)
end ConformalPoisson

end ProofPart_ObservedBoundaryNoEscape

/- Proof support: ScaledRelationRegularity.lean, SHA256 1eb66522c291306fd19ccfd4e550956bcab3eb49026d7a78e5b6978b9f30d309 -/
noncomputable section ProofPart_ScaledRelationRegularity




/-
Analytic recovery of a continuous scaled identification from an actual target
quotient chart. The chart will be supplied by the proved native jet producer.
-/

open Set Filter
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ D : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]

without_proof_info in
theorem analyticAt_scaled_identification_of_quotient_chart
    (u : D → M₁ → ℝ) (v : D → M₂ → ℝ)
    (U : TopologicalSpace.Opens M₁) (J : M₁ → M₂) (c : M₁ → ℝ)
    (x : M₁) (hx : x ∈ U) (hJcont : ContinuousAt J x)
    (hc : ∀ z ∈ U, c z ≠ 0)
    (hrel : ∀ f z, z ∈ U → u f z = c z * v f (J z))
    (hu : ∀ f, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (u f) x)
    (denominator : D) (numerators : Fin (n + 1) → D)
    (hv : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (v denominator) (J x))
    (hv0 : v denominator (J x) ≠ 0)
    (hQ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
      (quotientCoordinates (fun i => v (numerators i)) (v denominator)) (J x)) :
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J x ∧
      ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω c x := by
  let Qu := quotientCoordinates (fun i => u (numerators i)) (u denominator)
  let Qv := quotientCoordinates (fun i => v (numerators i)) (v denominator)
  have hscale (z : M₁) (hz : z ∈ U) : Qu z = Qv (J z) :=
    quotientCoordinates_eq_of_scaled_evaluations u v denominator numerators z (J z)
      (c z) (hc z hz) (fun f => hrel f z hz)
  have hu0 : u denominator x ≠ 0 := by
    rw [hrel denominator x hx]
    exact mul_ne_zero (hc x hx) hv0
  have hQu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω Qu x :=
    contMDiffAt_pi_module_iff.mpr fun i => (hu (numerators i)).div₀ (hu denominator) hu0
  have hInv := hQ.contMDiffAt_localInverse
  have hcenter : Qu x = Qv (J x) := hscale x hx
  change ContMDiffAt 𝓘(ℝ, Fin (n + 1) → ℝ) (𝓡∂ (n + 1)) ω hQ.localInverse (Qv (J x)) at hInv
  rw [← hcenter] at hInv
  have hJ : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J x := by
    apply (hInv.comp x hQu).congr_of_eventuallyEq
    have hleft := hQ.localInverse_eventuallyEq_left.comp_tendsto hJcont
    filter_upwards [U.isOpen.mem_nhds hx, hleft] with z hz hleftz
    change J z = hQ.localInverse (Qu z)
    rw [hscale z hz]
    exact hleftz.symm
  have hV : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (fun z => v denominator (J z)) x :=
    hv.comp x hJ
  have hdennear : ∀ᶠ z in 𝓝 x, v denominator (J z) ≠ 0 :=
    hV.continuousAt.preimage_mem_nhds (isClosed_singleton.isOpen_compl.mem_nhds hv0)
  refine ⟨hJ, ?_⟩
  apply ((hu denominator).div₀ hV hv0).congr_of_eventuallyEq
  filter_upwards [U.isOpen.mem_nhds hx, hdennear] with z hz hdenz
  exact (eq_div_iff hdenz).mpr (hrel denominator z hz).symm

without_proof_info in
/-- A source quotient chart forces injectivity of the recovered map's native differential. -/
theorem injective_mfderiv_scaled_identification_of_quotient_chart
    (u : D → M₁ → ℝ) (v : D → M₂ → ℝ)
    (U : TopologicalSpace.Opens M₁) (J : M₁ → M₂) (c : M₁ → ℝ)
    (x : M₁) (hx : x ∈ U) (hc : ∀ z ∈ U, c z ≠ 0)
    (hrel : ∀ f z, z ∈ U → u f z = c z * v f (J z))
    (hJ : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J x)
    (hv : ∀ f, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (v f) (J x))
    (denominator : D) (numerators : Fin (n + 1) → D) (hu0 : u denominator x ≠ 0)
    (hQ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
      (quotientCoordinates (fun i => u (numerators i)) (u denominator)) x) :
    Function.Injective (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x) := by
  let Qu := quotientCoordinates (fun i => u (numerators i)) (u denominator)
  let Qv := quotientCoordinates (fun i => v (numerators i)) (v denominator)
  have hv0 : v denominator (J x) ≠ 0 := by
    intro hzero
    apply hu0
    rw [hrel denominator x hx, hzero, mul_zero]
  have hQv : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω Qv (J x) :=
    contMDiffAt_pi_module_iff.mpr fun i => (hv (numerators i)).div₀ (hv denominator) hv0
  have hgerm : Qu =ᶠ[𝓝 x] Qv ∘ J := by
    filter_upwards [U.isOpen.mem_nhds hx] with z hz
    exact quotientCoordinates_eq_of_scaled_evaluations u v denominator numerators z (J z)
      (c z) (hc z hz) (fun f => hrel f z hz)
  have hD := hgerm.mfderiv_eq (I := 𝓡∂ (n + 1)) (I' := 𝓘(ℝ, Fin (n + 1) → ℝ))
  rw [mfderiv_comp x (hQv.mdifferentiableAt (by decide)) (hJ.mdifferentiableAt (by decide))] at hD
  have hinj : Function.Injective (mfderiv (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) Qu x) :=
    (hQ.mfderivToContinuousLinearEquiv (by decide)).injective
  intro a b hab
  apply hinj
  rw [hD]
  simp only [ContinuousLinearMap.comp_apply, hab]

end ConformalPoisson

end ProofPart_ScaledRelationRegularity

/- Proof support: NativeScaledRegularity.lean, SHA256 79bb388a94b91c79fd86a860645471799d8d76bd40537c8a7227026b1e930a34 -/
noncomputable section ProofPart_NativeScaledRegularity





/-
The actual full partial-boundary solution relation recovers an analytic map and
multiplier, and makes the map a local analytic diffeomorphism in the interior.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂] [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁]
  [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem native_scaled_solution_relation_regularity
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hdim : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ (𝓡∂ (n + 1)).interior M₁)
    (J : M₁ → M₂) (c : M₁ → ℝ) (hJcont : ContinuousOn J U)
    (hJinterior : ∀ x ∈ U, J x ∈ (𝓡∂ (n + 1)).interior M₂)
    (hc : ∀ x ∈ U, c x ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x)) :
    ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J U ∧
      ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω c U ∧
      ∀ x ∈ U, IsLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J x := by
  let Γ₁ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₁) :=
    ⟨observedPatch (n := n) V₁, V₁.isOpen.preimage continuous_subtype_val⟩
  let Γ₂ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₂) :=
    ⟨observedPatch (n := n) V₂, V₂.isOpen.preimage continuous_subtype_val⟩
  have hΓ₂ : (Γ₂ : Set ((𝓡∂ (n + 1)).boundary M₂)).Nonempty := by
    obtain ⟨z, hz⟩ := D.patch_nonempty
    exact ⟨D.boundaryIdentification z, (D.patches_match z).mp hz⟩
  have hpatch : ∀ z, z ∈ observedPatch (n := n) V₁ ↔
      D.boundaryIdentification z ∈ observedPatch (n := n) V₂ := D.patches_match
  let T := transportBoundaryDatumLinearEquiv D.boundaryIdentification hpatch
  let u : BoundaryDatum (observedPatch (n := n) V₂) → M₁ → ℝ :=
    fun f => D.solver₁.solve (T.symm f).val
  let v : BoundaryDatum (observedPatch (n := n) V₂) → M₂ → ℝ := fun f => D.solver₂.solve f.val
  have hrel₂ : ∀ f z, z ∈ U → u f z = c z * v f (J z) := by
    intro f z hz
    have hval : (T.symm f).val ∘ D.boundaryIdentification.symm = f.val := by
      exact congrArg Subtype.val (T.apply_symm_apply f)
    have h := hrel (T.symm f) z hz
    rw [hval] at h
    exact h
  have hu (f : BoundaryDatum (observedPatch (n := n) V₂)) (z : M₁) (hz : z ∈ U) :
      ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (u f) z :=
    D.solver₁.analyticAt_interior hReg₁ A₁.metric A₁.potential A₁.analytic_potential
      (T.symm f).val (T.symm f).property.1 z (hU hz)
  have hv (f : BoundaryDatum (observedPatch (n := n) V₂)) (z : M₁) (hz : z ∈ U) :
      ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (v f) (J z) :=
    D.solver₂.analyticAt_interior hReg₂ A₂.metric A₂.potential A₂.analytic_potential
      f.val f.property.1 (J z) (hJinterior z hz)
  have hanalytic (z : M₁) (hz : z ∈ U) :
      ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J z ∧
        ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω c z := by
    obtain ⟨f₀, f, hf₀, _, hQ⟩ := exists_interior_analytic_quotient_coordinates
      hSchauder hRunge₂ hReg₂ hdim hcompact₂ hconnected₂ A₂ D.solver₂ Γ₂ hΓ₂
      (J z) (hJinterior z hz)
    exact analyticAt_scaled_identification_of_quotient_chart u v U J c z hz
      ((hJcont z hz).continuousAt (U.isOpen.mem_nhds hz)) hc hrel₂ (fun f => hu f z hz)
      f₀ f (hv f₀ z hz) (by change D.solver₂.solve f₀.val (J z) ≠ 0; rw [hf₀]; exact one_ne_zero) hQ
  have hJanalytic : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J U :=
    fun z hz => (hanalytic z hz).1.contMDiffWithinAt
  refine ⟨hJanalytic, fun z hz => (hanalytic z hz).2.contMDiffWithinAt, ?_⟩
  intro z hz
  obtain ⟨f₀, f, hf₀, _, hQ⟩ := exists_interior_analytic_quotient_coordinates
    hSchauder hRunge₁ hReg₁ hdim hcompact₁ hconnected₁ A₁ D.solver₁ Γ₁ D.patch_nonempty z (hU hz)
  have hSourceQ : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
      (quotientCoordinates (fun i => u (T (f i))) (u (T f₀))) z := by
    simpa only [u, LinearEquiv.symm_apply_apply] using hQ
  have hu₀ : u (T f₀) z ≠ 0 := by
    simp only [u, LinearEquiv.symm_apply_apply, hf₀]
    exact one_ne_zero
  have hinj := injective_mfderiv_scaled_identification_of_quotient_chart
    u v U J c z hz hc hrel₂ (hanalytic z hz).1 (fun f => hv f z hz)
    (T f₀) (fun i => T (f i)) hu₀ hSourceQ
  exact TauCeti.isLocalDiffeomorphAt_of_injective_mfderiv hJanalytic U.isOpen hz (hU hz)
    (by decide) hinj rfl

end ConformalPoisson

end ProofPart_NativeScaledRegularity

