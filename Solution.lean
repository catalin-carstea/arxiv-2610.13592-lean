/- A deliberately nonoptimal dimension-to-the-order bound converts
coordinate multilinear readings to the Euclidean operator norm. -/
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n k : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem norm_multilinear_le_coordinate_bound
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (A : ContinuousMultilinearMap ℝ (fun _ : Fin k => V) F)
    {K : ℝ} (hK : 0 ≤ K)
    (hA : ∀ m : Fin k → Fin (n + 1),
      ‖A (fun i => EuclideanSpace.single (m i) 1)‖ ≤ K) :
    ‖A‖ ≤ (n + 1 : ℝ) ^ k * K := by
