/- Assignment268, /root. Taylor coefficient errors times the ACTUAL finite
profile jets give the required uniform scaled scalar residual estimate. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem coefficient_jet_product_bound {C J t h s : ℝ} {a v : ℂ} (p : ℕ)
    (hC : 0 ≤ C) (hh : 0 ≤ h) (ht : t = h * s)
    (ha : ‖a‖ ≤ C * t ^ p) (hv : s ^ p * ‖v‖ ≤ J) :
    ‖a‖ * ‖v‖ ≤ C * J * h ^ p := by
  calc
    _ ≤ (C * t ^ p) * ‖v‖ := mul_le_mul_of_nonneg_right ha (norm_nonneg _)
    _ = C * h ^ p * (s ^ p * ‖v‖) := by rw [ht, mul_pow]; ring
    _ ≤ C * h ^ p * J := mul_le_mul_of_nonneg_left hv (mul_nonneg hC (pow_nonneg hh _))
    _ = _ := by ring

namespace BoundaryLayerCoefficients

without_proof_info in
theorem exists_native_taylor_operator_error_bound {S : TopologicalSpace.Opens H}
    (F : NormalMetricField S) {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) {K : Set Y} (hK : IsCompact K) (hKU : K ⊆ U)
    (a : Y → ℂ) (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (M : ℕ) {r CT : ℝ} (hCT : 0 ≤ CT) (he : LayerCoefficientTaylorError F B K r M CT) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ j : ℕ, j ≤ M → ∀ z : H,
      (nativeNormalCoordinates z).1 ∈ K → (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) r →
      ∀ h : ℝ, 0 < h → h ≤ 1 →
      ‖conjugatedSplitOperator (fun i l => (F.inverse z i l : ℂ)) (F.tau z)
          (fun i => (metricTangentialDrift F i z : ℂ)) ξ h (B.profile a j)
          (nativeNormalCoordinates z).1 ((nativeNormalCoordinates z).2 / h) -
        conjugatedSplitOperator (B.matrixTaylor M (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2)
          (B.normalTaylor M (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2)
          (B.tangentTaylor M (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2) ξ h (B.profile a j)
          (nativeNormalCoordinates z).1 ((nativeNormalCoordinates z).2 / h)‖ ≤ C * h ^ (M + 1) := by
  obtain ⟨c, J, hc, hJ, hb⟩ := B.exists_uniform_actual_layerJet_moment_exp_bound hU hK hKU a ha ha0 M (M + 1)
  refine ⟨CT * J * scalarFrequencyWeight ξ, mul_nonneg (mul_nonneg hCT hJ) (scalarFrequencyWeight_nonneg ξ), ?_⟩
  intro j hj z hz ht h hh hh1
  let y := (nativeNormalCoordinates z).1
  let t := (nativeNormalCoordinates z).2
  let s := t / h
  have hs : 0 ≤ s := div_nonneg ht.1 hh.le
  have hts : t = h * s := by dsimp [s]; field_simp
  obtain ⟨hv, hn, hd, hdd⟩ := hb j hj y hz s hs
  have hexp : J * Real.exp (-c * s) ≤ J := by
    exact (mul_le_mul_of_nonneg_left (Real.exp_le_one_iff.mpr (by nlinarith)) hJ).trans_eq (mul_one _)
  have hv' := hv.trans hexp
  have hn' := hn.trans hexp
  have hd' := fun i => (hd i).trans hexp
  have hdd' := fun i l => (hdd i l).trans hexp
  obtain ⟨hA, hτ, hc'⟩ := he z hz ht
  rw [conjugatedSplitOperator_sub]
  have hp {u v : ℂ} (hu : ‖u‖ ≤ CT * t ^ (M + 1)) (hv : s ^ (M + 1) * ‖v‖ ≤ J) :
      ‖u‖ * ‖v‖ ≤ CT * J * h ^ (M + 1) :=
    coefficient_jet_product_bound (M + 1) hCT hh.le hts hu hv
  let A : Matrix (Fin n) (Fin n) ℂ := fun i l => (F.inverse z i l : ℂ)
  have hbound := scalarCoefficientDifference_product_bound
    (A - B.matrixTaylor M y t)
    ((F.tau z : ℂ) - B.normalTaylor M y t)
    ((fun i => (metricTangentialDrift F i z : ℂ)) - B.tangentTaylor M y t)
    ξ hh.le hh1 (by positivity : 0 ≤ CT * J * h ^ (M + 1)) (B.profile a j) y s
    (fun i l => hp (hA i l) hv') (hp hτ hn')
    (fun i l => hp (hA i l) (hd' l)) (fun i => hp (hc' i) hv')
    (fun i l => hp (hA i l) (hdd' i l)) (fun i => hp (hc' i) (hd' i))
  exact hbound.trans_eq (by ring)

end BoundaryLayerCoefficients
end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNNativeTaylorResidualBound

