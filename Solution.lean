  obtain ⟨K2, hK2⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (fun x hx => ((hu x hx).fderiv_right (m := 2) (by norm_num)).fderiv_right
      (m := 1) (by norm_num)) hα
  exact ⟨K0, K1, K2, hK0, hK1, hK2⟩

namespace DirichletHolder
variable [ProperSpace E]

without_proof_info in
theorem exists_holderJet_of_local_c3 {α : ℝ≥0} (hα : α ≤ 1) (u : E → ℝ)
    (hu : ∀ x ∈ closedBall (0 : E) 1, ContDiffAt ℝ 3 u x) :
    ∃ j : HolderJet α E, ∀ x : closedBall (0 : E) 1,
      j.1 x = u x ∧ j.2.1 x = fderiv ℝ u x ∧
        j.2.2 x = fderiv ℝ (fderiv ℝ u) x := by
  obtain ⟨K0, K1, K2, hK0, hK1, hK2⟩ :=
    exists_holderBounds_jets_of_contDiffAt_three_isCompact
      (isCompact_closedBall (0 : E) 1) hu hα
  have hc0 : ContinuousOn u (closedBall (0 : E) 1) :=
    fun x hx => (hu x hx).continuousAt.continuousWithinAt
  have hc1 : ContinuousOn (fderiv ℝ u) (closedBall (0 : E) 1) :=
    fun x hx => ((hu x hx).fderiv_right (m := 2) (by norm_num)).continuousAt.continuousWithinAt
  have hc2 : ContinuousOn (fderiv ℝ (fderiv ℝ u)) (closedBall (0 : E) 1) :=
    fun x hx => (((hu x hx).fderiv_right (m := 2) (by norm_num)).fderiv_right
      (m := 1) (by norm_num)).continuousAt.continuousWithinAt
  refine ⟨(closedBallHolderRestriction u hc0 hK0,
    closedBallHolderRestriction (fderiv ℝ u) hc1 hK1,
    closedBallHolderRestriction (fderiv ℝ (fderiv ℝ u)) hc2 hK2), ?_⟩
  intro x
  simp only [closedBallHolderRestriction_apply, and_self]

end DirichletHolder
end ConformalPoisson

end ProofPart_BoundaryAnalytic_FiniteHolderJet

/- Boundary analytic support: ReflectedHolderFamilies.lean, SHA256 e45b6d208405d614af5baeaf754b4d55b925031f755cc4b781f11e09a98ba757 -/
noncomputable section ProofPart_BoundaryAnalytic_ReflectedHolderFamilies




/- Bounded fold precomposition carries the actual analytic parameter
families into Holder reflected fields. Multiplication by a fixed normal
coordinate factor gives the normal drift and forcing; spatial analyticity
of a reflected field is never asserted. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

def evenFoldHolderL : (H F) →L[ℝ] (H F) :=
  TauCeti.HolderSpace.compLipschitzL boundaryFoldClosed boundaryFoldClosed_lipschitz

without_proof_info in
@[simp] theorem evenFoldHolderL_apply (f : H F) (x : closedBall (0 : V) 1) :
    evenFoldHolderL f x = f (boundaryFoldClosed x) :=
  TauCeti.HolderSpace.compLipschitzL_apply boundaryFoldClosed_lipschitz f x

def normalFactorFoldHolderL (T : H ℝ) : (H ℝ) →L[ℝ] (H ℝ) :=
  ((ContinuousLinearMap.mul ℝ ℝ).compHolder₂ T).comp evenFoldHolderL

without_proof_info in
@[simp] theorem normalFactorFoldHolderL_apply (T f : H ℝ) (x : closedBall (0 : V) 1) :
    normalFactorFoldHolderL T f x = T x * f (boundaryFoldClosed x) := by
  simp [normalFactorFoldHolderL]

without_proof_info in
theorem exists_normalCoordinateHolder (hα : α ≤ 1) :
    ∃ T : H ℝ, ∀ x : closedBall (0 : V) 1, T x = (x : V) 0 := by
  let L : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  obtain ⟨K, hK⟩ := exists_holderBound_of_contDiffAt_isCompact
    (f := fun x : V => x 0) (isCompact_closedBall (0 : V) 1)
    (fun x _ => L.contDiff.contDiffAt) hα
  refine ⟨DirichletHolder.closedBallHolderRestriction (fun x : V => x 0)
    L.continuous.continuousOn hK, ?_⟩
  intro x
  exact DirichletHolder.closedBallHolderRestriction_apply _ _ _ x

variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P] {p : P}

without_proof_info in
theorem analyticAt_evenFoldHolderFamily {f : P → H F} (hf : AnalyticAt ℝ f p) :
    AnalyticAt ℝ (fun a => evenFoldHolderL (f a)) p :=
  (evenFoldHolderL.analyticAt _).comp hf

without_proof_info in
theorem analyticAt_normalFactorFoldHolderFamily (T : H ℝ)
    {f : P → H ℝ} (hf : AnalyticAt ℝ f p) :
    AnalyticAt ℝ (fun a => normalFactorFoldHolderL T (f a)) p :=
  ((normalFactorFoldHolderL T).analyticAt _).comp hf

without_proof_info in
theorem evenFoldHolderL_translated_read (χ : V → ℝ) (a : V) (ha : a 0 = 0)
    (hχ : ∀ x : V, χ (boundaryFold x) = χ x)
    (f : V → F) (G : H F)
    (hG : ∀ x : closedBall (0 : V) 1, G x = f (localizedTranslation χ a x))
    (x : closedBall (0 : V) 1) :
    evenFoldHolderL G x = f (boundaryFold (localizedTranslation χ a x)) := by
  rw [evenFoldHolderL_apply, hG]
  exact congrArg f (boundaryFold_localizedTranslation χ a x ha (hχ x)).symm

without_proof_info in
theorem normalFactorFoldHolderL_translated_read (χ : V → ℝ) (a : V) (ha : a 0 = 0)
    (hχ : ∀ x : V, χ (boundaryFold x) = χ x)
    (f : V → ℝ) (T G : H ℝ)
    (hG : ∀ x : closedBall (0 : V) 1, G x = f (localizedTranslation χ a x))
    (x : closedBall (0 : V) 1) :
    normalFactorFoldHolderL T G x = T x * f (boundaryFold (localizedTranslation χ a x)) := by
  rw [normalFactorFoldHolderL_apply]
  have h := evenFoldHolderL_translated_read χ a ha hχ f G hG x
  rw [evenFoldHolderL_apply] at h
  exact congrArg (fun c : ℝ => T x * c)
    h

end ConformalPoisson

end ProofPart_BoundaryAnalytic_ReflectedHolderFamilies

