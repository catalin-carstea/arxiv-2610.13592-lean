  obtain ⟨w, hw⟩ := exists_Wkp_boundary_chart_reading (μ := μ) (p := (2 : ℝ≥0∞)) c htarget hu 1
  rw [Wkp.value_one] at hw
  let f : V → ℝ := fun z => G.kernel x ((extChartAt Ihalf c).symm z)
  let v : V → ℝ := u ∘ (extChartAt Ihalf c).symm
