  have hprod := Wkp.iteratedGradient_zero_ae_eq_of_value_ae_eq_mul hη hw1
  have hGS : (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) : P → P) =ᵐ[(volume : Measure P).restrict S]
      Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v₀) := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset hSΩ hprod,
      ae_restrict_of_ae_restrict_of_subset hSH hG, ae_restrict_mem hS.measurableSet]
      with x hxprod hxG hxS
