without_proof_info in
theorem contDiffOn_classical_directional {Ω : Opens V} {f : V → ℝ}
    (hf : ContDiffOn ℝ 2 f (Ω : Set V)) (e : V) :
    ContDiffOn ℝ 1 (fun x => fderiv ℝ f x e) (Ω : Set V) :=
  (hf.fderiv_of_isOpen Ω.isOpen (by norm_num : (1 : ℕ∞ω) + 1 ≤ 2)).clm_apply contDiffOn_const

without_proof_info in
theorem weak_directional_value_ae_eq_classical {Ω : Opens V} {u d : W1p μ Ω 2} {f : V → ℝ}
    (hf : ContDiffOn ℝ 2 f (Ω : Set V))
    (huf : (W1p.value u : V → ℝ) =ᵐ[μ.restrict (Ω : Set V)] f) {e : V}
    (hd : HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value d) e) :
