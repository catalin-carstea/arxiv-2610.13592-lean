  have hus : tsupport u ⊆ K := by
    apply closure_minimal ?_ hK.isClosed
    intro x hx
    change χ x * φ (extChartAt Ihalf c x) ≠ 0 at hx
    have hxs := hχs (subset_tsupport χ (mul_ne_zero_iff.mp hx).1)
    exact ⟨extChartAt Ihalf c x, subset_tsupport φ (mul_ne_zero_iff.mp hx).2,
      (extChartAt Ihalf c).left_inv hxs⟩
  refine ⟨u, hu, hK.of_isClosed_subset (isClosed_tsupport u) hus, hus.trans hKΩ,
    hus.trans hKi, ?_, ?_⟩
  · intro y
    apply image_eq_zero_of_notMem_tsupport
    intro hy
    have hyc : (y : M) ∈ ((Ihalf).interior M)ᶜ := by
      rw [(Ihalf).compl_interior]
      exact y.property
    exact hyc (hKi (hus hy))
  · intro z hz
    change χ ((extChartAt Ihalf c).symm z) * φ (extChartAt Ihalf c ((extChartAt Ihalf c).symm z)) = φ z
    rw [(extChartAt Ihalf c).right_inv (hΩt hz)]
    by_cases hφz : φ z = 0
    · rw [hφz, mul_zero]
    · rw [hχone.self_of_nhdsSet _ ⟨z, subset_tsupport φ hφz, rfl⟩, one_mul]

end ConformalPoisson

