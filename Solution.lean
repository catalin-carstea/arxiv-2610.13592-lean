noncomputable section ProofPart_GreenForcingSmooth


/- A forcing which vanishes near the evaluation point removes the Green
diagonal before any differentiation under an integral is attempted. -/
open Set Filter
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenForcingBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary

without_proof_info in
theorem DirichletGreenKernel.contMDiffAt_forcing_product
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
    {x : M} (hx : x ∉ tsupport F) (y : M) :
    ContMDiffAt ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) 𝓘(ℝ) ∞
      (fun p : M × M => G.kernel p.1 p.2 * F p.2) (x, y) := by
  by_cases hy : y ∈ tsupport F
  · have hxy : x ≠ y := fun h => hx (h ▸ hy)
    have hG := (G.smooth_off_diagonal (x, y) hxy).contMDiffAt
      ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hxy)
    exact hG.mul ((hF y).comp (x, y) contMDiffAt_snd)
  · have hz : (fun p : M × M => F p.2) =ᶠ[𝓝 (x, y)] 0 :=
      (notMem_tsupport_iff_eventuallyEq.mp hy).comp_tendsto continuous_snd.continuousAt.tendsto
    apply (contMDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq
    filter_upwards [hz] with p hp
    simp only [hp, Pi.zero_apply, mul_zero]

without_proof_info in
theorem DirichletGreenKernel.contMDiffOn_forcing_product
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F) :
    ContMDiffOn ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) 𝓘(ℝ) ∞
      (fun p : M × M => G.kernel p.1 p.2 * F p.2) ((tsupport F)ᶜ ×ˢ univ) :=
  fun p hp => (G.contMDiffAt_forcing_product g q ν S F hF hp.1 p.2).contMDiffWithinAt

without_proof_info in
theorem DirichletGreenKernel.firstVariableJet_forcing_product
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (F : M → ℝ) {x : M} (hx : x ∉ tsupport F) (y : M) :
    secondJet g (fun z => G.kernel z y * F y) x =
      F y • secondJet g (fun z => G.kernel z y) x := by
