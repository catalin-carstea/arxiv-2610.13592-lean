    ∀ x ∈ S, ‖iteratedFDerivWithin ℝ k f S x‖ ≤ C := by
  have hc : ContinuousOn (fun x => ‖iteratedFDerivWithin ℝ k f S x‖) S :=
    (hf.continuousOn_iteratedFDerivWithin (m := k) (by simp) hS).norm
  have heq : EqOn (fun x => min ‖iteratedFDerivWithin ℝ k f S x‖ C)
      (fun x => ‖iteratedFDerivWithin ℝ k f S x‖) (interior S) := by
    intro x hx
    change min ‖iteratedFDerivWithin ℝ k f S x‖ C = ‖iteratedFDerivWithin ℝ k f S x‖
    rw [iteratedFDerivWithin_eq_of_mem_interior hx k]
    exact min_eq_left (hbound x hx)
  have heqS := heq.of_subset_closure (hc.inf continuousOn_const) hc interior_subset hclosure
  intro x hx
  have hxEq : min ‖iteratedFDerivWithin ℝ k f S x‖ C = ‖iteratedFDerivWithin ℝ k f S x‖ := heqS hx
  exact hxEq.ge.trans (min_le_right _ _)

without_proof_info in
theorem analyticWithinAt_zero_of_interior_factorial_bounds [CompleteSpace F]
    {S : Set E} (hS : UniqueDiffOn ℝ S) (hconv : Convex ℝ S) (h0 : (0 : E) ∈ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    {M D : ℝ} (hM : 0 ≤ M) (hD : 0 < D)
    (hbound : ∀ x ∈ interior S, ∀ k, ‖iteratedFDeriv ℝ k f x‖ ≤
      M * D ^ k * (k.factorial : ℝ)) : AnalyticWithinAt ℝ f S 0 := by
  apply analyticWithinAt_zero_of_uniform_factorial_bounds hS hconv h0 hf hM hD
  intro x hx k
  exact relative_derivative_bound_of_interior_bound hS hclosure hf k
    (M * D ^ k * (k.factorial : ℝ)) (fun y hy => hbound y hy k) x hx

