theorem exists_native_compact_smooth_extension
    (U : Opens M) (hUI : (U : Set M) ⊆ (Ihalf).interior M)
    (K : Set M) (hK : IsCompact K) (hKU : K ⊆ U)
    (f : M → ℝ) (hf : ContMDiffOn Ihalf 𝓘(ℝ) ∞ f U) :
