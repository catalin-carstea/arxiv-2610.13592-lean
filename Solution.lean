/- The native local a priori estimate with the original forcing on the
right. Only value and first-order solution errors remain for global
patching and interpolation. All constants precede the forcing and solution. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem exists_native_boundary_apriori_lp_below (hp : 1 < p) (hpfin : p ≠ ⊤)
    (g : Metric (n := n) (M := M)) (c : M) (q : M → ℝ) (hq : Continuous q)
    (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ R > 0, R ≤ rMax ∧ ∃ b : ContDiffBump (extChartAt Ihalf c c), b.rOut < R ∧
      (closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∃ A ≥ 0, ∃ B ≥ 0, ∃ D ≥ 0, ∀ F u : M → ℝ,
        ContMDiff Ihalf 𝓘(ℝ) ∞ F → IsZeroDirichletSolution g q F u →
        ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
          (Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
            fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
          lpNorm (fun z => b (euclideanNormalSplit n z) • Wkp.iteratedGradient 1 U z) p
              (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤
            A * lpNorm (fun z : P => F ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) p
                (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) +
              B * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + D * ‖Wkp.value 2 U‖ := by
  obtain ⟨R, hR, hRMax, b, hb, htarget, A, hA, B₀, hB₀, D₀, hD₀, hlocal⟩ :=
    exists_native_boundary_local_lp_hessian_estimate_below (p := p) hp hpfin g c rMax hMax
  obtain ⟨B₁, hB₁, Q₁, hQ₁, hforcing⟩ :=
    native_boundary_rhs_lp_bound (p := p) hpfin g c q hq b hb htarget
  refine ⟨R, hR, hRMax, b, hb, htarget, A, hA, A * B₁ + B₀, by positivity,
    A * Q₁ + D₀, by positivity, fun F u hF hu => ?_⟩
  obtain ⟨U, hU, hest⟩ := hlocal q F u hu
  obtain ⟨hRhs, hRhsNorm⟩ := hforcing F u hF hu
  let e := euclideanNormalSplit n
  let μ : Measure P := volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)
  let w : P → ℝ := fun z => u ((extChartAt Ihalf c).symm (e z))
  have hUv : W1p.value (Wkp.lowerOrder 1 U) =ᵐ[μ] w := by
    have h : Wkp.value 1 (Wkp.lowerOrder 1 U) =ᵐ[μ] w := by
      rw [← Wkp.value_succ]
      exact hU
    simpa only [Wkp.value_one] using h
  have hUg := W1p.gradient_ae_eq_of_contDiffOn (Wkp.lowerOrder 1 U)
    ((contDiffOn_split_boundary_chart_reading c htarget hu.1).of_le (by simp)) hUv
  have hvalnorm : lpNorm w p μ = ‖Wkp.value 2 U‖ := by
    rw [Lp.norm_def, lpNorm, eLpNorm_congr_ae hU]
  have hgradnorm : lpNorm (∇ w) p μ = ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ := by
    rw [Wkp.iteratedGradient_zero, Lp.norm_def, lpNorm, eLpNorm_congr_ae hUg]
