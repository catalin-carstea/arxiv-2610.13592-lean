/- Proof support: FixedDenominatorCoordinates.lean, SHA256 0876bc88cd591c9c7c0dc167f9777923ffc084cf5702c0cd1dee601a78c8da77 -/
noncomputable section ProofPart_FixedDenominatorCoordinates





/- Actual interior analytic quotient coordinates with ANY prescribed
original supported denominator nonzero at the point. This common witness
is needed in both no-boundary-escape and continuation. -/
open Set TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem exists_interior_analytic_quotient_coordinates_fixed_denominator
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : AnalyticRungeJetApproximation (n := n) (M := M))
    (hRegularity : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    (A : AnalyticProblem (n := n) (M := M)) (S : DirichletSolver A.smoothMetric A.potential)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (f₀ : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M))) (hf₀ : S.solve f₀.val x ≠ 0) :
    ∃ f : Fin (n + 1) → BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      (∀ i, S.solve (f i).val x = 0) ∧
      IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
        (quotientCoordinates (fun i => S.solve (f i).val) (S.solve f₀.val)) x := by
  classical
  have hframe (i : Fin (n + 1)) := exists_datum_with_value_and_covector
    hSchauder (hRunge A) hdim hcompact hconnected
    (A.analytic_potential.of_le (by decide)) A.nonresonant S Γ hΓ x hx 0
    (S.solve f₀.val x • (EuclideanSpace.proj i : TangentSpace (𝓡∂ (n + 1)) x →L[ℝ] ℝ))
  choose f hfvalue hfderiv using hframe
  let u : Fin (n + 1) → M → ℝ := fun i => S.solve (f i).val
  let w : M → ℝ := S.solve f₀.val
  let U : TopologicalSpace.Opens M :=
    ⟨(𝓡∂ (n + 1)).interior M ∩ {z | w z ≠ 0},
      ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).inter
        (isClosed_singleton.isOpen_compl.preimage (S.correct f₀.val f₀.property.1).1.continuous)⟩
  have hxU : x ∈ U := ⟨hx, hf₀⟩
  have huanalytic (i : Fin (n + 1)) : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω (u i) U :=
    (S.analyticOn_nativeInterior hRegularity A.metric A.potential A.analytic_potential
      (f i).val (f i).property.1).mono inter_subset_left
  have hwanalytic : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω w U :=
    (S.analyticOn_nativeInterior hRegularity A.metric A.potential A.analytic_potential
      f₀.val f₀.property.1).mono inter_subset_left
  have hQ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω (quotientCoordinates u w) U :=
    contMDiffOn_pi_module_iff.mpr fun i => (huanalytic i).div₀ hwanalytic (fun _ hz => hz.2)
  have hinj : Function.Injective (mfderiv (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ)
      (quotientCoordinates u w) x) := by
    apply TauCeti.injective_mvfderiv_iff.mp
    exact injective_mvfderiv_quotientCoordinates_scaled u w x
      (fun i => ((S.correct (f i).val (f i).property.1).1.of_le (by decide)).contMDiffAt)
      (((S.correct f₀.val f₀.property.1).1.of_le (by decide)).contMDiffAt) hfvalue hf₀ hfderiv
  exact ⟨f, hfvalue, TauCeti.isLocalDiffeomorphAt_of_injective_mfderiv hQ U.isOpen hxU hx
    (by decide) hinj (by simp)⟩
end ConformalPoisson

end ProofPart_FixedDenominatorCoordinates

/- Proof support: InteriorQuotientCoordinates.lean, SHA256 ad88316a232ad2b551af361c566c27d09a6777dced47468f33a6e2d636a486ef -/
noncomputable section ProofPart_InteriorQuotientCoordinates



/-
Actual analytic quotient coordinates at every interior point, supplied by the
proved finite jets and the approved interior analytic regularity input.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem exists_interior_analytic_quotient_coordinates
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : AnalyticRungeJetApproximation (n := n) (M := M))
    (hRegularity : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    (A : AnalyticProblem (n := n) (M := M)) (S : DirichletSolver A.smoothMetric A.potential)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M) :
    ∃ denominator : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      ∃ numerators : Fin (n + 1) → BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
        S.solve denominator.val x = 1 ∧ (∀ i, S.solve (numerators i).val x = 0) ∧
        IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
          (quotientCoordinates (fun i => S.solve (numerators i).val) (S.solve denominator.val)) x := by
  classical
  obtain ⟨f₀, hf₀⟩ := exists_datum_with_value_one hSchauder (hRunge A) hdim hcompact hconnected (A.analytic_potential.of_le (by decide)) A.nonresonant S Γ hΓ x hx
  obtain ⟨f, hfvalue, hQ⟩ := exists_interior_analytic_quotient_coordinates_fixed_denominator
    hSchauder hRunge hRegularity hdim hcompact hconnected A S Γ hΓ x hx f₀
    (by rw [hf₀]; exact one_ne_zero)
  exact ⟨f₀, f, hf₀, hfvalue, hQ⟩

end ConformalPoisson

