      ∀ u : Wkp (volume : Measure P) Ω p 2,
      (∀ η : P → ℝ, ContDiff ℝ ∞ η → HasCompactSupport η → tsupport η ⊆ ball x₀ R →
        ∀ w : Wkp (volume : Measure P) Ω p 2,
          Wkp.value 2 w =ᵐ[(volume : Measure P).restrict Ω] (fun x => η x * Wkp.value 2 u x) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω p) →
      ∀ r t : ℝ, 0 < r → r < t → t ≤ R → ∀ ε : ℝ, 0 < ε →
        lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p
            ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
          ε * (lpNorm (Wkp.iteratedGradient 1 u) p
              ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ t)) +
            (c / (t - r) * lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p
              ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ t)) +
             c / (t - r) ^ 2 * lpNorm (Wkp.value 2 u) p
              ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ t)))) +
          (4 * (finrank ℝ P : ℝ) ^ 2 / ε) * lpNorm (Wkp.value 2 u) p
              ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ t)) := by
  obtain ⟨c₀, hc₀, hcut⟩ := exists_forall_contDiff_cutoff_closedBall (E := P)
  refine ⟨4 * c₀, by positivity, fun a Ω x₀ R hmatch u hzero r t hr hrt htR ε hε => ?_⟩
  let m := (r + t) / 2
  obtain ⟨η, hη, hηrange, hηone, hηts, hηg, hηh⟩ :=
    hcut x₀ hr.le (show r < m by dsimp [m]; linarith)
  let Bt : Opens P := ⟨ball x₀ t, isOpen_ball⟩
  let Ωt : Opens P := Ω ⊓ Bt
  let S : Set P := (Ω : Set P) ∩ ball x₀ r
  have hηc : HasCompactSupport η := (isCompact_closedBall x₀ m).of_isClosed_subset
    (isClosed_tsupport η) hηts
  have hηBt : tsupport η ⊆ (Bt : Set P) := hηts.trans
    (closedBall_subset_ball (by dsimp [m]; linarith))
  have hηR : tsupport η ⊆ ball x₀ R := hηBt.trans (ball_subset_ball htR)
  have hηabs : ∀ x, |η x| ≤ 1 := fun x => abs_le.mpr
    ⟨by linarith [(hηrange ⟨x, rfl⟩).1], (hηrange ⟨x, rfl⟩).2⟩
  obtain ⟨w, hw⟩ := Wkp.exists_value_ae_eq_mul_of_hasCompactSupport 2 hη hηc u
  let uR := Wkp.restrictL (inf_le_left : Ωt ≤ Ω) 2 u
  let wR := Wkp.restrictL (inf_le_left : Ωt ≤ Ω) 2 w
  have hwr : Wkp.value 2 wR =ᵐ[(volume : Measure P).restrict Ωt]
      (fun x => η x * Wkp.value 2 uR x) := cutoff_reading_restrict (V := Bt) η u w hw
  have hwr0 : Wkp.firstOrder 1 wR ∈ w1p0Submodule volume Ωt p :=
    cutoff_zeroTrace_restrict η hηc hηBt u w hw (hzero η hη hηc hηR w hw)
  have hΩt : (Ωt : Set P) ∩ Bt = (normalHalfSpace (E := E) a : Set P) ∩ Bt := by
    ext x
    constructor
    · rintro ⟨⟨hxΩ, hxt⟩, _⟩
      have hxR := ball_subset_ball htR hxt
      have hxIR : x ∈ (Ω : Set P) ∩ ball x₀ R := ⟨hxΩ, hxR⟩
      rw [hmatch] at hxIR
      exact ⟨hxIR.1, hxt⟩
    · intro hx
      have hxR := ball_subset_ball htR hx.2
      have hxIR : x ∈ (normalHalfSpace (E := E) a : Set P) ∩ ball x₀ R := ⟨hx.1, hxR⟩
      rw [← hmatch] at hxIR
      exact ⟨⟨hxIR.1, hx.2⟩, hx.2⟩
  have hSΩt : S ⊆ (Ωt : Set P) := fun x hx => ⟨hx.1, ball_subset_ball hrt.le hx.2⟩
  have hSH : S ⊆ (normalHalfSpace (E := E) a : Set P) := by
    intro x hx
    have hxR := ball_subset_ball (hrt.le.trans htR) hx.2
    have hxIR : x ∈ (Ω : Set P) ∩ ball x₀ R := ⟨hx.1, hxR⟩
    rw [hmatch] at hxIR
    exact hxIR.1
  have hηS : EqOn η 1 S := fun x hx => hηone (ball_subset_closedBall hx.2)
  have hkey := boundary_cutoff_gradient_interpolation hp a hΩt uR wR η hη hηc hηBt
    hηabs hηg hηh hwr hwr0 (Ω.isOpen.inter isOpen_ball) hSΩt hSH hηS ε hε
  have hvg : (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 uR) : P → P) =ᵐ[(volume : Measure P).restrict Ωt]
      Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) := by
    rw [show uR = Wkp.restrictL (inf_le_left : Ωt ≤ Ω) 2 u from rfl,
      Wkp.lowerOrder_restrictL]
    exact Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 0 (Wkp.lowerOrder 1 u)
  have hmr : m - r = (t - r) / 2 := by dsimp [m]; ring
  have hgap : t - r ≠ 0 := sub_ne_zero.mpr hrt.ne'
  have hm1 : 2 * (c₀ / (m - r)) = 4 * c₀ / (t - r) := by rw [hmr]; field_simp; ring
  have hm2 : c₀ / (m - r) ^ 2 = 4 * c₀ / (t - r) ^ 2 := by rw [hmr]; field_simp; ring
  rw [hm1, hm2, Lp.norm_eq_lpNorm_of_ae_eq (Wkp.value_restrictL_ae (inf_le_left : Ωt ≤ Ω) 2 u),
    Lp.norm_eq_lpNorm_of_ae_eq hvg,
    Lp.norm_eq_lpNorm_of_ae_eq (Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 1 u)] at hkey
  rw [← lpNorm_congr_ae (ae_restrict_of_ae_restrict_of_subset hSΩt hvg)]
  exact hkey

end ConformalPoisson

end ProofPart_GreenTrace_HalfBallGradientInterpolation

