/- Proof support: ConformalFirstOrder.lean, SHA256 5fa49151d71e6a656282baa808748a8bb55cf0031bd0599beade756621d6e398 -/
noncomputable section ProofPart_ConformalFirstOrder



/-
At a zero of a homogeneous solution, the second-order part cancels between two
conformal metrics. What remains is the actual first-order pairing used to recover
the conformal factor from the common scaled solution family.
-/

open Bundle
open scoped Manifold ContDiff InnerProductSpace

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem nativeGradientPairing_mul_right (g : Metric (n := n) (M := M))
    (a r u : M → ℝ) (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r)
    (hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u) (x : M) :
    nativeGradientPairing g a (r * u) x =
      r x * nativeGradientPairing g a u x + u x * nativeGradientPairing g a r x := by
  let : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  dsimp only [nativeGradientPairing]
  rw [TauCeti.Manifold.mgradient_mul (hr.mdifferentiable (by decide))
    (hu.mdifferentiable (by decide))]
  simp only [inner_add_right, real_inner_smul_right]

without_proof_info in
theorem conformal_firstOrder_pairing_of_zero_solution
    (g : Metric (n := n) (M := M)) (q p a r u : M → ℝ)
    (ha : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a) (hapos : ∀ x, 0 < a x)
    (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r)
    (hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u) (x : M)
    (hux : u x = 0) (hLu : schrodinger g q u x = 0)
    (hscaled : schrodinger (g.rescale a ha hapos) p (r * u) x = 0) :
    2 * nativeGradientPairing g r u x +
      (((n + 1 : ℝ) - 2) / (2 * a x)) * r x * nativeGradientPairing g a u x = 0 := by
  have hLzero : schrodinger g 0 u x = 0 := by
    simpa only [schrodinger, hux, mul_zero, Pi.zero_apply, add_zero] using hLu
  have hscaledzero : schrodinger (g.rescale a ha hapos) 0 (r * u) x = 0 := by
    simpa only [schrodinger, Pi.mul_apply, hux, mul_zero, Pi.zero_apply, add_zero] using hscaled
  rw [schrodinger_rescale_zero g a (r * u) ha hapos (hr.mul hu) x,
    schrodinger_mul g 0 r u hr hu x, nativeGradientPairing_mul_right g a r u hr hu x] at hscaledzero
  simp only [hLzero, hux, mul_zero, zero_mul, add_zero] at hscaledzero
  have hinv : (a x)⁻¹ ≠ 0 := inv_ne_zero (hapos x).ne'
  have hb := (mul_eq_zero.mp hscaledzero).resolve_left hinv
  linarith

end ConformalPoisson

end ProofPart_ConformalFirstOrder

