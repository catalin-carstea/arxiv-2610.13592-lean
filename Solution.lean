def nativeLocalSmoothZeroDirichletSpace
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (c : M) (r : ℝ) :
    Submodule ℝ (M → ℝ) where
  carrier := {u | ContMDiff Ihalf 𝓘(ℝ) ∞ u ∧
    (∀ y, (𝓡∂ (n + 1)).IsBoundaryPoint y → u y = 0) ∧
    ∀ z ∈ (boundaryChartCap (I := Ihalf) c r : Set V),
      schrodinger g q u ((extChartAt Ihalf c).symm z) = 0}
  zero_mem' := ⟨contMDiff_const, fun _ _ => rfl, fun z _ => schrodinger_zero g q _⟩
  add_mem' := by
    rintro u v ⟨hu, hu0, hPu⟩ ⟨hv, hv0, hPv⟩
    refine ⟨hu.add hv, fun y hy => ?_, fun z hz => ?_⟩
    · simp only [Pi.add_apply, hu0 y hy, hv0 y hy, add_zero]
    · rw [schrodinger_add g q hu hv, hPu z hz, hPv z hz]
      simp
  smul_mem' := by
    rintro a u ⟨hu, hu0, hPu⟩
    refine ⟨contMDiff_const.smul (I := 𝓘(ℝ)) hu, fun y hy => ?_, fun z hz => ?_⟩
    · simp only [Pi.smul_apply, hu0 y hy, smul_zero]
    · rw [schrodinger_smul g q a hu, hPu z hz]
      simp

