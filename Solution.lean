/- The native inverse only needs smooth regularity of weak values.
The signed Garding inequality removes a weak kernel whose L2 value is
zero, so no separate equality in the H1 completion is necessary. -/
open Bundle Set TauCeti TauCeti.Manifold MeasureTheory
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]

/-- Minimal weak/native regularity obligation for the actual inverse:
the weak value has a smooth zero-boundary classical solution representative.
Equality of the original H1 elements is not assumed. -/
def NativeWeakDirichletValueRegularity (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) : Prop :=
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let Q := ContinuousMap.toLp ⊤ (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨q, hq.continuous⟩
  ∀ (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
      (u : DirichletSobolev.zeroTraceSubmodule (I := 𝓡∂ (n + 1)) ((𝓡∂ (n + 1)).boundary M)),
    (∀ v, DirichletSobolev.schrodingerForm ((𝓡∂ (n + 1)).boundary M) Q u v =
      ⟪ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨F, hF.continuous⟩,
        DirichletSobolev.valueL ((𝓡∂ (n + 1)).boundary M) v⟫_ℝ) →
    ∃ (w : M → ℝ) (hw : IsZeroDirichletSolution g q F w),
      DirichletSobolev.valueL ((𝓡∂ (n + 1)).boundary M) u =
        ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨w, hw.1.continuous⟩

without_proof_info in
/-- The earlier stronger regularity bridge implies the value version;
its original statement is preserved. -/
theorem NativeWeakDirichletRegularity.toValue
    {g : Metric (n := n) (M := M)} {q : M → ℝ}
    {hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q}
    (hreg : NativeWeakDirichletRegularity g q hq) : NativeWeakDirichletValueRegularity g q hq := by
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  intro F hF u hu
  obtain ⟨w, hw, heq⟩ := hreg F hF u hu
  refine ⟨w, hw, ?_⟩
  change SobolevH1.toLp u.val = _
  rw [heq, SobolevH1.toLp_ofSmooth]
  congr 1

without_proof_info in
/-- Native compactness is proved, and smooth nonresonance plus the
signed Garding estimate eliminates the weak kernel using value regularity. -/
theorem exists_zeroDirichletSolution_of_weak_value_regularity
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hregularity : NativeWeakDirichletValueRegularity g q hq)
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F) :
    ∃ w : M → ℝ, IsZeroDirichletSolution g q F w := by
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let B := (𝓡∂ (n + 1)).boundary M
  let Q := ContinuousMap.toLp ⊤ (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨q, hq.continuous⟩
  have hker : ∀ u : DirichletSobolev.zeroTraceSubmodule (I := 𝓡∂ (n + 1)) B,
      (∀ v, DirichletSobolev.schrodingerForm B Q u v = 0) → u = 0 := by
    intro u hu
    have hweak : ∀ v, DirichletSobolev.schrodingerForm B Q u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ
          (⟨(0 : M → ℝ), continuous_const⟩ : C(M, ℝ)), DirichletSobolev.valueL B v⟫_ℝ := by
      intro v
      have hzero : ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ
          (⟨(0 : M → ℝ), continuous_const⟩ : C(M, ℝ)) = 0 := by
        change ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ 0 = 0
        exact map_zero _
      rw [hzero, inner_zero_left]
      exact hu v
    obtain ⟨w, hw, hvalue⟩ := hregularity 0 contMDiff_const u hweak
    have hwzero : w = 0 := hNR w ⟨hw.1, hw.2.1, hw.2.2⟩
    have hc : (⟨w, hw.1.continuous⟩ : C(M, ℝ)) = 0 := by
      ext x
      exact congrFun hwzero x
    have hvaluezero : DirichletSobolev.valueL B u = 0 := by
      rw [hvalue, hc, map_zero]
    have hgarding := DirichletSobolev.schrodingerForm_garding B Q u
    rw [hu u, hvaluezero, norm_zero, zero_pow (by norm_num : (2 : ℕ) ≠ 0),
      mul_zero, add_zero] at hgarding
    exact norm_eq_zero.mp (by nlinarith [norm_nonneg u])
  let F₂ := ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨F, hF.continuous⟩
  obtain ⟨u, hu, _⟩ := DirichletSobolev.existsUnique_weakSolution_of_compact_value_of_trivial_kernel
    B Q (nativeZeroTraceCompactness g) hker F₂
  obtain ⟨w, hw, _⟩ := hregularity F hF u hu
  exact ⟨w, hw⟩

