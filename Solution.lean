  have hEbound : gradLpNorm + valueLpNorm ≤ ε * S + CE * FN := herrors R hRR₀ F u hF hu
  have hBterm : B * gradLpNorm + D * valueLpNorm ≤ M₀ * (gradLpNorm + valueLpNorm) := by
    calc
      B * gradLpNorm + D * valueLpNorm ≤ M₀ * gradLpNorm + M₀ * valueLpNorm :=
        add_le_add (mul_le_mul_of_nonneg_right (le_max_left _ _) lpNorm_nonneg)
          (mul_le_mul_of_nonneg_right (le_max_right _ _) lpNorm_nonneg)
      _ = _ := by ring
  have hsum : A * forcingLpNorm + B * gradLpNorm + D * valueLpNorm ≤ A * (A₀ * FN) + M₀ * (ε * S + CE * FN) := by
    calc
      A * forcingLpNorm + B * gradLpNorm + D * valueLpNorm = A * forcingLpNorm + (B * gradLpNorm + D * valueLpNorm) := by ring
      _ ≤ A * (A₀ * FN) + M₀ * (gradLpNorm + valueLpNorm) :=
        add_le_add (mul_le_mul_of_nonneg_left hFbound hA) hBterm
      _ ≤ _ := add_le_add (le_refl _) (mul_le_mul_of_nonneg_left hEbound hM₀)
