def nativePullbackScale
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (F : EuclideanHalfSpace (n + 1) → M₁) (χ : EuclideanHalfSpace (n + 1) → M₂)
    (v₀ : EuclideanSpace ℝ (Fin (n + 1))) (z : EuclideanHalfSpace (n + 1)) : ℝ :=
  nativeMapPullbackPairing g₁ F z v₀ v₀ / nativeMapPullbackPairing g₂ χ z v₀ v₀

without_proof_info in
theorem nativePullbackScale_analyticOn
    (g₁ : Metric (n := n) (M := M₁) ω) (g₂ : Metric (n := n) (M := M₂) ω)
    {U : Set (EuclideanHalfSpace (n + 1))} (hU : IsOpen U)
    {F : EuclideanHalfSpace (n + 1) → M₁} {χ : EuclideanHalfSpace (n + 1) → M₂}
    (hF : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω F U)
    (hχ : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω χ U)
    (v₀ : EuclideanSpace ℝ (Fin (n + 1)))
    (hden : ∀ z ∈ U, nativeMapPullbackPairing (g₂.ofLE (by decide)) χ z v₀ v₀ ≠ 0) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      (nativePullbackScale (g₁.ofLE (by decide)) (g₂.ofLE (by decide)) F χ v₀) U :=
  (nativeMapPullbackPairing_analyticOn g₁ hU hF v₀ v₀).div₀
    (nativeMapPullbackPairing_analyticOn g₂ hU hχ v₀ v₀) hden

without_proof_info in
theorem cross_identity_eq_scale (x y a b : ℝ) (ha : a ≠ 0) (h : x * a = b * y) :
    x = (b / a) * y := by
  field_simp
  nlinarith [h]

without_proof_info in
theorem native_pullback_eq_scale_of_cross
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (F : EuclideanHalfSpace (n + 1) → M₁) (χ : EuclideanHalfSpace (n + 1) → M₂)
    (z : EuclideanHalfSpace (n + 1)) (v₀ v w : EuclideanSpace ℝ (Fin (n + 1)))
    (hden : nativeMapPullbackPairing g₂ χ z v₀ v₀ ≠ 0)
    (hcross : nativeMapPullbackPairing g₁ F z v w * nativeMapPullbackPairing g₂ χ z v₀ v₀ =
      nativeMapPullbackPairing g₁ F z v₀ v₀ * nativeMapPullbackPairing g₂ χ z v w) :
    nativeMapPullbackPairing g₁ F z v w = nativePullbackScale g₁ g₂ F χ v₀ z *
      nativeMapPullbackPairing g₂ χ z v w :=
  cross_identity_eq_scale _ _ _ _ hden hcross

without_proof_info in
theorem nativePullbackScale_eq_of_scaled_pairing
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (F : EuclideanHalfSpace (n + 1) → M₁) (χ : EuclideanHalfSpace (n + 1) → M₂)
