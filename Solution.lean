noncomputable section ProofPart_BoundaryAnalytic_MixedDerivativeWordBounds


/- Fixed differential words in the scalar equation shift only their
declared tangential/normal orders, with a fixed product of direction norms. -/
open Set
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem norm_mixedDerivativeWithin_tangent_word_le
    {S : Set E} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) {x : E} (hx : x ∈ S)
    (P : E →L[ℝ] E) (e : E) (vs : List E) (hvs : ∀ v ∈ vs, P v = v) (p q : ℕ) :
    ‖mixedDerivativeWithin S P e p q (iteratedFDerivWithinAlong S vs f) x‖ ≤
      ‖mixedDerivativeWithin S P e (p + vs.length) q f x‖ * (vs.map norm).prod := by
  induction vs generalizing p with
  | nil => simp only [iteratedFDerivWithinAlong_nil, List.length_nil, Nat.add_zero,
      List.map_nil, List.prod_nil, mul_one, le_refl]
  | cons v vs ih =>
    have hv : P v = v := hvs v (by simp)
    have htail : ∀ w ∈ vs, P w = w := fun w hw => hvs w (by simp [hw])
    have hw := contDiffOn_iteratedFDerivWithinAlong hS hf vs
    change ‖mixedDerivativeWithin S P e p q
      (fun y => fderivWithin ℝ (iteratedFDerivWithinAlong S vs f) S y v) x‖ ≤ _
    calc
      _ ≤ ‖mixedDerivativeWithin S P e (p + 1) q
          (iteratedFDerivWithinAlong S vs f) x‖ * ‖v‖ :=
        norm_mixedDerivativeWithin_tangent_direction_le hS hclosure hw hx P e v hv p q
      _ ≤ (‖mixedDerivativeWithin S P e (p + 1 + vs.length) q f x‖ *
          (vs.map norm).prod) * ‖v‖ :=
        mul_le_mul_of_nonneg_right (ih htail (p + 1)) (norm_nonneg v)
      _ = _ := by
        have hi : p + 1 + vs.length = p + (v :: vs).length := by simp; omega
        rw [hi]
        simp only [List.map_cons, List.prod_cons]
        ring

without_proof_info in
theorem norm_mixedDerivativeWithin_differential_word_le
    {S : Set E} (hS : UniqueDiffOn ℝ S)
    (hclosure : ∀ x ∈ S, x ∈ closure (interior S))
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S) {x : E} (hx : x ∈ S)
    (P : E →L[ℝ] E) (e : E) (vs : List E) (hvs : ∀ v ∈ vs, P v = v)
    (ell p q : ℕ) :
    ‖mixedDerivativeWithin S P e p q
      (iteratedFDerivWithinAlong S vs (normalDerivativeWithin S e ell f)) x‖ ≤
      ‖mixedDerivativeWithin S P e (p + vs.length) (q + ell) f x‖ * (vs.map norm).prod := by
  have h := norm_mixedDerivativeWithin_tangent_word_le hS hclosure
    (contDiffOn_normalDerivativeWithin hS hf e ell) hx P e vs hvs p q
  rwa [mixedDerivativeWithin_normalDerivativeWithin] at h

end ConformalPoisson

end ProofPart_BoundaryAnalytic_MixedDerivativeWordBounds

