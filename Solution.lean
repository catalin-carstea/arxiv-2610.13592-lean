noncomputable section ProofPart_CovariantJetLinearCoordinates




/- A linear coordinate reading of the full native jet. The Hessian includes
the exact connection correction. Injectivity permits any jet functional to
be read as a linear functional of ordinary coordinate derivatives. -/
namespace ConformalPoisson
variable {E W : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W]

def OrdinaryJet (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :=
  ℝ × (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)

def ordinaryJet (a : ℝ) (ξ : E →L[ℝ] ℝ) (B : E →L[ℝ] E →L[ℝ] ℝ) : OrdinaryJet E :=
  ⟨a, ξ, B⟩

instance : NormedAddCommGroup (OrdinaryJet E) :=
  inferInstanceAs (NormedAddCommGroup (ℝ × (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)))
instance : NormedSpace ℝ (OrdinaryJet E) :=
  inferInstanceAs (NormedSpace ℝ (ℝ × (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)))
instance : CompleteSpace (OrdinaryJet E) :=
  inferInstanceAs (CompleteSpace (ℝ × (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)))

def covariantJetCoordinateLinearMap (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) :
    (ℝ × (W →L[ℝ] ℝ) × (W →L[ℝ] W)) →ₗ[ℝ] OrdinaryJet E where
  toFun j := ⟨j.1, j.2.1.comp D.toContinuousLinearMap, connectionJetHessian D Γ j.2.1 j.2.2⟩
  map_add' j k := by
    refine Prod.ext rfl (Prod.ext ?_ ?_)
    · ext v
      rfl
    · ext v w
      change inner ℝ (j.2.2 (D v) + k.2.2 (D v)) (D w) +
        (j.2.1 (D (Γ v w)) + k.2.1 (D (Γ v w))) =
        (inner ℝ (j.2.2 (D v)) (D w) + j.2.1 (D (Γ v w))) +
        (inner ℝ (k.2.2 (D v)) (D w) + k.2.1 (D (Γ v w)))
      rw [inner_add_left]
      ring
  map_smul' a j := by
    refine Prod.ext rfl (Prod.ext ?_ ?_)
    · ext v
      rfl
    · ext v w
      change inner ℝ (a • j.2.2 (D v)) (D w) + a * j.2.1 (D (Γ v w)) =
        a * (inner ℝ (j.2.2 (D v)) (D w) + j.2.1 (D (Γ v w)))
      rw [real_inner_smul_left]
      ring

without_proof_info in
theorem covariantJetCoordinateLinearMap_injective (D : E ≃L[ℝ] W)
    (Γ : E →L[ℝ] E →L[ℝ] E) : Function.Injective (covariantJetCoordinateLinearMap D Γ) := by
  intro j k h
  have ha : j.1 = k.1 := congrArg (fun t : OrdinaryJet E => t.1) h
  have hξ : j.2.1 = k.2.1 := covector_eq_of_coordinates D fun v =>
    congrArg (fun t : OrdinaryJet E => t.2.1 v) h
  have hA : j.2.2 = k.2.2 := by
    apply raisedHessian_eq_of_coordinates D
    intro v w
    have hB := congrArg (fun t : OrdinaryJet E => t.2.2 v w) h
    change connectionJetHessian D Γ j.2.1 j.2.2 v w =
      connectionJetHessian D Γ k.2.1 k.2.2 v w at hB
    simp only [connectionJetHessian_apply, hξ] at hB
    exact add_right_cancel hB
  exact Prod.ext ha (Prod.ext hξ hA)

end ConformalPoisson

end ProofPart_CovariantJetLinearCoordinates

