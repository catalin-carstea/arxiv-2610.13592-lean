  have hv : ContMDiff Ihalf 𝓘(ℝ) ∞ v := by
    apply contMDiff_of_tsupport
    intro z hz
    have hzU := hχU (tsupport_mul_subset_left hz)
    exact (hχ z).mul ((hG z hzU).contMDiffAt (hU.mem_nhds hzU))
  refine ⟨⟨θ, hθ, hθc, hθI, O, hxO, hθO, v, hv, ?_, ?_⟩, hθW⟩
  · exact (tsupport_mul_subset_left.trans hχU).trans (fun _ hz => hz.1)
  · intro z hz
    have hχz : χ z = 1 := subset_of_mem_nhdsSet hχone hz
    change χ z * G z = G z
    rw [hχz, one_mul]

without_proof_info in
theorem exists_nativePoleCutoffData
    (x : M) (hx : (Ihalf).IsInteriorPoint x) (G : M → ℝ)
    (hG : ContMDiffOn Ihalf 𝓘(ℝ) ∞ G ((Ihalf).interior M \ {x})) :
