theorem exists_local_wholeSpace_extension_euclidean_halfSpace
    {Ω U D : Opens (EuclideanSpace ℝ (Fin (n + 1)))}
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U)
    (u : W1p μ Ω p) :
    ∃ Z : W1p (volume : Measure X) ⊤ p,
      W1p.value Z =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] W1p.value u := by
  obtain ⟨ψ, N, hψ, _, hψ1, hψc, hψU, _, _, _⟩ :=
    hD.exists_contDiff_cutoff_with_bounds U.isOpen hDU
