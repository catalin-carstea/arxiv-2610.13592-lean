noncomputable section ProofPart_GreenTrace_NativeLocalL2AllOrderReading




/- The actual complete native L2 solution closure has ONE coherent bounded
reading at every finite Sobolev order, with its actual original L2 values.
Intended callers: bounded smooth readback and smooth operator evaluations. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 1500000 in
without_proof_info in
theorem exists_native_localL2_allOrder_reading_below
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (c : M) (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ r > 0, r ≤ rMax ∧ ∃ htarget :
      closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target,
      ∃ S : AllOrderSobolevReading (Module.finBasis ℝ V).addHaar
        (boundaryChartCap (I := Ihalf) c (r / 8))
        (nativeLocalL2SolutionSpace (g := g) (q := q) htarget),
        ∀ u, S.value u =ᵐ[(Module.finBasis ℝ V).addHaar.restrict
          (boundaryChartCap (I := Ihalf) c (r / 8) : Set V)]
          ((u : nativeLocalL2SolutionSpace (g := g) (q := q) htarget) :
            Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict
              (boundaryChartCap (I := Ihalf) c r : Set V))) := by
  obtain ⟨r, hr, hrMax, htarget, horders⟩ :=
    exists_native_localL2_bounded_higher_readings_below g q hq c rMax hMax
  let μ := (Module.finBasis ℝ V).addHaar
  let X := nativeLocalL2SolutionSpace (g := g) (q := q) htarget
  letI : CompleteSpace X := inferInstanceAs
    (CompleteSpace (LinearMap.range (nativeLocalSmoothToL2 (g := g) (q := q) htarget)).topologicalClosure)
  let Ω := boundaryChartCap (I := Ihalf) c r
  let D := boundaryChartCap (I := Ihalf) c (r / 8)
  have hsub : D ≤ Ω := fun _ hz => ⟨ball_subset_ball (by linarith : r / 8 ≤ r) hz.1, hz.2⟩
  let R : Lp ℝ 2 (μ.restrict (Ω : Set V)) →L[ℝ] Lp ℝ 2 (μ.restrict (D : Set V)) :=
    Lp.LpToLpOfMeasureLeSMul (c := 1) (by simp) (by
      simpa only [one_smul] using Measure.restrict_mono_set μ (SetLike.coe_subset_coe.mpr hsub))
  have hR : ∀ u : Lp ℝ 2 (μ.restrict (Ω : Set V)), R u =ᵐ[μ.restrict (D : Set V)] u :=
    fun u => Lp.coeFn_LpToLpOfMeasureLeSMul _ _ u
  let A : X →L[ℝ] Lp ℝ 2 (μ.restrict (D : Set V)) := R.comp X.subtypeL
  have hA : ∀ u : X, A u = R (u : Lp ℝ 2 (μ.restrict (Ω : Set V))) :=
    fun u => ContinuousLinearMap.comp_apply R X.subtypeL u
  have hDom : (boundaryChartCap (I := Ihalf) c (r / 4)) ⊓
      (⟨ball (extChartAt Ihalf c c) (r / 8), isOpen_ball⟩ : Opens V) = D := by
    apply SetLike.ext
    intro z
    exact ⟨fun hz => ⟨hz.2, hz.1.2⟩, fun hz =>
      ⟨⟨ball_subset_ball (by linarith : r / 8 ≤ r / 4) hz.1, hz.2⟩, hz.1⟩⟩
  have hDomSet : (boundaryChartCap (I := Ihalf) c (r / 4) : Set V) ∩
      ball (extChartAt Ihalf c c) (r / 8) = (D : Set V) :=
    congrArg (fun W : Opens V => (W : Set V)) hDom
  have hall : ∀ k : ℕ, ∃ T : X →L[ℝ] Wkp μ D 2 (k + 2),
      ∀ u, Wkp.value (k + 2) (T u) =ᵐ[μ.restrict (D : Set V)] A u := by
    intro k
    have horder := horders k
    rw [hDom] at horder
