    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    {z : V} (hz : z ∈ (boundaryChartCap (I := Ihalf) c r : Set V)) :
    traceCLM ℝ V (nativeChartPrincipal g c z ∘L
      iteratedGradientChain (u ∘ (extChartAt Ihalf c).symm) 1 z) =
      fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) z (nativeChartDrift g c z) +
        nativeChartPotential c q z * u ((extChartAt Ihalf c).symm z) -
        F ((extChartAt Ihalf c).symm z) := by
  have hzi := boundaryChartCap_subset_interior_target (I := Ihalf) c hrt hz
  have hzt := interior_subset hzi
  have hys := (extChartAt Ihalf c).map_target hzt
  have hround := (extChartAt Ihalf c).right_inv hzt
  have hi : (Ihalf).IsInteriorPoint ((extChartAt Ihalf c).symm z) := by
    apply ((Ihalf).isInteriorPoint_iff_of_mem_atlas one_ne_zero
      (chart_mem_atlas (EuclideanHalfSpace (n + 1)) c)
      (by simpa only [← extChartAt_source (I := Ihalf)] using hys)).2
    change extChartAt Ihalf c ((extChartAt Ihalf c).symm z) ∈
      interior (extChartAt Ihalf c).target
    rwa [hround]
