noncomputable section ProofPart_InteriorAnalytic_SmoothHolderJet




/- A fixed supplied smooth function has its actual three Holder jet
fields on the ball, without any zero-boundary restriction. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]

without_proof_info in
theorem exists_holderJet_of_local_smooth {α : ℝ≥0} (hα : α ≤ 1) (u : E → ℝ)
    (hu : ∀ x ∈ closedBall (0 : E) 1, ContDiffAt ℝ ∞ u x) :
    ∃ j : HolderJet α E, ∀ x : closedBall (0 : E) 1,
      j.1 x = u x ∧ j.2.1 x = fderiv ℝ u x ∧
        j.2.2 x = fderiv ℝ (fderiv ℝ u) x := by
  obtain ⟨K0, K1, K2, hK0, hK1, hK2⟩ :=
    exists_holderBounds_jets_of_contDiffAt_isCompact (isCompact_closedBall (0 : E) 1) hu hα
  have hc0 : ContinuousOn u (closedBall (0 : E) 1) :=
    fun x hx => (hu x hx).continuousAt.continuousWithinAt
  have hc1 : ContinuousOn (fderiv ℝ u) (closedBall (0 : E) 1) :=
    fun x hx => ((hu x hx).fderiv_right (m := ∞) (by simp)).continuousAt.continuousWithinAt
  have hc2 : ContinuousOn (fderiv ℝ (fderiv ℝ u)) (closedBall (0 : E) 1) :=
    fun x hx => (((hu x hx).fderiv_right (m := ∞) (by simp)).fderiv_right
      (m := ∞) (by simp)).continuousAt.continuousWithinAt
  refine ⟨(closedBallHolderRestriction u hc0 hK0,
    closedBallHolderRestriction (fderiv ℝ u) hc1 hK1,
    closedBallHolderRestriction (fderiv ℝ (fderiv ℝ u)) hc2 hK2), ?_⟩
  intro x
  simp only [closedBallHolderRestriction_apply, and_self]

end ConformalPoisson.DirichletHolder

end ProofPart_InteriorAnalytic_SmoothHolderJet

/- Interior analytic support: PullbackDifferenceEquation.lean, SHA256 36905e22099c9664902270b44ea9562d45e1bb6fd022e238bf601f66557f67a6 -/
noncomputable section ProofPart_InteriorAnalytic_PullbackDifferenceEquation





/- Read the actual pulled-back operator on the same smooth difference.
The fixed supplied u need not have zero boundary values. -/
open Set Metric Filter
open scoped NNReal ContDiff Topology BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem secondFDeriv_sub_at {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {f g : E → ℝ} {x : E} (hf : ContDiffAt ℝ 2 f x) (hg : ContDiffAt ℝ 2 g x) :
    fderiv ℝ (fderiv ℝ (f - g)) x = fderiv ℝ (fderiv ℝ f) x - fderiv ℝ (fderiv ℝ g) x := by
  have heq : fderiv ℝ (f - g) =ᶠ[𝓝 x] (fun y => fderiv ℝ f y - fderiv ℝ g y) := by
    filter_upwards [hf.eventually (by norm_num), hg.eventually (by norm_num)] with y hyf hyg
    exact fderiv_sub (hyf.differentiableAt (by norm_num)) (hyg.differentiableAt (by norm_num))
  rw [heq.fderiv_eq, fderiv_fun_sub
    ((hf.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num))
    ((hg.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num))]

variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F

without_proof_info in
theorem pulledBackCoordinateExpression_sub
    (A : V → V →L[ℝ] V) (b : V → V) (q χ : V → ℝ) (a : V)
    (K : V →L[ℝ] V) (f g : V → ℝ) (x : V)
    (hf : ContDiffAt ℝ 2 f x) (hg : ContDiffAt ℝ 2 g x) :
    pulledBackCoordinateExpression A b q χ a K (f - g) x =
      pulledBackCoordinateExpression A b q χ a K f x -
        pulledBackCoordinateExpression A b q χ a K g x := by
  unfold pulledBackCoordinateExpression
  rw [secondFDeriv_sub_at hf hg,
    fderiv_sub (hf.differentiableAt (by norm_num)) (hg.differentiableAt (by norm_num))]
  simp only [ContinuousLinearMap.sub_apply, Pi.sub_apply]
  rw [Finset.sum_sub_distrib]
  ring

namespace DirichletHolder

without_proof_info in
theorem pulledBackHolderOperator_eq_expression
    (A : V → V →L[ℝ] V) (b : V → V) (q χ : V → ℝ) (a : V)
    (AH : H (V →L[ℝ] V)) (BH : H V) (QH : H ℝ) (KH : H (V →L[ℝ] V))
    (CH : H (V →L[ℝ] V →L[ℝ] ℝ)) (j : HolderJet α V) (f : V → ℝ)
    (x : closedBall (0 : V) 1)
    (hA : AH x = A (localizedTranslation χ a x))
    (hB : BH x = b (localizedTranslation χ a x))
    (hQ : QH x = q (localizedTranslation χ a x))
    (hC : CH x = fderiv ℝ (fderiv ℝ χ) x)
    (hj : j.1 x = f x ∧ j.2.1 x = fderiv ℝ f x ∧
      j.2.2 x = fderiv ℝ (fderiv ℝ f) x) :
    pulledBackHolderOperator AH BH QH KH CH a j x =
      pulledBackCoordinateExpression A b q χ a (KH x) f x := by
  rw [pulledBackHolderOperator_apply, hj.1, hj.2.1, hj.2.2, hA, hB, hQ, hC]
  rfl

without_proof_info in
theorem localizedSolutionDifference_operator_equation (hα : α ≤ 1)
    (A : V → V →L[ℝ] V) (b : V → V) (q χ u : V → ℝ) (a : V)
    (hχ : ContDiff ℝ ∞ χ) (hχbound : ∀ x, ‖χ x‖ ≤ 1)
    (hu : ContDiffOn ℝ ∞ u (ball 0 3)) (ha : a ∈ ball (0 : V) 1)
    (hLu : ∀ y ∈ ball (0 : V) 3, coordinateSchrodinger A b q u y = 0)
    (AH : H (V →L[ℝ] V)) (BH : H V) (QH : H ℝ) (KH : H (V →L[ℝ] V))
    (CH : H (V →L[ℝ] V →L[ℝ] ℝ)) (j : HolderJet α V) (J : BallSpace α V ℝ)
    (hA : ∀ x : closedBall (0 : V) 1, AH x = A (localizedTranslation χ a x))
    (hB : ∀ x : closedBall (0 : V) 1, BH x = b (localizedTranslation χ a x))
    (hQ : ∀ x : closedBall (0 : V) 1, QH x = q (localizedTranslation χ a x))
    (hC : ∀ x : closedBall (0 : V) 1, CH x = fderiv ℝ (fderiv ℝ χ) x)
    (hK : ∀ x : closedBall (0 : V) 1,
      (fderiv ℝ (localizedTranslation χ a) x).comp (KH x) = ContinuousLinearMap.id ℝ V)
    (hj : ∀ x : closedBall (0 : V) 1, j.1 x = u x ∧
      j.2.1 x = fderiv ℝ u x ∧ j.2.2 x = fderiv ℝ (fderiv ℝ u) x)
    (hJ : ∀ x : closedBall (0 : V) 1,
      J.val.1 x = localizedSolutionDifference χ u a x ∧
      J.val.2.1 x = fderiv ℝ (localizedSolutionDifference χ u a) x ∧
      J.val.2.2 x = fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u a)) x) :
    pulledBackBallOperator hα AH BH QH KH CH a J =
      -(pulledBackHolderOperator AH BH QH KH CH a j) := by
  apply eq_neg_iff_add_eq_zero.2
  apply TauCeti.HolderSpace.ext
  intro x
  simp only [TauCeti.HolderSpace.add_apply, TauCeti.HolderSpace.zero_apply]
  have hJread : (ballHolderJetL hα J).1 x = localizedSolutionDifference χ u a x ∧
      (ballHolderJetL hα J).2.1 x = fderiv ℝ (localizedSolutionDifference χ u a) x ∧
      (ballHolderJetL hα J).2.2 x =
        fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u a)) x := by
    simpa [ballHolderJetL] using hJ x
  change pulledBackHolderOperator AH BH QH KH CH a (ballHolderJetL hα J) x +
    pulledBackHolderOperator AH BH QH KH CH a j x = 0
  rw [pulledBackHolderOperator_eq_expression A b q χ a AH BH QH KH CH
    (ballHolderJetL hα J) (localizedSolutionDifference χ u a) x
    (hA x) (hB x) (hQ x) (hC x) hJread,
    pulledBackHolderOperator_eq_expression A b q χ a AH BH QH KH CH j u x
      (hA x) (hB x) (hQ x) (hC x) (hj x)]
  have hx2 : (x : V) ∈ ball 0 2 :=
    closedBall_subset_ball (by norm_num : (1 : ℝ) < 2) x.property
  have hx3 : (x : V) ∈ ball 0 3 := ball_subset_ball (by norm_num : (2 : ℝ) ≤ 3) hx2
  have hPhi3 := localizedTranslation_mem_ball_three χ hχbound ha hx2
  have hux : ContDiffAt ℝ 2 u (x : V) :=
    ((hu x hx3).contDiffAt (isOpen_ball.mem_nhds hx3)).of_le (by simp)
  have hup : ContDiffAt ℝ 2 u (localizedTranslation χ a x) :=
    ((hu _ hPhi3).contDiffAt (isOpen_ball.mem_nhds hPhi3)).of_le (by simp)
  have hχx : ContDiffAt ℝ 2 χ (x : V) := hχ.contDiffAt.of_le (by simp)
  have hPhi : ContDiffAt ℝ 2 (localizedTranslation χ a) (x : V) :=
    contDiffAt_id.add (hχx.smul contDiffAt_const)
  have hcomp : ContDiffAt ℝ 2 (u ∘ localizedTranslation χ a) (x : V) := hup.comp (x : V) hPhi
  change pulledBackCoordinateExpression A b q χ a (KH x)
      ((u ∘ localizedTranslation χ a) - u) x +
    pulledBackCoordinateExpression A b q χ a (KH x) u x = 0
  rw [pulledBackCoordinateExpression_sub A b q χ a (KH x)
    (u ∘ localizedTranslation χ a) u x hcomp hux, sub_add_cancel]
  exact (pulledBackCoordinateExpression_comp A b q χ u a x (KH x) hχx hup (hK x)).trans
    (hLu _ hPhi3)

end DirichletHolder
end ConformalPoisson

end ProofPart_InteriorAnalytic_PullbackDifferenceEquation

/- Interior analytic support: LocalInteriorAnalytic.lean, SHA256 aef31133ee193de4e91ff88dd8129c469377fb52bc931be027e821693dabb1c3 -/
noncomputable section ProofPart_InteriorAnalytic_LocalInteriorAnalytic






/- The local scalar analytic-regularity argument. The explicit inverse
here is the actual preconditioned zero-Dirichlet operator at zero translation;
its production from normalized small coefficients remains a downstream caller
obligation, rather than a new premise of the selected native theorem. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder

def interiorFiniteCoordinates (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] : E ≃L[ℝ] (Fin (Module.finrank ℝ E) → ℝ) :=
  (Module.finBasis ℝ E).equivFun.toContinuousLinearEquiv

variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "BX" => BallSpace α V ℝ

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem analyticAt_of_local_schrodinger_inverse (hα : α ≤ 1)
    (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ)
    (hA : AnalyticOnNhd ℝ A (ball 0 3)) (hb : AnalyticOnNhd ℝ b (ball 0 3))
    (hq : AnalyticOnNhd ℝ q (ball 0 3)) (hu : ContDiffOn ℝ ∞ u (ball 0 3))
    (hLu : ∀ x ∈ ball (0 : V) 3, coordinateSchrodinger A b q u x = 0)
    (A0 : H (V →L[ℝ] V)) (B0 : H V) (Q0 : H ℝ)
    (hA0 : ∀ x : closedBall (0 : V) 1, A0 x = A x)
    (hB0 : ∀ x : closedBall (0 : V) 1, B0 x = b x)
    (hQ0 : ∀ x : closedBall (0 : V) 1, Q0 x = q x)
    (T : (H ℝ) →L[ℝ] BX) (hinv : (T.comp (ballSchrodinger hα A0 B0 Q0)).IsInvertible) :
    AnalyticAt ℝ u 0 := by
  obtain ⟨χ, hχ, hχbound, hχnear, hχsphere⟩ := exists_localizedTranslation_cutoff (E := V)
  have hχ0 : χ 0 = 1 := hχnear.self_of_nhds
  have hK3 : closedBall (0 : V) 1 ⊆ ball 0 3 :=
    closedBall_subset_ball (by norm_num : (1 : ℝ) < 3)
  let TC := interiorFiniteCoordinates V
  let SC := interiorFiniteCoordinates (V →L[ℝ] V)
  obtain ⟨UA, AH, hUA, h0A, hAH, hAHeq⟩ :=
    exists_finite_analytic_localized_holder_family hα TC SC A χ
      (hχ.of_le (by simp)) isOpen_ball hK3 hA
  obtain ⟨UB, BH, hUB, h0B, hBH, hBHeq⟩ :=
    exists_finite_analytic_localized_holder_family hα TC TC b χ
      (hχ.of_le (by simp)) isOpen_ball hK3 hb
  obtain ⟨UQ, QH, hUQ, h0Q, hQH, hQHeq⟩ :=
    exists_real_analytic_localized_holder_family hα TC q χ
      (hχ.of_le (by simp)) isOpen_ball hK3 hq
  obtain ⟨jχ, hjχ⟩ := exists_holderJet_of_local_smooth hα χ
    (fun x hx => hχ.contDiffAt)
  let η := jχ.2.1
  let C := jχ.2.2
  let KH : V → H (V →L[ℝ] V) := holderTranslationInverseJacobian η
  have hKH : AnalyticAt ℝ KH 0 := analyticAt_holderTranslationInverseJacobian η
  have hKH0 : KH 0 = 1 := by
    simp [KH, holderTranslationInverseJacobian]
  have hAH0 : AH 0 = A0 := by
    apply TauCeti.HolderSpace.ext
    intro x
    rw [hAHeq 0 h0A x, hA0 x]
    simp
  have hBH0 : BH 0 = B0 := by
    apply TauCeti.HolderSpace.ext
    intro x
    rw [hBHeq 0 h0B x, hB0 x]
    simp
  have hQH0 : QH 0 = Q0 := by
    apply TauCeti.HolderSpace.ext
    intro x
    rw [hQHeq 0 h0Q x, hQ0 x]
    simp
  obtain ⟨ju, hju⟩ := exists_holderJet_of_local_smooth hα u
    (fun x hx => (hu x (hK3 hx)).contDiffAt (isOpen_ball.mem_nhds (hK3 hx)))
  obtain ⟨J, hJ, hJeq⟩ := exists_localizedSolutionDifference_ballJets hα χ u hχ hχbound
    hχsphere hu
  have hJcont : ContinuousAt J (0 : V) :=
    hJ.continuousAt (isOpen_ball.mem_nhds (mem_ball_self zero_lt_one))
  let Lall : V → HolderJet α V →L[ℝ] H ℝ :=
    fun a => pulledBackHolderOperator (AH a) (BH a) (QH a) (KH a) C a
  let Lball : V → BX →L[ℝ] H ℝ :=
    fun a => pulledBackBallOperator hα (AH a) (BH a) (QH a) (KH a) C a
  have hLall : AnalyticAt ℝ Lall 0 :=
    analyticAt_pulledBackHolderOperator (hAH 0 h0A) (hBH 0 h0B) (hQH 0 h0Q)
      hKH analyticAt_id C
  have hLball : AnalyticAt ℝ Lball 0 :=
    analyticAt_pulledBackBallOperator hα (hAH 0 h0A) (hBH 0 h0B) (hQH 0 h0Q)
      hKH analyticAt_id C
  let P : V → BX →L[ℝ] BX := fun a => T.comp (Lball a)
  let CP : (BX →L[ℝ] H ℝ) →L[ℝ] (BX →L[ℝ] BX) :=
    (ContinuousLinearMap.compL ℝ BX (H ℝ) BX) T
  have hP : AnalyticAt ℝ P 0 := (CP.analyticAt _).comp hLball
  have hL0 : Lball 0 = ballSchrodinger hα A0 B0 Q0 := by
    dsimp only [Lball]
    rw [hAH0, hBH0, hQH0, hKH0]
    exact pulledBackBallOperator_at_zero hα A0 B0 Q0 C
  have hPinv : (P 0).IsInvertible := by
    change (T.comp (Lball 0)).IsInvertible
    rwa [hL0]
  let evj : (HolderJet α V →L[ℝ] H ℝ) →L[ℝ] H ℝ := ContinuousLinearMap.apply ℝ (H ℝ) ju
  let F : V → BX := fun a => -(T (Lall a ju))
  have hforce : AnalyticAt ℝ (fun a => Lall a ju) 0 := (evj.analyticAt _).comp hLall
  have hF : AnalyticAt ℝ F 0 := ((T.analyticAt _).comp hforce).neg
  have heq : ∀ᶠ a in 𝓝 (0 : V), P a (J a) = F a := by
    filter_upwards [hUA.mem_nhds h0A, hUB.mem_nhds h0B, hUQ.mem_nhds h0Q,
