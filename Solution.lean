    analyticAt_closedSubspace (c1BallGraph (V := V) (F := F))
      isClosed_c1BallGraph hU hg hp
  have hreal : AnalyticAt ℝ g p := hcomplex.restrictScalars
  exact ((c1BallHolderL (V := V) (F := F) hα).analyticAt _).comp hreal

