local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def supportedNativeCoordinateFlux (g : Metric (n := n) (M := M)) (α : M)
    (X : (x : M) → TangentSpace Ihalf x) : V → V :=
  (extChartAt Ihalf α).target.indicator (nativeCoordinateFlux g α X)

without_proof_info in
theorem supportedNativeCoordinateFlux_eq_zero (g : Metric (n := n) (M := M)) (α : M)
    (X : (x : M) → TangentSpace Ihalf x) {z : V}
    (hz : z ∉ extChartAt Ihalf α '' tsupport (α := V) X) :
    supportedNativeCoordinateFlux g α X z = 0 := by
  by_cases ht : z ∈ (extChartAt Ihalf α).target
  · have hX : X ((extChartAt Ihalf α).symm z) = 0 :=
      image_eq_zero_of_notMem_tsupport (α := V) (fun h => hz ⟨_, h, (extChartAt Ihalf α).right_inv ht⟩)
    simp only [supportedNativeCoordinateFlux, indicator_of_mem ht, nativeCoordinateFlux, hX, map_zero, smul_zero]
  · exact indicator_of_notMem ht _

without_proof_info in
theorem supportedNativeCoordinateFlux_hasCompactSupport
    (g : Metric (n := n) (M := M)) (α : M)
    (X : (x : M) → TangentSpace Ihalf x)
    (hK : IsCompact (tsupport (α := V) X))
    (hKs : tsupport (α := V) X ⊆ (extChartAt Ihalf α).source) :
