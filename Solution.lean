  exact integral_carleman_schrodinger_coercivity_of_tsupport_subset hφ hq hv hvc
    (S := Set.univ) (Set.subset_univ _) hτ hc hd hgap hlarge hQ hlargeQ
    (fun x _ => hqbound x) (fun x _ ξ => hHess x ξ) (fun x _ => hNormal x)
    (fun x _ => hGrad x) (fun x _ => hBiLap x)

without_proof_info in
theorem exists_uniform_carleman_schrodinger_parameter_on {φ q : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hq : Continuous q)
    (S : Set M)
    {c h w d Q : ℝ} (hc : 0 ≤ c) (hd : 0 ≤ d) (hgap : 0 < h - c * w)
