theorem exists_boundaryTranslation_cutoff :
    ∃ χ : V → ℝ, ContDiff ℝ ∞ χ ∧ (∀ x, ‖χ x‖ ≤ 1) ∧
      (∀ᶠ x in nhds (0 : V), χ x = 1) ∧
      (∀ x ∈ sphere (0 : V) 1, χ x = 0) ∧
