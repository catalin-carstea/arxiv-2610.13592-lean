/- The actual signed native energy paired with a compact interior-chart
test. This is Green's first identity only for interior-supported tests;
no surface flux formula or boundaryless instance is asserted. -/
open Bundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem native_interior_chart_energy_pairing
    (g : Metric (n := n) (M := M)) (q u ψ : M → ℝ) (hq : Continuous q)
    (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) (hψ : ContMDiff Ihalf 𝓘(ℝ) ∞ ψ)
    (c : M) (hs : tsupport ψ ⊆ (chartAt (EuclideanHalfSpace (n + 1)) c).source)
    (hi : extChartAt Ihalf c '' tsupport ψ ⊆ interior (extChartAt Ihalf c).target) :
    letI : RiemannianBundle (fun y : M => TangentSpace Ihalf y) := ⟨g.toRiemannianMetric⟩
    letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun y : M => TangentSpace Ihalf y) :=
      IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
    (∫ y, (⟪mgradient Ihalf u y, mgradient Ihalf ψ y⟫_ℝ + q y * u y * ψ y) ∂nativeVolume g) =
      ∫ y, ψ y * schrodinger g q u y ∂nativeVolume g := by
  letI : RiemannianBundle (fun y : M => TangentSpace Ihalf y) := ⟨g.toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun y : M => TangentSpace Ihalf y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  letI : ContMDiffVectorBundle 1 V (TangentSpace Ihalf : M → Type _) Ihalf :=
    TangentBundle.contMDiffVectorBundle
  letI : IsContinuousRiemannianBundle V (fun y : M => TangentSpace Ihalf y) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  letI : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  have hgreen := integral_mul_laplaceBeltrami_of_interior_chart c
    (hψ.of_le (by simp)) (hu.of_le (by simp)) hs hi
  change (∫ y, ψ y * laplaceBeltrami Ihalf u y ∂nativeVolume g) =
    -∫ y, ⟪mgradient Ihalf ψ y, mgradient Ihalf u y⟫_ℝ ∂nativeVolume g at hgreen
  have hlap : Integrable (fun y => ψ y * laplaceBeltrami Ihalf u y) (nativeVolume g) :=
    (hψ.continuous.mul (continuous_laplaceBeltrami (hu.of_le (by simp)))).integrable_of_compactSpace
  have hgrad : Integrable (fun y => ⟪mgradient Ihalf u y, mgradient Ihalf ψ y⟫_ℝ) (nativeVolume g) :=
    (continuous_inner_mgradient (hu.of_le (by simp)) (hψ.of_le (by simp))).integrable_of_compactSpace
  have hpot : Integrable (fun y => q y * u y * ψ y) (nativeVolume g) :=
    ((hq.mul hu.continuous).mul hψ.continuous).integrable_of_compactSpace
  have hinner : (fun y => ⟪mgradient Ihalf ψ y, mgradient Ihalf u y⟫_ℝ) =
      (fun y => ⟪mgradient Ihalf u y, mgradient Ihalf ψ y⟫_ℝ) :=
    funext fun y => real_inner_comm _ _
  rw [hinner] at hgreen
  calc
    _ = (∫ y, ⟪mgradient Ihalf u y, mgradient Ihalf ψ y⟫_ℝ ∂nativeVolume g) +
        ∫ y, q y * u y * ψ y ∂nativeVolume g := integral_add hgrad hpot
    _ = -(∫ y, ψ y * laplaceBeltrami Ihalf u y ∂nativeVolume g) +
        ∫ y, q y * u y * ψ y ∂nativeVolume g := by linarith only [hgreen]
    _ = ∫ y, -(ψ y * laplaceBeltrami Ihalf u y) + q y * u y * ψ y ∂nativeVolume g := by
      have h := (integral_add hlap.neg hpot).symm
      simpa only [Pi.neg_apply, integral_neg] using h
    _ = _ := by
      apply integral_congr_ae
      filter_upwards with y
      dsimp only [schrodinger]
      ring

end ConformalPoisson

