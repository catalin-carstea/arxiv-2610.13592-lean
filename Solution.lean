noncomputable section ProofPart_GreenTrace_NativeWeakGreenRows





/- Actual native weak Green rows and normal rows, constructed from the inverse.
Their representation is independent of a chosen smooth solver. Pointwise joint
off-diagonal regularity is a further obligation, not a field assumed here. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

structure NativeInverseLpRowFamily (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (s : ℝ≥0∞) where
  row : M → Lp ℝ s (nativeVolume g)
  uniform_bound : ∃ C ≥ 0, ∀ x, ‖row x‖ ≤ C
  representation : ∀ x, ∀ F : C^∞⟮Ihalf, M; ℝ⟯, ∀ u : M → ℝ,
    IsZeroDirichletSolution g q F u →
      Integrable (fun z => row x z * F z) (nativeVolume g) ∧
      u x = ∫ z, row x z * F z ∂nativeVolume g

structure NativeInverseNormalLpRowFamily (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (Ihalf).boundary M) → TangentSpace Ihalf (y : M)) (s : ℝ≥0∞) where
  row : (Ihalf).boundary M → Lp ℝ s (nativeVolume g)
  uniform_bound : ∃ C ≥ 0, ∀ y, ‖row y‖ ≤ C
  representation : ∀ y, ∀ F : C^∞⟮Ihalf, M; ℝ⟯, ∀ u : M → ℝ,
    IsZeroDirichletSolution g q F u →
      Integrable (fun z => row y z * F z) (nativeVolume g) ∧
      normalDerivative ν u y = ∫ z, row y z * F z ∂nativeVolume g

without_proof_info in
theorem nonempty_nativeInverseLpRowFamily
    {r : ℝ≥0} {s : ℝ≥0∞} [Fact (1 ≤ (r : ℝ≥0∞))] [Fact (1 ≤ s)]
    [s.HolderConjugate (r : ℝ≥0∞)]
    (hr : (n + 1 : ℝ≥0) < r) (hp : 2 < (r : ℝ≥0∞))
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) :
    Nonempty (NativeInverseLpRowFamily g q s) := by
  obtain ⟨C, hC, h⟩ := exists_native_inverse_lp_rows hr hp g q hq hNR (s := s)
  choose row hrow hrep using h
  exact ⟨⟨row, ⟨C, hC, hrow⟩, hrep⟩⟩

without_proof_info in
theorem nonempty_nativeInverseNormalLpRowFamily
    (hn : 1 ≤ n) {r : ℝ≥0} {s : ℝ≥0∞} [Fact (1 ≤ (r : ℝ≥0∞))] [Fact (1 ≤ s)]
    [s.HolderConjugate (r : ℝ≥0∞)] (hr : (n + 1 : ℝ≥0) < r)
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (ν : (y : (Ihalf).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y)) :
    Nonempty (NativeInverseNormalLpRowFamily g q ν s) := by
  obtain ⟨C, hC, h⟩ := exists_native_inverse_normal_lp_rows hn hr g q hq hNR ν hν (s := s)
  choose row hrow hrep using h
  exact ⟨⟨row, ⟨C, hC, hrow⟩, hrep⟩⟩

without_proof_info in
theorem NativeInverseLpRowFamily.weak_equation
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseLpRowFamily g q s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (x : M) (u : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hu0 : ∀ y : (Ihalf).boundary M, u y = 0) :
    Integrable (fun z => K.row x z * schrodinger g q u z) (nativeVolume g) ∧
      (∫ z, K.row x z * schrodinger g q u z ∂nativeVolume g) = u x := by
  obtain ⟨hint, heq⟩ := K.representation x
    ⟨schrodinger g q u, contMDiff_schrodinger g q u hq hu⟩ u ⟨hu, fun _ _ => rfl, hu0⟩
  exact ⟨hint, heq.symm⟩

without_proof_info in
theorem NativeInverseLpRowFamily.boundary_row_eq_zero
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
    (K : NativeInverseLpRowFamily g q s)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hp : p ≠ (⊤ : ℝ≥0∞)) (y : (Ihalf).boundary M) : K.row y = 0 :=
  native_inverse_boundary_lp_row_eq_zero g q hq hNR hp y (K.row y)
    (fun F u hu => (K.representation y F u hu).2)

without_proof_info in
theorem NativeInverseNormalLpRowFamily.weak_equation
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseNormalLpRowFamily g q ν s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (y : (Ihalf).boundary M) (u : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hu0 : ∀ z : (Ihalf).boundary M, u z = 0) :
    Integrable (fun z => K.row y z * schrodinger g q u z) (nativeVolume g) ∧
      (∫ z, K.row y z * schrodinger g q u z ∂nativeVolume g) = normalDerivative ν u y := by
  obtain ⟨hint, heq⟩ := K.representation y
    ⟨schrodinger g q u, contMDiff_schrodinger g q u hq hu⟩ u ⟨hu, fun _ _ => rfl, hu0⟩
  exact ⟨hint, heq.symm⟩

without_proof_info in
theorem NativeInverseLpRowFamily.row_unique
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
    (K L : NativeInverseLpRowFamily g q s)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hp : p ≠ (⊤ : ℝ≥0∞)) (x : M) : K.row x = L.row x := by
  apply native_lp_rows_eq_of_smooth_moments g hp
  intro F
  obtain ⟨u, hu⟩ := exists_zeroDirichletSolution g q hq hNR F F.contMDiff
  exact (K.representation x F u hu).2.symm.trans (L.representation x F u hu).2

without_proof_info in
theorem NativeInverseNormalLpRowFamily.row_unique
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
    (K L : NativeInverseNormalLpRowFamily g q ν s)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hp : p ≠ (⊤ : ℝ≥0∞)) (y : (Ihalf).boundary M) : K.row y = L.row y := by
  apply native_lp_rows_eq_of_smooth_moments g hp
  intro F
  obtain ⟨u, hu⟩ := exists_zeroDirichletSolution g q hq hNR F F.contMDiff
  exact (K.representation y F u hu).2.symm.trans (L.representation y F u hu).2

without_proof_info in
theorem NativeInverseNormalLpRowFamily.row_ne_zero
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    [Fact (1 ≤ s)]
    (K : NativeInverseNormalLpRowFamily g q ν s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y)) (y : (Ihalf).boundary M) : K.row y ≠ 0 := by
  intro hk
  obtain ⟨w, hw, hw0, hwn⟩ := exists_zero_boundary_normal_ne_zero ν y (hν y).1
  have heq := (K.weak_equation hq y w hw hw0).2
  have hAE : (fun z => K.row y z * schrodinger g q w z) =ᵐ[nativeVolume g]
      (fun _ => (0 : ℝ)) := by
    rw [hk]
    filter_upwards [Lp.coeFn_zero ℝ s (nativeVolume g)] with z hz
    exact congrArg (fun a => a * schrodinger g q w z) hz |>.trans (zero_mul _)
  have hzero : (∫ z, K.row y z * schrodinger g q w z ∂nativeVolume g) = 0 :=
    (integral_congr_ae hAE).trans (integral_zero M ℝ)
  exact hwn (heq.symm.trans hzero)

end ConformalPoisson

end ProofPart_GreenTrace_NativeWeakGreenRows

