/- Pointwise existence of the actual metric unit normal. Choosing these
vectors on the boundary needs no extra regularity or existence premise. -/
open Bundle Set
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem nativeNegativeUnitGradient_isOutwardUnitNormal
    (g : Metric (n := n) (M := M)) (x : (𝓡∂ (n + 1)).boundary M) :
    IsOutwardUnitNormal g x
      (nativeNegativeUnitGradient g (chartBoundaryFunction (n := n) (x : M)) x) := by
  let : RiemannianBundle (fun z : M => TangentSpace (𝓡∂ (n + 1)) z) := ⟨g.toRiemannianMetric⟩
  let f := chartBoundaryFunction (n := n) (x : M)
  let G := TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) f (x : M)
  have hdf (v : TangentSpace (𝓡∂ (n + 1)) (x : M)) :
      mvfderiv (𝓡∂ (n + 1)) f x v =
        (show EuclideanSpace ℝ (Fin (n + 1)) from v) 0 := by
    rw [mvfderiv_chartBoundaryFunction (x : M) (mem_chart_source _ _),
      tangentCoordChange_self (mem_extChartAt_source (I := 𝓡∂ (n + 1)) (x : M))]
  have hG : G ≠ 0 := by
    intro hz
    have h := TauCeti.Manifold.inner_mgradient (I := 𝓡∂ (n + 1)) (f := f) (x := (x : M))
      (show TangentSpace (𝓡∂ (n + 1)) (x : M) from EuclideanSpace.single 0 1)
    change inner ℝ G _ = _ at h
    rw [hz, inner_zero_left, hdf] at h
    simpa using h
  change TauCeti.IsOutwardPointing (x : M) (-NormedSpace.normalize G) ∧
    g.inner x (-NormedSpace.normalize G) (-NormedSpace.normalize G) = 1 ∧
    ∀ w : TangentSpace (𝓡 n) x, g.inner x (-NormedSpace.normalize G)
      (mfderiv (𝓡 n) (𝓡∂ (n + 1)) (fun y : (𝓡∂ (n + 1)).boundary M => (y : M)) x w) = 0
  refine ⟨?_, ?_, ?_⟩
  · rw [TauCeti.isOutwardPointing_iff_tangentCoordChange x.property
      (mem_extChartAt_source (I := 𝓡∂ (n + 1)) (x : M)),
      tangentCoordChange_self (mem_extChartAt_source (I := 𝓡∂ (n + 1)) (x : M))]
    rw [← hdf, map_neg, TauCeti.Manifold.mvfderiv_normalize_mgradient]
    exact neg_neg_of_pos (norm_pos_iff.mpr hG)
  · change inner ℝ (-NormedSpace.normalize G) (-NormedSpace.normalize G) = 1
    rw [inner_neg_neg, real_inner_self_eq_norm_sq, NormedSpace.norm_normalize hG]
    norm_num
  · intro w
    change inner ℝ (-NormedSpace.normalize G)
      (mfderiv (𝓡 n) (𝓡∂ (n + 1)) Subtype.val x w) = 0
    rw [inner_neg_left, TauCeti.Manifold.inner_normalize_mgradient, hdf,
      TauCeti.mfderiv_subtypeVal_boundary]
    have hz : ((TauCeti.euclideanHalfSpaceBoundaryParam n) w).ofLp 0 = 0 :=
      TauCeti.euclideanHalfSpaceBoundaryParam_apply_zero
        (show EuclideanSpace ℝ (Fin n) from w)
    change -(‖G‖⁻¹ * ((TauCeti.euclideanHalfSpaceBoundaryParam n) w).ofLp 0) = 0
    rw [hz, mul_zero, neg_zero]

end ConformalPoisson

