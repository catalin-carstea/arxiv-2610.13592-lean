  · exact mul_le_mul hτ hn (norm_nonneg _) hE
  · exact fun i j => mul_le_mul (hA i j) (ht j) (norm_nonneg _) hE
  · exact fun i => mul_le_mul (hc i) hv (norm_nonneg _) hE
  · exact fun i j => mul_le_mul (hA i j) (htt i j) (norm_nonneg _) hE
