    constructor
    · rintro ⟨⟨hxΩ, hxt⟩, _⟩
      have hxR : x ∈ (Ω : Set P) ∩ ball x₀ R := ⟨hxΩ, ball_subset_ball htR hxt⟩
      rw [hmatch] at hxR
      exact ⟨hxR.1, hxt⟩
    · intro hx
      have hxR : x ∈ (normalHalfSpace (E := E) a : Set P) ∩ ball x₀ R := ⟨hx.1, ball_subset_ball htR hx.2⟩
      rw [← hmatch] at hxR
      exact ⟨⟨hxR.1, hx.2⟩, hx.2⟩
  have hft : MemLp f p ((volume : Measure P).restrict Ωt) :=
    hf.mono_measure (Measure.restrict_mono htRsub le_rfl)
  have hveq : ∀ᵐ x ∂(volume : Measure P).restrict Ωt,
      traceCLM ℝ P (A x ∘L Wkp.iteratedGradient 1 v x) = hft.toLp f x := by
    filter_upwards [Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 1 u,
      hft.coeFn_toLp, ae_restrict_of_ae_restrict_of_subset htRsub heq] with x h1 h2 h3
    rw [h1, h2, h3]
  have hv0 : ∃ z : W1p0 (volume : Measure P) Ωt p,
      W1p.value (z : W1p volume Ωt p) =ᵐ[(volume : Measure P).restrict Ωt]
        (fun x => ζ x * Wkp.value 2 v x) := by
    refine ⟨⟨Wkp.firstOrder 1 wR, hwr0⟩, ?_⟩
    rw [Wkp.value_firstOrder]
    exact hwr
  have key := hloc a hlam hA₀ hΩt hζ hζc hζBt hζg hζh
    (hAm.mono_measure (Measure.restrict_mono htRsub le_rfl)) hε
    ((ae_restrict_of_ae_restrict_of_subset htRsub hA).mono fun x hx _ => hx) hΛ
    ((ae_restrict_of_ae_restrict_of_subset htRsub hAΛ).mono fun x hx _ => hx) v (hft.toLp f) hv0 hveq
  have hζH : MemLp (fun x => ζ x • Wkp.iteratedGradient 1 v x) p ((volume : Measure P).restrict Ωt) :=
    (hζ.continuous.memLp_top_of_hasCompactSupport hζc _).smul (Lp.memLp _)
  have hlow : lpNorm (Wkp.iteratedGradient 1 u) p ((volume : Measure P).restrict S) ≤
      lpNorm (fun x => ζ x • Wkp.iteratedGradient 1 v x) p ((volume : Measure P).restrict Ωt) := by
    have hae : (Wkp.iteratedGradient 1 u : P → _) =ᵐ[(volume : Measure P).restrict S]
        (fun x => ζ x • Wkp.iteratedGradient 1 v x) := by
      filter_upwards [ae_restrict_of_ae_restrict_of_subset hSt
        (Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 1 u),
        ae_restrict_mem (Ω.isOpen.inter isOpen_ball).measurableSet] with x h1 hx
      rw [hζone (ball_subset_closedBall hx.2), h1, Pi.one_apply, one_smul]
    rw [← toReal_eLpNorm, eLpNorm_congr_ae hae]
    exact ENNReal.toReal_mono hζH.eLpNorm_ne_top
      (eLpNorm_mono_measure _ (Measure.restrict_mono hSt le_rfl))
  have hfb : lpNorm (fun x => ζ x * hft.toLp f x) p ((volume : Measure P).restrict Ωt) ≤
      lpNorm f p ((volume : Measure P).restrict Ωt) := by
    refine ENNReal.toReal_mono hft.eLpNorm_ne_top (eLpNorm_mono_ae
      (hζ.continuous.aestronglyMeasurable.mul (Lp.aestronglyMeasurable _)) ?_)
    filter_upwards [hft.coeFn_toLp] with x hx
    rw [hx, norm_mul, Real.norm_eq_abs]
    exact mul_le_of_le_one_left (norm_nonneg _) (hζabs x)
  have hng : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ =
      lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p ((volume : Measure P).restrict Ωt) := by
    rw [show v = Wkp.restrictL (inf_le_left : Ωt ≤ Ω) 2 u from rfl, Wkp.lowerOrder_restrictL]
    exact Lp.norm_eq_lpNorm_of_ae_eq (Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 0 (Wkp.lowerOrder 1 u))
  have hnv : ‖Wkp.value 2 v‖ ≤ lpNorm (Wkp.value 2 u) p
      ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := by
    rw [Lp.norm_eq_lpNorm_of_ae_eq (Wkp.value_restrictL_ae (inf_le_left : Ωt ≤ Ω) 2 u)]
    exact lpNorm_mono_measure
      ((Lp.memLp (Wkp.value 2 u)).mono_measure (Measure.restrict_mono
        (fun (x : P) (hx : x ∈ (Ω : Set P) ∩ ball x₀ R) => hx.1) le_rfl))
      (Measure.restrict_mono htRsub le_rfl)
  have hmr : m - r = (t - r) / 2 := by dsimp [m]; ring
  have hm1 : 2 * (c₀ / (m - r)) = 4 * c₀ / (t - r) := by rw [hmr]; field_simp; ring
  have hm2 : c₀ / (m - r) ^ 2 = 4 * c₀ / (t - r) ^ 2 := by rw [hmr]; field_simp; ring
  rw [hm1, hm2, hng] at key
  change lpNorm (Wkp.iteratedGradient 1 u) p ((volume : Measure P).restrict S) ≤
    (C : ℝ) / lam * lpNorm f p ((volume : Measure P).restrict Ωt) +
    ((C : ℝ) / lam * finrank ℝ P * Λ + 1) *
      (4 * c₀ / (t - r) * lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p
        ((volume : Measure P).restrict Ωt) +
      4 * c₀ / (t - r) ^ 2 * lpNorm (Wkp.value 2 u) p
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)))
  calc
    _ ≤ _ := hlow
    _ ≤ _ := key
    _ ≤ _ := by gcongr

end ConformalPoisson

end ProofPart_GreenTrace_HalfBallHessianLocalization

/- Green/trace proof support: StrongLowerOrderLpBound.lean, SHA256 3aa3f179ba71475996976e2efc3d6704b2f1edef44268fb376659b68cba0dfb6 -/
noncomputable section ProofPart_GreenTrace_StrongLowerOrderLpBound




/- Bounded lower-order terms for the strong local equation. Adapted from
the private helper in pinned Tau Ceti Analysis/PDE/Regularity/Hessian/Interior.lean
(Apache 2.0, External/LICENSE.tauceti), with a general inner-product model
so that the SAME proof applies to boundary normal-product coordinates. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti
open scoped ENNReal InnerProductSpace
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {p : ℝ≥0∞} [Fact (1 ≤ p)]

without_proof_info in
theorem strong_lowerOrder_memLp_and_bound {Ω : Opens E} {S : Set E} (hS : S ⊆ Ω)
    (u : Wkp μ Ω p 2) {b : E → E} {c : E → ℝ} {β γ : ℝ}
    (hb : AEStronglyMeasurable b (μ.restrict S)) (hbβ : ∀ᵐ x ∂μ.restrict S, ‖b x‖ ≤ β)
    (hc : AEStronglyMeasurable c (μ.restrict S)) (hcγ : ∀ᵐ x ∂μ.restrict S, |c x| ≤ γ) :
    MemLp (fun x => ⟪b x, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ +
      c x * Wkp.value 2 u x) p (μ.restrict S) ∧
    lpNorm (fun x => ⟪b x, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ +
      c x * Wkp.value 2 u x) p (μ.restrict S) ≤
      β * lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p (μ.restrict S) +
        γ * lpNorm (Wkp.value 2 u) p (μ.restrict S) := by
  let G := Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)
  let V := Wkp.value 2 u
  have hG : MemLp G p (μ.restrict S) := (Lp.memLp G).mono_measure (Measure.restrict_mono hS le_rfl)
  have hV : MemLp V p (μ.restrict S) := (Lp.memLp V).mono_measure (Measure.restrict_mono hS le_rfl)
  have hdm : AEStronglyMeasurable (fun x => ⟪b x, G x⟫_ℝ) (μ.restrict S) := hb.inner hG.aestronglyMeasurable
  have hzm : AEStronglyMeasurable (fun x => c x * V x) (μ.restrict S) := hc.mul hV.aestronglyMeasurable
  have hdle : ∀ᵐ x ∂μ.restrict S, ‖⟪b x, G x⟫_ℝ‖ ≤ β * ‖G x‖ := hbβ.mono fun x hx => by
    rw [Real.norm_eq_abs]
    exact (abs_real_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right hx (norm_nonneg _))
  have hzle : ∀ᵐ x ∂μ.restrict S, ‖c x * V x‖ ≤ γ * ‖V x‖ := hcγ.mono fun x hx => by
    rw [norm_mul, Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_right hx (norm_nonneg _)
  have hd : MemLp (fun x => ⟪b x, G x⟫_ℝ) p (μ.restrict S) := hG.of_le_mul hdm hdle
  refine ⟨hd.add (hV.of_le_mul hzm hzle), (lpNorm_add_le hd Fact.out).trans ?_⟩
  exact add_le_add (lpNorm_le_mul_lpNorm_of_ae_le_mul hdm hG hdle)
    (lpNorm_le_mul_lpNorm_of_ae_le_mul hzm hV hzle)

end ConformalPoisson

end ProofPart_GreenTrace_StrongLowerOrderLpBound

/- Green/trace proof support: HalfBallHomogeneousEstimate.lean, SHA256 3a8525cde39794c6cc08dee0e75dad9d4fb879e2d72e51cce1dd899849c7ab9b -/
noncomputable section ProofPart_GreenTrace_HalfBallHomogeneousEstimate




/- The local boundary Hessian estimate needed for homogeneous Green rows.
The constant is chosen BEFORE the function. Lower-order coefficients may
have either sign. No sharp constant or inhomogeneous extension is claimed. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti Module Metric
open scoped ENNReal NNReal InnerProductSpace ContDiff Gradient
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "P" => WithLp 2 (ℝ × E)

without_proof_info in
theorem halfBall_lpNorm_mono_radius {Ω : Opens P} {x₀ : P} {r R : ℝ}
    {F : Type*} [NormedAddCommGroup F]
    (w : Lp F p ((volume : Measure P).restrict Ω)) (hrR : r ≤ R) :
    lpNorm w p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
      lpNorm w p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := by
  exact lpNorm_mono_measure
    ((Lp.memLp w).mono_measure (Measure.restrict_mono
      (fun (x : P) (hx : x ∈ (Ω : Set P) ∩ ball x₀ R) => hx.1) le_rfl))
    (Measure.restrict_mono
      (show (Ω : Set P) ∩ ball x₀ r ⊆ (Ω : Set P) ∩ ball x₀ R from
        fun x hx => ⟨hx.1, ball_subset_ball hrR hx.2⟩) le_rfl)

set_option maxHeartbeats 1600000 in
without_proof_info in
theorem exists_halfBall_homogeneous_hessian_bound (hp : 1 < p) (hp_top : p ≠ (⊤ : ℝ≥0∞)) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ (a : ℝ) (Ω : Opens P) (x₀ : P) (R : ℝ), 0 < R →
      (Ω : Set P) ∩ ball x₀ R = (normalHalfSpace (E := E) a : Set P) ∩ ball x₀ R →
      ∀ (A₀ : P →L[ℝ] P) (lam : ℝ), 0 < lam →
      (∀ ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪A₀ ξ, ξ⟫_ℝ) →
      ∀ (A : P → P →L[ℝ] P) (ε Λ : ℝ),
      AEStronglyMeasurable A ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) →
      ε ≤ δ * lam →
      (∀ᵐ x ∂(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R), ‖A x - A₀‖ ≤ ε) →
      0 ≤ Λ → (∀ᵐ x ∂(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R), ‖A x‖ ≤ Λ) →
      ∀ (b : P → P) (c : P → ℝ) (β γ : ℝ), 0 ≤ β → 0 ≤ γ →
      AEStronglyMeasurable b ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) →
      (∀ᵐ x ∂(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R), ‖b x‖ ≤ β) →
      AEStronglyMeasurable c ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) →
      (∀ᵐ x ∂(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R), |c x| ≤ γ) →
      ∃ D ≥ 0, ∀ u : Wkp (volume : Measure P) Ω p 2,
      (∀ η : P → ℝ, ContDiff ℝ ∞ η → HasCompactSupport η → tsupport η ⊆ ball x₀ R →
        ∀ w : Wkp (volume : Measure P) Ω p 2,
          Wkp.value 2 w =ᵐ[(volume : Measure P).restrict Ω] (fun x => η x * Wkp.value 2 u x) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω p) →
      (∀ᵐ x ∂(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R),
        traceCLM ℝ P (A x ∘L Wkp.iteratedGradient 1 u x) +
          ⟪b x, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ + c x * Wkp.value 2 u x = 0) →
      ∀ r : ℝ, 0 < r → r < R →
        (R - r) ^ 2 * lpNorm (Wkp.iteratedGradient 1 u) p
          ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
        D * lpNorm (Wkp.value 2 u) p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := by
  obtain ⟨C, δ, hδ, cA, hcA, hstepA⟩ := exists_halfBall_hessian_localization (E := E) hp hp_top
  obtain ⟨cB, hcB, hstepB⟩ := exists_halfBall_gradient_interpolation (E := E) hp_top
  refine ⟨δ, hδ, fun a Ω x₀ R hR hmatch A₀ lam hlam hA₀ A ε Λ hAm hε hA hΛ hAΛ
    b c β γ hβ hγ hb hbβ hc hcγ => ?_⟩
  let N : ℝ := 4 * (finrank ℝ P : ℝ) ^ 2
  let K : ℝ := (C : ℝ) / lam * finrank ℝ P * Λ + 1
  let Q : ℝ := (C : ℝ) / lam * (β * R + γ * R ^ 2)
  let D : ℝ := (8 * (cA + 1) + 256 * (cA + 1) ^ 2 * N +
    16 * (cA + 1) * N * (4 * cB + 1)) * (K + Q) ^ 2
  have hK1 : 1 ≤ K := by
    dsimp only [K]
    exact le_add_of_nonneg_left (by positivity)
  have hQ0 : 0 ≤ Q := by dsimp [Q]; positivity
  have hN : 0 ≤ N := by dsimp [N]; positivity
  refine ⟨D, by dsimp [D]; positivity, fun u hzero heq r hr hrR => ?_⟩
  let G := Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)
  let V := Wkp.value 2 u
  let L : P → ℝ := fun x => ⟪b x, G x⟫_ℝ + c x * V x
  let g : P → ℝ := -L
  let k : ℝ → ℝ := fun σ => lpNorm (Wkp.iteratedGradient 1 u) p
    ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ))
  let h : ℝ → ℝ := fun σ => lpNorm G p
    ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ))
  let y : ℝ → ℝ := fun σ => lpNorm V p
    ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ))
  let z : ℝ := y R
  have hz : 0 ≤ z := lpNorm_nonneg
  have hres {σ : ℝ} (hσ : σ ≤ R) :
      (volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ) ≤
        (volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R) :=
    Measure.restrict_mono
      (show (Ω : Set P) ∩ ball x₀ σ ⊆ (Ω : Set P) ∩ ball x₀ R from
        fun x hx => ⟨hx.1, ball_subset_ball hσ hx.2⟩) le_rfl
  have hlow : ∀ {σ : ℝ}, σ ≤ R →
      MemLp L p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ)) ∧
      lpNorm L p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ)) ≤ β * h σ + γ * y σ := by
    intro σ hσ
    exact strong_lowerOrder_memLp_and_bound (fun (x : P) (hx : x ∈ (Ω : Set P) ∩ ball x₀ σ) => hx.1) u
      (hb.mono_measure (hres hσ)) (hbβ.filter_mono (ae_mono (hres hσ)))
      (hc.mono_measure (hres hσ)) (hcγ.filter_mono (ae_mono (hres hσ)))
  have hgm : MemLp g p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := (hlow le_rfl).1.neg
  have heq' : ∀ᵐ x ∂(volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R),
      traceCLM ℝ P (A x ∘L Wkp.iteratedGradient 1 u x) = g x := by
    filter_upwards [heq] with x hx
    change traceCLM ℝ P (A x ∘L Wkp.iteratedGradient 1 u x) = -(⟪b x, G x⟫_ℝ + c x * V x)
    linarith
  have hgt : ∀ {t : ℝ}, t ≤ R → lpNorm g p
      ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ t)) ≤ 0 + β * h t + γ * z := by
    intro t htR
    have hlt := (hlow htR).2
    have hyt := mul_le_mul_of_nonneg_left (halfBall_lpNorm_mono_radius (x₀ := x₀) V htR) hγ
    change lpNorm (-L) p _ ≤ 0 + β * h t + γ * z
    rw [lpNorm_neg]
    linarith
  have hA' : ∀ {s t : ℝ}, 0 < s → s < t → t ≤ R →
      k s ≤ 0 + (K + Q) * ((cA + 1) / (t - s) * h t + (cA + 1) / (t - s) ^ 2 * z) := by
    intro s t hs hst htR
    have hstep := hstepA a Ω x₀ R hmatch A₀ lam hlam hA₀ A ε Λ hAm hε hA hΛ hAΛ
      u hzero g hgm heq' s t hs hst htR
    have hscalar := le_add_mul_of_le_add_of_le_add_mul_add_mul
      (by positivity : 0 ≤ (C : ℝ) / lam) (by linarith : 0 ≤ K) hcA hβ hγ
      (show 0 ≤ h t from lpNorm_nonneg) hz hs hst htR hstep (hgt htR)
    simpa only [mul_zero] using hscalar
  have hB' : ∀ {s t : ℝ}, 0 < s → s < t → t ≤ R → ∀ {η : ℝ}, 0 < η →
      h s ≤ η * (k t + cB / (t - s) * h t + cB / (t - s) ^ 2 * y t) + N / η * y t := by
    intro s t hs hst htR η hη
    simpa only [add_assoc] using hstepB a Ω x₀ R hmatch u hzero s t hs hst htR η hη
  have hΦ := sq_mul_le_of_forall_le (k := k) (h := h) (y := y) hR (by norm_num : (0 : ℝ) ≤ 0)
    (by linarith : 1 ≤ K + Q) (by linarith : 0 ≤ cA + 1) hcB hN
    (fun _ => lpNorm_nonneg) (fun _ => lpNorm_nonneg)
    (fun σ hσ => halfBall_lpNorm_mono_radius (x₀ := x₀) (Wkp.iteratedGradient 1 u) hσ.2.le)
    (fun σ hσ => halfBall_lpNorm_mono_radius (x₀ := x₀) G hσ.2.le)
    (fun σ hσ => halfBall_lpNorm_mono_radius (x₀ := x₀) V hσ.2.le) hA' hB' hr hrR
  simpa only [mul_zero, zero_add] using hΦ

end ConformalPoisson

end ProofPart_GreenTrace_HalfBallHomogeneousEstimate

/- Green/trace proof support: HalfBallGradientAbsorption.lean, SHA256 ddc06d79460e56ee32d1193f48be66a1a615290a73751c88e378f4687ce0163a -/
noncomputable section ProofPart_GreenTrace_HalfBallGradientAbsorption


/- Remove the local gradient error after the homogeneous Hessian bound.
Only fixed inner fractions of the outer radius are needed by the Green
regularity caller. The existing scalar absorption lemma is reused. -/
open Set TauCeti
namespace ConformalPoisson

without_proof_info in
theorem gradient_step_le_half_add_inv_gap
    {d D c N hs ht kt yt z : ℝ}
    (hd : 0 < d) (hD : 0 ≤ D) (hc : 0 ≤ c) (hN : 0 ≤ N)
    (hht : 0 ≤ ht) (hyt : 0 ≤ yt) (hz : 0 ≤ z) (hyz : yt ≤ z)
    (hk : d ^ 2 * kt ≤ D * z)
    (hstep : ∀ η > 0, hs ≤ η * (kt + c / d * ht + c / d ^ 2 * yt) + N / η * yt) :
    hs ≤ (1 / 2) * ht + (D + c + 4 * N * (c + 1) ^ 2) / d * z := by
  let η := d / (2 * (c + 1))
  let M := 2 * (c + 1) * d
  let A := D + c + 4 * N * (c + 1) ^ 2
  have hη : 0 < η := by dsimp [η]; positivity
  have hM : 0 < M := by dsimp [M]; positivity
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hden : c + 1 ≠ 0 := ne_of_gt (by linarith)
  have hscaled := mul_le_mul_of_nonneg_left (hstep η hη) hM.le
  have heq : M * (η * (kt + c / d * ht + c / d ^ 2 * yt) + N / η * yt) =
      d ^ 2 * kt + c * d * ht + (c + 4 * N * (c + 1) ^ 2) * yt := by
    dsimp only [η, M]
    field_simp
    <;> ring
  rw [heq] at hscaled
  have hy := mul_le_mul_of_nonneg_left hyz (show 0 ≤ c + 4 * N * (c + 1) ^ 2 by positivity)
  have hfirst : M * hs ≤ c * d * ht + A * z := by dsimp only [A]; linarith
  have hsecond : c * d * ht + A * z ≤ (c + 1) * d * ht + 2 * (c + 1) * A * z := by
    nlinarith [mul_nonneg hd.le hht, mul_nonneg hA hz, mul_nonneg hc (mul_nonneg hA hz)]
  have hfinal : M * hs ≤ M * ((1 / 2) * ht + A / d * z) := by
    have he : M * ((1 / 2) * ht + A / d * z) =
        (c + 1) * d * ht + 2 * (c + 1) * A * z := by
      dsimp only [M]
      field_simp
      <;> ring
    rw [he]
    exact hfirst.trans hsecond
  exact (mul_le_mul_iff_right₀ hM).mp hfinal

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_halfBall_gradient_value_constant
    (R D c N : ℝ) (hR : 0 < R) (hD : 0 ≤ D) (hc : 0 ≤ c) (hN : 0 ≤ N) :
    ∃ C ≥ 0, ∀ (h k y : ℝ → ℝ) (z : ℝ), 0 ≤ z →
      (∀ σ, 0 ≤ h σ) → (∀ σ, 0 ≤ k σ) → (∀ σ, 0 ≤ y σ) →
      BddAbove (h '' Icc (R / 2) (3 * R / 4)) →
      (∀ σ ∈ Icc (R / 2) (3 * R / 4), y σ ≤ z) →
      (∀ σ ∈ Icc (R / 2) (3 * R / 4), (R - σ) ^ 2 * k σ ≤ D * z) →
