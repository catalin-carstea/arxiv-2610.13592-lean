open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

variable [T2Space M₁] [T2Space M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem LocalGaugedSeed.boundary_extension_regularity
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (R : LocalGaugedSeed P hn C) {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁) :
    IsLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
      (nativeBoundaryExtension D.boundaryIdentification A.map) (x : M₁) ∧
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (nativeBoundaryMultiplier (n := n) A.multiplier) (x : M₁) ∧
    normalDerivative D.normal₁ (nativeBoundaryMultiplier (n := n) A.multiplier) x = 0 := by
  have hagree := R.agrees_boundary_extension hSchauder hRunge₂ hcompact₂ hconnected₂ A hA
  let J := normalChartTransition C.chart₁ C.chart₂
  let Φ := J.restrOpen R.domain R.domain.isOpen
  have hxΦ : (x : M₁) ∈ Φ.source := by
    change (x : M₁) ∈ (J.restrOpen (R.domain : Set M₁) R.domain.isOpen).source
    rw [PartialDiffeomorph.restrOpen_source]
    exact ⟨R.source_subset R.point_mem, R.point_mem⟩
  have hlocal : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
      (nativeBoundaryExtension D.boundaryIdentification A.map) (x : M₁) := by
    apply isLocalDiffeomorphAt_of_eqOn (Φ := Φ) hxΦ
    intro z hz
    have hzR : z ∈ R.domain := by
      change z ∈ (J.restrOpen (R.domain : Set M₁) R.domain.isOpen).source at hz
      rw [PartialDiffeomorph.restrOpen_source] at hz
      exact hz.2
    change nativeBoundaryExtension D.boundaryIdentification A.map z =
      (J.restrOpen (R.domain : Set M₁) R.domain.isOpen) z
    rw [PartialDiffeomorph.coe_restrOpen]
    exact (hagree z hzR).1
  have hcbar : nativeBoundaryMultiplier (n := n) A.multiplier =ᶠ[𝓝 (x : M₁)] R.multiplier :=
    eventuallyEq_of_mem (R.domain.isOpen.mem_nhds R.point_mem) (fun z hz => (hagree z hz).2)
  have hcseed := (R.multiplier_analytic x R.point_mem).contMDiffAt (R.domain.isOpen.mem_nhds R.point_mem)
  refine ⟨hlocal, hcseed.congr_of_eventuallyEq hcbar, ?_⟩
  rw [normalDerivative_eq_of_eventuallyEq D.normal₁ x hcbar]
  exact R.multiplier_normal_zero x R.point_mem
end ConformalPoisson

end ProofPart_NativeBoundarySeedRegularity

/- Proof support: ReverseOriginalRelation.lean, SHA256 7ca113cc69ce6b711288a1de2d1bf6a09f02e0b81670b68e50b75f9aaa71443c -/
noncomputable section ProofPart_ReverseOriginalRelation


/- Read a reversed relation on the SAME original source-data index.
The supported transport is actual, not an arbitrary test identification. -/
open Set TauCeti
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {b : (𝓡∂ (n + 1)).boundary M₂}

without_proof_info in
theorem MatchingMeasurements.reverse_relation_on_original_data
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (B : Set M₂) (K : M₂ → M₁) (d : M₂ → ℝ)
    (hrel : ∀ g : BoundaryDatum (observedPatch (n := n) V₂), ∀ y ∈ B,
      D.symm.solver₁.solve g.val y = d y *
        D.symm.solver₂.solve (g.val ∘ D.symm.boundaryIdentification.symm) (K y)) :
    ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ y ∈ B,
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) y = d y * D.solver₁.solve f.val (K y) := by
  intro f y hy
  let g : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match f
  have h := hrel g y hy
  change D.solver₂.solve g.val y = d y * D.solver₁.solve (g.val ∘ D.boundaryIdentification) (K y) at h
  have hg : g.val ∘ D.boundaryIdentification = f.val := by
    funext a
    change f.val (D.boundaryIdentification.symm (D.boundaryIdentification a)) = f.val a
    rw [D.boundaryIdentification.symm_apply_apply]
  rw [hg] at h
  exact h
end ConformalPoisson

end ProofPart_ReverseOriginalRelation

/- Proof support: MutualScaledRelations.lean, SHA256 f9c9c92269e82acb26b76327448558830a4709cf4bd465a17a970de7d256aefe -/
noncomputable section ProofPart_MutualScaledRelations


/- Two actual scaled ALL-data relations determine inverse maps and
reciprocal multipliers on their actual domains by point/scale separation. -/
namespace ConformalPoisson
open Set
variable {D X Y : Type*} {u : D → X → ℝ} {v : D → Y → ℝ} {I : Set X} {T : Set Y}

without_proof_info in
theorem inverse_maps_of_mutual_scaled_relations
    (hsep₁ : SeparatesPointAndScale (fun f (x : I) => u f x))
    (hsep₂ : SeparatesPointAndScale (fun f (y : T) => v f y))
    (J : X → Y) (K : Y → X) (c : X → ℝ) (d : Y → ℝ)
    (hJ : MapsTo J I T) (hK : MapsTo K T I)
    (hc : ∀ x ∈ I, 0 < c x) (hd : ∀ y ∈ T, 0 < d y)
    (hf : ∀ f x, x ∈ I → u f x = c x * v f (J x))
    (hb : ∀ f y, y ∈ T → v f y = d y * u f (K y)) :
    (∀ x ∈ I, K (J x) = x ∧ c x * d (J x) = 1) ∧
      (∀ y ∈ T, J (K y) = y ∧ d y * c (K y) = 1) := by
  constructor
  · intro x hx
    have h := hsep₁ ⟨x, hx⟩ ⟨K (J x), hK (hJ hx)⟩ 1 (c x * d (J x)) one_ne_zero
      (mul_pos (hc x hx) (hd _ (hJ hx))).ne' (fun f => by
        change 1 * u f x = (c x * d (J x)) * u f (K (J x))
        calc
          1 * u f x = u f x := one_mul _
          _ = c x * v f (J x) := hf f x hx
          _ = c x * (d (J x) * u f (K (J x))) := congrArg (fun r => c x * r) (hb f _ (hJ hx))
          _ = (c x * d (J x)) * u f (K (J x)) := (mul_assoc _ _ _).symm)
    exact ⟨(congrArg Subtype.val h.1).symm, h.2.symm⟩
  · intro y hy
    have h := hsep₂ ⟨y, hy⟩ ⟨J (K y), hJ (hK hy)⟩ 1 (d y * c (K y)) one_ne_zero
      (mul_pos (hd y hy) (hc _ (hK hy))).ne' (fun f => by
        change 1 * v f y = (d y * c (K y)) * v f (J (K y))
        calc
          1 * v f y = v f y := one_mul _
          _ = d y * u f (K y) := hb f y hy
          _ = d y * (c (K y) * v f (J (K y))) := congrArg (fun r => d y * r) (hf f _ (hK hy))
          _ = (d y * c (K y)) * v f (J (K y)) := (mul_assoc _ _ _).symm)
    exact ⟨(congrArg Subtype.val h.1).symm, h.2.symm⟩
end ConformalPoisson

end ProofPart_MutualScaledRelations

/- Proof support: NativeMutualInverse.lean, SHA256 649874ea8eb632b5b20e4d0434c32d6194e0f194d68354a201a878cc41ee1523 -/
