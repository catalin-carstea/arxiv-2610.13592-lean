  intro x hx y hy
  rw [dist_eq_norm, ← sub_smul, norm_smul, he, mul_one, neg_sub_neg, norm_sub_rev]
  simpa only [dist_eq_norm] using hf.dist_le hx hy

set_option maxHeartbeats 400000 in
without_proof_info in
theorem gradient_oddReflection_ae_positive {U : Opens V} (ν : V) (hν : ν ≠ 0)
    (hU : MapsTo (hyperplaneReflection ν 0) U U) (u : W1p volume U 2)
    (hu0 : ∀ᵐ x ∂volume.restrict (U : Set V), x ∉ positiveNormalHalfSpace ν → W1p.value u x = 0) :
    (W1p.gradient (u - W1p.compHyperplaneReflectionL ENNReal.ofNat_ne_top ν 0 hU u) : V → V)
      =ᵐ[volume.restrict ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V)] (W1p.gradient u : V → V) := by
  let H := positiveNormalHalfSpace ν
  let w := u - W1p.compHyperplaneReflectionL ENNReal.ofNat_ne_top ν 0 hU u
  have hval := W1p.value_sub_compHyperplaneReflectionL_ae ENNReal.ofNat_ne_top hν
    (positiveNormalHalfSpace_mem_iff ν) hU hu0
  have heq : W1p.restrictL (inf_le_left : U ⊓ H ≤ U) w =
      W1p.restrictL (inf_le_left : U ⊓ H ≤ U) u := by
    apply W1p.ext_value
    apply Lp.ext
    exact (W1p.value_restrictL_ae (inf_le_left : U ⊓ H ≤ U) w).trans
      (hval.trans (W1p.value_restrictL_ae (inf_le_left : U ⊓ H ≤ U) u).symm)
  have hg := W1p.gradient_restrictL_ae (inf_le_left : U ⊓ H ≤ U) w
  rw [heq] at hg
  exact hg.symm.trans (W1p.gradient_restrictL_ae (inf_le_left : U ⊓ H ≤ U) u)

