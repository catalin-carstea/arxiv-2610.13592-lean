        integral_subtype_comap V.isOpen.measurableSet (fun z => ‖G.kernel x z‖)
      _ ≤ ∫ z, ‖G.kernel x z‖ ∂nativeVolume g :=
        integral_mono_measure Measure.restrict_le_self (Filter.Eventually.of_forall fun z => norm_nonneg _) (hint x).norm
      _ = ∫ z, ‖K.row x z‖ ∂nativeVolume g :=
        integral_congr_ae ((G.row_ae x).mono fun z hz => congrArg norm hz)
      _ ≤ A * ‖K.row x‖ := Lp.integral_norm_le_mul_norm (K.row x)
      _ ≤ A * C := mul_le_mul_of_nonneg_left (hbound x) hA
  apply (integrable_prod_iff hm).mpr
  constructor
  · exact Filter.Eventually.of_forall fun x => by
      have hr : Integrable (G.kernel x) ((nativeVolume g).restrict (V : Set M)) := (hint x).restrict
      rw [← map_comap_subtype_coe V.isOpen.measurableSet] at hr
      exact (MeasurableEmbedding.subtype_coe V.isOpen.measurableSet).integrable_map_iff.mp hr
  · apply Integrable.of_bound hm.norm.integral_prod_right' (A * C)
    exact Filter.Eventually.of_forall fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (integral_nonneg fun _ => norm_nonneg _)]
      exact hnorm x

end ConformalPoisson

