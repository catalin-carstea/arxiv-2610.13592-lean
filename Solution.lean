/- The complementary row is the ACTUAL smooth zero-Dirichlet inverse of
its explicit commutator forcing. Uniqueness is obtained from the existing
smooth-forcing density and row duality, with the original nonresonance. -/
open Bundle Set MeasureTheory TauCeti Filter TopologicalSpace
open scoped Manifold ContDiff Topology ENNReal
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem NativeInverseLpRowFamily.cutoff_part_eq_smooth_inverse
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p s : ℝ≥0∞}
    [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]
    (K : NativeInverseLpRowFamily g q s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (hNR : Nonresonant g q) (hp : p ≠ (⊤ : ℝ≥0∞)) (x : M) (G : M → ℝ)
    (hGk : G =ᵐ[nativeVolume g] K.row x) (D : NativePoleCutoffData (n := n) x G) :
    ∃ w : M → ℝ,
      IsZeroDirichletSolution g q (fun z => -nativeCutoffCommutator g q D.cutoff D.extension z) w ∧
      (fun z => (1 - D.cutoff z) * K.row x z) =ᵐ[nativeVolume g] w := by
  let F : M → ℝ := fun z => -nativeCutoffCommutator g q D.cutoff D.extension z
  have hF : ContMDiff Ihalf 𝓘(ℝ) ∞ F :=
    (contMDiff_nativeCutoffCommutator g q D.cutoff D.extension hq D.smooth D.extension_smooth).neg
  obtain ⟨w, hw⟩ := exists_zeroDirichletSolution g q hq hNR F hF
  let f : M → ℝ := fun z => (1 - D.cutoff z) * K.row x z
  have hcut : MemLp f s (nativeVolume g) :=
    (contMDiff_memLp_nativeVolume g (fun z => 1 - D.cutoff z) (contMDiff_const.sub D.smooth) ⊤).mul
      (Lp.memLp (K.row x))
  have hwm : MemLp w s (nativeVolume g) := contMDiff_memLp_nativeVolume g w hw.1 s
  let k : Lp ℝ s (nativeVolume g) := hcut.toLp f
  let l : Lp ℝ s (nativeVolume g) := hwm.toLp w
  have hkae : (k : M → ℝ) =ᵐ[nativeVolume g] f := hcut.coeFn_toLp
  have hlae : (l : M → ℝ) =ᵐ[nativeVolume g] w := hwm.coeFn_toLp
  have hkl : k = l := by
    apply native_lp_rows_eq_of_smooth_moments (p := p) g hp k l
    intro H
    obtain ⟨u, hu⟩ := exists_zeroDirichletSolution g q hq hNR H H.contMDiff
    have hPu : (fun z => schrodinger g q u z) =ᵐ[nativeVolume g] H := by
      filter_upwards [nativeVolume_ae_interior g] with z hz
      exact hu.2.1 z hz
    calc
      (∫ z, k z * H z ∂nativeVolume g) = ∫ z, f z * H z ∂nativeVolume g :=
        integral_congr_ae (hkae.mono fun z hz => congrArg (fun a => a * H z) hz)
      _ = ∫ z, f z * schrodinger g q u z ∂nativeVolume g :=
        integral_congr_ae (hPu.mono fun z hz => congrArg (fun a => f z * a) hz.symm)
      _ = ∫ z, F z * u z ∂nativeVolume g :=
        K.cutoff_weak_moment_eq_smooth_forcing hq hNR x G hGk D u hu.1 hu.2.2
      _ = ∫ z, H z * w z ∂nativeVolume g :=
        nativeInverseReciprocity g q hq hNR F H w u hF H.contMDiff hw hu
      _ = ∫ z, l z * H z ∂nativeVolume g := by
        apply integral_congr_ae
        filter_upwards [hlae] with z hz
        rw [hz, mul_comm]
  have hklae : (k : M → ℝ) =ᵐ[nativeVolume g] l := by rw [hkl]
  exact ⟨w, hw, hkae.symm.trans (hklae.trans hlae)⟩

end ConformalPoisson

