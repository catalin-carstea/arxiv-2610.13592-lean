/- Boundary analytic support: ReflectedSmallBallInverse.lean, SHA256 18dadb92a12b697eb2f42a343cac32b2c051649a3b018a5ebdd5211e6c917383 -/
noncomputable section ProofPart_BoundaryAnalytic_ReflectedSmallBallInverse



/- An actual small-scale inverse for the reflected coefficients. The fold
maps and normal-coordinate multiplier are fixed before the coefficient
germs; their norms only reduce the ordinary rescaling tolerance. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "BX" => BallSpace α V ℝ

without_proof_info in
theorem eventually_rescale_ball_four {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {R : ℝ} (hR : 0 < R) :
    ∀ᶠ ε in 𝓝 (0 : ℝ), MapsTo (fun x : E => ε • x) (ball 0 4) (ball 0 R) := by
  filter_upwards [ball_mem_nhds (0 : ℝ) (div_pos hR (by norm_num : (0 : ℝ) < 5))]
    with ε hε x hx
  have he : ‖ε‖ < R / 5 := mem_ball_zero_iff.mp hε
  have hxn : ‖x‖ < 4 := mem_ball_zero_iff.mp hx
  rw [mem_ball_zero_iff, norm_smul]
  have hb : ‖ε‖ * ‖x‖ ≤ ‖ε‖ * 4 := mul_le_mul_of_nonneg_left hxn.le (norm_nonneg ε)
  nlinarith

set_option maxHeartbeats 1200000 in
set_option synthInstance.maxHeartbeats 200000 in
without_proof_info in
theorem exists_small_scaled_reflected_ball_preconditioner
    (hα : 0 < α) (hαlt : α < 1)
    (A : V → V →L[ℝ] V) (β : V → V) (q : V → ℝ)
    {R : ℝ} (hR : 0 < R)
    (hA : AnalyticOnNhd ℝ A (ball 0 R)) (hβ : AnalyticOnNhd ℝ β (ball 0 R))
    (hq : AnalyticOnNhd ℝ q (ball 0 R)) (hA0 : A 0 = ContinuousLinearMap.id ℝ V) :
    ∃ ε : ℝ, 0 < ε ∧ ε ≤ 1 ∧
      MapsTo (fun x : V => ε • x) (ball 0 4) (ball 0 R) ∧
      ∃ (S : (H ℝ) →L[ℝ] BX) (A0 : H (V →L[ℝ] V)) (B0 : H V) (Q0 : H ℝ),
        (∀ x : closedBall (0 : V) 1, A0 x = A (ε • boundaryFold x)) ∧
        (∀ x : closedBall (0 : V) 1, B0 x =
          boundaryTangentialProjection (ε • β (ε • boundaryFold x)) +
            (ε * (x : V) 0 * (ε • β (ε • boundaryFold x)) 0) • EuclideanSpace.single 0 1) ∧
        (∀ x : closedBall (0 : V) 1, Q0 x = ε ^ 2 * q (ε • boundaryFold x)) ∧
        (S.comp (ballSchrodinger hαlt.le A0 B0 Q0)).IsInvertible := by
  obtain ⟨S, δ, hδ, hprecondition⟩ := exists_uniform_analytic_ball_preconditioner (n := n) hα hαlt
  obtain ⟨T, hT⟩ := exists_normalCoordinateHolder (n := n) hαlt.le
  let LA : (H (V →L[ℝ] V)) →L[ℝ] (H (V →L[ℝ] V)) := evenFoldHolderL
  let LQ : (H ℝ) →L[ℝ] (H ℝ) := evenFoldHolderL
  let LT : (H V) →L[ℝ] (H V) := tangentFoldHolderL
  let LN : (H V) →L[ℝ] (H V) := normalDriftFoldHolderL T
  let C : ℝ≥0 := 1 + ‖LA‖₊ + ‖LT‖₊ + ‖LN‖₊ + ‖LQ‖₊
  have hC : 0 < C := by dsimp [C]; positivity
  let d : ℝ≥0 := δ / (2 * C)
  have hd : 0 < d := div_pos hδ (mul_pos (by norm_num) hC)
  have htol : (C : ℝ) * (2 * (d : ℝ)) = δ := by
    dsimp [d]
    push_cast
    field_simp
  have hCA : ‖LA‖ ≤ (C : ℝ) := by
    dsimp [C]; push_cast
    linarith [norm_nonneg LT, norm_nonneg LN, norm_nonneg LQ]
  have hCQ : ‖LQ‖ ≤ (C : ℝ) := by
    dsimp [C]; push_cast
    linarith [norm_nonneg LA, norm_nonneg LT, norm_nonneg LN]
  have hCB : ‖LT‖ + ‖LN‖ ≤ (C : ℝ) := by
    dsimp [C]; push_cast
    linarith [norm_nonneg LA, norm_nonneg LQ]
  have hc := eventually_rescaled_coefficient_bounds
    (hA 0 (mem_ball_self hR)).contDiffAt (hβ 0 (mem_ball_self hR)).contDiffAt
    (hq 0 (mem_ball_self hR)).contDiffAt hA0 hαlt.le hd
  have hle : ∀ᶠ ε : ℝ in 𝓝 0, ε ≤ 1 :=
    (gt_mem_nhds (by norm_num : (0 : ℝ) < 1)).mono fun _ h => h.le
  obtain ⟨ε, hε, hmap, hcoeff, hεle⟩ := exists_pos_of_eventually_zero
    ((eventually_rescale_ball_four (E := V) hR).and (hc.and hle))
  have hmap3 : MapsTo (fun x : V => ε • x) (ball 0 3) (ball 0 R) :=
    hmap.mono_left (ball_subset_ball (by norm_num : (3 : ℝ) ≤ 4))
  let Aε : V → V →L[ℝ] V := fun x => A (ε • x)
  let Bε : V → V := fun x => ε • β (ε • x)
  let Qε : V → ℝ := fun x => ε ^ 2 * q (ε • x)
  have hs (x : V) : AnalyticAt ℝ (fun y : V => ε • y) x := analyticAt_id.const_smul (c := ε)
  have hK3 : closedBall (0 : V) 1 ⊆ ball 0 3 :=
    closedBall_subset_ball (by norm_num : (1 : ℝ) < 3)
  have hAc : ContinuousOn Aε (closedBall (0 : V) 1) :=
    (show AnalyticOnNhd ℝ Aε (ball 0 3) from
      fun x hx => (hA _ (hmap3 hx)).comp (hs x)).continuousOn.mono hK3
  have hBc : ContinuousOn Bε (closedBall (0 : V) 1) :=
    (show AnalyticOnNhd ℝ Bε (ball 0 3) from
      fun x hx => ((hβ _ (hmap3 hx)).comp (hs x)).const_smul (c := ε)).continuousOn.mono hK3
  have hQc : ContinuousOn Qε (closedBall (0 : V) 1) :=
    (show AnalyticOnNhd ℝ Qε (ball 0 3) from
      fun x hx => analyticAt_const.mul ((hq _ (hmap3 hx)).comp (hs x))).continuousOn.mono hK3
  let AR := closedBallHolderRestriction (fun x => Aε x - ContinuousLinearMap.id ℝ V)
    (hAc.sub continuousOn_const) hcoeff.1
  let BR := closedBallHolderRestriction Bε hBc hcoeff.2.1
  let QR := closedBallHolderRestriction Qε hQc hcoeff.2.2
  let AF : H (V →L[ℝ] V) := LA AR + TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)
  let BF : H V := scaledDriftFoldHolderL ε T BR
  let QF : H ℝ := LQ QR
  have hnA : ‖AF - TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)‖ ≤ (δ : ℝ) := by
    change ‖LA AR + _ - _‖ ≤ _
    rw [add_sub_cancel_right]
    calc
      _ ≤ ‖LA‖ * ‖AR‖ := LA.le_opNorm AR
      _ ≤ (C : ℝ) * (2 * (d : ℝ)) :=
        mul_le_mul hCA (norm_closedBallHolderRestriction_le _ _ _) (norm_nonneg _) C.coe_nonneg
      _ = _ := htol
  have hnB : ‖BF‖ ≤ (δ : ℝ) := by
    calc
      _ ≤ ‖scaledDriftFoldHolderL ε T‖ * ‖BR‖ := (scaledDriftFoldHolderL ε T).le_opNorm BR
      _ ≤ (C : ℝ) * (2 * (d : ℝ)) := mul_le_mul
        ((norm_scaledDriftFoldHolderL_le ε hε.le hεle T).trans hCB)
        (norm_closedBallHolderRestriction_le _ _ _) (norm_nonneg _) C.coe_nonneg
      _ = _ := htol
  have hnQ : ‖QF‖ ≤ (δ : ℝ) := by
    calc
      _ ≤ ‖LQ‖ * ‖QR‖ := LQ.le_opNorm QR
      _ ≤ (C : ℝ) * (2 * (d : ℝ)) :=
        mul_le_mul hCQ (norm_closedBallHolderRestriction_le _ _ _) (norm_nonneg _) C.coe_nonneg
      _ = _ := htol
  refine ⟨ε, hε, hεle, hmap, S, AF, BF, QF, ?_, ?_, ?_, hprecondition AF BF QF hnA hnB hnQ⟩
  · intro x
    simp [AF, LA, AR, Aε, boundaryFoldClosed]
  · intro x
    simp only [BF, scaledDriftFoldHolderL_apply, BR, closedBallHolderRestriction_apply, hT]
    rfl
  · intro x
    simp [QF, LQ, QR, Qε, boundaryFoldClosed]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_ReflectedSmallBallInverse

/- Boundary analytic support: NormalizedBoundaryAnalytic.lean, SHA256 7fdcb3827a05f6e0fb6c190025e5edc34a330e8f6223a1c15cdd388ea5771d45 -/
noncomputable section ProofPart_BoundaryAnalytic_NormalizedBoundaryAnalytic



/- The normalized scalar boundary consequence, with the inverse supplied
from the actual coefficient germs. No positivity of the potential, global
solvability, or optimal analytic estimate is used. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e" => (EuclideanSpace.single 0 1 : V)

without_proof_info in
theorem analyticWithinAt_of_positive_rescaled_function
    (u : V → ℝ) {ε : ℝ} (hε : 0 < ε)
    (hu : AnalyticWithinAt ℝ (fun x => u (ε • x)) {x : V | 0 ≤ x 0} 0) :
    AnalyticWithinAt ℝ u {x : V | 0 ≤ x 0} 0 := by
  have hs : AnalyticAt ℝ (fun x : V => ε⁻¹ • x) 0 := analyticAt_id.const_smul (c := ε⁻¹)
  have hm : MapsTo (fun x : V => ε⁻¹ • x) {x : V | 0 ≤ x 0} {x : V | 0 ≤ x 0} := by
    intro x hx
    exact mul_nonneg (inv_nonneg.mpr hε.le) hx
  have h := hu.comp_of_eq hs.analyticWithinAt hm (smul_zero ε⁻¹)
  simpa only [Function.comp_def, smul_smul, mul_inv_cancel₀ hε.ne', one_smul] using h

set_option maxHeartbeats 1800000 in
set_option synthInstance.maxHeartbeats 200000 in
without_proof_info in
theorem analyticWithinAt_of_normalized_boundary_equation
    (A : V → V →L[ℝ] V) (β : V → V) (q G u : V → ℝ) {R : ℝ} (hR : 0 < R)
    (hA : AnalyticOnNhd ℝ A (ball 0 R)) (hβ : AnalyticOnNhd ℝ β (ball 0 R))
    (hq : AnalyticOnNhd ℝ q (ball 0 R)) (hG : AnalyticOnNhd ℝ G (ball 0 R))
    (hu : ContDiffOn ℝ ∞ u (boundaryHalfBall R))
    (hA0 : A 0 = ContinuousLinearMap.id ℝ V)
    (hAn : ∀ x ∈ ball (0 : V) R, A x e = e)
    (hArow : ∀ x ∈ ball (0 : V) R, ∀ v : V, A x v 0 = v 0)
    (hzero : ∀ x ∈ ball (0 : V) R, x 0 = 0 → u x = 0)
    (hLu : ∀ x ∈ ball (0 : V) R, 0 < x 0 →
      coordinateSchrodinger A (boundaryNormalDrift β) q u x = x 0 * G x) :
    AnalyticWithinAt ℝ u {x : V | 0 ≤ x 0} 0 := by
  let α : ℝ≥0 := 1 / 2
  have hα : 0 < α := by norm_num [α]
  have hαlt : α < 1 := by norm_num [α]
  obtain ⟨ε, hε, _, hmap, S, A0, B0, Q0, hAread, hBread, hQread, hinv⟩ :=
    exists_small_scaled_reflected_ball_preconditioner hα hαlt A β q hR hA hβ hq hA0
  let Aε : V → V →L[ℝ] V := fun x => A (ε • x)
  let βε := boundaryRescaledDriftBundle ε β
  let qε : V → ℝ := fun x => ε ^ 2 * q (ε • x)
  let Gε : V → ℝ := fun x => ε ^ 3 * G (ε • x)
  let uε : V → ℝ := fun x => u (ε • x)
  have hs (x : V) : AnalyticAt ℝ (fun y : V => ε • y) x := analyticAt_id.const_smul (c := ε)
  have hAε : AnalyticOnNhd ℝ Aε (ball 0 4) := fun x hx => (hA _ (hmap hx)).comp (hs x)
  have hβε : AnalyticOnNhd ℝ βε (ball 0 4) := boundaryRescaledDriftBundle_analyticOnNhd ε β hmap hβ
  have hqε : AnalyticOnNhd ℝ qε (ball 0 4) :=
    fun x hx => analyticAt_const.mul ((hq _ (hmap hx)).comp (hs x))
  have hGε : AnalyticOnNhd ℝ Gε (ball 0 4) :=
    fun x hx => analyticAt_const.mul ((hG _ (hmap hx)).comp (hs x))
  have huε : ContDiffOn ℝ ∞ uε (boundaryHalfBall 4) :=
    hu.comp (contDiff_const_smul ε).contDiffOn
      (fun x hx => ⟨hmap hx.1, mul_nonneg hε.le hx.2⟩)
