open TauCeti LineDeriv
open scoped SchwartzMap ContDiff
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => CoordinateSpace d

without_proof_info in
theorem schwartz_second_lineDeriv_eq_fderiv
    (φ : 𝓢(V, ℝ)) (v w x : V) :
    ∂_{v} (∂_{w} φ) x = fderiv ℝ (fderiv ℝ (φ : V → ℝ)) x v w := by
  have h := SchwartzMap.iteratedLineDerivOp_eq_iteratedFDeriv
    (m := ![v, w]) (f := φ) (x := x)
  simpa only [iteratedLineDerivOp_succ_left, iteratedLineDerivOp_fin_zero,
    Fin.tail_def, Fin.succ_zero_eq_one, Matrix.cons_val_zero, Matrix.cons_val_one,
    iteratedFDeriv_two_apply] using h

