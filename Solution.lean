without_proof_info in
theorem NativeInverseLpRowFamily.cutoff_weak_moment
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseLpRowFamily g q s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (x : M) (θ : M → ℝ) (hθ : ContMDiff Ihalf 𝓘(ℝ) ∞ θ) (hθx : θ x = 1)
    (u : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hu0 : ∀ y : (Ihalf).boundary M, u y = 0) :
    Integrable (fun z => ((1 - θ z) * K.row x z) * schrodinger g q u z) (nativeVolume g) ∧
      (∫ z, ((1 - θ z) * K.row x z) * schrodinger g q u z ∂nativeVolume g) =
        ∫ z, K.row x z * nativeCutoffCommutator g q θ u z ∂nativeVolume g := by
  have hθu0 : ∀ y : (Ihalf).boundary M, (θ * u) y = 0 := by
    intro y
    simp only [Pi.mul_apply, hu0 y, mul_zero]
  obtain ⟨hA, hAi⟩ := K.weak_equation hq x u hu hu0
  obtain ⟨hC, hCi⟩ := K.weak_equation hq x (θ * u) (hθ.mul hu) hθu0
  have hB : Integrable (fun z => θ z * (K.row x z * schrodinger g q u z)) (nativeVolume g) :=
    hA.mul_of_top_right (contMDiff_memLp_nativeVolume g θ hθ ⊤)
  have hw : (fun z => ((1 - θ z) * K.row x z) * schrodinger g q u z) =
      (fun z => K.row x z * schrodinger g q u z - θ z * (K.row x z * schrodinger g q u z)) := by
    funext z
    ring
  have hc : (fun z => K.row x z * nativeCutoffCommutator g q θ u z) =
      (fun z => K.row x z * schrodinger g q (θ * u) z - θ z * (K.row x z * schrodinger g q u z)) := by
    funext z
    dsimp [nativeCutoffCommutator]
    ring
  refine ⟨hw ▸ hA.sub hB, ?_⟩
  rw [hw, hc, integral_sub hA hB, integral_sub hC hB, hAi, hCi]
  simp only [Pi.mul_apply, hθx, one_mul]

without_proof_info in
theorem NativePoleCutoffData.row_commutator_ae
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    {x : M} {G k : M → ℝ} (D : NativePoleCutoffData (n := n) x G)
    (hGk : G =ᵐ[nativeVolume g] k) (u : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) :
    (fun z => k z * nativeCutoffCommutator g q D.cutoff u z) =ᵐ[nativeVolume g]
      (fun z => D.extension z * nativeCutoffCommutator g q D.cutoff u z) := by
  have hs := tsupport_nativeCutoffCommutator_subset g q D.cutoff u D.smooth hu D.one_domain D.one
  filter_upwards [hGk] with z hz
  by_cases hT : z ∈ tsupport D.cutoff \ (D.one_domain : Set M)
  · rw [D.agrees hT, hz]
  · have hzC : nativeCutoffCommutator g q D.cutoff u z = 0 :=
      image_eq_zero_of_notMem_tsupport (fun h => hT (hs h))
    rw [hzC, mul_zero, mul_zero]

