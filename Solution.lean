without_proof_info in
theorem continuousAt_uncurry_of_uniform_coordinate_bound
    (f : X → Y → F) (ρ : Y → E) (x₀ : X) (y₀ : Y) (C : ℝ)
    (hx : ContinuousAt (fun x => f x y₀) x₀) (hρ : ContinuousAt ρ y₀)
    (S : Set X) (T : Set Y) (hS : S ∈ 𝓝 x₀) (hT : T ∈ 𝓝 y₀)
    (hbound : ∀ x ∈ S, ∀ y ∈ T, dist (f x y) (f x y₀) ≤ C * dist (ρ y) (ρ y₀)) :
    ContinuousAt (fun t : X × Y => f t.1 t.2) (x₀, y₀) := by
  have heS : ∀ᶠ t : X × Y in 𝓝 (x₀, y₀), t.1 ∈ S :=
    continuousAt_fst.preimage_mem_nhds hS
  have heT : ∀ᶠ t : X × Y in 𝓝 (x₀, y₀), t.2 ∈ T :=
    continuousAt_snd.preimage_mem_nhds hT
  have hright : Tendsto (fun t : X × Y => C * dist (ρ t.2) (ρ y₀) +
      dist (f t.1 y₀) (f x₀ y₀)) (𝓝 (x₀, y₀)) (𝓝 0) := by
    have hρprod : ContinuousAt (fun t : X × Y => ρ t.2) (x₀, y₀) := hρ.comp continuousAt_snd
    have hxprod : ContinuousAt (fun t : X × Y => f t.1 y₀) (x₀, y₀) := by
      exact ContinuousAt.comp (f := Prod.fst) (g := fun x : X => f x y₀) (x := (x₀, y₀)) hx continuousAt_fst
    have h : ContinuousAt (fun t : X × Y => C * dist (ρ t.2) (ρ y₀) +
        dist (f t.1 y₀) (f x₀ y₀)) (x₀, y₀) :=
      (continuousAt_const.mul (hρprod.dist continuousAt_const)).add
        (hxprod.dist continuousAt_const)
    simpa only [dist_self, mul_zero, add_zero] using h.tendsto
  apply tendsto_iff_dist_tendsto_zero.mpr
  apply squeeze_zero' (Eventually.of_forall fun _ => dist_nonneg) _ hright
  filter_upwards [heS, heT] with t htS htT
  exact (dist_triangle (f t.1 t.2) (f t.1 y₀) (f x₀ y₀)).trans
    (add_le_add (hbound t.1 htS t.2 htT) le_rfl)

end ConformalPoisson

