  obtain ⟨J, hJ, hJeq⟩ := exists_continuous_ballJet_family hα v v1 v2 v3 hv hv1 hv2 hv3
    (by
      intro p hp x hx
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx), hv1eq p hp]
      exact hasFDerivAt_domainRead_of_ball_values (v p) (f p) (hveq p hp) hx
        ((hslice hf p hp (hKW (ball_subset_closedBall hx))).differentiableAt (by simp)))
