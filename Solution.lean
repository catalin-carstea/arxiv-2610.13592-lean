    (⟨_, W1p.ofTestFunctionₗ_mem_w1p0Submodule φ⟩ : W1p0 volume U 2)
  refine hw.trans (integral_congr_ae ?_)
  filter_upwards [gradientTestFunctionLp_apply_ae (mu := volume) 2 φ] with x hx
  rw [W1p.gradient_ofTestFunctionₗ, hx]
end ConformalPoisson

