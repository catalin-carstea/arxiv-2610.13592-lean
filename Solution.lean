theorem coordinatePushforward_finset_linear
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    {ι : Type*} (A : Finset ι) (w : ι → ℝ) (f : ι → H → F) :
    coordinatePushforward χ (fun z => ∑ i ∈ A, w i • f i z) =
      fun x => ∑ i ∈ A, w i • coordinatePushforward χ (f i) x := by
  funext x
  by_cases hxt : x ∈ χ.target
