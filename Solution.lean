without_proof_info in
theorem remainder_congr_prefix {b c : ℕ → NativeSymbol n} (r : ℕ)
    (h : ∀ p ≤ r, b p = c p) :
    symbolCompositionRemainder b r = symbolCompositionRemainder c r := by
  funext ξ z
  unfold symbolCompositionRemainder
  apply Finset.sum_congr rfl
  intro p hp
  apply Finset.sum_congr rfl
  intro q hq
  rw [h p (Nat.le_of_lt_succ (Finset.mem_range.mp hp)),
    h q (Nat.le_of_lt_succ (Finset.mem_range.mp hq))]

def rawComponent (F : NormalMetricField S) (k : ℕ) : NativeSymbol n :=
  match k with
  | 0 => fun ξ z => -Complex.ofReal (F.principal ξ z)
  | r + 1 => fun ξ z => (Complex.ofReal (2 * F.principal ξ z))⁻¹ *
      (normalDeriv (rawComponent F r ξ) z - Complex.ofReal (F.tau z / 2) * rawComponent F r ξ z +
        symbolCompositionRemainder (fun p => if _h : p ≤ r then rawComponent F p else 0) r ξ z -
        (if r = 0 then F.firstOrderSymbol ξ z else 0))
termination_by k
decreasing_by all_goals omega

without_proof_info in
theorem rawComponent_zero (F : NormalMetricField S) :
    rawComponent F 0 = fun ξ z => -Complex.ofReal (F.principal ξ z) := by
  rw [rawComponent]

without_proof_info in
theorem rawComponent_succ (F : NormalMetricField S) (r : ℕ) :
    rawComponent F (r + 1) = fun ξ z => (Complex.ofReal (2 * F.principal ξ z))⁻¹ *
      (normalDeriv (rawComponent F r ξ) z - Complex.ofReal (F.tau z / 2) * rawComponent F r ξ z +
        symbolCompositionRemainder (rawComponent F) r ξ z -
        (if r = 0 then F.firstOrderSymbol ξ z else 0)) := by
  rw [rawComponent]
  have he := remainder_congr_prefix (b := fun p => if _h : p ≤ r then rawComponent F p else 0)
    (c := rawComponent F) r (fun p hp => dite_eq_left hp)
  rw [he]

without_proof_info in
theorem rawComponent_recurrence (F : NormalMetricField S) (r : ℕ)
    {ξ : Fin n → ℝ} (hξ : ξ ≠ 0) {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) :
    Complex.ofReal (2 * F.principal ξ z) * rawComponent F (r + 1) ξ z =
      normalDeriv (rawComponent F r ξ) z - Complex.ofReal (F.tau z / 2) * rawComponent F r ξ z +
        symbolCompositionRemainder (rawComponent F) r ξ z -
        (if r = 0 then F.firstOrderSymbol ξ z else 0) := by
  have hn : Complex.ofReal (2 * F.principal ξ z) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (F.principal_pos ξ hξ z hz).ne')
  rw [rawComponent_succ]
  exact mul_inv_cancel_left₀ hn _


/- Adapted ordinary proof from the previously checked RawSymbolAnalyticity,
replacing an assumed family's recurrence with the explicit recursion above. -/
without_proof_info in
theorem rawComponent_analytic (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    (r : ℕ) : SymbolContMDiffOn S ω (rawComponent F r) := by
  have hp := F.principal_joint_contMDiffOn hA
  have hpC : SymbolContMDiffOn S ω (fun ξ z => Complex.ofReal (F.principal ξ z)) :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn hp
  have hE : SymbolContMDiffOn S ω (fun _ z => Complex.ofReal (F.tau z / 2)) :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn
      (symbol_coefficient_contMDiffOn ((F.tau_analyticOn hG hA).div_const 2))
  have hinv : SymbolContMDiffOn S ω (fun ξ z => Complex.ofReal ((2 * F.principal ξ z)⁻¹)) :=
    Complex.ofRealCLM.contDiff.contMDiff.comp_contMDiffOn
      ((contMDiffOn_const.mul hp).inv₀ (fun p hp =>
        mul_ne_zero (two_ne_zero : (2 : ℝ) ≠ 0) (F.principal_pos p.2 hp.2 p.1 hp.1).ne'))
  induction r using Nat.strong_induction_on with
  | ind r ih =>
    cases r with
    | zero =>
      rw [rawComponent_zero]
      exact hpC.neg
    | succ r =>
      have hb : ∀ p ≤ r, SymbolContMDiffOn S ω (rawComponent F p) :=
        fun p hp => ih p (Nat.lt_succ_of_le hp)
      have hN := symbolNormalDeriv_contMDiffOn S.isOpen (hb r le_rfl)
        (le_top : (ω : ℕ∞ω) + 1 ≤ ω)
      have hR := symbolCompositionRemainder_contMDiffOn S.isOpen
        (le_top : (ω : ℕ∞ω) + 1 ≤ ω) (rawComponent F) r hb
      have hQ : SymbolContMDiffOn S ω (fun ξ z => if r = 0 then F.firstOrderSymbol ξ z else 0) := by
        by_cases hr : r = 0
        · simp only [hr, ite_true]
          exact F.firstOrderSymbol_analyticOn hG hA
        · simp only [hr, ite_false]
          exact symbolConst_contMDiffOn 0
      have hnum : SymbolContMDiffOn S ω (fun ξ z => normalDeriv (rawComponent F r ξ) z -
          Complex.ofReal (F.tau z / 2) * rawComponent F r ξ z +
          symbolCompositionRemainder (rawComponent F) r ξ z -
          (if r = 0 then F.firstOrderSymbol ξ z else 0)) :=
        ((hN.sub (symbolMul_contMDiffOn hE (hb r le_rfl))).add hR).sub hQ
      rw [rawComponent_succ]
      simpa only [Complex.ofReal_inv] using symbolMul_contMDiffOn hinv hnum


def Homogeneous (S : Set (EuclideanHalfSpace (n + 1))) (d : ℤ) (b : NativeSymbol n) : Prop :=
  ∀ z ∈ S, ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ∀ t : ℝ, 0 < t →
    b (t • ξ) z = (t ^ d) • b ξ z

without_proof_info in
theorem modelDeriv_homogeneous {d : ℤ} {b : NativeSymbol n}
    (hb : Homogeneous S d b) (v : EuclideanSpace ℝ (Fin (n + 1))) :
    Homogeneous S d (fun ξ => modelDirectionalDeriv (𝓡∂ (n + 1)) v (b ξ)) := by
  intro z hz ξ hξ t ht
  dsimp only
  have he : b (t • ξ) =ᶠ[𝓝 z] (t ^ d) • b ξ :=
    Filter.eventuallyEq_of_mem (S.isOpen.mem_nhds hz) (fun y hy => hb y hy ξ hξ t ht)
  have h := modelDirectionalDeriv_eq_of_eventuallyEq (𝓡∂ (n + 1)) v he
  exact h.trans (congrArg (fun A => A v)
    (mvfderiv_const_smul_field (I := 𝓡∂ (n + 1)) (b ξ) z (t ^ d)))

without_proof_info in
theorem frequencyDeriv_homogeneous {d : ℤ} {b : NativeSymbol n}
    (hb : Homogeneous S d b)
    (hdf : ∀ z ∈ S, ∀ ξ : Fin n → ℝ, ξ ≠ 0 → DifferentiableAt ℝ (fun η => b η z) ξ)
    (i : Fin n) : Homogeneous S (d - 1) (symbolFrequencyDeriv i b) := by
  intro z hz ξ hξ t ht
  let f : (Fin n → ℝ) → ℂ := fun η => b η z
  let L : (Fin n → ℝ) →L[ℝ] (Fin n → ℝ) := t • ContinuousLinearMap.id ℝ _
  have htξ : t • ξ ≠ 0 := smul_ne_zero ht.ne' hξ
  have he : f ∘ L =ᶠ[𝓝 ξ] (t ^ d) • f := by
    filter_upwards [isOpen_ne.mem_nhds hξ] with η hη
    exact hb z hz η hη t ht
  have hd : DifferentiableAt ℝ f (L ξ) := hdf z hz (t • ξ) htξ
  have h := congrArg (fun A : (Fin n → ℝ) →L[ℝ] ℂ => A (Pi.single i 1)) he.fderiv_eq
  rw [fderiv_comp _ hd L.differentiableAt, L.fderiv,
    fderiv_const_smul (hdf z hz ξ hξ)] at h
  have hh := congrArg (fun w : ℂ => t⁻¹ • w) h
  have hs : t⁻¹ * t ^ d = t ^ (d - 1) := by
    rw [zpow_sub₀ ht.ne', zpow_one, div_eq_mul_inv, mul_comm]
  simp only [L, ContinuousLinearMap.comp_apply, smul_apply, ContinuousLinearMap.id_apply,
    map_smul, smul_smul, inv_mul_cancel₀ ht.ne', one_smul] at hh
  rw [hs] at hh
  exact hh


without_proof_info in
theorem frequency_slice_differentiable {b : NativeSymbol n} (hb : SymbolContMDiffOn S ω b)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) {ξ : Fin n → ℝ} (hξ : ξ ≠ 0) :
    DifferentiableAt ℝ (fun η => b η z) ξ := by
  have hp := (hb (z, ξ) ⟨hz, hξ⟩).contMDiffAt
    ((symbol_domain_open S.isOpen).mem_nhds ⟨hz, hξ⟩)
  have hp' : ContMDiffAt ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) 𝓘(ℝ, ℂ) ω
      (fun p : EuclideanHalfSpace (n + 1) × (Fin n → ℝ) => b p.2 p.1) (z, ξ) := by
    rw [chartedSpaceSelf_prod]
    exact hp
  have hs : ContMDiffAt 𝓘(ℝ, Fin n → ℝ)
      ((𝓡∂ (n + 1)).prod 𝓘(ℝ, Fin n → ℝ)) ω
      (fun η : Fin n → ℝ => (z, η)) ξ := contMDiffAt_const.prodMk contMDiffAt_id
  exact (contMDiffAt_iff_contDiffAt.mp (hp'.comp ξ hs)).differentiableAt (by decide)

