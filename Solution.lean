/- Assignment268, /root. Actual scalar/complex Taylor readings of the
native coefficient bundle inherit the proved remainder bound. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Metric Filter Topology Finset TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem nativeNormalTaylor_clm (L : E →L[ℝ] F) {f : H → E} {S : Set H} (hS : IsOpen S)
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, E) ∞ f S) (y : Y)
    (hy : EuclideanHalfSpace.boundaryParam n y ∈ S) (N : ℕ) (t : ℝ) :
    nativeNormalTaylor (L ∘ f) y N t = L (nativeNormalTaylor f y N t) := by
  unfold nativeNormalTaylor
  simp only [map_sum, map_smul]
  apply sum_congr rfl
  intro l hl
  rw [normalJet_clm_eqOn L hS hf l hy]
  rfl

def complexNormalTaylor (f : H → ℝ) (y : Y) (N : ℕ) (t : ℝ) : ℂ :=
  ∑ l ∈ range (N + 1), faceTaylor f l y * (t : ℂ) ^ l

without_proof_info in
theorem complexNormalTaylor_eq_ofReal (f : H → ℝ) (y : Y) (N : ℕ) (t : ℝ) :
    complexNormalTaylor f y N t = ((nativeNormalTaylor f y N t : ℝ) : ℂ) := by
  simp only [complexNormalTaylor, nativeNormalTaylor, faceTaylor, faceJet, smul_eq_mul,
    Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_div, Complex.ofReal_pow,
    Complex.ofReal_natCast]
  apply sum_congr rfl
  intro l hl
  ring

without_proof_info in
theorem complexNormalTaylor_reading_bound (L : E →L[ℝ] ℝ) {f : H → E} {S : Set H}
    (hS : IsOpen S) (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, E) ∞ f S)
    (y : Y) (hy : EuclideanHalfSpace.boundaryParam n y ∈ S) (N : ℕ) (t : ℝ)
    (z : H) {C : ℝ} (hb : ‖f z - nativeNormalTaylor f y N t‖ ≤ C * t ^ (N + 1)) :
    ‖(L (f z) : ℂ) - complexNormalTaylor (L ∘ f) y N t‖ ≤ ‖L‖ * C * t ^ (N + 1) := by
  rw [complexNormalTaylor_eq_ofReal, nativeNormalTaylor_clm L hS hf y hy N t,
    ← Complex.ofReal_sub, Complex.norm_real, ← map_sub]
  calc
    ‖L (f z - nativeNormalTaylor f y N t)‖ ≤ ‖L‖ * ‖f z - nativeNormalTaylor f y N t‖ := L.le_opNorm _
    _ ≤ ‖L‖ * (C * t ^ (N + 1)) := mul_le_mul_of_nonneg_left hb (norm_nonneg _)
    _ = _ := by ring

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNNativeTaylorReadings

