/- Assignment268, /root. Lower original inverse metric jets supply exactly
the actual native layer coefficient equalities used by the finite response. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem native_coefficient_jet_comparison {S : TopologicalSpace.Opens H}
    (F₁ F₂ : NormalMetricField S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hA₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.inverse S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.inverse S)
    {U W : Set Y} (hUS : MapsTo (EuclideanHalfSpace.boundaryParam n) U S)
    (hW : IsOpen W) (hWU : W ⊆ U) (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) (L : ℕ)
    (hj : ∀ r ≤ L, EqOn (normalJet r F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet r F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W) :
    let B₁ := nativeBoundaryLayerCoefficients F₁ hG₁ hA₁ hUS ξ hξ;
    let B₂ := nativeBoundaryLayerCoefficients F₂ hG₂ hA₂ hUS ξ hξ;
    EqOn B₁.kappa B₂.kappa W ∧
      (∀ l ≤ L, ∀ i r, EqOn (B₁.inverse l i r) (B₂.inverse l i r) W) ∧
      (∀ l, l + 1 ≤ L → EqOn (B₁.normalDrift l) (B₂.normalDrift l) W) ∧
      (∀ l ≤ L, ∀ i, EqOn (B₁.tangentDrift l i) (B₂.tangentDrift l i) W) := by
  have hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S := hUS.mono_left hWU
  have hAJ : BoundaryJetComparison S W L F₁.inverse F₂.inverse := ⟨hA₁, hA₂, hj⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro y hy
    change F₁.principal ξ (EuclideanHalfSpace.boundaryParam n y) = F₂.principal ξ (EuclideanHalfSpace.boundaryParam n y)
    unfold NormalMetricField.principal
    have h0 : F₁.inverse (EuclideanHalfSpace.boundaryParam n y) = F₂.inverse (EuclideanHalfSpace.boundaryParam n y) := hj 0 (Nat.zero_le L) hy
    rw [h0]
  · intro l hl i r y hy
    change faceTaylor (fun z => F₁.inverse z i r) l y = faceTaylor (fun z => F₂.inverse z i r) l y
    unfold faceTaylor faceJet
    rw [normalJet_matrix_entry S.isOpen F₁.inverse_smooth l i r (hWS hy),
      normalJet_matrix_entry S.isOpen F₂.inverse_smooth l i r (hWS hy)]
    exact congrArg (fun A : Matrix (Fin n) (Fin n) ℝ => (A i r : ℂ) / (l.factorial : ℂ)) (hj l hl hy)
  · intro l hl y hy
    change faceTaylor F₁.tau l y = faceTaylor F₂.tau l y
    exact congrArg (fun t : ℝ => (t : ℂ) / (l.factorial : ℂ))
      (F₁.tau_jet_eq_of_inverse_jets F₂ (hWS hy) L (fun r hr => hj r hr hy) l hl)
  · intro l hl i y hy
    have hd := metricTangentialDrift_jetComparison F₁ F₂ hW hWS hG₁ hG₂ hAJ i
    change faceTaylor (metricTangentialDrift F₁ i) l y = faceTaylor (metricTangentialDrift F₂ i) l y
    exact congrArg (fun t : ℝ => (t : ℂ) / (l.factorial : ℂ)) (hd.jets l hl hy)

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNNativeCoefficientJetComparison

