      intro x hx
      exact ((ContinuousLinearMap.proj j).analyticAt _).comp
        ((S.analyticAt _).comp (hf x hx)))
  choose U H hU h0 hH hHeq using hscalar
  let A := ⋂ j : Fin m, U j
  let L (j : Fin m) : ℝ →L[ℝ] F :=
    (ContinuousLinearMap.id ℝ ℝ).smulRight (S.symm (Pi.single j 1))
  let G : V → TauCeti.HolderSpace α K F := fun a =>
    ∑ j : Fin m, TauCeti.HolderSpace.compLeftL (L j) (H j a)
  refine ⟨A, G, isOpen_iInter_of_finite hU, mem_iInter.2 h0, ?_, ?_⟩
  · intro a ha
    apply Finset.analyticAt_fun_sum
    intro j hj
    exact ((TauCeti.HolderSpace.compLeftL (α := α) (X := K) (L j)).analyticAt _).comp
      (hH j a (mem_iInter.1 ha j))
  · intro a ha x
    change (∑ j : Fin m, TauCeti.HolderSpace.compLeftL (L j) (H j a)) x = _
    rw [TauCeti.HolderSpace.sum_apply]
    simp only [TauCeti.HolderSpace.compLeftL_apply, L,
      ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.id_apply]
    simp_rw [hHeq _ a (mem_iInter.1 ha _) x]
    apply S.injective
    rw [map_sum]
    simp only [map_smul, S.apply_symm_apply]
    ext j
    simp [Finset.sum_apply, Pi.single_apply, apply_ite]

