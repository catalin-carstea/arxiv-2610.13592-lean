/- Proof support: CoordinateSmoothBootstrap.lean, SHA256 c4684d44347c5f1b5ebdc1a8d1888c9ec6b939048c57c27a62340d97a0ba0054 -/
noncomputable section ProofPart_CoordinateSmoothBootstrap







/- Interior smoothness of the actual classical coordinate solution,
using canonical Sobolev representatives on compactly contained balls.
No boundary regularity or sign condition on the potential is needed. -/
open Set Metric MeasureTheory TauCeti TauCeti.PDE
open scoped ContDiff ENNReal Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem coordinate_classical_smooth_on_precompact
    {U K : Set V} (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    {Ω : TopologicalSpace.Opens V} (hΩK : (Ω : Set V) ⊆ K)
    {a : V → V →L[ℝ] V} {b : V → V} {q u F : V → ℝ}
    (ha : ContDiffOn ℝ ∞ a U) (hb : ContDiffOn ℝ ∞ b U)
    (hq : ContDiffOn ℝ ∞ q U) (hF : ContDiffOn ℝ ∞ F U)
    (hu : ContDiffOn ℝ 2 u U)
    (hsmall : ∀ x ∈ U, ‖a x - ContinuousLinearMap.id ℝ V‖ ≤ 1 / 2)
    (heq : ∀ x ∈ U, coordinateSchrodinger a b q u x = F x) :
    ContDiffOn ℝ ∞ u Ω := by
  have hsub : (Ω : Set V) ⊆ U := hΩK.trans hKU
  have ha1 : ContDiffOn ℝ 1 a U := ha.of_le (by simp)
  obtain ⟨uH, hvalue, _⟩ := W1p.exists_value_gradient_ae_eq_of_contDiffOn_of_isCompact
    (mu := volume) (Omega := Ω) (p := 2) hU (hu.of_le one_le_two) hK hΩK hKU
  have hFLp : MemLp F 2 (volume.restrict (Ω : Set V)) :=
    (hF.continuousOn.mono hKU).memLp_restrict_of_subset_isCompact hK Ω.isOpen.measurableSet hΩK 2
  have hcoeff : MemLp (fun x => energyIntegrand (coordinatePrincipalMatrix (a x))
      (b x + coordinateDivergenceDrift a x) (q x)) ⊤ (volume.restrict (Ω : Set V)) :=
    ((coordinate_energyIntegrand_continuousOn hU ha1 hb.continuousOn hq.continuousOn).mono hKU).memLp_restrict_of_subset_isCompact
      (μ := volume) (E := (ℝ × V) →L[ℝ] (ℝ × V) →L[ℝ] ℝ)
      (f := fun x => energyIntegrand (coordinatePrincipalMatrix (a x))
        (b x + coordinateDivergenceDrift a x) (q x)) hK Ω.isOpen.measurableSet hΩK ⊤
  have hweak : ∀ v : W1p0 volume Ω 2,
      energyFormH1 (mu := volume) (Omega := Ω) (fun x => coordinatePrincipalMatrix (a x))
          (fun x => b x + coordinateDivergenceDrift a x) q uH (v : W1p volume Ω 2) =
        ∫ x in Ω, F x * W1p.value (v : W1p volume Ω 2) x := by
    intro v
    exact coordinate_energyForm_of_classical (μ := volume) (Ω := Ω) (ha1.mono hsub) (hu.mono hsub)
      (hb.continuousOn.mono hsub) (hq.continuousOn.mono hsub) (hF.continuousOn.mono hsub)
      (fun x hx => heq x (hsub hx)) uH hvalue hcoeff hFLp v
  have hforcing : ∀ x ∈ Ω, ∃ W : TopologicalSpace.Opens V, x ∈ W ∧
      ∀ k, ∃ f : Wkp volume W 2 k,
        (Wkp.value k f : V → ℝ) =ᵐ[volume.restrict (W : Set V)] F := by
    intro x hx
    refine ⟨Ω, hx, ?_⟩
    intro k
    exact Wkp.exists_value_ae_eq_of_contDiffOn_of_isCompact (mu := volume) (Omega := Ω) (p := 2)
      k hU (hF.of_le (by simp)) hK hΩK hKU
  have hell := (coordinatePrincipalMatrix_uniformlyEllipticOn hsmall).mono_set hsub
  obtain ⟨g, hg, hug⟩ := hell.exists_contDiffOn_ae_eq_of_contDiffOn
    (Omega := Ω) (u := uH) (a := fun x => coordinatePrincipalMatrix (a x))
    (b := fun x => b x + coordinateDivergenceDrift a x) (c := q) (f := F)
    (fun i j => (coordinatePrincipalMatrix_entry_contDiffOn ha i j).mono hsub)
    ((hb.add (coordinateDivergenceDrift_contDiffOn hU ha)).mono hsub)
    (hq.mono hsub) hforcing hweak
  have hpoint : EqOn u g Ω := Measure.eqOn_open_of_ae_eq (hvalue.symm.trans hug) Ω.isOpen
    (hu.continuousOn.mono hsub) hg.continuousOn
  exact hg.congr (fun x hx => hpoint hx)

without_proof_info in
/-- Smooth interior coefficients and forcing promote the original C2
solution itself to C-infinity on the original open set. -/
theorem coordinate_classical_contDiffOn {U : Set V} (hU : IsOpen U)
    {a : V → V →L[ℝ] V} {b : V → V} {q u F : V → ℝ}
    (ha : ContDiffOn ℝ ∞ a U) (hb : ContDiffOn ℝ ∞ b U)
    (hq : ContDiffOn ℝ ∞ q U) (hF : ContDiffOn ℝ ∞ F U)
    (hu : ContDiffOn ℝ 2 u U)
    (hsmall : ∀ x ∈ U, ‖a x - ContinuousLinearMap.id ℝ V‖ ≤ 1 / 2)
    (heq : ∀ x ∈ U, coordinateSchrodinger a b q u x = F x) :
    ContDiffOn ℝ ∞ u U := by
  intro x hx
  obtain ⟨r, hr, hball⟩ := nhds_basis_closedBall.mem_iff.mp (hU.mem_nhds hx)
  let Ω : TopologicalSpace.Opens V := ⟨ball x r, isOpen_ball⟩
  have hlocal := coordinate_classical_smooth_on_precompact hU (isCompact_closedBall x r) hball
    (Ω := Ω) ball_subset_closedBall ha hb hq hF hu hsmall heq
  have hxΩ : x ∈ Ω := mem_ball_self hr
  exact ((hlocal x hxΩ).contDiffAt (Ω.isOpen.mem_nhds hxΩ)).contDiffWithinAt

end ConformalPoisson

