/- Proof support: CampanatoGradientHolder.lean, SHA256 9846608fa080c35878577be06a20141cb98aff0569dc0c6e5458c27a569ac08c -/
noncomputable section ProofPart_CampanatoGradientHolder


/- A power bound for the L2 oscillation of the actual weak gradient
implies its Holder continuity. This separates the standard Campanato
conclusion from the boundary-dependent forcing comparison. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE
open scoped NNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.Campanato
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_holderOnWith_gradient_of_oscillation_bound {Ω : Opens V}
    (u : W1p volume Ω 2) {S : Set V} {α : ℝ≥0} {R A : ℝ}
    (hα : 0 < α) (hR : 0 < R) (_hA : 0 ≤ A) (hS : thickening R S ⊆ Ω)
    (hdec : ∀ z ∈ S, ∀ t, 0 < t → t ≤ R →
      (∫ x in ball z t, ‖W1p.gradient u x - ⨍ y in ball z t, W1p.gradient u y‖ ^ 2) ≤
        A * t ^ (((n : ℝ) + 1) + 2 * α)) :
    ∃ K : ℝ≥0, HolderOnWith K α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient u : V → V)) S := by
  let ω := volume.real (ball (0 : V) 1)
  have hω : 0 < ω := measureReal_ball_pos volume (0 : V) one_pos
  have hball : ∀ z ∈ S, ball z R ⊆ Ω :=
    fun z hz => (ball_subset_thickening hz R).trans hS
  have hosc : ∀ z ∈ S, ∀ t, 0 < t → t ≤ R →
      ⨍ y in closedBall z t, ‖W1p.gradient u y - ⨍ w in closedBall z t, W1p.gradient u w‖ ≤
        √(A * (1 / ω)) * t ^ (α : ℝ) := by
    intro z hz t ht htR
    have hpre : (∫ x in ball z t, ‖W1p.gradient u x - ⨍ y in ball z t, W1p.gradient u y‖ ^ 2) ≤
        A * 1 * ((t / 1) ^ (n + 1) * (t / 1) ^ (2 * (α : ℝ))) := by
      rw [mul_one, div_one, ← Real.rpow_natCast t (n + 1), ← Real.rpow_add ht]
      simpa only [Nat.cast_add, Nat.cast_one] using hdec z hz t ht htR
    have h := setAverage_closedBall_norm_gradient_sub_le u
      ((ball_subset_ball htR).trans (hball z hz)) ht one_pos hpre
    simpa only [one_pow, mul_one, Real.one_rpow, one_mul, ω] using h
  let B := ‖W1p.gradient u‖ ^ 2 / (ω * R ^ (n + 1)) + 1
  have havg : ∀ z ∈ S, ‖⨍ y in closedBall z R, W1p.gradient u y‖ ≤ B := by
    intro z hz
    have hJ := sq_norm_setAverage_closedBall_gradient_mul_le u (hball z hz)
    have hmass := Lp.setIntegral_norm_sq_le_norm_sq (W1p.gradient u) (hball z hz)
    rw [Measure.addHaar_real_ball_of_pos _ z hR, finrank_euclideanSpace_fin] at hJ
    have hden : 0 < ω * R ^ (n + 1) := by positivity
    have hsquare : ‖⨍ y in closedBall z R, W1p.gradient u y‖ ^ 2 ≤
        ‖W1p.gradient u‖ ^ 2 / (ω * R ^ (n + 1)) := by
      rw [le_div_iff₀ hden]
      calc
        _ = ‖⨍ y in closedBall z R, W1p.gradient u y‖ ^ 2 *
            (R ^ (n + 1) * volume.real (ball (0 : V) 1)) := by dsimp only [ω]; ring
        _ ≤ _ := hJ.trans hmass
    dsimp only [B]
    nlinarith [sq_nonneg (‖⨍ y in closedBall z R, W1p.gradient u y‖ - 1 / 2)]
  exact ⟨_, TauCeti.MeasureTheory.holderOnWith_preciseRepresentative_of_setAverage_norm_sub_le
    hα hR (fun z hz => integrableOn_closedBall_gradient u (hball z hz) le_rfl) hosc havg⟩
end ConformalPoisson.Campanato

end ProofPart_CampanatoGradientHolder

/- Proof support: CampanatoGradientResidual.lean, SHA256 ae90fad14cbd0f3db95a46562cc5f199a73f4eecc1953ec22aeb1efbe094ea85 -/
noncomputable section ProofPart_CampanatoGradientResidual



/- Campanato decay from small local H-minus-one forcing residuals.
The residual on each ball is a genuine L2 field representing the weak
equation there. It may be obtained by subtracting a divergence-free
reference, including the proved tangential jump reference. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE
open scoped NNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.Campanato
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem gradient_oscillation_restrictL {Ω B : Opens V} (hB : B ≤ Ω)
    (u : W1p volume Ω 2) {z : V} {r : ℝ} (hball : ball z r ⊆ B) :
    (∫ x in ball z r, ‖W1p.gradient (W1p.restrictL hB u) x -
      ⨍ y in ball z r, W1p.gradient (W1p.restrictL hB u) y‖ ^ 2) =
    ∫ x in ball z r, ‖W1p.gradient u x - ⨍ y in ball z r, W1p.gradient u y‖ ^ 2 := by
  have hg : (W1p.gradient (W1p.restrictL hB u) : V → V) =ᵐ[volume.restrict (ball z r)]
      (W1p.gradient u : V → V) :=
    ae_restrict_of_ae_restrict_of_subset hball (W1p.gradient_restrictL_ae hB u)
  have hav : (⨍ y in ball z r, W1p.gradient (W1p.restrictL hB u) y) =
      ⨍ y in ball z r, W1p.gradient u y := by
    simp only [setAverage_eq]
    rw [integral_congr_ae hg]
  rw [hav]
  apply integral_congr_ae
  filter_upwards [hg] with x hx
  rw [hx]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_oscillation_bound_of_local_gradient_residuals {Ω : Opens V}
    (u : W1p volume Ω 2) {S : Set V} {α : ℝ≥0} {R M : ℝ}
    (hαlt : α < 1) (hR : 0 < R) (hM : 0 ≤ M) (hS : thickening R S ⊆ Ω)
    (hres : ∀ z ∈ S, ∀ r, 0 < r → r ≤ R →
      ∀ hB : (⟨ball z r, isOpen_ball⟩ : Opens V) ≤ Ω,
        ∃ G : Lp V 2 (volume.restrict (ball z r)),
          (∀ v : W1p0 volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2,
            energyFormH1 (fun _ => 1) 0 0 (W1p.restrictL hB u)
              (v : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2) =
                ⟪G, W1p.gradient (v : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2)⟫_ℝ) ∧
          ‖G‖ ^ 2 ≤ M * r ^ (((n : ℝ) + 1) + 2 * α)) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ z ∈ S, ∀ t, 0 < t → t ≤ R →
