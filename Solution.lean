    AnalyticAt ℝ (fun z => pulledBackHolderOperator (A z) (B z) (Q z) (K z) C (a z)) p := by
  have hH : AnalyticAt ℝ (fun z => ∑ i : Fin d, pullbackHessianTerm (A z) (K z) i) p := by
    apply Finset.analyticAt_fun_sum
    intro i hi
