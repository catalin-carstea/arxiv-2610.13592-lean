    ring
  · simp [hi, Ne.symm hi]

without_proof_info in
theorem principalCongruence_boundaryReflection_normal_form
    (A : V →L[ℝ] V) (hAn : A e = e) (hA0 : ∀ v : V, A v 0 = v 0) :
    principalCongruence
      (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap A = A := by
  apply ContinuousLinearMap.ext
  intro v
  rw [principalCongruence_apply, boundaryReflection_adjoint]
  exact boundaryReflection_conjugate_normal_form A hAn hA0 v

without_proof_info in
theorem boundaryReflection_linearEquiv_symm :
    (boundaryReflection n).toContinuousLinearEquiv.symm.toContinuousLinearMap =
      (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap := by
  apply ContinuousLinearMap.ext
  intro v
  change (boundaryReflection n).symm v = boundaryReflection n v
  exact boundaryReflection_symm_apply v

without_proof_info in
theorem affinePrincipalCoefficient_boundaryReflection
    (A : V → V →L[ℝ] V) (x : V)
    (hAn : A (boundaryReflection n x) e = e)
    (hA0 : ∀ v : V, A (boundaryReflection n x) v 0 = v 0) :
