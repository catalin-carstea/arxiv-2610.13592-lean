noncomputable section ProofPart_InteriorAnalytic_PreconditionedThreshold


/- Small abstract perturbation lemmas keep the concrete Holder operator
definitions opaque during the final kernel check. -/
open scoped NNReal
namespace ConformalPoisson
variable {X Y : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

without_proof_info in
theorem clm_leftInverse_of_rightInverse (L : X →L[ℝ] Y) (T : Y →L[ℝ] X)
    (hinj : Function.Injective L) (hT : ∀ y, L (T y) = y) :
    T.comp L = ContinuousLinearMap.id ℝ X := by
  apply ContinuousLinearMap.ext
  intro x
  apply hinj
  exact hT (L x)

without_proof_info in
theorem isInvertible_preconditioned_of_norm_sub_lt
    (L M : X →L[ℝ] Y) (T : Y →L[ℝ] X)
    (hleft : T.comp L = ContinuousLinearMap.id ℝ X)
    (hsmall : ‖T‖ * ‖M - L‖ < 1) : (T.comp M).IsInvertible := by
  have h := isInvertible_preconditioned_of_small_perturbation L T hleft (M - L) hsmall
  simpa only [add_sub_cancel] using h

without_proof_info in
theorem exists_operator_perturbation_threshold (T : Y →L[ℝ] X) {D : ℝ} (hD : 0 < D) :
    ∃ δ : ℝ≥0, 0 < δ ∧ ∀ R : X →L[ℝ] Y, ‖R‖ ≤ D * δ → ‖T‖ * ‖R‖ < 1 := by
  let δr : ℝ := (2 * D * (‖T‖ + 1))⁻¹
  have hδr : 0 < δr := inv_pos.2 (by positivity)
  let δ : ℝ≥0 := ⟨δr, hδr.le⟩
  refine ⟨δ, hδr, ?_⟩
  intro R hR
  have hδeq : 2 * D * (‖T‖ + 1) * (δ : ℝ) = 1 :=
    mul_inv_cancel₀ (ne_of_gt (by positivity : 0 < 2 * D * (‖T‖ + 1)))
  have hhalf : ‖T‖ * (D * (δ : ℝ)) ≤ 1 / 2 := by
    have hn : 0 ≤ D * (δ : ℝ) := mul_nonneg hD.le δ.coe_nonneg
    nlinarith
  exact ((mul_le_mul_of_nonneg_left hR (norm_nonneg T)).trans hhalf).trans_lt (by norm_num)

end ConformalPoisson

end ProofPart_InteriorAnalytic_PreconditionedThreshold

