/- Identify the half-space estimate's trace equation with the actual native
Schrodinger equation. In particular the forcing sign and first-order drift
are fixed by the native operator, rather than supplied as extra premises. -/
open Bundle Set Metric MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal InnerProductSpace BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

section Trace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] {ι : Type*} [Fintype ι]

without_proof_info in
theorem trace_comp_iteratedGradientChain_one (b : OrthonormalBasis ι ℝ E)
    (A : E →L[ℝ] E) {u : E → ℝ} {x : E} (hu : ContDiffAt ℝ 2 u x) :
    traceCLM ℝ E (A ∘L iteratedGradientChain u 1 x) =
      ∑ i, fderiv ℝ (fderiv ℝ u) x (b i) (A (b i)) := by
  rw [ContinuousLinearMap.traceCLM_comp_comm, traceCLM_apply,
    LinearMap.trace_eq_sum_inner _ b]
  refine Finset.sum_congr rfl fun i _ => ?_
  change ⟪b i, iteratedGradientChain u 1 x (A (b i))⟫_ℝ = _
  rw [real_inner_comm, inner_iteratedGradientChain_one]
  exact hu.isSymmSndFDerivAt (by norm_num) _ _
end Trace

without_proof_info in
theorem coordinateSchrodinger_eq_negative_trace {d : ℕ}
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q u : EuclideanSpace ℝ (Fin d) → ℝ) {x : EuclideanSpace ℝ (Fin d)}
    (hu : ContDiffAt ℝ 2 u x) :
    coordinateSchrodinger a b q u x =
      -traceCLM ℝ _ (a x ∘L iteratedGradientChain u 1 x) +
        fderiv ℝ u x (b x) + q x * u x := by
  rw [trace_comp_iteratedGradientChain_one (EuclideanSpace.basisFun (Fin d) ℝ) _ hu]
  simp only [coordinateSchrodinger, EuclideanSpace.basisFun_apply]

section Native
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
/-- The exact classical trace equation on a real boundary cap. It applies
to arbitrary signed potentials and does not require nonresonance. -/
theorem native_boundary_chart_hessian_trace (g : Metric (n := n) (M := M))
