noncomputable section ProofPart_ParametricNormalTrace



/- Joint regularity of differentiation along a smooth spatial vector field in
a family. This will supply differentiation under the boundary integral. -/
open Bundle Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E Y H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [TopologicalSpace H]
  {I : ModelWithCorners ℝ Y H} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I ω M]

without_proof_info in
theorem contMDiffAt_parametric_vector_derivative {G : E → M → ℝ} {x : E} {y : M}
    (hG : ContMDiffAt (𝓘(ℝ, E).prod I) 𝓘(ℝ) ∞ (uncurry G) (x, y))
    (N : (z : M) → TangentSpace I z)
    (hN : ContMDiffAt I I.tangent ∞ (fun z => (⟨z, N z⟩ : TangentBundle I M)) y) :
    ContMDiffAt (𝓘(ℝ, E).prod I) 𝓘(ℝ) ∞
      (fun r : E × M => mvfderiv I (G r.1) r.2 (N r.2)) (x, y) := by
  letI : IsManifold (𝓘(ℝ, E).prod I) (∞ + 1) (E × M) := by
    simpa using (inferInstance : IsManifold (𝓘(ℝ, E).prod I) ∞ (E × M))
  have hzero : ContMDiffAt 𝓘(ℝ, E) (𝓘(ℝ, E)).tangent ∞
      (fun z : E => (⟨z, 0⟩ : TangentBundle 𝓘(ℝ, E) E)) x :=
    (contMDiff_zeroSection ℝ (TangentSpace 𝓘(ℝ, E) : E → Type _)).contMDiffAt
  have hfield : ContMDiffAt (𝓘(ℝ, E).prod I) (𝓘(ℝ, E).prod I).tangent ∞
      (fun r : E × M => (⟨r, (0, N r.2)⟩ : TangentBundle (𝓘(ℝ, E).prod I) (E × M)))
      (x, y) :=
    (contMDiff_equivTangentBundleProd_symm (I := 𝓘(ℝ, E)) (M := E) (I' := I) (M' := M)
      (n := ∞)).contMDiffAt.comp (x, y)
        ((hzero.comp (x, y) contMDiffAt_fst).prodMk (hN.comp (x, y) contMDiffAt_snd))
  have hD := (hG.contMDiffAt_mvfderiv_apply (m := ∞) (by simp)).comp (x, y) hfield
  have hnear := (contMDiffAt_iff_contMDiffAt_nhds (n := 1) (by simp)).mp
    (hG.of_le (by simp))
  refine hD.congr_of_eventuallyEq (hnear.mono fun r hr => ?_)
  exact congrArg (fun A => A (N r.2))
    (TauCeti.mvfderiv_curry_right r.1 r.2 (hr.mdifferentiableAt (by simp)))

end ConformalPoisson

