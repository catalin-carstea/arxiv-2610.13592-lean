noncomputable section ProofPart_ConformalPower







/- Exact conversion of the integrated conformal combination to the paper's power. -/

namespace ConformalPoisson

without_proof_info in
theorem conformal_factor_eq_power_constant (d : ℕ) (hd : 3 ≤ d)
    (a c C : ℝ) (ha : 0 < a) (hc : 0 < c) (hC : 0 < C)
    (h : c⁻¹ * a ^ (((d : ℝ) - 2) / 4) = C) :
    a = C ^ (4 / ((d : ℝ) - 2)) * c ^ (4 / ((d : ℝ) - 2)) := by
  have hd' : (d : ℝ) - 2 ≠ 0 := by
    have : (3 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hpow : a ^ (((d : ℝ) - 2) / 4) = C * c := by
    have hh := congrArg (fun z : ℝ => c * z) h
    rw [← mul_assoc, mul_inv_cancel₀ hc.ne', one_mul] at hh
    exact hh.trans (mul_comm c C)
  have hprod : (((d : ℝ) - 2) / 4) * (4 / ((d : ℝ) - 2)) = 1 := by
    field_simp
  calc
    a = (a ^ (((d : ℝ) - 2) / 4)) ^ (4 / ((d : ℝ) - 2)) := by
      simpa only [hprod, Real.rpow_one] using
        (Real.rpow_mul ha.le (((d : ℝ) - 2) / 4) (4 / ((d : ℝ) - 2)))
    _ = (C * c) ^ (4 / ((d : ℝ) - 2)) := congrArg (fun z : ℝ => z ^ (4 / ((d : ℝ) - 2))) hpow
    _ = _ := Real.mul_rpow hC.le hc.le

end ConformalPoisson

end ProofPart_ConformalPower

