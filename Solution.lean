/- The actual smooth representative satisfies the classical native equation.
Green's identity is used only with tests supported in the interior chart cap. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.BoundaryChartLocalization
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [CompactSpace M] [IsManifold I 2 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
  [MeasurableSpace M] [BorelSpace M]
local notation "V" => EuclideanSpace ℝ (Fin d)
local instance classicalReadbackContinuousMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := 1)
open DirichletSobolev
variable {c : M} (L : BoundaryChartLocalization (I := I) c)


variable [T2Space M] [IsManifold I ∞ M]

without_proof_info in
/-- The residual of the actual classical native equation has zero
integral against every transplanted test in the inner cap. -/
theorem integral_classical_residual_eq_zero {q F : M → ℝ}
    (hq : Continuous q) (hF : Continuous F)
    (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x})
    (hu : ∀ v : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x},
      schrodingerForm (I := I) {x : M | I.IsBoundaryPoint x}
          (ContinuousMap.toLp ⊤ (riemannianVolume I M) ℝ ⟨q, hq⟩) u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume I M) ℝ ⟨F, hF⟩,
          valueL (I := I) {x : M | I.IsBoundaryPoint x} v⟫_ℝ)
    (w : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x})
    (hval : (valueL (I := I) {x : M | I.IsBoundaryPoint x} u : M → ℝ)
      =ᵐ[riemannianVolume I M] w.val)
    (v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x})
    (hv : tsupport v.val ⊆ (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V)) :
    (∫ x, (-laplaceBeltrami I w.val x + q x * w.val x - F x) * v.val x
      ∂riemannianVolume I M) = 0 := by
  have he := L.smooth_energy_eq_forcing_of_native_value_ae hq hF u hu w hval v hv
  have hgreen := integral_mul_laplaceBeltrami_of_interior_chart c
    (v.val.contMDiff.of_le (by simp)) (w.val.contMDiff.of_le (by simp))
    (show tsupport v.val ⊆ (chartAt H c).source from fun x hx => by
      simpa only [extChartAt_source] using (hv hx).1)
    (show extChartAt I c '' tsupport v.val ⊆ interior (extChartAt I c).target from by
      rintro z ⟨x, hx, rfl⟩
      exact L.innerCap_subset_interior_target (hv hx).2)
  have hig : Integrable (fun x => ⟪mgradient I w.val x, mgradient I v.val x⟫_ℝ)
      (riemannianVolume I M) :=
    (continuous_inner_mgradient (w.val.contMDiff.of_le (by simp))
      (v.val.contMDiff.of_le (by simp))).integrable_of_compactSpace
  have hip : Integrable (fun x => q x * w.val x * v.val x) (riemannianVolume I M) :=
    ((hq.mul w.val.contMDiff.continuous).mul v.val.contMDiff.continuous).integrable_of_compactSpace
  have hiF : Integrable (fun x => F x * v.val x) (riemannianVolume I M) :=
    (hF.mul v.val.contMDiff.continuous).integrable_of_compactSpace
  have hiL : Integrable (fun x => v.val x * laplaceBeltrami I w.val x) (riemannianVolume I M) :=
    (v.val.contMDiff.continuous.mul
      (continuous_laplaceBeltrami (w.val.contMDiff.of_le (by simp)))).integrable_of_compactSpace
  have hswap : (∫ x, ⟪mgradient I v.val x, mgradient I w.val x⟫_ℝ ∂riemannianVolume I M) =
      ∫ x, ⟪mgradient I w.val x, mgradient I v.val x⟫_ℝ ∂riemannianVolume I M := by
    apply integral_congr_ae
    exact ae_of_all _ fun x => real_inner_comm _ _
  rw [hswap] at hgreen
  rw [integral_add hig hip] at he
  calc
    _ = ∫ x, -(v.val x * laplaceBeltrami I w.val x) + q x * w.val x * v.val x - F x * v.val x
        ∂riemannianVolume I M := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => by ring
    _ = -(∫ x, v.val x * laplaceBeltrami I w.val x ∂riemannianVolume I M) +
        (∫ x, q x * w.val x * v.val x ∂riemannianVolume I M) -
        ∫ x, F x * v.val x ∂riemannianVolume I M := by
      rw [integral_sub (f := fun x => -(v.val x * laplaceBeltrami I w.val x) + q x * w.val x * v.val x)
        (g := fun x => F x * v.val x) (hiL.neg.add hip) hiF,
        integral_add (f := fun x => -(v.val x * laplaceBeltrami I w.val x))
          (g := fun x => q x * w.val x * v.val x) hiL.neg hip, integral_neg]
    _ = 0 := by linarith
without_proof_info in
theorem classical_equation_on_innerCap_of_native_value_ae {q F : M → ℝ}
    (hq : Continuous q) (hF : Continuous F)
    (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x})
    (hu : ∀ v : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x},
      schrodingerForm (I := I) {x : M | I.IsBoundaryPoint x}
          (ContinuousMap.toLp ⊤ (riemannianVolume I M) ℝ ⟨q, hq⟩) u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume I M) ℝ ⟨F, hF⟩,
          valueL (I := I) {x : M | I.IsBoundaryPoint x} v⟫_ℝ)
    (w : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x})
    (hval : (valueL (I := I) {x : M | I.IsBoundaryPoint x} u : M → ℝ)
      =ᵐ[riemannianVolume I M] w.val)
 :
    ∀ x ∈ (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V),
      -laplaceBeltrami I w.val x + q x * w.val x = F x := by
  let G : M → ℝ := fun x => -laplaceBeltrami I w.val x + q x * w.val x - F x
  let R : V → ℝ := fun z => chartVolumeDensity (I := I) c ((extChartAt I c).symm z) *
    G ((extChartAt I c).symm z)
  have hG : Continuous G :=
    (((continuous_laplaceBeltrami (w.val.contMDiff.of_le (by simp))).neg.add
      (hq.mul w.val.contMDiff.continuous)).sub hF)
  have hR : ContinuousOn R L.innerCap :=
    ((continuousOn_chartDensity_target (I := I) c).mul
      (hG.comp_continuousOn (continuousOn_extChartAt_symm c))).mono
        (L.innerCap_subset_interior_target.trans interior_subset)
  have hz := L.innerCap.isOpen.ae_eq_zero_of_integral_contDiff_smul_eq_zero
    (μ := (Module.finBasis ℝ V).addHaar) (hR.locallyIntegrableOn L.innerCap.isOpen.measurableSet) (by
      intro φ hφ hφc hφs
      let Φ : 𝓓(L.innerCap, ℝ) := ⟨φ, hφ, hφc, hφs⟩
      obtain ⟨v, hv, hread⟩ := L.exists_native_test_transplant Φ
      have hi := L.integral_classical_residual_eq_zero hq hF u hu w hval v hv
      change (∫ x, G x * v.val x ∂riemannianVolume I M) = 0 at hi
      have heq : (∫ x, G x * v.val x ∂riemannianVolume I M) =
          ∫ z in (L.innerCap : Set V), φ z * R z ∂(Module.finBasis ℝ V).addHaar := by
        calc
          _ = ∫ x in (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V),
              G x * v.val x ∂riemannianVolume I M := by
            symm
            apply setIntegral_eq_integral_of_forall_compl_eq_zero
            intro x hx
            rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hv h)), mul_zero]
          _ = ∫ z in (L.innerCap : Set V), chartVolumeDensity (I := I) c ((extChartAt I c).symm z) *
              (G ((extChartAt I c).symm z) * v.val ((extChartAt I c).symm z))
                ∂(Module.finBasis ℝ V).addHaar :=
            setIntegral_native_chart_preimage c L.innerCap.isOpen
              (L.innerCap_subset_interior_target.trans interior_subset) _
          _ = _ := by
            apply setIntegral_congr_fun L.innerCap.isOpen.measurableSet
            intro z hz
            change chartVolumeDensity (I := I) c ((extChartAt I c).symm z) *
              (G ((extChartAt I c).symm z) * v.val ((extChartAt I c).symm z)) = φ z * R z
            rw [show v.val ((extChartAt I c).symm z) = φ z from hread z hz]
            change _ = φ z * (chartVolumeDensity (I := I) c ((extChartAt I c).symm z) *
              G ((extChartAt I c).symm z))
            ring
      have hi' := heq.symm.trans hi
      have hall : (∫ z, φ z * R z ∂(Module.finBasis ℝ V).addHaar) =
          ∫ z in (L.innerCap : Set V), φ z * R z ∂(Module.finBasis ℝ V).addHaar := by
        symm
        apply setIntegral_eq_integral_of_forall_compl_eq_zero
        intro z hz
        rw [image_eq_zero_of_notMem_tsupport (fun h => hz (hφs h)), zero_mul]
      simpa only [smul_eq_mul] using hall.trans hi')
  have ha : R =ᵐ[(Module.finBasis ℝ V).addHaar.restrict L.innerCap] 0 := by
    rw [Filter.EventuallyEq, ae_restrict_iff' L.innerCap.isOpen.measurableSet]
    exact hz
  have hzero : EqOn R 0 L.innerCap := Measure.eqOn_open_of_ae_eq ha L.innerCap.isOpen hR continuousOn_const
  intro x hx
  have h := hzero hx.2
  change chartVolumeDensity (I := I) c ((extChartAt I c).symm (extChartAt I c x)) *
    G ((extChartAt I c).symm (extChartAt I c x)) = 0 at h
  rw [(extChartAt I c).left_inv hx.1] at h
  have hρ : chartVolumeDensity (I := I) c x ≠ 0 :=
    (chartVolumeDensity_pos (I := I) c (by simpa only [TangentBundle.trivializationAt_baseSet,
      extChartAt_source] using hx.1)).ne'
  have hGx := (mul_eq_zero.mp h).resolve_left hρ
  change -laplaceBeltrami I w.val x + q x * w.val x - F x = 0 at hGx
  linarith

end ConformalPoisson.BoundaryChartLocalization

end ProofPart_NativeClassicalReadback

/- Proof support: NativeDirichletFredholmCaller.lean, SHA256 525869a12ee1735af48cd3abbf78e6f010aca5bc54fb31b2fc05e953fd532b90 -/
noncomputable section ProofPart_NativeDirichletFredholmCaller



/- Actual native forced Dirichlet solvability from the two precise weak
bridges still to be proved: compactness of the native zero-trace value map
and smooth boundary regularity with weak/native operator compatibility.
These are conditional helper inputs, not added literature premises. -/
open Bundle Set TauCeti MeasureTheory
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]

/-- The specific native Rellich compactness obligation. -/
def NativeZeroTraceCompactness (g : Metric (n := n) (M := M)) : Prop :=
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  IsCompactOperator (DirichletSobolev.valueL (I := 𝓡∂ (n + 1)) ((𝓡∂ (n + 1)).boundary M))

/-- Smooth weak solutions have actual smooth zero-boundary native
representatives, including equality in canonical H1, not merely pointwise
claims about a chosen L2 representative. -/
def NativeWeakDirichletRegularity (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) : Prop :=
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let Q := ContinuousMap.toLp ⊤ (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨q, hq.continuous⟩
  ∀ (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
      (u : DirichletSobolev.zeroTraceSubmodule (I := 𝓡∂ (n + 1)) ((𝓡∂ (n + 1)).boundary M)),
    (∀ v, DirichletSobolev.schrodingerForm ((𝓡∂ (n + 1)).boundary M) Q u v =
      ⟪ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨F, hF.continuous⟩,
        DirichletSobolev.valueL ((𝓡∂ (n + 1)).boundary M) v⟫_ℝ) →
    ∃ (w : M → ℝ) (hw : IsZeroDirichletSolution g q F w),
      u.val = Manifold.SobolevH1.ofSmooth ⟨w, hw.1⟩

without_proof_info in
/-- A checked conditional caller for the actual native inverse: smooth
nonresonance eliminates the WEAK kernel only through the stated regularity
bridge; no positivity or coercivity of the original signed potential is assumed. -/
theorem exists_zeroDirichletSolution_of_weak_bridges
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hcompact : NativeZeroTraceCompactness g) (hregularity : NativeWeakDirichletRegularity g q hq)
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F) :
    ∃ w : M → ℝ, IsZeroDirichletSolution g q F w := by
  let : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let B := (𝓡∂ (n + 1)).boundary M
  let Q := ContinuousMap.toLp ⊤ (riemannianVolume (𝓡∂ (n + 1)) M) ℝ ⟨q, hq.continuous⟩
  have hker : ∀ u : DirichletSobolev.zeroTraceSubmodule (I := 𝓡∂ (n + 1)) B,
      (∀ v, DirichletSobolev.schrodingerForm B Q u v = 0) → u = 0 := by
    intro u hu
    have hweak : ∀ v, DirichletSobolev.schrodingerForm B Q u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ
          (⟨(0 : M → ℝ), continuous_const⟩ : C(M, ℝ)), DirichletSobolev.valueL B v⟫_ℝ := by
      intro v
      have hzero : ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ
          (⟨(0 : M → ℝ), continuous_const⟩ : C(M, ℝ)) = 0 := by
        change ContinuousMap.toLp 2 (riemannianVolume (𝓡∂ (n + 1)) M) ℝ 0 = 0
        exact map_zero _
      rw [hzero, inner_zero_left]
      exact hu v
    obtain ⟨w, hw, heq⟩ := hregularity 0 contMDiff_const u hweak
    have hzero : w = 0 := hNR w ⟨hw.1, hw.2.1, hw.2.2⟩
