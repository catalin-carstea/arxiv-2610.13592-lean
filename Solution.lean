noncomputable section ProofPart_ConformalMetricPower




/- The integrated scalar identity gives the actual constant-times-gauge metric. -/

open Bundle
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem exists_const_conformalGaugeMetric_of_combination
    (hdim : 2 ≤ n) (g h : Metric (n := n) (M := M)) (a c : M → ℝ)
    (ha : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a) (hapos : ∀ x, 0 < a x)
    (hc : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ c) (hcpos : ∀ x, 0 < c x)
    (hmetric : h = g.rescale a ha hapos) (C : ℝ) (hC : 0 < C)
    (hconst : ∀ x, (c x)⁻¹ * (a x) ^ (((n + 1 : ℝ) - 2) / 4) = C) :
    ∃ k : ℝ, ∃ hk : 0 < k,
      h = (conformalGaugeMetric g c hc hcpos).rescale (fun _ => k) contMDiff_const (fun _ => hk) := by
  let k := C ^ conformalGaugeExponent n
  have hk : 0 < k := Real.rpow_pos_of_pos hC _
  refine ⟨k, hk, ?_⟩
  rw [hmetric]
  apply ContMDiffRiemannianMetric.ext
  intro x v w
  rw [ContMDiffRiemannianMetric.rescale_inner,
    ContMDiffRiemannianMetric.rescale_inner]
  have hax := conformal_factor_eq_power_constant (n + 1) (by omega)
    (a x) (c x) C (hapos x) (hcpos x) hC
    (by simpa only [Nat.cast_add, Nat.cast_one] using hconst x)
  change a x * g.inner x v w = k * ((conformalGaugeMetric g c hc hcpos).inner x v w)
  rw [hax]
  simp only [conformalGaugeMetric, ContMDiffRiemannianMetric.rescale_inner, k,
    conformalGaugeExponent, Nat.cast_add, Nat.cast_one]
  ring

end ConformalPoisson

end ProofPart_ConformalMetricPower

