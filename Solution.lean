open Set Metric Filter TopologicalSpace TauCeti TauCeti.PDE EuclideanGeometry
open scoped NNReal ContDiff Laplacian Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e₀" => (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ))

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem exists_local_holderOnWith_hessian_ne_sphere_pole
    (hα : 0 < α) (hαlt : α < 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) (u : V → ℝ)
    (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1))
    (hc : ContinuousOn u (closedBall (0 : V) 1)) (hzero : EqOn u 0 (sphere (0 : V) 1))
    (heq : ∀ y ∈ ball (0 : V) 1, -Δ u y = DirichletHolder.domainRead (closedBall 0 1) f y)
    {p : V} (hp : p ∈ sphere (0 : V) 1) (hne : p ≠ -e₀) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ K : ℝ≥0, HolderOnWith K α
      (fderiv ℝ (fderiv ℝ u)) (ball p δ ∩ ball (0 : V) 1) := by
  let z := chartMap n p
  let g := chartKelvin u
  let T := ball z 1 ∩ {y : V | 0 < y 0}
  have hcoord : Continuous (fun y : V => y 0) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous
  have hT : IsOpen T := isOpen_ball.inter (isOpen_lt continuous_const hcoord)
  have hlin : IsLinearMap ℝ (fun y : V => y 0) := by
    constructor
    · intro x y; simp
    · intro a x; simp
  have hconv : Convex ℝ T := (convex_ball z 1).inter (convex_halfSpace_gt hlin 0)
  have hg : ContDiffOn ℝ 2 g T := (contDiffOn_chartKelvin hu).mono inter_subset_right
  obtain ⟨KH, hKH⟩ := exists_holderOnWith_chartKelvin_hessian_halfBall hα hαlt f u hu hc hzero heq
    z (chartMap_zero_of_mem_sphere hp hne)
  obtain ⟨⟨K0, h0⟩, ⟨K1, h1⟩, ⟨K2, h2⟩⟩ := exists_bounded_holder_jets_of_hessian hT hconv
    (isBounded_ball.subset inter_subset_left) hαlt.le hg hKH
  obtain ⟨δ, hδ, hδpole, hδmap, _⟩ := exists_compact_chart_neighborhood hp hne
  let C := closedBall p δ
  let S := ball p δ ∩ ball (0 : V) 1
  have hC : IsCompact C := isCompact_closedBall p δ
  have hSC : S ⊆ C := fun y hy => ball_subset_closedBall hy.1
  have hmap : MapsTo (chartMap n) S T := fun y hy =>
    ⟨hδmap (hSC hy), chartMap_pos_of_mem_ball hy.2⟩
  have hΦsmooth : ∀ y ∈ C, ContDiffAt ℝ ∞ (chartMap n) y :=
    fun y hy => EuclideanGeometry.contDiffAt_inversion (hδpole y hy)
  obtain ⟨L, hL⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (fun y hy => (hΦsmooth y hy).of_le (by simp)) (α := 1) le_rfl
  have hLip : LipschitzOnWith L (chartMap n) S := (holderOnWith_one.mp hL.2).mono hSC
  obtain ⟨_, LD, LH, _, hD, hH⟩ := exists_holderBounds_jets_of_contDiffAt_isCompact hC hΦsmooth hαlt.le
  obtain ⟨P0, P1, P2, hP, hDP, hHP⟩ := exists_holderBounds_jets_of_contDiffAt_isCompact hC
    (fun y hy => contDiffAt_inverseChartWeight (hδpole y hy)) hαlt.le
  obtain ⟨K, hK⟩ := exists_holderOnWith_hessian_weighted_comp (S := S) (g := g)
    (Φ := chartMap n) (ψ := inverseChartWeight n)
    (fun y hy => (hg _ (hmap hy)).contDiffAt (hT.mem_nhds (hmap hy)))
    (fun y hy => (hΦsmooth y (hSC hy)).of_le (by simp))
    (fun y hy => contDiffAt_inverseChartWeight (hδpole y (hSC hy)))
    (h0.comp_lipschitz hLip hmap) (h1.comp_lipschitz hLip hmap) (h2.comp_lipschitz hLip hmap)
    (hD.restrict_set hSC) (hH.restrict_set hSC)
    (hP.restrict_set hSC) (hDP.restrict_set hSC) (hHP.restrict_set hSC)
  have hHeq : EqOn (fderiv ℝ (fderiv ℝ (fun y => inverseChartWeight n y * g (chartMap n y))))
      (fderiv ℝ (fderiv ℝ u)) S := by
    intro y hy
    have heqN : (fun y => inverseChartWeight n y * g (chartMap n y)) =ᶠ[𝓝 y] u := by
      filter_upwards [isOpen_compl_singleton.mem_nhds (hδpole y (hSC hy))] with w hw
      exact recover_from_chartKelvin u hw
    exact heqN.fderiv.fderiv_eq
  refine ⟨δ, hδ, K, HolderOnWith.of_dist_le ?_⟩
  intro x hx y hy
  rw [← hHeq hx, ← hHeq hy]
  exact hK.dist_le hx hy
end ConformalPoisson.SphereFlattening

end ProofPart_SphereInverseHessian

/- Proof support: BallNegation.lean, SHA256 58d2b7d41ec33aff9777d332ab0d1c2d9a9b725112dc5051d0fe44510da2fdd2 -/
noncomputable section ProofPart_BallNegation


/- Negation preserves the actual ball forcing, classical equation
and Hessian Holder estimates. This supplies the second sphere chart
at the first inversion's pole. -/
open Set Metric Filter TopologicalSpace TauCeti TauCeti.PDE
open scoped NNReal ContDiff Laplacian Topology BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def closedBallNeg (x : closedBall (0 : V) 1) : closedBall (0 : V) 1 :=
  ⟨-x.val, by simpa only [mem_closedBall, dist_zero_right, norm_neg] using x.property⟩

def negateForcing (f : HolderSpace α (closedBall (0 : V) 1) ℝ) :
    HolderSpace α (closedBall (0 : V) 1) ℝ := by
  let g : closedBall (0 : V) 1 → ℝ := fun x => f (closedBallNeg x)
  have hg : Continuous g := f.continuous.comp (by
    apply Continuous.subtype_mk
    exact continuous_subtype_val.neg)
  have hG : HolderWith ‖f‖₊ α g := by
    intro x y
    simpa only [g, closedBallNeg, Subtype.edist_eq, edist_neg_neg] using
      f.holderWith_nnnorm (closedBallNeg x) (closedBallNeg y)
  exact HolderSpace.ofBoundedContinuousFunction (BoundedContinuousFunction.mkOfCompact ⟨g, hg⟩) hG.memHolder

without_proof_info in
theorem domainRead_negateForcing (f : HolderSpace α (closedBall (0 : V) 1) ℝ)
    {x : V} (hx : x ∈ closedBall (0 : V) 1) :
    DirichletHolder.domainRead (closedBall 0 1) (negateForcing f) x =
      DirichletHolder.domainRead (closedBall 0 1) f (-x) := by
  have hnx : -x ∈ closedBall (0 : V) 1 := by
    simpa only [mem_closedBall, dist_zero_right, norm_neg] using hx
  rw [DirichletHolder.domainRead_of_mem _ _ hx, DirichletHolder.domainRead_of_mem _ _ hnx]
  simp only [negateForcing, HolderSpace.ofBoundedContinuousFunction_apply]
  rfl

without_proof_info in
theorem hessian_comp_neg {u : V → ℝ} {x : V} (hu : ContDiffAt ℝ 2 u (-x)) :
    fderiv ℝ (fderiv ℝ (fun y => u (-y))) x = fderiv ℝ (fderiv ℝ u) (-x) := by
  have hN : ContDiffAt ℝ 2 (fun y : V => -y) x := contDiffAt_id.neg
  ext v w
  have hchain := fderiv_fderiv_comp_apply hu hN v w
  have hD : fderiv ℝ (fun y : V => -y) = fun _ => -(ContinuousLinearMap.id ℝ V) :=
    funext fun y => ((hasFDerivAt_id y).neg).fderiv
  rw [hD] at hchain
  have hD2 : fderiv ℝ (fun _ : V => -(ContinuousLinearMap.id ℝ V)) x = 0 :=
    (hasFDerivAt_const (-(ContinuousLinearMap.id ℝ V)) x).fderiv
  rw [hD2] at hchain
  simpa only [Function.comp_def, fderiv_const,
    ContinuousLinearMap.neg_apply, ContinuousLinearMap.id_apply, map_neg,
    neg_neg, Pi.neg_apply, map_zero, ContinuousLinearMap.zero_apply, add_zero] using hchain

without_proof_info in
theorem negated_ball_classical_data
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) {u : V → ℝ}
    (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1))
    (hc : ContinuousOn u (closedBall (0 : V) 1)) (hzero : EqOn u 0 (sphere (0 : V) 1))
    (heq : ∀ y ∈ ball (0 : V) 1, -Δ u y = DirichletHolder.domainRead (closedBall 0 1) f y) :
    ContDiffOn ℝ 2 (fun y => u (-y)) (ball (0 : V) 1) ∧
      ContinuousOn (fun y => u (-y)) (closedBall (0 : V) 1) ∧
      EqOn (fun y => u (-y)) 0 (sphere (0 : V) 1) ∧
      ∀ y ∈ ball (0 : V) 1, -Δ (fun y => u (-y)) y =
        DirichletHolder.domainRead (closedBall 0 1) (negateForcing f) y := by
  have hmapB : MapsTo (fun y : V => -y) (ball (0 : V) 1) (ball 0 1) := by
    intro y hy
    simpa only [mem_ball, dist_zero_right, norm_neg] using hy
  have hmapC : MapsTo (fun y : V => -y) (closedBall (0 : V) 1) (closedBall 0 1) := by
    intro y hy
    simpa only [mem_closedBall, dist_zero_right, norm_neg] using hy
  refine ⟨hu.comp contDiffOn_id.neg hmapB, hc.comp continuousOn_id.neg hmapC, ?_, ?_⟩
  · intro y hy
    exact hzero (by simpa only [mem_sphere, dist_zero_right, norm_neg] using hy)
  · intro y hy
    have hΔ := congrFun (laplacian_comp_smul_right (-1 : ℝ) u) y
    simp only [neg_one_smul, neg_sq, one_pow, one_smul] at hΔ
    rw [hΔ, heq _ (hmapB hy), domainRead_negateForcing f (ball_subset_closedBall hy)]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_local_holderOnWith_hessian_on_sphere
    (hα : 0 < α) (hαlt : α < 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) (u : V → ℝ)
    (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1))
    (hc : ContinuousOn u (closedBall (0 : V) 1)) (hzero : EqOn u 0 (sphere (0 : V) 1))
    (heq : ∀ y ∈ ball (0 : V) 1, -Δ u y = DirichletHolder.domainRead (closedBall 0 1) f y)
    {p : V} (hp : p ∈ sphere (0 : V) 1) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ K : ℝ≥0, HolderOnWith K α
      (fderiv ℝ (fderiv ℝ u)) (ball p δ ∩ ball (0 : V) 1) := by
  by_cases hne : p ≠ -EuclideanSpace.single 0 1
  · exact exists_local_holderOnWith_hessian_ne_sphere_pole hα hαlt f u hu hc hzero heq hp hne
  · have hpole : p = -EuclideanSpace.single 0 1 := not_ne_iff.mp hne
    have hne' : -p ≠ -EuclideanSpace.single 0 1 := by
      intro h
      have hcoord := congrArg (fun x : V => x 0) h
      simp [hpole, EuclideanSpace.single] at hcoord
      linarith
    obtain ⟨huN, hcN, hzeroN, heqN⟩ := negated_ball_classical_data f hu hc hzero heq
    obtain ⟨δ, hδ, K, hK⟩ := exists_local_holderOnWith_hessian_ne_sphere_pole hα hαlt
      (negateForcing f) (fun y => u (-y)) huN hcN hzeroN heqN
      (by simpa only [mem_sphere, dist_zero_right, norm_neg] using hp) hne'
    have hmap : MapsTo (fun y : V => -y) (ball p δ ∩ ball (0 : V) 1)
        (ball (-p) δ ∩ ball (0 : V) 1) := by
      intro y hy
      exact ⟨by simpa only [mem_ball, dist_neg_neg] using hy.1,
        by simpa only [mem_ball, dist_zero_right, norm_neg] using hy.2⟩
    have hHeq : ∀ x ∈ ball (0 : V) 1,
        fderiv ℝ (fderiv ℝ (fun y => u (-y))) (-x) = fderiv ℝ (fderiv ℝ u) x := by
      intro x hx
      simpa only [neg_neg] using hessian_comp_neg
        (x := -x) (by simpa only [neg_neg] using (hu x hx).contDiffAt (isOpen_ball.mem_nhds hx))
    refine ⟨δ, hδ, K, HolderOnWith.of_dist_le ?_⟩
    intro x hx y hy
    rw [← hHeq x hx.2, ← hHeq y hy.2]
    simpa only [dist_neg_neg] using hK.dist_le (hmap hx) (hmap hy)
end ConformalPoisson.SphereFlattening

end ProofPart_BallNegation

/- Proof support: BallHolderClosure.lean, SHA256 d4d44500d2a23c1271cb46b7699dec80805d317c0b49f1d0af8bcc0ad8d07b7c -/
noncomputable section ProofPart_BallHolderClosure



/- Holder fields on the open ball extend to actual Holder fields on
its closed ball. This is used for the Hessian and first derivative in
the complete Dirichlet graph; no boundary derivative is postulated. -/
open Set Metric Topology
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  {α K : ℝ≥0} {f : E → F}

without_proof_info in
theorem dense_openBall_in_closedBall :
    Dense {x : closedBall (0 : E) 1 | (x : E) ∈ ball 0 1} := by
  rw [Subtype.dense_iff]
  have himage : Subtype.val '' {x : closedBall (0 : E) 1 | (x : E) ∈ ball 0 1} =
      ball (0 : E) 1 := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨x, ball_subset_closedBall hx⟩, hx, rfl⟩
  rw [himage, closure_ball (0 : E) (by norm_num : (1 : ℝ) ≠ 0)]

without_proof_info in
theorem exists_holderSpace_closedBall_extension (hα : 0 < α)
    (hf : HolderOnWith K α f (ball 0 1)) :
    ∃ G : TauCeti.HolderSpace α (closedBall (0 : E) 1) F,
      ∀ x (hx : x ∈ ball 0 1), G ⟨x, ball_subset_closedBall hx⟩ = f x := by
  let S : Set (closedBall (0 : E) 1) := {x | (x : E) ∈ ball 0 1}
  have hfS : HolderOnWith K α (fun x : closedBall (0 : E) 1 => f x) S :=
    fun x hx y hy => hf x hx y hy
  obtain ⟨g, hg, hfg⟩ := hfS.extend_of_dense hα dense_openBall_in_closedBall
  let Gbc : closedBall (0 : E) 1 →ᵇ F :=
    BoundedContinuousFunction.mkOfCompact ⟨g, hg.continuous hα⟩
  let G : TauCeti.HolderSpace α (closedBall (0 : E) 1) F :=
    TauCeti.HolderSpace.ofBoundedContinuousFunction Gbc hg.memHolder
  refine ⟨G, ?_⟩
  intro x hx
  rw [TauCeti.HolderSpace.ofBoundedContinuousFunction_apply]
  exact (hfg hx).symm
end ConformalPoisson.DirichletHolder

end ProofPart_BallHolderClosure

/- Proof support: BallDirichletGraph.lean, SHA256 4ea164ee0d3075529008bd4992c3928d4751625be478cffc25cc8f8e18760f2b -/
noncomputable section ProofPart_BallDirichletGraph



/- A classical zero-boundary ball solution whose actual Hessian is
Holder on the open ball determines an element of the complete closed
Dirichlet graph. Its derivative fields at the sphere are obtained by
continuous extension, rather than assumed independently. -/
open Set Metric Filter Topology TauCeti
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  {α K : ℝ≥0} {u : E → F}

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_ballSpace_of_holder_hessian (hα : 0 < α)
    (hu : ContDiffOn ℝ 2 u (ball 0 1)) (hcont : ContinuousOn u (closedBall 0 1))
    (hzero : EqOn u 0 (sphere 0 1))
    (hholder : HolderOnWith K α (fderiv ℝ (fderiv ℝ u)) (ball 0 1)) :
    ∃ J : BallSpace α E F, EqOn (ballValue J) u (closedBall 0 1) := by
  obtain ⟨H, hH⟩ := exists_holderSpace_closedBall_extension hα hholder
  have hDu : ContDiffOn ℝ 1 (fderiv ℝ u) (ball 0 1) :=
    hu.fderiv_of_isOpen isOpen_ball (by decide)
  have hLip : LipschitzOnWith ‖H‖₊ (fderiv ℝ u) (ball 0 1) := by
    apply Convex.lipschitzOnWith_of_nnNorm_fderiv_le
      (fun x hx => (hDu.differentiableOn one_ne_zero).differentiableAt (isOpen_ball.mem_nhds hx))
      ?_ (convex_ball (0 : E) 1)
    intro x hx
    rw [← hH x hx]
    exact_mod_cast H.norm_apply_le ⟨x, ball_subset_closedBall hx⟩
  obtain ⟨D, hD⟩ := exists_holderSpace_closedBall_extension (by norm_num : (0 : ℝ≥0) < 1)
    hLip.holderOnWith
  let U0 : closedBall (0 : E) 1 →ᵇ F := BoundedContinuousFunction.mkOfCompact
    ⟨fun x => u x, continuousOn_iff_continuous_domRestrict.mp hcont⟩
  let data : DomainJet (F := F) α (closedBall (0 : E) 1) :=
    (U0, D.toBoundedContinuousFunction, H)
  have hdata : data ∈ dirichletGraph α (closedBall (0 : E) 1) (ball 0 1)
      {x | (x : E) ∈ sphere 0 1} := by
    refine ⟨?_, ?_, ?_⟩
    · intro x hx
      change HasFDerivAt (domainRead (closedBall 0 1) U0)
        (domainRead (closedBall 0 1) D.toBoundedContinuousFunction x) x
      have hv : domainRead (closedBall 0 1) U0 =ᶠ[𝓝 x] u := by
        filter_upwards [isOpen_ball.mem_nhds hx] with y hy
        rw [domainRead_of_mem _ _ (ball_subset_closedBall hy)]
        rfl
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx),
        HolderSpace.toBoundedContinuousFunction_apply, hD x hx]
      exact ((hu.differentiableOn (by decide)).differentiableAt
        (isOpen_ball.mem_nhds hx)).hasFDerivAt.congr_of_eventuallyEq hv
    · intro x hx
      change HasFDerivAt (domainRead (closedBall 0 1) D.toBoundedContinuousFunction)
        (domainRead (closedBall 0 1) H.toBoundedContinuousFunction x) x
      have hder : domainRead (closedBall 0 1) D.toBoundedContinuousFunction =ᶠ[𝓝 x]
          fderiv ℝ u := by
        filter_upwards [isOpen_ball.mem_nhds hx] with y hy
        rw [domainRead_of_mem _ _ (ball_subset_closedBall hy),
          HolderSpace.toBoundedContinuousFunction_apply, hD y hy]
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx),
        HolderSpace.toBoundedContinuousFunction_apply, hH x hx]
      exact ((hDu.differentiableOn one_ne_zero).differentiableAt
        (isOpen_ball.mem_nhds hx)).hasFDerivAt.congr_of_eventuallyEq hder
    · intro x hx
      change U0 x = 0
      exact hzero hx
  refine ⟨⟨data, hdata⟩, ?_⟩
  intro x hx
  rw [ballValue, domainRead_of_mem _ _ hx]
  rfl
end ConformalPoisson.DirichletHolder

end ProofPart_BallDirichletGraph

/- Proof support: BallHessianRegularityCaller.lean, SHA256 bba8b42be152b17823918c2a898173ca2c1ce76451227f0852a01a0ad79778ae -/
noncomputable section ProofPart_BallHessianRegularityCaller



/- Exact remaining boundary Schauder obligation. Classical existence,
closed derivative-graph assembly, uniqueness and bounded inversion are
proved. Only Holder regularity of the actual Hessian up to the sphere
is left as the explicit hypothesis of this conditional caller. -/
open Set Metric Filter Topology TauCeti InnerProductSpace
open scoped NNReal ContDiff Laplacian
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

/-- An OPEN development obligation, not a retained literature input:
classical zero-Dirichlet solutions with Holder forcing have a Holder
Hessian on the entire open ball, with one finite constant. -/
def BallHessianRegularity (d : ℕ) (β : ℝ≥0) : Prop :=
  ∀ (f : HolderSpace β (closedBall (0 : EuclideanSpace ℝ (Fin d)) 1) ℝ)
      (u : EuclideanSpace ℝ (Fin d) → ℝ),
    ContDiffOn ℝ 2 u (ball 0 1) → ContinuousOn u (closedBall 0 1) → EqOn u 0 (sphere 0 1) →
    (∀ x ∈ ball 0 1, -Δ u x = domainRead (closedBall 0 1) f x) →
    ∃ K : ℝ≥0, HolderOnWith K β (fderiv ℝ (fderiv ℝ u)) (ball 0 1)

set_option maxHeartbeats 400000 in
without_proof_info in
theorem ballLaplacian_surjective_of_hessian_regularity (hα : 0 < α) (hαlt : α < 1)
    (hreg : BallHessianRegularity (n + 1) α) :
    Function.Surjective (ballLaplacian (d := n + 1) hαlt.le) := by
  intro f
  obtain ⟨u, hu, hc, h0, hLu⟩ := exists_ball_classical_zeroDirichlet hα hαlt f
  obtain ⟨K, hH⟩ := hreg f u hu hc h0 hLu
  obtain ⟨J, hJ⟩ := exists_ballSpace_of_holder_hessian hα hu hc h0 hH
  refine ⟨J, ?_⟩
  let F := ballLaplacian (d := n + 1) hαlt.le J
  have hEq : EqOn (domainRead (closedBall 0 1) F.toBoundedContinuousFunction)
      (domainRead (closedBall 0 1) f.toBoundedContinuousFunction) (ball 0 1) := by
    intro x hx
    rw [domainRead_of_mem _ _ (ball_subset_closedBall hx),
      domainRead_of_mem _ _ (ball_subset_closedBall hx),
      HolderSpace.toBoundedContinuousFunction_apply, HolderSpace.toBoundedContinuousFunction_apply]
    change ballLaplacian hαlt.le J ⟨x, ball_subset_closedBall hx⟩ = f ⟨x, ball_subset_closedBall hx⟩
    rw [ballLaplacian_eq_negative_laplacian hαlt.le J hx]
    have hv : ballValue J =ᶠ[𝓝 x] u := by
      filter_upwards [isOpen_ball.mem_nhds hx] with y hy
      exact hJ (ball_subset_closedBall hy)
    rw [(laplacian_congr_nhds hv).self_of_nhds, hLu x hx,
      domainRead_of_mem _ _ (ball_subset_closedBall hx)]
  have hEc := hEq.of_subset_closure (continuousOn_domainRead _ _) (continuousOn_domainRead _ _)
    ball_subset_closedBall (by
      rw [closure_ball (0 : V) (by norm_num : (1 : ℝ) ≠ 0)])
  apply HolderSpace.ext
  intro x
  have h := hEc x.property
  rw [domainRead_of_mem _ _ x.property, domainRead_of_mem _ _ x.property,
    HolderSpace.toBoundedContinuousFunction_apply, HolderSpace.toBoundedContinuousFunction_apply] at h
  exact h

without_proof_info in
theorem exists_ballLaplacian_inverse_of_hessian_regularity (hα : 0 < α) (hαlt : α < 1)
    (hreg : BallHessianRegularity (n + 1) α) :
    ∃ T : HolderSpace α (closedBall (0 : V) 1) ℝ →L[ℝ] BallSpace α V ℝ,
      ∀ f, ballLaplacian hαlt.le (T f) = f :=
  exists_ballLaplacian_inverse_of_surjective (by omega) hαlt.le
    (ballLaplacian_surjective_of_hessian_regularity hα hαlt hreg)

without_proof_info in
theorem localSchauder_of_ball_hessian_regularity
    (hreg : ∀ β : ℝ≥0, 0 < β → β < 1 → BallHessianRegularity (n + 1) β) :
    LocalSchauderDirichletAssumption (n + 1) := by
  apply localSchauder_of_ball_laplacian_inverse
  intro β hβ hβlt
  exact exists_ballLaplacian_inverse_of_hessian_regularity hβ hβlt (hreg β hβ hβlt)
end ConformalPoisson.DirichletHolder

end ProofPart_BallHessianRegularityCaller

/- Proof support: CompactRelativeHolder.lean, SHA256 bed5d3738d72a955a83d6a54e2d8086fc2b104179b280203f3145f1f5f0e7af7 -/
noncomputable section ProofPart_CompactRelativeHolder



/- Relative local Holder estimates over a compact closure give a
single global estimate on the actual open domain. The finite-cover and
Lebesgue-number argument adapts the pinned Tau Ceti theorem
IsCompact.exists_holderOnWith_thickening_and_norm_le, by the Tau Ceti
contributors (2026), Apache-2.0. Here all local estimates concern
ball(x,r) intersect S; no boundary value of f is assumed. -/
open Set Metric Filter
open scoped NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {S C : Set E} {f : E → F} {α : ℝ≥0}

set_option maxHeartbeats 700000 in
without_proof_info in
theorem exists_holderOnWith_of_compact_relative_cover (hC : IsCompact C) (hSC : S ⊆ C)
    (hf : ∀ x ∈ C, ∃ r > 0, ∃ L : ℝ≥0, HolderOnWith L α f (ball x r ∩ S)) :
    ∃ K : ℝ≥0, HolderOnWith K α f S := by
  classical
  choose! r hr L hL using hf
  have hbounded : ∀ x ∈ C, ∃ M : ℝ≥0, ∀ y ∈ ball x (r x) ∩ S, ‖f y‖ ≤ M := by
    intro x hx
    exact exists_norm_bound_of_holderOnWith (isBounded_ball.subset inter_subset_left) (hL x hx)
  choose! M hM using hbounded
  obtain ⟨t, htC, hcover⟩ := hC.elim_nhds_subcover (fun x => ball x (r x))
    (fun x hx => ball_mem_nhds x (hr x hx))
  obtain ⟨δ, hδ, hδC⟩ := lebesgue_number_lemma_of_metric hC
    (c := fun z : t => ball (z : E) (r z)) (fun _ => isOpen_ball) (fun y hy => by
      obtain ⟨z, hzt, hyz⟩ := mem_iUnion₂.mp (hcover hy)
      exact mem_iUnion.mpr ⟨⟨z, hzt⟩, hyz⟩)
  let N : ℝ≥0 := ∑ z ∈ t, M z
  have hN : ∀ y ∈ S, ‖f y‖ ≤ N := by
    intro y hy
    obtain ⟨z, hzt, hyz⟩ := mem_iUnion₂.mp (hcover (hSC hy))
    apply (hM z (htC z hzt) y ⟨hyz, hy⟩).trans
    exact_mod_cast (Finset.single_le_sum (f := M) (fun _ _ => zero_le) hzt)
  let ε : ℝ≥0 := ⟨δ, hδ.le⟩
  have hε : 0 < ε := by exact_mod_cast hδ
  refine ⟨_, HolderOnWith.of_dist_lt_of_dist_le (δ := ε) (K := ∑ z ∈ t, L z) (D := 2 * N) hε ?_ ?_⟩
  · intro x hx y hy hxy
    change dist x y < δ at hxy
    obtain ⟨⟨z, hzt⟩, hz⟩ := hδC x (hSC hx)
    have hxz : x ∈ ball z (r z) := hz (mem_ball_self hδ)
    have hyz : y ∈ ball z (r z) := hz (by simpa only [mem_ball, dist_comm] using hxy)
    apply ((hL z (htC z hzt)).dist_le ⟨hxz, hx⟩ ⟨hyz, hy⟩).trans
    gcongr
    exact_mod_cast Finset.single_le_sum (f := L) (fun _ _ => zero_le) hzt
  · intro x hx y hy
    push_cast
    linarith [dist_le_norm_add_norm (f x) (f y), hN x hx, hN y hy]
