noncomputable section ProofPart_GreenTrace_NativeLocalBoundaryC1Bound



/- Uniform local classical value/gradient control for actual native
homogeneous zero-boundary functions. The global extension is removed by
same-cap germ equality, and its arbitrary behavior elsewhere is irrelevant. -/
open Bundle Set Metric MeasureTheory TauCeti Filter TopologicalSpace Module
open scoped Manifold ContDiff Topology ENNReal NNReal Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

set_option maxHeartbeats 1100000 in
without_proof_info in
theorem exists_native_local_boundary_c1_bound
    (p : ℝ≥0) [Fact (1 ≤ (p : ℝ≥0∞))] (hp : (finrank ℝ P : ℝ≥0) < p)
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (hq : Continuous q)
    (c : M) (U : Opens M) (hc : c ∈ U) :
    ∃ R₀ > 0,
      (closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      (nativeClosedChartCap (n := n) c R₀ ⊆ U) ∧
      ∀ R : ℝ, 0 < R → R ≤ R₀ →
      ∃ C ≥ 0, ∀ f : M → ℝ, ContMDiffOn Ihalf 𝓘(ℝ) ∞ f U →
      (∀ x ∈ (U : Set M), (𝓡∂ (n + 1)).IsBoundaryPoint x → f x = 0) →
      (∀ x ∈ (U : Set M), (𝓡∂ (n + 1)).IsInteriorPoint x → schrodinger g q f x = 0) →
      ∀ z ∈ (splitBoundaryChartCap (n := n) c (R / 4) : Set P),
        |f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| +
          ‖∇ (fun w : P => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n w))) z‖ ≤
        C * lpNorm (fun z : P => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (p : ℝ≥0∞)
          (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) := by
  have hdim : finrank ℝ P = n + 1 := by
    rw [(euclideanNormalSplit n).toLinearEquiv.finrank_eq]
    simp
  have hp1 : 1 < (p : ℝ≥0∞) := by
    have hdim1 : (1 : ℝ≥0) ≤ (finrank ℝ P : ℝ≥0) := by rw [hdim]; norm_cast; omega
    exact_mod_cast hdim1.trans_lt hp
  obtain ⟨rMax, hMax, _, hKU⟩ := exists_native_closed_chart_cap_within (n := n) c U hc
  obtain ⟨R₀, hR₀, hRMax, htarget, hH⟩ :=
    exists_native_halfBall_homogeneous_bound_below hp1 ENNReal.coe_ne_top g q hq c rMax hMax
  have hK₀U := (nativeClosedChartCap_mono (n := n) c hRMax).trans hKU
  refine ⟨R₀, hR₀, htarget, hK₀U, fun R hR hRR₀ => ?_⟩
  obtain ⟨D, hD, hDall⟩ := hH R hR hRR₀
  obtain ⟨C, hC, hCall⟩ := exists_halfBall_classical_c1_bound p hp 0
    (splitBoundaryChartCap (n := n) c R)
    ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) R hR
    (splitBoundaryChartCap_inter_ball c R) D hD
  have htargetR : closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target :=
    (fun z hz => htarget ⟨closedBall_subset_closedBall hRR₀ hz.1, hz.2⟩)
  have hKRU := (nativeClosedChartCap_mono (n := n) c hRR₀).trans hK₀U
  refine ⟨C, hC, fun f hf hf0 hPf => ?_⟩
  obtain ⟨u, hu, hu0, hue⟩ := exists_native_chart_cap_zeroDirichlet_extension c htargetR U hKRU f hf hf0
  have hmem : ∀ z ∈ (splitBoundaryChartCap (n := n) c R : Set P),
      (extChartAt Ihalf c).symm (euclideanNormalSplit n z) ∈ nativeClosedChartCap (n := n) c R :=
    fun z hz => ⟨euclideanNormalSplit n z, ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩, rfl⟩
  have hLu : ∀ z ∈ (splitBoundaryChartCap (n := n) c R : Set P),
      schrodinger g q u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) = 0 := by
    intro z hz
    have hyK := hmem z hz
    have hyU := hKRU hyK
    rw [schrodinger_eq_of_eventuallyEq g q ((hu.of_le (by simp)).contMDiffAt)
      (((hf _ hyU).contMDiffAt (U.isOpen.mem_nhds hyU)).of_le (by simp)) (hue _ hyK)]
    exact hPf _ hyU (isInteriorPoint_symm_of_mem_boundaryChartCap c htargetR hz)
  obtain ⟨W, hW, hzero, hHess⟩ := hDall u hu (fun y hy => hu0 ⟨y, hy⟩) hLu
  have heq : EqOn
      (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)))
      (fun z : P => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)))
      (splitBoundaryChartCap (n := n) c R : Set P) :=
    fun z hz => (hue _ (hmem z hz)).eq_of_nhds
  have hfs : ContDiffOn ℝ ∞
      (fun z : P => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)))
      (splitBoundaryChartCap (n := n) c R : Set P) :=
    (contDiffOn_split_boundary_chart_reading c htargetR hu).congr heq.symm
  have hWf : Wkp.value 2 W =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
      fun z => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) := by
    filter_upwards [hW, ae_restrict_mem (splitBoundaryChartCap (n := n) c R).isOpen.measurableSet] with z hz hzcap
    exact hz.trans (heq hzcap)
  have hest := hCall W hzero hHess _ hfs hWf
  rw [splitBoundaryChartCap_inter_smaller_ball c (by linarith : R / 4 ≤ R),
    splitBoundaryChartCap_inter_smaller_ball c le_rfl, lpNorm_congr_ae hWf] at hest
  exact hest

end ConformalPoisson

