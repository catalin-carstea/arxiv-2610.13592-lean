    (by simpa only [extChartAt_source] using hx.1) hzi q
    (((hu x hx).contMDiffAt (O.isOpen.mem_nhds hx)).of_le (by simp))
  have hgerm : ((v ∘ extChartAt Ihalf c) ∘ (extChartAt Ihalf c).symm) =ᶠ[𝓝 (extChartAt Ihalf c x)] v := by
    filter_upwards [Ω.isOpen.mem_nhds hx.2] with z hz
    dsimp only [Function.comp_apply]
    rw [(extChartAt Ihalf c).right_inv (hΩt hz)]
  rw [coordinateSchrodinger_eq_of_eventuallyEq _ _ _ hgerm, hPv _ hx.2] at heq
