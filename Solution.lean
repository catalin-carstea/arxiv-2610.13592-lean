  have h : (((e.symm : F →L[ℝ] E) ∘L A ∘L (e : E →L[ℝ] F)) ∘L
      (e.iteratedGradientCongr 1).symm H) =
      (e.symm : F →L[ℝ] E) ∘L (A ∘L H) ∘L (e : E →L[ℝ] F) := by
    rw [LinearIsometryEquiv.iteratedGradientCongr_symm_succ_apply,
      LinearIsometryEquiv.iteratedGradientCongr_zero]
    ext y
    change e.symm (A (e (e.symm (H (e y))))) = e.symm (A (H (e y)))
    rw [e.apply_symm_apply]
  rw [h]
