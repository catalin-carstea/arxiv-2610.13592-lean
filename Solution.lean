without_proof_info in
theorem normal_majorant_coefficient_ratio_le
    {B C : ℝ} (hB : 1 ≤ B) (hBC : B ≤ C)
    {k ell : ℕ} (hell : ell ≤ 1) (hkell : k + ell ≤ 2) :
    B ^ k / C ^ (2 - ell) ≤ B / C := by
