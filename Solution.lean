    (hK : IsCompactOperator K) (hT : Function.Injective T)
    (hEstimate : ∀ u, ‖u‖ ≤ A * ‖T u‖ + ‖K u‖) :
    ∃ C : ℝ, 0 < C ∧ ∀ u, ‖u‖ ≤ C * ‖T u‖ := by
  have hker : T.ker = ⊥ := LinearMap.ker_eq_bot.mpr hT
  obtain ⟨c, hc, hbound⟩ := T.exists_pos_mul_norm_le_of_compact_estimate hK hEstimate
    (M := ⊤) (by simp)
    (by rw [hker]; exact disjoint_bot_left)
  refine ⟨c⁻¹, inv_pos.mpr hc, fun u => ?_⟩
  have hu := hbound u (Submodule.mem_top)
  exact (le_inv_mul_iff₀ hc).mpr hu

without_proof_info in
/-- The same coercive estimate controls a bounded trace/readback operator.
Its intended native caller must construct all spaces and maps in the hypotheses. -/
theorem trace_bound_of_compact_error
    (T : E →L[ℝ] F) (K : E →L[ℝ] G) (R : E →L[ℝ] H) (A : ℝ)
    (hK : IsCompactOperator K) (hT : Function.Injective T)
    (hEstimate : ∀ u, ‖u‖ ≤ A * ‖T u‖ + ‖K u‖) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u, ‖R u‖ ≤ C * ‖T u‖ := by
  obtain ⟨C, hC, hbound⟩ := norm_le_mul_image_of_compact_error T K A hK hT hEstimate
  refine ⟨‖R‖ * C, mul_nonneg (norm_nonneg _) hC.le, fun u => ?_⟩
  calc ‖R u‖ ≤ ‖R‖ * ‖u‖ := R.le_opNorm u
    _ ≤ ‖R‖ * (C * ‖T u‖) := mul_le_mul_of_nonneg_left (hbound u) (norm_nonneg _)
    _ = (‖R‖ * C) * ‖T u‖ := (mul_assoc _ _ _).symm

end ConformalPoisson

end ProofPart_GreenTrace_CompactErrorInverseBound

