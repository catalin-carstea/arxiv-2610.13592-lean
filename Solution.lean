    (hA : AnalyticAt ℝ A p) (hK : AnalyticAt ℝ K p)
    (C : H (V →L[ℝ] V →L[ℝ] ℝ)) :
    AnalyticAt ℝ (fun a => pullbackCorrection (A a) (K a) C) p := by
  apply Finset.analyticAt_fun_sum
  intro i hi
  exact ((analyticAt_pullbackHessianTerm hA hK i).contDiffAt.clm_apply
    contDiffAt_const).analyticAt

without_proof_info in
theorem analyticAt_pulledBackHolderOperator
    {A K : P → H (V →L[ℝ] V)} {B : P → H V} {Q : P → H ℝ} {a : P → V}
    (hA : AnalyticAt ℝ A p) (hB : AnalyticAt ℝ B p) (hQ : AnalyticAt ℝ Q p)
    (hK : AnalyticAt ℝ K p) (ha : AnalyticAt ℝ a p)
