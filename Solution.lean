/- Proof support: ManifoldCompactIntegralJets.lean, SHA256 da830f631829fae58400c544f07a171e28ed296172171e8610ee459aa63c28ae -/
noncomputable section ProofPart_ManifoldCompactIntegralJets


/- Compact native integration parameters may have boundary. Only the
variable being differentiated is placed in an ordinary Euclidean chart. -/
open Set Filter MeasureTheory Function
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {E' H' Y : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
  [TopologicalSpace H'] {J : ModelWithCorners ℝ E' H'}
  [TopologicalSpace Y] [T2Space Y] [CompactSpace Y] [ChartedSpace H' Y] [IsManifold J 1 Y]
  [MeasurableSpace Y] [OpensMeasurableSpace Y]
  {μ : Measure Y} [IsFiniteMeasure μ]

without_proof_info in
theorem ordinaryJet_compact_integral_of_contMDiffOn {U : Set E} (hU : IsOpen U)
    {x : E} (hx : x ∈ U) {F : E → Y → ℝ}
    (hF : ContMDiffOn (𝓘(ℝ, E).prod J) 𝓘(ℝ) ∞ (uncurry F) (U ×ˢ univ)) :
    Integrable (fun y => ordinaryJet (F x y) (fderiv ℝ (fun z => F z y) x)
      (fderiv ℝ (fderiv ℝ (fun z => F z y)) x)) μ ∧
    ordinaryJet (∫ y, F x y ∂μ) (fderiv ℝ (fun z => ∫ y, F z y ∂μ) x)
      (fderiv ℝ (fderiv ℝ (fun z => ∫ y, F z y ∂μ)) x) =
        ∫ y, ordinaryJet (F x y) (fderiv ℝ (fun z => F z y) x)
          (fderiv ℝ (fderiv ℝ (fun z => F z y)) x) ∂μ := by
  let D : E → Y → E →L[ℝ] ℝ := fun z y => fderiv ℝ (fun z => F z y) z
  have hAt (z : E) (hz : z ∈ U) (y : Y) :
      ContMDiffAt (𝓘(ℝ, E).prod J) 𝓘(ℝ) ∞ (uncurry F) (z, y) :=
    (hF (z, y) ⟨hz, mem_univ _⟩).contMDiffAt
      ((hU.prod isOpen_univ).mem_nhds ⟨hz, mem_univ _⟩)
  have hDAt (z : E) (hz : z ∈ U) (y : Y) :
      ContMDiffAt (𝓘(ℝ, E).prod J) 𝓘(ℝ, E →L[ℝ] ℝ) ∞ (uncurry D) (z, y) :=
    contMDiffAt_joint_fderiv_fst (G := F) (hAt z hz y)
  have hDDAt (z : E) (hz : z ∈ U) (y : Y) :
      ContMDiffAt (𝓘(ℝ, E).prod J) 𝓘(ℝ, E →L[ℝ] E →L[ℝ] ℝ) ∞
        (fun p : E × Y => fderiv ℝ (fderiv ℝ (fun z => F z p.2)) p.1) (z, y) :=
    contMDiffAt_joint_fderiv_fst (G := D) (hDAt z hz y)
  apply ordinaryJet_compact_integral (μ := μ) hU hx hF.continuousOn
  · intro y z hz
    exact ((hAt z hz y).comp z (contMDiffAt_id.prodMk contMDiffAt_const)).contDiffAt
      |>.differentiableAt (by decide) |>.differentiableWithinAt
  · exact fun p hp => (hDAt p.1 hp.1 p.2).continuousAt.continuousWithinAt
  · intro y z hz
    exact ((hDAt z hz y).comp z (contMDiffAt_id.prodMk contMDiffAt_const)).contDiffAt
      |>.differentiableAt (by decide) |>.differentiableWithinAt
  · exact fun p hp => (hDDAt p.1 hp.1 p.2).continuousAt.continuousWithinAt

end ConformalPoisson

end ProofPart_ManifoldCompactIntegralJets

/- Proof support: GreenForcingJetRepresentation.lean, SHA256 56ba217267c8e6c0ee2a9eb577a63056f7e6379a055e281037632f07a09e91e2 -/
noncomputable section ProofPart_GreenForcingJetRepresentation




/- Differentiate the supplied Green forcing representation only where its
forcing support is separated from the evaluation point. -/
open Set Filter Function MeasureTheory
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenForcingJetBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.chartOrdinaryJet_forcing_representation
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
    (hFc : HasCompactSupport F) (hFi : tsupport F ⊆ (𝓡∂ (n + 1)).interior M)
    (w : M → ℝ) (hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w)
    (hwb : ∀ y : (𝓡∂ (n + 1)).boundary M, w y = 0)
    (hL : ∀ z ∈ (𝓡∂ (n + 1)).interior M, schrodinger g q w z = F z)
    {x : M} (hx : x ∈ (𝓡∂ (n + 1)).interior M) (hxF : x ∉ tsupport F) :
    Integrable (fun y => chartOrdinarySecondJet (n := n) x (fun z => G.kernel z y * F y))
      (nativeVolume g) ∧
    chartOrdinarySecondJet (n := n) x w =
      ∫ y, chartOrdinarySecondJet (n := n) x (fun z => G.kernel z y * F y) ∂nativeVolume g := by
  let := nativeVolume_isFiniteMeasure g
  let c := extChartAt (𝓡∂ (n + 1)) x
  let A : V → M → ℝ := fun z y => G.kernel (c.symm z) y * F y
  have hround : c.symm (c x) = x := c.left_inv (mem_extChartAt_source x)
  obtain ⟨U, hxU, hUI, hA⟩ := G.exists_forcing_chart_domain g q ν S F hF hx hxF
  have hjet := ordinaryJet_compact_integral_of_contMDiffOn (μ := nativeVolume g)
    (F := A) U.isOpen hxU hA
  have hread : (w ∘ c.symm) =ᶠ[𝓝 (c x)] (fun z => ∫ y, A z y ∂nativeVolume g) := by
    filter_upwards [U.isOpen.mem_nhds hxU] with z hz
    exact (G.forcing_representation F hF hFc hFi w hw hwb hL (c.symm z) (hUI z hz).1).2
  have hd := hread.fderiv_eq (𝕜 := ℝ)
  have hdg : fderiv ℝ (w ∘ c.symm) =ᶠ[𝓝 (c x)]
      fderiv ℝ (fun z => ∫ y, A z y ∂nativeVolume g) :=
    hread.eventuallyEq_nhds.mono (fun z hz => hz.fderiv_eq (𝕜 := ℝ))
  have hdd := hdg.fderiv_eq (𝕜 := ℝ)
  have hval : w x = ∫ y, A (c x) y ∂nativeVolume g := by
    simpa only [A, hround] using (G.forcing_representation F hF hFc hFi w hw hwb hL x hx).2
  have hJ : (fun y => ordinaryJet (A (c x) y) (fderiv ℝ (fun z => A z y) (c x))
      (fderiv ℝ (fderiv ℝ (fun z => A z y)) (c x))) =
      (fun y => chartOrdinarySecondJet (n := n) x (fun z => G.kernel z y * F y)) := by
    funext y
    simp only [chartOrdinarySecondJet, A, hround, c]
    rfl
  refine ⟨hJ ▸ hjet.1, ?_⟩
  calc
    chartOrdinarySecondJet (n := n) x w =
        ordinaryJet (∫ y, A (c x) y ∂nativeVolume g)
          (fderiv ℝ (fun z => ∫ y, A z y ∂nativeVolume g) (c x))
          (fderiv ℝ (fderiv ℝ (fun z => ∫ y, A z y ∂nativeVolume g)) (c x)) := by
      change ordinaryJet (w x) (fderiv ℝ (w ∘ c.symm) (c x))
        (fderiv ℝ (fderiv ℝ (w ∘ c.symm)) (c x)) = _
      rw [hval, hd, hdd]
    _ = _ := hjet.2.trans (congrArg (fun f => ∫ y, f y ∂nativeVolume g) hJ)

end ConformalPoisson

end ProofPart_GreenForcingJetRepresentation

/- Proof support: GreenForcingMoment.lean, SHA256 dd1ded56698328db354e839e5465f2070b4a698cbda5f355ac0153c0405bd384 -/
noncomputable section ProofPart_GreenForcingMoment



/- The actual first-variable native-jet functional commutes with the supplied
Green forcing representation, with explicit integrability and separated support. -/
open Set Filter Function MeasureTheory
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenForcingMomentBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.nativeJet_forcing_moment
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {N : ℕ} (points : Fin N → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : Fin N) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
    (hFc : HasCompactSupport F) (hFi : tsupport F ⊆ (𝓡∂ (n + 1)).interior M)
    (hFP : Disjoint (tsupport F) (range points))
    (w : M → ℝ) (hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w)
    (hwb : ∀ y : (𝓡∂ (n + 1)).boundary M, w y = 0)
    (hL : ∀ z ∈ (𝓡∂ (n + 1)).interior M, schrodinger g q w z = F z) :
    Integrable (fun y => greenJetSection g points ℓ G.kernel y * F y) (nativeVolume g) ∧
      ℓ (fun i => secondJet g w (points i)) =
        ∫ y, greenJetSection g points ℓ G.kernel y * F y ∂nativeVolume g := by
  classical
  have hpoff (i : Fin N) : points i ∉ tsupport F :=
    fun h => Set.disjoint_left.mp hFP h ⟨i, rfl⟩
  obtain ⟨L, hLift⟩ := exists_simultaneous_continuous_ordinary_jet_functional g points ℓ
  let J : M → Fin N → OrdinaryJet V :=
    fun y i => chartOrdinarySecondJet (n := n) (points i) (fun z => G.kernel z y * F y)
  have hm (i : Fin N) := G.chartOrdinaryJet_forcing_representation g q ν S F hF hFc hFi
    w hw hwb hL (hpoints i) (hpoff i)
  have hInt : Integrable J (nativeVolume g) := Integrable.of_eval fun i => (hm i).1
  have hWread : (fun i => nativeChartJetLinearMap g (points i) (secondJet g w (points i))) =
      (fun i => chartOrdinarySecondJet (n := n) (points i) w) := by
    funext i
    exact nativeChartJetLinearMap_secondJet g (points i) (hpoints i) (hw.of_le (by decide)).contMDiffAt
  have hMoment : (fun i => chartOrdinarySecondJet (n := n) (points i) w) =
      ∫ y, J y ∂nativeVolume g := by
    funext i
    exact (hm i).2.trans (eval_integral (fun i => (hm i).1) i).symm
  have hIntegrand (y : M) : L (J y) = greenJetSection g points ℓ G.kernel y * F y := by
    have hProductRead :
        (fun i => nativeChartJetLinearMap g (points i)
          (secondJet g (fun z => G.kernel z y * F y) (points i))) = J y := by
      funext i
      apply nativeChartJetLinearMap_secondJet g (points i) (hpoints i)
      exact ((G.contMDiffAt_forcing_product g q ν S F hF (hpoff i) y).comp
        (points i) (contMDiffAt_id.prodMk contMDiffAt_const)).of_le
          (by decide : (2 : ℕ∞ω) ≤ ∞)
    calc
      L (J y) = L (fun i => nativeChartJetLinearMap g (points i)
          (secondJet g (fun z => G.kernel z y * F y) (points i))) := congrArg L hProductRead.symm
      _ = ℓ (fun i => secondJet g (fun z => G.kernel z y * F y) (points i)) := hLift _
      _ = F y * ℓ (fun i => secondJet g (fun z => G.kernel z y) (points i)) := by
        have hsplit : (fun i => secondJet g (fun z => G.kernel z y * F y) (points i)) =
            F y • (fun i => secondJet g (fun z => G.kernel z y) (points i)) :=
          funext fun i => G.firstVariableJet_forcing_product g q ν S F (hpoff i) y
        rw [hsplit, map_smul]
        rfl
      _ = greenJetSection g points ℓ G.kernel y * F y := mul_comm _ _
  have hFun : (fun y => L (J y)) = (fun y => greenJetSection g points ℓ G.kernel y * F y) :=
    funext hIntegrand
  refine ⟨hFun ▸ L.integrable_comp hInt, ?_⟩
  calc
    ℓ (fun i => secondJet g w (points i)) =
        L (fun i => nativeChartJetLinearMap g (points i) (secondJet g w (points i))) :=
      (hLift _).symm
    _ = L (fun i => chartOrdinarySecondJet (n := n) (points i) w) := congrArg L hWread
    _ = L (∫ y, J y ∂nativeVolume g) := congrArg L hMoment
    _ = ∫ y, L (J y) ∂nativeVolume g := (L.integral_comp_comm hInt).symm
    _ = _ := congrArg (fun f => ∫ y, f y ∂nativeVolume g) hFun

end ConformalPoisson

end ProofPart_GreenForcingMoment

/- Proof support: GreenJetSmooth.lean, SHA256 e6fd0bf9ea3cb5a29eff7d68cc9da4774ffd532ae6099eac3daaa2b5af791b8d -/
noncomputable section ProofPart_GreenJetSmooth



/- Smoothness off the poles of the actual Green-jet combination. The chart
reading is linear with its native connection correction; the functional is
extended continuously using mathlib, with no additional analytical input. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenJetSmoothBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "I" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.contMDiffAt_chartOrdinaryJet
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace I (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {x y : M} (hx : x ∈ (𝓡∂ (n + 1)).interior M) (hxy : x ≠ y) :
    ContMDiffAt I 𝓘(ℝ, OrdinaryJet V) ∞
      (fun r => chartOrdinarySecondJet (n := n) x (fun z => G.kernel z r)) y := by
  let c := extChartAt I x
  have hcx : c x ∈ interior c.target := ModelWithCorners.isInteriorPoint_iff.mp hx
  have hround : c.symm (c x) = x := c.left_inv (mem_extChartAt_source x)
  have hcinv : ContMDiffAt 𝓘(ℝ, V) I ∞ c.symm (c x) :=
    (contMDiffOn_extChartAt_symm x (c x) (interior_subset hcx)).contMDiffAt
      (Filter.mem_of_superset (isOpen_interior.mem_nhds hcx) interior_subset)
  have hG := (G.smooth_off_diagonal (x, y) hxy).contMDiffAt
    ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hxy)
  let F : M → V → ℝ := fun r z => G.kernel (c.symm z) r
  have hF : ContMDiffAt ((𝓡∂ (n + 1)).prod 𝓘(ℝ, V)) 𝓘(ℝ) ∞ (uncurry F) (y, c x) := by
    apply hG.comp_of_eq
      ((hcinv.comp (y, c x) contMDiffAt_snd).prodMk contMDiffAt_fst)
    exact Prod.ext hround rfl
  have hjet := contMDiffAt_fixed_ordinaryJet hF
  convert hjet using 1
  funext r
  simp only [chartOrdinarySecondJet, F, hround, c]
  rfl

without_proof_info in
theorem DirichletGreenKernel.greenJetSection_eq_continuous_chart_read
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace I (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {ι : Type*} [Fintype ι] (points : ι → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ) :
    ∃ L : (ι → OrdinaryJet V) →L[ℝ] ℝ,
      ∀ y ∉ range points,
        greenJetSection g points ℓ G.kernel y =
          L (fun i => chartOrdinarySecondJet (n := n) (points i) (fun z => G.kernel z y)) := by
  obtain ⟨L, hL⟩ := exists_simultaneous_continuous_ordinary_jet_functional g points ℓ
  refine ⟨L, fun y hy => ?_⟩
  have hread : ∀ i,
      nativeChartJetLinearMap g (points i) (secondJet g (fun z => G.kernel z y) (points i)) =
        chartOrdinarySecondJet (n := n) (points i) (fun z => G.kernel z y) := by
    intro i
    exact nativeChartJetLinearMap_secondJet g (points i) (hpoints i)
      ((G.firstVariable_smoothAt g q ν S (fun h => hy ⟨i, h⟩)).of_le (by decide))
  have heq := hL (fun i => secondJet g (fun z => G.kernel z y) (points i))
  simp_rw [hread] at heq
  exact heq.symm

without_proof_info in
theorem DirichletGreenKernel.greenJetSection_smooth
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace I (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {ι : Type*} [Fintype ι] (points : ι → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ) :
    ContMDiffOn I 𝓘(ℝ) ∞ (greenJetSection g points ℓ G.kernel) (range points)ᶜ := by
  obtain ⟨L, hL⟩ := G.greenJetSection_eq_continuous_chart_read g q ν S points hpoints ℓ
  have hP : (range points).Finite := finite_range points
  intro y hy
  have htuple : ContMDiffAt I 𝓘(ℝ, ι → OrdinaryJet V) ∞
      (fun r i => chartOrdinarySecondJet (n := n) (points i) (fun z => G.kernel z r)) y :=
    contMDiffAt_pi_module_iff.mpr fun i => G.contMDiffAt_chartOrdinaryJet g q ν S (hpoints i)
      (fun heq => hy ⟨i, heq⟩)
  have hfun := L.contMDiff.contMDiffAt.comp y htuple
  exact (hfun.congr_of_eventuallyEq (eventuallyEq_of_mem
    (hP.isClosed.isOpen_compl.mem_nhds hy) (fun r hr => hL r hr))).contMDiffWithinAt

end ConformalPoisson

end ProofPart_GreenJetSmooth

/- Proof support: GreenKernelEquation.lean, SHA256 5f082b8035756b28e1529b80e10a651869b58962696d403d7bf0ad99aed7b902 -/
noncomputable section ProofPart_GreenKernelEquation







/- Derive the Green kernel equation from the supplied forcing representation
and retained zero-Dirichlet inverse. Test separation replaces integration by
parts. No kernel-PDE property is added to the literature package. -/
open Set Filter Function MeasureTheory
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenEquationBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary

without_proof_info in
theorem nativeVolume_isOpenPosMeasure (g : Metric (n := n) (M := M)) :
    Measure.IsOpenPosMeasure (nativeVolume g) := by
  unfold nativeVolume
  infer_instance

without_proof_info in
theorem DirichletGreenKernel.firstVariable_equation_off_diagonal
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (D : ZeroDirichletSolver g q) {x y : M}
    (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (hy : y ∈ (𝓡∂ (n + 1)).interior M) (hxy : x ≠ y) :
    schrodinger g q (fun z => G.kernel z y) x = 0 := by
  let := nativeVolume_isLocallyFiniteMeasure g
  let := nativeVolume_isOpenPosMeasure g
  let points : Fin 1 → M := fun _ => x
  let ℓ : ((i : Fin 1) → JetSpace g (points i)) →ₗ[ℝ] ℝ :=
    (jetEquation g q x).comp (LinearMap.proj 0)
  let Q := greenJetSection g points ℓ G.kernel
  have hQ (z : M) : Q z = schrodinger g q (fun w => G.kernel w z) x :=
    jetEquation_secondJet g q (fun w => G.kernel w z) x
  have hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M := fun _ => hx
  have hrange : range points = {x} := by ext z; simp [points]
  let U : Set M := (𝓡∂ (n + 1)).interior M \ {x}
  have hU : IsOpen U :=
    ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).inter isOpen_compl_singleton
  have hQsmooth : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ Q ({x}ᶜ) := by
    simpa only [← hrange] using G.greenJetSection_smooth g q ν S points hpoints ℓ
  have hQon : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ Q U :=
    hQsmooth.mono (fun _ hz => hz.2)
  have hcont : ContinuousOn Q U := hQon.continuousOn
  have hae : ∀ᵐ z ∂nativeVolume g, z ∈ U → Q z = 0 := by
    apply hU.ae_eq_zero_of_integral_contMDiff_smul_eq_zero (𝓡∂ (n + 1))
      (hcont.locallyIntegrableOn hU.measurableSet)
    intro F hF hFc hFU
    have hxF : x ∉ tsupport F := fun h => (hFU h).2 rfl
    have hFi : tsupport F ⊆ (𝓡∂ (n + 1)).interior M := fun _ hz => (hFU hz).1
    have hFP : Disjoint (tsupport F) (range points) := by
      rw [hrange, disjoint_singleton_right]
      exact hxF
    have hD := D.correct F hF
    have hm := G.nativeJet_forcing_moment g q ν S points hpoints ℓ F hF hFc hFi hFP
      (D.solve F) hD.1 hD.2.2 hD.2.1
    have hzero : ℓ (fun i => secondJet g (D.solve F) (points i)) = 0 := by
      change jetEquation g q x (secondJet g (D.solve F) x) = 0
      rw [jetEquation_secondJet, hD.2.1 x hx]
      exact image_eq_zero_of_notMem_tsupport hxF
    have h := hm.2.symm.trans hzero
    simpa only [Q, smul_eq_mul, mul_comm] using h
  have hpoint : EqOn Q 0 U := Measure.eqOn_open_of_ae_eq
    ((ae_restrict_iff' hU.measurableSet).mpr hae) hU hcont continuousOn_const
  exact (hQ y).symm.trans (hpoint ⟨hy, Ne.symm hxy⟩)

without_proof_info in
theorem DirichletGreenKernel.secondVariable_equation_off_diagonal
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (D : ZeroDirichletSolver g q) {x y : M}
    (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (hy : y ∈ (𝓡∂ (n + 1)).interior M) (hxy : x ≠ y) :
    schrodinger g q (fun z => G.kernel x z) y = 0 := by
  have hG := (G.smooth_off_diagonal (x, y) hxy).contMDiffAt
    ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hxy)
  have hsecond : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (fun z => G.kernel x z) y :=
    (hG.comp y (contMDiffAt_const.prodMk contMDiffAt_id)).of_le (by decide)
  have heq : (fun z => G.kernel x z) =ᶠ[𝓝 y] (fun z => G.kernel z x) := by
    filter_upwards [isOpen_compl_singleton.mem_nhds (Ne.symm hxy)] with z hz
    exact G.symmetric x z (Ne.symm hz)
  calc
    schrodinger g q (fun z => G.kernel x z) y =
        schrodinger g q (fun z => G.kernel z x) y :=
      schrodinger_eq_of_eventuallyEq g q hsecond
        ((G.firstVariable_smoothAt g q ν S (Ne.symm hxy)).of_le (by decide)) heq
    _ = 0 := G.firstVariable_equation_off_diagonal g q ν S D hy hx (Ne.symm hxy)

end ConformalPoisson

end ProofPart_GreenKernelEquation

/- Proof support: NativeOperatorJetFunctional.lean, SHA256 f97c99219d9c815e2ace5afb6a2e5774c06a96847d6b2df3a5d897b80d6d741f -/
noncomputable section ProofPart_NativeOperatorJetFunctional



/- The actual native Schrödinger operator at an interior point is a
continuous linear functional of the full ordinary jet in its own chart. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem exists_nativeOperator_ordinaryJet_functional
    (g : Metric (n := n) (M := M)) (q : M → ℝ) {y : M}
    (hy : y ∈ (𝓡∂ (n + 1)).interior M) :
    ∃ L : OrdinaryJet V →L[ℝ] ℝ,
      ∀ (f : M → ℝ), ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 f y →
        L (ordinarySecondJet (f ∘ (extChartAt (𝓡∂ (n + 1)) y).symm)
          (extChartAt (𝓡∂ (n + 1)) y y)) = schrodinger g q f y := by
  obtain ⟨L, hL⟩ := exists_continuous_functional_extension_of_injective
    (nativeChartJetLinearMap g y) (nativeChartJetLinearMap_injective g y) (jetEquation g q y)
  refine ⟨L, fun f hf => ?_⟩
  have hround := (extChartAt (𝓡∂ (n + 1)) y).left_inv (mem_extChartAt_source y)
  have hread : nativeChartJetLinearMap g y (secondJet g f y) =
      ordinarySecondJet (f ∘ (extChartAt (𝓡∂ (n + 1)) y).symm)
        (extChartAt (𝓡∂ (n + 1)) y y) := by
    rw [nativeChartJetLinearMap_secondJet g y hy hf]
    simp only [ordinarySecondJet, Function.comp_apply, hround]
    rfl
  rw [← hread, hL]
  exact jetEquation_secondJet g q f y

end ConformalPoisson

end ProofPart_NativeOperatorJetFunctional

/- Proof support: GreenInteriorDoubleCharts.lean, SHA256 f9ff7abe76a11babd13b4ff0f0a37d45e0e5496cce1f05563e67994f3776908f -/
noncomputable section ProofPart_GreenInteriorDoubleCharts


/- Disjoint interior coordinate rectangles for the actual off-diagonal Green
kernel. The original manifold retains its boundary and its native charts. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance doubleChartBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.exists_interior_double_chart_domain
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {x y : M} (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (hy : y ∈ (𝓡∂ (n + 1)).interior M) (hxy : x ≠ y) :
    ∃ U W : TopologicalSpace.Opens V,
      extChartAt (𝓡∂ (n + 1)) x x ∈ U ∧ extChartAt (𝓡∂ (n + 1)) y y ∈ W ∧
      (∀ a ∈ U, (extChartAt (𝓡∂ (n + 1)) x).symm a ∈ (𝓡∂ (n + 1)).interior M ∧
        (extChartAt (𝓡∂ (n + 1)) x).symm a ≠ y) ∧
      ContDiffOn ℝ ∞ (fun p : V × V => G.kernel
        ((extChartAt (𝓡∂ (n + 1)) x).symm p.1)
        ((extChartAt (𝓡∂ (n + 1)) y).symm p.2)) ((U : Set V) ×ˢ (W : Set V)) := by
  obtain ⟨P, Q, hP, hQ, hxP, hyQ, hPQ⟩ := t2_separation hxy
  let c := extChartAt (𝓡∂ (n + 1)) x
  let d := extChartAt (𝓡∂ (n + 1)) y
  have hI := (𝓡∂ (n + 1)).isOpen_interior (n := ω) (M := M) (by decide)
  have hc : ContMDiffOn 𝓘(ℝ, V) (𝓡∂ (n + 1)) ∞ c.symm (interior c.target) :=
    (contMDiffOn_extChartAt_symm x).mono interior_subset
  have hd : ContMDiffOn 𝓘(ℝ, V) (𝓡∂ (n + 1)) ∞ d.symm (interior d.target) :=
    (contMDiffOn_extChartAt_symm y).mono interior_subset
  let U : TopologicalSpace.Opens V :=
    ⟨interior c.target ∩ c.symm ⁻¹' ((𝓡∂ (n + 1)).interior M ∩ P),
      hc.continuousOn.isOpen_inter_preimage isOpen_interior (hI.inter hP)⟩
  let W : TopologicalSpace.Opens V :=
    ⟨interior d.target ∩ d.symm ⁻¹' ((𝓡∂ (n + 1)).interior M ∩ Q),
      hd.continuousOn.isOpen_inter_preimage isOpen_interior (hI.inter hQ)⟩
  have hcround : c.symm (c x) = x := c.left_inv (mem_extChartAt_source x)
  have hdround : d.symm (d y) = y := d.left_inv (mem_extChartAt_source y)
  refine ⟨U, W, ⟨ModelWithCorners.isInteriorPoint_iff.mp hx, ?_⟩,
    ⟨ModelWithCorners.isInteriorPoint_iff.mp hy, ?_⟩, ?_, ?_⟩
  · change c.symm (c x) ∈ (𝓡∂ (n + 1)).interior M ∩ P
    rw [hcround]
    exact ⟨hx, hxP⟩
  · change d.symm (d y) ∈ (𝓡∂ (n + 1)).interior M ∩ Q
    rw [hdround]
    exact ⟨hy, hyQ⟩
  · intro a ha
    exact ⟨ha.2.1, fun heq => disjoint_left.mp hPQ (heq ▸ ha.2.2) hyQ⟩
  · intro p hp
    have hcAt := (hc p.1 hp.1.1).contMDiffAt (isOpen_interior.mem_nhds hp.1.1)
    have hdAt := (hd p.2 hp.2.1).contMDiffAt (isOpen_interior.mem_nhds hp.2.1)
    have hne : c.symm p.1 ≠ d.symm p.2 :=
      fun heq => disjoint_left.mp hPQ (heq ▸ hp.1.2.2) hp.2.2.2
    have hG := (G.smooth_off_diagonal (c.symm p.1, d.symm p.2) hne).contMDiffAt
      ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hne)
    have hcomp := hG.comp p
      ((hcAt.comp p contMDiffAt_fst).prodMk (hdAt.comp p contMDiffAt_snd))
    rw [← modelWithCornersSelf_prod, chartedSpaceSelf_prod, contMDiffAt_iff_contDiffAt] at hcomp
    exact hcomp.contDiffWithinAt

end ConformalPoisson

end ProofPart_GreenInteriorDoubleCharts

/- Proof support: GreenJetEquation.lean, SHA256 ceebd6f5689fd138405970c70698a8266653275f4cbe52add0040836eba6333f -/
noncomputable section ProofPart_GreenJetEquation



/- Homogeneity of the actual Green-jet combination away from its finite
poles, derived from the kernel equation and mixed ordinary jet calculus. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenJetEquationBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.greenJetSection_equation
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (D : ZeroDirichletSolver g q)
    {N : ℕ} (points : Fin N → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : Fin N) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    {y : M} (hy : y ∈ (𝓡∂ (n + 1)).interior M) (hyP : y ∉ range points) :
    schrodinger g q (greenJetSection g points ℓ G.kernel) y = 0 := by
  classical
  let c (i : Fin N) := extChartAt (𝓡∂ (n + 1)) (points i)
  let d := extChartAt (𝓡∂ (n + 1)) y
  have hxy (i : Fin N) : points i ≠ y := fun heq => hyP ⟨i, heq⟩
  choose U W hU hW hUI hG using
    fun i => G.exists_interior_double_chart_domain g q ν S (hpoints i) hy (hxy i)
  obtain ⟨L, hL⟩ := exists_nativeOperator_ordinaryJet_functional g q hy
  obtain ⟨A, hA⟩ := G.greenJetSection_eq_continuous_chart_read g q ν S points hpoints ℓ
  let F : Fin N → V → V → ℝ := fun i a b => G.kernel ((c i).symm a) (d.symm b)
  have hEq (i : Fin N) (a : V) (ha : a ∈ U i) :
      L (ordinarySecondJet (F i a) (d y)) = 0 := by
    have hne := (hUI i a ha).2
    have hGsmooth := (G.smooth_off_diagonal ((c i).symm a, y) hne).contMDiffAt
      ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hne)
    have hGs : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (fun z => G.kernel ((c i).symm a) z) y :=
      (hGsmooth.comp y (contMDiffAt_const.prodMk contMDiffAt_id)).of_le (by decide)
    exact (hL _ hGs).trans (G.secondVariable_equation_off_diagonal g q ν S D
      (hUI i a ha).1 hy hne)
  have hKernel := jetFunctional_finite_parameter_kernel
    (Module.finBasis ℝ V) F (fun i => (U i : Set V)) (fun i => (W i : Set V))
    (fun i => (U i).isOpen) (fun i => (W i).isOpen)
    (fun i => c i (points i)) hU (d y) hW hG L hEq A.toLinearMap
  have hround (i : Fin N) : (c i).symm (c i (points i)) = points i :=
    (c i).left_inv (mem_extChartAt_source (points i))
  have hdround : d.symm (d y) = y := d.left_inv (mem_extChartAt_source y)
  have hnbhd : ∀ᶠ b : V in 𝓝 (d y), d.symm b ∉ range points := by
    have hcont := (continuousAt_extChartAt_symm (I := 𝓡∂ (n + 1)) y).tendsto
    rw [hdround] at hcont
    exact hcont.eventually ((finite_range points).isClosed.isOpen_compl.mem_nhds hyP)
  have heq : (greenJetSection g points ℓ G.kernel ∘ d.symm) =ᶠ[𝓝 (d y)]
      (fun b => A (fun i => ordinarySecondJet (fun a => F i a b) (c i (points i)))) := by
    filter_upwards [hnbhd] with b hb
    simpa only [Function.comp_apply, chartOrdinarySecondJet, ordinarySecondJet, F,
      Function.comp_def, hround, c] using hA (d.symm b) hb
  have hH : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (greenJetSection g points ℓ G.kernel) y :=
    ((G.greenJetSection_smooth g q ν S points hpoints ℓ y hyP).contMDiffAt
      ((finite_range points).isClosed.isOpen_compl.mem_nhds hyP)).of_le (by decide)
  calc
    schrodinger g q (greenJetSection g points ℓ G.kernel) y =
        L (ordinarySecondJet (greenJetSection g points ℓ G.kernel ∘ d.symm) (d y)) :=
      (hL _ hH).symm
    _ = L (ordinarySecondJet
        (fun b => A (fun i => ordinarySecondJet (fun a => F i a b) (c i (points i)))) (d y)) :=
      congrArg L (ordinarySecondJet_eq_of_eventuallyEq heq)
    _ = 0 := hKernel.2

end ConformalPoisson

end ProofPart_GreenJetEquation

