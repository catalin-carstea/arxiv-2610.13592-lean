  rw [firstOrder_restrictL_one_eq]
  apply W1p.restrictL_mem_w1p0Submodule_of_isCompact hηc hηV hw0
  rw [Wkp.value_firstOrder]
  filter_upwards [hw] with x hx hxK
  rw [hx, image_eq_zero_of_notMem_tsupport hxK, zero_mul]

without_proof_info in
theorem cutoff_reading_restrict
    {Ω V : Opens E} (η : E → ℝ) (u w : Wkp μ Ω p 2)
    (hw : Wkp.value 2 w =ᵐ[μ.restrict Ω] fun x => η x * Wkp.value 2 u x) :
    Wkp.value 2 (Wkp.restrictL (inf_le_left : Ω ⊓ V ≤ Ω) 2 w) =ᵐ[μ.restrict (Ω ⊓ V)]
      fun x => η x * Wkp.value 2 (Wkp.restrictL (inf_le_left : Ω ⊓ V ≤ Ω) 2 u) x := by
  filter_upwards [Wkp.value_restrictL_ae (inf_le_left : Ω ⊓ V ≤ Ω) 2 w,
    Wkp.value_restrictL_ae (inf_le_left : Ω ⊓ V ≤ Ω) 2 u,
    ae_restrict_of_ae_restrict_of_subset (fun _ hx => hx.1) hw] with x hwR huR hx
  rw [hwR, huR, hx]

end ConformalPoisson

