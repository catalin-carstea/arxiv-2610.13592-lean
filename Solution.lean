      traceCLM ℝ F (A ∘L iteratedGradientChain u 1 (e x)) := by
  have h := trace_conjugate_principal_hessian e A (iteratedGradientChain u 1 (e x))
  rw [iteratedGradientChain_one_comp_isometry]
  rw [e.iteratedGradientCongr_symm_succ_apply 0, e.iteratedGradientCongr_zero] at h
