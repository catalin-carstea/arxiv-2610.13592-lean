without_proof_info in
theorem exists_eLpNorm_toReal_bound_of_uniform_bound
    {X E : Type*} [MeasurableSpace X] [NormedAddCommGroup E]
    (μ : Measure X) [IsFiniteMeasure μ] (p : ℝ≥0∞) :
    ∃ C ≥ 0, ∀ (f : X → E), AEStronglyMeasurable f μ →
      ∀ B : ℝ, 0 ≤ B → (∀ x, ‖f x‖ ≤ B) → (eLpNorm f p μ).toReal ≤ C * B := by
  let K := μ univ ^ (1 / p.toReal)
  have hK : K ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) (measure_ne_top μ univ)
  refine ⟨K.toReal, ENNReal.toReal_nonneg, ?_⟩
  intro f hf B hB hb
  obtain ⟨hfTop, hTop⟩ := memLp_top_and_lpNorm_le_of_ae_bound hf hB (Filter.Eventually.of_forall hb)
  have he := eLpNorm_le_eLpNorm_mul_rpow_measure_univ (show p ≤ ⊤ from le_top) hf
  simp only [ENNReal.toReal_top, div_zero, sub_zero] at he
  have hr := ENNReal.toReal_mono (ENNReal.mul_ne_top hfTop.eLpNorm_ne_top hK) he
  rw [ENNReal.toReal_mul] at hr
  exact hr.trans ((mul_le_mul_of_nonneg_right hTop ENNReal.toReal_nonneg).trans_eq (mul_comm _ _))

