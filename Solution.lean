without_proof_info in
theorem inverse_eqOn_of_gram_eqOn (F₁ F₂ : NormalMetricField S)
    (hG : EqOn F₁.gram F₂.gram S) : EqOn F₁.inverse F₂.inverse S := by
  intro z hz
  have hi₁ : F₁.inverse z * F₁.gram z = 1 := F₁.inverse_gram hz
  have hi₂ : F₂.gram z * F₂.inverse z = 1 := F₂.gram_inverse hz
  calc
    F₁.inverse z = F₁.inverse z * 1 := (mul_one _).symm
    _ = F₁.inverse z * (F₂.gram z * F₂.inverse z) := by rw [hi₂]
    _ = (F₁.inverse z * F₁.gram z) * F₂.inverse z := by rw [hG hz, mul_assoc]
    _ = F₂.inverse z := by rw [hi₁, one_mul]

without_proof_info in
theorem tau_eqOn_of_gram_eqOn (F₁ F₂ : NormalMetricField S)
    (hG : EqOn F₁.gram F₂.gram S) : EqOn F₁.tau F₂.tau S := by
  have hA := inverse_eqOn_of_gram_eqOn F₁ F₂ hG
  have hDA := normalJet_eqOn S.isOpen hA 1
