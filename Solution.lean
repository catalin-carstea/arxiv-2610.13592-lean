/- Proof support: InverseConformalPairing.lean, SHA256 367f4f59de83c4fa9981adc9c824db8beffc34a1d6326c9a266eabcb682db8a0 -/
noncomputable section ProofPart_InverseConformalPairing





/- The ACTUAL inverse intertwining reciprocates the recovered constant
and the original multiplier. This is a local differential calculation
on the old matching region, not a boundary inverse assumption. -/
open Bundle Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem inverse_conformal_scalar (k c s a b : ℝ) (hk : 0 < k) (hc : 0 < c)
    (h : b = k * c ^ s * a) : a = k⁻¹ * (c⁻¹) ^ s * b := by
  rw [Real.inv_rpow hc.le]
  have hn := (Real.rpow_pos_of_pos hc s).ne'
  field_simp
  nlinarith [h]

variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem inverse_conformal_pairing_at
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (c : M₁ → ℝ) (k s : ℝ) (hk : 0 < k)
    (hc : ∀ y ∈ J.source, 0 < c y)
    (hmetric : ∀ y ∈ J.source, ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
      g₂.inner (J y) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y w) = k * c y ^ s * g₁.inner y v w)
    {F : EuclideanHalfSpace (n + 1) → M₁} {χ : EuclideanHalfSpace (n + 1) → M₂}
    {z : EuclideanHalfSpace (n + 1)} (hFsource : F z ∈ J.source)
    (hF : MDifferentiableAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z)
    (hcomp : (J ∘ F) =ᶠ[𝓝 z] χ)
    (v w : EuclideanSpace ℝ (Fin (n + 1))) :
    nativeMapPullbackPairing g₁ F z v w =
      k⁻¹ * ((c (F z))⁻¹) ^ s * nativeMapPullbackPairing g₂ χ z v w := by
  have hJ := J.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) hFsource
  have hD := hcomp.mfderiv_eq (I := 𝓡∂ (n + 1)) (I' := 𝓡∂ (n + 1))
  rw [mfderiv_comp z hJ hF] at hD
  have hv := congrArg (fun L => L v) hD
  have hw := congrArg (fun L => L w) hD
  change mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J (F z)
    (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z v) =
      mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z v at hv
  change mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J (F z)
    (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z w) =
      mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z w at hw
  have hpoint : J (F z) = χ z := hcomp.eq_of_nhds
  have h := hmetric (F z) hFsource
    (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z v)
    (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) F z w)
  rw [hv, hw, hpoint] at h
  exact inverse_conformal_scalar k (c (F z)) s
    (nativeMapPullbackPairing g₁ F z v w) (nativeMapPullbackPairing g₂ χ z v w)
    hk (hc (F z) hFsource) h
end ConformalPoisson

end ProofPart_InverseConformalPairing

/- Proof support: ConformalPolynomialIdentity.lean, SHA256 9beab45ad84cf4494a88e37c921e22d054f4941a627e37a21c5882d9493daf1f -/
noncomputable section ProofPart_ConformalPolynomialIdentity



/- Eliminate the fractional conformal power on the matching open set.
Only this integer-power identity will be continued to the boundary. -/
namespace ConformalPoisson

without_proof_info in
theorem conformal_power_integer_identity (c : ℝ) (hc : 0 < c) (m : ℕ) (hm : 0 < m) :
    (c ^ (4 / (m : ℝ))) ^ m = c ^ (4 : ℕ) := by
  have hm' : (m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hm)
  calc (c ^ (4 / (m : ℝ))) ^ m = (c ^ (4 / (m : ℝ))) ^ (m : ℝ) :=
         (Real.rpow_natCast _ _).symm
       _ = c ^ ((4 / (m : ℝ)) * (m : ℝ)) := (Real.rpow_mul hc.le _ _).symm
       _ = c ^ (4 : ℝ) := by rw [div_mul_cancel₀ _ hm']
       _ = c ^ (4 : ℕ) := Real.rpow_natCast _ _

without_proof_info in
theorem conformal_weighted_polynomial_identity (rho K c a b : ℝ) (m : ℕ) (hm : 0 < m)
    (hc : 0 < c) (hscale : rho = K * c ^ (4 / (m : ℝ))) (hdatum : b = c * a) :
    rho ^ m * a ^ 4 = K ^ m * b ^ 4 := by
  rw [hscale, mul_pow, conformal_power_integer_identity c hc m hm, hdatum, mul_pow]
  ring
end ConformalPoisson

end ProofPart_ConformalPolynomialIdentity

