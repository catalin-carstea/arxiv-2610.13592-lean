open Bundle Set MeasureTheory TauCeti Filter TopologicalSpace
open scoped Manifold ContDiff Topology ENNReal
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

structure NativePoleCutoffData (x : M) (G : M → ℝ) where
  cutoff : M → ℝ
  smooth : ContMDiff Ihalf 𝓘(ℝ) ∞ cutoff
  compact : HasCompactSupport cutoff
  interior_support : tsupport cutoff ⊆ (Ihalf).interior M
  one_domain : Opens M
  center : x ∈ one_domain
  one : EqOn cutoff (fun _ => 1) one_domain
  extension : M → ℝ
  extension_smooth : ContMDiff Ihalf 𝓘(ℝ) ∞ extension
  extension_interior_support : tsupport extension ⊆ (Ihalf).interior M
