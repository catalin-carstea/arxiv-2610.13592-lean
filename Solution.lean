noncomputable section ProofPart_DNSymbol_DNRealImagSplitReading



/- Assignment268, /root. Real/imaginary continuous-linear readings of the
complex scalar expression are the SAME original real scalar expressions. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Finset
open scoped ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "b" => EuclideanSpace.basisFun (Fin n) ℝ

without_proof_info in
theorem clm_real_mul (L : ℂ →L[ℝ] ℝ) (a : ℝ) (z : ℂ) : L ((a : ℂ) * z) = a * L z := by
  simpa only [Complex.real_smul, smul_eq_mul] using L.map_smul a z

without_proof_info in
theorem clm_complexSplitOperator (L : ℂ →L[ℝ] ℝ) (A : Matrix (Fin n) (Fin n) ℝ)
    (τ : ℝ) (c : Fin n → ℝ) {W : Y × ℝ → ℂ} (hW : ContDiff ℝ ∞ W) (y : Y) (t : ℝ) :
    L (complexSplitOperator (fun i j => (A i j : ℂ)) (τ : ℂ) (fun i => (c i : ℂ)) W y t) =
      realSplitOperator A τ c (L ∘ W) y t := by
  have hmapN : ContDiff ℝ ∞ (fun r : ℝ => ((y, r) : Y × ℝ)) := contDiff_const.prodMk contDiff_id
  have hmapT : ContDiff ℝ ∞ (fun z : Y => ((z, t) : Y × ℝ)) := contDiff_id.prodMk contDiff_const
  have hWN : ContDiff ℝ ∞ (fun r : ℝ => W (y, r)) := hW.comp hmapN
  have hWT : ContDiff ℝ ∞ (fun z : Y => W (z, t)) := hW.comp hmapT
  have hN : deriv (fun r : ℝ => (L ∘ W) (y, r)) t = L (splitNormal W y t) := by
    have he := clm_post_fderiv_direction L (hWN.differentiable (by decide) t) (1 : ℝ)
    simpa only [Function.comp_def, fderiv_apply_one_eq_deriv, splitNormal] using he
  have hNN : deriv (deriv (fun r : ℝ => (L ∘ W) (y, r))) t = L (splitNormalSecond W y t) := by
    have he := clm_post_fderiv_twice_direction L hWN t (1 : ℝ) (1 : ℝ)
    simpa only [Function.comp_def, fderiv_apply_one_eq_deriv, splitNormalSecond] using he
  have hT (i : Fin n) : fderiv ℝ (fun z : Y => (L ∘ W) (z, t)) y (b i) = L (splitFirst W y t i) :=
    clm_post_fderiv_direction L (hWT.differentiable (by decide) y) (b i)
  have hTT (i j : Fin n) :
      fderiv ℝ (fun z => fderiv ℝ (fun w : Y => (L ∘ W) (w, t)) z (b j)) y (b i) =
        L (splitSecond W y t i j) := clm_post_fderiv_twice_direction L hWT y (b i) (b j)
  unfold realSplitOperator
  rw [hNN]
  simp_rw [hTT, hN, hT]
  unfold complexSplitOperator
  have hτ : ((τ / 2 : ℝ) : ℂ) = (τ : ℂ) / 2 := by simp
  rw [← hτ]
  simp only [map_sub, map_neg, map_add, map_sum, clm_real_mul]

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNRealImagSplitReading

/- DN finite-layer support: DNPairedCoordinateOperator.lean, SHA256 10ed741dbe97e5be715f0156796c350b7db07680dc1968cb2b754642c2031ed8 -/
noncomputable section ProofPart_DNSymbol_DNPairedCoordinateOperator


/- Assignment268, /root. Pairing the original real normal-form operators
is exactly the complex split scalar expression, with the original signed q. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem pairedNormalCoordinate_eq_complexSplit
    {S : TopologicalSpace.Opens H} (F : NormalMetricField S) (q : H → ℝ)
    (W : Y × ℝ → ℂ) (hW : ContDiff ℝ ∞ W) (z : H) :
    Complex.mk
      (normalCoordinateSchrodinger F q (fun v => (W ((euclideanHalfSpaceBoundaryNormalEquiv n).symm v)).re) z)
      (normalCoordinateSchrodinger F q (fun v => (W ((euclideanHalfSpaceBoundaryNormalEquiv n).symm v)).im) z) =
    complexSplitOperator (fun i j => (F.inverse z i j : ℂ)) (F.tau z : ℂ)
      (fun a => (metricTangentialDrift F a z : ℂ)) W (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2 +
      (q z : ℂ) * W (nativeNormalCoordinates z) := by
  let A := F.inverse z
  let τ := F.tau z
  let c := fun a => metricTangentialDrift F a z
  let w := nativeNormalCoordinates z
  apply Complex.ext
  · simp only [Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
    calc
      _ = realSplitOperator A τ c (Complex.reCLM ∘ W) w.1 w.2 + q z * (W w).re :=
        normalCoordinateSchrodinger_eq_realSplit F q (W := Complex.reCLM ∘ W) (Complex.reCLM.contDiff.comp hW) z
      _ = _ := congrArg (fun r : ℝ => r + q z * (W w).re)
        (clm_complexSplitOperator Complex.reCLM A τ c hW w.1 w.2).symm
  · simp only [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
    calc
      _ = realSplitOperator A τ c (Complex.imCLM ∘ W) w.1 w.2 + q z * (W w).im :=
        normalCoordinateSchrodinger_eq_realSplit F q (W := Complex.imCLM ∘ W) (Complex.imCLM.contDiff.comp hW) z
      _ = _ := congrArg (fun r : ℝ => r + q z * (W w).im)
        (clm_complexSplitOperator Complex.imCLM A τ c hW w.1 w.2).symm

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNPairedCoordinateOperator

