/- Actual localized differences for the C3 reflected function. No normal
translation equation is asserted; the boundary argument later restricts
this continuous family to tangential parameters. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [ProperSpace E]

without_proof_info in
theorem exists_localizedSolutionDifference_ballJets_c3 {α : ℝ≥0} (hα : α ≤ 1)
    (χ u : E → ℝ) (hχ : ContDiff ℝ ∞ χ) (hχbound : ∀ x, ‖χ x‖ ≤ 1)
    (hχsphere : ∀ x ∈ sphere (0 : E) 1, χ x = 0)
    (hu : ContDiffOn ℝ 3 u (ball 0 3)) :
    ∃ J : E → BallSpace α E ℝ, ContinuousOn J (ball (0 : E) 1) ∧
      ∀ a ∈ ball (0 : E) 1, ∀ x : closedBall (0 : E) 1,
        (J a).val.1 x = localizedSolutionDifference χ u a x ∧
        (J a).val.2.1 x = fderiv ℝ (localizedSolutionDifference χ u a) x ∧
        (J a).val.2.2 x = fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u a)) x := by
  have hPhi : ContDiff ℝ 3 (fun z : E × E => localizedTranslation χ z.1 z.2) :=
    contDiff_snd.add (((hχ.of_le (by simp)).comp contDiff_snd).smul contDiff_fst)
  have hcomp : ContDiffOn ℝ 3 (fun z : E × E => u (localizedTranslation χ z.1 z.2))
      (ball (0 : E) 1 ×ˢ ball (0 : E) 2) :=
    hu.comp hPhi.contDiffOn (fun z hz => localizedTranslation_mem_ball_three χ hχbound hz.1 hz.2)
  have hsnd : ContDiffOn ℝ 3 (fun z : E × E => u z.2)
      (ball (0 : E) 1 ×ˢ ball (0 : E) 2) :=
    hu.comp contDiffOn_snd (fun z hz => ball_subset_ball (by norm_num : (2 : ℝ) ≤ 3) hz.2)
  apply exists_ballJets_of_c3_joint_family hα isOpen_ball
    (closedBall_subset_ball (by norm_num : (1 : ℝ) < 2))
    (localizedSolutionDifference χ u) (hcomp.sub hsnd)
  intro a ha x hx
  simp [localizedSolutionDifference, localizedTranslation, hχsphere x hx]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_FiniteLocalizedSolutionFamily

/- Boundary analytic support: InhomogeneousPullbackEquation.lean, SHA256 43ace3b04decb0030c25e18024e8bedcf46cbe11614d3b8734818402ecbe0cf2 -/
noncomputable section ProofPart_BoundaryAnalytic_InhomogeneousPullbackEquation



/- The actual C2 inhomogeneous equation for the same difference. The source
field is read at the translated point; it is not discarded or absorbed into
an unproved homogeneous extension. -/
open Set Metric Filter
open scoped NNReal ContDiff Topology BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F

without_proof_info in
theorem localizedSolutionDifference_inhomogeneous_operator_equation (hα : α ≤ 1)
    (A : V → V →L[ℝ] V) (b : V → V) (q χ u source : V → ℝ) (a : V)
    (hχ : ContDiff ℝ ∞ χ) (hχbound : ∀ x, ‖χ x‖ ≤ 1)
    (hu : ContDiffOn ℝ 2 u (ball 0 3)) (ha : a ∈ ball (0 : V) 1)
    (hLu : ∀ y ∈ ball (0 : V) 3, coordinateSchrodinger A b q u y = source y)
    (AH : H (V →L[ℝ] V)) (BH : H V) (QH : H ℝ) (KH : H (V →L[ℝ] V))
    (CH : H (V →L[ℝ] V →L[ℝ] ℝ)) (j : HolderJet α V) (J : BallSpace α V ℝ) (GH : H ℝ)
    (hSource : ∀ x : closedBall (0 : V) 1, GH x = source (localizedTranslation χ a x))
    (hA : ∀ x : closedBall (0 : V) 1, AH x = A (localizedTranslation χ a x))
    (hB : ∀ x : closedBall (0 : V) 1, BH x = b (localizedTranslation χ a x))
    (hQ : ∀ x : closedBall (0 : V) 1, QH x = q (localizedTranslation χ a x))
    (hC : ∀ x : closedBall (0 : V) 1, CH x = fderiv ℝ (fderiv ℝ χ) x)
    (hK : ∀ x : closedBall (0 : V) 1,
      (fderiv ℝ (localizedTranslation χ a) x).comp (KH x) = ContinuousLinearMap.id ℝ V)
    (hj : ∀ x : closedBall (0 : V) 1, j.1 x = u x ∧
      j.2.1 x = fderiv ℝ u x ∧ j.2.2 x = fderiv ℝ (fderiv ℝ u) x)
    (hJ : ∀ x : closedBall (0 : V) 1,
      J.val.1 x = localizedSolutionDifference χ u a x ∧
      J.val.2.1 x = fderiv ℝ (localizedSolutionDifference χ u a) x ∧
      J.val.2.2 x = fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u a)) x) :
    pulledBackBallOperator hα AH BH QH KH CH a J =
      GH - pulledBackHolderOperator AH BH QH KH CH a j := by
  apply eq_sub_iff_add_eq.2
  apply TauCeti.HolderSpace.ext
  intro x
  simp only [TauCeti.HolderSpace.add_apply]
  have hJread : (ballHolderJetL hα J).1 x = localizedSolutionDifference χ u a x ∧
      (ballHolderJetL hα J).2.1 x = fderiv ℝ (localizedSolutionDifference χ u a) x ∧
      (ballHolderJetL hα J).2.2 x =
        fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u a)) x := by
    simpa [ballHolderJetL] using hJ x
  change pulledBackHolderOperator AH BH QH KH CH a (ballHolderJetL hα J) x +
    pulledBackHolderOperator AH BH QH KH CH a j x = GH x
  rw [pulledBackHolderOperator_eq_expression A b q χ a AH BH QH KH CH
    (ballHolderJetL hα J) (localizedSolutionDifference χ u a) x
    (hA x) (hB x) (hQ x) (hC x) hJread,
    pulledBackHolderOperator_eq_expression A b q χ a AH BH QH KH CH j u x
      (hA x) (hB x) (hQ x) (hC x) (hj x)]
  have hx2 : (x : V) ∈ ball 0 2 :=
    closedBall_subset_ball (by norm_num : (1 : ℝ) < 2) x.property
  have hx3 : (x : V) ∈ ball 0 3 := ball_subset_ball (by norm_num : (2 : ℝ) ≤ 3) hx2
  have hPhi3 := localizedTranslation_mem_ball_three χ hχbound ha hx2
  have hux : ContDiffAt ℝ 2 u (x : V) :=
    ((hu x hx3).contDiffAt (isOpen_ball.mem_nhds hx3)).of_le (by simp)
  have hup : ContDiffAt ℝ 2 u (localizedTranslation χ a x) :=
    ((hu _ hPhi3).contDiffAt (isOpen_ball.mem_nhds hPhi3)).of_le (by simp)
  have hχx : ContDiffAt ℝ 2 χ (x : V) := hχ.contDiffAt.of_le (by simp)
  have hPhi : ContDiffAt ℝ 2 (localizedTranslation χ a) (x : V) :=
    contDiffAt_id.add (hχx.smul contDiffAt_const)
  have hcomp : ContDiffAt ℝ 2 (u ∘ localizedTranslation χ a) (x : V) := hup.comp (x : V) hPhi
  change pulledBackCoordinateExpression A b q χ a (KH x)
      ((u ∘ localizedTranslation χ a) - u) x +
    pulledBackCoordinateExpression A b q χ a (KH x) u x = GH x
  rw [pulledBackCoordinateExpression_sub A b q χ a (KH x)
    (u ∘ localizedTranslation χ a) u x hcomp hux, sub_add_cancel]
  exact (pulledBackCoordinateExpression_comp A b q χ u a x (KH x) hχx hup (hK x)).trans
    ((hLu _ hPhi3).trans (hSource x).symm)


end ConformalPoisson.DirichletHolder

end ProofPart_BoundaryAnalytic_InhomogeneousPullbackEquation

/- Boundary analytic support: InhomogeneousAnalyticJets.lean, SHA256 a7dfb50d5f6264aac799c67e8e51271bd08d39328ef1d1e8e70a75b55c16e3e3 -/
noncomputable section ProofPart_BoundaryAnalytic_InhomogeneousAnalyticJets



/- Analyticity of the actual continuous jet family from an inhomogeneous
pulled-back equation. Concrete reflected families, the same solution equation
and the local inverse are still supplied by their actual producers. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "BX" => BallSpace α V ℝ
variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P] [CompleteSpace P]
  {p : P}

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem analyticAt_jetFamily_of_inhomogeneous_pulledBack_equation
    (hα : α ≤ 1)
    (A K : P → H (V →L[ℝ] V)) (B : P → H V) (Q G : P → H ℝ) (a : P → V)
    (hA : AnalyticAt ℝ A p) (hB : AnalyticAt ℝ B p) (hQ : AnalyticAt ℝ Q p)
    (hK : AnalyticAt ℝ K p) (hG : AnalyticAt ℝ G p) (ha : AnalyticAt ℝ a p)
    (C : H (V →L[ℝ] V →L[ℝ] ℝ)) (j : HolderJet α V)
    (S : (H ℝ) →L[ℝ] BX) (J : P → BX) (hJ : ContinuousAt J p)
    (hinv : (S.comp (pulledBackBallOperator hα (A p) (B p) (Q p) (K p) C (a p))).IsInvertible)
    (heq : ∀ᶠ z in 𝓝 p,
      pulledBackBallOperator hα (A z) (B z) (Q z) (K z) C (a z) (J z) =
        G z - pulledBackHolderOperator (A z) (B z) (Q z) (K z) C (a z) j) :
    AnalyticAt ℝ J p := by
  let Lall : P → HolderJet α V →L[ℝ] H ℝ :=
    fun z => pulledBackHolderOperator (A z) (B z) (Q z) (K z) C (a z)
  let Lball : P → BX →L[ℝ] H ℝ :=
    fun z => pulledBackBallOperator hα (A z) (B z) (Q z) (K z) C (a z)
  have hLall : AnalyticAt ℝ Lall p :=
    analyticAt_pulledBackHolderOperator hA hB hQ hK ha C
  have hLball : AnalyticAt ℝ Lball p :=
    analyticAt_pulledBackBallOperator hα hA hB hQ hK ha C
  let R : P → BX →L[ℝ] BX := fun z => S.comp (Lball z)
  let CR : (BX →L[ℝ] H ℝ) →L[ℝ] (BX →L[ℝ] BX) :=
    (ContinuousLinearMap.compL ℝ BX (H ℝ) BX) S
  have hR : AnalyticAt ℝ R p := (CR.analyticAt _).comp hLball
  let ev : (HolderJet α V →L[ℝ] H ℝ) →L[ℝ] H ℝ :=
    ContinuousLinearMap.apply ℝ (H ℝ) j
  have hforce : AnalyticAt ℝ (fun z => G z - Lall z j) p :=
    hG.sub ((ev.analyticAt _).comp hLall)
  have hsource : AnalyticAt ℝ (fun z => S (G z - Lall z j)) p :=
    (S.analyticAt _).comp hforce
  apply analyticAt_of_operator_equation hR hsource hJ hinv
  filter_upwards [heq] with z hz
  change S (Lball z (J z)) = S (G z - Lall z j)
  exact congrArg S hz

without_proof_info in
theorem analyticAt_solutionHolderJets_of_difference_family
    (hα : α ≤ 1) (J : P → BX) (hJ : AnalyticAt ℝ J p) (j : HolderJet α V) :
    AnalyticAt ℝ (fun z => ballHolderJetL hα (J z) + j) p :=
  (((ballHolderJetL hα).analyticAt _).comp hJ).add analyticAt_const

end ConformalPoisson

end ProofPart_BoundaryAnalytic_InhomogeneousAnalyticJets

