noncomputable section ProofPart_GaugedMetricGerm



/- Actual local metric coefficient agreement around the original boundary
base, obtained by PROJECT analytic uniqueness from the recovered jets. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂] [SecondCountableTopology M₁] [SecondCountableTopology M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.exists_equal_gram_neighborhood
    (hSymbol : LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (hn : 2 ≤ n) (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    ∃ (U : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))),
      U ≤ C.coefficientDomain ∧ EuclideanHalfSpace.boundaryParam n C.boundaryBase ∈ U ∧
      EqOn C.metricField₁.gram C.metricField₂.gram U := by
  obtain ⟨S, hS, hbase, hjets⟩ := P.exists_equal_metric_normalJets hSymbol
    hcompact₁ hcompact₂ hconnected₁ hconnected₂ hn C
  let W := EuclideanHalfSpace.boundaryParam n ⁻¹' (S : Set _)
  have hW : IsOpen W := S.isOpen.preimage EuclideanHalfSpace.continuous_boundaryParam
  have hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S := fun _ hy => hy
  have hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω C.metricField₁.gram S :=
    fun z hz => ((C.metricField₁_analytic P.metricAnalyticOn₁ (hS hz)).1).contMDiffWithinAt
  have hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω C.metricField₂.gram S :=
    fun z hz => ((C.metricField₂_analytic P.metricAnalyticOn₂ (hS hz)).1).contMDiffWithinAt
  have he : C.metricField₁.gram =ᶠ[𝓝 (EuclideanHalfSpace.boundaryParam n C.boundaryBase)] C.metricField₂.gram :=
    native_analytic_eventuallyEq_of_normalJets S.isOpen hG₁ hG₂ hW hWS hbase (fun k => (hjets k).2)
  obtain ⟨U, hUsub, hUopen, hUbase⟩ := mem_nhds_iff.mp (inter_mem he (S.isOpen.mem_nhds hbase))
  exact ⟨⟨U, hUopen⟩, fun z hz => hS (hUsub hz).2, hUbase, fun z hz => (hUsub hz).1⟩

omit [T2Space M₁] [T2Space M₂] [SecondCountableTopology M₁] [SecondCountableTopology M₂] in
without_proof_info in
theorem BoundaryGaugePair.commonCharts_inner_eq
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ C.coefficientDomain)
    (hgram : C.metricField₁.gram z = C.metricField₂.gram z)
    (u v : EuclideanSpace ℝ (Fin (n + 1))) :
    P.metric₁.inner (C.chart₁ z) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) C.chart₁ z u)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) C.chart₁ z v) =
    P.metric₂.inner (C.chart₂ z) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) C.chart₂ z u)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) C.chart₂ z v) :=
  normalChart_inner_eq_of_gram_eq C.geometry₁ C.geometry₂ hz (C.source_eq ▸ hz) hgram u v
end ConformalPoisson

