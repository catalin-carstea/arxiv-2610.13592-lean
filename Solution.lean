/- A complete C1 graph on the closed unit ball, with complex scalars.
Its bounded real-linear Holder reading is the intended norm bridge for
analytic translated coefficients; spatial cutoffs need only be smooth. -/
open Set Metric Filter Topology
open scoped BoundedContinuousFunction NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {V F : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [NormedSpace ℝ F] [IsScalarTower ℝ ℂ F]

local notation "Fields" =>
  ((closedBall (0 : V) 1 →ᵇ F) × (closedBall (0 : V) 1 →ᵇ (V →L[ℝ] F)))

-- Select the compatible parent dictionaries once for the product field space.
-- Its norm and operations are the canonical product/uniform ones.
local instance : AddCommMonoid Fields :=
  (inferInstance : NormedAddCommGroup Fields).toAddCommGroup.toAddCommMonoid

local instance : Module ℂ Fields := (inferInstance : NormedSpace ℂ Fields).toModule
local instance : Module ℝ Fields := (inferInstance : NormedSpace ℝ Fields).toModule

without_proof_info in
theorem domainRead_complex_smul (s : Set V) (c : ℂ) (f : s → F) :
    domainRead s (c • f) = c • domainRead s f := by
  classical
  funext x
  by_cases hx : x ∈ s <;> simp [domainRead, hx]

def c1BallGraph : Submodule ℂ
    ((closedBall (0 : V) 1 →ᵇ F) × (closedBall (0 : V) 1 →ᵇ (V →L[ℝ] F))) where
  carrier := {J | ∀ x ∈ ball (0 : V) 1,
    HasFDerivAt (domainRead (closedBall 0 1) J.1)
      (domainRead (closedBall 0 1) J.2 x) x}
  zero_mem' := by
    intro x hx
    simpa using hasFDerivAt_zero (𝕜 := ℝ) (F := F) x
  add_mem' := by
    intro J K hJ hK x hx
    simpa using (hJ x hx).add (hK x hx)
  smul_mem' := by
    intro c J hJ x hx
    simpa only [Prod.smul_fst, Prod.smul_snd, BoundedContinuousFunction.coe_smul,
      domainRead_complex_smul, Pi.smul_apply,
      domainRead_of_mem _ _ (ball_subset_closedBall hx)] using (hJ x hx).const_smul c

instance normedAddCommGroup_c1BallGraph :
    NormedAddCommGroup (c1BallGraph (V := V) (F := F)) := by
  unfold c1BallGraph
  infer_instance

instance normedSpace_c1BallGraph : NormedSpace ℂ (c1BallGraph (V := V) (F := F)) := by
  exact Submodule.normedSpace (𝕜 := ℂ) (R := ℂ) (E := Fields)
    (c1BallGraph (V := V) (F := F))

instance normedSpaceReal_c1BallGraph : NormedSpace ℝ (c1BallGraph (V := V) (F := F)) :=
  Submodule.normedSpace (𝕜 := ℝ) (R := ℂ) (E := Fields)
    (c1BallGraph (V := V) (F := F))

without_proof_info in
theorem isClosed_c1BallGraph : IsClosed (c1BallGraph (V := V) (F := F) :
    Set ((closedBall (0 : V) 1 →ᵇ F) × (closedBall (0 : V) 1 →ᵇ (V →L[ℝ] F)))) :=
  isClosed_domainDerivativeGraph (closedBall 0 1) isOpen_ball ball_subset_closedBall
    id uniformContinuous_id

instance [CompleteSpace F] : CompleteSpace (c1BallGraph (V := V) (F := F)) :=
  (isClosed_c1BallGraph (V := V) (F := F)).completeSpace_coe

without_proof_info in
theorem c1BallGraph_holderWith {α : ℝ≥0} (hα : α ≤ 1)
    (J : c1BallGraph (V := V) (F := F)) :
    HolderWith (3 * ‖J‖₊) α J.val.1 := by
  apply holderWith_of_ball_derivative hα J.val.1 J.val.2
  · intro x hx
    simpa only [domainRead_of_mem _ _ (ball_subset_closedBall hx)] using J.property x hx
  · exact norm_fst_le J.val
  · exact norm_snd_le J.val

def c1BallHolder {α : ℝ≥0} (hα : α ≤ 1)
    (J : c1BallGraph (V := V) (F := F)) :
    TauCeti.HolderSpace α (closedBall (0 : V) 1) F :=
  TauCeti.HolderSpace.ofBoundedContinuousFunction J.val.1 (c1BallGraph_holderWith hα J).memHolder

without_proof_info in
@[simp] theorem c1BallHolder_apply {α : ℝ≥0} (hα : α ≤ 1)
    (J : c1BallGraph (V := V) (F := F)) (x : closedBall (0 : V) 1) :
    c1BallHolder hα J x = J.val.1 x := by simp [c1BallHolder]

without_proof_info in
theorem norm_c1BallHolder_le {α : ℝ≥0} (hα : α ≤ 1)
    (J : c1BallGraph (V := V) (F := F)) : ‖c1BallHolder hα J‖ ≤ 4 * ‖J‖ := by
  have h := TauCeti.HolderSpace.norm_le_of_norm_le_of_holderWith
    (f := c1BallHolder hα J) (M := ‖J‖) (norm_nonneg J)
    (fun x => by simpa using (J.val.1.norm_coe_le_norm x).trans (norm_fst_le J.val))
    (by simpa only [funext (c1BallHolder_apply hα J)] using c1BallGraph_holderWith hα J)
  convert h using 1
  push_cast
  ring

local instance : AddCommMonoid (c1BallGraph (V := V) (F := F)) :=
  (inferInstance : NormedAddCommGroup (c1BallGraph (V := V) (F := F))).toAddCommGroup.toAddCommMonoid

local instance : Module ℝ (c1BallGraph (V := V) (F := F)) :=
  (inferInstance : NormedSpace ℝ (c1BallGraph (V := V) (F := F))).toModule

def c1BallHolderL {α : ℝ≥0} (hα : α ≤ 1) :
    c1BallGraph (V := V) (F := F) →L[ℝ] TauCeti.HolderSpace α (closedBall (0 : V) 1) F :=
  LinearMap.mkContinuous
    { toFun := c1BallHolder hα
      map_add' := fun J K => TauCeti.HolderSpace.ext fun x => by simp
      map_smul' := fun c J => TauCeti.HolderSpace.ext fun x => by
        simp [Prod.smul_fst, BoundedContinuousFunction.smul_apply] }
    4 (norm_c1BallHolder_le hα)

variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℂ P] [FiniteDimensional ℂ P]
  [NormedSpace ℝ P] [IsScalarTower ℝ ℂ P] [CompleteSpace F]

