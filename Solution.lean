without_proof_info in
theorem setIntegral_inner_const_gradient_eq_zero (v : V) {Ω : Opens V} (φ : 𝓓(Ω, ℝ)) :
    (∫ x in (Ω : Set V), ⟪v, ∇ (φ : V → ℝ) x⟫_ℝ) = 0 := by
  have hweak : HasWeakLineDerivOn volume Ω (fun _ : V => (1 : ℝ)) (fun _ => 0) v :=
    hasWeakLineDerivOn_const 1
  have hzero := hweak.integral_lineDeriv_smul_eq_neg_integral_smul φ
  simp only [smul_eq_mul, mul_zero, integral_zero, neg_zero, mul_one] at hzero
  rw [φ.setIntegral_inner_gradient_eq_integral_inner_gradient _ φ.tsupport_subset]
  convert hzero using 1
  apply integral_congr_ae
  exact ae_of_all _ fun x => by
    change ⟪v, ∇ (φ : V → ℝ) x⟫_ℝ = lineDeriv ℝ (φ : V → ℝ) x v
    rw [(φ.contDiff.differentiable (by simp) x).lineDeriv_eq_fderiv,
      inner_gradient_right, conj_trivial]

without_proof_info in
theorem sobolevDivergenceFree_const (c : V) {Ω : Opens V}
    (hLp : MemLp (fun _ : V => c) 2 (volume.restrict (Ω : Set V))) :
    SobolevDivergenceFree Ω hLp.toLp := by
  apply sobolevDivergenceFree_of_testFunction
  intro φ
  rw [L2.inner_def, W1p.gradient_ofTestFunctionₗ]
  have hφ := gradientTestFunctionLp_apply_ae (mu := volume) 2 φ
  refine (integral_congr_ae ?_).trans (setIntegral_inner_const_gradient_eq_zero c φ)
  filter_upwards [hLp.coeFn_toLp, hφ] with x hCx hφx
  rw [hCx, hφx]

without_proof_info in
theorem SobolevDivergenceFree.add {Ω : Opens V} {C D : Lp V 2 (volume.restrict (Ω : Set V))}
    (hC : SobolevDivergenceFree Ω C) (hD : SobolevDivergenceFree Ω D) :
    SobolevDivergenceFree Ω (C + D) := by
  intro v
  rw [inner_add_left, hC v, hD v, add_zero]

without_proof_info in
theorem exists_divergenceFree_piecewise_constant (ν p m : V) (a : ℝ)
    (hmatch : ⟪ν, p⟫_ℝ = ⟪ν, m⟫_ℝ) {Ω : Opens V}
    (hfin : volume (Ω : Set V) ≠ ⊤) :
    ∃ C : Lp V 2 (volume.restrict (Ω : Set V)), SobolevDivergenceFree Ω C ∧
      C =ᵐ[volume.restrict (Ω : Set V)] fun x => if a < ⟪ν, x⟫_ℝ then p else m := by
  let : IsFiniteMeasure (volume.restrict (Ω : Set V)) := isFiniteMeasure_restrict.2 hfin
  have hs : MeasurableSet {x : V | a < ⟪ν, x⟫_ℝ} :=
    (isOpen_lt continuous_const (continuous_const.inner continuous_id)).measurableSet
  have hm : MemLp (fun _ : V => m) 2 (volume.restrict (Ω : Set V)) := memLp_const m
  have hj : MemLp ({x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => p - m) 2
      (volume.restrict (Ω : Set V)) := (memLp_const (p - m)).indicator hs.nullMeasurableSet
  refine ⟨hm.toLp + hj.toLp, (sobolevDivergenceFree_const m hm).add
    (sobolevDivergenceFree_halfspaceIndicator_tangent ν (p - m) a
      (by rw [inner_sub_right, hmatch, sub_self]) hj), ?_⟩
  filter_upwards [Lp.coeFn_add hm.toLp hj.toLp, hm.coeFn_toLp, hj.coeFn_toLp] with x hx hm' hj'
  rw [hx]
  simp only [Pi.add_apply, hm', hj']
  by_cases h : a < ⟪ν, x⟫_ℝ
  · simp only [ite_eq_left h, indicator_of_mem (show x ∈ {x : V | a < ⟪ν, x⟫_ℝ} from h)]
    abel
  · simp only [ite_eq_right h, indicator_of_notMem (show x ∉ {x : V | a < ⟪ν, x⟫_ℝ} from h), add_zero]
end ConformalPoisson

