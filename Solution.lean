    analyticWithinAt_of_boundary_normal_equation_at_point W.isOpen hzW (boundary_coordinate_zero α)
      a b qbar fbar v ha hb (fun x hx => hx.2) hfbar hv T hT
      (fun x hx => (hnormal x hx).1) (fun x hx => (hnormal x hx).2)
      (fun x hx => hfread x (hWD hx)) hLv
  have hnative := R.normalCoordinateFunction_native_analytic A u
    (chartAt (EuclideanHalfSpace (n + 1)) (α : M) α) (R.normalChart_base_mem A hcompat) hav
  rw [R.normalChart_base_value A] at hnative
  exact hnative

