noncomputable section ProofPart_GreenTrace_W2pCutoffComponentBound



/- A sufficient component-sum bound for the same cutoff used in the
native Calderon-Zygmund estimate. -/
open MeasureTheory Set TopologicalSpace Filter
open scoped ContDiff ENNReal Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
open TauCeti
variable {E : Type*} [MeasurableSpace E] [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [BorelSpace E] {μ : Measure E} [μ.IsAddHaarMeasure]
  {p : ℝ≥0∞} [Fact (1 ≤ p)] {Ω : Opens E}

without_proof_info in
theorem w2p_cutoff_components_le {ζ : E → ℝ} (hζ : ContDiff ℝ ∞ ζ)
    (hζ1 : ∀ x, |ζ x| ≤ 1) {M₁ M₂ : ℝ}
    (hM₁ : ∀ x, ‖∇ ζ x‖ ≤ M₁) (hM₂ : ∀ x, ‖fderiv ℝ (∇ ζ) x‖ ≤ M₂)
    {u w : Wkp μ Ω p 2}
    (hw : Wkp.value 2 w =ᵐ[μ.restrict Ω] fun x => ζ x * Wkp.value 2 u x) :
    ‖Wkp.value 2 w‖ + ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 w)‖ +
      ‖Wkp.iteratedGradient 1 w‖ ≤
      lpNorm (fun x => ζ x • Wkp.iteratedGradient 1 u x) p (μ.restrict Ω) +
        (1 + 2 * M₁) * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)‖ +
        (1 + M₁ + M₂) * ‖Wkp.value 2 u‖ := by
  have hM₁0 : 0 ≤ M₁ := (norm_nonneg _).trans (hM₁ 0)
  have hval : ‖Wkp.value 2 w‖ ≤ ‖Wkp.value 2 u‖ := by
    refine Lp.norm_le_norm_of_ae_le ?_
    filter_upwards [hw] with x hx
    rw [hx, norm_mul, Real.norm_eq_abs]
    exact mul_le_of_le_one_left (norm_nonneg _) (hζ1 x)
  have hw1 : Wkp.value 1 (Wkp.lowerOrder 1 w) =ᵐ[μ.restrict Ω]
      fun x => ζ x * Wkp.value 1 (Wkp.lowerOrder 1 u) x := by
    rw [← Wkp.value_succ, ← Wkp.value_succ]
    exact hw
  have hgrad : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 w)‖ ≤
      ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)‖ + M₁ * ‖Wkp.value 2 u‖ := by
    have hg := Wkp.iteratedGradient_zero_ae_eq_of_value_ae_eq_mul hζ hw1
    refine (TauCeti.Lp.norm_le_add_of_ae_norm_le (a := 1) (b := M₁)
      (g := Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) (h := Wkp.value 2 u)
      zero_le_one hM₁0 ?_).trans_eq (by ring)
    filter_upwards [hg] with x hx
    rw [hx, ← Wkp.value_succ]
    calc
      ‖ζ x • Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x +
          Wkp.value 2 u x • ∇ ζ x‖ ≤
          ‖ζ x • Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x‖ +
            ‖Wkp.value 2 u x • ∇ ζ x‖ := norm_add_le _ _
      _ ≤ 1 * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x‖ +
          M₁ * ‖Wkp.value 2 u x‖ := by
        simp only [norm_smul, Real.norm_eq_abs]
        apply add_le_add
        · exact mul_le_mul_of_nonneg_right (hζ1 x) (norm_nonneg _)
        · simpa only [mul_comm] using
            mul_le_mul_of_nonneg_left (hM₁ x) (abs_nonneg (Wkp.value 2 u x))
  obtain ⟨T, _, _, hT, hprincipal⟩ :=
    Wkp.exists_iteratedGradient_one_ae_eq_smul_add_of_value_ae_eq_mul hζ hM₁ hM₂ hw
  have hhess : ‖Wkp.iteratedGradient 1 w‖ ≤
      lpNorm (fun x => ζ x • Wkp.iteratedGradient 1 u x) p (μ.restrict Ω) +
        (2 * M₁ * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)‖ +
          M₂ * ‖Wkp.value 2 u‖) := by
    rw [hprincipal]
    calc
      ‖Wkp.iteratedGradient 1 w‖ = ‖(Wkp.iteratedGradient 1 w - T) + T‖ := by
        rw [sub_add_cancel]
      _ ≤ ‖Wkp.iteratedGradient 1 w - T‖ + ‖T‖ := norm_add_le _ _
      _ ≤ _ := add_le_add (le_refl _) hT
  exact (add_le_add (add_le_add hval hgrad) hhess).trans_eq (by ring)

end ConformalPoisson

end ProofPart_GreenTrace_W2pCutoffComponentBound

