theorem NativeInverseLpRowFamily.cutoff_weak_moment_eq_smooth_forcing
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseLpRowFamily g q s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (hNR : Nonresonant g q) (x : M) (G : M → ℝ)
    (hGk : G =ᵐ[nativeVolume g] K.row x) (D : NativePoleCutoffData (n := n) x G)
