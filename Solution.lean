  obtain ⟨Ur, Ui, Cr, Ci, Ct, h0, hCr, hCi, hCt, hh0, hA⟩ := hApprox N
  refine ⟨(fun h => scaledChartTrace χ (Ur h) (Ui h) ξ z h),
    (C : ℝ) * (Cr + Ci), Ct, h0, mul_nonneg C.coe_nonneg (add_nonneg hCr hCi), hCt, hh0, ?_⟩
  intro h hh hh0
  obtain ⟨hUr, hUi, hTr, hTi, hLr, hLi, hTrace⟩ := hA h hh hh0
  have hEr := hC χ H (fr h) (hfr h) (Ur h) hUr hTr z hz hz0
  have hEi := hC χ H (fi h) (hfi h) (Ui h) hUi hTi z hz hz0
  refine ⟨?_, hTrace⟩
  calc
    ‖scaledChartTrace χ (S.solve (fr h)) (S.solve (fi h)) ξ z h -
        scaledChartTrace χ (Ur h) (Ui h) ξ z h‖ ≤
      h * (|normalDeriv (S.solve (fr h) ∘ χ) z - normalDeriv (Ur h ∘ χ) z| +
        |normalDeriv (S.solve (fi h) ∘ χ) z - normalDeriv (Ui h ∘ χ) z|) :=
      scaled_complex_pair_error ξ z hh _ _ _ _
    _ ≤ h * ((C : ℝ) *
        (eLpNorm (schrodinger g q (Ur h)) (ENNReal.ofReal (n + 2 : ℝ)) (nativeVolume g)).toReal +
      (C : ℝ) * (eLpNorm (schrodinger g q (Ui h)) (ENNReal.ofReal (n + 2 : ℝ)) (nativeVolume g)).toReal) :=
      mul_le_mul_of_nonneg_left (add_le_add hEr hEi) hh.le
    _ ≤ h * ((C : ℝ) * (Cr * h ^ N) + (C : ℝ) * (Ci * h ^ N)) :=
      mul_le_mul_of_nonneg_left (add_le_add (mul_le_mul_of_nonneg_left hLr C.coe_nonneg)
        (mul_le_mul_of_nonneg_left hLi C.coe_nonneg)) hh.le
    _ = (C : ℝ) * (Cr + Ci) * h ^ (N + 1) := by rw [pow_succ]; ring

