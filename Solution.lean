continuous Holder representative, uniformly for all W2p inputs. -/
theorem exists_w2p_directional_morrey {r : ℝ≥0}
    [Fact (1 ≤ (r : ℝ≥0∞))] (hr : (finrank ℝ E : ℝ≥0) < r) (v : E) :
    ∃ T : Wkp μ ⊤ (r : ℝ≥0∞) 2 →L[ℝ]
