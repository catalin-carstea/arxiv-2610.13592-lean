noncomputable section ProofPart_GreenTrace_SplitChartCutoffBounds


/- Geometry, support and derivative bounds for the same actual chart cutoff
used in the native zero-trace reading and in the half-space estimate. -/
open Set Metric MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ∞ M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem splitBoundaryChartCap_inter_ball (c : M) (r : ℝ) :
    (splitBoundaryChartCap (n := n) c r : Set P) ∩
      ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) r =
    (normalHalfSpace (E := EuclideanSpace ℝ (Fin n)) 0 : Set P) ∩
      ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) r := by
  rw [splitBoundaryChartCap_eq]
  ext z
  simp only [mem_inter_iff]
  tauto

without_proof_info in
theorem split_chart_cutoff_bounds (c : M)
    (b : ContDiffBump (extChartAt Ihalf c c)) {r : ℝ} (hbr : b.rOut < r) :
    ContDiff ℝ ∞ (b ∘ euclideanNormalSplit n) ∧
      HasCompactSupport (b ∘ euclideanNormalSplit n) ∧
      tsupport (b ∘ euclideanNormalSplit n) ⊆
        ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) r ∧
      ∃ M₁ M₂ : ℝ, (∀ z, ‖∇ (b ∘ euclideanNormalSplit n) z‖ ≤ M₁) ∧
        (∀ z, ‖fderiv ℝ (∇ (b ∘ euclideanNormalSplit n)) z‖ ≤ M₂) := by
  let e := euclideanNormalSplit n
  let ζ : P → ℝ := b ∘ e
  have hs : ContDiff ℝ ∞ ζ := b.contDiff.comp e.contDiff
  have hc : HasCompactSupport ζ := b.hasCompactSupport.comp_homeomorph e.toHomeomorph
  have hsupport : tsupport ζ ⊆ ball (e.symm (extChartAt Ihalf c c)) r := by
    change tsupport ((b : V → ℝ) ∘ e.toHomeomorph) ⊆ _
    rw [tsupport_comp_eq_preimage b e.toHomeomorph, b.tsupport_eq]
    intro z hz
    have hd : dist (e z) (extChartAt Ihalf c c) = dist z (e.symm (extChartAt Ihalf c c)) := by
      rw [← e.dist_map z (e.symm (extChartAt Ihalf c c)), e.apply_symm_apply]
    exact mem_ball.mpr (hd ▸ (mem_closedBall.mp hz).trans_lt hbr)
  have hg : ContDiff ℝ ∞ (∇ ζ) := hs.gradient_right (by simp)
  obtain ⟨M₁, hM₁⟩ := hc.gradient.exists_bound_of_continuous hg.continuous
  obtain ⟨M₂, hM₂⟩ := (hc.gradient.fderiv (𝕜 := ℝ)).exists_bound_of_continuous
    (hg.continuous_fderiv (by simp))
  exact ⟨hs, hc, hsupport, M₁, M₂, hM₁, hM₂⟩

end ConformalPoisson

end ProofPart_GreenTrace_SplitChartCutoffBounds

/- Green/trace proof support: NativeBoundaryLocalLpEstimate.lean, SHA256 ba7b88f008765b698375304d4af1434154a8106c24b49bba711557613e2e104b -/
noncomputable section ProofPart_GreenTrace_NativeBoundaryLocalLpEstimate




/- A genuine local quantitative estimate for the actual native Dirichlet
solution. The geometry and coefficient constants precede every solution.
No boundary estimate, trace estimate or new analytical premise is assumed. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem exists_native_boundary_local_lp_hessian_estimate_below (hp : 1 < p) (hpfin : p ≠ ⊤)
    (g : Metric (n := n) (M := M)) (c : M) (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ R > 0, R ≤ rMax ∧ ∃ b : ContDiffBump (extChartAt Ihalf c c), b.rOut < R ∧
      (closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∃ A ≥ 0, ∃ B ≥ 0, ∃ D ≥ 0, ∀ q F u : M → ℝ, IsZeroDirichletSolution g q F u →
        ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
          (Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
            fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
          lpNorm (fun z => b (euclideanNormalSplit n z) • Wkp.iteratedGradient 1 U z) p
              (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤
            A * lpNorm (fun z => b (euclideanNormalSplit n z) * splitChartTraceForcing g c q F u z) p
                (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) +
              B * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + D * ‖Wkp.value 2 U‖ := by
  obtain ⟨C, δ, hδ, hCZ⟩ :=
    exists_lpNorm_smul_iteratedGradient_le_of_traceCLM_comp_eq_of_norm_sub_le_of_normalHalfSpace
      (E := EuclideanSpace ℝ (Fin n)) hp hpfin
  obtain ⟨lam, hlam, R, hR, hRMax, Λ, hΛ, hcoercive, htarget, hbounds⟩ :=
    exists_native_boundary_principal_localization_below g c hδ rMax hMax
  let e := euclideanNormalSplit n
  let z₀ := e.symm (extChartAt Ihalf c c)
  let b : ContDiffBump (extChartAt Ihalf c c) := ⟨R / 4, R / 2, by positivity, by linarith⟩
  have hb : b.rOut < R := by dsimp [b]; linarith
  obtain ⟨hζ, hζc, hζU, M₁, M₂, hM₁, hM₂⟩ := split_chart_cutoff_bounds c b hb
  let K := (C : ℝ) / lam * Module.finrank ℝ P * Λ + 1
  have hM₁0 : 0 ≤ M₁ := (norm_nonneg _).trans (hM₁ 0)
  have hM₂0 : 0 ≤ M₂ := (norm_nonneg _).trans (hM₂ 0)
  have hK : 0 ≤ K := by dsimp only [K]; positivity
  refine ⟨R, hR, hRMax, b, hb, htarget, C / lam, by positivity, K * (2 * M₁), by positivity,
    K * M₂, by positivity, fun q F u hu => ?_⟩
  obtain ⟨U, hU, hZ, f, hf, heq⟩ := exists_native_boundary_lp_equation (p := p)
    hpfin g q F u hu c b hb htarget
  have hA₀ : ∀ ξ : P, lam * ‖ξ‖ ^ 2 ≤ ⟪splitChartPrincipal g c z₀ ξ, ξ⟫_ℝ := by
    intro ξ
    rw [splitChartPrincipal, inner_conjugate_principal_isometry]
    have hr : e z₀ = extChartAt Ihalf c c := e.apply_symm_apply _
    change lam * ‖ξ‖ ^ 2 ≤ ⟪nativeChartPrincipal g c (e z₀) (e ξ), e ξ⟫_ℝ
    rw [hr, ← e.norm_map ξ]
    exact hcoercive (e ξ)
  have hA := (continuousOn_splitChartPrincipal_cap g c htarget).aestronglyMeasurable
    (μ := (volume : Measure P)) (splitBoundaryChartCap (n := n) c R).isOpen.measurableSet
  have hosc : ∀ᵐ z ∂volume.restrict (splitBoundaryChartCap (n := n) c R : Set P),
      z ∈ tsupport (b ∘ e) → ‖splitChartPrincipal g c z - splitChartPrincipal g c z₀‖ ≤ δ * lam := by
    filter_upwards [ae_restrict_mem (splitBoundaryChartCap (n := n) c R).isOpen.measurableSet]
      with z hz _
    rw [splitChartPrincipal, splitChartPrincipal, norm_sub_conjugate_principal_isometry]
    have hr : e z₀ = extChartAt Ihalf c c := e.apply_symm_apply _
    change ‖nativeChartPrincipal g c (e z) - nativeChartPrincipal g c (e z₀)‖ ≤ δ * lam
    rw [hr]
    exact (hbounds _ ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩).1
  have hAΛ : ∀ᵐ z ∂volume.restrict (splitBoundaryChartCap (n := n) c R : Set P),
      z ∈ tsupport (b ∘ e) → ‖splitChartPrincipal g c z‖ ≤ Λ := by
    filter_upwards [ae_restrict_mem (splitBoundaryChartCap (n := n) c R).isOpen.measurableSet]
      with z hz _
    rw [splitChartPrincipal, norm_conjugate_principal_isometry]
    exact (hbounds _ ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩).2
  let Vball : Opens P := ⟨ball z₀ R, isOpen_ball⟩
  have hdom : (splitBoundaryChartCap (n := n) c R : Set P) ∩ Vball =
      (normalHalfSpace (E := EuclideanSpace ℝ (Fin n)) 0 : Set P) ∩ Vball :=
    splitBoundaryChartCap_inter_ball c R
  have hest := hCZ 0 (A₀ := splitChartPrincipal g c z₀) hlam hA₀
    (U := Vball) hdom hζ hζc hζU hM₁ hM₂
    hA (le_refl (δ * lam)) hosc hΛ hAΛ U f hZ heq
  have hfnorm : lpNorm (fun z => b (e z) * f z) p
      (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) =
      lpNorm (fun z => b (e z) * splitChartTraceForcing g c q F u z) p
        (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) := by
    unfold lpNorm
    apply congrArg ENNReal.toReal
    apply eLpNorm_congr_ae
    filter_upwards [hf] with z hz
    rw [hz]
  change lpNorm (fun z => b (e z) • Wkp.iteratedGradient 1 U z) p _ ≤
    C / lam * lpNorm (fun z => b (e z) * f z) p _ +
      K * (2 * M₁ * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + M₂ * ‖Wkp.value 2 U‖) at hest
  rw [hfnorm] at hest
  refine ⟨U, hU, hest.trans_eq ?_⟩
  dsimp only [K]
  ring

without_proof_info in
theorem exists_native_boundary_local_lp_hessian_estimate (hp : 1 < p) (hpfin : p ≠ ⊤)
    (g : Metric (n := n) (M := M)) (c : M) :
    ∃ R > 0, ∃ b : ContDiffBump (extChartAt Ihalf c c), b.rOut < R ∧
      (closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      ∃ A ≥ 0, ∃ B ≥ 0, ∃ D ≥ 0, ∀ q F u : M → ℝ, IsZeroDirichletSolution g q F u →
        ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
          (Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
            fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
          lpNorm (fun z => b (euclideanNormalSplit n z) • Wkp.iteratedGradient 1 U z) p
              (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤
            A * lpNorm (fun z => b (euclideanNormalSplit n z) * splitChartTraceForcing g c q F u z) p
                (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) +
              B * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + D * ‖Wkp.value 2 U‖ := by
  obtain ⟨R, hR, _, hrest⟩ :=
    exists_native_boundary_local_lp_hessian_estimate_below hp hpfin g c 1 zero_lt_one
  exact ⟨R, hR, hrest⟩

end ConformalPoisson

end ProofPart_GreenTrace_NativeBoundaryLocalLpEstimate

/- Green/trace proof support: NativeBoundaryLowerOrderBounds.lean, SHA256 781f353dd826aec3608d20a4ab8112cf7d77ef5faf0beda3dfb2a6e477917945 -/
noncomputable section ProofPart_GreenTrace_NativeBoundaryLowerOrderBounds


/- Bounds for the actual first- and zeroth-order coefficients through the
physical chart boundary. These will turn the local trace forcing into the
native forcing plus the lower-order solution norms. -/
open Bundle Set Metric Riemannian.Tensor TauCeti
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

section RelativeChart
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]

without_proof_info in
theorem contDiffOn_chartDrift_relative_target (c : M) :
    ContDiffOn ℝ ∞ (chartDriftCoefficient (I := I) c) (extChartAt I c).target := by
  have hS : ContMDiffOn I 𝓘(ℝ, EuclideanSpace ℝ (Fin d) →L[ℝ]
      EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)) ∞
      (chartLeviCivitaMap (I := I) c) (extChartAt I c).source := by
    simpa only [TangentBundle.trivializationAt_baseSet, extChartAt_source] using
      contMDiffOn_chartLeviCivitaMap (I := I) (k := ∞) (m := ∞) (r := ∞) c (by simp) (by simp)
  have hChristoffel := (hS.comp (contMDiffOn_extChartAt_symm c)
    (fun z hz => (extChartAt I c).map_target hz)).contDiffOn
  unfold chartDriftCoefficient chartNegativeLaplacianDrift
  apply ContDiffOn.sum
  intro i _
  apply ContDiffOn.sum
  intro j _
  exact (contDiffOn_chartInvGram_target c i j).smul
    ((hChristoffel.clm_apply contDiffOn_const).clm_apply contDiffOn_const)
end RelativeChart

section Native
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem continuousOn_nativeChartDrift_target (g : Metric (n := n) (M := M)) (c : M) :
    ContinuousOn (nativeChartDrift g c) (extChartAt Ihalf c).target := by
  letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  letI : ContMDiffVectorBundle 1 V (TangentSpace Ihalf : M → Type _) Ihalf :=
    TangentBundle.contMDiffVectorBundle
  exact (contDiffOn_chartDrift_relative_target c).continuousOn

without_proof_info in
theorem exists_native_boundary_lower_order_bounds
    (g : Metric (n := n) (M := M)) (c : M) {q : M → ℝ} (hq : Continuous q) {r : ℝ}
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) :
    ∃ B ≥ 0, ∃ Q ≥ 0, ∀ z ∈ closedBall (extChartAt Ihalf c c) r ∩ range Ihalf,
      ‖nativeChartDrift g c z‖ ≤ B ∧ |nativeChartPotential c q z| ≤ Q := by
  have hK : IsCompact (closedBall (extChartAt Ihalf c c) r ∩ range Ihalf) :=
    (isCompact_closedBall _ _).inter_right (𝓡∂ (n + 1)).isClosed_range
  obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn
    ((continuousOn_nativeChartDrift_target g c).mono hrt)
  obtain ⟨Q, hQ⟩ := hK.exists_bound_of_continuousOn
    ((hq.comp_continuousOn (continuousOn_extChartAt_symm c)).mono hrt)
  refine ⟨max B 0, le_max_right _ _, max Q 0, le_max_right _ _, fun z hz => ?_⟩
  exact ⟨(hB z hz).trans (le_max_left _ _),
    (show |nativeChartPotential c q z| ≤ Q by exact hQ z hz).trans (le_max_left _ _)⟩

without_proof_info in
theorem splitChartTraceForcing_abs_le (g : Metric (n := n) (M := M)) (c : M)
    (q F u : M → ℝ) {B Q : ℝ}
    {z : P} (hb : ‖nativeChartDrift g c (euclideanNormalSplit n z)‖ ≤ B)
    (hq : |nativeChartPotential c q (euclideanNormalSplit n z)| ≤ Q) :
    |splitChartTraceForcing g c q F u z| ≤
      B * ‖fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (euclideanNormalSplit n z)‖ +
        Q * |u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| +
        |F ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| := by
  have hfirst := ((fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (euclideanNormalSplit n z)).le_opNorm
    (nativeChartDrift g c (euclideanNormalSplit n z))).trans
      (mul_le_mul_of_nonneg_left hb (norm_nonneg _))
  have hpotential := mul_le_mul_of_nonneg_right hq
    (abs_nonneg (u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))))
  have hfirst' : |fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (euclideanNormalSplit n z)
      (nativeChartDrift g c (euclideanNormalSplit n z))| ≤
      B * ‖fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (euclideanNormalSplit n z)‖ := by
    simpa only [Real.norm_eq_abs, mul_comm] using hfirst
  let a := fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (euclideanNormalSplit n z)
    (nativeChartDrift g c (euclideanNormalSplit n z))
  let v := nativeChartPotential c q (euclideanNormalSplit n z) *
    u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))
  let f := F ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))
  have htri : |a + v - f| ≤ |a| + |v| + |f| :=
    (abs_sub (a + v) f).trans (add_le_add (abs_add_le a v) (le_refl |f|))
  have hv : |v| ≤ Q * |u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| := by
    simpa only [v, abs_mul] using hpotential
  exact htri.trans (add_le_add (add_le_add hfirst' hv) (le_refl |f|))

end Native
end ConformalPoisson

end ProofPart_GreenTrace_NativeBoundaryLowerOrderBounds

/- Green/trace proof support: LpThreeTermBound.lean, SHA256 fcbc837b99bb435091b6ec531d55376abd7781b7b22fc06c3f2525828e74e2b9 -/
noncomputable section ProofPart_GreenTrace_LpThreeTermBound


/- The three lower-order terms used by the native local estimate, with
almost-everywhere bounds on the actual restricted coordinate measure. -/
open MeasureTheory
open scoped ENNReal NNReal
namespace ConformalPoisson
variable {α E₁ E₂ E₃ : Type*} [MeasurableSpace α]
  [NormedAddCommGroup E₁] [NormedAddCommGroup E₂] [NormedAddCommGroup E₃]
  {μ : Measure α} {p : ℝ≥0∞}

without_proof_info in
theorem lpNorm_le_three_terms_of_ae_norm_le
    (hp : 1 ≤ p) {f : α → ℝ} (hf : AEStronglyMeasurable f μ)
    {g₁ : α → E₁} {g₂ : α → E₂} {g₃ : α → E₃}
    (hg₁ : MemLp g₁ p μ) (hg₂ : MemLp g₂ p μ) (hg₃ : MemLp g₃ p μ)
    {B Q : ℝ} (hB : 0 ≤ B) (hQ : 0 ≤ Q)
    (hle : ∀ᵐ x ∂μ, ‖f x‖ ≤ B * ‖g₁ x‖ + Q * ‖g₂ x‖ + ‖g₃ x‖) :
    lpNorm f p μ ≤ B * lpNorm g₁ p μ + Q * lpNorm g₂ p μ + lpNorm g₃ p μ := by
  let h₁ : α → ℝ := fun x => B * ‖g₁ x‖
  let h₂ : α → ℝ := fun x => Q * ‖g₂ x‖
  let h₃ : α → ℝ := fun x => ‖g₃ x‖
  let h : α → ℝ := h₁ + h₂ + h₃
  have hm₁ : MemLp h₁ p μ := hg₁.norm.const_mul B
  have hm₂ : MemLp h₂ p μ := hg₂.norm.const_mul Q
  have hm₃ : MemLp h₃ p μ := hg₃.norm
  have hm : MemLp h p μ := (hm₁.add hm₂).add hm₃
  have hnonneg : ∀ x, 0 ≤ h x := by intro x; dsimp [h, h₁, h₂, h₃]; positivity
  have hmono : ∀ᵐ x ∂μ, ‖f x‖ ≤ (1 : ℝ) * ‖h x‖ := by
    filter_upwards [hle] with x hx
    simp only [one_mul, Real.norm_eq_abs]
    rw [abs_of_nonneg (hnonneg x)]
    exact hx
  have hfh : lpNorm f p μ ≤ lpNorm h p μ := by
    simpa only [one_mul] using lpNorm_le_mul_lpNorm_of_ae_le_mul hf hm hmono
  have htri : lpNorm h p μ ≤ lpNorm h₁ p μ + lpNorm h₂ p μ + lpNorm h₃ p μ :=
    (lpNorm_add_le (hm₁.add hm₂) hp).trans
      (add_le_add (lpNorm_add_le hm₁ hp) (le_refl _))
