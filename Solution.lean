    have hzX : X (y : M) = 0 := image_eq_zero_of_notMem_tsupport (α := V) (fun h => hyM (hKs h))
    simp only [f, hzX, map_zero, zero_apply]
  have hSurf : (∫ y, f y ∂nativeSurfaceMeasure g) =
      ∫ w in cB.target, nativeStandardBoundaryChartDensity g α (cB.symm w) * f (cB.symm w) := by
    rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero]
    have hsub : cB.source ⊆ (chartAt B α).source := by simp only [cB, extChartAt_source, subset_refl]
    have h := setIntegral_nativeVolume_eq_standard (I := 𝓡 n) α
      (isOpen_extChartAt_source α).measurableSet hsub f
    rw [cB.image_source_eq_target] at h
    exact h
  have hTerm (w : B) (hw : w ∈ cB.target) :
      nativeStandardBoundaryChartDensity g α (cB.symm w) * f (cB.symm w) = -b w := by
    have hyB := cB.map_target hw
    have hy : cB.symm w ∈ (chartAt B α).source := by simpa only [cB, extChartAt_source] using hyB
    have hyM : ((cB.symm w : (Ihalf).boundary M) : M) ∈ c.source := by
      simpa only [c, cB, extChartAt_source, boundaryChartedSpace_chartAt_source, mem_preimage] using hyB
    have hparam : euclideanHalfSpaceBoundaryParam n w ∈ c.target :=
      (boundaryParam_mem_extChartAt_target_iff α w).mpr hw
    have hround : c.symm (euclideanHalfSpaceBoundaryParam n w) = ((cB.symm w : (Ihalf).boundary M) : M) := by
      have hcoord : euclideanHalfSpaceBoundaryParam n w = c ((cB.symm w : (Ihalf).boundary M) : M) := by
        calc
          _ = euclideanHalfSpaceBoundaryParam n (cB (cB.symm w)) :=
            congrArg (euclideanHalfSpaceBoundaryParam n) (cB.right_inv hw).symm
          _ = _ := boundaryParam_extChartAt hyB
      rw [hcoord]
      exact c.left_inv hyM
    have h := native_boundary_standard_flux_density g α (cB.symm w) hy (ν (cB.symm w))
      (X (cB.symm w)) (hν (cB.symm w))
    change _ = -supportedNativeCoordinateFlux g (α : M) X (euclideanHalfSpaceBoundaryParam n w) 0
    rw [supportedNativeCoordinateFlux, indicator_of_mem hparam, nativeCoordinateFlux, hround]
    simpa only [f, PiLp.smul_apply, smul_eq_mul, neg_mul] using h
  have hbzero : ∀ w, w ∉ cB.target → b w = 0 := by
    intro w hw
    have hnot : euclideanHalfSpaceBoundaryParam n w ∉ c.target :=
      (boundaryParam_mem_extChartAt_target_iff α w).not.mpr hw
    change ((c.target.indicator (nativeCoordinateFlux g (α : M) X)) _) 0 = 0
    rw [indicator_of_notMem hnot]
    rfl
  refine ⟨hi, hSurf.trans ?_⟩
  calc
    _ = ∫ w in cB.target, -b w :=
      setIntegral_congr_fun (isOpen_extChartAt_target α).measurableSet hTerm
    _ = ∫ w, -b w := setIntegral_eq_integral_of_forall_compl_eq_zero (fun w hw => by rw [hbzero w hw, neg_zero])
    _ = _ := integral_neg _

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integral_native_divergence_boundary_chart (g : Metric (n := n) (M := M))
    (α : (𝓡∂ (n + 1)).boundary M)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (X : (x : M) → TangentSpace Ihalf x)
    (hX : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M)))
    (hKs : tsupport (α := V) X ⊆ (extChartAt Ihalf (α : M)).source) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
      IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
    (∫ x, divergence Ihalf X x ∂nativeVolume g) =
      ∫ y, g.inner y (ν y) (X y) ∂nativeSurfaceMeasure g := by
  obtain ⟨_, hvol⟩ := integral_native_divergence_chart g (α : M) X hX
    (HasCompactSupport.of_compactSpace X) hKs
  exact hvol.trans (integral_native_boundary_flux_chart g α ν hν X hX hKs).2.symm
end ConformalPoisson

end ProofPart_GreenTrace_NativeBoundaryChartFluxIntegral

/- Green/trace proof support: NativeSurfaceDivergence.lean, SHA256 bf9bafcae3de2350a2fa022c5b665fab397cbe0acac639b01d153f9979fc1a3e -/
noncomputable section ProofPart_GreenTrace_NativeSurfaceDivergence





/- The unsigned native divergence theorem on the original compact manifold
WITH boundary. A finite smooth partition uses boundary charts at boundary
centres and interior-supported charts at interior centres. -/
open Bundle Module MeasureTheory Set Filter TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local instance surfaceDiv_compact : CompactSpace ((𝓡∂ (n + 1)).boundary M) := compactSpace_nativeBoundary

set_option maxHeartbeats 1500000 in
without_proof_info in
theorem integral_native_divergence (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (X : (x : M) → TangentSpace Ihalf x)
    (hX : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M))) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
      IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
    (∫ x, divergence Ihalf X x ∂nativeVolume g) =
      ∫ y, g.inner y (ν y) (X y) ∂nativeSurfaceMeasure g := by
  classical
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  let : ContMDiffVectorBundle 1 V (TangentSpace Ihalf : M → Type _) Ihalf := TangentBundle.contMDiffVectorBundle
  let : IsLocallyFiniteMeasure (nativeSurfaceMeasure g) := nativeSurfaceMeasure_isLocallyFiniteMeasure g
  let : IsFiniteMeasure (nativeSurfaceMeasure g) := inferInstance
  let U : M → Set M := fun x => if (Ihalf).IsInteriorPoint x then
    (extChartAt Ihalf x).source ∩ (Ihalf).interior M else (extChartAt Ihalf x).source
  have hU (x : M) (_ : x ∈ (univ : Set M)) : U x ∈ 𝓝 x := by
    dsimp only [U]
    split_ifs with hx
    · exact inter_mem ((isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x))
        (((Ihalf).isOpen_interior (n := ω) (by decide)).mem_nhds hx)
    · exact (isOpen_extChartAt_source x).mem_nhds (mem_extChartAt_source x)
  obtain ⟨ι, hι, f, hf⟩ := isCompact_univ.exists_smoothBumpCovering_isSubordinate Ihalf hU
  let ρ := f.toSmoothPartitionOfUnity
  have hρ := hf.toSmoothPartitionOfUnity
  let Y : ι → (x : M) → TangentSpace Ihalf x := fun i x => ρ i x • X x
  have hY (i : ι) : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (Y i x) : TangentBundle Ihalf M)) :=
    ((ρ i).contMDiff.of_le (by simp)).smul_section hX
  have hYS (i : ι) : tsupport (α := V) (Y i) ⊆ U (f.c i) :=
    (tsupport_smul_subset_left _ _).trans (hρ i)
  have hYs (i : ι) : tsupport (α := V) (Y i) ⊆ (extChartAt Ihalf (f.c i)).source := by
    intro x hx
    have hu := hYS i hx
    dsimp only [U] at hu
    split_ifs at hu with hi
    · exact hu.1
    · exact hu
  have hsum (x : M) : X x = ∑ i : ι, Y i x := by
    dsimp only [Y]
    rw [← Finset.sum_smul, ρ.sum_finsupport' x (mem_univ x) (Finset.subset_univ _), one_smul]
  have hLocal (i : ι) : (∫ x, divergence Ihalf (Y i) x ∂nativeVolume g) =
      ∫ y, g.inner y (ν y) (Y i y) ∂nativeSurfaceMeasure g := by
    by_cases hi : (Ihalf).IsInteriorPoint (f.c i)
    · have hYi : tsupport (α := V) (Y i) ⊆ (Ihalf).interior M := by
        intro x hx
        have hu := hYS i hx
        simp only [U, if_pos hi] at hu
        exact hu.2
      have hcoord : extChartAt Ihalf (f.c i) '' tsupport (α := V) (Y i) ⊆
          interior (extChartAt Ihalf (f.c i)).target := by
        rintro z ⟨x, hx, rfl⟩
        exact ((Ihalf).isInteriorPoint_iff_of_mem_atlas (n := ω) (by decide)
          (chart_mem_atlas (EuclideanHalfSpace (n + 1)) (f.c i))
          (by simpa only [extChartAt_source] using hYs i hx)).mp (hYi hx)
      have hzero := integral_divergence_eq_zero_of_interior_chart (α := f.c i) (hY i)
        (HasCompactSupport.of_compactSpace (Y i))
        (by simpa only [extChartAt_source] using hYs i) hcoord
      have hFluxZero : (fun y : (Ihalf).boundary M => g.inner y (ν y) (Y i y)) = 0 := by
        funext y
        have hz : Y i y = 0 := image_eq_zero_of_notMem_tsupport (α := V) (fun h =>
          ((Ihalf).isInteriorPoint_iff_not_isBoundaryPoint (y : M)).mp (hYi h) y.property)
        simp only [hz, map_zero, Pi.zero_apply]
      rw [hFluxZero]
      change (∫ x, divergence Ihalf (Y i) x ∂nativeVolume g) =
        ∫ _ : (Ihalf).boundary M, (0 : ℝ) ∂nativeSurfaceMeasure g
      rw [integral_zero]
      exact hzero
    · have hib : f.c i ∈ (Ihalf).boundary M := by rwa [← (Ihalf).compl_interior]
      exact integral_native_divergence_boundary_chart g ⟨f.c i, hib⟩ ν hν (Y i) (hY i) (hYs i)
  have hDiv (x : M) : divergence Ihalf X x = ∑ i : ι, divergence Ihalf (Y i) x := by
    rw [← divergence_finsetSum Ihalf Finset.univ Y x (fun i _ => (hY i x).mdifferentiableAt one_ne_zero)]
    exact congrArg (divergence Ihalf · x) (funext hsum)
  have hFlux (y : (Ihalf).boundary M) : g.inner y (ν y) (X y) = ∑ i : ι, g.inner y (ν y) (Y i y) := by
    rw [hsum (y : M), map_sum]
  have hIntDiv (i : ι) : Integrable (divergence Ihalf (Y i)) (nativeVolume g) :=
    integrable_divergence (hY i) (HasCompactSupport.of_compactSpace (Y i))
  have hIntFlux (i : ι) : Integrable (fun y : (Ihalf).boundary M => g.inner y (ν y) (Y i y))
      (nativeSurfaceMeasure g) :=
    (continuous_native_unitNormal_inner g ν hν (Y i) (hY i).continuous).integrable_of_compactSpace
  calc
    _ = ∫ x, ∑ i : ι, divergence Ihalf (Y i) x ∂nativeVolume g :=
      integral_congr_ae (Filter.Eventually.of_forall hDiv)
    _ = ∑ i : ι, ∫ x, divergence Ihalf (Y i) x ∂nativeVolume g :=
      integral_finsetSum _ (fun i _ => hIntDiv i)
    _ = ∑ i : ι, ∫ y, g.inner y (ν y) (Y i y) ∂nativeSurfaceMeasure g :=
      Finset.sum_congr rfl (fun i _ => hLocal i)
    _ = ∫ y, ∑ i : ι, g.inner y (ν y) (Y i y) ∂nativeSurfaceMeasure g :=
      (integral_finsetSum _ (fun i _ => hIntFlux i)).symm
    _ = _ := integral_congr_ae (Filter.Eventually.of_forall (fun y => (hFlux y).symm))
end ConformalPoisson

end ProofPart_GreenTrace_NativeSurfaceDivergence

/- Green/trace proof support: NativeSurfaceGreen.lean, SHA256 0f358921b2a3d787758f1b0eda35eeafbc3bd421ef77142fe87f8ec2fa8130b1 -/
noncomputable section ProofPart_GreenTrace_NativeSurfaceGreen



/- Native Green's second identity with the actual induced surface measure
and supplied outward unit normal. Signed potentials cancel exactly. -/
open Bundle Module MeasureTheory Set Filter TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local instance nativeGreen_compact : CompactSpace ((𝓡∂ (n + 1)).boundary M) := compactSpace_nativeBoundary

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem native_green_second_identity (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (u v : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) (hv : ContMDiff Ihalf 𝓘(ℝ) ∞ v) :
    (∫ x, u x * schrodinger g q v x - v x * schrodinger g q u x ∂nativeVolume g) =
      ∫ y, v y * normalDerivative ν u y - u y * normalDerivative ν v y ∂nativeSurfaceMeasure g := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace Ihalf : M → Type _) Ihalf := TangentBundle.contMDiffVectorBundle
  have hGu : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (mgradient Ihalf u x) : TangentBundle Ihalf M)) :=
    contMDiff_mgradient (n := 1) (hu.of_le (by norm_num))
  have hGv : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (mgradient Ihalf v x) : TangentBundle Ihalf M)) :=
    contMDiff_mgradient (n := 1) (hv.of_le (by norm_num))
  let Y : (x : M) → TangentSpace Ihalf x := fun x => v x • mgradient Ihalf u x
  let Z : (x : M) → TangentSpace Ihalf x := fun x => u x • mgradient Ihalf v x
  let X : (x : M) → TangentSpace Ihalf x := Y + (-1 : ℝ) • Z
  have hY : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (Y x) : TangentBundle Ihalf M)) :=
    (hv.of_le (by simp)).smul_section hGu
  have hZ : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (Z x) : TangentBundle Ihalf M)) :=
    (hu.of_le (by simp)).smul_section hGv
  have hNegZ := (contMDiff_const : ContMDiff Ihalf 𝓘(ℝ) 1 (fun _ : M => (-1 : ℝ))).smul_section hZ
  have hX : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M)) := hY.add_section hNegZ
  have hpt (x : M) : divergence Ihalf X x = u x * schrodinger g q v x - v x * schrodinger g q u x := by
    rw [divergence_add Ihalf Y ((-1 : ℝ) • Z) x
      ((hY x).mdifferentiableAt one_ne_zero) ((hNegZ x).mdifferentiableAt one_ne_zero),
      divergence_smul Ihalf (-1) Z x ((hZ x).mdifferentiableAt one_ne_zero)]
    have hYE : Y = v • mgradient Ihalf u := rfl
    have hZE : Z = u • mgradient Ihalf v := rfl
    rw [hYE, hZE]
    rw [divergence_smul_function Ihalf v (mgradient Ihalf u) x
      ((hv x).mdifferentiableAt (by simp)) ((hGu x).mdifferentiableAt one_ne_zero),
      divergence_smul_function Ihalf u (mgradient Ihalf v) x
      ((hu x).mdifferentiableAt (by simp)) ((hGv x).mdifferentiableAt one_ne_zero),
      ← laplaceBeltrami_def, ← laplaceBeltrami_def]
    have hc : mvfderiv Ihalf v x (mgradient Ihalf u x) = mvfderiv Ihalf u x (mgradient Ihalf v x) := by
      rw [← inner_mgradient, ← inner_mgradient, real_inner_comm]
    rw [hc]
    dsimp only [schrodinger]
    ring
  have hnu (f : M → ℝ) (y : (Ihalf).boundary M) :
      g.inner y (ν y) (mgradient Ihalf f y) = normalDerivative ν f y := by
    change inner ℝ (ν y) (mgradient Ihalf f y) = mvfderiv Ihalf f y (ν y)
    rw [real_inner_comm, inner_mgradient]
  have hflux (y : (Ihalf).boundary M) : g.inner y (ν y) (X y) =
      v y * normalDerivative ν u y - u y * normalDerivative ν v y := by
    simp only [X, Y, Z, Pi.add_apply, Pi.smul_apply, map_add, map_smul, smul_eq_mul, hnu]
    ring
  calc
    _ = ∫ x, divergence Ihalf X x ∂nativeVolume g :=
      integral_congr_ae (Filter.Eventually.of_forall (fun x => (hpt x).symm))
    _ = ∫ y, g.inner y (ν y) (X y) ∂nativeSurfaceMeasure g := integral_native_divergence g ν hν X hX
    _ = _ := integral_congr_ae (Filter.Eventually.of_forall hflux)

without_proof_info in
/-- The sole surface Green consequence needed when the first factor has
zero boundary trace. -/
theorem native_green_second_zero_boundary (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (u v : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) (hv : ContMDiff Ihalf 𝓘(ℝ) ∞ v)
    (hu0 : ∀ y : (Ihalf).boundary M, u y = 0) :
    (∫ x, u x * schrodinger g q v x - v x * schrodinger g q u x ∂nativeVolume g) =
      ∫ y, v y * normalDerivative ν u y ∂nativeSurfaceMeasure g := by
  rw [native_green_second_identity g q ν hν u v hu hv]
  apply integral_congr_ae
  filter_upwards with y
  rw [hu0 y, zero_mul, sub_zero]
end ConformalPoisson

end ProofPart_GreenTrace_NativeSurfaceGreen

/- Green/trace proof support: NativeGreenPoleRemoval.lean, SHA256 909e95ff1f8520f09ea220c12c8bbfb037d04307a6bc9986de01d0b2ed673250 -/
noncomputable section ProofPart_GreenTrace_NativeGreenPoleRemoval





/- Smooth boundary extensions avoiding one interior point, and smooth
removal of the SAME Green row's pole inside that zero neighborhood. -/
open Bundle Set Filter MeasureTheory TauCeti
open scoped Manifold ContDiff Topology ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

set_option maxHeartbeats 500000 in
without_proof_info in
theorem exists_native_boundary_extension_away_point
    {g : Metric (n := n) (M := M)} {q : M → ℝ} (S : DirichletSolver g q)
    (f : (𝓡∂ (n + 1)).boundary M → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f)
    (x : M) (hx : x ∈ (Ihalf).interior M) :
    ∃ O : TopologicalSpace.Opens M, x ∈ O ∧ (O : Set M) ⊆ (Ihalf).interior M ∧
      ∃ E : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ E ∧ EqOn E 0 O ∧
        ∀ y : (Ihalf).boundary M, E y = f y := by
  have hI : IsOpen ((Ihalf).interior M) := (Ihalf).isOpen_interior (n := ω) (by decide)
  obtain ⟨χ, hχ, hχone, _, hχI, _⟩ := isCompact_singleton.exists_contMDiff_one_nhds_tsupport_subset
    Ihalf hI (singleton_subset_iff.mpr hx)
  let O : TopologicalSpace.Opens M := ⟨interior {z : M | χ z = 1}, isOpen_interior⟩
  have hxO : x ∈ O := by
    apply mem_interior_iff_mem_nhds.mpr
    change ∀ᶠ z in 𝓝 x, χ z = 1
    simpa only [nhdsSet_singleton] using hχone
  have hOne : ∀ z ∈ O, χ z = 1 := fun z hz => interior_subset hz
  have hOI : (O : Set M) ⊆ (Ihalf).interior M := by
    intro z hz
    apply hχI
    apply subset_tsupport χ
    change χ z ≠ 0
    rw [hOne z hz]
    norm_num
  let E : M → ℝ := fun z => (1 - χ z) * S.solve f z
  refine ⟨O, hxO, hOI, E, (contMDiff_const.sub hχ).mul (S.correct f hf).1, ?_, ?_⟩
  · intro z hz
    simp only [E, hOne z hz, sub_self, zero_mul, Pi.zero_apply]
  · intro y
    have hyI : (y : M) ∉ (Ihalf).interior M := by
      change (y : M) ∈ ((Ihalf).interior M)ᶜ
      rw [(Ihalf).compl_interior]
      exact y.property
    have hχy : χ y = 0 := image_eq_zero_of_notMem_tsupport (fun h => hyI (hχI h))
    simp only [E, hχy, sub_zero, one_mul, (S.correct f hf).2.2 y]

set_option maxHeartbeats 700000 in
without_proof_info in
theorem NativeClassicalValueKernel.exists_smooth_pole_removal_in
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    {K : NativeInverseLpRowFamily g q s} (G : NativeClassicalValueKernel K)
    (x : M) (W : TopologicalSpace.Opens M) (hxW : x ∈ W) :
    ∃ θ : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ θ ∧ tsupport θ ⊆ (W : Set M) ∧
      ∃ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ u ∧
        (∀ y : (Ihalf).boundary M, u y = 0) ∧
        ∀ z ∉ tsupport θ, u =ᶠ[𝓝 z] G.kernel x := by
  obtain ⟨θ, hθ, hθone, _, hθW, _⟩ := isCompact_singleton.exists_contMDiff_one_nhds_tsupport_subset
    Ihalf W.isOpen (singleton_subset_iff.mpr hxW)
  have hOne : ∀ᶠ z in 𝓝 x, θ z = 1 := by simpa only [nhdsSet_singleton] using hθone
  let u : M → ℝ := fun z => (1 - θ z) * G.kernel x z
