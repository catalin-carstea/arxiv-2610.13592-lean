        exists_native_boundary_principal_localization_below g c (by norm_num : (0 : ℝ) < 1) rMax hMax
      refine ⟨R₀, hR₀, hRMax, htarget, fun R hR hRR₀ => ⟨1, by norm_num, ?_⟩⟩
      intro u hu hu0 hLu
      simp
  | succ N ih =>
      letI : Fact (1 ≤ (s N : ℝ≥0∞)) := ⟨(hs N (Nat.le_succ N)).le⟩
      obtain ⟨R₁, hR₁, hR₁Max, _, hstep⟩ :=
        exists_native_halfBall_value_exponent_gain_below (s N) (s (N + 1))
          (hs N (Nat.le_succ N)) (hmono N (Nat.lt_succ_self N)) (hgap N (Nat.lt_succ_self N))
