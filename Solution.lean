/-- A fixed component of the first weak gradient lifts boundedly to W1p. -/
theorem exists_w2p_directional_gradient_lift (v : E) :
    ∃ T : Wkp μ ⊤ p 2 →L[ℝ] W1p μ ⊤ p, ∀ u,
      W1p.value (T u) =ᵐ[μ] fun x =>
        ⟪v, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ := by
  let A : Wkp μ ⊤ p 2 →L[ℝ] Lp ℝ p (μ.restrict (⊤ : Opens E)) :=
    ((innerSL ℝ v).compLpL p _).comp
      ((Wkp.iteratedGradientL 0).comp (Wkp.lowerOrderL 1))
  let B : Wkp μ ⊤ p 1 →L[ℝ] Lp ℝ p (μ.restrict (⊤ : Opens E)) := Wkp.valueL 1
  have hA (u : Wkp μ ⊤ p 2) : A u =ᵐ[μ] fun x =>
      ⟪v, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ := by
    dsimp only [A]
    simp only [ContinuousLinearMap.comp_apply]
    rw [Wkp.lowerOrderL_apply, Wkp.iteratedGradientL_apply]
    have h := (innerSL ℝ v).coeFn_compLpL
      (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u))
    have hae : ae (μ.restrict (⊤ : Opens E)) = ae μ := by simp
    rw [hae] at h
    filter_upwards [h] with x hx
    rw [hx, innerSL_apply_apply]
  have hex : ∀ u : Wkp μ ⊤ p 2, ∃ d : Wkp μ ⊤ p 1, B d = A u := by
    intro u
    obtain ⟨d, hd⟩ := Wkp.exists_hasWeakLineDerivOn_value 1 u v
    have hg := (Wkp.hasWeakFDerivOn_value (Wkp.lowerOrder 1 u)).hasWeakLineDerivOn v
    rw [← Wkp.value_succ] at hg
    have he := hd.ae_eq hg
    have hae : ae (μ.restrict (⊤ : Opens E)) = ae μ := by simp
    rw [hae] at he
    have he' : Wkp.value 1 d =ᵐ[μ] fun x =>
        ⟪v, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ := by
      filter_upwards [he] with x hx
      simpa only [innerSL_apply_apply, real_inner_comm] using hx
    refine ⟨d, Lp.ext ?_⟩
    dsimp only [B]
    rw [Wkp.valueL_apply]
    have h := he'.trans (hA u).symm
    rw [← hae] at h
    exact h
  have hB : Function.Injective B := by
    intro u v h
    dsimp only [B] at h
    rw [Wkp.valueL_apply, Wkp.valueL_apply] at h
    exact Wkp.ext 1 h
  obtain ⟨T, hT⟩ := exists_continuous_lift_of_injective_value A B hB hex
  refine ⟨(Wkp.firstOrderL 0).comp T, fun u => ?_⟩
  simp only [ContinuousLinearMap.comp_apply]
  rw [Wkp.firstOrderL_apply, Wkp.value_firstOrder]
  have ht := hT u
  dsimp only [B] at ht
  rw [Wkp.valueL_apply] at ht
  rw [ht]
  exact hA u

