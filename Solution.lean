set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_halfBall_gradient_interpolation (hp : p ≠ (⊤ : ℝ≥0∞)) :
    ∃ c ≥ 0, ∀ (a : ℝ) (Ω : Opens P) (x₀ : P) (R : ℝ),
