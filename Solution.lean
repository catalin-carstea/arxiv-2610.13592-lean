@[simp] theorem coe_linearRangeClosureMap (e : E →ₗ[ℝ] H) (x : E) :
    ((linearRangeClosureMap e x : (LinearMap.range e).topologicalClosure) : H) = e x := rfl

without_proof_info in
theorem denseRange_linearRangeClosureMap (e : E →ₗ[ℝ] H) :
    DenseRange (linearRangeClosureMap e) := by
  have hd : DenseRange (Set.inclusion (subset_closure : (Set.range e) ⊆ closure (Set.range e))) :=
    (denseRange_inclusion_iff subset_closure).2 subset_rfl
  have hs : Function.Surjective (Set.rangeFactorization e) := Set.rangeFactorization_surjective
  exact hd.comp hs.denseRange (continuous_inclusion subset_closure)

