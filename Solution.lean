/- A global smooth zero-boundary representative of the actual native
weak Dirichlet value. The classical equation is a separate obligation. -/
open Bundle Set Metric MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*}
  [TopologicalSpace M] [T2Space M] [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [CompactSpace M] [IsManifold (𝓡∂ (n + 1)) 2 M] [IsManifold (𝓡∂ (n + 1)) ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x)]
  [IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : M => TangentSpace (𝓡∂ (n + 1)) x)]
  [IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) ∞ (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : M => TangentSpace (𝓡∂ (n + 1)) x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin (n + 1)))
    (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1))]
  [MeasurableSpace M] [BorelSpace M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Ihalf" => 𝓡∂ (n + 1)
local instance weakSmoothValueMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := Ihalf) (n := 1)
open DirichletSobolev

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_native_weak_smooth_zero_value {q F : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hF : ContMDiff Ihalf 𝓘(ℝ) ∞ F)
    (u : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x})
    (hu : ∀ v : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x},
      schrodingerForm (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x}
          (ContinuousMap.toLp ⊤ (riemannianVolume Ihalf M) ℝ ⟨q, hq.continuous⟩) u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ ⟨F, hF.continuous⟩,
          valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} v⟫_ℝ) :
    ∃ w : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ w ∧
      (∀ x : M, (Ihalf).IsBoundaryPoint x → w x = 0) ∧
      (valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u : M → ℝ)
        =ᵐ[riemannianVolume Ihalf M] w := by
  let : SecondCountableTopology (EuclideanHalfSpace (n + 1)) := (𝓡∂ (n + 1)).secondCountableTopology
  let : SecondCountableTopology M :=
    ChartedSpace.secondCountable_of_sigmaCompact (EuclideanHalfSpace (n + 1)) M
  obtain ⟨w, hw, hzero, hval⟩ := exists_contMDiff_zero_ae_eq_of_locally
    (I := Ihalf) (μ := riemannianVolume Ihalf M)
    (B := {x : M | (Ihalf).IsBoundaryPoint x})
    (u := valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} u) (by
      intro c
      obtain ⟨L⟩ := nonempty_boundaryChartLocalization (I := Ihalf) c
      exact L.exists_native_local_smooth_zero_representative hq hF u hu)
  exact ⟨w, hw, hzero, hval.symm⟩
end ConformalPoisson

