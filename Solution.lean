/- Component bounds from the pinned ACTUAL reflected-Hessian formula.
These bounds supply scale control for local boundary interpolation. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti
open scoped ENNReal InnerProductSpace
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "P" => WithLp 2 (ℝ × E)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem norm_lp_reflected_difference_le
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (a : ℝ) (S : F → F) (hS : ∀ v, ‖S v‖ ≤ ‖v‖)
    (u : Lp F p ((volume : Measure P).restrict (normalHalfSpace (E := E) a : Set P)))
    (w : Lp F p ((volume : Measure P).restrict (univ : Set P)))
    (hw : w =ᵐ[volume] fun x =>
      (normalHalfSpace (E := E) a : Set P).indicator u x -
      S ((normalHalfSpace (E := E) a : Set P).indicator u (normalReflection E a x))) :
    ‖w‖ ≤ 2 * ‖u‖ := by
  let H := normalHalfSpace (E := E) a
  let Z := Lp F p ((volume : Measure P).restrict (univ : Set P))
  have hH : MeasurableSet (H : Set P) := H.isOpen.measurableSet
  have hρ : MeasurePreserving (normalReflection E a)
      ((volume : Measure P).restrict univ) (volume.restrict univ) := by
    simpa using (measurePreserving_normalReflection (E := E) a).restrict_preimage MeasurableSet.univ
  let A : Z := extendByZeroLpₗᵢ ℝ volume hH (Set.subset_univ _) u
  let B : Z := Lp.compMeasurePreservingₗᵢ ℝ (normalReflection E a) hρ A
  have hA : A =ᵐ[volume] (H : Set P).indicator u := by
    simpa only [A, Measure.restrict_univ] using
      coeFn_extendByZeroLpₗᵢ ℝ hH (Set.subset_univ _) u
  have hB : B =ᵐ[volume] (fun x => (H : Set P).indicator u (normalReflection E a x)) := by
    have hb : B =ᵐ[volume] (fun x => A (normalReflection E a x)) := by
      dsimp only [B]
      rw [Lp.compMeasurePreservingₗᵢ_apply]
      simpa only [Measure.restrict_univ, Function.comp_def] using Lp.coeFn_compMeasurePreserving A hρ
    exact hb.trans ((measurePreserving_normalReflection (E := E) a).quasiMeasurePreserving.ae_eq_comp hA)
  have hAn : ‖A‖ = ‖u‖ := (extendByZeroLpₗᵢ ℝ volume hH (Set.subset_univ _)).norm_map u
  have hBn : ‖B‖ = ‖A‖ := (Lp.compMeasurePreservingₗᵢ ℝ (normalReflection E a) hρ).norm_map A
  have hn : ‖w‖ ≤ 1 * ‖A‖ + 1 * ‖B‖ := by
    apply TauCeti.Lp.norm_le_add_of_ae_norm_le zero_le_one zero_le_one
    have he : ∀ᵐ x ∂(volume : Measure P), ‖w x‖ ≤ 1 * ‖A x‖ + 1 * ‖B x‖ := by
      filter_upwards [hw, hA, hB] with x hx ha hb
      rw [hx, ← ha, ← hb, one_mul, one_mul]
      have hs := hS (B x)
      exact (norm_sub_le _ _).trans (by linarith)
    simpa only [Measure.restrict_univ] using he
  rw [one_mul, one_mul, hBn, hAn] at hn
  linarith

without_proof_info in
theorem norm_normalReflection_conjugate_le (D : P →L[ℝ] P) :
    ‖(normalLinearReflection E : P →L[ℝ] P) ∘L D ∘L
      (normalLinearReflection E : P →L[ℝ] P)‖ ≤ ‖D‖ := by
  apply ContinuousLinearMap.opNorm_le_bound
    ((normalLinearReflection E : P →L[ℝ] P) ∘L D ∘L
      (normalLinearReflection E : P →L[ℝ] P)) (norm_nonneg D)
  intro x
  change ‖normalLinearReflection E (D (normalLinearReflection E x))‖ ≤ ‖D‖ * ‖x‖
  rw [(normalLinearReflection E).norm_map]
  simpa only [LinearIsometryEquiv.norm_map] using D.le_opNorm (normalLinearReflection E x)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_odd_w2p_extension_component_bounds (a : ℝ)
    (u : halfSpaceW2pZeroTrace (E := E) (p := p) a) :
    ∃ w : Wkp (volume : Measure P) ⊤ p 2,
      Wkp.restrictL (le_top : normalHalfSpace (E := E) a ≤ ⊤) 2 w =
        (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2) ∧
      ‖Wkp.value 2 w‖ ≤ 2 * ‖Wkp.value 2
        (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2)‖ ∧
      ‖Wkp.iteratedGradient 1 w‖ ≤ 2 * ‖Wkp.iteratedGradient 1
        (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2)‖ := by
  let v : Wkp (volume : Measure P) (normalHalfSpace a) p 2 := u
  have hv0 : Wkp.firstOrder 1 v ∈ w1p0Submodule volume (normalHalfSpace a) p := by
    have h := u.property
    change Wkp.firstOrderL 1 v ∈ w1p0Submodule volume (normalHalfSpace a) p at h
    rw [Wkp.firstOrderL_apply] at h
    exact h
  obtain ⟨w, hw, hD⟩ := Wkp.exists_value_ae_eq_sub_comp_normalReflection v hv0
  refine ⟨w, odd_w2p_restrict_eq a v w hw, ?_, ?_⟩
  · exact norm_lp_reflected_difference_le a id (fun _ => le_rfl) (Wkp.value 2 v) (Wkp.value 2 w) hw
  · exact norm_lp_reflected_difference_le a
      (fun D : P →L[ℝ] P => (normalLinearReflection E : P →L[ℝ] P) ∘L D ∘L
        (normalLinearReflection E : P →L[ℝ] P)) norm_normalReflection_conjugate_le
      (Wkp.iteratedGradient 1 v) (Wkp.iteratedGradient 1 w) hD

end ConformalPoisson

