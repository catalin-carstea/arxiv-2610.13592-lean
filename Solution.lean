/- Proof support: InverseProperties.lean, SHA256 102214212663ee0aea0ff68653985bb27d6d863a931f80f24e1ae44083faa7d4 -/
noncomputable section ProofPart_InverseProperties




/-
Consequences of the concrete zero-Dirichlet problem and its inverse trace bound.
In particular forcing convergence gives normal-trace convergence; this conclusion
is proved, rather than included in the Green representation assumption.
-/

open Bundle Set MeasureTheory Filter
open scoped Manifold ContDiff Topology ENNReal NNReal

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {q F H w u : M → ℝ}

without_proof_info in
theorem IsZeroDirichletSolution.sub (hw : IsZeroDirichletSolution g q F w)
    (hu : IsZeroDirichletSolution g q H u) : IsZeroDirichletSolution g q (F - H) (w - u) := by
  refine ⟨hw.1.sub hu.1, fun x hx => ?_, fun x => ?_⟩
  · rw [schrodinger_sub g q hw.1 hu.1, hw.2.1 x hx, hu.2.1 x hx]
    rfl
  · simp only [Pi.sub_apply, hw.2.2 x, hu.2.2 x, sub_self]

without_proof_info in
theorem Nonresonant.zeroDirichlet_solution_unique (hNR : Nonresonant g q)
    (hw : IsZeroDirichletSolution g q F w) (hu : IsZeroDirichletSolution g q F u) : w = u := by
  have hsub := hw.sub hu
  have hzero : IsDirichletSolution g q 0 (w - u) := by
    refine ⟨hsub.1, fun x hx => ?_, hsub.2.2⟩
    simpa only [Pi.sub_apply, sub_self] using hsub.2.1 x hx
  have h := hNR (w - u) hzero
  funext x
  simpa only [Pi.sub_apply, Pi.zero_apply, sub_eq_zero] using congrFun h x

omit [IsManifold (𝓡∂ (n + 1)) ω M] in
without_proof_info in
theorem normalDerivative_sub
    (ν : (x : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (x : M))
    (hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w)
    (hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u) (y : (𝓡∂ (n + 1)).boundary M) :
    normalDerivative ν (w - u) y = normalDerivative ν w y - normalDerivative ν u y := by
  change mvfderiv (𝓡∂ (n + 1)) (w - u) y (ν y) = _
  rw [mvfderiv_sub (hw.mdifferentiable (by decide) y) (hu.mdifferentiable (by decide) y)]
  rfl

variable [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]

without_proof_info in
/-- The exact normal convergence used with compact-interior forcing approximation.
The fixed inverse estimate is applied to the difference of actual zero-Dirichlet solutions. -/
theorem normalTrace_tendsto_of_forcing_tendsto
    (ν : (x : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (x : M))
    (y : (𝓡∂ (n + 1)).boundary M) (p : ℝ≥0∞) (C : ℝ≥0)
    (hbound : ∀ F w : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F →
      IsZeroDirichletSolution g q F w →
      |normalDerivative ν w y| ≤ (C : ℝ) * (eLpNorm F p (nativeVolume g)).toReal)
    (Fm wm : ℕ → M → ℝ) (hFm : ∀ m, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (Fm m))
    (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
    (hwm : ∀ m, IsZeroDirichletSolution g q (Fm m) (wm m))
    (hw : IsZeroDirichletSolution g q F w)
    (hconv : Tendsto (fun m => (eLpNorm (Fm m - F) p (nativeVolume g)).toReal) atTop (𝓝 0)) :
    Tendsto (fun m => normalDerivative ν (wm m) y) atTop (𝓝 (normalDerivative ν w y)) := by
  have hbd (m : ℕ) : ‖normalDerivative ν (wm m) y - normalDerivative ν w y‖ ≤
      (C : ℝ) * (eLpNorm (Fm m - F) p (nativeVolume g)).toReal := by
    have h := hbound (Fm m - F) (wm m - w) ((hFm m).sub hF) ((hwm m).sub hw)
    rw [normalDerivative_sub ν (hwm m).1 hw.1] at h
    simpa only [Real.norm_eq_abs] using h
  apply (tendsto_iff_norm_sub_tendsto_zero).mpr
  exact squeeze_zero (fun m => norm_nonneg _) hbd
    (by simpa only [mul_zero] using (tendsto_const_nhds.mul hconv :
      Tendsto (fun m => (C : ℝ) * (eLpNorm (Fm m - F) p (nativeVolume g)).toReal) atTop (𝓝 ((C : ℝ) * 0))))

end ConformalPoisson

end ProofPart_InverseProperties

/- Proof support: PoissonNonvanishing.lean, SHA256 6d173f4c2c62f269e5fcce25c05eedeaf03cd69f01879df626e8070467cc7973 -/
noncomputable section ProofPart_PoissonNonvanishing




/-
The inverse/Green contradiction in Lemma 3.6. This checked conditional caller
exposes the geometric test function and compact-interior approximation still to
be constructed by project proofs; neither is added to the literature package.
