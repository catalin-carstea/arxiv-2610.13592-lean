set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_halfBall_gradient_bound_of_hessian
    (hp : p ≠ (⊤ : ℝ≥0∞)) (a : ℝ) (Ω : Opens P) (x₀ : P) (R : ℝ) (hR : 0 < R)
    (hmatch : (Ω : Set P) ∩ ball x₀ R = (normalHalfSpace (E := E) a : Set P) ∩ ball x₀ R)
    (D : ℝ) (hD : 0 ≤ D) :
    ∃ C ≥ 0, ∀ u : Wkp (volume : Measure P) Ω p 2,
      (∀ η : P → ℝ, ContDiff ℝ ∞ η → HasCompactSupport η → tsupport η ⊆ ball x₀ R →
        ∀ w : Wkp (volume : Measure P) Ω p 2,
          Wkp.value 2 w =ᵐ[(volume : Measure P).restrict Ω] (fun x => η x * Wkp.value 2 u x) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω p) →
      (∀ r > 0, r < R → (R - r) ^ 2 * lpNorm (Wkp.iteratedGradient 1 u) p
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
        D * lpNorm (Wkp.value 2 u) p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R))) →
      lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ (R / 2))) ≤
        C * lpNorm (Wkp.value 2 u) p ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := by
  obtain ⟨c, hc, hstep⟩ := exists_halfBall_gradient_interpolation (E := E) hp
  let N : ℝ := 4 * (finrank ℝ P : ℝ) ^ 2
  obtain ⟨C, hC, hbound⟩ := exists_halfBall_gradient_value_constant R D c N hR hD hc (by dsimp [N]; positivity)
  refine ⟨C, hC, fun u hzero hH => ?_⟩
  let G := Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)
  let V := Wkp.value 2 u
  let h : ℝ → ℝ := fun σ => lpNorm G p
    ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ))
  let k : ℝ → ℝ := fun σ => lpNorm (Wkp.iteratedGradient 1 u) p
    ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ))
  let y : ℝ → ℝ := fun σ => lpNorm V p
    ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ σ))
