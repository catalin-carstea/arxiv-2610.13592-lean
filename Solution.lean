/- Reflection and folding on the unchanged Euclidean ball. The sufficient
Lipschitz constant three is deliberately nonoptimal. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def boundaryReflection (n : ℕ) :
    EuclideanSpace ℝ (Fin (n + 1)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (n + 1)) :=
  LinearIsometryEquiv.piLpCongrRight 2 fun i : Fin (n + 1) =>
    if i = 0 then LinearIsometryEquiv.neg ℝ else LinearIsometryEquiv.refl ℝ ℝ

without_proof_info in
@[simp] theorem boundaryReflection_apply (x : V) (i : Fin (n + 1)) :
    boundaryReflection n x i = if i = 0 then -x i else x i := by
  by_cases hi : i = 0 <;> simp [boundaryReflection, hi]

without_proof_info in
@[simp] theorem boundaryReflection_involutive (x : V) :
    boundaryReflection n (boundaryReflection n x) = x := by
  ext i
  by_cases hi : i = 0 <;> simp [hi]

without_proof_info in
@[simp] theorem norm_boundaryReflection (x : V) : ‖boundaryReflection n x‖ = ‖x‖ :=
  (boundaryReflection n).norm_map x

def boundaryFold (x : V) : V :=
  x + (|x 0| - x 0) • EuclideanSpace.single 0 1

without_proof_info in
@[simp] theorem boundaryFold_normal (x : V) : boundaryFold x 0 = |x 0| := by
  simp [boundaryFold]

without_proof_info in
theorem boundaryFold_tangent (x : V) {i : Fin (n + 1)} (hi : i ≠ 0) :
    boundaryFold x i = x i := by
  simp [boundaryFold, hi, Ne.symm hi]

without_proof_info in
theorem boundaryFold_eq_self (x : V) (hx : 0 ≤ x 0) : boundaryFold x = x := by
  simp [boundaryFold, abs_of_nonneg hx]

without_proof_info in
theorem boundaryFold_eq_reflection (x : V) (hx : x 0 ≤ 0) :
    boundaryFold x = boundaryReflection n x := by
  ext i
  by_cases hi : i = 0
  · subst i
    simp [abs_of_nonpos hx]
  · simp [boundaryFold_tangent x hi, hi]

without_proof_info in
@[simp] theorem norm_boundaryFold (x : V) : ‖boundaryFold x‖ = ‖x‖ := by
  by_cases hx : 0 ≤ x 0
  · rw [boundaryFold_eq_self x hx]
  · rw [boundaryFold_eq_reflection x (le_of_not_ge hx), norm_boundaryReflection]

without_proof_info in
theorem boundaryFold_lipschitz : LipschitzWith 3 (boundaryFold (n := n)) := by
  apply LipschitzWith.of_dist_le_mul
  intro x y
  have hxy : |x 0 - y 0| ≤ ‖x - y‖ := by
    simpa using PiLp.norm_apply_le (x - y) 0
  have hc : |(|x 0| - x 0) - (|y 0| - y 0)| ≤ 2 * ‖x - y‖ := by
    calc
      _ = |(|x 0| - |y 0|) - (x 0 - y 0)| := by congr 1 <;> ring
      _ ≤ abs (abs (x 0) - abs (y 0)) + |x 0 - y 0| := abs_sub _ _
      _ ≤ 2 * ‖x - y‖ := by
        have h := abs_abs_sub_abs_le_abs_sub (x 0) (y 0)
        linarith
  have heq : boundaryFold x - boundaryFold y =
      (x - y) + ((|x 0| - x 0) - (|y 0| - y 0)) • EuclideanSpace.single 0 1 := by
    simp only [boundaryFold, sub_smul]
    abel
  rw [dist_eq_norm, dist_eq_norm, heq]
  calc
    _ ≤ ‖x - y‖ + ‖((|x 0| - x 0) - (|y 0| - y 0)) •
        (EuclideanSpace.single 0 1 : V)‖ := norm_add_le _ _
    _ = ‖x - y‖ + |(|x 0| - x 0) - (|y 0| - y 0)| := by
      simp [norm_smul, EuclideanSpace.single, PiLp.norm_single]
    _ ≤ _ := by norm_num; linarith

without_proof_info in
theorem boundaryFold_localizedTranslation (χ : V → ℝ) (a x : V)
    (ha : a 0 = 0) (hχ : χ (boundaryFold x) = χ x) :
    boundaryFold (localizedTranslation χ a x) =
      localizedTranslation χ a (boundaryFold x) := by
  simp only [localizedTranslation]
  rw [hχ]
  ext i
  simp only [boundaryFold, localizedTranslation, PiLp.add_apply, PiLp.smul_apply,
    smul_eq_mul, ha, mul_zero, add_zero]
  ring

def boundaryFoldClosed (x : closedBall (0 : V) 1) : closedBall (0 : V) 1 :=
  ⟨boundaryFold x, by
    apply mem_closedBall_zero_iff.mpr
    rw [norm_boundaryFold]
    exact mem_closedBall_zero_iff.mp x.property⟩

without_proof_info in
@[simp] theorem boundaryFoldClosed_coe (x : closedBall (0 : V) 1) :
    (boundaryFoldClosed x : V) = boundaryFold x := rfl

without_proof_info in
theorem boundaryFoldClosed_lipschitz :
    LipschitzWith 3 (boundaryFoldClosed (n := n)) := by
  intro x y
  exact boundaryFold_lipschitz (x : V) (y : V)

end ConformalPoisson

