    { domain := V
      base_mem := ⟨R.base_mem, hαO⟩
      tensor := R.tensor
      analytic := R.analytic.mono (by intro z hz; exact hz.1)
      symmetric := R.symmetric
      positive := fun z hz => R.positive z hz.1
      agrees := R.agrees }
  refine ⟨R', rfl, (by intro z hz; exact hz.1), ?_⟩
