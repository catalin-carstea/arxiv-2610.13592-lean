without_proof_info in
theorem nativeGradientPairing_const_left (g : Metric (n := n) (M := M))
    (k : ℝ) (v : M → ℝ) (x : M) : nativeGradientPairing g (fun _ => k) v x = 0 := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  dsimp only [nativeGradientPairing]
  rw [TauCeti.Manifold.inner_mgradient, mvfderiv_const]
  rfl

without_proof_info in
theorem schrodinger_const_rescale
    (g : Metric (n := n) (M := M)) (k : ℝ) (hk : 0 < k) (p q v : M → ℝ)
    (hv : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ v) (x : M) :
    schrodinger (g.rescale (fun _ => k) contMDiff_const (fun _ => hk)) p v x =
      k⁻¹ * schrodinger g q v x + (p x - k⁻¹ * q x) * v x := by
  have hL := schrodinger_rescale_zero g (fun _ => k) v contMDiff_const (fun _ => hk) hv x
  rw [nativeGradientPairing_const_left, mul_zero, sub_zero] at hL
  rw [schrodinger_eq_zero_potential_add _ p v x, hL,
    schrodinger_eq_zero_potential_add g q v x]
  ring

without_proof_info in
theorem potential_eq_of_const_rescale_common_solution
    (g : Metric (n := n) (M := M)) (k : ℝ) (hk : 0 < k) (p q v : M → ℝ)
    (hv : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ v) (x : M) (hvx : v x ≠ 0)
    (hg : schrodinger g q v x = 0)
    (hh : schrodinger (g.rescale (fun _ => k) contMDiff_const (fun _ => hk)) p v x = 0) :
    p x = k⁻¹ * q x := by
  rw [schrodinger_const_rescale g k hk p q v hv x, hg, mul_zero, zero_add] at hh
  exact sub_eq_zero.mp ((mul_eq_zero.mp hh).resolve_right hvx)

end ConformalPoisson

