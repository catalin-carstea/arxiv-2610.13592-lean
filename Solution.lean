          continuous_snd.continuousAt] with s hs
        change f s.2 = 0 at hs
        change boundaryPoissonSection ν G.kernel s.2 s.1 * f s.2 = 0
        rw [hs, mul_zero]
      exact (contMDiffAt_const.congr_of_eventuallyEq he).contMDiffWithinAt
  have hRep (x : M) (hx : x ∈ Cᶜ) : S.solve f x = ∫ z, F x z ∂nativeSurfaceMeasure g := by
    by_cases hxB : (𝓡∂ (n + 1)).IsBoundaryPoint x
    · let b : (Ihalf).boundary M := ⟨x, hxB⟩
      have hbF : f b = 0 := notMem_tsupport_iff_eventuallyEq.mp (by
        intro hb
        exact hx ⟨b, hb, rfl⟩) |>.eq_of_nhds
      have hIntZero : (fun z => F x z) = (0 : (Ihalf).boundary M → ℝ) := by
        funext z
        exact (congrArg (fun t => t * f z) (G.poissonSection_zero_boundary ν z b)).trans (zero_mul _)
      rw [hIntZero]
      change S.solve f x = ∫ _, (0 : ℝ) ∂nativeSurfaceMeasure g
      rw [integral_zero]
      exact ((S.correct f hf).2.2 b).trans hbF
    · exact (G.poisson_representation hq S ν hν f hf x
        (((𝓡∂ (n + 1)).isInteriorPoint_iff_not_isBoundaryPoint x).mpr hxB)).2
  obtain ⟨hInt, hEq⟩ := native_compact_integral_derivative (J := 𝓡 n)
    (μ := nativeSurfaceMeasure g) g hU hSmooth (S.correct f hf).1.contMDiffOn hRep hyC (ν y)
