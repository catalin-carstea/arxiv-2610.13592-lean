    have hn : ‖hηH.toLp _‖ ≤ ‖Wkp.iteratedGradient 1 uR‖ := by
      refine Lp.norm_le_norm_of_ae_le ?_
      filter_upwards [hηH.coeFn_toLp] with x hx
      rw [hx, norm_smul, Real.norm_eq_abs]
