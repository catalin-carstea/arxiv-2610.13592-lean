namespace ConformalPoisson.LocalDN
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem exists_actual_shared_boundary_data
    (β : Diffeomorph (𝓡 n) (𝓡 n) ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (x : (𝓡∂ (n + 1)).boundary M₁)
    {g₁ : Metric (n := n) (M := M₁)} {g₂ : Metric (n := n) (M := M₂)}
    {O₁ : TopologicalSpace.Opens M₁} {O₂ : TopologicalSpace.Opens M₂}
    (C : CommonNormalCharts β x g₁ g₂ O₁ O₂)
    {Γ : Set ((𝓡∂ (n + 1)).boundary M₁)}
    (hΓ : ∀ y : (𝓡∂ (n + 1)).boundary M₁, (y : M₁) ∈ C.chart₁.target → y ∈ Γ)
    {ξ : Fin n → ℝ} {U₁ U₂ : Set Y} (B₁ : BoundaryLayerCoefficients ξ U₁) (B₂ : BoundaryLayerCoefficients ξ U₂)
    (hU : IsOpen U₁) {K : Set Y} (hK : IsCompact K) (hKU : K ⊆ U₁)
    (a : Y → ℂ) (ha : ContDiffOn ℝ ∞ a U₁) (ha0 : ∀ y ∉ K, a y = 0)
    (η : ContDiffBump (0 : ℝ)) (hη : η 0 = 1)
    (hcap : (nativeNormalCoordinates (n := n)) ⁻¹' (K ×ˢ tsupport η) ⊆ C.chart₁.source) :
    ∃ fr fi : ℝ → BoundaryDatum Γ, ∀ h : ℝ, ∀ N : ℕ,
      (∀ y : (𝓡∂ (n + 1)).boundary M₁, (B₁.nativeWave C.chart₁ a η N h y).re = (fr h).val y) ∧
      (∀ y : (𝓡∂ (n + 1)).boundary M₁, (B₁.nativeWave C.chart₁ a η N h y).im = (fi h).val y) ∧
      (∀ y : (𝓡∂ (n + 1)).boundary M₂, (B₂.nativeWave C.chart₂ a η N h y).re = (fr h).val (β.symm y)) ∧
      (∀ y : (𝓡∂ (n + 1)).boundary M₂, (B₂.nativeWave C.chart₂ a η N h y).im = (fi h).val (β.symm y)) := by
  let W (h : ℝ) := B₁.nativeWave C.chart₁ a η 0 h
  have hW (h : ℝ) := B₁.nativeWave_contMDiff C.chart₁ hU hK hKU a ha ha0 η η.contDiff η.hasCompactSupport hcap 0 h
  have hcW (h : ℝ) := B₁.nativeWave_hasCompactSupport C.chart₁ hU hK a ha ha0 η η.hasCompactSupport hcap 0 h
  have hpW (h : ℝ) : ∀ y : (𝓡∂ (n + 1)).boundary M₁, (y : M₁) ∈ tsupport (W h) → y ∈ Γ := by
    intro y hy
    obtain ⟨z, hz, he⟩ := B₁.nativeWave_tsupport_subset_cap_image C.chart₁ hU hK a ha ha0 η η.hasCompactSupport hcap 0 h hy
    exact hΓ y (he ▸ C.chart₁.map_source (hcap hz))
  let fr : ℝ → BoundaryDatum Γ := fun h => nativeTraceDatum Complex.reCLM (W h) (hW h) (hcW h) (hpW h)
  let fi : ℝ → BoundaryDatum Γ := fun h => nativeTraceDatum Complex.imCLM (W h) (hW h) (hcW h) (hpW h)
  refine ⟨fr, fi, ?_⟩
  intro h N
  have he₁ (y : (𝓡∂ (n + 1)).boundary M₁) : B₁.nativeWave C.chart₁ a η N h y = W h y :=
    B₁.nativeWave_boundary_same B₁ C.chart₁ a η η hη hη N 0 h y
  have he₂ (y : (𝓡∂ (n + 1)).boundary M₂) : B₂.nativeWave C.chart₂ a η N h y = W h (β.symm y) := by
    have he := BoundaryLayerCoefficients.nativeWave_common_boundary β x C B₁ B₂ a η η hη hη 0 N h (β.symm y)
    simpa only [Diffeomorph.apply_symm_apply] using he
  exact ⟨fun y => congrArg Complex.re (he₁ y), fun y => congrArg Complex.im (he₁ y),
    fun y => congrArg Complex.re (he₂ y), fun y => congrArg Complex.im (he₂ y)⟩

end ConformalPoisson.LocalDN

