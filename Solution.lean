  refine ⟨N, hcN, C, hC, fun F u hF hu x hx => ?_⟩
  let μ : Measure P := volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)
  let w : P → ℝ := fun t => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))
  let FN := (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal
  let S := ‖nativeC1Function g u (hu.1.of_le (by simp))‖
  let forcingLpNorm := lpNorm (fun t : P => F ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))) (r : ℝ≥0∞) μ
  let gradLpNorm := lpNorm (∇ w) (r : ℝ≥0∞) μ
  let valueLpNorm := lpNorm w (r : ℝ≥0∞) μ
