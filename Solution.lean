/- Uniform Lp bounds for the exact native local forcing. The drift and
potential constants are fixed before all forcings and solutions. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem native_boundary_rhs_lp_bound (hpfin : p ≠ ⊤)
    (g : Metric (n := n) (M := M)) (c : M) (q : M → ℝ) (hq : Continuous q)
    (b : ContDiffBump (extChartAt Ihalf c c)) {r : ℝ} (hbr : b.rOut < r)
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) :
    ∃ B ≥ 0, ∃ Q ≥ 0, ∀ F u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F →
      IsZeroDirichletSolution g q F u →
      MemLp (splitChartTraceForcing g c q F u) p
          (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) ∧
      lpNorm (splitChartTraceForcing g c q F u) p
          (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) ≤
        B * lpNorm (∇ (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)))) p
            (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) +
          Q * lpNorm (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) p
            (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) +
          lpNorm (fun z : P => F ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) p
            (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) := by
  obtain ⟨B, hB, Q, hQ, hbounds⟩ := exists_native_boundary_lower_order_bounds g c hq hrt
  refine ⟨B, hB, Q, hQ, fun F u hF hu => ?_⟩
  obtain ⟨U, hU, _, f, hf, _⟩ := exists_native_boundary_lp_equation (p := p)
    hpfin g q F u hu c b hbr hrt
  let e := euclideanNormalSplit n
  let w : P → ℝ := fun z => u ((extChartAt Ihalf c).symm (e z))
  let μ : Measure P := volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)
  have hw : MemLp w p μ := MemLp.ae_eq hU (Lp.memLp (Wkp.value 2 U))
  have hU1 : W1p.value (Wkp.firstOrder 1 U) =ᵐ[μ] w := by
    simpa only [Wkp.value_firstOrder] using hU
  have hgrad := W1p.gradient_ae_eq_of_contDiffOn (Wkp.firstOrder 1 U)
    ((contDiffOn_split_boundary_chart_reading c hrt hu.1).of_le (by simp)) hU1
  have hgw : MemLp (∇ w) p μ := MemLp.ae_eq hgrad (Lp.memLp (W1p.gradient (Wkp.firstOrder 1 U)))
  obtain ⟨Vf, hVf⟩ := exists_Wkp_boundary_chart_reading (μ := (volume : Measure V)) (p := p) c hrt hF 0
  have hFV : MemLp (F ∘ (extChartAt Ihalf c).symm) p
      (volume.restrict (boundaryChartCap (I := Ihalf) c r : Set V)) :=
    MemLp.ae_eq hVf (Lp.memLp (Wkp.value 0 Vf))
  have heR : MeasurePreserving e μ
      (volume.restrict (boundaryChartCap (I := Ihalf) c r : Set V)) :=
    (e.measurePreserving).restrict_preimage (boundaryChartCap (I := Ihalf) c r).isOpen.measurableSet
  have hFM : MemLp (fun z : P => F ((extChartAt Ihalf c).symm (e z))) p μ :=
    hFV.comp_measurePreserving heR
  have hRhs : AEStronglyMeasurable (splitChartTraceForcing g c q F u) μ :=
    (Lp.aestronglyMeasurable f).congr hf
  have hpointwise : ∀ᵐ z ∂μ, ‖splitChartTraceForcing g c q F u z‖ ≤
      B * ‖∇ w z‖ + Q * ‖w z‖ + ‖F ((extChartAt Ihalf c).symm (e z))‖ := by
    filter_upwards [ae_restrict_mem (splitBoundaryChartCap (n := n) c r).isOpen.measurableSet]
      with z hz
    obtain ⟨hbz, hqz⟩ := hbounds (e z) ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩
    have hn : ‖∇ w z‖ = ‖fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (e z)‖ := by
      change ‖∇ ((u ∘ (extChartAt Ihalf c).symm) ∘ e) z‖ = _
      rw [gradient_comp_linearIsometryEquiv_right, e.symm.norm_map, norm_gradient_eq_norm_fderiv]
    rw [hn]
    simpa only [Real.norm_eq_abs] using splitChartTraceForcing_abs_le g c q F u hbz hqz
  exact ⟨MemLp.ae_eq hf (Lp.memLp f),
    lpNorm_le_three_terms_of_ae_norm_le (Fact.out : 1 ≤ p) hRhs hgw hw hFM hB hQ hpointwise⟩

end ConformalPoisson

