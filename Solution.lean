theorem inverseChart_interior_of_mem_interior_target (α : M)
    {z : EuclideanSpace ℝ (Fin (n + 1))}
    (hz : z ∈ interior (extChartAt (𝓡∂ (n + 1)) α).target) :
    (𝓡∂ (n + 1)).IsInteriorPoint ((extChartAt (𝓡∂ (n + 1)) α).symm z) := by
  have hzt := interior_subset hz
  have hy : (extChartAt (𝓡∂ (n + 1)) α).symm z ∈
      (chartAt (EuclideanHalfSpace (n + 1)) α).source := by
    simpa only [extChartAt_source] using (extChartAt (𝓡∂ (n + 1)) α).map_target hzt
  apply (TauCeti.ModelWithCorners.isInteriorPoint_iff_mem_interior_range
    (I := 𝓡∂ (n + 1)) (k := ω) (by decide) (IsManifold.chart_mem_maximalAtlas α) hy).mpr
  change extChartAt (𝓡∂ (n + 1)) α ((extChartAt (𝓡∂ (n + 1)) α).symm z) ∈
    interior (range (𝓡∂ (n + 1)))
  rw [(extChartAt (𝓡∂ (n + 1)) α).right_inv hzt]
  exact interior_mono (extChartAt_target_subset_range α) hz

without_proof_info in
theorem boundary_coordinate_zero (α : (𝓡∂ (n + 1)).boundary M) :
    (extChartAt (𝓡∂ (n + 1)) (α : M) α) 0 = 0 := by
  have hh := (TauCeti.ModelWithCorners.isBoundaryPoint_iff_mem_frontier_range
    (I := 𝓡∂ (n + 1)) (k := ω) (by decide) (IsManifold.chart_mem_maximalAtlas (α : M))
    (mem_chart_source _ _)).mp α.property
  change extChartAt (𝓡∂ (n + 1)) (α : M) α ∈ frontier (range (𝓡∂ (n + 1))) at hh
  rw [frontier_range_modelWithCornersEuclideanHalfSpace] at hh
  exact hh.symm

def positiveCoordinateCap (D : Opens (EuclideanSpace ℝ (Fin (n + 1)))) :
    Opens (EuclideanSpace ℝ (Fin (n + 1))) :=
  ⟨(D : Set _) ∩ {z | 0 < z 0}, D.isOpen.inter
    (isOpen_lt continuous_const (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous)⟩

without_proof_info in
theorem positiveCoordinateCap_frontier (D : Opens (EuclideanSpace ℝ (Fin (n + 1))))
    {z : EuclideanSpace ℝ (Fin (n + 1))}
    (hz : z ∈ frontier (positiveCoordinateCap D : Set _)) (hzD : z ∈ D) : z 0 = 0 := by
  have hsub : (positiveCoordinateCap D : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆
      {z | 0 ≤ z 0} := by
    intro z hz
    change 0 ≤ z 0
    exact (show 0 < z 0 from hz.2).le
  have hcl : closure (positiveCoordinateCap D : Set (EuclideanSpace ℝ (Fin (n + 1)))) ⊆
      {z | 0 ≤ z 0} := closure_minimal hsub
        (isClosed_le continuous_const (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous)
  have hnonneg := hcl hz.1
  have hnpos : ¬ 0 < z 0 := by
    intro hp
    exact hz.2 ((positiveCoordinateCap D).isOpen.mem_nhds ⟨hzD, hp⟩ |> mem_interior_iff_mem_nhds.mpr)
  exact le_antisymm (le_of_not_gt hnpos) hnonneg

end ConformalPoisson

end ProofPart_NativeCauchyGeometry

/- Proof support: AmbientTestFunctions.lean, SHA256 4c6f2ea88f2ad9c24290c7fe9fcf9c048c773dee4f7f5e0276224e43f93494c4 -/
noncomputable section ProofPart_AmbientTestFunctions


/- Restrict a test to an actual ambient open chart, retaining compact
support inside that chart. The coordinate operator vanishes wherever
the test is locally zero, with no regularity condition on the
coefficients needed for this support assertion. -/
open Bundle Set TopologicalSpace Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

without_proof_info in
theorem tsupport_ambient_restriction_subset (D : Opens E) (f : E → ℝ) :
    tsupport (fun x : D => f x) ⊆ (Subtype.val : D → E) ⁻¹' tsupport f :=
  tsupport_comp_subset_preimage f continuous_subtype_val

without_proof_info in
theorem hasCompactSupport_ambient_restriction (D : Opens E) {f : E → ℝ}
    (hfc : HasCompactSupport f) (hfs : tsupport f ⊆ D) :
    HasCompactSupport (fun x : D => f x) := by
  have hK : IsCompact ((Subtype.val : D → E) ⁻¹' tsupport f) :=
    Topology.IsEmbedding.subtypeVal.isInducing.isCompact_preimage' hfc
      (by rwa [Subtype.range_coe])
  exact HasCompactSupport.intro hK fun x hx => image_eq_zero_of_notMem_tsupport hx


without_proof_info in
/-- A genuine compact ambient cap inside a chosen open chart neighborhood. -/
theorem exists_ambient_compact_cap [ProperSpace E]
    (D : Opens E) (p : D) (S : Opens D) (hpS : p ∈ S) :
    ∃ U : Opens E, (p : E) ∈ U ∧ IsCompact (closure (U : Set E)) ∧
      closure (U : Set E) ⊆ D ∧ ∀ x : D, (x : E) ∈ U → x ∈ S := by
  have hO : IsOpen ((Subtype.val : D → E) '' (S : Set D)) :=
    D.isOpen.isOpenMap_subtype_val _ S.isOpen
  have hpO : (p : E) ∈ (Subtype.val : D → E) '' (S : Set D) := ⟨p, hpS, rfl⟩
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hO (p : E) hpO
  let U : Opens E := ⟨Metric.ball (p : E) (r / 2), Metric.isOpen_ball⟩
  have hcl : closure (U : Set E) = Metric.closedBall (p : E) (r / 2) :=
    closure_ball (p : E) (half_pos hr).ne'
  have hKO : closure (U : Set E) ⊆ (Subtype.val : D → E) '' (S : Set D) := by
    rw [hcl]
    exact (Metric.closedBall_subset_ball (half_lt_self hr)).trans hball
  refine ⟨U, Metric.mem_ball_self (half_pos hr), ?_, ?_, ?_⟩
  · rw [hcl]
    exact isCompact_closedBall _ _
  · intro x hx
    obtain ⟨y, _, rfl⟩ := hKO hx
    exact y.property
  · intro x hx
    obtain ⟨y, hy, he⟩ := hKO (subset_closure hx)
    have hyx : y = x := Subtype.ext he
    exact hyx ▸ hy

without_proof_info in
theorem coordinateSchrodinger_eq_zero_of_notMem_tsupport {d : ℕ}
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q f : EuclideanSpace ℝ (Fin d) → ℝ) {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∉ tsupport f) : coordinateSchrodinger a b q f x = 0 := by
  have he : f =ᶠ[𝓝 x] 0 := notMem_tsupport_iff_eventuallyEq.mp hx
  rw [coordinateSchrodinger_eq_of_eventuallyEq a b q he]
  simp [coordinateSchrodinger]

without_proof_info in
theorem tsupport_coordinateSchrodinger_subset {d : ℕ}
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q f : EuclideanSpace ℝ (Fin d) → ℝ) :
    tsupport (coordinateSchrodinger a b q f) ⊆ tsupport f := by
  apply closure_minimal ?_ (isClosed_tsupport f)
  intro x hx
  by_contra hxf
  exact hx (coordinateSchrodinger_eq_zero_of_notMem_tsupport a b q f hxf)

end ConformalPoisson

end ProofPart_AmbientTestFunctions

/- Proof support: H2CoordinateReadings.lean, SHA256 330c13ed9ea8fb878c8ae2fdf03cd2f5d0fed3c417cdc574dfc301d6a798cef6 -/
noncomputable section ProofPart_H2CoordinateReadings



/- Bounded actual value, gradient and Hessian component readings
for the Euclidean H2 graph. Scalar coefficient multiplication uses
mathlib's canonical Holder operator with exponents infinity,2,2. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}

/-- Multiplication by an actual L-infinity coefficient on the same domain. -/
def h2ScalarMultiplier (a : Lp ℝ ∞ (μ.restrict Ω)) :
    Lp ℝ 2 (μ.restrict Ω) →L[ℝ] Lp ℝ 2 (μ.restrict Ω) :=
  (ContinuousLinearMap.mul ℝ ℝ).holderL (μ.restrict Ω) ∞ 2 2 a

without_proof_info in
theorem h2ScalarMultiplier_ae (a : Lp ℝ ∞ (μ.restrict Ω)) (f : Lp ℝ 2 (μ.restrict Ω)) :
    h2ScalarMultiplier a f =ᵐ[μ.restrict Ω] fun x => a x * f x := by
  exact (ContinuousLinearMap.mul ℝ ℝ).coeFn_holder a f

/-- A first directional derivative read from the actual weak gradient. -/
def h2GradientComponentL (v : E) : Wkp μ Ω 2 2 →L[ℝ] Lp ℝ 2 (μ.restrict Ω) :=
  ((innerSL ℝ v).compLpL 2 (μ.restrict Ω)).comp
    (W1p.gradientL.comp (Wkp.firstOrderL 1))

/-- A Hessian entry read from the actual highest weak derivative. -/
def h2HessianComponentL (v w : E) : Wkp μ Ω 2 2 →L[ℝ] Lp ℝ 2 (μ.restrict Ω) :=
  (((innerSL ℝ w).comp (ContinuousLinearMap.apply ℝ E v)).compLpL 2 (μ.restrict Ω)).comp
    (Wkp.iteratedGradientL 1)

without_proof_info in
theorem h2GradientComponentL_ae (v : E) (u : Wkp μ Ω 2 2) :
    h2GradientComponentL v u =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient (Wkp.firstOrder 1 u) x, v⟫_ℝ := by
  have hf : Wkp.firstOrderL 1 u = Wkp.firstOrder 1 u := Wkp.firstOrderL_apply 1 u
  have hg : W1p.gradientL (Wkp.firstOrderL 1 u) = W1p.gradient (Wkp.firstOrder 1 u) :=
    (congrArg W1p.gradientL hf).trans (W1p.gradientL_apply _)
  have he : h2GradientComponentL v u =
      (innerSL ℝ v).compLpL 2 (μ.restrict Ω) (W1p.gradient (Wkp.firstOrder 1 u)) := by
    unfold h2GradientComponentL
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply]
    exact congrArg ((innerSL ℝ v).compLpL 2 (μ.restrict Ω)) hg
  rw [he]
  filter_upwards [(innerSL ℝ v).coeFn_compLpL (W1p.gradient (Wkp.firstOrder 1 u))] with x hx
  rw [hx, innerSL_apply_apply, real_inner_comm]

without_proof_info in
theorem h2HessianComponentL_ae (v w : E) (u : Wkp μ Ω 2 2) :
    h2HessianComponentL v w u =ᵐ[μ.restrict Ω]
      fun x => ⟪Wkp.iteratedGradient 1 u x v, w⟫_ℝ := by
  let L : (E →L[ℝ] E) →L[ℝ] ℝ := (innerSL ℝ w).comp (ContinuousLinearMap.apply ℝ E v)
  have hH : Wkp.iteratedGradientL 1 u = Wkp.iteratedGradient 1 u := Wkp.iteratedGradientL_apply 1 u
  have he : h2HessianComponentL v w u = L.compLpL 2 (μ.restrict Ω) (Wkp.iteratedGradient 1 u) := by
    unfold h2HessianComponentL
    rw [ContinuousLinearMap.comp_apply]
    exact congrArg (L.compLpL 2 (μ.restrict Ω)) hH
  rw [he]
  filter_upwards [L.coeFn_compLpL (Wkp.iteratedGradient 1 u)] with x hx
  rw [hx]
  change ⟪w, Wkp.iteratedGradient 1 u x v⟫_ℝ = _
  exact real_inner_comm _ _

end ConformalPoisson

end ProofPart_H2CoordinateReadings

/- Proof support: H2CoefficientOperator.lean, SHA256 05b601b0d5ddf3b70f11c14467b629fb36f611c63bb5e463560c6deab3c34352 -/
noncomputable section ProofPart_H2CoefficientOperator


/- The actual nondivergence operator on the H2 graph, with bounded
measurable principal, drift and signed potential coefficients. All
components are bounded linear maps into the same L2 space. -/
open Set MeasureTheory TopologicalSpace TauCeti Filter
open scoped ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}
  {ι : Type*} [Fintype ι]

/-- The weak second-order expression with the paper's negative
principal-part sign convention. -/
def h2CoefficientOperator (e : ι → E)
    (a : ι → ι → Lp ℝ ∞ (μ.restrict Ω)) (b : ι → Lp ℝ ∞ (μ.restrict Ω))
    (q : Lp ℝ ∞ (μ.restrict Ω)) : Wkp μ Ω 2 2 →L[ℝ] Lp ℝ 2 (μ.restrict Ω) :=
  -(∑ i, ∑ j, (h2ScalarMultiplier (a i j)).comp (h2HessianComponentL (e i) (e j))) +
    (∑ i, (h2ScalarMultiplier (b i)).comp (h2GradientComponentL (e i))) +
    (h2ScalarMultiplier q).comp (Wkp.valueL 2)

without_proof_info in
/-- A finite sum of actual L2 readings has the sum of their readings. -/
theorem finite_sum_L2_ae {X : Type*} [MeasurableSpace X] {ν : Measure X}
    (f : ι → Lp ℝ 2 ν) (g : ι → X → ℝ) (hf : ∀ i, f i =ᵐ[ν] g i) :
    (∑ i, f i) =ᵐ[ν] fun x => ∑ i, g i x := by
  filter_upwards [Lp.coeFn_fun_finsetSum Finset.univ f, ae_all_iff.mpr hf] with x hx hfx
  rw [hx]
  exact Finset.sum_congr rfl fun i _ => hfx i

set_option maxHeartbeats 600000 in
without_proof_info in
theorem h2CoefficientOperator_ae (e : ι → E)
    (a : ι → ι → Lp ℝ ∞ (μ.restrict Ω)) (b : ι → Lp ℝ ∞ (μ.restrict Ω))
    (q : Lp ℝ ∞ (μ.restrict Ω)) (u : Wkp μ Ω 2 2) :
    h2CoefficientOperator e a b q u =ᵐ[μ.restrict Ω] fun x =>
      -(∑ i, ∑ j, a i j x * ⟪Wkp.iteratedGradient 1 u x (e i), e j⟫_ℝ) +
      (∑ i, b i x * ⟪W1p.gradient (Wkp.firstOrder 1 u) x, e i⟫_ℝ) + q x * Wkp.value 2 u x := by
  let A := fun i j => h2ScalarMultiplier (a i j) (h2HessianComponentL (e i) (e j) u)
  let B := fun i => h2ScalarMultiplier (b i) (h2GradientComponentL (e i) u)
  let Q := h2ScalarMultiplier q (Wkp.value 2 u)
  have hA (i j : ι) : A i j =ᵐ[μ.restrict Ω]
      fun x => a i j x * ⟪Wkp.iteratedGradient 1 u x (e i), e j⟫_ℝ := by
    filter_upwards [h2ScalarMultiplier_ae (a i j) (h2HessianComponentL (e i) (e j) u),
      h2HessianComponentL_ae (e i) (e j) u] with x hx hy
    change h2ScalarMultiplier (a i j) (h2HessianComponentL (e i) (e j) u) x = _
    rw [hx, hy]
  have hB (i : ι) : B i =ᵐ[μ.restrict Ω]
      fun x => b i x * ⟪W1p.gradient (Wkp.firstOrder 1 u) x, e i⟫_ℝ := by
    filter_upwards [h2ScalarMultiplier_ae (b i) (h2GradientComponentL (e i) u),
      h2GradientComponentL_ae (e i) u] with x hx hy
    change h2ScalarMultiplier (b i) (h2GradientComponentL (e i) u) x = _
    rw [hx, hy]
  have hQ : Q =ᵐ[μ.restrict Ω] fun x => q x * Wkp.value 2 u x := h2ScalarMultiplier_ae q _
  have hAsum := finite_sum_L2_ae (fun i => ∑ j, A i j) _
    (fun i => finite_sum_L2_ae (A i) _ (hA i))
  have hBsum := finite_sum_L2_ae B _ hB
  have hoperator : h2CoefficientOperator e a b q u = -(∑ i, ∑ j, A i j) + (∑ i, B i) + Q := by
    simp only [h2CoefficientOperator, A, B, Q, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.sum_apply, ContinuousLinearMap.comp_apply]
    exact congrArg (fun z : Lp ℝ 2 (μ.restrict Ω) =>
      -(∑ i, ∑ j, A i j) + (∑ i, B i) + h2ScalarMultiplier q z) (Wkp.valueL_apply 2 u)
  rw [hoperator]
  filter_upwards [Lp.coeFn_add (-(∑ i, ∑ j, A i j) + (∑ i, B i)) Q,
    Lp.coeFn_add (-(∑ i, ∑ j, A i j)) (∑ i, B i), Lp.coeFn_neg (∑ i, ∑ j, A i j),
    hAsum, hBsum, hQ] with x hx hxadd hxneg hax hbx hqx
  rw [hx, Pi.add_apply, hxadd, Pi.add_apply, hxneg, Pi.neg_apply, hax, hbx, hqx]
end ConformalPoisson

end ProofPart_H2CoefficientOperator

/- Proof support: CoordinateConormalFlux.lean, SHA256 3a74ee46879a0adb717dbc014b12d1c4b0950a69e74398a9e74289deec969ae8 -/
noncomputable section ProofPart_CoordinateConormalFlux




/- The actual conormal flux of a classical coordinate solution.
It is the Riesz representative of Du composed with a, so its divergence
has the exact Hessian contraction used by coordinateSchrodinger. This
is the classical-to-weak bridge for the smooth interior bootstrap. -/
open Set MeasureTheory InnerProductSpace TauCeti
open scoped ContDiff Gradient Distributions InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

def coordinateConormalFlux (a : E → E →L[ℝ] E) (u : E → ℝ) (z : E) : E :=
  (InnerProductSpace.toDual ℝ E).symm ((fderiv ℝ u z).comp (a z))

without_proof_info in
theorem inner_coordinateConormalFlux (a : E → E →L[ℝ] E) (u : E → ℝ) (z v : E) :
    ⟪v, coordinateConormalFlux a u z⟫_ℝ = fderiv ℝ u z (a z v) := by
  rw [real_inner_comm, coordinateConormalFlux, InnerProductSpace.toDual_symm_apply]
  rfl

without_proof_info in
theorem coordinateConormalFlux_contDiffOn {U : Set E} (hU : IsOpen U)
    {a : E → E →L[ℝ] E} {u : E → ℝ}
    (ha : ContDiffOn ℝ 1 a U) (hu : ContDiffOn ℝ 2 u U) :
    ContDiffOn ℝ 1 (coordinateConormalFlux a u) U := by
  exact (InnerProductSpace.toDual ℝ E).symm.contDiff.comp_contDiffOn
    ((hu.fderiv_of_isOpen hU (by norm_num)).clm_comp ha)

without_proof_info in
theorem inner_fderiv_coordinateConormalFlux {U : Set E} (hU : IsOpen U)
    {a : E → E →L[ℝ] E} {u : E → ℝ}
    (ha : ContDiffOn ℝ 1 a U) (hu : ContDiffOn ℝ 2 u U) {x : E} (hx : x ∈ U)
    (v w : E) :
    ⟪v, fderiv ℝ (coordinateConormalFlux a u) x w⟫_ℝ =
      fderiv ℝ (fderiv ℝ u) x w (a x v) + fderiv ℝ u x (fderiv ℝ a x w v) := by
  have hda : DifferentiableAt ℝ a x := (ha.contDiffAt (hU.mem_nhds hx)).differentiableAt one_ne_zero
  have hdu : DifferentiableAt ℝ (fderiv ℝ u) x :=
    ((hu.contDiffAt (hU.mem_nhds hx)).fderiv_right (m := 1) (by norm_num)).differentiableAt one_ne_zero
  have hflux : DifferentiableAt ℝ (coordinateConormalFlux a u) x :=
    ((coordinateConormalFlux_contDiffOn hU ha hu).contDiffAt (hU.mem_nhds hx)).differentiableAt one_ne_zero
  have heq : (fun y => ⟪v, coordinateConormalFlux a u y⟫_ℝ) =
      (fun y => fderiv ℝ u y (a y v)) := funext fun y => inner_coordinateConormalFlux a u y v
  have hinner := ((innerSL ℝ v).hasFDerivAt.comp x hflux.hasFDerivAt).fderiv
  have hinnerw := congrArg (fun L : E →L[ℝ] ℝ => L w) hinner
  change fderiv ℝ (fun y => ⟪v, coordinateConormalFlux a u y⟫_ℝ) x w =
    ⟪v, fderiv ℝ (coordinateConormalFlux a u) x w⟫_ℝ at hinnerw
  rw [heq, fderiv_clm_apply hdu (hda.clm_apply (differentiableAt_const v)),
    fderiv_clm_apply hda (differentiableAt_const v)] at hinnerw
  simpa only [add_apply, ContinuousLinearMap.comp_apply,
    fderiv_const_apply, ContinuousLinearMap.comp_zero, zero_add, ContinuousLinearMap.flip_apply,
    add_comm]
    using hinnerw.symm

without_proof_info in
theorem trace_fderiv_coordinateConormalFlux {ι : Type*} [Fintype ι]
    (basis : OrthonormalBasis ι ℝ E) {U : Set E} (hU : IsOpen U)
    {a : E → E →L[ℝ] E} {u : E → ℝ}
    (ha : ContDiffOn ℝ 1 a U) (hu : ContDiffOn ℝ 2 u U) {x : E} (hx : x ∈ U) :
    LinearMap.trace ℝ E (fderiv ℝ (coordinateConormalFlux a u) x) =
      (∑ i, fderiv ℝ (fderiv ℝ u) x (basis i) (a x (basis i))) +
        fderiv ℝ u x (∑ i, fderiv ℝ a x (basis i) (basis i)) := by
  rw [LinearMap.trace_eq_sum_inner _ basis]
  change (∑ i, ⟪basis i, fderiv ℝ (coordinateConormalFlux a u) x (basis i)⟫_ℝ) = _
  simp_rw [inner_fderiv_coordinateConormalFlux hU ha hu hx]
  simp [Finset.sum_add_distrib, map_sum]

without_proof_info in
/-- Green's identity for the actual variable-coefficient conormal field,
against a compactly supported test function in an arbitrary open set. -/
theorem integral_gradient_coordinateConormalFlux
    [MeasurableSpace E] [BorelSpace E] {μ : Measure E} [μ.IsAddHaarMeasure]
    {Ω : TopologicalSpace.Opens E} {a : E → E →L[ℝ] E} {u : E → ℝ}
    (ha : ContDiffOn ℝ 1 a Ω) (hu : ContDiffOn ℝ 2 u Ω) (φ : 𝓓(Ω, ℝ)) :
    (∫ x, ⟪∇ (φ : E → ℝ) x, coordinateConormalFlux a u x⟫_ℝ ∂μ) =
      -∫ x, φ x * LinearMap.trace ℝ E (fderiv ℝ (coordinateConormalFlux a u) x) ∂μ := by
  simpa only [smul_eq_mul] using
    (coordinateConormalFlux_contDiffOn Ω.isOpen ha hu).hasWeakFDerivOn_fderiv.integral_inner_gradient_eq_neg_integral_smul_trace φ

end ConformalPoisson

end ProofPart_CoordinateConormalFlux

/- Proof support: CoordinateFluxEquation.lean, SHA256 3e87cb4fdbd9a42112b2f451d41a0fbf412ed60470987d1ef9a71c787adba95c -/
noncomputable section ProofPart_CoordinateFluxEquation


/- Exact conversion of the selected nondivergence operator to a
divergence operator and its compensating first-order term. -/
open Set InnerProductSpace
open scoped ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def coordinateDivergenceDrift (a : V → V →L[ℝ] V) (z : V) : V :=
  ∑ i, fderiv ℝ a z (EuclideanSpace.single i 1) (EuclideanSpace.single i 1)

without_proof_info in
theorem coordinateDivergenceDrift_continuousOn {U : Set V} (hU : IsOpen U)
    {a : V → V →L[ℝ] V} (ha : ContDiffOn ℝ 1 a U) :
    ContinuousOn (coordinateDivergenceDrift a) U := by
  apply continuousOn_finsetSum Finset.univ
  intro i _
  exact ((ha.continuousOn_fderiv_of_isOpen hU le_rfl).clm_apply continuousOn_const).clm_apply
    continuousOn_const

without_proof_info in
/-- The correction has the positive sign appropriate to the selected
negative-Laplacian convention. No symmetry of the principal field is used. -/
theorem coordinateSchrodinger_eq_negative_flux_trace {U : Set V} (hU : IsOpen U)
    {a : V → V →L[ℝ] V} {u : V → ℝ}
    (ha : ContDiffOn ℝ 1 a U) (hu : ContDiffOn ℝ 2 u U)
    (b : V → V) (q : V → ℝ) {x : V} (hx : x ∈ U) :
    coordinateSchrodinger a b q u x =
      -LinearMap.trace ℝ V (fderiv ℝ (coordinateConormalFlux a u) x) +
        fderiv ℝ u x (b x + coordinateDivergenceDrift a x) + q x * u x := by
  have ht := trace_fderiv_coordinateConormalFlux (EuclideanSpace.basisFun (Fin d) ℝ) hU ha hu hx
  simp only [EuclideanSpace.basisFun_apply] at ht
  simp only [coordinateSchrodinger, coordinateDivergenceDrift, map_add]
  linarith

without_proof_info in
theorem coordinateDivergenceDrift_contDiffOn {U : Set V} (hU : IsOpen U)
    {a : V → V →L[ℝ] V} (ha : ContDiffOn ℝ ∞ a U) :
    ContDiffOn ℝ ∞ (coordinateDivergenceDrift a) U := by
  apply ContDiffOn.sum
  intro i _
  exact ((ha.fderiv_of_isOpen hU (m := ∞) (by simp)).clm_apply contDiffOn_const).clm_apply
    contDiffOn_const

end ConformalPoisson

end ProofPart_CoordinateFluxEquation

/- Proof support: CoordinateFluxWeak.lean, SHA256 96f1f880d9999ce4f5640735f9a0d78f3573053b48dc515a89d6ee6075305f9a -/
noncomputable section ProofPart_CoordinateFluxWeak



/- The selected classical equation implies its test-function weak
identity, with the actual conormal field and compensating drift. -/
open Set MeasureTheory InnerProductSpace TauCeti
open scoped ContDiff Gradient Distributions InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem integrable_inner_testGradient {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure E} {Ω : TopologicalSpace.Opens E} {V : E → E}
    (hV : LocallyIntegrableOn V Ω μ) (φ : 𝓓(Ω, ℝ)) :
    Integrable (fun x => ⟪∇ (φ : E → ℝ) x, V x⟫_ℝ) μ := by
  let Dφ : 𝓓(Ω, E →L[ℝ] ℝ) := TestFunction.fderivCLM ℝ (⊤ : ℕ∞) (⊤ : ℕ∞) φ
  have h := Dφ.integrable_bilin (ContinuousLinearMap.id ℝ (E →L[ℝ] ℝ)) hV
  simpa [Dφ, inner_gradient_left] using h

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
/-- The weak identity is proved for the original classical solution,
without replacing it by a formal jet or assuming weak compatibility. -/
theorem coordinateSchrodinger_testFunction_identity
    {μ : Measure V} [μ.IsAddHaarMeasure] {Ω : TopologicalSpace.Opens V}
    {a : V → V →L[ℝ] V} {b : V → V} {q u F : V → ℝ}
    (ha : ContDiffOn ℝ 1 a Ω) (hu : ContDiffOn ℝ 2 u Ω)
    (hb : ContinuousOn b Ω) (hq : ContinuousOn q Ω) (hF : ContinuousOn F Ω)
    (heq : ∀ x ∈ Ω, coordinateSchrodinger a b q u x = F x) (φ : 𝓓(Ω, ℝ)) :
    (∫ x, ⟪∇ (φ : V → ℝ) x, coordinateConormalFlux a u x⟫_ℝ +
      φ x * (fderiv ℝ u x (b x + coordinateDivergenceDrift a x) + q x * u x) ∂μ) =
      ∫ x, φ x * F x ∂μ := by
  let L : V → ℝ := fun x =>
    fderiv ℝ u x (b x + coordinateDivergenceDrift a x) + q x * u x
  have hL : ContinuousOn L Ω :=
    (((hu.of_le one_le_two).continuousOn_fderiv_of_isOpen Ω.isOpen le_rfl).clm_apply
      (hb.add (coordinateDivergenceDrift_continuousOn Ω.isOpen ha))).add (hq.mul hu.continuousOn)
  have htr : ∀ x ∈ Ω,
      LinearMap.trace ℝ V (fderiv ℝ (coordinateConormalFlux a u) x) = L x - F x := by
    intro x hx
    have h := coordinateSchrodinger_eq_negative_flux_trace Ω.isOpen ha hu b q hx
    rw [heq x hx] at h
    dsimp only [L]
    linarith
  have hprincipal : Integrable (fun x => ⟪∇ (φ : V → ℝ) x, coordinateConormalFlux a u x⟫_ℝ) μ :=
    integrable_inner_testGradient
      ((coordinateConormalFlux_contDiffOn Ω.isOpen ha hu).continuousOn.locallyIntegrableOn
        Ω.isOpen.measurableSet) φ
  have hLint : Integrable (fun x => φ x * L x) μ := by
    simpa only [smul_eq_mul] using φ.integrable_smul (hL.locallyIntegrableOn Ω.isOpen.measurableSet)
  have hFint : Integrable (fun x => φ x * F x) μ := by
    simpa only [smul_eq_mul] using φ.integrable_smul (hF.locallyIntegrableOn Ω.isOpen.measurableSet)
  have htrace : (fun x => φ x * LinearMap.trace ℝ V
      (fderiv ℝ (coordinateConormalFlux a u) x)) = (fun x => φ x * L x - φ x * F x) := by
    funext x
    by_cases hx : x ∈ Ω
    · rw [htr x hx]
      ring
    · simp [φ.zero_on_compl hx]
  change (∫ x, ⟪∇ (φ : V → ℝ) x, coordinateConormalFlux a u x⟫_ℝ + φ x * L x ∂μ) = _
  rw [integral_add hprincipal hLint, integral_gradient_coordinateConormalFlux ha hu φ,
    htrace, integral_sub hLint hFint]
  ring

end ConformalPoisson

end ProofPart_CoordinateFluxWeak

/- Proof support: CoordinatePrincipalMatrix.lean, SHA256 e2f7d6861f5fc06399f0bb2befbb9caa66c11f610fbf819ce26afc62ff931c10 -/
noncomputable section ProofPart_CoordinatePrincipalMatrix



/- The divergence-form matrix of the same principal field. Its rows
are the images of the coordinate basis vectors; hence no symmetry of a
is assumed and its bilinear form is inner(a eta, xi). -/
open Set InnerProductSpace TauCeti.PDE
open scoped ContDiff InnerProductSpace Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

def coordinatePrincipalMatrix (a : V →L[ℝ] V) : Matrix (Fin d) (Fin d) ℝ :=
  fun i j => a (EuclideanSpace.single i 1) j

without_proof_info in
theorem coordinatePrincipalMatrix_basis (a : V →L[ℝ] V) (i : Fin d) (ξ : V) :
    matrixBilinearForm (coordinatePrincipalMatrix a) (EuclideanSpace.single i 1) ξ =
      ⟪a (EuclideanSpace.single i 1), ξ⟫_ℝ := by
  simp [matrixBilinearForm_apply, coordinatePrincipalMatrix, Matrix.mulVec, dotProduct,
    EuclideanSpace.single, PiLp.single_apply, EuclideanSpace.inner_eq_star_dotProduct, mul_comm]

without_proof_info in
theorem coordinatePrincipalMatrix_bilinear (a : V →L[ℝ] V) (η ξ : V) :
    matrixBilinearForm (coordinatePrincipalMatrix a) η ξ = ⟪a η, ξ⟫_ℝ := by
  have hη : (∑ i, η i • EuclideanSpace.single i 1) = η := by
    simpa only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] using
      (EuclideanSpace.basisFun (Fin d) ℝ).sum_repr η
  calc
    _ = matrixBilinearForm (coordinatePrincipalMatrix a)
        (∑ i, η i • EuclideanSpace.single i 1) ξ := by rw [hη]
    _ = ∑ i, η i * matrixBilinearForm (coordinatePrincipalMatrix a)
        (EuclideanSpace.single i 1) ξ := by simp
    _ = ∑ i, η i * ⟪a (EuclideanSpace.single i 1), ξ⟫_ℝ := by
      simp only [coordinatePrincipalMatrix_basis]
    _ = ⟪a (∑ i, η i • EuclideanSpace.single i 1), ξ⟫_ℝ := by
      simp [sum_inner, map_sum, inner_smul_left]
    _ = _ := by rw [hη]

without_proof_info in
theorem coordinatePrincipalMatrix_gradient (a : V →L[ℝ] V) (u : V → ℝ) (x η : V) :
    matrixBilinearForm (coordinatePrincipalMatrix a) η (∇ u x) = fderiv ℝ u x (a η) := by
  rw [coordinatePrincipalMatrix_bilinear, real_inner_comm, inner_gradient_left]

end ConformalPoisson

end ProofPart_CoordinatePrincipalMatrix

/- Proof support: H2CoordinateClassical.lean, SHA256 7a802112d4e7bce5af2a5a9e56494522091cafc74cdf20d5e613030fdaed02c4 -/
noncomputable section ProofPart_H2CoordinateClassical




/- Readback of the bounded H2 operator on an actual C2 representative.
The gradient/Hessian identification uses the same Riesz calculation as
TauCeti.Analysis.InnerProductSpace.Laplacian.Trace, revision
4d91513e4d30746eb1fa96658c18e051c772e55e (Apache2.0;
External/LICENSE.tauceti). Its public scalar entry is exposed here for
coefficient contractions; no Hessian compatibility is assumed. -/
open Set MeasureTheory TopologicalSpace TauCeti InnerProductSpace
open scoped ENNReal InnerProductSpace ContDiff Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}
  {ι : Type*} [Fintype ι]

without_proof_info in
theorem inner_iteratedGradientChain_one (f : E → ℝ) (x v w : E) :
    ⟪iteratedGradientChain f 1 x v, w⟫_ℝ = fderiv ℝ (fderiv ℝ f) x v w := by
  have hgrad : gradient f = (toDual ℝ E).symm.toContinuousLinearEquiv ∘ fderiv ℝ f := by
    funext y
    simp only [gradient, Function.comp_apply, LinearIsometryEquiv.coe_toContinuousLinearEquiv]
  have hD : iteratedGradientChain f 1 x =
      continuousLinearMapOfBilin (fderiv ℝ (fderiv ℝ f) x) := by
    rw [iteratedGradientChain_succ, iteratedGradientChain_zero, hgrad, continuousLinearMapOfBilin,
      ContinuousLinearEquiv.comp_fderiv]
  rw [hD, continuousLinearMapOfBilin_apply]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem h2CoefficientOperator_of_contDiffOn (e : ι → E)
    (a : ι → ι → Lp ℝ ∞ (μ.restrict Ω)) (b : ι → Lp ℝ ∞ (μ.restrict Ω))
    (q : Lp ℝ ∞ (μ.restrict Ω)) (u : Wkp μ Ω 2 2)
    {f : E → ℝ} (hf : ContDiffOn ℝ 2 f Ω)
    (hu : Wkp.value 2 u =ᵐ[μ.restrict Ω] f) :
    h2CoefficientOperator e a b q u =ᵐ[μ.restrict Ω] fun x =>
      -(∑ i, ∑ j, a i j x * fderiv ℝ (fderiv ℝ f) x (e i) (e j)) +
      (∑ i, b i x * fderiv ℝ f x (e i)) + q x * f x := by
  have hu1 : W1p.value (Wkp.firstOrder 1 u) =ᵐ[μ.restrict Ω] f := by
    rw [Wkp.value_firstOrder]
    exact hu
  have hG := W1p.gradient_ae_eq_of_contDiffOn (Wkp.firstOrder 1 u) (hf.of_le (by norm_num)) hu1
  have hH := Wkp.iteratedGradient_ae_eq_of_contDiffOn 1 u (hf.of_le (by norm_num)) hu
  filter_upwards [h2CoefficientOperator_ae e a b q u, hG, hH, hu] with x hx hGx hHx hux
  rw [hx, hGx, hHx, hux]
  simp only [inner_gradient_left]
  have hs : (∑ i, ∑ j, a i j x * ⟪iteratedGradientChain f 1 x (e i), e j⟫_ℝ) =
      ∑ i, ∑ j, a i j x * fderiv ℝ (fderiv ℝ f) x (e i) (e j) := by
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    exact congrArg (fun t : ℝ => a i j x * t) (inner_iteratedGradientChain_one f x (e i) (e j))
  rw [hs]

section Euclidean
variable {d : ℕ}

without_proof_info in
theorem coordinateSchrodinger_eq_matrix_entries
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q f : EuclideanSpace ℝ (Fin d) → ℝ) (x : EuclideanSpace ℝ (Fin d)) :
    coordinateSchrodinger a b q f x =
      -(∑ i, ∑ j, (a x (EuclideanSpace.basisFun (Fin d) ℝ i)) j *
        fderiv ℝ (fderiv ℝ f) x (EuclideanSpace.basisFun (Fin d) ℝ i)
          (EuclideanSpace.basisFun (Fin d) ℝ j)) +
      (∑ i, b x i * fderiv ℝ f x (EuclideanSpace.basisFun (Fin d) ℝ i)) + q x * f x := by
  let e := fun i : Fin d => EuclideanSpace.single i (1 : ℝ)
  have hrepr (v : EuclideanSpace ℝ (Fin d)) : v = ∑ i, v i • e i := by
    symm
    simpa only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply, e] using
      (EuclideanSpace.basisFun (Fin d) ℝ).sum_repr v
  have hfirst : fderiv ℝ f x (b x) = ∑ i, b x i * fderiv ℝ f x (e i) := by
    conv_lhs => rw [hrepr (b x)]
    simp only [map_sum, map_smul, smul_eq_mul]
  have hsecond (i : Fin d) : fderiv ℝ (fderiv ℝ f) x (e i) (a x (e i)) =
      ∑ j, (a x (e i)) j * fderiv ℝ (fderiv ℝ f) x (e i) (e j) := by
    conv_lhs => rw [hrepr (a x (e i))]
    simp only [map_sum, map_smul, smul_eq_mul]
  simp only [coordinateSchrodinger, EuclideanSpace.basisFun_apply]
  rw [hfirst]
  exact congrArg (fun t : ℝ => -t + (∑ i, b x i * fderiv ℝ f x (e i)) + q x * f x)
    (Finset.sum_congr rfl fun i _ => hsecond i)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem h2CoefficientOperator_coordinateSchrodinger
    {ν : Measure (EuclideanSpace ℝ (Fin d))} [ν.IsAddHaarMeasure]
    {U : Opens (EuclideanSpace ℝ (Fin d))}
    (A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (Q : EuclideanSpace ℝ (Fin d) → ℝ)
    (a : Fin d → Fin d → Lp ℝ ∞ (ν.restrict U))
    (b : Fin d → Lp ℝ ∞ (ν.restrict U)) (q : Lp ℝ ∞ (ν.restrict U))
    (ha : ∀ i j, a i j =ᵐ[ν.restrict U] fun x => (A x (EuclideanSpace.basisFun (Fin d) ℝ i)) j)
    (hb : ∀ i, b i =ᵐ[ν.restrict U] fun x => B x i) (hq : q =ᵐ[ν.restrict U] Q)
    (u : Wkp ν U 2 2) {f : EuclideanSpace ℝ (Fin d) → ℝ}
    (hf : ContDiffOn ℝ 2 f U) (hu : Wkp.value 2 u =ᵐ[ν.restrict U] f) :
    h2CoefficientOperator (EuclideanSpace.basisFun (Fin d) ℝ) a b q u =ᵐ[ν.restrict U]
      coordinateSchrodinger A B Q f := by
  have hAall : ∀ᵐ x ∂ν.restrict U, ∀ i j,
      a i j x = (A x (EuclideanSpace.basisFun (Fin d) ℝ i)) j :=
    ae_all_iff.mpr fun i => ae_all_iff.mpr (ha i)
  have hBall : ∀ᵐ x ∂ν.restrict U, ∀ i, b i x = B x i := ae_all_iff.mpr hb
  filter_upwards [h2CoefficientOperator_of_contDiffOn (EuclideanSpace.basisFun (Fin d) ℝ)
    a b q u hf hu, hAall, hBall, hq] with x hx hax hbx hqx
  rw [hx, coordinateSchrodinger_eq_matrix_entries]
  simp only [hax, hbx, hqx]
end Euclidean

end ConformalPoisson

end ProofPart_H2CoordinateClassical

/- Proof support: H2CompactCoefficients.lean, SHA256 a1acfee2afe1a22615da0ac596d8fa89324646b079861af0eb2a37e45830fcef -/
noncomputable section ProofPart_H2CompactCoefficients



/- Construct bounded coefficient readings on one actual compact
chart cap. The coefficients are chosen once, before the H2 element
or smooth representative; no multiplier or operator compatibility
is assumed. Continuous potentials of either sign are allowed. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ENNReal InnerProductSpace ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [MeasurableSpace E] [BorelSpace E] {μ : Measure E} {Ω : Opens E} {K : Set E}

without_proof_info in
theorem exists_Linfty_reading_on_compact
    (hK : IsCompact K) (hΩK : (Ω : Set E) ⊆ K) {f : E → ℝ} (hf : ContinuousOn f K) :
    ∃ a : Lp ℝ ∞ (μ.restrict Ω), a =ᵐ[μ.restrict Ω] f := by
  have hm : MemLp f ∞ (μ.restrict Ω) :=
    hf.memLp_top_restrict_of_subset_isCompact hK Ω.isOpen.measurableSet hΩK
  exact ⟨hm.toLp f, hm.coeFn_toLp⟩

section Euclidean
variable {d : ℕ} {ν : Measure (EuclideanSpace ℝ (Fin d))} [ν.IsAddHaarMeasure]
  {U : Opens (EuclideanSpace ℝ (Fin d))}

/-- One shared family of coefficient readings for the actual classical operator. -/
structure H2CoordinateCoefficients
    (A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (Q : EuclideanSpace ℝ (Fin d) → ℝ) where
  principal : Fin d → Fin d → Lp ℝ ∞ (ν.restrict U)
  drift : Fin d → Lp ℝ ∞ (ν.restrict U)
  potential : Lp ℝ ∞ (ν.restrict U)
  readPrincipal : ∀ i j, principal i j =ᵐ[ν.restrict U]
    fun x => (A x (EuclideanSpace.basisFun (Fin d) ℝ i)) j
  readDrift : ∀ i, drift i =ᵐ[ν.restrict U] fun x => B x i
  readPotential : potential =ᵐ[ν.restrict U] Q

set_option maxHeartbeats 500000 in
without_proof_info in
theorem exists_h2CoordinateCoefficients_on_compact
    {L : Set (EuclideanSpace ℝ (Fin d))} (hL : IsCompact L) (hUL : (U : Set _) ⊆ L)
    (A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (Q : EuclideanSpace ℝ (Fin d) → ℝ)
    (hA : ContinuousOn A L) (hB : ContinuousOn B L) (hQ : ContinuousOn Q L) :
    Nonempty (H2CoordinateCoefficients (ν := ν) (U := U) A B Q) := by
  have ha : ∀ i j : Fin d, ∃ a : Lp ℝ ∞ (ν.restrict U),
      a =ᵐ[ν.restrict U] fun x => (A x (EuclideanSpace.basisFun (Fin d) ℝ i)) j := by
    intro i j
    apply exists_Linfty_reading_on_compact hL hUL
    exact (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin d => ℝ) j).continuous.comp_continuousOn
      (hA.clm_apply continuousOn_const)
  have hb : ∀ i : Fin d, ∃ b : Lp ℝ ∞ (ν.restrict U), b =ᵐ[ν.restrict U] fun x => B x i := by
    intro i
    apply exists_Linfty_reading_on_compact hL hUL
    exact (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin d => ℝ) i).continuous.comp_continuousOn hB
  obtain ⟨q, hq⟩ := exists_Linfty_reading_on_compact (μ := ν) hL hUL hQ
  choose a ha using ha
  choose b hb using hb
  exact ⟨⟨a, b, q, ha, hb, hq⟩⟩

variable {A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)}
  {B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)}
  {Q : EuclideanSpace ℝ (Fin d) → ℝ}

def H2CoordinateCoefficients.operator (C : H2CoordinateCoefficients (ν := ν) (U := U) A B Q) :
    Wkp ν U 2 2 →L[ℝ] Lp ℝ 2 (ν.restrict U) :=
  h2CoefficientOperator (EuclideanSpace.basisFun (Fin d) ℝ) C.principal C.drift C.potential

without_proof_info in
theorem H2CoordinateCoefficients.operator_of_contDiffOn
    (C : H2CoordinateCoefficients (ν := ν) (U := U) A B Q)
    (u : Wkp ν U 2 2) {f : EuclideanSpace ℝ (Fin d) → ℝ}
    (hf : ContDiffOn ℝ 2 f U) (hu : Wkp.value 2 u =ᵐ[ν.restrict U] f) :
    C.operator u =ᵐ[ν.restrict U] coordinateSchrodinger A B Q f :=
  h2CoefficientOperator_coordinateSchrodinger A B Q C.principal C.drift C.potential
    C.readPrincipal C.readDrift C.readPotential u hf hu
end Euclidean
end ConformalPoisson

end ProofPart_H2CompactCoefficients

/- Proof support: NativeCoordinateEnergy.lean, SHA256 a4c0694508da2774bb3bfa2c538f2b8917bb5a4e6a4545d73664ec26b63507d5 -/
noncomputable section ProofPart_NativeCoordinateEnergy






/- Exact native-to-coordinate energy identities. These supply the
pointwise algebra for the native weak Dirichlet regularity bridge. The
principal coefficient is the actual chart density times inverse metric,
and the potential is signed. -/
open Bundle Set Riemannian.Tensor TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
section GeneralModel
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]

without_proof_info in
/-- The exact native gradient inner product in an ordinary interior
chart, allowing the preferred coordinate frame to be nonorthonormal. -/
theorem inner_mgradient_eq_chart_energy (c : M) {x : M}
    (hx : x ∈ (chartAt H c).source)
    (hxi : extChartAt I c x ∈ interior (extChartAt I c).target)
    {u v : M → ℝ} (hu : MDifferentiableAt I 𝓘(ℝ) u x)
    (hv : MDifferentiableAt I 𝓘(ℝ) v x) :
    ⟪mgradient I u x, mgradient I v x⟫_ℝ =
      fderiv ℝ (u ∘ (extChartAt I c).symm) (extChartAt I c x)
        (inverseMetricOperator (Module.finBasis ℝ E) (chartInvGramMatrix (I := I) c x)
          (∇ (v ∘ (extChartAt I c).symm) (extChartAt I c x))) := by
  rw [inner_mgradient_right, mgradient_def,
    rieszDual_eq_sum_chartLocalFrame c hx]
  simp only [map_sum, map_smul, smul_eq_mul, Matrix.mulVec, dotProduct,
    chartLocalFrame_eq_symmL, mvfderiv_inverseChart_vector c hx hxi hu,
    mvfderiv_inverseChart_vector c hx hxi hv]
  simp only [inverseMetricOperator, ContinuousLinearMap.sum_apply,
    ContinuousLinearMap.smul_apply, ContinuousLinearMap.smulRight_apply,
    innerSL_apply_apply, inner_gradient_right, conj_trivial, map_sum, map_smul]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j hj
  ring
end GeneralModel

section EuclideanModel
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
local notation "V" => EuclideanSpace ℝ (Fin d)

/-- The actual divergence-form matrix for the native energy integral. -/
def chartWeightedPrincipal (c : M) (z : V) : Matrix (Fin d) (Fin d) ℝ :=
  coordinatePrincipalMatrix (chartVolumeDensity (I := I) c ((extChartAt I c).symm z) •
    chartPrincipalCoefficient (I := I) c z)

/-- The native potential multiplied by the actual chart density. -/
def chartWeightedPotential (c : M) (q : M → ℝ) (z : V) : ℝ :=
  chartVolumeDensity (I := I) c ((extChartAt I c).symm z) * q ((extChartAt I c).symm z)

without_proof_info in
theorem matrixBilinearForm_chartWeightedPrincipal (c : M) {x : M}
    (hx : x ∈ (chartAt H c).source)
    (hxi : extChartAt I c x ∈ interior (extChartAt I c).target)
    {u v : M → ℝ} (hu : MDifferentiableAt I 𝓘(ℝ) u x)
    (hv : MDifferentiableAt I 𝓘(ℝ) v x) :
    matrixBilinearForm (chartWeightedPrincipal (I := I) c (extChartAt I c x))
        (∇ (v ∘ (extChartAt I c).symm) (extChartAt I c x))
        (∇ (u ∘ (extChartAt I c).symm) (extChartAt I c x)) =
      chartVolumeDensity (I := I) c x * ⟪mgradient I u x, mgradient I v x⟫_ℝ := by
  have hround := (extChartAt I c).left_inv (show x ∈ (extChartAt I c).source by
    simpa only [extChartAt_source] using hx)
  rw [chartWeightedPrincipal, coordinatePrincipalMatrix_gradient,
    ContinuousLinearMap.smul_apply, map_smul, smul_eq_mul,
    inner_mgradient_eq_chart_energy c hx hxi hu hv]
  simp only [chartPrincipalCoefficient, hround]

without_proof_info in
/-- Pointwise equality of the complete energy densities, including the
signed zeroth-order term, with no drift in weighted divergence form. -/
theorem energyIntegrand_chartWeighted (c : M) {x : M}
    (hx : x ∈ (chartAt H c).source)
    (hxi : extChartAt I c x ∈ interior (extChartAt I c).target)
    {u v : M → ℝ} (hu : MDifferentiableAt I 𝓘(ℝ) u x)
    (hv : MDifferentiableAt I 𝓘(ℝ) v x) (q : M → ℝ) :
    energyIntegrand (chartWeightedPrincipal (I := I) c (extChartAt I c x)) 0
        (chartWeightedPotential (I := I) c q (extChartAt I c x))
        (u x, ∇ (u ∘ (extChartAt I c).symm) (extChartAt I c x))
        (v x, ∇ (v ∘ (extChartAt I c).symm) (extChartAt I c x)) =
      chartVolumeDensity (I := I) c x *
        (⟪mgradient I u x, mgradient I v x⟫_ℝ + q x * u x * v x) := by
  have hround := (extChartAt I c).left_inv (show x ∈ (extChartAt I c).source by
    simpa only [extChartAt_source] using hx)
  rw [energyIntegrand_apply, matrixBilinearForm_chartWeightedPrincipal c hx hxi hu hv]
  simp only [driftForm_apply, massForm_apply, inner_zero_left, mul_zero, zero_mul,
    add_zero, chartWeightedPotential, hround]
  ring
end EuclideanModel
end ConformalPoisson

end ProofPart_NativeCoordinateEnergy

/- Proof support: CoordinateMatrixRegularity.lean, SHA256 5ca55eb033d418c2007c4e953b12bdeb0d8fa4192821cdf431211ebb32bd7346 -/
