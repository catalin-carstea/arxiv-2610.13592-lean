/- Uniform ellipticity of the actual density-weighted chart metric on
compact relative chart subsets, including points on the model boundary. -/
open Bundle Set Riemannian.Tensor TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology InnerProductSpace Matrix.Norms.Elementwise
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
local instance ellipticityDualNormedGroup (d : ℕ) :
    NormedAddCommGroup (EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := EuclideanSpace ℝ (Fin d)) (F := ℝ)
local instance ellipticityBilinearNormedGroup (d : ℕ) :
    NormedAddCommGroup (EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := EuclideanSpace ℝ (Fin d)) (F := EuclideanSpace ℝ (Fin d) →L[ℝ] ℝ)

without_proof_info in
/-- Compactness upgrades strict pointwise positivity to the precise
uniform ellipticity interface used by the Euclidean regularity theorem. -/
theorem uniformlyEllipticOn_of_compact_positive {d : ℕ} {X : Type*}
    [TopologicalSpace X] {K : Set X} (hK : IsCompact K)
    {a : X → Matrix (Fin d) (Fin d) ℝ} (ha : ContinuousOn a K)
    (hp : ∀ x ∈ K, ∀ ξ : EuclideanSpace ℝ (Fin d), ξ ≠ 0 →
      0 < matrixBilinearForm (a x) ξ ξ) :
    ∃ lam Lam, UniformlyEllipticOn K a lam Lam := by
  have hb := ha.matrixBilinearForm
  obtain ⟨lam, hlam, hlo⟩ := hK.exists_pos_forall_mul_norm_sq_le hb hp
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn hb
  refine ⟨lam, max C lam, ?_⟩
  rw [uniformlyEllipticOn_iff]
  refine ⟨hlam, le_max_right _ _, fun x hx => ⟨?_, ?_⟩⟩
  · intro ξ
    simpa only [matrixBilinearForm_self] using hlo x hx ξ
  · intro η ξ
    rw [← matrixBilinearForm_apply, ← Real.norm_eq_abs]
    exact ((matrixBilinearForm (a x)).le_opNorm₂ η ξ).trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right ((hC x hx).trans (le_max_left _ _)) (norm_nonneg η))
        (norm_nonneg ξ))

variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
/-- Positivity holds throughout the relative target, rather than only
at interior points. It uses the same inverse-metric factorization and
the actual positive Riemannian chart density. -/
theorem chartWeightedPrincipal_positive (c : M) {z : V}
    (hz : z ∈ (extChartAt I c).target) {ξ : V} (hξ : ξ ≠ 0) :
    0 < matrixBilinearForm (chartWeightedPrincipal (I := I) c z) ξ ξ := by
  have hx := (extChartAt I c).map_target hz
  have hxs : (extChartAt I c).symm z ∈ (chartAt H c).source := by
    simpa only [extChartAt_source] using hx
  obtain ⟨C, hC⟩ := chartPrincipalCoefficient_factor (I := I) c hxs
  rw [(extChartAt I c).right_inv hz] at hC
  have hp : 0 < inner ℝ ξ (chartPrincipalCoefficient (I := I) c z ξ) := by
    rw [hC]
    exact factor_comp_adjoint_positive C hξ
  have hρ : 0 < chartVolumeDensity (I := I) c ((extChartAt I c).symm z) := by
    apply chartVolumeDensity_pos
    simpa only [TangentBundle.trivializationAt_baseSet] using hxs
  rw [chartWeightedPrincipal, coordinatePrincipalMatrix_bilinear]
  simpa only [smul_apply, real_inner_smul_left] using
    mul_pos hρ (show 0 < inner ℝ (chartPrincipalCoefficient (I := I) c z ξ) ξ by
      rwa [real_inner_comm])

without_proof_info in
/-- Each actual diagonal principal coefficient is strictly positive
on the full relative target, including the physical boundary. -/
theorem chartWeightedPrincipal_diagonal_pos (c : M) {z : V}
    (hz : z ∈ (extChartAt I c).target) (j : Fin d) :
    0 < chartWeightedPrincipal (I := I) c z j j := by
  have hξ : EuclideanSpace.basisFun (Fin d) ℝ j ≠ 0 :=
    (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.ne_zero j
  have hp := chartWeightedPrincipal_positive (I := I) c hz hξ
  have he : matrixBilinearForm (chartWeightedPrincipal (I := I) c z)
      (EuclideanSpace.basisFun (Fin d) ℝ j) (EuclideanSpace.basisFun (Fin d) ℝ j) =
      chartWeightedPrincipal (I := I) c z j j := by
    simp [matrixBilinearForm_apply, EuclideanSpace.basisFun_apply, Matrix.mulVec, dotProduct]
  rwa [he] at hp

without_proof_info in
/-- The actual weak-equation principal coefficients are uniformly
elliptic on every compact set contained in the relative chart target. -/
theorem chartWeightedPrincipal_uniformlyEllipticOn (c : M) {K : Set V}
    (hK : IsCompact K) (hKt : K ⊆ (extChartAt I c).target) :
    ∃ lam Lam, UniformlyEllipticOn K (chartWeightedPrincipal (I := I) c) lam Lam :=
  uniformlyEllipticOn_of_compact_positive hK
    ((continuousOn_chartWeightedPrincipal_target (I := I) c).mono hKt)
    (fun _ hz _ hξ => chartWeightedPrincipal_positive c (hKt hz) hξ)

section Smooth
variable [IsManifold I ∞ M]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]

without_proof_info in
/-- Smoothness of the actual principal bilinear field on the whole
relative target. The coefficient-to-bilinear-form map is the pinned
canonical continuous linear map. -/
theorem contDiffOn_chartWeightedBilinear_target (c : M) :
    ContDiffOn ℝ ∞ (fun z => matrixBilinearForm (chartWeightedPrincipal (I := I) c z))
      (extChartAt I c).target := by
  have ha : ContDiffOn ℝ ∞ (chartWeightedPrincipal (I := I) c) (extChartAt I c).target :=
    contDiffOn_pi.mpr fun i => contDiffOn_pi.mpr fun j =>
      contDiffOn_chartWeightedPrincipal_entries_target c i j
  let T : Matrix (Fin d) (Fin d) ℝ →L[ℝ] V →L[ℝ] V →L[ℝ] ℝ :=
    (matrixBilinearFormLinear (n := Fin d)).toLinearMap.toContinuousLinearMap
  have hT (A : Matrix (Fin d) (Fin d) ℝ) : T A = matrixBilinearForm A :=
    matrixBilinearFormLinear_apply A
  exact (T.contDiff.comp_contDiffOn ha).congr (fun z _ => (hT _).symm)

without_proof_info in
/-- A compact convex relative chart subset gives the boundary-inclusive
Lipschitz estimate required for weak boundary regularity. -/
theorem chartWeightedPrincipal_lipschitzOnWith (c : M) {K : Set V}
    (hK : IsCompact K) (hconv : Convex ℝ K) (hKt : K ⊆ (extChartAt I c).target) :
    ∃ C, LipschitzOnWith C
      (fun z => matrixBilinearForm (chartWeightedPrincipal (I := I) c z)) K :=
  ((contDiffOn_chartWeightedBilinear_target (I := I) c).mono hKt).exists_lipschitzOnWith
    (by simp) hconv hK
end Smooth

end ConformalPoisson

