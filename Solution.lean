    simp only [modelWithCornersEuclideanHalfSpace_toFun, EuclideanHalfSpace.boundaryParam_coe]
  have hcomp : f ∘ EuclideanHalfSpace.boundaryParam n = G ∘ euclideanHalfSpaceBoundaryParam n := by
    rw [he]
    funext y
    simp only [Function.comp_apply, modelWithCornersEuclideanHalfSpace_toFun,
      EuclideanHalfSpace.boundaryParam_coe]
  rw [hcomp, he, modelDirectionalDeriv_ambient _ _ hG.differentiableAt]
  rw [hpoint]
  have hG' : AnalyticAt ℝ G (euclideanHalfSpaceBoundaryParam n x) := hpoint ▸ hG
  have hd := hG'.differentiableAt.hasFDerivAt.comp x
    (euclideanHalfSpaceBoundaryParam n).hasFDerivAt
  exact congrArg (fun A => A v) hd.fderiv

