  have hread : (fun z : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) =ᵐ[
      volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
      fun z => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) := by
    filter_upwards [ae_restrict_mem (splitBoundaryChartCap (n := n) c R).isOpen.measurableSet] with z hz
    exact (hue _ (hmem z hz)).eq_of_nhds
