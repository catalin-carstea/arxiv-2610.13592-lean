    ∃ G : V → ℝ, HolderOnWith (K * (2 : ℝ≥0) ^ (α : ℝ)) α G {x | 0 ≤ ⟪ν, x⟫_ℝ} ∧
      EqOn F G (closedBall z r ∩ {x | 0 ≤ ⟪ν, x⟫_ℝ}) := by
  let R := centeredRadialRetraction z r
  have hmap : MapsTo R {x | 0 ≤ ⟪ν, x⟫_ℝ} (closedBall z r ∩ {x | 0 ≤ ⟪ν, x⟫_ℝ}) :=
    fun x hx => ⟨centeredRadialRetraction_mem_closedBall hr x,
      centeredRadialRetraction_mem_halfspace ν z hr hz hx⟩
  refine ⟨F ∘ R, ?_, ?_⟩
  · simpa only [mul_one] using hF.comp
      ((lipschitzWith_centeredRadialRetraction (x₀ := z) hr).holderWith.holderOnWith {x | 0 ≤ ⟪ν, x⟫_ℝ}) hmap
  · intro x hx
    change F x = F (centeredRadialRetraction z r x)
    rw [centeredRadialRetraction_of_mem_closedBall hx.1]
end ConformalPoisson

end ProofPart_HalfBallHolderExtension

/- Proof support: BilinearHolderAssembly.lean, SHA256 3c8b046bcac30c342d976465f289ac19ede42dd23554a0c8b48f7172e3eb6f94 -/
noncomputable section ProofPart_BilinearHolderAssembly



/- Finite basis assembly for actual continuous bilinear Hessians.
Scalar Holder bounds on the entries give a Holder bound in the genuine
operator norm, using the pinned matrix bilinear norm estimate. -/
open Set Metric TauCeti TauCeti.PDE InnerProductSpace Matrix
open scoped NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Bilin" => V →L[ℝ] V →L[ℝ] ℝ

without_proof_info in
theorem bilinearForm_eq_matrix_of_entries (B : Bilin) :
    matrixBilinearForm (fun i j => B (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)
      (EuclideanSpace.basisFun (Fin (n + 1)) ℝ j)) = B := by
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  have hb (i j) : matrixBilinearForm (fun k l => B (b k) (b l)) (b i) (b j) = B (b i) (b j) := by
    simp [b, EuclideanSpace.basisFun_apply]
  ext v w
  conv_lhs => rw [← b.sum_repr' v, ← b.sum_repr' w]
  conv_rhs => rw [← b.sum_repr' v, ← b.sum_repr' w]
  simp only [map_sum, map_smul, sum_apply, smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i hi
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  rw [hb]

set_option maxHeartbeats 400000 in
without_proof_info in
theorem holderOnWith_bilinear_of_entries {X : Type*} [PseudoMetricSpace X]
    {S : Set X} {H : X → Bilin} {α : ℝ≥0}
    (K : Fin (n + 1) → Fin (n + 1) → ℝ≥0)
    (hH : ∀ i j, HolderOnWith (K i j) α
      (fun x => H x (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)
        (EuclideanSpace.basisFun (Fin (n + 1)) ℝ j)) S) :
    HolderOnWith (∑ i, ∑ j, K i j) α H S := by
  apply HolderOnWith.of_dist_le
  intro x hx y hy
  rw [dist_eq_norm, ← bilinearForm_eq_matrix_of_entries (H x - H y)]
  apply (norm_matrixBilinearForm_le_sum_abs _).trans
  push_cast
  rw [Finset.sum_mul]
  apply Finset.sum_le_sum
  intro i hi
  rw [Finset.sum_mul]
  apply Finset.sum_le_sum
  intro j hj
  simpa only [sub_apply, Pi.sub_apply, Real.dist_eq] using (hH i j).dist_le hx hy
end ConformalPoisson

end ProofPart_BilinearHolderAssembly

/- Proof support: NormalHessianHolder.lean, SHA256 9b3d08427dec873d785901c560b8969cde9a4b4d6a69889dea768c26a5d633df -/
noncomputable section ProofPart_NormalHessianHolder


/- The pure normal Hessian entry follows from the trace and all
remaining entries. This is the algebraic normal recovery needed after
the tangential boundary derivative estimates. -/
open Set Metric TauCeti TauCeti.PDE InnerProductSpace Matrix
open scoped NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Bilin" => V →L[ℝ] V →L[ℝ] ℝ

without_proof_info in
/-- The finite sum estimate on an arbitrary subset, obtained by
applying the pinned Holder sum theorem to the subtype. -/
theorem holderOnWith_fintype_sum {ι X Y : Type*} [Fintype ι]
    [PseudoMetricSpace X] [SeminormedAddCommGroup Y] {S : Set X} {F : ι → X → Y}
    {K : ι → ℝ≥0} {α : ℝ≥0} (hF : ∀ i, HolderOnWith (K i) α (F i) S) :
    HolderOnWith (∑ i, K i) α (fun x => ∑ i, F i x) S := by
  have hh := HolderWith.sum (s := Finset.univ) (C := K) (r := α)
    (f := fun i (z : S) => F i z) (fun i _ => (hF i).holderWith)
  intro x hx y hy
  exact hh ⟨x, hx⟩ ⟨y, hy⟩

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_holderOnWith_bilinear_of_trace_and_off_normal {X : Type*} [PseudoMetricSpace X]
    {S : Set X} {H : X → Bilin} {α K : ℝ≥0}
    (htrace : HolderOnWith K α (fun x => ∑ i,
      H x (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)
        (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)) S)
    (hentry : ∀ i j : Fin (n + 1), i ≠ 0 ∨ j ≠ 0 → ∃ C : ℝ≥0, HolderOnWith C α
      (fun x => H x (EuclideanSpace.basisFun (Fin (n + 1)) ℝ i)
        (EuclideanSpace.basisFun (Fin (n + 1)) ℝ j)) S) :
    ∃ C : ℝ≥0, HolderOnWith C α H S := by
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  choose D hD using fun j : Fin n => hentry j.succ j.succ (Or.inl (Fin.succ_ne_zero j))
  have hsum := holderOnWith_fintype_sum hD
  have h00 : HolderOnWith (K + ∑ j, D j) α (fun x => H x (b 0) (b 0)) S := by
    convert htrace.sub hsum using 1
    funext x
    simp only [Pi.sub_apply]
    rw [Fin.sum_univ_succ]
    dsimp only [b]
    ring
  have hall : ∀ i j : Fin (n + 1), ∃ C : ℝ≥0, HolderOnWith C α (fun x => H x (b i) (b j)) S := by
    intro i j
    by_cases hi : i = 0
    · by_cases hj : j = 0
      · subst i
        subst j
        exact ⟨_, h00⟩
      · exact hentry i j (Or.inr hj)
    · exact hentry i j (Or.inl hi)
  choose C hC using hall
  exact ⟨_, holderOnWith_bilinear_of_entries C hC⟩
end ConformalPoisson

end ProofPart_NormalHessianHolder

/- Proof support: ClassicalHessianHolder.lean, SHA256 cef7cc0da8a40d8f37cf5ecceac4f4aab24fbae75c0bd2e0075657efa0be4fd6 -/
noncomputable section ProofPart_ClassicalHessianHolder




/- Actual classical Hessian Holder regularity from the tangential
derivative gradients and the Laplace equation. Symmetry recovers the
normal row; the trace recovers its normal-normal entry. -/
open Set Metric TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace Matrix
open scoped NNReal InnerProductSpace Gradient Laplacian ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem holderOnWith_inner_unit {X : Type*} [PseudoMetricSpace X] {S : Set X}
    {F : X → V} {K α : ℝ≥0} (hF : HolderOnWith K α F S) (v : V) (hv : ‖v‖ = 1) :
    HolderOnWith K α (fun x => ⟪v, F x⟫_ℝ) S := by
  apply HolderOnWith.of_dist_le
  intro x hx y hy
  calc
    dist ⟪v, F x⟫_ℝ ⟪v, F y⟫_ℝ = |⟪v, F x - F y⟫_ℝ| := by rw [Real.dist_eq, inner_sub_right]
    _ ≤ ‖v‖ * ‖F x - F y‖ := abs_real_inner_le_norm _ _
    _ = dist (F x) (F y) := by rw [hv, one_mul, dist_eq_norm]
    _ ≤ _ := hF.dist_le hx hy

without_proof_info in
theorem hessian_apply_eq_inner_gradient_directional {u : V → ℝ} {x : V}
    (hu : DifferentiableAt ℝ (fderiv ℝ u) x) (v e : V) :
    fderiv ℝ (fderiv ℝ u) x v e = ⟪v, ∇ (fun y => fderiv ℝ u y e) x⟫_ℝ := by
  rw [inner_gradient_right, conj_trivial, fderiv_clm_apply hu (differentiableAt_const e)]
  simp

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_holderOnWith_hessian_of_tangential_gradients {Ω : Opens V} {u : V → ℝ}
    (hu : ContDiffOn ℝ 2 u (Ω : Set V)) {S : Set V} (hS : S ⊆ Ω) {α : ℝ≥0}
    (hΔ : ∃ K : ℝ≥0, HolderOnWith K α (fun x => Δ u x) S)
    (htan : ∀ j : Fin n, ∃ K : ℝ≥0, HolderOnWith K α
      (fun x => ∇ (fun y => fderiv ℝ u y (EuclideanSpace.basisFun (Fin (n + 1)) ℝ j.succ)) x) S) :
    ∃ K : ℝ≥0, HolderOnWith K α (fderiv ℝ (fderiv ℝ u)) S := by
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  have hd (x : V) (hx : x ∈ S) : DifferentiableAt ℝ (fderiv ℝ u) x :=
    (((hu x (hS hx)).contDiffAt (Ω.isOpen.mem_nhds (hS hx))).fderiv_right
      (m := 1) (by norm_num)).differentiableAt (by norm_num)
  have hsym (x : V) (hx : x ∈ S) (v w : V) :
      fderiv ℝ (fderiv ℝ u) x v w = fderiv ℝ (fderiv ℝ u) x w v :=
    (((hu x (hS hx)).contDiffAt (Ω.isOpen.mem_nhds (hS hx))).isSymmSndFDerivAt (by norm_num)).eq v w
  obtain ⟨K, hK⟩ := hΔ
  have htrace : HolderOnWith K α (fun x => ∑ i, fderiv ℝ (fderiv ℝ u) x (b i) (b i)) S := by
    convert hK using 1
    funext x
    rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis u b]
    simp only [iteratedFDeriv_two_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
  apply exists_holderOnWith_bilinear_of_trace_and_off_normal htrace
  have hcolumn (i : Fin (n + 1)) (j : Fin n) : ∃ C : ℝ≥0, HolderOnWith C α
      (fun x => fderiv ℝ (fderiv ℝ u) x (b i) (b j.succ)) S := by
    obtain ⟨C, hC⟩ := htan j
    have hb : ‖b i‖ = 1 := b.norm_eq_one i
    have hc := holderOnWith_inner_unit hC (b i) hb
    refine ⟨C, ?_⟩
    intro x hx y hy
    change edist (fderiv ℝ (fderiv ℝ u) x (b i) (b j.succ))
      (fderiv ℝ (fderiv ℝ u) y (b i) (b j.succ)) ≤ _
    rw [hessian_apply_eq_inner_gradient_directional (hd x hx),
      hessian_apply_eq_inner_gradient_directional (hd y hy)]
    exact hc x hx y hy
  intro i j hij
  cases j using Fin.cases with
  | zero =>
    have hi : i ≠ 0 := hij.resolve_right (by simp)
    cases i using Fin.cases with
    | zero => exact (hi rfl).elim
    | succ i =>
      obtain ⟨C, hC⟩ := hcolumn 0 i
      refine ⟨C, ?_⟩
      intro x hx y hy
      change edist (fderiv ℝ (fderiv ℝ u) x (b i.succ) (b 0))
        (fderiv ℝ (fderiv ℝ u) y (b i.succ) (b 0)) ≤ _
      rw [hsym x hx (b i.succ) (b 0), hsym y hy (b i.succ) (b 0)]
      exact hC x hx y hy
  | succ j => exact hcolumn i j
end ConformalPoisson

end ProofPart_ClassicalHessianHolder

/- Proof support: H2TangentialExtension.lean, SHA256 ed51bc17ae68f5388f2ed46d3fd348f969ff04dc49396f1213fa04d467f8e0a6 -/
noncomputable section ProofPart_H2TangentialExtension



/- A tangential derivative of a genuine zero-Dirichlet H2 function
has a local H1 zero extension through the face. Both nested artificial
edges are handled by compact cutoffs, not by extra boundary conditions. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {Ω U B D : Opens (EuclideanSpace ℝ (Fin (n + 1)))}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_local_zeroExterior_tangential_derivative_H2
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set V) ∩ U ⊆ Ω)
    (u : W1p μ Ω 2) (W : Wkp μ Ω 2 2) (hW : Wkp.value 2 W = W1p.value u)
    (hu0 : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    (hB : IsCompact (closure (B : Set V))) (hBU : closure (B : Set V) ⊆ U)
    (hD : IsCompact (closure (D : Set V))) (hDB : closure (D : Set V) ⊆ B)
    (τ : V) (hτ : τ 0 = 0) (d : W1p μ Ω 2)
    (hd : HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value d) τ) :
    ∃ w : W1p μ D 2,
      (∀ᵐ x ∂μ.restrict (D : Set V), x ∉ euclideanOpenHalfSpace n 0 → W1p.value w x = 0) ∧
      (W1p.value w : V → ℝ) =ᵐ[μ.restrict ((D ⊓ euclideanOpenHalfSpace n 0 : Opens V) : Set V)]
        (W1p.value d : V → ℝ) := by
  have hd0 := exists_local_zeroTrace_tangential_derivative hΩH hHU u W hW hu0 hB hBU τ hτ d hd
  have hBsub : B ≤ U := fun x hx => hBU (subset_closure hx)
  have hDsub : D ≤ B := fun x hx => hDB (subset_closure hx)
  have hHBU : (euclideanOpenHalfSpace n 0 : Set V) ∩ B ⊆ (Ω ⊓ B : Opens V) :=
    fun x hx => ⟨hHU ⟨hx.1, hBsub hx.2⟩, hx.2⟩
  let dB := W1p.restrictL (inf_le_left : Ω ⊓ B ≤ Ω) d
  have hdB0 : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ B →
      ∃ v : W1p0 μ (Ω ⊓ B) 2,
        W1p.value v.val =ᵐ[μ.restrict (Ω ⊓ B : Opens V)] fun x => ψ x * W1p.value dB x := by
    intro ψ hψ hψc hψB
    exact exists_zeroTrace_restrict_cutoff d hψc hψB (hd0 ψ hψ hψc hψB)
  obtain ⟨w, hw0, hwval⟩ := exists_zeroExterior_extension_of_local_zeroTrace
    (Ω := Ω ⊓ B) (H := euclideanOpenHalfSpace n 0) (U := B) (B := D)
    (fun x hx => hΩH hx.1) inf_le_right hHBU dB hdB0 hD hDB
  refine ⟨w, hw0, hwval.trans ?_⟩
  have hDH : (D ⊓ euclideanOpenHalfSpace n 0 : Opens V) ≤ Ω ⊓ B :=
    fun x hx => hHBU ⟨hx.2, hDsub hx.1⟩
  exact ae_restrict_of_ae_restrict_of_subset hDH
    (W1p.value_restrictL_ae (inf_le_left : Ω ⊓ B ≤ Ω) d)
end ConformalPoisson

end ProofPart_H2TangentialExtension

