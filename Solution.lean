theorem tsupport_coordinatePushforward_subset_image
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (f : H → F) (hf : HasCompactSupport f) (hs : tsupport f ⊆ χ.source) :
    tsupport (coordinatePushforward χ f) ⊆ χ '' tsupport f := by
  have hc : IsCompact (χ '' tsupport f) := hf.image_of_continuousOn
    (χ.contMDiffOn_toFun.continuousOn.mono hs)
  apply closure_minimal ?_ hc.isClosed
  intro x hx
  by_contra hout
  apply hx
  by_cases hxt : x ∈ χ.target
  · rw [coordinatePushforward_target χ f hxt]
    apply image_eq_zero_of_notMem_tsupport
    intro hz
    exact hout ⟨χ.symm x, hz, χ.right_inv hxt⟩
  · exact coordinatePushforward_eq_zero_outside χ f hxt

