    (hf : HolderOnWith K α f {x | a ≤ ⟪ν, x⟫_ℝ})
    (hg : HolderOnWith K α g {x | ⟪ν, x⟫_ℝ ≤ a})
    {ζ z : V} {r : ℝ} (hr : 0 < r) (hζ : ⟪ν, ζ⟫_ℝ = a)
