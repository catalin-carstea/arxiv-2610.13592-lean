theorem exists_reference_of_piecewise_holder (ν : V) (hν : ‖ν‖ = 1)
    (f g : V → V) {K α : ℝ≥0}
    (hf : HolderOnWith K α f {x | 0 ≤ ⟪ν, x⟫_ℝ})
    (hg : HolderOnWith K α g {x | ⟪ν, x⟫_ℝ ≤ 0})
    (hmatch : ∀ ζ, ⟪ν, ζ⟫_ℝ = 0 → ⟪ν, f ζ⟫_ℝ = ⟪ν, g ζ⟫_ℝ)
    {z : V} {r : ℝ} (hr : 0 < r) (G : Lp V 2 (volume.restrict (ball z r)))
    (hG : G =ᵐ[volume.restrict (ball z r)] fun x => if 0 < ⟪ν, x⟫_ℝ then f x else g x) :
    ∃ C : Lp V 2 (volume.restrict (ball z r)),
      SobolevDivergenceFree ⟨ball z r, isOpen_ball⟩ C ∧
      (∀ᵐ x ∂volume.restrict (ball z r),
        ‖G x - C x‖ ≤ ((K : ℝ) * 2 ^ (α : ℝ)) * r ^ (α : ℝ)) := by
  by_cases hnear : |⟪ν, z⟫_ℝ| ≤ r
  · obtain ⟨hplane, hdist⟩ := unit_normal_projection ν z hν
    exact exists_reference_piecewise_holder_near_hyperplane ν 0 f g hf hg hr hplane
      (hmatch _ hplane) (hdist.trans_le hnear) G hG
  · have hfar : r < |⟪ν, z⟫_ℝ| := lt_of_not_ge hnear
    have hfactor : (K : ℝ) * r ^ (α : ℝ) ≤ ((K : ℝ) * 2 ^ (α : ℝ)) * r ^ (α : ℝ) := by
      have htwo : (1 : ℝ) ≤ 2 ^ (α : ℝ) := Real.one_le_rpow (by norm_num) α.coe_nonneg
      nlinarith [mul_nonneg K.coe_nonneg (Real.rpow_nonneg hr.le (α : ℝ)),
        mul_nonneg (mul_nonneg K.coe_nonneg (Real.rpow_nonneg hr.le (α : ℝ))) (sub_nonneg.2 htwo)]
    by_cases hz : 0 ≤ ⟪ν, z⟫_ℝ
    · rw [abs_of_nonneg hz] at hfar
      have hpos : ∀ x ∈ ball z r, 0 < ⟪ν, x⟫_ℝ := by
        intro x hx
        have hh := abs_height_sub_le_dist ν hν x z
        have hdist := mem_ball.1 hx
        linarith [neg_le_abs (⟪ν, x⟫_ℝ - ⟪ν, z⟫_ℝ)]
      have hGf : G =ᵐ[volume.restrict (ball z r)] f := by
        filter_upwards [hG, self_mem_ae_restrict measurableSet_ball] with x hx hxb
        simpa only [ite_eq_left (hpos x hxb)] using hx
      obtain ⟨C, hC, herr⟩ := exists_reference_of_holder_on_ball hr
        (hf.mono fun x hx => (hpos x hx).le) G hGf
      exact ⟨C, hC, herr.mono fun x hx => hx.trans hfactor⟩
    · have hneg := lt_of_not_ge hz
      rw [abs_of_neg hneg] at hfar
      have hnegball : ∀ x ∈ ball z r, ⟪ν, x⟫_ℝ < 0 := by
        intro x hx
        have hh := abs_height_sub_le_dist ν hν x z
        have hdist := mem_ball.1 hx
        linarith [le_abs_self (⟪ν, x⟫_ℝ - ⟪ν, z⟫_ℝ)]
      have hGg : G =ᵐ[volume.restrict (ball z r)] g := by
        filter_upwards [hG, self_mem_ae_restrict measurableSet_ball] with x hx hxb
        simpa only [ite_eq_right (not_lt_of_gt (hnegball x hxb))] using hx
      obtain ⟨C, hC, herr⟩ := exists_reference_of_holder_on_ball hr
        (hg.mono fun x hx => (hnegball x hx).le) G hGg
      exact ⟨C, hC, herr.mono fun x hx => hx.trans hfactor⟩
end ConformalPoisson

end ProofPart_FlatTransmissionReference

/- Proof support: FlatTransmissionRegularity.lean, SHA256 f9865d7fbe2ccee640d534e5781d5d799c451eacf5404b96936c892681964714 -/
noncomputable section ProofPart_FlatTransmissionRegularity



/- Holder continuity of the actual weak gradient for the flat
Laplace transmission equation with piecewise Holder divergence forcing.
Only normal continuity of the forcing is required across the plane.
No transmission regularity theorem is assumed. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped NNReal InnerProductSpace Distributions Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_holderOnWith_gradient_of_flat_transmission {Ω : Opens V}
    (u : W1p volume Ω 2) (ν : V) (hν : ‖ν‖ = 1)
    (f g : V → V) {K α : ℝ≥0} {S : Set V} {R : ℝ}
    (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R) (hS : thickening R S ⊆ Ω)
    (hf : HolderOnWith K α f {x | 0 ≤ ⟪ν, x⟫_ℝ})
    (hg : HolderOnWith K α g {x | ⟪ν, x⟫_ℝ ≤ 0})
    (hmatch : ∀ ζ, ⟪ν, ζ⟫_ℝ = 0 → ⟪ν, f ζ⟫_ℝ = ⟪ν, g ζ⟫_ℝ)
    (hF : MemLp (fun x => if 0 < ⟪ν, x⟫_ℝ then f x else g x) 2 (volume.restrict (Ω : Set V)))
    (hu : ∀ φ : 𝓓(Ω, ℝ), energyFormH1 (fun _ => 1) 0 0 u (W1p.ofTestFunctionₗ volume Ω 2 φ) =
      ∫ x in (Ω : Set V), ⟪(if 0 < ⟪ν, x⟫_ℝ then f x else g x), ∇ (φ : V → ℝ) x⟫_ℝ) :
    ∃ L : ℝ≥0, HolderOnWith L α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient u : V → V)) S := by
  apply Campanato.exists_holderOnWith_gradient_of_local_reference_error u hα hαlt hR
    (K := (K : ℝ) * 2 ^ (α : ℝ)) (by positivity) hS
  intro z hz r hr hrR hB
  have hFB := hF.mono_measure (Measure.restrict_mono (show ball z r ⊆ (Ω : Set V) from hB) le_rfl)
  let G : Lp V 2 (volume.restrict (ball z r)) := hFB.toLp _
  obtain ⟨C, hC, herr⟩ := exists_reference_of_piecewise_holder ν hν f g hf hg hmatch hr G hFB.coeFn_toLp
  refine ⟨G, C, ?_, hC, herr⟩
  intro v
  have ha : MemLp (fun _ : V => energyIntegrand (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) 0 0)
      ⊤ (volume.restrict (ball z r)) := by
    simpa using memLp_top_const (μ := volume.restrict (ball z r))
      (energyIntegrand (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) 0 0)
  have hFB0 : MemLp (fun x => (if 0 < ⟪ν, x⟫_ℝ then f x else g x) - (0 : V)) 2
      (volume.restrict (ball z r)) := by simpa only [sub_zero] using hFB
  have hto : (hFB0.toLp _ : Lp V 2 (volume.restrict (ball z r))) = G := by
    apply Lp.ext
    filter_upwards [hFB0.coeFn_toLp, hFB.coeFn_toLp] with x hx hy
    change (hFB0.toLp _ : V → V) x = (hFB.toLp _ : V → V) x
    rw [hx, hy, sub_zero]
  simpa only [hto] using forall_energyFormH1_restrictL_eq_inner hB ha hu hFB0 v

without_proof_info in
/-- A continuous classical gradient agreeing with the weak gradient
inherits its Holder bound pointwise on an open domain. -/
theorem holderOnWith_continuous_gradient_of_preciseRepresentative {Ω : Opens V}
    (u : W1p volume Ω 2) {S : Set V} (hS : S ⊆ Ω) {L α : ℝ≥0} {F : V → V}
    (hF : ContinuousOn F (Ω : Set V))
    (hgrad : (W1p.gradient u : V → V) =ᵐ[volume.restrict (Ω : Set V)] F)
    (hholder : HolderOnWith L α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient u : V → V)) S) :
    HolderOnWith L α F S := by
  have heq := TauCeti.MeasureTheory.eqOn_preciseRepresentative_of_continuousOn Ω.isOpen
    (MeasureTheory.Lp.locallyIntegrableOn (W1p.gradient u) one_le_two) hgrad hF
  intro x hx y hy
  rw [← heq (hS hx), ← heq (hS hy)]
  exact hholder x hx y hy
end ConformalPoisson

end ProofPart_FlatTransmissionRegularity

/- Proof support: ReflectedForcingHolder.lean, SHA256 6152a1cea85977d85b86c142825eea7024742cb1cc99269953ea2fa6e0dd56c3 -/
noncomputable section ProofPart_ReflectedForcingHolder


/- The divergence forcing associated with odd Dirichlet reflection
is F on one side and -R(F(Rx)) on the other. The normal components
match automatically, although the tangential components generally jump.
This verifies the actual forcing geometry of the transmission caller. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped NNReal InnerProductSpace Distributions Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def reflectedDivergenceForcing (ν : V) (F : V → V) : V → V :=
  fun x => if 0 < ⟪ν, x⟫_ℝ then F x else -(hyperplaneReflection ν 0 (F (hyperplaneReflection ν 0 x)))

without_proof_info in
theorem inner_hyperplaneReflection_zero_left (ν : V) (hν : ν ≠ 0) (x : V) :
    ⟪ν, hyperplaneReflection ν 0 x⟫_ℝ = -⟪ν, x⟫_ℝ := by
  calc
    ⟪ν, hyperplaneReflection ν 0 x⟫_ℝ = ⟪hyperplaneReflection ν 0 x, ν⟫_ℝ := real_inner_comm _ _
    _ = -⟪x, ν⟫_ℝ := by rw [inner_hyperplaneReflection hν, mul_zero, zero_sub]
    _ = -⟪ν, x⟫_ℝ := congrArg Neg.neg (real_inner_comm _ _)

without_proof_info in
theorem holderOnWith_reflected_negative_forcing (ν : V) (hν : ν ≠ 0)
    (F : V → V) {K α : ℝ≥0} (hF : HolderOnWith K α F {x | 0 ≤ ⟪ν, x⟫_ℝ}) :
    HolderOnWith K α
      (fun x => -(hyperplaneReflection ν 0 (F (hyperplaneReflection ν 0 x))))
      {x | ⟪ν, x⟫_ℝ ≤ 0} := by
  apply HolderOnWith.of_dist_le
  intro x hx y hy
  have hxR : 0 ≤ ⟪ν, hyperplaneReflection ν 0 x⟫_ℝ := by
    rw [inner_hyperplaneReflection_zero_left ν hν]
    exact neg_nonneg.2 hx
  have hyR : 0 ≤ ⟪ν, hyperplaneReflection ν 0 y⟫_ℝ := by
    rw [inner_hyperplaneReflection_zero_left ν hν]
    exact neg_nonneg.2 hy
  simpa only [dist_neg_neg, (hyperplaneReflection ν 0).isometry.dist_eq] using hF.dist_le hxR hyR

without_proof_info in
theorem reflected_forcing_normal_components_match (ν : V) (F : V → V)
    {ζ : V} (hζ : ⟪ν, ζ⟫_ℝ = 0) :
    ⟪ν, F ζ⟫_ℝ = ⟪ν, -(hyperplaneReflection ν 0 (F (hyperplaneReflection ν 0 ζ)))⟫_ℝ := by
  have hfix : hyperplaneReflection ν 0 ζ = ζ :=
    hyperplaneReflection_eq_self_of_inner_eq (by simpa only [real_inner_comm] using hζ)
  rw [hfix, inner_neg_hyperplaneReflection_zero]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_holderOnWith_gradient_of_reflected_forcing {Ω : Opens V}
    (u : W1p volume Ω 2) (ν : V) (hν : ‖ν‖ = 1)
    (F : V → V) {K α : ℝ≥0} {S : Set V} {R : ℝ}
    (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R) (hS : thickening R S ⊆ Ω)
    (hF : HolderOnWith K α F {x | 0 ≤ ⟪ν, x⟫_ℝ})
    (hLp : MemLp (reflectedDivergenceForcing ν F) 2 (volume.restrict (Ω : Set V)))
    (hu : ∀ φ : 𝓓(Ω, ℝ), energyFormH1 (fun _ => 1) 0 0 u (W1p.ofTestFunctionₗ volume Ω 2 φ) =
      ∫ x in (Ω : Set V), ⟪reflectedDivergenceForcing ν F x, ∇ (φ : V → ℝ) x⟫_ℝ) :
    ∃ L : ℝ≥0, HolderOnWith L α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient u : V → V)) S := by
  have hν0 : ν ≠ 0 := norm_ne_zero_iff.mp (by rw [hν]; exact one_ne_zero)
  exact exists_holderOnWith_gradient_of_flat_transmission u ν hν F
    (fun x => -(hyperplaneReflection ν 0 (F (hyperplaneReflection ν 0 x)))) hα hαlt hR hS hF
    (holderOnWith_reflected_negative_forcing ν hν0 F hF)
    (fun ζ hζ => reflected_forcing_normal_components_match ν F hζ) hLp hu
end ConformalPoisson

end ProofPart_ReflectedForcingHolder

/- Proof support: ReflectedGradientPairing.lean, SHA256 ae801953850405324d0ad78a795177379bf51be2d6d5014f4e884a6d6e9eea80 -/
noncomputable section ProofPart_ReflectedGradientPairing
/-
The change-of-variables argument below adapts the scalar value-pairing
proof in TauCeti/Analysis/Sobolev/W1p/HyperplaneReflection.lean,
W1p0.setIntegral_mul_value_restrictSubCompHyperplaneReflectionL, at
revision 4d91513e4d30746eb1fa96658c18e051c772e55e (Apache-2.0,
Copyright 2026 The Tau Ceti contributors). Here the pairing is with the
actual weak gradient, so the linear reflection also acts on the field.
The original pinned source is retained unchanged.
-/




open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped NNReal InnerProductSpace Distributions Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem setIntegral_inner_gradient_restrictSubReflection {U H : Opens V} (ν : V) (a : ℝ)
    (hH : ∀ x, x ∈ H ↔ a < ⟪x, ν⟫_ℝ)
    (hU : MapsTo (hyperplaneReflection ν a) U U) {F : V → V}
    (hF : MemLp F 2 (volume.restrict ((U ⊓ H : Opens V) : Set V)))
    (φ : W1p0 volume U 2) :
    (∫ x in ((U ⊓ H : Opens V) : Set V), ⟪F x, W1p.gradient
      (W1p0.restrictSubCompHyperplaneReflectionL ENNReal.ofNat_ne_top hH hU φ :
        W1p volume (U ⊓ H) 2) x⟫_ℝ) =
    ∫ x in (U : Set V), ⟪(H : Set V).indicator F x -
      (ℝ ∙ ν)ᗮ.reflection ((H : Set V).indicator F (hyperplaneReflection ν a x)),
      W1p.gradient (φ : W1p volume U 2) x⟫_ℝ := by
  let ρ := hyperplaneReflection ν a
  let R := (ℝ ∙ ν)ᗮ.reflection
  let g := (H : Set V).indicator F
  let v : V → V := W1p.gradient (φ : W1p volume U 2)
  have hρ : MeasurePreserving ρ (volume.restrict (U : Set V)) (volume.restrict (U : Set V)) :=
    measurePreserving_restrict_hyperplaneReflection hU U.isOpen.measurableSet
  have hHm : MeasurableSet (H : Set V) := H.isOpen.measurableSet
  have hg : MemLp g 2 (volume.restrict (U : Set V)) := by
    rw [memLp_indicator_iff_restrict hHm.nullMeasurableSet, Measure.restrict_restrict hHm,
      inter_comm]
    exact hF
  have hv : MemLp v 2 (volume.restrict (U : Set V)) := Lp.memLp _
  have hvρ := hv.comp_measurePreserving hρ
  have hRvρ := hvρ.continuousLinearMap_comp R.toContinuousLinearMap
  have hgρ := hg.comp_measurePreserving hρ
  have hRgρ := hgρ.continuousLinearMap_comp R.toContinuousLinearMap
  have hgrad : W1p.gradient
      (W1p0.restrictSubCompHyperplaneReflectionL ENNReal.ofNat_ne_top hH hU φ :
        W1p volume (U ⊓ H) 2) =ᵐ[volume.restrict ((U ⊓ H : Opens V) : Set V)]
      fun x => v x - R (v (ρ x)) := by
    rw [W1p0.coe_restrictSubCompHyperplaneReflectionL]
    have hsub := Lp.coeFn_sub (W1p.gradient (φ : W1p volume U 2))
      (W1p.gradient (W1p.compHyperplaneReflectionL ENNReal.ofNat_ne_top ν a hU (φ : W1p volume U 2)))
    rw [← W1p.gradient_sub] at hsub
    have hcomp := W1p.gradient_compHyperplaneReflectionL_ae ENNReal.ofNat_ne_top hU
      (φ : W1p volume U 2)
    filter_upwards [W1p.gradient_restrictL_ae (inf_le_left : U ⊓ H ≤ U)
      ((φ : W1p volume U 2) - W1p.compHyperplaneReflectionL ENNReal.ofNat_ne_top ν a hU (φ : W1p volume U 2)),
      ae_restrict_of_ae_restrict_of_subset inter_subset_left hsub,
      ae_restrict_of_ae_restrict_of_subset inter_subset_left hcomp] with x h1 h2 h3
    rw [h1, h2, Pi.sub_apply, h3]
  have hflip (w z : V) : ⟪w, R z⟫_ℝ = ⟪R w, z⟫_ℝ := by
    rw [R.inner_map_eq_flip, Submodule.reflection_symm]
  have hswap : (∫ x in (U : Set V), ⟪g x, R (v (ρ x))⟫_ℝ) =
      ∫ x in (U : Set V), ⟪R (g (ρ x)), v x⟫_ℝ := by
    have h := MeasurePreserving.integral_comp hρ ρ.toHomeomorph.measurableEmbedding
      (fun x => ⟪R (g (ρ x)), v x⟫_ℝ)
    have heq : (∫ x in (U : Set V), ⟪g x, R (v (ρ x))⟫_ℝ) =
        ∫ x in (U : Set V), ⟪R (g x), v (ρ x)⟫_ℝ := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => hflip _ _
    rw [heq]
    simpa only [AffineIsometryEquiv.coe_toHomeomorph, ρ,
      hyperplaneReflection_hyperplaneReflection] using h
  calc
    _ = ∫ x in ((U ⊓ H : Opens V) : Set V), ⟪F x, v x - R (v (ρ x))⟫_ℝ := by
      apply integral_congr_ae
      filter_upwards [hgrad] with x hx
      rw [hx]
    _ = ∫ x in (U : Set V), ⟪g x, v x - R (v (ρ x))⟫_ℝ := by
      change (∫ x in (U : Set V) ∩ (H : Set V), ⟪F x, v x - R (v (ρ x))⟫_ℝ) = _
      rw [← setIntegral_indicator hHm]
      apply integral_congr_ae
      exact ae_of_all _ fun x => by
        by_cases hx : x ∈ H
        · simp only [g, indicator_of_mem hx]
        · simp only [g, indicator_of_notMem hx, inner_zero_left]
    _ = (∫ x in (U : Set V), ⟪g x, v x⟫_ℝ) -
        ∫ x in (U : Set V), ⟪R (g (ρ x)), v x⟫_ℝ := by
      rw [← hswap, ← integral_sub (hg.integrable_inner hv) (hg.integrable_inner hRvρ)]
      simp only [inner_sub_right]
    _ = ∫ x in (U : Set V), ⟪g x - R (g (ρ x)), v x⟫_ℝ := by
      rw [← integral_sub (hg.integrable_inner hv) (hRgρ.integrable_inner hv)]
      simp only [inner_sub_left]
end ConformalPoisson

