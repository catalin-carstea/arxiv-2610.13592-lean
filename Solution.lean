      have hRNR : R / 4 ^ N ≤ R := (div_le_self hR.le hpow1)
      obtain ⟨C₀, hC₀, hCprev⟩ := hprev R hR hRR₀
      obtain ⟨C₁, hC₁, hCstep⟩ := hstep (R / 4 ^ N) hRN (hRNR.trans (hRR₀.trans hR₀₁))
