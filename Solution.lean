      (hlocal x x.property)
  refine ⟨hopen.contMDiff.of_le (by decide), fun x => hopen.isInvertible_mfderiv (by decide) x, ?_⟩
  intro x
  exact (((hcω x x.property).contMDiffAt (U.isOpen.mem_nhds x.property)).comp x
