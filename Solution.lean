/- Proof support: GaugedTransitionCauchyData.lean, SHA256 5095a63f78948f46e079ef1caee3d18f1e29ec9bbb9bbb314798022738867f5a -/
noncomputable section ProofPart_GaugedTransitionCauchyData


/- ALL ORIGINAL supported data have zero actual Cauchy difference after
pullback through the SAME common-chart transition. No smaller family of
boundary tests and no equality of interior solutions is assumed. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.transition_difference_cauchy
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (hn : 2 ≤ n) (C : P.CommonCharts)
    (f : BoundaryDatum (observedPatch (n := n) V₁))
    (y : (𝓡∂ (n + 1)).boundary M₁)
    (hy : (y : M₁) ∈ (normalChartTransition C.chart₁ C.chart₂).source) :
    let J := normalChartTransition C.chart₁ C.chart₂
    let w := (P.solver₁ hn).solve f.val -
      (P.solver₂ hn).solve (f.val ∘ D.boundaryIdentification.symm) ∘ J
    w y = 0 ∧ normalDerivative D.normal₁ w y = 0 := by
  let J := normalChartTransition C.chart₁ C.chart₂
  let f₂ : BoundaryDatum (observedPatch (n := n) V₂) := transportBoundaryDatum D.boundaryIdentification D.patches_match f
  let u₁ := (P.solver₁ hn).solve f.val
  let u₂ := (P.solver₂ hn).solve f₂.val
  let w := u₁ - u₂ ∘ J
  have hu₁ := ((P.solver₁ hn).correct f.val f.property.1).1
  have hu₂ := ((P.solver₂ hn).correct f₂.val f₂.property.1).1
  have hy₁ : (y : M₁) ∈ C.chart₁.target := hy.1
  let z := C.chart₁.symm (y : M₁)
  have hz : z ∈ C.chart₁.source := C.chart₁.symm.map_source hy₁
  have hpoint : C.chart₁ z = (y : M₁) := C.chart₁.right_inv hy₁
  have hyB : C.chart₁ z ∈ (𝓡∂ (n + 1)).boundary M₁ := hpoint.symm ▸ y.property
  have hz0 := partialDiffeomorph_halfSpace_zero_of_boundary C.chart₁ hz hyB
  have hval : w y = 0 := by
    change u₁ y - u₂ (J y) = 0
    rw [← hpoint, normalChartTransition_apply C.chart₁ C.chart₂ hz]
    exact sub_eq_zero.mpr (P.commonCharts_value_equal hn C f hz hz0)
  have hEq : EqOn (w ∘ C.chart₁) (u₁ ∘ C.chart₁ - u₂ ∘ C.chart₂) C.chart₁.source := by
    intro a ha
    change u₁ (C.chart₁ a) - u₂ (J (C.chart₁ a)) = u₁ (C.chart₁ a) - u₂ (C.chart₂ a)
    rw [normalChartTransition_apply C.chart₁ C.chart₂ ha]
  have hN := normalDeriv_eq_of_eventuallyEq
    (Filter.eventuallyEq_of_mem (C.chart₁.open_source.mem_nhds hz) hEq)
  have hc₁ := hu₁.comp_contMDiffOn (C.chart₁.contMDiffOn_toFun.of_le le_top)
  have hc₂ := hu₂.comp_contMDiffOn ((C.chart₂.contMDiffOn_toFun.of_le le_top).mono
    (fun a ha => C.source_eq ▸ ha))
  have hsub := normalJet_sub_eqOn C.chart₁.open_source hc₁ hc₂ 1 hz
  have htime := P.commonCharts_time_equal hn C f hz hz0
  change normalDeriv (u₁ ∘ C.chart₁) z = normalDeriv (u₂ ∘ C.chart₂) z at htime
  have hNzero : normalDeriv (w ∘ C.chart₁) z = 0 :=
    hN.trans (hsub.trans (sub_eq_zero.mpr htime))
  have hJat := J.contMDiffOn_toFun (y : M₁) hy |>.contMDiffAt (J.open_source.mem_nhds hy)
  have hw : MDifferentiableAt (𝓡∂ (n + 1)) 𝓘(ℝ) w (y : M₁) :=
    (hu₁.contMDiffAt.sub (hu₂.contMDiffAt.comp (y : M₁) (hJat.of_le le_top))).mdifferentiableAt
      (by decide : (∞ : ℕ∞ω) ≠ 0)
  have hnormal := C.geometry₁.normalDerivative hz hz0 D.normal₁ P.normal_spec₁ w
    (hpoint.symm ▸ hw)
  have hlabel : (⟨C.chart₁ z, partialDiffeomorph_halfSpace_boundary C.chart₁ hz hz0⟩ :
      (𝓡∂ (n + 1)).boundary M₁) = y := Subtype.ext hpoint
  rw [hlabel] at hnormal
  refine ⟨hval, hnormal.trans ?_⟩
  change -normalDeriv (w ∘ C.chart₁) z = 0
  rw [hNzero, neg_zero]
end ConformalPoisson

end ProofPart_GaugedTransitionCauchyData

/- Proof support: LocalOperatorAlgebra.lean, SHA256 e1b6f2e678ad919559499ab2c0deaa0eaa4c8d01f84e25855a9820688c8287ce -/
noncomputable section ProofPart_LocalOperatorAlgebra



/- Local linearity of the actual signed-potential operator on an open
domain; functions need be smooth only where they are being compared. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem schrodinger_sub_on (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (U : TopologicalSpace.Opens M) {u v : M → ℝ}
    (hu : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u U)
    (hv : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ v U) {x : M} (hx : x ∈ U) :
    schrodinger g q (u - v) x = schrodinger g q u x - schrodinger g q v x := by
  let xU : U := ⟨x, hx⟩
  have huR : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y : U => u y) := fun y =>
    ((hu y y.property).contMDiffAt (U.isOpen.mem_nhds y.property)).comp y contMDiff_subtype_val.contMDiffAt
  have hvR : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y : U => v y) := fun y =>
    ((hv y y.property).contMDiffAt (U.isOpen.mem_nhds y.property)).comp y contMDiff_subtype_val.contMDiffAt
  have huAt := ((hu x hx).contMDiffAt (U.isOpen.mem_nhds hx)).of_le (by decide : (2 : ℕ∞ω) ≤ ∞)
  have hvAt := ((hv x hx).contMDiffAt (U.isOpen.mem_nhds hx)).of_le (by decide : (2 : ℕ∞ω) ≤ ∞)
  exact (schrodinger_restrictOpen g U q (u - v) xU (huAt.sub hvAt)).symm.trans
    ((schrodinger_sub (g.restrictOpenTangentSpace U) (fun y : U => q y) huR hvR xU).trans
      (congrArg₂ (· - ·) (schrodinger_restrictOpen g U q u xU huAt)
        (schrodinger_restrictOpen g U q v xU hvAt)))

without_proof_info in
theorem schrodinger_eq_of_potential_value_eq (g : Metric (n := n) (M := M))
    {q₁ q₂ : M → ℝ} (u : M → ℝ) (x : M) (hq : q₁ x = q₂ x) :
    schrodinger g q₁ u x = schrodinger g q₂ u x := by
  simp only [schrodinger, hq]
end ConformalPoisson

end ProofPart_LocalOperatorAlgebra

/- Proof support: GaugedTransitionEquation.lean, SHA256 e79f7b417507609029937a9b31af34d033fb70bb020de1a90475e1275a9a4a7d -/
noncomputable section ProofPart_GaugedTransitionEquation



/- Actual homogeneous equation for the ALL-original-data gauged solution
difference on the actual local-isometry source. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.transition_difference_homogeneous
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (hn : 2 ≤ n)
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ J.source)
    (hU₁ : (U : Set M₁) ⊆ P.gauge₁.neighborhood)
    (hU₂ : ∀ y ∈ U, J y ∈ P.gauge₂.neighborhood)
    (hmetric : ∀ y ∈ U, ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
      P.metric₂.inner (J y) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J y w) = P.metric₁.inner y v w)
    (f : BoundaryDatum (observedPatch (n := n) V₁)) :
    let w := (P.solver₁ hn).solve f.val -
      (P.solver₂ hn).solve (f.val ∘ D.boundaryIdentification.symm) ∘ J
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w U ∧
      ∀ y ∈ U, y ∈ (𝓡∂ (n + 1)).interior M₁ → schrodinger P.metric₁ P.potential₁ w y = 0 := by
  let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match f
  let u₁ := (P.solver₁ hn).solve f.val
  let u₂ := (P.solver₂ hn).solve f₂.val
  have hu₁ := (P.solver₁ hn).correct f.val f.property.1
  have hu₂ := (P.solver₂ hn).correct f₂.val f₂.property.1
  have hv : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (u₂ ∘ J) U := by
    intro y hy
    have hJat := (J.contMDiffOn_toFun y (hU hy)).contMDiffAt (J.open_source.mem_nhds (hU hy))
    exact (hu₂.1.contMDiffAt.comp y (hJat.of_le le_top)).contMDiffWithinAt
  refine ⟨hu₁.1.contMDiffOn.sub hv, ?_⟩
  intro y hy hyint
  have hJy := (PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J
    (hU hy)).isInteriorPoint_iff (by decide : (ω : ℕ∞ω) ≠ 0) |>.mp hyint
  have hpotential : P.potential₁ y = (P.potential₂ ∘ J) y :=
    (P.gauge₁.potential_zero y (hU₁ hy)).trans (P.gauge₂.potential_zero (J y) (hU₂ y hy)).symm
  have hsecond : schrodinger P.metric₁ P.potential₁ (u₂ ∘ J) y = 0 :=
    (schrodinger_eq_of_potential_value_eq P.metric₁ (u₂ ∘ J) y hpotential).trans
      ((schrodinger_comp_of_partial_native_isometry P.metric₁ P.metric₂ J U hU hmetric
        P.potential₂ u₂ hy (hu₂.1.contMDiffAt.of_le (by decide))).trans (hu₂.2.1 (J y) hJy))
  change schrodinger P.metric₁ P.potential₁ (u₁ - u₂ ∘ J) y = 0
  rw [schrodinger_sub_on P.metric₁ P.potential₁ U hu₁.1.contMDiffOn hv hy,
    hu₁.2.1 y hyint, hsecond, sub_self]
end ConformalPoisson

end ProofPart_GaugedTransitionEquation

/- Proof support: CauchyConnectedInterior.lean, SHA256 afcd8bbccf74d289a99c5ba4350545861ddd7d77e9999579d4908826b2b84c30 -/
noncomputable section ProofPart_CauchyConnectedInterior



/- Boundary Cauchy uniqueness plus interior continuation gives vanishing
on a FIXED domain whose interior is connected. This is the uniform-domain
step required before quantifying over all original boundary data. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem cauchy_zero_on_connected_interior
    (hBoundary : BoundaryCauchyUniquenessAssumption (n := n) (M := M))
    (hInterior : InteriorUniqueContinuationAssumption (n := n) (M := M))
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (U : TopologicalSpace.Opens M) (hconnected : IsConnected ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M))
    (x : (𝓡∂ (n + 1)).boundary M) (hx : (x : M) ∈ U)
    (w : M → ℝ) (hw : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w U)
    (hL : ∀ y ∈ U, y ∈ (𝓡∂ (n + 1)).interior M → schrodinger g q w y = 0)
    (hC : ∀ y : (𝓡∂ (n + 1)).boundary M, (y : M) ∈ U → w y = 0 ∧ normalDerivative ν w y = 0) :
    EqOn w 0 U := by
  let Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M) :=
    ⟨observedPatch (n := n) U, U.isOpen.preimage continuous_subtype_val⟩
  obtain ⟨W, hxW, _hWsub, hW⟩ := hBoundary g q hq ν hν U Γ (fun _ hy => hy) w hw hL hC x hx
  let UI : TopologicalSpace.Opens M :=
    ⟨(U : Set M) ∩ (𝓡∂ (n + 1)).interior M, U.isOpen.inter ((𝓡∂ (n + 1)).isOpen_interior one_ne_zero)⟩
  let W₀ : TopologicalSpace.Opens M := ⟨(W : Set M) ∩ UI, W.isOpen.inter UI.isOpen⟩
  have hnonempty : (W₀ : Set M).Nonempty := by
    obtain ⟨y, hyW, hyI⟩ := (dense_nativeInterior (n := n) (M := M)).inter_open_nonempty
      ((W : Set M) ∩ U) (W.isOpen.inter U.isOpen) ⟨x, hxW, hx⟩
    exact ⟨y, hyW.1, hyW.2, hyI⟩
  have hzero : EqOn w 0 UI := hInterior g q hq UI inter_subset_right hconnected w
    (hw.mono inter_subset_left) (fun y hy => hL y hy.1 hy.2) W₀ hnonempty
      inter_subset_right (fun y hy => hW hy.1)
  have hwR : Continuous (fun y : U => w y) :=
    (show ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y : U => w y) from fun y =>
      ((hw y y.property).contMDiffAt (U.isOpen.mem_nhds y.property)).comp y contMDiff_subtype_val.contMDiffAt).continuous
  have hres : (fun y : U => w y) = 0 := Continuous.ext_on (dense_nativeInterior (n := n) (M := U))
    hwR continuous_const (fun y hy => hzero ⟨y.property,
      (𝓡∂ (n + 1)).isInteriorPoint_iff_isInteriorPoint_val.mp hy⟩)
  intro y hy
  exact congrFun hres ⟨y, hy⟩
end ConformalPoisson

end ProofPart_CauchyConnectedInterior

/- Proof support: AnalyticCauchyConnectedInterior.lean, SHA256 5908766bf4c418139f1d2d3309faedd249efa72bba6bd5066d0802be3cc59923 -/
noncomputable section ProofPart_AnalyticCauchyConnectedInterior




/- Fixed-domain Cauchy uniqueness with analytic propagation of the actual
function. No assertion of unique continuation for arbitrary smooth coefficients. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem cauchy_zero_on_connected_interior_of_analytic
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (U : TopologicalSpace.Opens M) (hg : MetricAnalyticOn g U)
    (hconnected : IsConnected ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M))
    (x : (𝓡∂ (n + 1)).boundary M) (hx : (x : M) ∈ U)
    (w : M → ℝ) (hw : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w U)
    (hω : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω w
      ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M))
    (hL : ∀ y ∈ U, y ∈ (𝓡∂ (n + 1)).interior M → schrodinger g q w y = 0)
    (hC : ∀ y : (𝓡∂ (n + 1)).boundary M, (y : M) ∈ U →
      w y = 0 ∧ normalDerivative ν w y = 0) : EqOn w 0 U := by
  obtain ⟨W, hxW, _, hW⟩ := native_cauchy_local_zero_of_analytic_metric g q hq.continuous
    U hg ν hν w hw hL hC x hx
  let UI : TopologicalSpace.Opens M :=
    ⟨(U : Set M) ∩ (𝓡∂ (n + 1)).interior M,
      U.isOpen.inter ((𝓡∂ (n + 1)).isOpen_interior one_ne_zero)⟩
  let W₀ : TopologicalSpace.Opens M := W ⊓ UI
  have hnonempty : (W₀ : Set M).Nonempty := by
    obtain ⟨y, hyW, hyI⟩ := (dense_nativeInterior (n := n) (M := M)).inter_open_nonempty
      ((W : Set M) ∩ U) (W.isOpen.inter U.isOpen) ⟨x, hxW, hx⟩
    exact ⟨y, hyW.1, hyW.2, hyI⟩
  have hconn : IsPreconnected ((UI : Set M) ∩ (𝓡∂ (n + 1)).interior M) := by
    simpa only [UI, TopologicalSpace.Opens.coe_mk, inter_assoc, inter_self] using
      hconnected.isPreconnected
  have hzero : EqOn w 0 UI := native_analytic_eqOn_of_open_match UI hconn hω
    contMDiffOn_const W₀ hnonempty (fun _ hy => ⟨hy.2, hy.2.2⟩) (fun _ hy => hW hy.1)
  have hwR : Continuous (fun y : U => w y) :=
    (show ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y : U => w y) from fun y =>
      ((hw y y.property).contMDiffAt (U.isOpen.mem_nhds y.property)).comp y
        contMDiff_subtype_val.contMDiffAt).continuous
  have hres : (fun y : U => w y) = 0 := Continuous.ext_on
    (dense_nativeInterior (n := n) (M := U)) hwR continuous_const
    (fun y hy => hzero ⟨y.property,
      (𝓡∂ (n + 1)).isInteriorPoint_iff_isInteriorPoint_val.mp hy⟩)
  intro y hy
  exact congrFun hres ⟨y, hy⟩
end ConformalPoisson

end ProofPart_AnalyticCauchyConnectedInterior

/- Proof support: AnalyticGaugedSolutions.lean, SHA256 bd3764d548ec0082d74b3e7983195154df7f5b74d344cd00660252c67b8611dc -/
noncomputable section ProofPart_AnalyticGaugedSolutions



/- Analyticity of the actual gauged solution difference on the interior of
its chosen hood. Only the original analytic operator uses elliptic regularity;
the globally smooth cutoff gauges are analytic on their own neighborhoods. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.transition_difference_analytic_on_interior
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (hn : 2 ≤ n)
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ J.source)
    (hU₁ : (U : Set M₁) ⊆ P.gauge₁.neighborhood)
    (hU₂ : ∀ y ∈ U, J y ∈ P.gauge₂.neighborhood)
    (f : BoundaryDatum (observedPatch (n := n) V₁)) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      ((P.solver₁ hn).solve f.val -
        (P.solver₂ hn).solve (f.val ∘ D.boundaryIdentification.symm) ∘ J)
      ((U : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁) := by
  let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match f
  have hu₁ := D.solver₁.analyticOn_nativeInterior hReg₁ A₁.metric A₁.potential
    A₁.analytic_potential f.val f.property.1
  have hu₂ := D.solver₂.analyticOn_nativeInterior hReg₂ A₂.metric A₂.potential
    A₂.analytic_potential f₂.val f₂.property.1
  have hv₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω ((P.solver₁ hn).solve f.val)
      ((U : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁) := by
    change ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      (D.solver₁.solve f.val / P.gauge₁.multiplier) _
    exact (hu₁.mono inter_subset_right).div₀
      (P.gauge₁.analytic_local.mono (fun _ hy => hU₁ hy.1))
      (fun y _ => (P.gauge₁.positive y).ne')
  have hv₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω ((P.solver₂ hn).solve f₂.val)
      ((𝓡∂ (n + 1)).interior M₂ ∩ (P.gauge₂.neighborhood : Set M₂)) := by
    change ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      (D.solver₂.solve f₂.val / P.gauge₂.multiplier) _
    exact (hu₂.mono inter_subset_left).div₀
      (P.gauge₂.analytic_local.mono inter_subset_right)
      (fun y _ => (P.gauge₂.positive y).ne')
  have himage : MapsTo J ((U : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁)
      ((𝓡∂ (n + 1)).interior M₂ ∩ (P.gauge₂.neighborhood : Set M₂)) := by
    intro y hy
    refine ⟨?_, hU₂ y hy.1⟩
    exact (PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J
      (hU hy.1)).isInteriorPoint_iff (by decide : (ω : ℕ∞ω) ≠ 0) |>.mp hy.2
  exact hv₁.sub (hv₂.comp (J.contMDiffOn_toFun.mono (fun _ hy => hU hy.1)) himage)
end ConformalPoisson

end ProofPart_AnalyticGaugedSolutions

/- Proof support: GaugedUniformSeedCaller.lean, SHA256 efeda642b88b85aeabdf2161ee7fccb9eff0d02138f1fa824088070b95560203 -/
noncomputable section ProofPart_GaugedUniformSeedCaller




/- Uniform ALL-original-data solution identity on one fixed local-isometry
domain with connected interior. The required connected neighborhood is a
PROJECT topology obligation, not an extra analytical literature premise. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.transition_solutions_equal_on
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (hn : 2 ≤ n) (C : P.CommonCharts)
    (U : TopologicalSpace.Opens M₁)
    (hconnected : IsConnected ((U : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁)) (hx : (x : M₁) ∈ U)
    (hU : (U : Set M₁) ⊆ (normalChartTransition C.chart₁ C.chart₂).source)
    (hU₁ : (U : Set M₁) ⊆ P.gauge₁.neighborhood)
    (hU₂ : ∀ y ∈ U, normalChartTransition C.chart₁ C.chart₂ y ∈ P.gauge₂.neighborhood)
    (hmetric : ∀ y ∈ U, ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
      P.metric₂.inner (normalChartTransition C.chart₁ C.chart₂ y)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y w) =
        P.metric₁.inner y v w) :
    ∀ f : BoundaryDatum (observedPatch (n := n) V₁),
      EqOn ((P.solver₁ hn).solve f.val)
        ((P.solver₂ hn).solve (f.val ∘ D.boundaryIdentification.symm) ∘
          normalChartTransition C.chart₁ C.chart₂) U := by
  intro f
  have hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ P.potential₁ :=
    contMDiff_conformalGaugePotential A₁.smoothMetric A₁.potential P.gauge₁.multiplier
      (A₁.analytic_potential.of_le le_top) P.gauge₁.smooth P.gauge₁.positive
  have hEq := P.transition_difference_homogeneous hn (normalChartTransition C.chart₁ C.chart₂)
    U hU hU₁ hU₂ hmetric f
  have hω := P.transition_difference_analytic_on_interior hReg₁ hReg₂ hn
    (normalChartTransition C.chart₁ C.chart₂) U hU hU₁ hU₂ f
  have hgU : MetricAnalyticOn P.metric₁ U := fun y hy =>
    (P.metricAnalyticOn₁ y (hU₁ hy)).mono hU₁
  have hzero := cauchy_zero_on_connected_interior_of_analytic P.metric₁ P.potential₁ hq
    D.normal₁ P.normal_spec₁ U hgU hconnected x hx _ hEq.1 hω hEq.2
      (fun y hy => P.transition_difference_cauchy hn C f y (hU hy))
  intro y hy
  exact sub_eq_zero.mp (hzero hy)
end ConformalPoisson

end ProofPart_GaugedUniformSeedCaller

/- Proof support: LocalGaugedSeed.lean, SHA256 5f730a1698e67f55b5352efd12a6a3fa2e8e1021c040b6c9368a5304b16850da -/
noncomputable section ProofPart_LocalGaugedSeed



/- A PROJECT-produced uniform local seed: one actual analytic transition
and one fixed original-manifold hood for EVERY original supported datum. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

structure LocalGaugedSeed (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (hn : 2 ≤ n) (C : P.CommonCharts) where
  domain : TopologicalSpace.Opens M₁
  point_mem : (x : M₁) ∈ domain
  source_subset : (domain : Set M₁) ⊆ (normalChartTransition C.chart₁ C.chart₂).source
  gauge₁_subset : (domain : Set M₁) ⊆ P.gauge₁.neighborhood
  gauge₂_image : ∀ y ∈ domain, normalChartTransition C.chart₁ C.chart₂ y ∈ P.gauge₂.neighborhood
  interior_connected : IsConnected ((domain : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁)
  metric : ∀ y ∈ domain, ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
    P.metric₂.inner (normalChartTransition C.chart₁ C.chart₂ y)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y v)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y w) =
      P.metric₁.inner y v w
  boundary : ∀ y : (𝓡∂ (n + 1)).boundary M₁, (y : M₁) ∈ domain →
    normalChartTransition C.chart₁ C.chart₂ y = (D.boundaryIdentification y : M₂)
  solutions : ∀ f : BoundaryDatum (observedPatch (n := n) V₁),
    EqOn ((P.solver₁ hn).solve f.val)
      ((P.solver₂ hn).solve (f.val ∘ D.boundaryIdentification.symm) ∘ normalChartTransition C.chart₁ C.chart₂) domain

variable [T2Space M₁] [T2Space M₂] [SecondCountableTopology M₁] [SecondCountableTopology M₂]

without_proof_info in
theorem BoundaryGaugePair.nonempty_localGaugedSeed
    (hSymbol : LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (hn : 2 ≤ n) (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts) :
    Nonempty (LocalGaugedSeed P hn C) := by
  obtain ⟨U, hxU, hUsource, hUgauge₁, hUgauge₂, hUmetric, hUboundary⟩ :=
    P.exists_local_isometry hSymbol hcompact₁ hcompact₂ hconnected₁ hconnected₂ hn C
  have hz : EuclideanHalfSpace.boundaryParam n C.boundaryBase ∈ C.chart₁.source := by
    rw [C.boundaryBase_map]
    exact C.base_mem
  have hbase : C.chart₁ (EuclideanHalfSpace.boundaryParam n C.boundaryBase) = (x : M₁) := by
    rw [C.boundaryBase_map, C.base₁]
  obtain ⟨V, hxV, hVU, _hVtarget, hVconnected⟩ := exists_chart_neighborhood_connected_interior
    C.chart₁ hz U (hbase.symm ▸ hxU)
  have hxV' : (x : M₁) ∈ V := hbase ▸ hxV
  have hVsource : (V : Set M₁) ⊆ (normalChartTransition C.chart₁ C.chart₂).source :=
    fun _ hy => hUsource (hVU hy)
  have hVgauge₁ : (V : Set M₁) ⊆ P.gauge₁.neighborhood := fun _ hy => hUgauge₁ (hVU hy)
  have hVgauge₂ : ∀ y ∈ V, normalChartTransition C.chart₁ C.chart₂ y ∈ P.gauge₂.neighborhood :=
    fun y hy => hUgauge₂ y (hVU hy)
  have hVmetric := fun y (hy : y ∈ V) => hUmetric y (hVU hy)
  refine ⟨⟨V, hxV', hVsource, hVgauge₁, hVgauge₂, hVconnected, hVmetric,
    (fun y hy => hUboundary y (hVU hy)), ?_⟩⟩
  exact P.transition_solutions_equal_on hReg₁ hReg₂ hn C V hVconnected hxV'
    hVsource hVgauge₁ hVgauge₂ hVmetric
end ConformalPoisson

end ProofPart_LocalGaugedSeed

/- Proof support: LocalOriginalSeed.lean, SHA256 2b2975298ef63356722b53156531c1f7dc12fa09a9900b80a194bfcf1e9ee4a5 -/
noncomputable section ProofPart_LocalOriginalSeed


/- The SAME actual local seed for the ORIGINAL solutions, with one
positive locally analytic multiplier for EVERY original supported datum. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

def LocalGaugedSeed.multiplier (_R : LocalGaugedSeed P hn C) : M₁ → ℝ :=
  fun y => P.gauge₁.multiplier y / P.gauge₂.multiplier (normalChartTransition C.chart₁ C.chart₂ y)

without_proof_info in
theorem LocalGaugedSeed.multiplier_positive (R : LocalGaugedSeed P hn C) (y : M₁) :
    0 < R.multiplier y := div_pos (P.gauge₁.positive y) (P.gauge₂.positive _)

without_proof_info in
theorem LocalGaugedSeed.multiplier_analytic (R : LocalGaugedSeed P hn C) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω R.multiplier R.domain := by
  have h₁ := P.gauge₁.analytic_local.mono R.gauge₁_subset
  have hJ := (normalChartTransition C.chart₁ C.chart₂).contMDiffOn_toFun.mono R.source_subset
  have h₂ := P.gauge₂.analytic_local.comp hJ R.gauge₂_image
  exact h₁.div₀ h₂ (fun y _ => (P.gauge₂.positive _).ne')

without_proof_info in
theorem LocalGaugedSeed.original_solution_relation (R : LocalGaugedSeed P hn C)
    (f : BoundaryDatum (observedPatch (n := n) V₁)) (y : M₁) (hy : y ∈ R.domain) :
    D.solver₁.solve f.val y = R.multiplier y * D.solver₂.solve
      (f.val ∘ D.boundaryIdentification.symm) (normalChartTransition C.chart₁ C.chart₂ y) := by
  have h := R.solutions f hy
  change D.solver₁.solve f.val y / P.gauge₁.multiplier y = D.solver₂.solve
    (f.val ∘ D.boundaryIdentification.symm) (normalChartTransition C.chart₁ C.chart₂ y) /
      P.gauge₂.multiplier (normalChartTransition C.chart₁ C.chart₂ y) at h
  have h₁ := (P.gauge₁.positive y).ne'
  have h₂ := (P.gauge₂.positive (normalChartTransition C.chart₁ C.chart₂ y)).ne'
  change D.solver₁.solve f.val y = (P.gauge₁.multiplier y / P.gauge₂.multiplier _) * _
  field_simp at h ⊢
  nlinarith [h]

without_proof_info in
theorem LocalGaugedSeed.multiplier_boundary_one (R : LocalGaugedSeed P hn C)
    (y : (𝓡∂ (n + 1)).boundary M₁) (hy : (y : M₁) ∈ R.domain) : R.multiplier y = 1 := by
  change P.gauge₁.multiplier y / P.gauge₂.multiplier (normalChartTransition C.chart₁ C.chart₂ y) = 1
  rw [R.boundary y hy, P.gauge₁.boundary_one y, P.gauge₂.boundary_one (D.boundaryIdentification y), div_one]
end ConformalPoisson

end ProofPart_LocalOriginalSeed

/- Proof support: GaugedTransitionNormal.lean, SHA256 e8d7fe7de3eadda0c457d49826e6ae2cd88c508619e521302a996bd94cae24eb -/
noncomputable section ProofPart_GaugedTransitionNormal


/- The SAME actual transition carries the supplied outward unit normal
to its actual paired normal, including the beta boundary basepoint. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}

without_proof_info in
theorem BoundaryGaugePair.transition_boundary_normal
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts)
    (y : (𝓡∂ (n + 1)).boundary M₁)
    (hy : (y : M₁) ∈ (normalChartTransition C.chart₁ C.chart₂).source) :
    normalChartTransition C.chart₁ C.chart₂ y = (D.boundaryIdentification y : M₂) ∧
      mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y (D.normal₁ y) =
        D.normal₂ (D.boundaryIdentification y) := by
  let z := C.chart₁.symm (y : M₁)
  have hz : z ∈ C.chart₁.source := C.chart₁.symm.map_source hy.1
  have hz₂ : z ∈ C.chart₂.source := C.source_eq ▸ hz
  have hpoint : C.chart₁ z = (y : M₁) := C.chart₁.right_inv hy.1
  have hyB : C.chart₁ z ∈ (𝓡∂ (n + 1)).boundary M₁ := hpoint.symm ▸ y.property
  have hz0 := partialDiffeomorph_halfSpace_zero_of_boundary C.chart₁ hz hyB
  have hlabel₁ : (⟨C.chart₁ z, partialDiffeomorph_halfSpace_boundary C.chart₁ hz hz0⟩ :
      (𝓡∂ (n + 1)).boundary M₁) = y := Subtype.ext hpoint
  have hpoint₂ : C.chart₂ z = (D.boundaryIdentification y : M₂) :=
    (C.boundary z hz hz0 hyB).trans (congrArg (fun b : (𝓡∂ (n + 1)).boundary M₁ =>
      (D.boundaryIdentification b : M₂)) (Subtype.ext hpoint))
  have hlabel₂ : (⟨C.chart₂ z, partialDiffeomorph_halfSpace_boundary C.chart₂ hz₂ hz0⟩ :
      (𝓡∂ (n + 1)).boundary M₂) = D.boundaryIdentification y := Subtype.ext hpoint₂
  have hν₁ := C.geometry₁.normal z hz hz0 D.normal₁ P.normal_spec₁
  have hν₂ := C.geometry₂.normal z hz₂ hz0 D.normal₂ P.normal_spec₂
  rw [hlabel₁] at hν₁
  rw [hlabel₂] at hν₂
  constructor
  · rw [← hpoint, normalChartTransition_apply C.chart₁ C.chart₂ hz]
    exact hpoint₂
  · rw [hν₁, hν₂, map_neg, ← hpoint, normalChartTransition_differential C.chart₁ C.chart₂ hz hz₂]

without_proof_info in
theorem BoundaryGaugePair.transition_normalDerivative
    (P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x) (C : P.CommonCharts)
    (u : M₂ → ℝ) (hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u)
    (y : (𝓡∂ (n + 1)).boundary M₁)
    (hy : (y : M₁) ∈ (normalChartTransition C.chart₁ C.chart₂).source) :
    normalDerivative D.normal₁ (u ∘ normalChartTransition C.chart₁ C.chart₂) y =
      normalDerivative D.normal₂ u (D.boundaryIdentification y) := by
  have h := P.transition_boundary_normal C y hy
  unfold normalDerivative
  rw [mvfderiv_comp_apply_of_eq (y : M₁)
    (hu.mdifferentiableAt (by decide : (∞ : ℕ∞ω) ≠ 0))
    ((normalChartTransition C.chart₁ C.chart₂).mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) hy) h.1]
  rw [h.2]
end ConformalPoisson

end ProofPart_GaugedTransitionNormal

/- Proof support: LocalSeedNormalTrace.lean, SHA256 4c1b982f26d117803669b542ffd185d5091919680baecdf7c63b5ae0112fbc7b -/
noncomputable section ProofPart_LocalSeedNormalTrace



/- The SAME original multiplier has actual zero outward normal trace.
Differentiate its genuine product identity at the boundary point, using
only local regularity and the actual paired-gauge normal observations. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

without_proof_info in
theorem LocalGaugedSeed.multiplier_normal_zero (R : LocalGaugedSeed P hn C)
    (y : (𝓡∂ (n + 1)).boundary M₁) (hy : (y : M₁) ∈ R.domain) :
    normalDerivative D.normal₁ R.multiplier y = 0 := by
  let J := normalChartTransition C.chart₁ C.chart₂
  have hc := ((R.multiplier_analytic y hy).contMDiffAt (R.domain.isOpen.mem_nhds hy)).mdifferentiableAt
    (by decide : (ω : ℕ∞ω) ≠ 0)
  have hden := (P.gauge₂.smooth.mdifferentiableAt (by decide : (∞ : ℕ∞ω) ≠ 0)).comp (y : M₁)
    (J.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) (R.source_subset hy))
  have hprod : R.multiplier * (P.gauge₂.multiplier ∘ J) = P.gauge₁.multiplier := by
    funext a
    exact div_mul_cancel₀ _ (P.gauge₂.positive (J a)).ne'
  have hd := congrArg (fun A => A (D.normal₁ y)) (mvfderiv_mul hc hden)
  rw [hprod] at hd
  simp only [add_apply, smul_apply, smul_eq_mul] at hd
  change normalDerivative D.normal₁ P.gauge₁.multiplier y =
    R.multiplier y * normalDerivative D.normal₁ (P.gauge₂.multiplier ∘ J) y +
    P.gauge₂.multiplier (J y) * normalDerivative D.normal₁ R.multiplier y at hd
  have hdenone : P.gauge₂.multiplier (J y) = 1 := by
    rw [R.boundary y hy]
    exact P.gauge₂.boundary_one (D.boundaryIdentification y)
  have hpair : normalDerivative D.normal₁ P.gauge₁.multiplier y =
      normalDerivative D.normal₂ P.gauge₂.multiplier (D.boundaryIdentification y) :=
    P.normal_match y (R.gauge₁_subset hy) (by
      rw [← R.boundary y hy]
      exact R.gauge₂_image y hy)
  rw [R.multiplier_boundary_one y hy, hdenone,
    P.transition_normalDerivative C P.gauge₂.multiplier P.gauge₂.smooth y (R.source_subset hy),
    one_mul, one_mul, hpair] at hd
  linarith
end ConformalPoisson

end ProofPart_LocalSeedNormalTrace

/- Proof support: LocalSeedOriginalMetric.lean, SHA256 eec90ff546626afe2924baaa9bff6dbb64ea25a51e08464497ae0c7ef6417839 -/
noncomputable section ProofPart_LocalSeedOriginalMetric


/- The SAME original seed multiplier gives the actual metric identity
with constant exactly ONE, by undoing the two actual paired gauges. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

without_proof_info in
theorem scalar_metric_eq_ratio_power (a b s u v : ℝ) (ha : 0 < a) (hb : 0 < b)
    (h : b ^ s * v = a ^ s * u) : v = (a / b) ^ s * u := by
  rw [Real.div_rpow ha.le hb.le]
  have hnonzero := (Real.rpow_pos_of_pos hb s).ne'
  field_simp
  nlinarith [h]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem LocalGaugedSeed.original_metric (R : LocalGaugedSeed P hn C)
    (y : M₁) (hy : y ∈ R.domain) (v w : TangentSpace (𝓡∂ (n + 1)) y) :
    A₂.smoothMetric.inner (normalChartTransition C.chart₁ C.chart₂ y)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y v)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y w) =
      R.multiplier y ^ conformalGaugeExponent n * A₁.smoothMetric.inner y v w := by
  have h := R.metric y hy v w
  simp only [BoundaryGaugePair.metric₁, BoundaryGaugePair.metric₂, conformalGaugeMetric,
    ContMDiffRiemannianMetric.rescale_inner] at h
  exact scalar_metric_eq_ratio_power (P.gauge₁.multiplier y)
    (P.gauge₂.multiplier (normalChartTransition C.chart₁ C.chart₂ y)) (conformalGaugeExponent n)
    (A₁.smoothMetric.inner y v w)
    (A₂.smoothMetric.inner (normalChartTransition C.chart₁ C.chart₂ y)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y v)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition C.chart₁ C.chart₂) y w))
    (P.gauge₁.positive y) (P.gauge₂.positive _) h

end ConformalPoisson

end ProofPart_LocalSeedOriginalMetric

/- Proof support: LocalSeedInteriorCandidate.lean, SHA256 1e2126358c64ecc0b88c12c81779d58a36910f63078f7cab2f4dd472396c80ab -/
noncomputable section ProofPart_LocalSeedInteriorCandidate



/- The actual original local boundary seed supplies the nonempty
connected INTERIOR anchor candidate for global continuation. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

def LocalGaugedSeed.interiorDomain (R : LocalGaugedSeed P hn C) : TopologicalSpace.Opens M₁ :=
  R.domain ⊓ ⟨(𝓡∂ (n + 1)).interior M₁, (𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)⟩

def LocalGaugedSeed.interiorCandidate (R : LocalGaugedSeed P hn C) :
    OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) (R.interiorDomain : Set M₁) where
  domain := R.interiorDomain
  inside := fun _ hz => hz.2
  connected := R.interior_connected
  contains := Subset.rfl
  map := normalChartTransition C.chart₁ C.chart₂
  multiplier := R.multiplier
  continuous := (normalChartTransition C.chart₁ C.chart₂).contMDiffOn.continuousOn.mono
    (fun _ hz => R.source_subset hz.1)
  image := by
    intro z hz
    exact ((normalChartTransition C.chart₁ C.chart₂).isLocalDiffeomorphAt
      (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω (R.source_subset hz.1)).isInteriorPoint_iff
        (by decide : (ω : ℕ∞ω) ≠ 0) |>.mp hz.2
  positive := fun z _ => R.multiplier_positive z
  solutions := fun f z hz => R.original_solution_relation f z hz.1

without_proof_info in
theorem LocalGaugedSeed.interiorDomain_nonempty (R : LocalGaugedSeed P hn C) :
    (R.interiorDomain : Set M₁).Nonempty := R.interior_connected.nonempty
end ConformalPoisson

end ProofPart_LocalSeedInteriorCandidate

/- Proof support: NativeGlobalFromSeed.lean, SHA256 d6dd8e178cf40bb4d4746ba87adc4e3936372852e693a4ec7226630c035d25ff -/
noncomputable section ProofPart_NativeGlobalFromSeed



/- Produce the boundary seed from the approved symbol/UCP/analytic
inputs, then continue its SAME original data to the whole interior.
No seed or continuation proposition is retained as an input. -/
open Bundle Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

variable [CompactSpace M₂] [MeasurableSpace M₂] [BorelSpace M₂]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₂)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₂)]

local instance globalSeedBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M₂) :=
  compactSpace_nativeBoundary

variable [SecondCountableTopology M₁] [SecondCountableTopology M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_native_global_interior_from_boundary
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hBoundaryReg₁ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₁))
    (hBoundaryReg₂ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₂))
    (hGreen₂ : GreenKernelAssumption (n := n) (M := M₂))
    (hInverse₂ : ForwardInhomogeneousAssumption (n := n) (M := M₂))
    (hEstimate₂ : NormalTraceInverseEstimateAssumption (n := n) (M := M₂))
    (hSymbol : LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁))
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : (𝓡∂ (n + 1)).boundary M₁) (hx : (x : M₁) ∈ V₁) :
    ∃ P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x, ∃ C : P.CommonCharts, ∃ R : LocalGaugedSeed P hn C,
    ∃ A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) (R.interiorDomain : Set M₁),
      (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁ := by
  obtain ⟨P⟩ := nonempty_boundaryGaugePair hBoundaryReg₁ hBoundaryReg₂ A₁ A₂ V₁ V₂ D x hx
  obtain ⟨C⟩ := P.exists_commonCharts
  obtain ⟨R⟩ := P.nonempty_localGaugedSeed hSymbol hReg₁ hReg₂ hcompact₁ isCompact_univ
    hconnected₁ hconnected₂ hn C
  obtain ⟨A, hA⟩ := exists_native_global_interior_extension hSchauder hRunge₁ hReg₁ hBoundaryReg₂
    hGreen₂ hInverse₂ hEstimate₂ hRunge₂ hReg₂ hn hcompact₁
    (nativeInterior_connected hconnected₁) (nativeInterior_connected hconnected₂) A₁ A₂ V₁ V₂ D
    R.interiorCandidate R.interiorDomain_nonempty
  exact ⟨P, C, R, A, hA⟩
end ConformalPoisson

end ProofPart_NativeGlobalFromSeed

/- Proof support: SymmetricMeasurements.lean, SHA256 0659420fd5fb5262ca16f2b3de80391cc80dfd25ea12f1914cc7f1db0488a429 -/
noncomputable section ProofPart_SymmetricMeasurements



/- Reverse the ACTUAL original measurements. Every target supported
datum is transported back, so local DN equality reverses without a
new symbol or measurement premise. -/
open Set TauCeti
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {b : (𝓡∂ (n + 1)).boundary M₂}

def MatchingMeasurements.symm (D : MatchingMeasurements A₁ A₂ V₁ V₂) :
    MatchingMeasurements A₂ A₁ V₂ V₁ where
  boundaryIdentification := D.boundaryIdentification.symm
  patches_match := by
    intro z
    simpa only [Diffeomorph.apply_symm_apply] using (D.patches_match (D.boundaryIdentification.symm z)).symm
  patch_nonempty := by
    obtain ⟨a, ha⟩ := D.patch_nonempty
    exact ⟨D.boundaryIdentification a, (D.patches_match a).mp ha⟩
  solver₁ := D.solver₂
  solver₂ := D.solver₁
  normal₁ := D.normal₂
  normal₂ := D.normal₁
  normal₁_spec := D.normal₂_spec
  normal₂_spec := D.normal₁_spec
  local_DN_equal := by
    intro g y hy
    let f : BoundaryDatum (observedPatch (n := n) V₁) :=
      transportBoundaryDatum D.boundaryIdentification.symm
        (matchingBoundaryPatches_symm D.boundaryIdentification
          (Γ₁ := observedPatch (n := n) V₁) (Γ₂ := observedPatch (n := n) V₂) D.patches_match) g
    have hx : (D.boundaryIdentification.symm y : M₁) ∈ V₁ := by
      exact (D.patches_match (D.boundaryIdentification.symm y)).mpr
        (by simpa only [Diffeomorph.apply_symm_apply] using hy)
    have h := D.local_DN_equal f (D.boundaryIdentification.symm y) hx
    have hf : f.val ∘ D.boundaryIdentification.symm = g.val := by
      funext z
      change g.val (D.boundaryIdentification (D.boundaryIdentification.symm z)) = g.val z
      rw [D.boundaryIdentification.apply_symm_apply]
    rw [hf, D.boundaryIdentification.apply_symm_apply] at h
    exact h.symm
end ConformalPoisson

end ProofPart_SymmetricMeasurements

/- Proof support: NativeReverseCandidate.lean, SHA256 4fcd640646561a4f48041e519e96f1c6db973cb30d666d15d71f8b093be824a6 -/
noncomputable section ProofPart_NativeReverseCandidate




/- The ACTUAL old inverse on its whole image is an initial reversed
candidate, with reciprocal SAME multiplier and all original target data.
No reversed boundary-symbol seed is assumed or needed. -/
open Set TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {b : (𝓡∂ (n + 1)).boundary M₂}

def MatchingMeasurements.reverseCandidate
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hconn : IsConnected J.source)
    (hsource : J.source ⊆ (𝓡∂ (n + 1)).interior M₁)
    (htarget : J.target ⊆ (𝓡∂ (n + 1)).interior M₂)
    (c : M₁ → ℝ) (hc : ∀ z ∈ J.source, 0 < c z)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ J.source,
      D.solver₁.solve f.val z = c z * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J z)) :
    OpenScaledExtension
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) => D.symm.solver₁.solve g.val)
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) =>
        D.symm.solver₂.solve (g.val ∘ D.symm.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₂) ((𝓡∂ (n + 1)).interior M₁) J.target where
  domain := ⟨J.target, J.open_target⟩
  inside := htarget
  connected := by
    change IsConnected J.target
    rw [← J.toPartialEquiv.image_source_eq_target]
    exact hconn.image J J.contMDiffOn.continuousOn
  contains := Subset.rfl
  map := J.symm
  multiplier := fun z => (c (J.symm z))⁻¹
  continuous := J.symm.contMDiffOn.continuousOn
  image := fun _ hz => hsource (J.map_target hz)
  positive := fun z hz => inv_pos.mpr (hc _ (J.map_target hz))
  solutions := by
    intro g z hz
    let f : BoundaryDatum (observedPatch (n := n) V₁) :=
      transportBoundaryDatum D.symm.boundaryIdentification D.symm.patches_match g
    have hf : f.val ∘ D.boundaryIdentification.symm = g.val := by
      funext a
      change g.val (D.boundaryIdentification (D.boundaryIdentification.symm a)) = g.val a
      rw [D.boundaryIdentification.apply_symm_apply]
    have h := hrel f (J.symm z) (J.map_target hz)
    have hpoint : J (J.symm z) = z := J.right_inv hz
    rw [hpoint, hf] at h
    change D.solver₂.solve g.val z = (c (J.symm z))⁻¹ * D.solver₁.solve f.val (J.symm z)
    rw [h]
    exact (inv_mul_cancel_left₀ (hc _ (J.map_target hz)).ne' _).symm
end ConformalPoisson

end ProofPart_NativeReverseCandidate

/- Proof support: NativeReverseGlobal.lean, SHA256 8ae5cc4d52e742e14b6fd47059691fb81c1dea869d8d359135759f3993c55d06 -/
noncomputable section ProofPart_NativeReverseGlobal



/- Continue the actual old inverse from its genuine image to the
WHOLE target interior. This reuses project continuation and does not
assume a second boundary seed or reversed localized-symbol theorem. -/
open Bundle Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

variable [CompactSpace M₂] [MeasurableSpace M₂] [BorelSpace M₂]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₂)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₂)]

local instance reverseGlobalBoundaryCompact₂ : CompactSpace ((𝓡∂ (n + 1)).boundary M₂) :=
  compactSpace_nativeBoundary


variable [CompactSpace M₁] [MeasurableSpace M₁] [BorelSpace M₁]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₁)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₁)]
local instance reverseGlobalBoundaryCompact₁ : CompactSpace ((𝓡∂ (n + 1)).boundary M₁) :=
  compactSpace_nativeBoundary

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_native_reverse_global_extension
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hBoundaryReg₁ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₁))
    (hGreen₁ : GreenKernelAssumption (n := n) (M := M₁))
    (hInverse₁ : ForwardInhomogeneousAssumption (n := n) (M := M₁))
    (hEstimate₁ : NormalTraceInverseEstimateAssumption (n := n) (M := M₁))
    (hn : 2 ≤ n)
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    :
    ∃ T₀ : Set M₂, ∃ B : OpenScaledExtension
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) => D.symm.solver₁.solve g.val)
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) =>
        D.symm.solver₂.solve (g.val ∘ D.symm.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₂) ((𝓡∂ (n + 1)).interior M₁) T₀,
      (B.domain : Set M₂) = (𝓡∂ (n + 1)).interior M₂ := by
  obtain ⟨F, hFs, hFt, hFmap, _⟩ := exists_native_scaled_partialDiffeomorph hSchauder hRunge₁ hRunge₂
    hReg₁ hReg₂ hn isCompact_univ isCompact_univ hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D
    A.domain A.inside A.map A.multiplier A.continuous A.image (fun z hz => (A.positive z hz).ne') A.solutions
  have hsource : F.source ⊆ (𝓡∂ (n + 1)).interior M₁ := by rw [hFs]; exact A.inside
  have htarget : F.target ⊆ (𝓡∂ (n + 1)).interior M₂ := by
    rw [hFt]
    rintro z ⟨a, ha, rfl⟩
    exact A.image ha
  have hconn : IsConnected F.source := by rw [hFs]; exact A.connected
  have hpos : ∀ z ∈ F.source, 0 < A.multiplier z := by
    intro z hz
    exact A.positive z (by rw [hFs] at hz; exact hz)
  have hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ F.source,
      D.solver₁.solve f.val z = A.multiplier z * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (F z) := by
    intro f z hz
    rw [hFmap]
    exact A.solutions f z (by rw [hFs] at hz; exact hz)
  let B₀ := D.reverseCandidate F hconn hsource htarget A.multiplier hpos hrel
  obtain ⟨B, hB⟩ := exists_native_global_interior_extension hSchauder hRunge₂ hReg₂ hBoundaryReg₁
    hGreen₁ hInverse₁ hEstimate₁ hRunge₁ hReg₁ hn isCompact_univ
    hconnected₂ hconnected₁ A₂ A₁ V₂ V₁ D.symm B₀ B₀.connected.nonempty
  exact ⟨F.target, B, hB⟩
end ConformalPoisson

end ProofPart_NativeReverseGlobal

/- Proof support: NativeBoundaryExtension.lean, SHA256 7648108af9e989561e65cfea1d2f45f3aa32b4056bc056844ab4015da793464a -/
noncomputable section ProofPart_NativeBoundaryExtension



/- The actual interior map is extended by the GIVEN original analytic
boundary identification. Analyticity is claimed later ONLY on the
observed domain, by actual local seed agreement. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

def nativeBoundaryExtension
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (J : M₁ → M₂) : M₁ → M₂ := by
  classical
  exact fun x => if hx : x ∈ (𝓡∂ (n + 1)).interior M₁ then J x else
    (β ⟨x, by rw [← (𝓡∂ (n + 1)).compl_interior]; exact hx⟩ : M₂)

def nativeBoundaryMultiplier (c : M₁ → ℝ) : M₁ → ℝ := by
  classical
  exact fun x => if x ∈ (𝓡∂ (n + 1)).interior M₁ then c x else 1

without_proof_info in
@[simp] theorem nativeBoundaryExtension_of_interior
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (J : M₁ → M₂) {x : M₁} (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) :
    nativeBoundaryExtension β J x = J x := by
  simp only [nativeBoundaryExtension, dif_pos hx]

without_proof_info in
@[simp] theorem nativeBoundaryMultiplier_of_interior
    (c : M₁ → ℝ) {x : M₁} (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) :
    nativeBoundaryMultiplier (n := n) c x = c x := by simp only [nativeBoundaryMultiplier, if_pos hx]

without_proof_info in
@[simp] theorem nativeBoundaryExtension_boundary
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (J : M₁ → M₂) (b : (𝓡∂ (n + 1)).boundary M₁) :
    nativeBoundaryExtension β J b = (β b : M₂) := by
  have hn : (b : M₁) ∉ (𝓡∂ (n + 1)).interior M₁ :=
    fun h => Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary h b.property
  simp only [nativeBoundaryExtension, dif_neg hn]

without_proof_info in
@[simp] theorem nativeBoundaryMultiplier_boundary
    (c : M₁ → ℝ) (b : (𝓡∂ (n + 1)).boundary M₁) : nativeBoundaryMultiplier (n := n) c b = 1 := by
  have hn : (b : M₁) ∉ (𝓡∂ (n + 1)).interior M₁ :=
    fun h => Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary h b.property
  simp only [nativeBoundaryMultiplier, if_neg hn]

without_proof_info in
theorem nativeBoundaryExtension_eventuallyEq_interior
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (J : M₁ → M₂) {x : M₁} (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) :
    nativeBoundaryExtension β J =ᶠ[𝓝 x] J :=
  eventuallyEq_of_mem (((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).mem_nhds hx)
    (fun _ hy => nativeBoundaryExtension_of_interior β J hy)

without_proof_info in
theorem nativeBoundaryMultiplier_eventuallyEq_interior
    (c : M₁ → ℝ) {x : M₁} (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) :
    nativeBoundaryMultiplier (n := n) c =ᶠ[𝓝 x] c :=
  eventuallyEq_of_mem (((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).mem_nhds hx)
    (fun _ hy => nativeBoundaryMultiplier_of_interior c hy)
end ConformalPoisson

end ProofPart_NativeBoundaryExtension

/- Proof support: NativeBoundaryExtensionInverse.lean, SHA256 1b0db11fdbc1099c5809f003f4bb8160f93685c6e218e751fda30e99c7f8bd9f -/
noncomputable section ProofPart_NativeBoundaryExtensionInverse


/- The given full boundary identification and actual interior inverse
laws give actual inverse total extensions. Continuity/analyticity is
only asserted later on the observed domains. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem nativeBoundaryExtension_left_inverse
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (F : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hFs : F.source = (𝓡∂ (n + 1)).interior M₁)
    (hFt : F.target = (𝓡∂ (n + 1)).interior M₂) :
    Function.LeftInverse (nativeBoundaryExtension β.symm F.symm) (nativeBoundaryExtension β F) := by
  intro x
  rcases (𝓡∂ (n + 1)).isInteriorPoint_or_isBoundaryPoint x with hi | hb
  · have hxF : x ∈ F.source := by rw [hFs]; exact hi
    have hFx : F x ∈ (𝓡∂ (n + 1)).interior M₂ := hFt ▸ F.map_source hxF
    rw [nativeBoundaryExtension_of_interior β F hi,
      nativeBoundaryExtension_of_interior β.symm F.symm hFx]
    exact F.left_inv hxF
  · let b : (𝓡∂ (n + 1)).boundary M₁ := ⟨x, hb⟩
    have hB : nativeBoundaryExtension β F x = (β b : M₂) := nativeBoundaryExtension_boundary β F b
    rw [hB, nativeBoundaryExtension_boundary]
    exact congrArg Subtype.val (β.symm_apply_apply b)

without_proof_info in
theorem nativeBoundaryExtension_right_inverse
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (F : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hFs : F.source = (𝓡∂ (n + 1)).interior M₁)
    (hFt : F.target = (𝓡∂ (n + 1)).interior M₂) :
    Function.RightInverse (nativeBoundaryExtension β.symm F.symm) (nativeBoundaryExtension β F) :=
  nativeBoundaryExtension_left_inverse β.symm F.symm hFt hFs

without_proof_info in
theorem nativeBoundaryExtension_maps_observedDomain
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (hpatch : ∀ b : (𝓡∂ (n + 1)).boundary M₁,
      (b : M₁) ∈ V₁ ↔ (β b : M₂) ∈ V₂)
    (J : M₁ → M₂) (hJ : MapsTo J ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂)) :
    MapsTo (nativeBoundaryExtension β J) (observedDomain (𝓡∂ (n + 1)) V₁)
      (observedDomain (𝓡∂ (n + 1)) V₂) := by
  intro z hz
  change z ∈ (𝓡∂ (n + 1)).interior M₁ ∪ (V₁ : Set M₁) at hz
  change nativeBoundaryExtension β J z ∈ (𝓡∂ (n + 1)).interior M₂ ∪ (V₂ : Set M₂)
  by_cases hi : z ∈ (𝓡∂ (n + 1)).interior M₁
  · rw [nativeBoundaryExtension_of_interior β J hi]
    exact Or.inl (hJ hi)
  · have hb : z ∈ (𝓡∂ (n + 1)).boundary M₁ := by
      rw [← (𝓡∂ (n + 1)).compl_interior]
      exact hi
    let b : (𝓡∂ (n + 1)).boundary M₁ := ⟨z, hb⟩
    have hzV : z ∈ V₁ := hz.elim (fun h => False.elim (hi h)) (fun h => h)
    have hB : nativeBoundaryExtension β J z = (β b : M₂) := nativeBoundaryExtension_boundary β J b
    rw [hB]
    exact Or.inr ((hpatch b).mp hzV)
end ConformalPoisson

end ProofPart_NativeBoundaryExtensionInverse

/- Proof support: NativeObservedDiffeomorph.lean, SHA256 685711b898721f80fd072286062281515ed0cf420808feac69a51d788ba62b42 -/
noncomputable section ProofPart_NativeObservedDiffeomorph



/- Actual inverse boundary extensions and local diffeomorphism on the
observed domain give an analytic partial diffeomorphism with EXACT
observed source and target, retaining its actual forward function. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_native_observed_partialDiffeomorph
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (hpatch : ∀ b : (𝓡∂ (n + 1)).boundary M₁,
      (b : M₁) ∈ V₁ ↔ (β b : M₂) ∈ V₂)
    (F : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hFs : F.source = (𝓡∂ (n + 1)).interior M₁)
    (hFt : F.target = (𝓡∂ (n + 1)).interior M₂)
    (hne : (observedDomain (𝓡∂ (n + 1)) V₁ : Set M₁).Nonempty)
    (hlocal : ∀ z ∈ observedDomain (𝓡∂ (n + 1)) V₁,
      IsLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω (nativeBoundaryExtension β F) z) :
    ∃ E : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω,
      E.source = (observedDomain (𝓡∂ (n + 1)) V₁ : Set M₁) ∧
      E.target = (observedDomain (𝓡∂ (n + 1)) V₂ : Set M₂) ∧
      (E : M₁ → M₂) = nativeBoundaryExtension β F := by
  let O₁ := observedDomain (𝓡∂ (n + 1)) V₁
  let O₂ := observedDomain (𝓡∂ (n + 1)) V₂
  let J := nativeBoundaryExtension β F
  let K := nativeBoundaryExtension β.symm F.symm
  have hJ : MapsTo J O₁ O₂ := nativeBoundaryExtension_maps_observedDomain β V₁ V₂ hpatch F
    (fun z hz => hFt ▸ F.map_source (hFs.symm ▸ hz))
  have hpatch' : ∀ b : (𝓡∂ (n + 1)).boundary M₂,
      (b : M₂) ∈ V₂ ↔ (β.symm b : M₁) ∈ V₁ := by
    intro b
    simpa only [Diffeomorph.apply_symm_apply] using (hpatch (β.symm b)).symm
  have hK : MapsTo K O₂ O₁ := nativeBoundaryExtension_maps_observedDomain β.symm V₂ V₁ hpatch' F.symm
    (fun z hz => hFs ▸ F.map_target (hFt.symm ▸ hz))
  have hleft := nativeBoundaryExtension_left_inverse β F hFs hFt
  have hright := nativeBoundaryExtension_right_inverse β F hFs hFt
  have himage : J '' (O₁ : Set M₁) = (O₂ : Set M₂) := by
    apply Subset.antisymm
