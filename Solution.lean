  have hA' : AnalyticOnNhd ℝ A' (ball 0 R) := fun x hx => (hA _ (hmap hx)).comp (hc x)
  have hb' : AnalyticOnNhd ℝ b' (ball 0 R) := fun x hx => (hb _ (hmap hx)).comp (hc x)
  have hq' : AnalyticOnNhd ℝ q' (ball 0 R) := fun x hx => (hq _ (hmap hx)).comp (hc x)
