    ((Filter.eventuallyEq_of_mem (hW.mem_nhds hx) he).fderiv_eq (𝕜 := ℝ))

without_proof_info in
theorem boundary_normalJet_directional_eq
    {f g : EuclideanHalfSpace (n + 1) → F}
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f S)
    (hg : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω g S)
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S) (k : ℕ)
    (he : EqOn ((normalJet k f) ∘ EuclideanHalfSpace.boundaryParam n)
      ((normalJet k g) ∘ EuclideanHalfSpace.boundaryParam n) W)
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W) (v : EuclideanSpace ℝ (Fin n)) :
    normalJet k (modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v) f)
