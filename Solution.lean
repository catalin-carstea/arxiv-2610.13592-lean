    (G.measurable_on_disjoint_opens (p := p) hq hNR hp U V hUV).aestronglyMeasurable
  have hmem : ∀ x, MemLp (G.kernel x) s (nativeVolume g) := fun x =>
    (memLp_congr_ae (G.row_ae x)).mpr (Lp.memLp (K.row x))
  have hint : ∀ x, Integrable (G.kernel x) (nativeVolume g) := fun x =>
    (hmem x).integrable (Fact.out : 1 ≤ s)
