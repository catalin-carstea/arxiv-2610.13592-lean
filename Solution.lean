noncomputable section ProofPart_GreenTrace_LpL2InfinityAbsorption




/- Only the L2/Linfinity interpolation consequence needed to absorb the
lower-order errors in the native local estimates. -/
open MeasureTheory Set
open scoped ENNReal
namespace ConformalPoisson

without_proof_info in
theorem exists_rpow_product_absorption {a : ℝ} (ha : 0 < a) (ha1 : a < 1)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ C ≥ 0, ∀ x y : ℝ, 0 ≤ x → 0 ≤ y →
      x ^ a * y ^ (1 - a) ≤ ε * y + C * x := by
  let k := ε ^ ((1 - a) / a)
  have hk : 0 < k := Real.rpow_pos_of_pos hε _
  have hka : k ^ a = ε ^ (1 - a) := by
    dsimp only [k]
    rw [← Real.rpow_mul hε.le]
    congr 1
    field_simp
  refine ⟨a / k, div_nonneg ha.le hk.le, fun x y hx hy => ?_⟩
  have hscale : (x / k) ^ a * (ε * y) ^ (1 - a) = x ^ a * y ^ (1 - a) := by
    rw [Real.div_rpow hx hk.le, Real.mul_rpow hε.le hy, hka]
    field_simp [ne_of_gt (Real.rpow_pos_of_pos hε (1 - a))]
  have hAM := Real.geom_mean_le_arith_mean2_weighted ha.le (sub_nonneg.mpr ha1.le)
    (div_nonneg hx hk.le) (mul_nonneg hε.le hy) (by ring : a + (1 - a) = 1)
  rw [hscale] at hAM
  calc
    x ^ a * y ^ (1 - a) ≤ a * (x / k) + (1 - a) * (ε * y) := hAM
    _ ≤ ε * y + (a / k) * x := by
      have hnonneg : 0 ≤ a * (ε * y) := mul_nonneg ha.le (mul_nonneg hε.le hy)
      have heq : a * (x / k) = (a / k) * x := by ring
      rw [heq]
      nlinarith [hnonneg]

variable {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
  {μ : Measure α}

without_proof_info in
theorem exists_lpNorm_le_epsilon_linfty_add_l2_uniform {p : ℝ≥0∞}
    (hp : 2 < p) (hpfin : p ≠ ⊤) {ε : ℝ} (hε : 0 < ε) :
    ∃ C ≥ 0, ∀ μ : Measure α, ∀ f : α → E, MemLp f 2 μ → MemLp f ⊤ μ →
      lpNorm f p μ ≤ ε * lpNorm f ⊤ μ + C * lpNorm f 2 μ := by
  have hpReal : 2 < p.toReal := by exact_mod_cast ENNReal.toReal_strict_mono hpfin hp
  let a := 2 / p.toReal
  have ha : 0 < a := div_pos (by norm_num) (by linarith)
  have ha1 : a < 1 := (div_lt_one (by linarith)).mpr hpReal
  obtain ⟨C, hC, hprod⟩ := exists_rpow_product_absorption ha ha1 hε
  refine ⟨C, hC, fun μ f hf2 hfTop => ?_⟩
  have hθ : 1 - a ∈ Icc (0 : ℝ) 1 := ⟨by linarith, by linarith⟩
  have hexp : p⁻¹ = ENNReal.ofReal (1 - (1 - a)) * (2 : ℝ≥0∞)⁻¹ +
      ENNReal.ofReal (1 - a) * (⊤ : ℝ≥0∞)⁻¹ := by
    rw [ENNReal.inv_top, mul_zero, add_zero, sub_sub_cancel]
    apply (ENNReal.toReal_eq_toReal_iff'
      (ENNReal.inv_ne_top.mpr (ne_of_gt (lt_trans (by norm_num) hp)))
      (by finiteness)).mp
    simp only [ENNReal.toReal_inv, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal ha.le, ENNReal.toReal_ofNat]
    dsimp only [a]
    ring
  have hinterp := eLpNorm_le_eLpNorm_rpow_mul_eLpNorm_rpow hθ hexp (f := f) (μ := μ)
  have hfinite : eLpNorm f 2 μ ^ (1 - (1 - a)) * eLpNorm f ⊤ μ ^ (1 - a) ≠ ⊤ :=
    ENNReal.mul_ne_top
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) hf2.eLpNorm_ne_top)
      (ENNReal.rpow_ne_top_of_nonneg hθ.1 hfTop.eLpNorm_ne_top)
  have hreal := ENNReal.toReal_mono hfinite hinterp
  rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow, ← ENNReal.toReal_rpow] at hreal
  simp only [sub_sub_cancel, toReal_eLpNorm] at hreal
  exact hreal.trans (hprod (lpNorm f 2 μ) (lpNorm f ⊤ μ) lpNorm_nonneg lpNorm_nonneg)

without_proof_info in
theorem exists_lpNorm_le_epsilon_linfty_add_l2 {p : ℝ≥0∞}
    (hp : 2 < p) (hpfin : p ≠ ⊤) {ε : ℝ} (hε : 0 < ε) :
    ∃ C ≥ 0, ∀ f : α → E, MemLp f 2 μ → MemLp f ⊤ μ →
      lpNorm f p μ ≤ ε * lpNorm f ⊤ μ + C * lpNorm f 2 μ := by
  obtain ⟨C, hC, hbound⟩ := exists_lpNorm_le_epsilon_linfty_add_l2_uniform (α := α) (E := E) hp hpfin hε
  exact ⟨C, hC, hbound μ⟩

end ConformalPoisson

