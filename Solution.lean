/- Scale-controlled half-space interpolation from the actual component
reflection formulas. The constant precedes all cutoffs, radii and functions. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti Module
open scoped ENNReal InnerProductSpace
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "P" => WithLp 2 (ℝ × E)

without_proof_info in
theorem halfSpace_gradient_interpolation_scaled
    (hp : p ≠ (⊤ : ℝ≥0∞)) (a : ℝ) (ε : ℝ) (hε : 0 < ε)
    (u : halfSpaceW2pZeroTrace (E := E) (p := p) a) :
    ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1
      (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2))‖ ≤
      ε * ‖Wkp.iteratedGradient 1 (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2)‖ +
        (4 * (finrank ℝ P : ℝ) ^ 2 / ε) *
          ‖Wkp.value 2 (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2)‖ := by
  let v : Wkp (volume : Measure P) (normalHalfSpace a) p 2 := u
  obtain ⟨w, hw, hval, hD⟩ := exists_odd_w2p_extension_component_bounds a u
  change Wkp.restrictL (le_top : normalHalfSpace (E := E) a ≤ ⊤) 2 w = v at hw
  have hg : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
      ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 w)‖ := by
    rw [← hw]
    exact norm_gradient_restrict_w2p_le le_top w
  have hi := Wkp.norm_iteratedGradient_lowerOrder_le hp w (half_pos hε)
  have hD' := mul_le_mul_of_nonneg_left hD (half_pos hε).le
  have hval' := mul_le_mul_of_nonneg_left hval
    (show 0 ≤ (finrank ℝ P : ℝ) ^ 2 / (ε / 2) by positivity)
  calc
    ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
        (ε / 2) * ‖Wkp.iteratedGradient 1 w‖ +
