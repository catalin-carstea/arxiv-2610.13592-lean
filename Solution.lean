/-- Canonical native L2 forcing against an actual smooth zero-trace test. -/
theorem forcing_inner_smooth_eq_integral {F : M → ℝ} (hF : Continuous F)
    (v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    ⟪ContinuousMap.toLp 2 (riemannianVolume I M) ℝ ⟨F, hF⟩,
