  have hcoord : energyFormH1 (chartWeightedPrincipal (I := Ihalf) c) 0
      (chartWeightedPotential (I := Ihalf) c q) w (W1p.ofTestFunctionₗ μ Ω 2 φ) =
      ∫ z in Ω, energyIntegrand (chartWeightedPrincipal (I := Ihalf) c z) 0
        (chartWeightedPotential (I := Ihalf) c q z)
        (u ((extChartAt Ihalf c).symm z), ∇ (u ∘ (extChartAt Ihalf c).symm) z)
