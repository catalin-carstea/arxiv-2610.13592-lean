noncomputable section ProofPart_GreenTrace_BoundedOddReflection




/- A bounded odd W2p extension, using the pinned qualitative reflection theorem
and the closed graph theorem. No sharp extension constant is needed downstream. -/
open MeasureTheory Set TopologicalSpace Filter
open scoped ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
open TauCeti
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

/-- W2p functions with the actual homogeneous first-order Dirichlet condition. -/
def halfSpaceW2pZeroTrace (a : ℝ) :
    ClosedSubmodule ℝ (Wkp (volume : Measure (WithLp 2 (ℝ × E)))
      (normalHalfSpace a) p 2) :=
  (w1p0Submodule (volume : Measure (WithLp 2 (ℝ × E))) (normalHalfSpace a) p).comap
    (Wkp.firstOrderL 1)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_bounded_odd_w2p_extension_with_value_bound (a : ℝ) :
    ∃ T : halfSpaceW2pZeroTrace (E := E) (p := p) a →L[ℝ]
        Wkp (volume : Measure (WithLp 2 (ℝ × E))) ⊤ p 2,
      ∀ u, (Wkp.value 2 (T u) =ᵐ[volume] fun x =>
        (normalHalfSpace (E := E) a : Set (WithLp 2 (ℝ × E))).indicator
          (Wkp.value 2 (u : Wkp volume (normalHalfSpace a) p 2)) x -
        (normalHalfSpace (E := E) a : Set (WithLp 2 (ℝ × E))).indicator
          (Wkp.value 2 (u : Wkp volume (normalHalfSpace a) p 2))
          (normalReflection E a x)) ∧
        ‖Wkp.value 2 (T u)‖ ≤ 2 * ‖Wkp.value 2
          (u : Wkp (volume : Measure (WithLp 2 (ℝ × E))) (normalHalfSpace (E := E) a) p 2)‖ := by
  let H := normalHalfSpace (E := E) a
  let P := WithLp 2 (ℝ × E)
  let X := halfSpaceW2pZeroTrace (E := E) (p := p) a
  let Y := Wkp (volume : Measure P) ⊤ p 2
  let Z := Lp ℝ p ((volume : Measure P).restrict (Set.univ : Set P))
  have hH : MeasurableSet (H : Set P) := H.isOpen.measurableSet
  have hρ : MeasurePreserving (normalReflection E a)
      ((volume : Measure P).restrict Set.univ) (volume.restrict Set.univ) := by
    simpa using (measurePreserving_normalReflection (E := E) a).restrict_preimage
      MeasurableSet.univ
  let ext : Lp ℝ p ((volume : Measure P).restrict H) →L[ℝ] Z :=
    (extendByZeroLpₗᵢ ℝ volume hH (Set.subset_univ _)).toContinuousLinearMap
  let refl : Z →L[ℝ] Z :=
    (Lp.compMeasurePreservingₗᵢ ℝ (normalReflection E a) hρ).toContinuousLinearMap
  let A : X →L[ℝ] Z :=
    ((ContinuousLinearMap.id ℝ Z - refl).comp ext).comp
      ((Wkp.valueL 2).comp (halfSpaceW2pZeroTrace (E := E) (p := p) a).toSubmodule.subtypeL)
  let B : Y →L[ℝ] Z := Wkp.valueL 2
  have hB : Function.Injective B := by
    intro u v h
    apply Wkp.ext 2
    dsimp only [B] at h
    rw [Wkp.valueL_apply, Wkp.valueL_apply] at h
    exact h
  have hA (u : X) : A u =ᵐ[volume] fun x =>
      (H : Set P).indicator (Wkp.value 2 (u : Wkp volume H p 2)) x -
      (H : Set P).indicator (Wkp.value 2 (u : Wkp volume H p 2))
        (normalReflection E a x) := by
    let v := Wkp.value 2 (u : Wkp volume H p 2)
    have he : ext v =ᵐ[volume] (H : Set P).indicator v := by
      simpa only [ext, LinearIsometry.coe_toContinuousLinearMap, Measure.restrict_univ] using coeFn_extendByZeroLpₗᵢ ℝ hH (Set.subset_univ _) v
    have hr : refl (ext v) =ᵐ[volume] (ext v) ∘ normalReflection E a := by
      dsimp only [refl]
      simp only [LinearIsometry.coe_toContinuousLinearMap]
      rw [Lp.compMeasurePreservingₗᵢ_apply]
      simpa only [Measure.restrict_univ] using Lp.coeFn_compMeasurePreserving (ext v) hρ
    have her := (measurePreserving_normalReflection (E := E) a).quasiMeasurePreserving.ae_eq_comp he
    have hav : A u = ext v - refl (ext v) := by
      dsimp only [A, v]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.sub_apply,
        ContinuousLinearMap.id_apply]
      rw [Submodule.subtypeL_apply, Wkp.valueL_apply]
    have hs : A u =ᵐ[volume] fun x => ext v x - refl (ext v) x := by
      rw [hav]
      have hh : ∀ᵐ x ∂(volume : Measure P).restrict Set.univ,
          (ext v - refl (ext v)) x = ext v x - refl (ext v) x := by
        filter_upwards [Lp.coeFn_sub (ext v) (refl (ext v))] with x hx
        simpa only [Pi.sub_apply] using hx
      change ∀ᵐ x ∂(volume : Measure P),
        (ext v - refl (ext v)) x = ext v x - refl (ext v) x
      have hae : ae ((volume : Measure P).restrict Set.univ) = ae volume := by simp
      rw [hae] at hh
      exact hh
    filter_upwards [hs, he, hr, her] with x hs he hr her
    simp only [Function.comp_apply] at her
    rw [hs, he, hr, Function.comp_apply, her]
  have hex : ∀ u : X, ∃ w : Y, B w = A u := by
    intro u
    have hu : Wkp.firstOrder 1 (u : Wkp volume H p 2) ∈
        w1p0Submodule volume H p := by
      have hh := u.property
      change (Wkp.firstOrderL 1) (u : Wkp volume H p 2) ∈
        w1p0Submodule volume H p at hh
      rw [Wkp.firstOrderL_apply] at hh
      exact hh
    obtain ⟨w, hw, _⟩ := Wkp.exists_value_ae_eq_sub_comp_normalReflection
      (u : Wkp volume H p 2) hu
    refine ⟨w, Lp.ext ?_⟩
    dsimp only [B]
    rw [Wkp.valueL_apply]
    simpa only [Measure.restrict_univ] using (hw.trans (hA u).symm)
  obtain ⟨T, hT⟩ := exists_continuous_lift_of_injective_value A B hB hex
  refine ⟨T, fun u => ?_⟩
  have ht : Wkp.value 2 (T u) = A u := by
    have ht := hT u
    dsimp only [B] at ht
    rw [Wkp.valueL_apply] at ht
    exact ht
  constructor
  · exact EventuallyEq.trans (EventuallyEq.of_eq (congrArg (fun z : Z => (z : P → ℝ)) ht))
      (hA u)
  · let v := Wkp.value 2 (u : Wkp volume H p 2)
    have hav : A u = ext v - refl (ext v) := by
      dsimp only [A, v]
      simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.sub_apply,
