    Riemannian.Tensor.contMDiffOn_chartInvGramMatrix_entry (I := I) (n := ∞) α i j

omit
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I] in
without_proof_info in
theorem contDiffOn_chartPrincipalCoefficient (α : M) :
    ContDiffOn ℝ ∞ (chartPrincipalCoefficient (I := I) α)
      (interior (extChartAt I α).target) := by
  unfold chartPrincipalCoefficient inverseMetricOperator
