theorem trace_conjugate_principal_hessian (e : E ≃ₗᵢ[ℝ] F) (A H : F →L[ℝ] F) :
    traceCLM ℝ E (((e.symm : F →L[ℝ] E) ∘L A ∘L (e : E →L[ℝ] F)) ∘L
