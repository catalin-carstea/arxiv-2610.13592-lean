  have ht0 : ∀ i ∈ t, i ≠ 0 := by
    intro i hi
    have hp := (List.mem_filter.mp hi).2
    simpa [pred] using hp
  have hz0 : ∀ i ∈ z, i = 0 := by
    intro i hi
    have hp := (List.mem_filter.mp hi).2
    simpa [pred] using hp
