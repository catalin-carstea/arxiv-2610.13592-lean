without_proof_info in
theorem exists_paired_native_residualLp_bound
    (hM : IsCompact (univ : Set M)) (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ U : M → ℂ,
      ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ U → ∀ B : ℝ, 0 ≤ B →
      (∀ x, ‖complexSchrodinger g q U x‖ ≤ B) →
      (eLpNorm (schrodinger g q (fun x => (U x).re)) (ENNReal.ofReal (n + 2 : ℝ)) (nativeVolume g)).toReal ≤ C * B ∧
      (eLpNorm (schrodinger g q (fun x => (U x).im)) (ENNReal.ofReal (n + 2 : ℝ)) (nativeVolume g)).toReal ≤ C * B := by
  obtain ⟨C, hC, hb⟩ := exists_native_residualLp_bound hM g q hq
