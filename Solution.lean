/- Proof support: ScaledRelationLimit.lean, SHA256 9d890833c71e9e0ede07a9802b952347bad20a8599b5a7d235392ee7c665e4ba -/
noncomputable section ProofPart_ScaledRelationLimit



/- A compact interior image limit has one positive scale for ALL data.
The same subsequence is used separately for each fixed datum; there is
no simultaneous uniform or diagonal convergence over the data space. -/
open Set Filter Topology
namespace ConformalPoisson
variable {D X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

without_proof_info in
theorem positive_scaled_relation_limit
    {u : D → X → ℝ} {v : D → Y → ℝ} {x : X} {y : Y}
    {xs : ℕ → X} {ys : ℕ → Y} {c : ℕ → ℝ}
    (hxs : Tendsto xs atTop (𝓝 x)) (hys : Tendsto ys atTop (𝓝 y))
    (hu : ∀ d, ContinuousAt (u d) x) (hv : ∀ d, ContinuousAt (v d) y)
    (hc : ∀ k, 0 < c k)
    (hrel : ∀ d k, u d (xs k) = c k * v d (ys k))
    (hnonzero : ∃ d, u d x ≠ 0) (d₀ : D) (hd₀ : v d₀ y = 1) :
    0 < u d₀ x ∧ Tendsto c atTop (𝓝 (u d₀ x)) ∧
      ∀ d, u d x = u d₀ x * v d y := by
  have hden : Tendsto (fun k => v d₀ (ys k)) atTop (𝓝 (1 : ℝ)) :=
    hd₀ ▸ (hv d₀).tendsto.comp hys
  have hnum := (hu d₀).tendsto.comp hxs
  have hratio : Tendsto (fun k => u d₀ (xs k) / v d₀ (ys k)) atTop (𝓝 (u d₀ x)) := by
    have hraw := hnum.div hden one_ne_zero
    change Tendsto (fun k => u d₀ (xs k) / v d₀ (ys k)) atTop (𝓝 (u d₀ x / 1)) at hraw
    simpa only [div_one] using hraw
  have hdennear : ∀ᶠ k in atTop, v d₀ (ys k) ≠ 0 :=
    hden.eventually (eventually_ne_nhds one_ne_zero)
  have he : c =ᶠ[atTop] (fun k => u d₀ (xs k) / v d₀ (ys k)) := by
    filter_upwards [hdennear] with k hk
    exact (eq_div_iff hk).mpr (hrel d₀ k).symm
  have hclim : Tendsto c atTop (𝓝 (u d₀ x)) := hratio.congr' he.symm
  have hlimit (d : D) : u d x = u d₀ x * v d y := by
    have hprod := hclim.mul ((hv d).tendsto.comp hys)
    have hprod' : Tendsto (fun k => u d (xs k)) atTop (𝓝 (u d₀ x * v d y)) := by
      simpa only [Function.comp_apply, ← hrel d] using hprod
    exact tendsto_nhds_unique ((hu d).tendsto.comp hxs) hprod'
  have hnonneg : 0 ≤ u d₀ x := ge_of_tendsto hclim (Filter.Eventually.of_forall fun k => (hc k).le)
  have hnz : u d₀ x ≠ 0 := by
    intro hz
    obtain ⟨d, hd⟩ := hnonzero
    exact hd (by simpa only [hz, zero_mul] using hlimit d)
  exact ⟨lt_of_le_of_ne hnonneg hnz.symm, hclim, hlimit⟩
end ConformalPoisson

end ProofPart_ScaledRelationLimit

/- Proof support: InteriorLimitData.lean, SHA256 0b9439911e9835b96d3a2a45694fd172cce505f59b4efd721a78383c03458cbf -/
noncomputable section ProofPart_InteriorLimitData





/- At an ACTUAL interior image limit, produce one original denominator,
target quotient coordinates from the SAME transported original family,
and the positive limiting scale for ALL original data. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

structure InteriorLimitData
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (y : M₂) where
  denominator : BoundaryDatum (observedPatch (n := n) V₁)
  numerators : Fin (n + 1) → BoundaryDatum (observedPatch (n := n) V₁)
  target_one : D.solver₂.solve (denominator.val ∘ D.boundaryIdentification.symm) y = 1
  source_positive : 0 < D.solver₁.solve denominator.val x
  quotient_diffeo : IsLocalDiffeomorphAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω
    (quotientCoordinates (fun i => D.solver₂.solve ((numerators i).val ∘ D.boundaryIdentification.symm))
      (D.solver₂.solve (denominator.val ∘ D.boundaryIdentification.symm))) y
  solutions : ∀ f : BoundaryDatum (observedPatch (n := n) V₁),
    D.solver₁.solve f.val x = D.solver₁.solve denominator.val x *
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) y

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_interiorLimitData
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (hx : x ∈ (𝓡∂ (n + 1)).interior M₁)
    (y : M₂) (hy : y ∈ (𝓡∂ (n + 1)).interior M₂)
    {xs : ℕ → M₁} {ys : ℕ → M₂} {c : ℕ → ℝ}
    (hxs : Tendsto xs atTop (𝓝 x)) (hys : Tendsto ys atTop (𝓝 y)) (hc : ∀ k, 0 < c k)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ k,
      D.solver₁.solve f.val (xs k) = c k * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (ys k)) :
    Nonempty (InteriorLimitData A₁ A₂ V₁ V₂ D x y) := by
  let Γ₁ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₁) :=
    ⟨observedPatch (n := n) V₁, V₁.isOpen.preimage continuous_subtype_val⟩
  let Γ₂ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₂) :=
    ⟨observedPatch (n := n) V₂, V₂.isOpen.preimage continuous_subtype_val⟩
  have hΓ₂ : (Γ₂ : Set ((𝓡∂ (n + 1)).boundary M₂)).Nonempty := by
    obtain ⟨a, ha⟩ := D.patch_nonempty
    exact ⟨D.boundaryIdentification a, (D.patches_match a).mp ha⟩
  obtain ⟨g₀, gs, hg₀, _, hQ⟩ := exists_interior_analytic_quotient_coordinates hSchauder hRunge₂
    hReg₂ hn hcompact₂ hconnected₂ A₂ D.solver₂ Γ₂ hΓ₂ y hy
  let e : BoundaryDatum (observedPatch (n := n) V₁) ≃ₗ[ℝ]
      BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatumLinearEquiv D.boundaryIdentification D.patches_match
  have he (g : BoundaryDatum (observedPatch (n := n) V₂)) :
      (e.symm g).val ∘ D.boundaryIdentification.symm = g.val :=
    congrArg Subtype.val (e.apply_symm_apply g)
  have hden : D.solver₂.solve ((e.symm g₀).val ∘ D.boundaryIdentification.symm) y = 1 := by
    rw [he]
    exact hg₀
  obtain ⟨fval, hfval⟩ := exists_datum_with_value_one hSchauder (hRunge₁ A₁) hn hcompact₁ hconnected₁ (A₁.analytic_potential.of_le (by decide)) A₁.nonresonant D.solver₁
    Γ₁ D.patch_nonempty x hx
  have hu (f : BoundaryDatum (observedPatch (n := n) V₁)) :=
    (D.solver₁.correct f.val f.property.1).1.continuous.continuousAt (x := x)
  have hv (f : BoundaryDatum (observedPatch (n := n) V₁)) :
      ContinuousAt (D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)) y := by
    let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
      transportBoundaryDatum D.boundaryIdentification D.patches_match f
    exact (D.solver₂.correct f₂.val f₂.property.1).1.continuous.continuousAt
  obtain ⟨hpos, _, hlimit⟩ := positive_scaled_relation_limit hxs hys hu hv hc hrel
    ⟨fval, by rw [hfval]; exact one_ne_zero⟩ (e.symm g₀) hden
  refine ⟨{ denominator := e.symm g₀
            numerators := fun i => e.symm (gs i)
            target_one := hden
            source_positive := hpos
            quotient_diffeo := ?_
            solutions := hlimit }⟩
  simpa only [he] using hQ
end ConformalPoisson

end ProofPart_InteriorLimitData

/- Proof support: InteriorContinuedMap.lean, SHA256 63513f47e5b1203948059fcdc5963531095039f96ec6a34048047c3eb42ca28c -/
noncomputable section ProofPart_InteriorContinuedMap



/- The explicit interior continuation uses the genuine TARGET quotient
inverse and the SAME ORIGINAL source quotient family. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

def InteriorLimitData.sourceCoordinates (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) :
    M₁ → Fin (n + 1) → ℝ :=
  quotientCoordinates (fun i => D.solver₁.solve (R.numerators i).val) (D.solver₁.solve R.denominator.val)

def InteriorLimitData.targetCoordinates (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) :
    M₂ → Fin (n + 1) → ℝ :=
  quotientCoordinates (fun i => D.solver₂.solve ((R.numerators i).val ∘ D.boundaryIdentification.symm))
    (D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm))

def InteriorLimitData.continuedMap (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) : M₁ → M₂ :=
  fun z => R.quotient_diffeo.localInverse (R.sourceCoordinates z)

def InteriorLimitData.continuedMultiplier (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) : M₁ → ℝ :=
  fun z => D.solver₁.solve R.denominator.val z /
    D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.continuedMap z)

without_proof_info in
theorem InteriorLimitData.coordinates_base (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) :
    R.sourceCoordinates x = R.targetCoordinates y :=
  quotientCoordinates_eq_of_scaled_evaluations
    (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
    (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)) R.denominator R.numerators
    x y (D.solver₁.solve R.denominator.val x) R.source_positive.ne' R.solutions

without_proof_info in
theorem InteriorLimitData.continuedMap_base (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) :
    R.continuedMap x = y := by
  change R.quotient_diffeo.localInverse (R.sourceCoordinates x) = y
  rw [R.coordinates_base]
  exact R.quotient_diffeo.localInverse_left_inv R.quotient_diffeo.localInverse_mem_target

without_proof_info in
theorem InteriorLimitData.continuedMultiplier_base (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) :
    R.continuedMultiplier x = D.solver₁.solve R.denominator.val x := by
  change D.solver₁.solve R.denominator.val x /
    D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.continuedMap x) = _
  rw [R.continuedMap_base, R.target_one, div_one]

without_proof_info in
theorem InteriorLimitData.sourceCoordinates_analyticAt (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y)
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, Fin (n + 1) → ℝ) ω R.sourceCoordinates x := by
  apply contMDiffAt_pi_module_iff.mpr
  intro i
  exact (D.solver₁.analyticAt_interior hReg₁ A₁.metric A₁.potential A₁.analytic_potential
    (R.numerators i).val (R.numerators i).property.1 x hx).div₀
      (D.solver₁.analyticAt_interior hReg₁ A₁.metric A₁.potential A₁.analytic_potential
        R.denominator.val R.denominator.property.1 x hx) R.source_positive.ne'

without_proof_info in
theorem InteriorLimitData.continuedMap_analyticAt (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y)
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) :
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω R.continuedMap x := by
  have hmem : R.sourceCoordinates x ∈ R.quotient_diffeo.localInverse.source := by
    rw [R.coordinates_base]
    exact R.quotient_diffeo.localInverse_mem_source
  exact (R.quotient_diffeo.localInverse.contMDiffOn.contMDiffAt
    (R.quotient_diffeo.localInverse.open_source.mem_nhds hmem)).comp x (R.sourceCoordinates_analyticAt hReg₁ hx)
end ConformalPoisson

