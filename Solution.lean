noncomputable section ProofPart_GreenTrace_NativeSplitReadingBounds







/- Compatible coordinate supremum and forcing bounds from ONE actual native
chart localization. The split model uses canonical Euclidean volume throughout. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold Module
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  {r : ℝ≥0} [Fact (1 ≤ (r : ℝ≥0∞))]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_split_reading_bounds
    (g : Metric (n := n) (M := M)) (c : M) (hr : 0 < r) :
    ∃ R > 0, ∃ G ≥ 0, ∃ A ≥ 0,
      (closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      (∀ u : M → ℝ, ∀ hu : ContMDiff Ihalf 𝓘(ℝ) 1 u,
        ∀ z ∈ splitBoundaryChartCap (n := n) c R,
          |u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| ≤ ‖nativeC1Function g u hu‖ ∧
          ‖∇ (fun t : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))) z‖ ≤
            G * ‖nativeC1Function g u hu‖) ∧
      ∀ F : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F →
        lpNorm (fun t : P => F ((extChartAt Ihalf c).symm (euclideanNormalSplit n t)))
          (r : ℝ≥0∞) (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤
            A * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  have hvol : nativeVolume g = riemannianVolume Ihalf M := rfl
  obtain ⟨L⟩ := nonempty_boundaryChartLocalization (I := Ihalf) c
  obtain ⟨CV, hCV, hfactor⟩ := exists_haar_lpNorm_factor (F := ℝ)
    (volume : Measure V) (Module.finBasis ℝ V).addHaar (p := (r : ℝ≥0∞)) (by finiteness)
  let dens := (L.density⁻¹) ^ (r : ℝ)⁻¹
  have hdens : 0 ≤ dens := Real.rpow_nonneg (inv_nonneg.mpr L.density_pos.le) _
  refine ⟨L.radius, L.radius_pos, L.C, L.C_nonneg, CV * dens, mul_nonneg hCV hdens,
    L.target, ?_, ?_⟩
  · intro u hu z hz
    let e := euclideanNormalSplit n
    let x := (extChartAt Ihalf c).symm (e z)
    have hzV : e z ∈ boundaryChartCap (I := Ihalf) c L.radius := hz
    have hS := native_value_gradient_le_c1_norm g u hu x
    have hv : |u x| ≤ ‖nativeC1Function g u hu‖ :=
      (le_add_of_nonneg_right (norm_nonneg (mgradient Ihalf u x))).trans hS
    have hg : ‖mgradient Ihalf u x‖ ≤ ‖nativeC1Function g u hu‖ :=
      (le_add_of_nonneg_left (abs_nonneg (u x))).trans hS
    refine ⟨hv, ?_⟩
    have hnorm : ‖∇ ((u ∘ (extChartAt Ihalf c).symm) ∘ e) z‖ =
        ‖fderiv ℝ (u ∘ (extChartAt Ihalf c).symm) (e z)‖ := by
      rw [gradient_comp_linearIsometryEquiv_right, e.symm.norm_map, norm_gradient_eq_norm_fderiv]
    change ‖∇ ((u ∘ (extChartAt Ihalf c).symm) ∘ e) z‖ ≤ _
    rw [hnorm]
    exact (L.comparison (e z) hzV u (hu.mdifferentiable one_ne_zero x)).trans
      (mul_le_mul_of_nonneg_left hg L.C_nonneg)
  · intro F hF
    let e := euclideanNormalSplit n
    let f : V → ℝ := F ∘ (extChartAt Ihalf c).symm
    let Ω := boundaryChartCap (I := Ihalf) c L.radius
    let ΩP := splitBoundaryChartCap (n := n) c L.radius
    let b : ContDiffBump (extChartAt Ihalf c c) :=
      ⟨L.radius, 2 * L.radius, L.radius_pos, by linarith [L.radius_pos]⟩
    have hcut : (fun z => b z * f z) =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)] f := by
      filter_upwards [ae_restrict_mem Ω.isOpen.measurableSet] with z hz
      rw [b.one_of_mem_closedBall (ball_subset_closedBall hz.1), one_mul]
    have hB := boundary_chart_cutoff_eLpNorm_value_le c b L.target L.density_pos
      L.density_lower hF.continuous hr
    change eLpNorm (fun z => b z * f z) (r : ℝ≥0∞)
      ((Module.finBasis ℝ V).addHaar.restrict (Ω : Set V)) ≤
      ENNReal.ofReal L.density⁻¹ ^ (r : ℝ)⁻¹ *
        eLpNorm F (r : ℝ≥0∞) (riemannianVolume Ihalf M) at hB
    rw [eLpNorm_congr_ae (p := (r : ℝ≥0∞)) hcut] at hB
    have hfinite : ENNReal.ofReal L.density⁻¹ ^ (r : ℝ)⁻¹ *
        eLpNorm F (r : ℝ≥0∞) (riemannianVolume Ihalf M) ≠ ⊤ :=
      ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top)
        (contMDiff_memLp_nativeVolume g F hF (r : ℝ≥0∞)).eLpNorm_ne_top
    have hBasis := ENNReal.toReal_mono hfinite hB
    rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow,
      ENNReal.toReal_ofReal (inv_nonneg.mpr L.density_pos.le)] at hBasis
    have hfm : AEStronglyMeasurable f (volume.restrict (Ω : Set V)) :=
      (hF.continuous.comp_continuousOn ((continuousOn_extChartAt_symm c).mono
        ((boundaryChartCap_subset_interior_target c L.target).trans interior_subset))).aestronglyMeasurable
          Ω.isOpen.measurableSet
    have he : MeasurePreserving e (volume : Measure P) (volume : Measure V) := e.measurePreserving
    have hcap : (ΩP : Set P) = e ⁻¹' (Ω : Set V) := rfl
    have her := hcap ▸ he.restrict_preimage Ω.isOpen.measurableSet
    have hiso : lpNorm (f ∘ e) (r : ℝ≥0∞) (volume.restrict (ΩP : Set P)) =
        lpNorm f (r : ℝ≥0∞) (volume.restrict (Ω : Set V)) := by
      unfold lpNorm
      rw [eLpNorm_comp_measurePreserving hfm her]
    change lpNorm (f ∘ e) (r : ℝ≥0∞) (volume.restrict (ΩP : Set P)) ≤
      CV * dens * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal
    rw [hiso, hfactor]
    exact (mul_le_mul_of_nonneg_left hBasis hCV).trans_eq (by dsimp only [dens]; rw [hvol]; ring)

end ConformalPoisson

end ProofPart_GreenTrace_NativeSplitReadingBounds

