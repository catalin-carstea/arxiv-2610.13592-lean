/- The actual signed native operator in the split half-ball interface.
The lower order signs follow from minus div-grad plus q; the localized
zero trace is proved for every actual Sobolev reading and cutoff. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti
open scoped Manifold ContDiff Topology Gradient ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))
local notation "Ihalf" => 𝓡∂ (n + 1)

def splitChartHomogeneousDrift (g : Metric (n := n) (M := M)) (c : M) (z : P) : P :=
  -(euclideanNormalSplit n).symm (nativeChartDrift g c (euclideanNormalSplit n z))

def splitChartHomogeneousPotential (c : M) (q : M → ℝ) (z : P) : ℝ :=
  -nativeChartPotential c q (euclideanNormalSplit n z)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_split_homogeneous_reading (hp : p ≠ ⊤)
    (g : Metric (n := n) (M := M)) (q u : M → ℝ) (c : M) {R : ℝ}
    (hrt : closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hu0 : ∀ x, (𝓡∂ (n + 1)).IsBoundaryPoint x → u x = 0)
    (hLu : ∀ z ∈ (splitBoundaryChartCap (n := n) c R : Set P),
      schrodinger g q u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) = 0) :
    ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
      (Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
        fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
      (∀ η : P → ℝ, ContDiff ℝ ∞ η → HasCompactSupport η →
        tsupport η ⊆ ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) R →
        ∀ w : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
          Wkp.value 2 w =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
            (fun z => η z * Wkp.value 2 U z) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume (splitBoundaryChartCap (n := n) c R) p) ∧
      ∀ᵐ z ∂volume.restrict (splitBoundaryChartCap (n := n) c R : Set P),
        traceCLM ℝ P (splitChartPrincipal g c z ∘L Wkp.iteratedGradient 1 U z) +
          ⟪splitChartHomogeneousDrift g c z, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U) z⟫_ℝ +
          splitChartHomogeneousPotential c q z * Wkp.value 2 U z = 0 := by
  obtain ⟨U, hU⟩ := exists_split_boundary_chart_reading (p := p) c hrt hu 2
  refine ⟨U, hU, ?_, ?_⟩
  · intro η hη hηc hηs w hw
    exact split_boundary_local_cutoff_zeroTrace hp c le_rfl hrt hu hu0 U hU η hη hηc hηs w hw
  · let e := euclideanNormalSplit n
    let f : V → ℝ := u ∘ (extChartAt Ihalf c).symm
    have hs := contDiffOn_split_boundary_chart_reading c hrt hu
    have hH := Wkp.iteratedGradient_ae_eq_of_contDiffOn 1 U (hs.of_le (by simp)) hU
    have hUv : W1p.value (Wkp.lowerOrder 1 U) =ᵐ[volume.restrict
        (splitBoundaryChartCap (n := n) c R : Set P)] fun z => f (e z) := by
      rw [Wkp.value_lowerOrder_one]
      exact hU
    have hG := W1p.gradient_ae_eq_of_contDiffOn (Wkp.lowerOrder 1 U) (hs.of_le (by simp)) hUv
    filter_upwards [hU, hH, hG, ae_restrict_mem (splitBoundaryChartCap (n := n) c R).isOpen.measurableSet]
      with z hUz hHz hGz hz
    have htrace := (trace_principal_classical_hessian_comp_isometry e
      (nativeChartPrincipal g c (e z)) f z).trans
      (native_boundary_chart_hessian_trace g q (schrodinger g q u) u
        ⟨hu, fun _ _ => rfl, fun x => hu0 x x.property⟩ c hrt hz)
    have hd : ⟪splitChartHomogeneousDrift g c z, ∇ (f ∘ e) z⟫_ℝ =
        -(fderiv ℝ f (e z) (nativeChartDrift g c (e z))) := by
      change ⟪-(e.symm (nativeChartDrift g c (e z))), ∇ (f ∘ e) z⟫_ℝ = _
      rw [gradient_comp_linearIsometryEquiv_right, inner_neg_left, e.symm.inner_map_map,
        real_inner_comm, inner_gradient_left]
    change W1p.gradient (Wkp.lowerOrder 1 U) z = ∇ (f ∘ e) z at hGz
    rw [hHz, Wkp.iteratedGradient_zero, hGz, hd, hUz]
    change traceCLM ℝ P (splitChartPrincipal g c z ∘L iteratedGradientChain (f ∘ e) 1 z) +
      -(fderiv ℝ f (e z) (nativeChartDrift g c (e z))) +
      (-nativeChartPotential c q (e z)) * u ((extChartAt Ihalf c).symm (e z)) = 0
    change traceCLM ℝ P (splitChartPrincipal g c z ∘L iteratedGradientChain (f ∘ e) 1 z) = _ at htrace
    rw [hLu z hz] at htrace
    dsimp only [f, Function.comp_apply] at htrace ⊢
    linarith

end ConformalPoisson

