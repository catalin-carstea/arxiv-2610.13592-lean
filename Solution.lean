without_proof_info in
theorem norm_sub_conjugate_principal_isometry (e : E ≃ₗᵢ[ℝ] F) (A B : F →L[ℝ] F) :
    ‖((e.symm : F →L[ℝ] E) ∘L A ∘L (e : E →L[ℝ] F)) -
