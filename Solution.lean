noncomputable section ProofPart_RelativeBoundaryStep



/- A boundary Sobolev step: tangential first derivatives of order
k+2 and a forcing of order k+1 upgrade an H(k+2) solution to H(k+3).
The equation supplies the pure normal Hessian component; commutation
supplies the other derivatives of the normal first derivative. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {ι : Type*} [Fintype ι] {μ : Measure (EuclideanSpace ℝ ι)} [μ.IsAddHaarMeasure]
  {Ω : Opens (EuclideanSpace ℝ ι)} {S K : Set (EuclideanSpace ℝ ι)}

without_proof_info in
theorem exists_relative_boundary_sobolev_step
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ K) (hΩS : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ interior S)
    {a : EuclideanSpace ℝ ι → Matrix ι ι ℝ}
    (ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S)
    (ν : ι) (haν : ∀ x ∈ S, a x ν ν ≠ 0)
    (k : ℕ) (F : Wkp μ Ω 2 (k + 1)) {u : W1p μ Ω 2}
    (hw : ∃ w : Wkp μ Ω 2 (k + 2), Wkp.value (k + 2) w = W1p.value u)
    (hu : ∀ φ : 𝓓(Ω, ℝ), energyFormH1 a 0 0 u (W1p.ofTestFunctionₗ μ Ω 2 φ) =
      ∫ x in Ω, Wkp.value (k + 1) F x * φ x ∂μ)
    (htan : ∀ j, j ≠ ν → ∃ Z : Wkp μ Ω 2 (k + 2),
      HasWeakLineDerivOn μ Ω (W1p.value u) (Wkp.value (k + 2) Z)
        (EuclideanSpace.basisFun ι ℝ j)) :
    ∃ w : Wkp μ Ω 2 (k + 3), Wkp.value (k + 3) w = W1p.value u := by
  classical
  let b := EuclideanSpace.basisFun ι ℝ
  obtain ⟨w, hw⟩ := hw
  choose G hG using fun j => Wkp.exists_hasWeakLineDerivOn_value (k + 1) w (b j)
  rw [hw] at hG
  let D := fun j => Wkp.firstOrder k (G j)
  have hD : ∀ j, HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value (D j)) (b j) := by
    intro j
    rw [Wkp.value_firstOrder]
    exact hG j
  have hGrad : ∀ j, ∃ v : Wkp μ Ω 2 (k + 1), Wkp.value (k + 1) v =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient u x, b j⟫_ℝ := fun j =>
    ⟨G j, (hG j).ae_eq ((W1p.hasWeakFDerivOn u).hasWeakLineDerivOn (b j))⟩
  have hMixed : ∀ i j, i ≠ ν ∨ j ≠ ν → ∃ v : Wkp μ Ω 2 (k + 1),
      Wkp.value (k + 1) v =ᵐ[μ.restrict Ω] fun x => ⟪W1p.gradient (D j) x, b i⟫_ℝ := by
    intro i j hij
    by_cases hj : j ≠ ν
    · obtain ⟨Z, hZ⟩ := htan j hj
      obtain ⟨V, hV⟩ := Wkp.exists_hasWeakLineDerivOn_value (k + 1) Z (b i)
      have hZD := hZ.ae_eq (hD j)
      exact ⟨V, (hV.congr_ae hZD).ae_eq
        ((W1p.hasWeakFDerivOn (D j)).hasWeakLineDerivOn (b i))⟩
    · have hi : i ≠ ν := hij.resolve_right hj
      obtain ⟨Z, hZ⟩ := htan i hi
      obtain ⟨V, hV⟩ := Wkp.exists_hasWeakLineDerivOn_value (k + 1) Z (b j)
      exact ⟨V, (hZ.comm hV (hD j)).ae_eq
        ((W1p.hasWeakFDerivOn (D j)).hasWeakLineDerivOn (b i))⟩
  obtain ⟨N, hN⟩ := exists_relative_normal_hessian_sobolev hS hK hKS hΩK hΩS ha ν haν
    (k + 1) F hD hu hGrad hMixed
  have hNormal : ∃ Z : Wkp μ Ω 2 (k + 2), Wkp.value (k + 2) Z = W1p.value (D ν) := by
    refine Wkp.exists_value_eq_of_forall_hasWeakLineDerivOn b (W1p.value (D ν)) (k + 1) fun i => ?_
    by_cases hi : i = ν
    · subst i
      exact ⟨N, ((W1p.hasWeakFDerivOn (D ν)).hasWeakLineDerivOn (b ν)).congr_ae_deriv hN.symm⟩
    · obtain ⟨V, hV⟩ := hMixed i ν (Or.inl hi)
      exact ⟨V, ((W1p.hasWeakFDerivOn (D ν)).hasWeakLineDerivOn (b i)).congr_ae_deriv hV.symm⟩
  refine Wkp.exists_value_eq_of_forall_hasWeakLineDerivOn b (W1p.value u) (k + 2) fun j => ?_
  by_cases hj : j = ν
  · subst j
    obtain ⟨Z, hZ⟩ := hNormal
    exact ⟨Z, hZ ▸ hD ν⟩
  · exact htan j hj
end ConformalPoisson

end ProofPart_RelativeBoundaryStep

