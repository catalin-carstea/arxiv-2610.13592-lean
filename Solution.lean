/- Assignment268, /root. Two actual native coefficient bundles share ONE
collar and cutoff witness, chosen before every frequency and Taylor order. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Metric Filter Topology TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)
local notation "Z" => Matrix (Fin n) (Fin n) ℝ × ℝ × (Fin n → ℝ)

def physicalSplitMap (n : ℕ) (w : EuclideanSpace ℝ (Fin n) × ℝ) : EuclideanHalfSpace (n + 1) :=
  (𝓡∂ (n + 1)).symm (euclideanHalfSpaceBoundaryNormalEquiv n w)

without_proof_info in
theorem continuous_physicalSplitMap : Continuous (physicalSplitMap n) :=
  (𝓡∂ (n + 1)).continuous_symm.comp (euclideanHalfSpaceBoundaryNormalEquiv n).continuous

without_proof_info in
@[simp] theorem physicalSplitMap_nativeNormalCoordinates (z : H) :
    physicalSplitMap n (nativeNormalCoordinates z) = z := by
  simp only [physicalSplitMap, nativeNormalCoordinates, ContinuousLinearEquiv.apply_symm_apply,
    ModelWithCorners.left_inv]

without_proof_info in
@[simp] theorem physicalSplitMap_boundary (y : Y) :
    physicalSplitMap n (y, 0) = EuclideanHalfSpace.boundaryParam n y := by
  rw [← nativeNormalCoordinates_boundary y, physicalSplitMap_nativeNormalCoordinates]

structure NativeLayerCollar {S : TopologicalSpace.Opens H}
    (F₁ F₂ : NormalMetricField S) (y : Y) where
  extension₁ : Y × ℝ → Z
  extension₂ : Y × ℝ → Z
  domain : TopologicalSpace.Opens (Y × ℝ)
  analytic₁ : AnalyticOnNhd ℝ extension₁ domain
  analytic₂ : AnalyticOnNhd ℝ extension₂ domain
  read₁ : ∀ z : H, normalCoefficientBundle F₁ z = extension₁ (nativeNormalCoordinates z)
  read₂ : ∀ z : H, normalCoefficientBundle F₂ z = extension₂ (nativeNormalCoordinates z)
  within_field : MapsTo (physicalSplitMap n) domain S
  cutoff : CompactLayerCollar y domain

without_proof_info in
theorem nonempty_nativeLayerCollar
    {S : TopologicalSpace.Opens H} (F₁ F₂ : NormalMetricField S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hA₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.inverse S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.inverse S)
    (y : Y) (hy : EuclideanHalfSpace.boundaryParam n y ∈ S) :
    Nonempty (NativeLayerCollar F₁ F₂ y) := by
  obtain ⟨G₁, r₁, hr₁, hω₁, hread₁⟩ := exists_common_coefficient_extension F₁ hG₁ hA₁ y hy
  obtain ⟨G₂, r₂, hr₂, hω₂, hread₂⟩ := exists_common_coefficient_extension F₂ hG₂ hA₂ y hy
  let O : Set (Y × ℝ) := (ball (y, 0) r₁ ∩ ball (y, 0) r₂) ∩ (physicalSplitMap n) ⁻¹' S
  have hO : IsOpen O := (isOpen_ball.inter isOpen_ball).inter
    (S.isOpen.preimage continuous_physicalSplitMap)
  have hyO : (y, (0 : ℝ)) ∈ O := ⟨⟨mem_ball_self hr₁, mem_ball_self hr₂⟩, by simpa using hy⟩
  obtain ⟨C⟩ := nonempty_compactLayerCollar hO y hyO
  exact ⟨⟨G₁, G₂, ⟨O, hO⟩, hω₁.mono (fun _ hz => hz.1.1), hω₂.mono (fun _ hz => hz.1.2),
    hread₁, hread₂, (fun _ hz => hz.2), C⟩⟩

namespace NativeLayerCollar

without_proof_info in
theorem face_domain_maps {S : TopologicalSpace.Opens H} {F₁ F₂ : NormalMetricField S} {y : Y}
    (R : NativeLayerCollar F₁ F₂ y) :
    MapsTo (EuclideanHalfSpace.boundaryParam n) R.cutoff.tangentialDomain S := by
  intro z hz
  have he := R.within_field (R.cutoff.face_domain_subset hz)
  simpa only [physicalSplitMap_boundary] using he

without_proof_info in
theorem native_support_maps {S : TopologicalSpace.Opens H} {F₁ F₂ : NormalMetricField S} {y : Y}
    (R : NativeLayerCollar F₁ F₂ y) :
    (nativeNormalCoordinates (n := n)) ⁻¹' (R.cutoff.supportCap ×ˢ tsupport R.cutoff.normalCutoff) ⊆ S := by
  intro z hz
  have he := R.within_field (R.cutoff.support_cylinder_subset hz)
  simpa only [physicalSplitMap_nativeNormalCoordinates] using he

end NativeLayerCollar
end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNPairedLayerCollar

