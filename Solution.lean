      congrArg norm hmixed.symm
    _ ≤ ‖mixedDerivativeWithin S boundaryTangentialProjection e vs.length z.length f x‖ *
        ∏ i : Fin vs.length, ‖vs.get i‖ :=
      (mixedDerivativeWithin S boundaryTangentialProjection e vs.length z.length f x).le_opNorm _
    _ = ‖mixedDerivativeWithin S boundaryTangentialProjection e vs.length z.length f x‖ := by rw [hprod, mul_one]
    _ ≤ M * B ^ vs.length * C ^ z.length * ((vs.length + z.length).factorial : ℝ) :=
      hbound vs.length z.length
