/- Proof support: DivergenceFreeComparison.lean, SHA256 9f706604460bd657596f5e5901e385e7672bb9e104e002f21dbcde49797f8d01 -/
noncomputable section ProofPart_DivergenceFreeComparison



/- Harmonic comparison after subtracting any divergence-free L2
reference field. Piecewise constant tangential reference fields will
be used for boundary reflection; they need not be constant across the
flat interface. This supplies the comparison step for that caller. -/
open Set Metric MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped Distributions Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

/-- A reference field annihilating every actual zero-trace Sobolev test. -/
def SobolevDivergenceFree (Ω : Opens V) (C : Lp V 2 (volume.restrict (Ω : Set V))) : Prop :=
  ∀ v : W1p0 volume Ω 2, ⟪C, W1p.gradient (v : W1p volume Ω 2)⟫_ℝ = 0

without_proof_info in
theorem sobolevDivergenceFree_of_testFunction {Ω : Opens V} (C : Lp V 2 (volume.restrict (Ω : Set V)))
    (hC : ∀ φ : 𝓓(Ω, ℝ), ⟪C, W1p.gradient (W1p.ofTestFunctionₗ volume Ω 2 φ)⟫_ℝ = 0) :
    SobolevDivergenceFree Ω C := by
  let L : W1p volume Ω 2 →L[ℝ] ℝ := (innerSL ℝ C).comp W1p.gradientL
  have hs : (w1p0Submodule volume Ω 2 : Set (W1p volume Ω 2)) ⊆ {v | L v = 0} := by
    apply w1p0Submodule_subset_of_isClosed (isClosed_eq L.continuous continuous_const)
    intro φ
    simpa only [mem_ofPred_eq, L, ContinuousLinearMap.comp_apply, innerSL_apply_apply,
      W1p.gradientL_apply] using hC φ
  intro v
  simpa only [mem_ofPred_eq, L, ContinuousLinearMap.comp_apply, innerSL_apply_apply,
    W1p.gradientL_apply] using hs v.property

set_option maxHeartbeats 800000 in
without_proof_info in
/-- Subtracting a divergence-free reference preserves the actual weak
PDE and improves the energy error to the L2 distance from that field. -/
theorem exists_harmonic_replacement_of_divergenceFree_reference {Ω : Opens V}
    {z : V} {R : ℝ} (hball : (Ω : Set V) ⊆ ball z R)
    (u : W1p volume Ω 2) (G C : Lp V 2 (volume.restrict (Ω : Set V)))
    (hu : ∀ v : W1p0 volume Ω 2, energyFormH1 (fun _ => 1) 0 0 u (v : W1p volume Ω 2) =
      ⟪G, W1p.gradient (v : W1p volume Ω 2)⟫_ℝ)
    (hC : SobolevDivergenceFree Ω C) :
    ∃ w : W1p volume Ω 2, u - w ∈ w1p0Submodule volume Ω 2 ∧
      (∀ v : W1p0 volume Ω 2, energyFormH1 (fun _ => 1) 0 0 w (v : W1p volume Ω 2) = 0) ∧
      ‖W1p.gradient (u - w)‖ ≤ ‖G - C‖ := by
  obtain ⟨w, huw, hw, _, hbound⟩ :=
    exists_sub_mem_w1p0Submodule_harmonicOnNhd_ae_eq_of_subset_ball
      (n := n) (Omega := Ω) (z := z) (R := R) hball u
  refine ⟨w, huw, hw, hbound (G - C) ?_⟩
  intro v
  rw [inner_sub_left, hC v, sub_zero]
  exact hu v

set_option maxHeartbeats 800000 in
without_proof_info in
/-- The full-ball gradient oscillation comparison remains valid for
any divergence-free reference, including tangential jump fields. -/
theorem gradient_oscillation_le_of_divergenceFree_reference {z : V} {r ρ : ℝ}
    (u : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2)
    (G C : Lp V 2 (volume.restrict (ball z r)))
    (hu : ∀ v : W1p0 volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2,
      energyFormH1 (fun _ => 1) 0 0 u (v : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2) = ⟪G, W1p.gradient (v : W1p volume (⟨ball z r, isOpen_ball⟩ : Opens V) 2)⟫_ℝ)
    (hC : SobolevDivergenceFree ⟨ball z r, isOpen_ball⟩ C) (hρ : 0 < ρ) (hρr : ρ ≤ r) :
    (∫ x in ball z ρ, ‖W1p.gradient u x - ⨍ y in ball z ρ, W1p.gradient u y‖ ^ 2) ≤
      4 * ((2 : ℝ) ^ (3 * (n + 1) + 10) * ((n + 1 : ℕ) + 1) ^ 2) *
        (ρ / r) ^ (n + 1 + 2) *
          (∫ x in ball z r, ‖W1p.gradient u x - ⨍ y in ball z r, W1p.gradient u y‖ ^ 2) +
        (4 * ((2 : ℝ) ^ (3 * (n + 1) + 10) * ((n + 1 : ℕ) + 1) ^ 2) + 2) * ‖G - C‖ ^ 2 := by
  have hr : 0 < r := hρ.trans_le hρr
  obtain ⟨w, _, hw, hbound⟩ := exists_harmonic_replacement_of_divergenceFree_reference
    (show (⟨ball z r, isOpen_ball⟩ : Opens V) ≤ ⟨ball z r, isOpen_ball⟩ from le_rfl)
    u G C hu hC
  have hA := uniformlyEllipticOn_const_one_one (n := Fin (n + 1)) (ball z r : Set V)
  have hAu : ∀ ξ : V, (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ).toQuadraticForm' ξ ≤ 1 * ‖ξ‖ ^ 2 :=
    fun ξ => (le_abs_self _).trans
      (abs_toQuadraticForm'_le_of_abs_dotProduct_mulVec_le (hA.upper_bound (mem_ball_self hr)) ξ)
  have hcomp := setIntegral_norm_gradient_sub_setAverage_sq_le_add_of_frozen
    (u := u) one_pos (hA.lower_bound (mem_ball_self hr)) hAu hw subset_rfl hρ hρr
  have herror : (∫ x in ball z r, ‖W1p.gradient u x - W1p.gradient w x‖ ^ 2) ≤ ‖G - C‖ ^ 2 := by
    have hsq := W1p.setIntegral_norm_gradient_sub_sq_eq (mu := volume)
      (show (⟨ball z r, isOpen_ball⟩ : Opens V) ≤ ⟨ball z r, isOpen_ball⟩ from le_rfl) u w
    rw [W1p.restrictL_self] at hsq
    exact hsq.trans_le (pow_le_pow_left₀ (norm_nonneg _) hbound 2)
  simp only [div_self one_ne_zero, Real.sqrt_one, one_pow, mul_one] at hcomp
  apply hcomp.trans
  apply add_le_add le_rfl
  exact mul_le_mul_of_nonneg_left herror (by positivity)
end ConformalPoisson

end ProofPart_DivergenceFreeComparison

