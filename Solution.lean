      (Ω : Set E).indicator (Wkp.value 1 (Wkp.lowerOrder 1 u)) := by
    rw [← Wkp.value_succ, ← Wkp.value_succ]
    exact hw
  have hg := Wkp.iteratedGradient_ae_eq_indicator_of_isClosed hK hKV 0 hu1 hw1
