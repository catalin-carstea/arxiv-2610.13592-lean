theorem exists_native_classical_representative_of_locally
    (g : Metric (n := n) (M := M)) (q k : M → ℝ) (U : Opens M)
    (h : ∀ x ∈ U, ∃ O : Opens M, x ∈ O ∧ (O : Set M) ⊆ U ∧
      ∃ f : M → ℝ, ContMDiffOn Ihalf 𝓘(ℝ) ∞ f O ∧
        (∀ y ∈ O, schrodinger g q f y = 0) ∧ f =ᵐ[(nativeVolume g).restrict O] k) :
    ∃ G : M → ℝ, ContMDiffOn Ihalf 𝓘(ℝ) ∞ G U ∧ G =ᵐ[nativeVolume g] k ∧
      ∀ x ∈ U, schrodinger g q G x = 0 := by
  let : SecondCountableTopology M := native_secondCountable_of_compact (n := n) isCompact_univ
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
