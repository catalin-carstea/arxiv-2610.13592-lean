      ContinuousOn.integrableOn_compact (μ := μ)
        (f := fun y => fderiv ℝ (fun z => F z y) x) isCompact_univ
        (hD.uncurry_left (f := fun z y => fderiv ℝ (fun z => F z y) z) x hx)
  · intro y z hz
    exact ((hAt z hz y).comp z (contMDiffAt_id.prodMk contMDiffAt_const)).contDiffAt
      |>.differentiableAt (by decide) |>.differentiableWithinAt
end Ordinary

