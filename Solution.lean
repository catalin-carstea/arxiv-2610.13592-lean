  obtain ⟨W, hW, hnorm⟩ := exists_halfSpace_extension_le_components a hΩU hζc hζU w hw0 hwK
  have hWf : Wkp.value 2 (W : Wkp (volume : Measure P) (normalHalfSpace a) (r : ℝ≥0∞) 2)
      =ᵐ[volume.restrict (Ω : Set P)] fun t => ζ t * f t := by
    have hWΩ := ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hΩH) hW
    filter_upwards [hWΩ, hw, huf, ae_restrict_mem Ω.isOpen.measurableSet] with t h1 h2 h3 htΩ
    rw [h1, indicator_of_mem htΩ, h2, h3]
