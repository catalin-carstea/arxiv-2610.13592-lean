  obtain ⟨L, hL⟩ := exists_holderOnWith_gradient_of_odd_dirichlet_reflection ν hν hU w hw0 hα hαlt hR hS
    (holderOnWith_unit_directional_forcing hfHolder e he) (memLp_directional_forcing hf e) hweak
