    by_cases hz : F z = 0
    · have hzero : (fun x => G.kernel x z * F z) = (0 : M → ℝ) := by
        funext x; simp only [hz, mul_zero, Pi.zero_apply]
      rw [hzero, mvfderiv_zero]
