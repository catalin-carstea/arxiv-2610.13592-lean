/- Arbitrarily small Hessian coefficient in the half-space Dirichlet
gradient interpolation estimate. Only an unspecified finite constant is
needed for local boundary estimates; no sharp reflection norm is used. -/
open MeasureTheory Set TopologicalSpace Filter TauCeti Module
open scoped ENNReal InnerProductSpace
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "P" => WithLp 2 (ℝ × E)

without_proof_info in
theorem norm_w2p_le_components {Omega : TopologicalSpace.Opens P}
    (u : Wkp (volume : Measure P) Omega p 2) :
    ‖u‖ ≤ ‖Wkp.value 2 u‖ + ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)‖ +
      ‖Wkp.iteratedGradient 1 u‖ := by
  have h1 := Wkp.norm_le_norm_lowerOrder_add_norm_iteratedGradient 1 u
  have h0 := Wkp.norm_le_norm_lowerOrder_add_norm_iteratedGradient 0 (Wkp.lowerOrder 1 u)
  rw [Wkp.lowerOrder_zero, ← Wkp.value_one, ← Wkp.value_succ 1 u] at h0
  linarith

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_halfSpace_gradient_interpolation
    (hp : p ≠ (⊤ : ℝ≥0∞)) (a : ℝ) (ε : ℝ) (hε : 0 < ε) :
    ∃ C ≥ 0, ∀ u : halfSpaceW2pZeroTrace (E := E) (p := p) a,
      ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1
        (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2))‖ ≤
      ε * ‖Wkp.iteratedGradient 1 (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2)‖ +
        C * ‖Wkp.value 2 (u : Wkp (volume : Measure P) (normalHalfSpace a) p 2)‖ := by
  obtain ⟨T, hT⟩ := exists_bounded_odd_w2p_extension_with_value_bound (E := E) (p := p) a
  let δ : ℝ := min 1 ε / (4 * (‖T‖ + 1))
  have hden : 0 < 4 * (‖T‖ + 1) := by positivity
  have hδ : 0 < δ := div_pos (lt_min zero_lt_one hε) hden
  have hδid : δ * (‖T‖ + 1) = min 1 ε / 4 := by
    dsimp only [δ]
    field_simp
  have ht0 : 0 ≤ δ * ‖T‖ := mul_nonneg hδ.le (norm_nonneg _)
  have ht1 : δ * ‖T‖ ≤ 1 / 2 := by
    have hm := min_le_left (1 : ℝ) ε
    nlinarith
  have htε : 2 * (δ * ‖T‖) ≤ ε := by
    have hm := min_le_right (1 : ℝ) ε
    nlinarith
  let B : ℝ := 2 * (finrank ℝ P : ℝ) ^ 2 / δ
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨2 * (δ * ‖T‖ + B), by positivity, fun u => ?_⟩
  let v : Wkp (volume : Measure P) (normalHalfSpace a) p 2 := u
  have heq := odd_w2p_restrict_eq a v (T u) (hT u).1
  have hgrad : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
      ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 (T u))‖ := by
    rw [← heq]
    exact norm_gradient_restrict_w2p_le le_top (T u)
  have hi := Wkp.norm_iteratedGradient_lowerOrder_le hp (T u) hδ
  have hh : ‖Wkp.iteratedGradient 1 (T u)‖ ≤ ‖T‖ * ‖v‖ :=
    (Wkp.norm_iteratedGradient_le 1 (T u)).trans (T.le_opNorm u)
  have hv := (hT u).2
  change ‖Wkp.value 2 (T u)‖ ≤ 2 * ‖Wkp.value 2 v‖ at hv
  have hn := norm_w2p_le_components v
  have hbase : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
      (δ * ‖T‖) * ‖v‖ + B * ‖Wkp.value 2 v‖ := by
    have hhδ := mul_le_mul_of_nonneg_left hh hδ.le
    have hvδ := mul_le_mul_of_nonneg_left hv
      (show 0 ≤ (finrank ℝ P : ℝ) ^ 2 / δ by positivity)
    calc
      ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
          δ * ‖Wkp.iteratedGradient 1 (T u)‖ +
            (finrank ℝ P : ℝ) ^ 2 / δ * ‖Wkp.value 2 (T u)‖ := hgrad.trans hi
      _ ≤ δ * (‖T‖ * ‖v‖) + (finrank ℝ P : ℝ) ^ 2 / δ * (2 * ‖Wkp.value 2 v‖) :=
        add_le_add hhδ hvδ
      _ = _ := by dsimp only [B]; ring
  have hn' := mul_le_mul_of_nonneg_left hn ht0
  have hsmall := mul_le_mul_of_nonneg_right ht1
    (norm_nonneg (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)))
  have habs : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
      2 * (δ * ‖T‖) * ‖Wkp.iteratedGradient 1 v‖ +
        2 * (δ * ‖T‖ + B) * ‖Wkp.value 2 v‖ := by nlinarith
  have hH := mul_le_mul_of_nonneg_right htε (norm_nonneg (Wkp.iteratedGradient 1 v))
  change ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v)‖ ≤
    ε * ‖Wkp.iteratedGradient 1 v‖ + 2 * (δ * ‖T‖ + B) * ‖Wkp.value 2 v‖
  linarith

end ConformalPoisson

end ProofPart_GreenTrace_HalfSpaceGradientInterpolation

