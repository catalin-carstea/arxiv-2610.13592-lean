theorem native_chart_reading_mem_localZeroDirichletSpace (hp : p ≠ ⊤) (c : M) {r : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    {u : M → ℝ} (hu : Continuous u) (hu0 : ∀ x, I.IsBoundaryPoint x → u x = 0)
