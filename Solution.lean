noncomputable section ProofPart_BoundaryAnalytic_BoundaryJetGluing



/- Actual finite reflection gluing on a closed ball. The matching jets are
explicit premises here, to be supplied by the trace lift and scalar equation.
The same supplied positive-side function is retained. -/
open Set Metric
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def boundaryOddReflection (u : V → ℝ) (x : V) : ℝ :=
  if 0 ≤ x 0 then u x else -u (boundaryReflection n x)

without_proof_info in
theorem boundaryOddReflection_eq_of_nonneg (u : V → ℝ) (x : V) (hx : 0 ≤ x 0) :
    boundaryOddReflection u x = u x := by simp [boundaryOddReflection, hx]

without_proof_info in
theorem boundaryOddReflection_eq_of_neg (u : V → ℝ) (x : V) (hx : x 0 < 0) :
    boundaryOddReflection u x = -u (boundaryReflection n x) := by
  simp [boundaryOddReflection, not_le.mpr hx]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem contDiffOn_boundaryOddReflection_of_matching_jets
    (u : V → ℝ) (p : V → FormalMultilinearSeries ℝ V ℝ) (r : ℝ)
    (hp : HasFTaylorSeriesUpToOn 3 u p (closedBall 0 r ∩ {x : V | 0 ≤ x 0}))
    (hzero : ∀ x ∈ closedBall (0 : V) r, x 0 = 0 → u x = 0)
    (hmatch : ∀ x ∈ closedBall (0 : V) r, x 0 = 0 → ∀ k : ℕ, k ≤ 3 →
      p x k = -(p x k).compContinuousLinearMap
        (fun _ => (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap)) :
    ContDiffOn ℝ 3 (boundaryOddReflection u) (closedBall (0 : V) r) := by
  classical
  let R : V →L[ℝ] V := (boundaryReflection n).toContinuousLinearEquiv.toContinuousLinearMap
  let S : Set V := closedBall 0 r ∩ {x : V | 0 ≤ x 0}
  let T : Set V := R ⁻¹' S
  let q : V → FormalMultilinearSeries ℝ V ℝ :=
    fun x k => -(p (R x) k).compContinuousLinearMap (fun _ => R)
  let jets : V → FormalMultilinearSeries ℝ V ℝ := {x : V | 0 ≤ x 0}.piecewise p q
  have hT (x : V) : x ∈ T ↔ x ∈ closedBall (0 : V) r ∧ x 0 ≤ 0 := by
    change (R x ∈ closedBall (0 : V) r ∧ 0 ≤ (R x) 0) ↔ _
    have hn : ‖R x‖ = ‖x‖ := norm_boundaryReflection x
    have hc : (R x) 0 = -x 0 := by simp [R]
    simp only [mem_closedBall_zero_iff, hn, hc, neg_nonneg]
  have hcover : S ∪ T = closedBall (0 : V) r := by
    ext x
    constructor
    · intro hx
      exact hx.elim (fun h => h.1) (fun h => ((hT x).mp h).1)
    · intro hx
      by_cases h : 0 ≤ x 0
      · exact Or.inl ⟨hx, h⟩
      · exact Or.inr ((hT x).mpr ⟨hx, le_of_not_ge h⟩)
  have hminus : HasFTaylorSeriesUpToOn 3 (fun x => -u (R x)) q T := by
    simpa only [Function.comp_apply, neg_one_smul] using
      (hp.compContinuousLinearMap R).const_smul (-1 : ℝ)
  have hface (x : V) (hx : x ∈ closedBall (0 : V) r) (hz : x 0 = 0)
      (k : ℕ) (hk : k ≤ 3) : p x k = q x k := by
    have hR : R x = x := boundaryReflection_eq_self_of_tangent x hz
    dsimp only [q]
    rw [hR]
    exact hmatch x hx hz k hk
  have hplus : HasFTaylorSeriesUpToOn 3 (boundaryOddReflection u) jets S := by
    apply (hp.congr (fun x hx => boundaryOddReflection_eq_of_nonneg u x hx.2)).congr_series
    intro k hk x hx
    simp [jets, hx.2]
  have hnegative : HasFTaylorSeriesUpToOn 3 (boundaryOddReflection u) jets T := by
    have hfunction : HasFTaylorSeriesUpToOn 3 (boundaryOddReflection u) q T := by
      apply hminus.congr
      intro x hx
      obtain ⟨hxball, hxnonpos⟩ := (hT x).mp hx
      by_cases h : 0 ≤ x 0
      · have hz : x 0 = 0 := le_antisymm hxnonpos h
        have hR : R x = x := boundaryReflection_eq_self_of_tangent x hz
        simp [boundaryOddReflection, h, hR, hzero x hxball hz]
      · simp only [boundaryOddReflection, if_neg h]
        rfl
    apply hfunction.congr_series
    intro k hk x hx
    obtain ⟨hxball, hxnonpos⟩ := (hT x).mp hx
    by_cases h : 0 ≤ x 0
    · have hz : x 0 = 0 := le_antisymm hxnonpos h
      have hk' : k ≤ 3 := by exact_mod_cast hk
      have hm : x ∈ {x : V | 0 ≤ x 0} := h
      simpa only [jets, Set.piecewise_eq_of_mem _ _ _ hm] using (hface x hxball hz k hk').symm
    · simp [jets, h]
  have hc : Continuous (fun x : V => x 0) :=
    (PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0 : V →L[ℝ] ℝ).continuous
  have hS : IsClosed S := isClosed_closedBall.inter (isClosed_le continuous_const hc)
  have hclosedT : IsClosed T := hS.preimage R.continuous
  have hglued := hplus.union_of_isClosed hnegative hS hclosedT
  rw [hcover] at hglued
  exact hglued.contDiffOn

end ConformalPoisson

end ProofPart_BoundaryAnalytic_BoundaryJetGluing

