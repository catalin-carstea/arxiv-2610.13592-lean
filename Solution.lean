without_proof_info in
theorem contMDiffAt_fixed_ordinaryJet {G : P → E → ℝ} {p : P} {x : E}
    (hG : ContMDiffAt (J.prod 𝓘(ℝ, E)) 𝓘(ℝ) ∞ (uncurry G) (p, x)) :
    ContMDiffAt J 𝓘(ℝ, OrdinaryJet E) ∞
      (fun r => ordinaryJet (G r x) (fderiv ℝ (G r) x) (fderiv ℝ (fderiv ℝ (G r)) x)) p := by
  have h1 := contMDiffAt_joint_fderiv_snd hG
  have h2 := contMDiffAt_joint_fderiv_snd (G := fun r => fderiv ℝ (G r)) h1
  have hslice : ContMDiffAt J (J.prod 𝓘(ℝ, E)) ∞ (fun r : P => (r, x)) p :=
    contMDiffAt_id.prodMk contMDiffAt_const
  change ContMDiffAt J 𝓘(ℝ, ℝ × (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)) ∞
    (fun r => (G r x, fderiv ℝ (G r) x, fderiv ℝ (fderiv ℝ (G r)) x)) p
  exact (hG.comp p hslice).prodMk_space
    ((h1.comp p hslice).prodMk_space (h2.comp p hslice))

without_proof_info in
theorem contMDiffAt_joint_fderiv_fst {G : E → P → F} {p : P} {x : E}
    (hG : ContMDiffAt (𝓘(ℝ, E).prod J) 𝓘(ℝ, F) ∞ (uncurry G) (x, p)) :
    ContMDiffAt (𝓘(ℝ, E).prod J) 𝓘(ℝ, E →L[ℝ] F) ∞
      (fun r : E × P => fderiv ℝ (fun z => G z r.2) r.1) (x, p) := by
