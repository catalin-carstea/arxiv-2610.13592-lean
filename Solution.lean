  have hEu : (u ∘ c.symm) =ᶠ[𝓝 z₀] (fun z => ∫ y, F (c.symm z) y ∂μ) :=
    Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hzW)
      (fun z hz => heq _ (hWU hz))
  have hDu : fderiv ℝ (u ∘ c.symm) z₀ =
      ∫ y, fderiv ℝ (fun z => F (c.symm z) y) z₀ ∂μ :=
    hEu.fderiv_eq.trans hDeriv.fderiv
  have hnative (y : Y) : mvfderiv Ihalf (fun z => F z y) x v =
      fderiv ℝ (fun z => F (c.symm z) y) z₀ v := by
    have hf : MDifferentiableAt Ihalf 𝓘(ℝ) (fun z => F z y) x :=
      (((hF (x, y) ⟨hx, mem_univ _⟩).contMDiffAt
        ((hU.prod isOpen_univ).mem_nhds ⟨hx, mem_univ _⟩)).comp x
          (contMDiffAt_id.prodMk contMDiffAt_const)).mdifferentiableAt (by decide)
    simpa only [TauCeti.Manifold.symmL_trivializationAt_self, Function.comp_def, c, z₀] using
      mvfderiv_inverseChart_vector x (mem_chart_source _ x) hz hf v
  have hIntv : Integrable (fun y => mvfderiv Ihalf (fun z => F z y) x v) μ := by
    exact ((ContinuousLinearMap.apply ℝ ℝ v).integrable_comp hInt).congr
      (Filter.Eventually.of_forall (fun y => (hnative y).symm))
  refine ⟨hIntv, ?_⟩
  have hux := mvfderiv_inverseChart_vector x (mem_chart_source _ x) hz
    (((hu x hx).contMDiffAt (hU.mem_nhds hx)).mdifferentiableAt (by decide)) v
