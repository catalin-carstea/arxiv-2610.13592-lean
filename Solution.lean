      ∀ R : ℝ, 0 < R → R ≤ R₀ →
      ∃ C ≥ 0, ∀ f : M → ℝ, ContMDiffOn Ihalf 𝓘(ℝ) ∞ f U →
      (∀ x ∈ (U : Set M), (𝓡∂ (n + 1)).IsBoundaryPoint x → f x = 0) →
