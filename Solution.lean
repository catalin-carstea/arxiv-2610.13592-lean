    ((hu.comp (A.chart (z : V)) hinv).comp (z : V) hC).contDiffAt
  let F : R.domain → ℝ := fun y => u ((extChartAt (𝓡∂ (n + 1)) α).symm y)
  have hUF : ContMDiffAt 𝓘(ℝ, V) 𝓘(ℝ) 2
      (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm) (A.chart (z : V)) :=
    hu.comp (A.chart (z : V)) hinv
