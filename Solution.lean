noncomputable section ProofPart_NativeAmbientOperator



/- Exact operator readback for the same extended metric on the
physical interior. The ambient Laplacian is transferred through
the proved local isometry with distinct source and target models. -/
open Bundle Set TauCeti TauCeti.Manifold TopologicalSpace
open scoped Manifold Topology ContDiff
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {α : M}

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem NativeMetricAmbientExtension.inverseChart_laplaceBeltrami
    (R : NativeMetricAmbientExtension g α) (x : R.domain)
    (hx : (x : EuclideanSpace ℝ (Fin (n + 1))) ∈ interior (extChartAt (𝓡∂ (n + 1)) α).target)
    (u : M → ℝ) (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u
      ((extChartAt (𝓡∂ (n + 1)) α).symm x)) :
    letI : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩;
    letI : RiemannianBundle (fun y : R.domain =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) := ⟨R.metric.toRiemannianMetric⟩;
    laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))
      (fun y : R.domain => u ((extChartAt (𝓡∂ (n + 1)) α).symm y)) x =
      laplaceBeltrami (𝓡∂ (n + 1)) u ((extChartAt (𝓡∂ (n + 1)) α).symm x) := by
  letI : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  letI : RiemannianBundle (fun y : R.domain =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) := ⟨R.metric.toRiemannianMetric⟩
  let O : Opens R.domain :=
    ⟨(Subtype.val : R.domain → EuclideanSpace ℝ (Fin (n + 1))) ⁻¹'
      interior (extChartAt (𝓡∂ (n + 1)) α).target,
      isOpen_interior.preimage continuous_subtype_val⟩
  let xO : O := ⟨x, hx⟩
  letI : RiemannianBundle (fun y : O =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) :=
    ⟨(R.metric.restrictOpenTangentSpace O).toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 (EuclideanSpace ℝ (Fin (n + 1)))
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  letI : IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) 1
      (EuclideanSpace ℝ (Fin (n + 1)))
      (fun y : R.domain => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ω) (by decide)
  letI : IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) 1
      (EuclideanSpace ℝ (Fin (n + 1)))
      (fun y : O => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ω) (by decide)
  have hinv : ContMDiffAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1)) 2
      (extChartAt (𝓡∂ (n + 1)) α).symm (x : EuclideanSpace ℝ (Fin (n + 1))) :=
    ((contMDiffOn_extChartAt_symm (I := 𝓡∂ (n + 1)) (n := ω) α)
      x (interior_subset hx)).contMDiffAt
        (Filter.mem_of_superset (isOpen_interior.mem_nhds hx) interior_subset) |>.of_le (by decide)
  have hF : ContMDiffAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) 𝓘(ℝ) 2
      (fun y : R.domain => u ((extChartAt (𝓡∂ (n + 1)) α).symm y)) x :=
    hu.comp x (hinv.comp x contMDiff_subtype_val.contMDiffAt)
  have hres := (R.metric.isLocalRiemannianIsometry_restrictOpenTangentSpace O).laplaceBeltrami_comp
    (x := xO) hF
  have hiso := R.inverseChart_isometry O (fun y => y.property)
  have hnat := hiso.laplaceBeltrami_comp (x := xO) hu
  exact hres.symm.trans hnat

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem NativeMetricAmbientExtension.coordinateSchrodinger_eq_original
    (R : NativeMetricAmbientExtension g α) (p x : R.domain)
    (hx : (x : EuclideanSpace ℝ (Fin (n + 1))) ∈ interior (extChartAt (𝓡∂ (n + 1)) α).target)
    (Q : R.domain → ℝ) (q u : M → ℝ)
    (hQ : Q x = q ((extChartAt (𝓡∂ (n + 1)) α).symm x))
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u
      ((extChartAt (𝓡∂ (n + 1)) α).symm x)) :
    letI : RiemannianBundle (fun y : R.domain =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) := ⟨R.metric.toRiemannianMetric⟩;
    coordinateSchrodinger
      (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1)))) p Q)
      (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm) x =
      schrodinger g q u ((extChartAt (𝓡∂ (n + 1)) α).symm x) := by
  letI : RiemannianBundle (fun y : R.domain =>
      TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) := ⟨R.metric.toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) ∞
      (EuclideanSpace ℝ (Fin (n + 1)))
      (fun y : R.domain => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ω) (by decide)
  have hinv : ContMDiffAt 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) (𝓡∂ (n + 1)) 2
      (extChartAt (𝓡∂ (n + 1)) α).symm (x : EuclideanSpace ℝ (Fin (n + 1))) :=
    ((contMDiffOn_extChartAt_symm (I := 𝓡∂ (n + 1)) (n := ω) α)
      x (interior_subset hx)).contMDiffAt
        (Filter.mem_of_superset (isOpen_interior.mem_nhds hx) interior_subset) |>.of_le (by decide)
  have hf : ContDiffAt ℝ 2 (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
      (x : EuclideanSpace ℝ (Fin (n + 1))) :=
    (hu.comp (x : EuclideanSpace ℝ (Fin (n + 1))) hinv).contDiffAt
  have ha := coordinateSchrodinger_ambient_restriction_at R.domain p x Q hf
  rw [ha]
  simp only [Function.comp_apply]
  rw [R.inverseChart_laplaceBeltrami x hx u hu, hQ]
  rfl

end ConformalPoisson

end ProofPart_NativeAmbientOperator

/- Proof support: HalfSpaceRetraction.lean, SHA256 11d0cee20fa36c29ad1708b57d692e8e21290140d706907d3eeccdf06e34a77d -/
noncomputable section ProofPart_HalfSpaceRetraction


/- A continuous retraction to the physical closed half-space.
It supplies a continuous extension of the original potential on
a smaller actual ambient metric domain, preserving its values on
the physical side. No analytic extension of the potential is needed. -/
open Bundle Set Filter TopologicalSpace
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}

def coordinateHalfSpaceRetraction (x : EuclideanSpace ℝ (Fin (n + 1))) :
    EuclideanSpace ℝ (Fin (n + 1)) :=
  x + max (-(x 0)) 0 • EuclideanSpace.single 0 1

without_proof_info in
theorem continuous_coordinateHalfSpaceRetraction :
    Continuous (coordinateHalfSpaceRetraction (n := n)) := by
  unfold coordinateHalfSpaceRetraction
  exact continuous_id.add
    (((PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous.neg.max
      continuous_const).smul continuous_const)

without_proof_info in
theorem coordinateHalfSpaceRetraction_nonneg (x : EuclideanSpace ℝ (Fin (n + 1))) :
    0 ≤ coordinateHalfSpaceRetraction x 0 := by
  change 0 ≤ x 0 + (max (-(x 0)) 0 • EuclideanSpace.single 0 (1 : ℝ)) 0
  simp only [PiLp.smul_apply, PiLp.single_apply, ite_true, smul_eq_mul, mul_one]
  linarith [le_max_left (-(x 0)) (0 : ℝ)]

without_proof_info in
theorem coordinateHalfSpaceRetraction_eq_self
    {x : EuclideanSpace ℝ (Fin (n + 1))} (hx : 0 ≤ x 0) :
    coordinateHalfSpaceRetraction x = x := by
  simp only [coordinateHalfSpaceRetraction, max_eq_right (neg_nonpos.mpr hx), zero_smul, add_zero]

variable {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {α : M}

set_option maxHeartbeats 600000 in
without_proof_info in
theorem NativeMetricAmbientExtension.exists_continuous_potential_extension
    (R : NativeMetricAmbientExtension g α)
    (hcompat : ∀ z ∈ R.domain, 0 ≤ z 0 → z ∈ (extChartAt (𝓡∂ (n + 1)) α).target)
    {q : M → ℝ} (hq : Continuous q) :
    ∃ R' : NativeMetricAmbientExtension g α,
      R'.tensor = R.tensor ∧ R'.domain ≤ R.domain ∧
      ∃ Q : R'.domain → ℝ, Continuous Q ∧
        ∀ z : R'.domain, 0 ≤ (z : EuclideanSpace ℝ (Fin (n + 1))) 0 →
          Q z = q ((extChartAt (𝓡∂ (n + 1)) α).symm z) := by
  let r := coordinateHalfSpaceRetraction (n := n)
  have hr : Continuous r := continuous_coordinateHalfSpaceRetraction
  let U : Opens (EuclideanSpace ℝ (Fin (n + 1))) :=
    ⟨(R.domain : Set _) ∩ r ⁻¹' (R.domain : Set _), R.domain.isOpen.inter (R.domain.isOpen.preimage hr)⟩
  have hc : 0 ≤ (extChartAt (𝓡∂ (n + 1)) α α) 0 := by
    have hh := extChartAt_target_subset_range (I := 𝓡∂ (n + 1)) α
      (mem_extChartAt_target α)
    simpa only [range_modelWithCornersEuclideanHalfSpace, mem_ofPred_eq] using hh
  have hpU : extChartAt (𝓡∂ (n + 1)) α α ∈ U := by
    refine ⟨R.base_mem, ?_⟩
    change r (extChartAt (𝓡∂ (n + 1)) α α) ∈ R.domain
    rw [show r (extChartAt (𝓡∂ (n + 1)) α α) = extChartAt (𝓡∂ (n + 1)) α α from
      coordinateHalfSpaceRetraction_eq_self hc]
    exact R.base_mem
  let R' : NativeMetricAmbientExtension g α :=
    { domain := U
      base_mem := hpU
      tensor := R.tensor
      analytic := R.analytic.mono inter_subset_left
      symmetric := R.symmetric
      positive := fun z hz => R.positive z hz.1
      agrees := R.agrees }
  let Q : R'.domain → ℝ := fun z => q ((extChartAt (𝓡∂ (n + 1)) α).symm (r z))
  refine ⟨R', rfl, (fun _ hz => hz.1), Q, ?_, ?_⟩
  · have hread : ContinuousOn (q ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
        (extChartAt (𝓡∂ (n + 1)) α).target :=
      hq.comp_continuousOn (continuousOn_extChartAt_symm (I := 𝓡∂ (n + 1)) α)
    have hcomp : Continuous (fun z : R'.domain => r (z : EuclideanSpace ℝ (Fin (n + 1)))) :=
      hr.comp continuous_subtype_val
    exact continuousOn_univ.mp (hread.comp hcomp.continuousOn (fun z _ =>
      hcompat (r z) z.property.2 (coordinateHalfSpaceRetraction_nonneg
        (z : EuclideanSpace ℝ (Fin (n + 1))))))
  · intro z hz
    change q ((extChartAt (𝓡∂ (n + 1)) α).symm (r z)) = _
    rw [show r (z : EuclideanSpace ℝ (Fin (n + 1))) = z from
      coordinateHalfSpaceRetraction_eq_self hz]

end ConformalPoisson

end ProofPart_HalfSpaceRetraction

