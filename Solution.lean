  have hreadInner := ae_restrict_of_ae_restrict_of_subset
    (splitBoundaryChartCap_mono c (div_le_self hR.le hpow1)) hread
  rw [lpNorm_congr_ae hreadInner, lpNorm_congr_ae hread] at hest
  exact hest

