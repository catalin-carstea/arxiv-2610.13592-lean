/-- The same transplant preserves the actual canonical H1 test, not
only its pointwise coordinate values. -/
theorem exists_native_test_reading (φ : 𝓓(L.innerCap, ℝ)) :
    ∃ v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x},
      tsupport v.val ⊆ (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V) ∧
      L.innerReadingL (smoothInclusion (E := V) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} v) =
