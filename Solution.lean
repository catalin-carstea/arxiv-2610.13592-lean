def linearRangeClosureMap (e : E →ₗ[ℝ] H) : E →ₗ[ℝ] (LinearMap.range e).topologicalClosure :=
  e.codRestrict (LinearMap.range e).topologicalClosure
    (fun x => (LinearMap.range e).le_topologicalClosure (LinearMap.mem_range_self e x))

