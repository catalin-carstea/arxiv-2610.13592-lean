/- Assignment268, /root. Product tangent/normal directional jets are the
literal slice derivatives used in the finite scalar operator. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set
open scoped ContDiff
namespace ConformalPoisson.LocalDN
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem product_normal_direction {W : E × ℝ → F} (hW : ContDiff ℝ ∞ W) (y : E) (t : ℝ) :
    fderiv ℝ W (y, t) ((0 : E), 1) = deriv (fun r : ℝ => W (y, r)) t := by
  have hl : HasDerivAt (fun r : ℝ => (y, r)) ((0 : E), 1) t :=
    (hasDerivAt_const t y).prodMk (hasDerivAt_id t)
  exact (((hW.differentiable (by decide) (y, t)).hasFDerivAt).comp_hasDerivAt t hl).deriv.symm

without_proof_info in
theorem product_tangent_direction {W : E × ℝ → F} (hW : ContDiff ℝ ∞ W) (y : E) (t : ℝ) (v : E) :
    fderiv ℝ W (y, t) (v, (0 : ℝ)) = fderiv ℝ (fun z => W (z, t)) y v := by
  have hm := (hasFDerivAt_id (𝕜 := ℝ) y).prodMk (hasFDerivAt_const (𝕜 := ℝ) t y)
  have hd := (hW.differentiable (by decide) (y, t)).hasFDerivAt.comp y hm
  have he := congrArg (fun L : E →L[ℝ] F => L v) hd.fderiv
  simpa only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.prod_apply,
    ContinuousLinearMap.id_apply, ContinuousLinearMap.zero_apply, Function.comp_def, id_eq] using he.symm

without_proof_info in
theorem product_normal_twice_direction {W : E × ℝ → F} (hW : ContDiff ℝ ∞ W) (y : E) (t : ℝ) :
    fderiv ℝ (fun x => fderiv ℝ W x ((0 : E), 1)) (y, t) ((0 : E), 1) =
      deriv (deriv (fun r : ℝ => W (y, r))) t := by
  rw [product_normal_direction (directional_fderiv_contDiff hW ((0 : E), (1 : ℝ))) y t]
  have he : (fun r : ℝ => fderiv ℝ W (y, r) ((0 : E), (1 : ℝ))) = deriv (fun r : ℝ => W (y, r)) :=
    funext (fun r => product_normal_direction hW y r)
  rw [he]

without_proof_info in
theorem product_tangent_twice_direction {W : E × ℝ → F} (hW : ContDiff ℝ ∞ W)
    (y : E) (t : ℝ) (u v : E) :
    fderiv ℝ (fun x => fderiv ℝ W x (v, (0 : ℝ))) (y, t) (u, (0 : ℝ)) =
      fderiv ℝ (fun z => fderiv ℝ (fun w => W (w, t)) z v) y u := by
  rw [product_tangent_direction (directional_fderiv_contDiff hW (v, (0 : ℝ))) y t u]
  have he : (fun z => fderiv ℝ W (z, t) (v, (0 : ℝ))) =
      fun z => fderiv ℝ (fun w => W (w, t)) z v := funext (fun z => product_tangent_direction hW z t v)
  rw [he]

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNProductDirectionalReadings

