    {f : EuclideanHalfSpace (n + 1) → F}
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W) (hconn : IsPreconnected W)
    (hf : ∀ y ∈ W, ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f
