noncomputable section ProofPart_GreenTrace_NativeRowCap




/- One compatible actual native row cap for density, principal ellipticity,
small oscillation and avoidance of the pole. Every witness precedes the row. -/
open Bundle Set MeasureTheory TauCeti Metric
open scoped Manifold ContDiff Topology ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

structure NativeRowCap (g : Metric (n := n) (M := M)) (c : M) where
  radius : ℝ
  radius_pos : 0 < radius
  density : ℝ
  density_pos : 0 < density
  lam : ℝ
  lam_pos : 0 < lam
  upper : ℝ
  upper_nonneg : 0 ≤ upper
  target : closedBall (extChartAt Ihalf c c) radius ∩ range Ihalf ⊆ (extChartAt Ihalf c).target
  density_lower : ∀ z ∈ (boundaryChartCap (I := Ihalf) c radius : Set V),
    density ≤ nativeChartDensity g c z
  center_coercive : ∀ ξ : V, lam * ‖ξ‖ ^ 2 ≤
    ⟪nativeChartPrincipal g c (extChartAt Ihalf c c) ξ, ξ⟫_ℝ
  principal_bounds : ∀ z ∈ closedBall (extChartAt Ihalf c c) radius ∩ range Ihalf,
    ‖nativeChartPrincipal g c z - nativeChartPrincipal g c (extChartAt Ihalf c c)‖ ≤ (1 / 4 : ℝ) * lam ∧
    ‖nativeChartPrincipal g c z‖ ≤ upper

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_row_cap_avoiding
    (g : Metric (n := n) (M := M)) (c x : M) (hcx : c ≠ x) :
    ∃ L : NativeRowCap g c,
      x ∉ (extChartAt Ihalf c).source ∩
        extChartAt Ihalf c ⁻¹' (boundaryChartCap (I := Ihalf) c L.radius : Set V) := by
  classical
  let : RiemannianBundle (fun y : M => TangentSpace Ihalf y) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun y : M => TangentSpace Ihalf y) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  obtain ⟨B⟩ := nonempty_boundaryChartLocalization (I := Ihalf) c
  let rPole : ℝ := if hx : x ∈ (extChartAt Ihalf c).source then
    dist (extChartAt Ihalf c x) (extChartAt Ihalf c c) / 2 else B.radius
  have hrPole : 0 < rPole := by
    dsimp only [rPole]
    split_ifs with hx
    · apply half_pos
      apply dist_pos.mpr
      intro heq
      exact hcx ((extChartAt Ihalf c).injOn hx (mem_extChartAt_source c) heq).symm
    · exact B.radius_pos
  obtain ⟨lam, hlam, R, hR, hRB, Λ, hΛ, hcoercive, htarget, hprincipal⟩ :=
    exists_native_boundary_principal_localization_below g c (by norm_num : (0 : ℝ) < 1 / 4)
      (min B.radius rPole) (lt_min B.radius_pos hrPole)
  have hRsmall : R ≤ B.radius := hRB.trans (min_le_left _ _)
  let L : NativeRowCap g c :=
    { radius := R
      radius_pos := hR
      density := B.density
      density_pos := B.density_pos
      lam := lam
      lam_pos := hlam
      upper := Λ
      upper_nonneg := hΛ
      target := htarget
      density_lower := fun z hz => B.density_lower z ⟨ball_subset_ball hRsmall hz.1, hz.2⟩
      center_coercive := hcoercive
      principal_bounds := hprincipal }
  refine ⟨L, ?_⟩
  rintro ⟨hxs, hxcap⟩
  have hdist : dist (extChartAt Ihalf c x) (extChartAt Ihalf c c) < R := hxcap.1
  have hPole : R ≤ dist (extChartAt Ihalf c x) (extChartAt Ihalf c c) / 2 := by
    have h := hRB.trans (min_le_right _ _)
    simpa only [rPole, dif_pos hxs] using h
  linarith [dist_nonneg (x := extChartAt Ihalf c x) (y := extChartAt Ihalf c c)]

end ConformalPoisson

end ProofPart_GreenTrace_NativeRowCap

