noncomputable section ProofPart_NativeCoordinateEnergyIntegral




/- Change of variables for the actual native Schrodinger energy.
No weak equation or unproved compatibility law is taken as a premise. -/
open Bundle Set MeasureTheory TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson


variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
local notation "V" => EuclideanSpace ℝ (Fin d)
local instance energyIntegralContinuousMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := 1)

without_proof_info in
/-- Integrate the native energy exactly in a coordinate region. The
relative boundary is not crossed: the region lies in the ordinary chart
interior, while its closure may meet the native boundary later. -/
theorem setIntegral_native_energy_eq_chart (c : M) {Ω : Set V} (hΩ : IsOpen Ω)
    (hΩt : Ω ⊆ interior (extChartAt I c).target) {u v : M → ℝ}
    (hu : ContMDiffOn I 𝓘(ℝ) 1 u ((extChartAt I c).source ∩ extChartAt I c ⁻¹' Ω))
    (hv : ContMDiffOn I 𝓘(ℝ) 1 v ((extChartAt I c).source ∩ extChartAt I c ⁻¹' Ω))
    (q : M → ℝ) :
    ∫ x in (extChartAt I c).source ∩ extChartAt I c ⁻¹' Ω,
        (⟪mgradient I u x, mgradient I v x⟫_ℝ + q x * u x * v x) ∂riemannianVolume I M =
      ∫ z in Ω, energyIntegrand (chartWeightedPrincipal (I := I) c z) 0
        (chartWeightedPotential (I := I) c q z)
        (u ((extChartAt I c).symm z), ∇ (u ∘ (extChartAt I c).symm) z)
        (v ((extChartAt I c).symm z), ∇ (v ∘ (extChartAt I c).symm) z)
          ∂(Module.finBasis ℝ V).addHaar := by
  have hΩt' : Ω ⊆ (extChartAt I c).target := hΩt.trans interior_subset
  have hsub : (extChartAt I c).source ∩ extChartAt I c ⁻¹' Ω ⊆ (chartAt H c).source := by
    rw [← extChartAt_source (I := I)]
    exact inter_subset_left
  rw [setIntegral_native_chart_preimage c hΩ hΩt']
  apply setIntegral_congr_fun (μ := (Module.finBasis ℝ V).addHaar) hΩ.measurableSet
  intro z hz
  have hzt := hΩt' hz
  have hx := (extChartAt I c).map_target hzt
  have hround := (extChartAt I c).right_inv hzt
  have hxΩ : (extChartAt I c).symm z ∈ (extChartAt I c).source ∩ extChartAt I c ⁻¹' Ω :=
    ⟨hx, by simpa only [mem_preimage, hround] using hz⟩
  have hxs : (extChartAt I c).symm z ∈ (chartAt H c).source := hsub hxΩ
  have hxi : extChartAt I c ((extChartAt I c).symm z) ∈ interior (extChartAt I c).target := by
    simpa only [hround] using hΩt hz
  have hE := energyIntegrand_chartWeighted c hxs hxi
    ((hu.contMDiffAt ((isOpen_extChartAt_preimage' c hΩ).mem_nhds hxΩ)).mdifferentiableAt one_ne_zero)
    ((hv.contMDiffAt ((isOpen_extChartAt_preimage' c hΩ).mem_nhds hxΩ)).mdifferentiableAt one_ne_zero) q
  simpa only [hround, smul_eq_mul] using hE.symm
end ConformalPoisson

end ProofPart_NativeCoordinateEnergyIntegral

