  have hWU : MapsTo c.symm W U := fun z hz => (hεsub hz).2
  have hcW : ContMDiffOn 𝓘(ℝ, V) Ihalf ∞ c.symm W :=
    (contMDiffOn_extChartAt_symm x).mono hWt
