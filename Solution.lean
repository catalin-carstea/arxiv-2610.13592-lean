      ((Complex.ofRealCLM.contDiff.comp_contDiffOn contDiffOn_snd).pow j)
  apply hs.congr
  intro x hx
  exact (P x.1).eval_eq_sum_range' (hD x.1 hx.1) (x.2 : ℂ)

def polynomialProfileFamily (κ : E → ℝ) (P : E → ℂ[X]) (x : E × ℝ) : ℂ :=
  Real.exp (-κ x.1 * x.2) • (P x.1).eval (x.2 : ℂ)

