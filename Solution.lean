/- Boundary analytic support: NormalEquationTerms.lean, SHA256 6966481996291db3a6ca1c605208cd8820870d4cdbb025dc612bc2a798849e25 -/
noncomputable section ProofPart_BoundaryAnalytic_NormalEquationTerms



/- The finite differential words of the actual scalar operator in metric
normal coordinates. No principal normal/tangential mixed term is introduced. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

abbrev ScalarNormalTermIndex (n : ℕ) := (Fin n × Fin n) ⊕ (Fin n ⊕ Bool)

variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def scalarNormalTermDirections : ScalarNormalTermIndex n → List V
  | Sum.inl (i, j) => [EuclideanSpace.single i.succ 1, EuclideanSpace.single j.succ 1]
  | Sum.inr (Sum.inl i) => [EuclideanSpace.single i.succ 1]
  | Sum.inr (Sum.inr _) => []

def scalarNormalTermOrder : ScalarNormalTermIndex n → ℕ
  | Sum.inl _ => 0
  | Sum.inr (Sum.inl _) => 0
  | Sum.inr (Sum.inr b) => if b then 1 else 0

def scalarNormalTermCoefficient (A : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) :
    ScalarNormalTermIndex n → V → ℝ
  | Sum.inl (i, j) => fun x => -A x (EuclideanSpace.single i.succ 1) j.succ
  | Sum.inr (Sum.inl i) => fun x => b x i.succ
  | Sum.inr (Sum.inr false) => q
  | Sum.inr (Sum.inr true) => fun x => b x 0

without_proof_info in
theorem scalarNormalTermOrder_le_one (i : ScalarNormalTermIndex n) : scalarNormalTermOrder i ≤ 1 := by
  cases i with
  | inl ij => simp [scalarNormalTermOrder]
  | inr i => cases i with
    | inl i => simp [scalarNormalTermOrder]
    | inr b => cases b <;> simp [scalarNormalTermOrder]

without_proof_info in
theorem scalarNormalTerm_total_order_le_two (i : ScalarNormalTermIndex n) :
    (scalarNormalTermDirections i).length + scalarNormalTermOrder i ≤ 2 := by
  cases i with
  | inl ij => rcases ij with ⟨i, j⟩; simp [scalarNormalTermDirections, scalarNormalTermOrder]
  | inr i => cases i with
    | inl i => simp [scalarNormalTermDirections, scalarNormalTermOrder]
    | inr b => cases b <;> simp [scalarNormalTermDirections, scalarNormalTermOrder]

without_proof_info in
theorem scalarNormalTermDirections_tangent (i : ScalarNormalTermIndex n) :
    ∀ v ∈ scalarNormalTermDirections i, boundaryTangentialProjection v = v := by
  cases i with
  | inl ij =>
    rcases ij with ⟨i, j⟩
    intro v hv
    simp [scalarNormalTermDirections] at hv
    rcases hv with rfl | rfl <;> apply boundaryTangentialProjection_eq_self <;> simp
  | inr i => cases i with
    | inl i =>
      intro v hv
      simp only [scalarNormalTermDirections, List.mem_singleton] at hv
      subst v
      apply boundaryTangentialProjection_eq_self
      simp
    | inr b => simp [scalarNormalTermDirections]

without_proof_info in
theorem tangent_vector_eq_sum_coordinate (v : V) (hv : v 0 = 0) :
    v = ∑ i : Fin n, v i.succ • EuclideanSpace.single i.succ 1 := by
  have h := (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).sum_repr v
  simpa only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply,
    Fin.sum_univ_succ, hv, zero_smul, zero_add] using h.symm

end ConformalPoisson

end ProofPart_BoundaryAnalytic_NormalEquationTerms

