/-- The same actual compatible value/derivative family is analytic in
Holder norm once its two uniform-norm fields are holomorphic. -/
theorem analyticAt_c1BallHolder {α : ℝ≥0} (hα : α ≤ 1)
    {g : P → c1BallGraph (V := V) (F := F)} {U : Set P} (hU : IsOpen U)
    (hg : AnalyticOnNhd ℂ (fun p => (g p).val) U) {p : P} (hp : p ∈ U) :
    AnalyticAt ℝ (fun q => c1BallHolder hα (g q)) p := by
