  apply ContinuousMultilinearMap.opNorm_le_bound (by positivity)
  intro v
  have hv : (fun i : Fin k => ∑ j : Fin (n + 1), v i j • EuclideanSpace.single j 1) = v := by
    funext i
    simpa only [EuclideanSpace.basisFun_repr, EuclideanSpace.basisFun_apply] using
      (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).sum_repr (v i)
  nth_rw 1 [← hv]
  rw [A.map_sum]
  calc
    _ ≤ ∑ m : Fin k → Fin (n + 1),
        ‖A (fun i => v i (m i) • EuclideanSpace.single (m i) 1)‖ := norm_sum_le _ _
    _ ≤ ∑ _m : Fin k → Fin (n + 1), K * ∏ i, ‖v i‖ := by
      apply Finset.sum_le_sum
      intro m _
      rw [A.map_smul_univ, norm_smul, norm_prod]
      have hprod : (∏ i : Fin k, ‖v i (m i)‖) ≤ ∏ i, ‖v i‖ :=
        Finset.prod_le_prod₀ (fun i _ => norm_nonneg _) (fun i _ => PiLp.norm_apply_le (v i) (m i))
      calc
        _ ≤ (∏ i : Fin k, ‖v i‖) * K :=
          mul_le_mul hprod (hA m) (norm_nonneg _) (by positivity)
        _ = _ := mul_comm _ _
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
        nsmul_eq_mul, Nat.cast_pow, Nat.cast_add, Nat.cast_one]
      ring

end ConformalPoisson

