/- Bounded local value/gradient readback from an actual native weak element.
This uses uniqueness of coordinate weak derivatives. It neither assumes a
boundaryless manifold nor identifies entire native H1 elements by their values. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson.BoundaryChartLocalization
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [CompactSpace M] [IsManifold I 2 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
