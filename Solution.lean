open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {ι : Type*} [Fintype ι] {μ : Measure (EuclideanSpace ℝ ι)} [μ.IsAddHaarMeasure]
  {Ω : Opens (EuclideanSpace ℝ ι)} {S K : Set (EuclideanSpace ℝ ι)}

without_proof_info in
theorem exists_relative_differentiated_equation
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ K) (hΩS : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ interior S)
    {a : EuclideanSpace ℝ ι → Matrix ι ι ℝ}
    (ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S)
    (hcoeff : MemLp (fun x => energyIntegrand (a x) 0 0) ⊤ (μ.restrict Ω))
    (k : ℕ) {F : Wkp μ Ω 2 (k + 1)} {u : W1p μ Ω 2}
    (hw : ∃ w : Wkp μ Ω 2 (k + 2), Wkp.value (k + 2) w = W1p.value u)
    (hu : ∀ v : W1p0 μ Ω 2, energyFormH1 a 0 0 u v.val =
      ∫ x in Ω, Wkp.value (k + 1) F x * W1p.value v.val x ∂μ)
    (e : EuclideanSpace ℝ ι) :
    ∃ (d : W1p μ Ω 2) (G : Wkp μ Ω 2 k),
      HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value d) e ∧
      ∀ v : W1p0 μ Ω 2, energyFormH1 a 0 0 d v.val =
        ∫ x in Ω, Wkp.value k G x * W1p.value v.val x ∂μ := by
  obtain ⟨w, hw⟩ := hw
  let b := EuclideanSpace.basisFun ι ℝ
  have haΩ : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) Ω :=
    fun i j => (ha i j).mono (hΩS.trans interior_subset)
  choose D hD using fun j => Wkp.exists_hasWeakLineDerivOn_value (k + 1) w (b j)
  choose E hE using fun i j => Wkp.exists_hasWeakLineDerivOn_value k (D j) (b i)
  obtain ⟨De, hDe⟩ := Wkp.exists_hasWeakLineDerivOn_value (k + 1) w e
  obtain ⟨Fe, hFe⟩ := Wkp.exists_hasWeakLineDerivOn_value k F e
  rw [hw] at hD hDe
  have hD' : ∀ j, HasWeakLineDerivOn μ Ω (W1p.value u)
      (W1p.value (Wkp.firstOrder k (D j))) (b j) := fun j => by
    rw [Wkp.value_firstOrder]; exact hD j
  have hda := fun i j => relative_smooth_directional_derivative hS (ha i j) e
  choose M₁ hM₁ using fun i j => exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k
    (relative_smooth_directional_derivative hS (hda i j) (b i)) (Wkp.lowerOrder k (D j))
  choose M₂ hM₂ using fun i j => exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k
    (hda i j) (E i j)
  have hd : HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value (Wkp.firstOrder k De)) e := by
    rw [Wkp.value_firstOrder]; exact hDe
  refine ⟨Wkp.firstOrder k De, Fe + ∑ i, ∑ j, (M₁ i j + M₂ i j), hd, ?_⟩
  have hut := (forall_energyFormH1_eq_setIntegral_iff_forall_testFunction hcoeff _ u).1 hu
  refine (forall_energyFormH1_eq_setIntegral_iff_forall_testFunction hcoeff _ _).2 fun φ => ?_
  refine (energyFormH1_ofTestFunctionₗ_eq_setIntegral_of_hasWeakLineDerivOn haΩ hut hd hD' hFe φ).trans ?_
  refine integral_congr_ae ?_
  have hu₁ : ∀ᵐ x ∂μ.restrict Ω, ∀ i j, Wkp.value k (M₁ i j) x =
      fderiv ℝ (fun y => fderiv ℝ (fun z => a z i j) y e) x (b i) *
        ⟪W1p.gradient u x, b j⟫_ℝ := by
    refine Filter.eventually_all.2 fun i => Filter.eventually_all.2 fun j => ?_
    filter_upwards [hM₁ i j, (hD j).ae_eq ((W1p.hasWeakFDerivOn u).hasWeakLineDerivOn (b j)),
      ae_restrict_mem Ω.isOpen.measurableSet] with x h₁ h₂ hxΩ
    rw [h₁, ← Wkp.value_succ, h₂, innerSL_apply_apply,
      relative_second_directional_derivative_eq_of_mem_interior (hΩS hxΩ) e (b i)]
  have hu₂ : ∀ᵐ x ∂μ.restrict Ω, ∀ i j, Wkp.value k (M₂ i j) x =
      fderiv ℝ (fun y => a y i j) x e *
        ⟪W1p.gradient (Wkp.firstOrder k (D j)) x, b i⟫_ℝ := by
    refine Filter.eventually_all.2 fun i => Filter.eventually_all.2 fun j => ?_
    have h := (W1p.hasWeakFDerivOn (Wkp.firstOrder k (D j))).hasWeakLineDerivOn (b i)
    rw [Wkp.value_firstOrder] at h
    filter_upwards [hM₂ i j, (hE i j).ae_eq h, ae_restrict_mem Ω.isOpen.measurableSet]
      with x h₁ h₂ hxΩ
    rw [h₁, h₂, innerSL_apply_apply,
      fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp (hΩS hxΩ))]
  filter_upwards [Wkp.ae_value_add_sum_eq Fe Finset.univ Finset.univ M₁ M₂
    (hu₁.mono fun x h i _ j _ => h i j) (hu₂.mono fun x h i _ j _ => h i j)] with x hx
  rw [hx]
end ConformalPoisson

end ProofPart_RelativeDifferentiatedEquation

/- Proof support: RelativeBoundaryRegularity.lean, SHA256 84052e3ca0291da42fac6ea50c1e274991e5ba4bccebab3160c6d7eb6e06b00d -/
noncomputable section ProofPart_RelativeBoundaryRegularity






/- Higher boundary regularity on flat caps for coefficients smooth on
the relative target. The induction follows the differentiated-equation
organization of pinned Tau Ceti Regularity/HigherOrder.lean (copyright
2026 The Tau Ceti contributors, Apache2.0; External/LICENSE.tauceti).
Here the physical face is retained: tangential derivatives have local
zero trace, and the equation recovers the missing normal derivatives.
The coefficient estimates are the relative-target multiplier theorems.
-/
open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal NNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
local notation "E" => EuclideanSpace ℝ (Fin (n + 1))
variable {Ω U V : Opens (EuclideanSpace ℝ (Fin (n + 1)))}
  {S K : Set (EuclideanSpace ℝ (Fin (n + 1)))}
  {a : EuclideanSpace ℝ (Fin (n + 1)) → Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ}
  {b : EuclideanSpace ℝ (Fin (n + 1)) → EuclideanSpace ℝ (Fin (n + 1))}
  {c : EuclideanSpace ℝ (Fin (n + 1)) → ℝ} {lam Lam : ℝ} {C : ℝ≥0}

without_proof_info in
private theorem exists_firstCoordinate_boundary_H2
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set E) ∩ U ⊆ Ω)
    (ha : UniformlyEllipticOn (Ω : Set E) a lam Lam)
    (hLip : LipschitzOnWith C (fun x => matrixBilinearForm (a x)) Ω)
    (hb : MemLp b ⊤ (μ.restrict Ω)) (hc : MemLp c ⊤ (μ.restrict Ω))
    {f : Lp ℝ 2 (μ.restrict Ω)} {u : W1p μ Ω 2}
    (hu : ∀ v : W1p0 μ Ω 2, energyFormH1 a b c u v.val =
      ∫ x in Ω, f x * W1p.value v.val x ∂μ)
    (hu0 : ∀ ψ : E → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    (hV : IsCompact (closure (V : Set E))) (hVU : closure (V : Set E) ⊆ U) :
    ∃ W : Wkp μ (Ω ⊓ V) 2 2,
      Wkp.lowerOrder 1 W = W1p.restrictL (inf_le_left : Ω ⊓ V ≤ Ω) u := by
  let ν := EuclideanSpace.basisFun (Fin (n + 1)) ℝ 0
  have hν : ν ≠ 0 := (EuclideanSpace.basisFun (Fin (n + 1)) ℝ).toBasis.ne_zero 0
  have hH : ∀ x : E, x ∈ euclideanOpenHalfSpace n 0 ↔ (0 : ℝ) < ⟪x, ν⟫_ℝ := by
    intro x
    simp only [euclideanOpenHalfSpace, Opens.mem_mk, Set.mem_ofPred_eq,
      ν, EuclideanSpace.inner_basisFun_real]
  have hΩU : (Ω : Set E) ∩ U = (euclideanOpenHalfSpace n 0 : Set E) ∩ U :=
    Subset.antisymm (fun x hx => ⟨hΩH hx.1, hx.2⟩) (fun x hx => ⟨hHU hx, hx.2⟩)
  exact (ha.mono_set inter_subset_left).exists_lowerOrder_eq_restrictL_of_halfSpace
    hν hH hΩU (hLip.mono inter_subset_left) hb hc hu hu0 hV hVU

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_relative_boundary_higher_regularity
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set E) ⊆ K) (hΩS : (Ω : Set E) ⊆ interior S)
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set E) ∩ U ⊆ Ω)
    (ha : UniformlyEllipticOn (Ω : Set E) a lam Lam)
    (hLip : LipschitzOnWith C (fun x => matrixBilinearForm (a x)) Ω)
    (hsmooth : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S)
    (ha0 : ∀ x ∈ S, a x 0 0 ≠ 0)
    (hcoeff : MemLp (fun x => energyIntegrand (a x) 0 0) ⊤ (μ.restrict Ω))
    (hb : ContDiffOn ℝ ∞ b S) (hc : ContDiffOn ℝ ∞ c S)
    (k : ℕ) {F : Wkp μ Ω 2 k} {u : W1p μ Ω 2}
    (hu : ∀ v : W1p0 μ Ω 2, energyFormH1 a b c u v.val =
      ∫ x in Ω, Wkp.value k F x * W1p.value v.val x ∂μ)
    (hu0 : ∀ ψ : E → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    (hV : IsCompact (closure (V : Set E))) (hVU : closure (V : Set E) ⊆ U) :
    ∃ W : Wkp μ (Ω ⊓ V) 2 (k + 2),
      Wkp.value (k + 2) W = W1p.value (W1p.restrictL (inf_le_left : Ω ⊓ V ≤ Ω) u) := by
  classical
  induction k generalizing Ω U V b c u with
  | zero =>
    obtain ⟨W, hW⟩ := exists_firstCoordinate_boundary_H2 hΩH hHU ha hLip
      ((hb.continuousOn.mono hKS).memLp_top_restrict_of_subset_isCompact hK Ω.isOpen.measurableSet hΩK)
      ((hc.continuousOn.mono hKS).memLp_top_restrict_of_subset_isCompact hK Ω.isOpen.measurableSet hΩK)
      hu hu0 hV hVU
    exact ⟨W, (Wkp.value_succ 1 W).trans ((Wkp.value_one _).trans
      (congrArg (fun v : W1p μ (Ω ⊓ V) 2 => W1p.value v) hW))⟩
  | succ k ih =>
    obtain ⟨Wset, hWopen, hVW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hV U.isOpen hVU
    let W : Opens E := ⟨Wset, hWopen⟩
    have hW_U : (W : Set E) ⊆ U := subset_closure.trans hWU
    have hV_W : (V : Set E) ⊆ W := subset_closure.trans hVW
    obtain ⟨Bset, hBopen, hVB, hBW, hBc⟩ := exists_open_between_and_isCompact_closure hV hWopen hVW
    let B : Opens E := ⟨Bset, hBopen⟩
    have hB_W : (B : Set E) ⊆ W := subset_closure.trans hBW
    let ΩW := Ω ⊓ W
    let D := Ω ⊓ V
    have hDW : D ≤ ΩW := fun x hx => ⟨hx.1, hV_W hx.2⟩
    have hDDW : D ≤ ΩW ⊓ V := fun x hx => ⟨hDW hx, hx.2⟩
    let R := W1p.restrictL (inf_le_left : ΩW ≤ Ω) u
    let RD := W1p.restrictL (inf_le_left : D ≤ Ω) u
    have hR_D : W1p.restrictL hDW R = RD :=
