noncomputable section ProofPart_CoordinateJetsFromNative




/-
Equality of actual native second jets gives equality of actual ordinary jets in
any fixed interior chart. This is the reverse comparison needed to use native
Runge interpolation in the coordinate coefficient-recovery argument.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem coordinate_derivatives_eq_of_secondJet_eq
    (g : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (hint : extChartAt (𝓡∂ (n + 1)) α x ∈ interior (extChartAt (𝓡∂ (n + 1)) α).target)
    {u v : M → ℝ} (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u x)
    (hv : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 v x)
    (h : secondJet g u x = secondJet g v x) :
    u x = v x ∧
      fderiv ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
        (extChartAt (𝓡∂ (n + 1)) α x) =
      fderiv ℝ (v ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
        (extChartAt (𝓡∂ (n + 1)) α x) ∧
      fderiv ℝ (fderiv ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm))
        (extChartAt (𝓡∂ (n + 1)) α x) =
      fderiv ℝ (fderiv ℝ (v ∘ (extChartAt (𝓡∂ (n + 1)) α).symm))
        (extChartAt (𝓡∂ (n + 1)) α x) := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  have hD := congrArg (fun j : JetSpace g x => j.2.1) h
  change mvfderiv (𝓡∂ (n + 1)) u x = mvfderiv (𝓡∂ (n + 1)) v x at hD
  have hfirst : fderiv ℝ (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
      (extChartAt (𝓡∂ (n + 1)) α x) =
      fderiv ℝ (v ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
      (extChartAt (𝓡∂ (n + 1)) α x) := by
    ext w
    rw [← mvfderiv_inverseChart_vector α hx hint (hu.mdifferentiableAt (by decide)),
      ← mvfderiv_inverseChart_vector α hx hint (hv.mdifferentiableAt (by decide)), hD]
  refine ⟨congrArg (fun j : JetSpace g x => j.1) h, hfirst, ?_⟩
  ext z w
  let Z := (trivializationAt V (TangentSpace (𝓡∂ (n + 1))) α).symmL ℝ x z
  let W := (trivializationAt V (TangentSpace (𝓡∂ (n + 1))) α).symmL ℝ x w
  have hH : TauCeti.Manifold.hessian (𝓡∂ (n + 1)) u x Z W =
      TauCeti.Manifold.hessian (𝓡∂ (n + 1)) v x Z W := by
    have ht := congrArg (fun j : JetSpace g x => g.inner x (j.2.2 Z) W) h
    rw [TauCeti.Manifold.hessian_def, TauCeti.Manifold.hessian_def]
    exact ht
  dsimp only [Z, W] at hH
  rw [hessian_fixedChart_christoffel α hx hint hu,
    hessian_fixedChart_christoffel α hx hint hv, hfirst] at hH
  exact sub_left_inj.mp hH

end ConformalPoisson

end ProofPart_CoordinateJetsFromNative

/- Proof support: CoordinateCoefficientRecovery.lean, SHA256 1a96c63946d7e0618f29f443c53c96728c0cfe3104f59f6ea4e50ddd062c0ff6 -/
noncomputable section ProofPart_CoordinateCoefficientRecovery





/-
Recovery of an ordinary scalar second-order operator from its kernel on symmetric
second jets. Symmetry of the two principal tensors is essential: symmetric Hessians
cannot determine an antisymmetric part. Positive definiteness fixes the sign of
the proportionality factor. The native coefficient-recovery caller will supply
these actual coordinate coefficients and exact solution jets.
-/

open scoped BigOperators

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  {ι : Type*} [Fintype ι]

/-- A symmetric Hessian testing two arbitrary covectors. -/
def symmetricCovectorProduct (v w : E) : symmetricBilinearSubmodule E :=
  ⟨(innerSL ℝ v).smulRight (innerSL ℝ w) +
    (innerSL ℝ w).smulRight (innerSL ℝ v), by
      intro z t
      simp only [add_apply, ContinuousLinearMap.smulRight_apply, smul_apply,
        innerSL_apply_apply, smul_eq_mul]
      ring⟩

without_proof_info in
theorem principalContraction_symmetricCovectorProduct
    (e : OrthonormalBasis ι ℝ E) (A : E →L[ℝ] E) (v w : E) :
    principalContraction e (symmetricCovectorProduct v w).val A =
      inner ℝ w (A v) + inner ℝ v (A w) := by
  change principalContraction e
    ((innerSL ℝ v).smulRight (innerSL ℝ w) +
      (innerSL ℝ w).smulRight (innerSL ℝ v)) A = _
  simp only [principalContraction, LinearMap.coe_mk, AddHom.coe_mk, add_apply,
    Finset.sum_add_distrib]
  exact congrArg₂ (· + ·) (principalContraction_covectorProduct e A v w)
    (principalContraction_covectorProduct e A w v)

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
/-- Symmetric Hessian tests determine a symmetric principal endomorphism. -/
theorem principalContraction_separates_symmetric (e : OrthonormalBasis ι ℝ E)
    {A C : E →L[ℝ] E}
    (hA : A.toLinearMap.IsSymmetric) (hC : C.toLinearMap.IsSymmetric)
    (h : ∀ B : symmetricBilinearSubmodule E,
      principalContraction e B.val A = principalContraction e B.val C) : A = C := by
  ext v
  apply ext_inner_left ℝ
  intro w
  have ht := h (symmetricCovectorProduct v w)
  rw [principalContraction_symmetricCovectorProduct,
    principalContraction_symmetricCovectorProduct] at ht
  have ha : inner ℝ v (A w) = inner ℝ w (A v) := by
    simpa only [real_inner_comm] using (hA.apply_clm v w).symm
  have hc : inner ℝ v (C w) = inner ℝ w (C v) := by
    simpa only [real_inner_comm] using (hC.apply_clm v w).symm
  rw [ha, hc] at ht
  linarith

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
/-- Proportional full jet functionals have proportional principal, drift and potential. -/
theorem coordinateCoefficients_eq_of_jetEquation_eq_smul
    {a₁ a₂ : V →L[ℝ] V} {b₁ b₂ : V} {q₁ q₂ k : ℝ}
    (ha₁ : a₁.toLinearMap.IsSymmetric) (ha₂ : a₂.toLinearMap.IsSymmetric)
    (h : coordinateJetEquation a₂ b₂ q₂ = k • coordinateJetEquation a₁ b₁ q₁) :
    a₂ = k • a₁ ∧ b₂ = k • b₁ ∧ q₂ = k * q₁ := by
  have heq (j : FlatJet V) : coordinateJetEquation a₂ b₂ q₂ j =
      k * coordinateJetEquation a₁ b₁ q₁ j := congrArg (fun L => L j) h
  have hq : q₂ = k * q₁ := by
    simpa [coordinateJetEquation] using heq (1, 0, 0)
  have hb : b₂ = k • b₁ := by
    apply ext_inner_left ℝ
    intro w
    have ht := heq (0, innerSL ℝ w, 0)
    simpa [coordinateJetEquation, inner_smul_right] using ht
  refine ⟨?_, hb, hq⟩
  apply principalContraction_separates_symmetric (EuclideanSpace.basisFun (Fin d) ℝ)
    ha₂ (by
      simpa only [ContinuousLinearMap.toLinearMap_smul] using
        (LinearMap.IsSymmetric.smul (show star k = k by simp) ha₁))
  intro B
  have ht := heq (0, 0, B)
  have ht' : -(principalContraction (EuclideanSpace.basisFun (Fin d) ℝ) B.val a₂) =
      k * (-(principalContraction (EuclideanSpace.basisFun (Fin d) ℝ) B.val a₁)) := by
    simpa only [coordinateJetEquation, principalContraction, LinearMap.coe_mk, AddHom.coe_mk,
      EuclideanSpace.basisFun_apply, zero_apply, mul_zero, add_zero] using ht
  rw [map_smul]
  change principalContraction (EuclideanSpace.basisFun (Fin d) ℝ) B.val a₂ =
    k * principalContraction (EuclideanSpace.basisFun (Fin d) ℝ) B.val a₁
  linarith

without_proof_info in
/-- The equation functional is nonzero whenever the principal tensor has one positive direction. -/
theorem exists_coordinateEquation_unit_jet
    (a : V →L[ℝ] V) (b : V) (q : ℝ) (w : V) (hw : 0 < inner ℝ w (a w)) :
    ∃ j : FlatJet V, coordinateJetEquation a b q j = 1 := by
  let B : symmetricBilinearSubmodule V :=
    ⟨(innerSL ℝ w).smulRight (innerSL ℝ w), by
      intro v z
      simp only [ContinuousLinearMap.smulRight_apply, smul_apply, innerSL_apply_apply, smul_eq_mul]
      ring⟩
  let j : FlatJet V := (0, 0, (-1 / inner ℝ w (a w)) • B)
  refine ⟨j, ?_⟩
  change -(∑ i, (-1 / inner ℝ w (a w)) *
    B.val (EuclideanSpace.single i 1) (a (EuclideanSpace.single i 1))) + 0 + q * 0 = 1
  rw [← Finset.mul_sum]
  have hB := principalContraction_covectorProduct (EuclideanSpace.basisFun (Fin d) ℝ) a w w
  have hB' : (∑ i, B.val (EuclideanSpace.single i 1) (a (EuclideanSpace.single i 1))) =
      inner ℝ w (a w) := by
    simpa only [principalContraction, LinearMap.coe_mk, AddHom.coe_mk,
      EuclideanSpace.basisFun_apply, B] using hB
  rw [hB']
  field_simp
  nlinarith

without_proof_info in
/-- The finite-dimensional kernel step, with all three coefficient conclusions. -/
theorem coordinateCoefficients_eq_multiple_of_ker_le
    {a₁ a₂ : V →L[ℝ] V} {b₁ b₂ : V} {q₁ q₂ : ℝ}
    (ha₁ : a₁.toLinearMap.IsSymmetric) (ha₂ : a₂.toLinearMap.IsSymmetric)
    (w : V) (hw : 0 < inner ℝ w (a₁ w))
    (hker : ∀ j : FlatJet V, coordinateJetEquation a₁ b₁ q₁ j = 0 →
      coordinateJetEquation a₂ b₂ q₂ j = 0) :
    ∃ k : ℝ, a₂ = k • a₁ ∧ b₂ = k • b₁ ∧ q₂ = k * q₁ := by
  obtain ⟨j, hj⟩ := exists_coordinateEquation_unit_jet a₁ b₁ q₁ w hw
  have h := linearForm_eq_smul_of_ker_le (coordinateJetEquation a₁ b₁ q₁)
    (coordinateJetEquation a₂ b₂ q₂) (fun j hj => hker j hj) j hj
  exact ⟨coordinateJetEquation a₂ b₂ q₂ j,
    coordinateCoefficients_eq_of_jetEquation_eq_smul ha₁ ha₂ h⟩

without_proof_info in
/-- Ellipticity of both actual coefficients forces the recovered scalar to be positive. -/
theorem coordinateCoefficients_eq_positive_multiple_of_ker_le
    {a₁ a₂ : V →L[ℝ] V} {b₁ b₂ : V} {q₁ q₂ : ℝ}
    (ha₁ : a₁.toLinearMap.IsSymmetric) (ha₂ : a₂.toLinearMap.IsSymmetric)
    (w : V) (hw₁ : 0 < inner ℝ w (a₁ w)) (hw₂ : 0 < inner ℝ w (a₂ w))
    (hker : ∀ j : FlatJet V, coordinateJetEquation a₁ b₁ q₁ j = 0 →
      coordinateJetEquation a₂ b₂ q₂ j = 0) :
    ∃ k : ℝ, 0 < k ∧ a₂ = k • a₁ ∧ b₂ = k • b₁ ∧ q₂ = k * q₁ := by
  obtain ⟨k, ha, hb, hq⟩ := coordinateCoefficients_eq_multiple_of_ker_le ha₁ ha₂ w hw₁ hker
  refine ⟨k, ?_, ha, hb, hq⟩
  rw [ha] at hw₂
  simp only [smul_apply, inner_smul_right] at hw₂
  exact pos_of_mul_pos_left hw₂ hw₁.le

end ConformalPoisson

end ProofPart_CoordinateCoefficientRecovery

/- Proof support: CoordinateProductOperator.lean, SHA256 421e320f573ad2615fb40da66815a9287d2af54128d65da1e54d2effdef791ef -/
noncomputable section ProofPart_CoordinateProductOperator




/-
The actual coordinate operator after multiplying the unknown by a scalar function.
The two cross terms are kept explicitly, so this formula does not require symmetry
of the principal endomorphism. Its coefficients will feed jet-kernel recovery.
-/

open scoped BigOperators ContDiff

namespace ConformalPoisson

variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

/-- The first-order vector produced by the two Hessian cross terms. -/
def principalCrossVector (a : V →L[ℝ] V) (ξ : V →L[ℝ] ℝ) : V :=
  ∑ i, (ξ (EuclideanSpace.single i 1) • a (EuclideanSpace.single i 1) +
    ξ (a (EuclideanSpace.single i 1)) • EuclideanSpace.single i 1)

without_proof_info in
theorem covector_principalCrossVector (a : V →L[ℝ] V) (ξ η : V →L[ℝ] ℝ) :
    η (principalCrossVector a ξ) = ∑ i,
      (ξ (EuclideanSpace.single i 1) * η (a (EuclideanSpace.single i 1)) +
      η (EuclideanSpace.single i 1) * ξ (a (EuclideanSpace.single i 1))) := by
  simp only [principalCrossVector, map_sum, map_add, map_smul, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro i _
  ring

without_proof_info in
/-- The coordinate jet functional evaluates the actual coordinate operator. -/
theorem coordinateJetEquation_flatJetAt
    (a : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ) (x : V)
    (hu : ContDiffAt ℝ 2 u x) :
    coordinateJetEquation (a x) (b x) (q x) (flatJetAt u x hu) =
      coordinateSchrodinger a b q u x := rfl

without_proof_info in
/-- Product conjugation of the actual second-order operator at one point. -/
theorem coordinateSchrodinger_mul
    (a : V → V →L[ℝ] V) (b : V → V) (q c v : V → ℝ) (x : V)
    (hc : ContDiffAt ℝ 2 c x) (hv : ContDiffAt ℝ 2 v x) :
    coordinateSchrodinger a b q (c * v) x =
      coordinateJetEquation (c x • a x)
        (c x • b x - principalCrossVector (a x) (fderiv ℝ c x))
        (coordinateSchrodinger a b q c x) (flatJetAt v x hv) := by
  have hd := fderiv_mul (hc.differentiableAt (by norm_num)) (hv.differentiableAt (by norm_num))
  change -(∑ i, fderiv ℝ (fderiv ℝ (c * v)) x (EuclideanSpace.single i 1)
      (a x (EuclideanSpace.single i 1))) + fderiv ℝ (c * v) x (b x) + q x * (c x * v x) =
    -(∑ i, fderiv ℝ (fderiv ℝ v) x (EuclideanSpace.single i 1)
      ((c x • a x) (EuclideanSpace.single i 1))) +
    fderiv ℝ v x (c x • b x - principalCrossVector (a x) (fderiv ℝ c x)) +
    (-(∑ i, fderiv ℝ (fderiv ℝ c) x (EuclideanSpace.single i 1)
      (a x (EuclideanSpace.single i 1))) + fderiv ℝ c x (b x) + q x * c x) * v x
  simp only [TauCeti.fderiv_fderiv_mul_apply hc hv, hd, smul_apply, smul_eq_mul,
    add_apply, map_sub, map_smul, covector_principalCrossVector, Finset.sum_add_distrib,
    ← Finset.mul_sum]
  ring

without_proof_info in
/-- A homogeneous product makes the transformed jet functional vanish. -/
theorem coordinateJetEquation_product_eq_zero
    (a : V → V →L[ℝ] V) (b : V → V) (q c v : V → ℝ) (x : V)
    (hc : ContDiffAt ℝ 2 c x) (hv : ContDiffAt ℝ 2 v x)
    (h : coordinateSchrodinger a b q (c * v) x = 0) :
    coordinateJetEquation (c x • a x)
      (c x • b x - principalCrossVector (a x) (fderiv ℝ c x))
      (coordinateSchrodinger a b q c x) (flatJetAt v x hv) = 0 := by
  rw [← coordinateSchrodinger_mul a b q c v x hc hv]
  exact h

end ConformalPoisson

end ProofPart_CoordinateProductOperator

/- Proof support: NativeCoordinateCoefficients.lean, SHA256 70014847e78ccb810b328f0f151716a6c509627543dd88a8bd7fa9d57307deb7 -/
noncomputable section ProofPart_NativeCoordinateCoefficients





/-
Coordinate coefficients bound to an explicit native metric, so simultaneous
operator comparisons cannot silently select another ambient metric instance.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def nativeChartPrincipal (g : Metric (n := n) (M := M)) (α : M) : V → V →L[ℝ] V :=
  letI : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩;
  chartPrincipalCoefficient (I := 𝓡∂ (n + 1)) α

def nativeChartDrift (g : Metric (n := n) (M := M)) (α : M) : V → V :=
  letI : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩;
  letI : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
    (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
      IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide);
  chartDriftCoefficient (I := 𝓡∂ (n + 1)) α

def nativeChartPotential (α : M) (q : M → ℝ) : V → ℝ :=
  chartPotentialCoefficient (I := 𝓡∂ (n + 1)) α q

without_proof_info in
theorem nativeCoordinateSchrodinger_eq (g : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (hint : extChartAt (𝓡∂ (n + 1)) α x ∈ interior (extChartAt (𝓡∂ (n + 1)) α).target)
    (q : M → ℝ) {u : M → ℝ} (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u x) :
    coordinateSchrodinger (nativeChartPrincipal g α) (nativeChartDrift g α)
      (nativeChartPotential α q) (u ∘ (extChartAt (𝓡∂ (n + 1)) α).symm)
      (extChartAt (𝓡∂ (n + 1)) α x) = schrodinger g q u x := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : ContMDiffVectorBundle 1 V (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1)) :=
    TangentBundle.contMDiffVectorBundle
  exact coordinateSchrodinger_eq_native α hx hint q hu

end ConformalPoisson

end ProofPart_NativeCoordinateCoefficients

/- Proof support: ExactCoordinateJets.lean, SHA256 fb2052e6176d415ee4f46069b3a994cbeb64941ac4ce7e7a5556395b92072069 -/
noncomputable section ProofPart_ExactCoordinateJets







/-
The project native Runge/Schauder theorem realizes every compatible ordinary
second jet of the same actual operator in an interior chart. A chart quadratic
converts the target to a compatible native jet; the reverse jet comparison then
recovers its actual ordinary derivatives from the global solution.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_datum_with_coordinate_jet
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M) (j : FlatJet V)
    (hj : coordinateJetEquation (nativeChartPrincipal g x (extChartAt (𝓡∂ (n + 1)) x x))
      (nativeChartDrift g x (extChartAt (𝓡∂ (n + 1)) x x))
      (nativeChartPotential x q (extChartAt (𝓡∂ (n + 1)) x x)) j = 0) :
    ∃ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      S.solve f.val x = j.1 ∧
      fderiv ℝ (S.solve f.val ∘ (extChartAt (𝓡∂ (n + 1)) x).symm)
        (extChartAt (𝓡∂ (n + 1)) x x) = j.2.1 ∧
      fderiv ℝ (fderiv ℝ (S.solve f.val ∘ (extChartAt (𝓡∂ (n + 1)) x).symm))
        (extChartAt (𝓡∂ (n + 1)) x x) = j.2.2.val := by
  let z := extChartAt (𝓡∂ (n + 1)) x x
  let P := centeredJetPolynomial z j
  let w := chartFunction (I := 𝓡∂ (n + 1)) x P
  have hint : z ∈ interior (extChartAt (𝓡∂ (n + 1)) x).target :=
    ModelWithCorners.isInteriorPoint_iff.mp hx
  have hP : ContDiff ℝ ∞ P := contDiff_centeredJetPolynomial z j
  have hP2 : ContDiffAt ℝ 2 P z := hP.contDiffAt.of_le (by decide)
  have hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 w x :=
    contMDiffAt_chartFunction x (mem_chart_source _ x) hP2
  have hPjet : flatJetAt P z hP2 = j := by
    refine Prod.ext (centeredJetPolynomial_value z j)
      (Prod.ext (centeredJetPolynomial_fderiv z j) ?_)
    exact Subtype.ext (centeredJetPolynomial_secondFDeriv z j)
  have hLw : schrodinger g q w x = 0 := by
    rw [← nativeCoordinateSchrodinger_eq g x (mem_chart_source _ x) hint q hw]
    rw [coordinateSchrodinger_eq_of_eventuallyEq _ _ _
      (chartFunction_read_eventually x P hint)]
    rw [← coordinateJetEquation_flatJetAt _ _ _ P z hP2, hPjet]
    exact hj
  let J : compatibleJetSubmodule g q x :=
    ⟨secondJet g w x, secondJet_mem_compatibleJetSubmodule g q hw hLw⟩
  obtain ⟨f, hf⟩ := exists_datum_with_compatible_jets_of_schauder
    hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ
    1 (fun _ => x) (fun i k _ => Subsingleton.elim i k) (fun _ => hx) (fun _ => J)
  have hsmooth : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (S.solve f.val) x :=
    ((S.correct f.val f.property.1).1.contMDiffAt).of_le (by decide)
  obtain ⟨hvalue, hfirst, hsecond⟩ := coordinate_derivatives_eq_of_secondJet_eq g x
    (mem_chart_source _ x) hint hsmooth hw (hf 0)
  refine ⟨f, hvalue.trans (centeredJetPolynomial_value z j), ?_, ?_⟩
  · exact hfirst.trans ((chartFunction_read_fderiv x P hint).trans
      (centeredJetPolynomial_fderiv z j))
  · exact hsecond.trans ((chartFunction_read_secondFDeriv x P hint).trans
      (centeredJetPolynomial_secondFDeriv z j))

end ConformalPoisson

end ProofPart_ExactCoordinateJets

/- Proof support: NativePrincipalEllipticity.lean, SHA256 a2d663f077b2e3172d7d48f91684f209810293b22b074059aee098dd21105e91 -/
noncomputable section ProofPart_NativePrincipalEllipticity



/- Symmetry and strict ellipticity of the same actual inverse chart metric. -/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

section Factor

variable {E W : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup W] [InnerProductSpace ℝ W] [CompleteSpace W]

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem factor_comp_adjoint_symmetric (C : W →L[ℝ] E) :
    (C.comp C.adjoint).toLinearMap.IsSymmetric := by
  intro v w
  change inner ℝ (C (C.adjoint v)) w = inner ℝ v (C (C.adjoint w))
  rw [← C.adjoint_inner_right, ← C.adjoint_inner_left]

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem factor_comp_adjoint_positive (C : W ≃L[ℝ] E) {v : E} (hv : v ≠ 0) :
    0 < inner ℝ v ((C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint) v) := by
  have hne : C.toContinuousLinearMap.adjoint v ≠ 0 := by
    intro hzero
    have h := C.toContinuousLinearMap.adjoint_inner_left (C.symm v) v
    rw [hzero, inner_zero_left] at h
    change 0 = inner ℝ v (C (C.symm v)) at h
    rw [C.apply_symm_apply] at h
    exact hv (inner_self_eq_zero.mp h.symm)
  change 0 < inner ℝ v (C.toContinuousLinearMap (C.toContinuousLinearMap.adjoint v))
  rw [← C.toContinuousLinearMap.adjoint_inner_left]
  exact real_inner_self_pos.mpr hne

end Factor

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 400000 in
set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem nativeChartPrincipal_symmetric_positive
    (g : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source) :
    (nativeChartPrincipal g α (extChartAt (𝓡∂ (n + 1)) α x)).toLinearMap.IsSymmetric ∧
      ∀ w : V, w ≠ 0 → 0 < inner ℝ w
        (nativeChartPrincipal g α (extChartAt (𝓡∂ (n + 1)) α x) w) := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  obtain ⟨C, hC⟩ := chartPrincipalCoefficient_factor (I := 𝓡∂ (n + 1)) α hx
  change (chartPrincipalCoefficient (I := 𝓡∂ (n + 1)) α
    (extChartAt (𝓡∂ (n + 1)) α x)).toLinearMap.IsSymmetric ∧
      ∀ w : V, w ≠ 0 → 0 < inner ℝ w
        (chartPrincipalCoefficient (I := 𝓡∂ (n + 1)) α
          (extChartAt (𝓡∂ (n + 1)) α x) w)
  rw [hC]
  exact ⟨factor_comp_adjoint_symmetric C.toContinuousLinearMap,
    fun w hw => factor_comp_adjoint_positive C hw⟩

end ConformalPoisson

end ProofPart_NativePrincipalEllipticity

/- Proof support: CoordinateRecoveryFromSolutions.lean, SHA256 b2ef284ab330706d4151db48ca2fc118d6cde939151320150e267bb9ac929ad3 -/
noncomputable section ProofPart_CoordinateRecoveryFromSolutions




/-
A coefficient-recovery caller for the actual supported Dirichlet solution family.
Its full compatible ordinary jet range is supplied by the project proof, rather
than assumed as a new PDE input. The second operator's coefficients are explicit.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

without_proof_info in
theorem coordinateCoefficients_of_native_solution_family
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (a : V →L[ℝ] V) (b : V) (p : ℝ) (ha : a.toLinearMap.IsSymmetric)
    (hapos : ∀ w : V, w ≠ 0 → 0 < inner ℝ w (a w))
    (hsolutions : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      coordinateSchrodinger (fun _ => a) (fun _ => b) (fun _ => p)
        (S.solve f.val ∘ (extChartAt (𝓡∂ (n + 1)) x).symm)
        (extChartAt (𝓡∂ (n + 1)) x x) = 0) :
    ∃ k : ℝ, 0 < k ∧
      a = k • nativeChartPrincipal g x (extChartAt (𝓡∂ (n + 1)) x x) ∧
      b = k • nativeChartDrift g x (extChartAt (𝓡∂ (n + 1)) x x) ∧
      p = k * nativeChartPotential x q (extChartAt (𝓡∂ (n + 1)) x x) := by
  obtain ⟨hg, hgpos⟩ := nativeChartPrincipal_symmetric_positive g x (mem_chart_source _ x)
  let w : V := EuclideanSpace.single (0 : Fin (n + 1)) 1
  have hw : w ≠ 0 := by simp [w]
  apply coordinateCoefficients_eq_positive_multiple_of_ker_le hg ha w (hgpos w hw) (hapos w hw)
  intro j hj
  obtain ⟨f, hval, hfirst, hsecond⟩ := exists_datum_with_coordinate_jet
    hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ x hx j hj
  have h := hsolutions f
  have hround : (extChartAt (𝓡∂ (n + 1)) x).symm (extChartAt (𝓡∂ (n + 1)) x x) = x :=
    (extChartAt (𝓡∂ (n + 1)) x).left_inv (mem_extChartAt_source x)
  simpa only [coordinateSchrodinger, hsecond, hfirst, Function.comp_apply, hround,
    hval, coordinateJetEquation, LinearMap.coe_mk, AddHom.coe_mk] using h

end ConformalPoisson

end ProofPart_CoordinateRecoveryFromSolutions

/- Proof support: ScaledCoordinateRecovery.lean, SHA256 649a759e1e60db791794bfc09d7c12868174b51c2734322d1e314364636a24ed -/
noncomputable section ProofPart_ScaledCoordinateRecovery



/-
Coefficient recovery for a scalar multiple of the actual partial-boundary solution
family, after both problems have been written in one coordinate domain. The
product operator and full jet range are project proofs, not extra assumptions.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem coordinateCoefficients_of_scaled_native_solution_family
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M)
    (a : V → V →L[ℝ] V) (b : V → V) (p c : V → ℝ)
    (hc : ContDiffAt ℝ 2 c (extChartAt (𝓡∂ (n + 1)) x x))
    (hcpos : 0 < c (extChartAt (𝓡∂ (n + 1)) x x))
    (ha : (a (extChartAt (𝓡∂ (n + 1)) x x)).toLinearMap.IsSymmetric)
    (hapos : ∀ w : V, w ≠ 0 → 0 < inner ℝ w (a (extChartAt (𝓡∂ (n + 1)) x x) w))
    (hsolutions : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      coordinateSchrodinger a b p
        (c * (S.solve f.val ∘ (extChartAt (𝓡∂ (n + 1)) x).symm))
        (extChartAt (𝓡∂ (n + 1)) x x) = 0) :
    ∃ k : ℝ, 0 < k ∧
      c (extChartAt (𝓡∂ (n + 1)) x x) • a (extChartAt (𝓡∂ (n + 1)) x x) =
        k • nativeChartPrincipal g x (extChartAt (𝓡∂ (n + 1)) x x) ∧
      c (extChartAt (𝓡∂ (n + 1)) x x) • b (extChartAt (𝓡∂ (n + 1)) x x) -
          principalCrossVector (a (extChartAt (𝓡∂ (n + 1)) x x))
            (fderiv ℝ c (extChartAt (𝓡∂ (n + 1)) x x)) =
        k • nativeChartDrift g x (extChartAt (𝓡∂ (n + 1)) x x) ∧
      coordinateSchrodinger a b p c (extChartAt (𝓡∂ (n + 1)) x x) =
        k * nativeChartPotential x q (extChartAt (𝓡∂ (n + 1)) x x) := by
  let z := extChartAt (𝓡∂ (n + 1)) x x
  apply coordinateCoefficients_of_native_solution_family hSchauder hRunge hdim hcompact
    hconnected hq hNR S Γ hΓ x hx (c z • a z)
    (c z • b z - principalCrossVector (a z) (fderiv ℝ c z))
    (coordinateSchrodinger a b p c z)
  · simpa only [ContinuousLinearMap.toLinearMap_smul] using
      LinearMap.IsSymmetric.smul (show star (c z) = c z by simp) ha
  · intro w hw
    change 0 < inner ℝ w (c z • a z w)
    rw [inner_smul_right]
    exact mul_pos hcpos (hapos w hw)
  · intro f
    have hint : z ∈ interior (extChartAt (𝓡∂ (n + 1)) x).target :=
      ModelWithCorners.isInteriorPoint_iff.mp hx
    have hu : ContDiffAt ℝ 2 (S.solve f.val ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) z :=
      ((contDiffOn_read_interiorChart x (S.correct f.val f.property.1).1.contMDiffOn).contDiffAt
        (isOpen_interior.mem_nhds hint)).of_le (by decide)
    rw [← coordinateJetEquation_flatJetAt _ _ _ _ z hu]
    exact coordinateJetEquation_product_eq_zero a b p c _ z hc hu (hsolutions f)

end ConformalPoisson

end ProofPart_ScaledCoordinateRecovery

/- Proof support: OpenChartRead.lean, SHA256 2cf709d27d84808157377115a99d468ea6add46af1330a0d00f94def4bc1220c -/
noncomputable section ProofPart_OpenChartRead




/- Actual coordinate germs of a scalar function and its open-submanifold restriction. -/

open Set Filter
open scoped Manifold Topology

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]

without_proof_info in
theorem extChartAt_restrictOpen_self (U : TopologicalSpace.Opens M) (x : U) :
    extChartAt I x x = extChartAt I (x : M) (x : M) := by
  simp [extChartAt, TopologicalSpace.Opens.chartAt_eq]

without_proof_info in
theorem read_restrictOpen_eventuallyEq (U : TopologicalSpace.Opens M) (x : U) (f : M → ℝ) :
    (fun y : U => f y) ∘ (extChartAt I x).symm =ᶠ[𝓝 (extChartAt I (x : M) (x : M))]
      f ∘ (extChartAt I (x : M)).symm := by
  have hc : Tendsto I.symm (𝓝 (extChartAt I (x : M) (x : M)))
      (𝓝 (chartAt H (x : M) (x : M))) := by
    simpa only [extChartAt, OpenPartialHomeomorph.extend_coe, Function.comp_apply,
      I.left_inv] using I.continuous_symm.tendsto (extChartAt I (x : M) (x : M))
  have h := (U.chartAt_subtype_val_symm_eventuallyEq (x := x)).comp_tendsto hc
  simpa only [extChartAt, OpenPartialHomeomorph.extend_coe_symm, Function.comp_def]
    using (h.fun_comp f).symm

without_proof_info in
theorem read_restrictOpen_fderiv (U : TopologicalSpace.Opens M) (x : U) (f : M → ℝ) :
    fderiv ℝ ((fun y : U => f y) ∘ (extChartAt I x).symm)
        (extChartAt I (x : M) (x : M)) =
      fderiv ℝ (f ∘ (extChartAt I (x : M)).symm) (extChartAt I (x : M) (x : M)) :=
  (read_restrictOpen_eventuallyEq U x f).fderiv_eq

without_proof_info in
theorem read_restrictOpen_secondFDeriv (U : TopologicalSpace.Opens M) (x : U) (f : M → ℝ) :
    fderiv ℝ (fderiv ℝ ((fun y : U => f y) ∘ (extChartAt I x).symm))
        (extChartAt I (x : M) (x : M)) =
      fderiv ℝ (fderiv ℝ (f ∘ (extChartAt I (x : M)).symm))
        (extChartAt I (x : M) (x : M)) := by
  have h := read_restrictOpen_eventuallyEq (I := I) U x f
  have hd : fderiv ℝ ((fun y : U => f y) ∘ (extChartAt I x).symm) =ᶠ[𝓝 (extChartAt I (x : M) (x : M))]
      fderiv ℝ (f ∘ (extChartAt I (x : M)).symm) :=
    h.eventuallyEq_nhds.mono fun _ hw => hw.fderiv_eq (𝕜 := ℝ)
  exact hd.fderiv_eq

end ConformalPoisson

end ProofPart_OpenChartRead

/- Proof support: NativeOpenCoefficients.lean, SHA256 674790074aa194827c410b2802396e094ba2f43bd3fade158b0b6f76ef47a098 -/
noncomputable section ProofPart_NativeOpenCoefficients







/-
The full coordinate equation functional is unchanged by restricting the actual
metric/potential to an open submanifold and using its inherited chart. This binds
local pullback calculations to the original compact-manifold jet producer.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 400000 in
without_proof_info in
theorem nativeCoordinateJetEquation_restrictOpen
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (U : TopologicalSpace.Opens M)
    (x : U) (hx : (𝓡∂ (n + 1)).IsInteriorPoint (x : M)) :
    coordinateJetEquation
      (nativeChartPrincipal (g.restrictOpenTangentSpace U) x (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)))
      (nativeChartDrift (g.restrictOpenTangentSpace U) x (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)))
      (nativeChartPotential x (fun y : U => q y) (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M))) =
    coordinateJetEquation
      (nativeChartPrincipal g (x : M) (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)))
      (nativeChartDrift g (x : M) (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)))
      (nativeChartPotential (x : M) q (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M))) := by
  let z := extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)
  have hcenter := extChartAt_restrictOpen_self (I := 𝓡∂ (n + 1)) U x
  have hxU : (𝓡∂ (n + 1)).IsInteriorPoint x :=
    (𝓡∂ (n + 1)).isInteriorPoint_iff_isInteriorPoint_val.mpr hx
  have hint := ModelWithCorners.isInteriorPoint_iff.mp hx
  have hintU := ModelWithCorners.isInteriorPoint_iff.mp hxU
  apply LinearMap.ext
  intro j
  let P := centeredJetPolynomial z j
  let w := chartFunction (I := 𝓡∂ (n + 1)) (x : M) P
  have hP : ContDiffAt ℝ 2 P z := (contDiff_centeredJetPolynomial z j).contDiffAt.of_le (by decide)
  have hjet : flatJetAt P z hP = j := by
    refine Prod.ext (centeredJetPolynomial_value z j)
      (Prod.ext (centeredJetPolynomial_fderiv z j) ?_)
    exact Subtype.ext (centeredJetPolynomial_secondFDeriv z j)
  have hw : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 w (x : M) :=
    contMDiffAt_chartFunction (x : M) (mem_chart_source _ _) hP
  have hwU : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 (fun y : U => w y) x :=
    hw.comp x contMDiff_subtype_val.contMDiffAt
  have hread : (w ∘ (extChartAt (𝓡∂ (n + 1)) (x : M)).symm) =ᶠ[𝓝 z] P :=
    chartFunction_read_eventually (x : M) P hint
  have hreadU : ((fun y : U => w y) ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) =ᶠ[𝓝 z] P :=
    (read_restrictOpen_eventuallyEq U x w).trans hread
  have hM := nativeCoordinateSchrodinger_eq g (x : M) (mem_chart_source _ _) hint q hw
  have hU := nativeCoordinateSchrodinger_eq (g.restrictOpenTangentSpace U) x
    (mem_chart_source _ _) hintU (fun y : U => q y) hwU
  rw [hcenter] at hU
  have hrestrict := schrodinger_restrictOpen g U q w x hw
  rw [coordinateSchrodinger_eq_of_eventuallyEq _ _ _ hread] at hM
  rw [coordinateSchrodinger_eq_of_eventuallyEq _ _ _ hreadU] at hU
  rw [← hjet]
  rw [coordinateJetEquation_flatJetAt, coordinateJetEquation_flatJetAt]
  exact hU.trans (hrestrict.trans hM.symm)

end ConformalPoisson

end ProofPart_NativeOpenCoefficients

/- Proof support: OpenScaledCoordinateRecovery.lean, SHA256 3c60b9a7f715c05dadc9f86e459172a8a117d94ec34a993a4bd20676e22c75b5 -/
noncomputable section ProofPart_OpenScaledCoordinateRecovery




/-
An actual homogeneous scaled family for a metric on an open submanifold supplies
the coordinate recovery premise, using exact jets from the original compact
manifold. No Dirichlet/Runge theorem on the open submanifold is assumed.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

set_option maxHeartbeats 400000 in
without_proof_info in
theorem coordinateCoefficients_of_open_scaled_native_family
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (U : TopologicalSpace.Opens M) (h : Metric (n := n) (M := U)) (p r : U → ℝ)
    (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r) (hrpos : ∀ x, 0 < r x)
    (x : U) (hx : (𝓡∂ (n + 1)).IsInteriorPoint (x : M))
    (hsolutions : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      schrodinger h p (fun y : U => r y * S.solve f.val y) x = 0) :
    let z := extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)
    let R := r ∘ (extChartAt (𝓡∂ (n + 1)) x).symm
    ∃ k : ℝ, 0 < k ∧
      r x • nativeChartPrincipal h x z = k • nativeChartPrincipal g (x : M) z ∧
      r x • nativeChartDrift h x z - principalCrossVector (nativeChartPrincipal h x z)
          (fderiv ℝ R z) = k • nativeChartDrift g (x : M) z ∧
      coordinateSchrodinger (nativeChartPrincipal h x) (nativeChartDrift h x)
        (nativeChartPotential x p) R z = k * nativeChartPotential (x : M) q z := by
  let z := extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)
  let R := r ∘ (extChartAt (𝓡∂ (n + 1)) x).symm
  have hcenter := extChartAt_restrictOpen_self (I := 𝓡∂ (n + 1)) U x
  have hxU := (𝓡∂ (n + 1)).isInteriorPoint_iff_isInteriorPoint_val.mpr hx
  have hint := ModelWithCorners.isInteriorPoint_iff.mp hxU
  have hR : ContDiffAt ℝ 2 R z := by
    change ContDiffAt ℝ 2 R (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M))
    rw [← hcenter]
    exact ((contDiffOn_read_interiorChart x hr.contMDiffOn).contDiffAt
      (isOpen_interior.mem_nhds hint)).of_le (by decide)
  have hRval : R z = r x := by
    change r ((extChartAt (𝓡∂ (n + 1)) x).symm
      (extChartAt (𝓡∂ (n + 1)) (x : M) (x : M))) = r x
    rw [← hcenter, (extChartAt (𝓡∂ (n + 1)) x).left_inv (mem_extChartAt_source x)]
  obtain ⟨ha, hapos⟩ := nativeChartPrincipal_symmetric_positive h x (mem_chart_source _ _)
  rw [hcenter] at ha hapos
  have hcoord (f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M))) :
      coordinateSchrodinger (nativeChartPrincipal h x) (nativeChartDrift h x)
        (nativeChartPotential x p) (R * (S.solve f.val ∘
          (extChartAt (𝓡∂ (n + 1)) (x : M)).symm)) z = 0 := by
    let v : U → ℝ := fun y => r y * S.solve f.val y
    have hv : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ v :=
      hr.mul ((S.correct f.val f.property.1).1.comp contMDiff_subtype_val)
    have heq : (R * (S.solve f.val ∘ (extChartAt (𝓡∂ (n + 1)) (x : M)).symm)) =ᶠ[𝓝 z]
        (v ∘ (extChartAt (𝓡∂ (n + 1)) x).symm) := by
      filter_upwards [read_restrictOpen_eventuallyEq U x (S.solve f.val)] with t ht
      change R t * S.solve f.val ((extChartAt (𝓡∂ (n + 1)) (x : M)).symm t) = _
      simp only [Function.comp_apply] at ht
      rw [← ht]
      rfl
    rw [coordinateSchrodinger_eq_of_eventuallyEq _ _ _ heq]
    have hnative := nativeCoordinateSchrodinger_eq h x (mem_chart_source _ _) hint p
      (hv.contMDiffAt.of_le (by decide))
    rw [hcenter] at hnative
    exact hnative.trans (hsolutions f)
  obtain ⟨k, hk, hA, hB, hP⟩ := coordinateCoefficients_of_scaled_native_solution_family
    hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ
    (x : M) hx (nativeChartPrincipal h x) (nativeChartDrift h x) (nativeChartPotential x p)
    R hR (hRval ▸ hrpos x) ha hapos hcoord
  exact ⟨k, hk, hRval ▸ hA, hRval ▸ hB, hP⟩

end ConformalPoisson

end ProofPart_OpenScaledCoordinateRecovery

/- Proof support: OpenPrincipalComparison.lean, SHA256 273a819df8af488214acce91475743afd3fe99f4466304c44fc558f9fa89d03a -/
noncomputable section ProofPart_OpenPrincipalComparison




/- All actual coordinate coefficients agree under inherited open restriction. -/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem nativeChartCoefficients_restrictOpen
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (U : TopologicalSpace.Opens M)
    (x : U) (hx : (𝓡∂ (n + 1)).IsInteriorPoint (x : M)) :
    let z := extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)
    nativeChartPrincipal (g.restrictOpenTangentSpace U) x z = nativeChartPrincipal g (x : M) z ∧
      nativeChartDrift (g.restrictOpenTangentSpace U) x z = nativeChartDrift g (x : M) z ∧
      nativeChartPotential x (fun y : U => q y) z = nativeChartPotential (x : M) q z := by
  have hM := (nativeChartPrincipal_symmetric_positive g (x : M) (mem_chart_source _ _)).1
  have hU := (nativeChartPrincipal_symmetric_positive (g.restrictOpenTangentSpace U) x
    (mem_chart_source _ _)).1
  rw [extChartAt_restrictOpen_self U x] at hU
  have h := coordinateCoefficients_eq_of_jetEquation_eq_smul hM hU (k := 1) (by
    simpa only [one_smul] using nativeCoordinateJetEquation_restrictOpen g q U x hx)
  simpa only [one_smul, one_mul] using h

end ConformalPoisson

end ProofPart_OpenPrincipalComparison

/- Proof support: InverseMetricUniqueness.lean, SHA256 aeeb960936b13eb00398feaa4afdcb7843ef766a8efdbb55c3fb40f02931bd94 -/
noncomputable section ProofPart_InverseMetricUniqueness



/-
An inverse metric coefficient determines its coordinate Gram matrix. This is
finite-dimensional algebra with the actual (possibly nonorthonormal) basis.
-/

open scoped BigOperators

namespace ConformalPoisson

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  {ι : Type*} [Fintype ι] [DecidableEq ι]

def basisCoordinateCovector (b : Module.Basis ι ℝ E) (i : ι) : E →L[ℝ] ℝ :=
  LinearMap.toContinuousLinearMap (b.coord i)

omit [Fintype ι] in
without_proof_info in
@[simp] theorem basisCoordinateCovector_apply_basis
    (b : Module.Basis ι ℝ E) (i j : ι) :
    basisCoordinateCovector b i (b j) = if j = i then 1 else 0 := by
  simp [basisCoordinateCovector, Module.Basis.coord_apply, Finsupp.single_apply]

without_proof_info in
theorem inverseMetricOperator_injective (b : Module.Basis ι ℝ E) :
    Function.Injective (inverseMetricOperator b : Matrix ι ι ℝ → E →L[ℝ] E) := by
  intro G H h
  ext i j
  let B := (basisCoordinateCovector b i).smulRight (basisCoordinateCovector b j)
  have ht := congrArg (fun A => principalContraction (stdOrthonormalBasis ℝ E) B A) h
  rw [principalContraction_inverseMetricOperator, principalContraction_inverseMetricOperator] at ht
  simp only [B, ContinuousLinearMap.smulRight_apply, smul_apply, smul_eq_mul,
    basisCoordinateCovector_apply_basis] at ht
  simpa using ht

omit [FiniteDimensional ℝ E] [DecidableEq ι] in
without_proof_info in
theorem inverseMetricOperator_smul (b : Module.Basis ι ℝ E) (r : ℝ) (G : Matrix ι ι ℝ) :
    inverseMetricOperator b (r • G) = r • inverseMetricOperator b G := by
  simp only [inverseMetricOperator, Matrix.smul_apply, smul_eq_mul, Finset.smul_sum,
    smul_smul]

without_proof_info in
/-- No nonsingular-inverse conclusion is inferred without invertibility. -/
theorem gramMatrix_eq_of_inverseMetricOperator_eq (b : Module.Basis ι ℝ E)
    {G H : Matrix ι ι ℝ} (hG : IsUnit G.det)
    (h : inverseMetricOperator b G⁻¹ = inverseMetricOperator b H⁻¹) : G = H :=
  Matrix.inv_inj ((inverseMetricOperator_injective b) h) hG

end ConformalPoisson

end ProofPart_InverseMetricUniqueness

/- Proof support: NativeMetricUniqueness.lean, SHA256 721381fc4c8dd792d8bdf20a08208ed8a90614c0d3cd29e8eaa151ce5db1138a -/
noncomputable section ProofPart_NativeMetricUniqueness




/-
The actual inverse chart coefficient determines the actual native metric at the
point. Both metrics are explicit; no common Riemannian-instance identification is
assumed in comparing them.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "ι" => Fin (Module.finrank ℝ V)

def nativeChartGram (g : Metric (n := n) (M := M)) (α x : M) : Matrix ι ι ℝ :=
  letI : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩;
  Riemannian.Tensor.chartGramMatrix (I := 𝓡∂ (n + 1)) α x

without_proof_info in
theorem nativeChartGram_apply (g : Metric (n := n) (M := M)) (α x : M) (i j : ι) :
    nativeChartGram g α x i j =
      g.inner x
        ((trivializationAt V (TangentSpace (𝓡∂ (n + 1))) α).symmL ℝ x
          (Module.finBasis ℝ V i))
        ((trivializationAt V (TangentSpace (𝓡∂ (n + 1))) α).symmL ℝ x
          (Module.finBasis ℝ V j)) := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  exact (Riemannian.Tensor.chartGramMatrix_apply α x i j).trans (by
    rw [Riemannian.Tensor.chartLocalFrame_eq_symmL,
      Riemannian.Tensor.chartLocalFrame_eq_symmL]
    rfl)

without_proof_info in
theorem nativeChartPrincipal_eq_inverseMetricOperator
    (g : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source) :
    nativeChartPrincipal g α (extChartAt (𝓡∂ (n + 1)) α x) =
      inverseMetricOperator (Module.finBasis ℝ V) (nativeChartGram g α x)⁻¹ := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  have hround : (extChartAt (𝓡∂ (n + 1)) α).symm (extChartAt (𝓡∂ (n + 1)) α x) = x :=
    (extChartAt (𝓡∂ (n + 1)) α).left_inv (by rwa [extChartAt_source])
  simp only [nativeChartPrincipal, chartPrincipalCoefficient, hround,
    Riemannian.Tensor.chartInvGramMatrix_def, nativeChartGram]

without_proof_info in
theorem nativeChartGram_det_pos (g : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source) :
    0 < (nativeChartGram g α x).det := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  exact Riemannian.Tensor.chartGramMatrix_det_pos α (by simpa using hx)

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem nativeMetric_inner_eq_of_chartPrincipal_eq
    (g h : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (heq : nativeChartPrincipal g α (extChartAt (𝓡∂ (n + 1)) α x) =
      nativeChartPrincipal h α (extChartAt (𝓡∂ (n + 1)) α x)) :
    g.inner x = h.inner x := by
  have hG : nativeChartGram g α x = nativeChartGram h α x := by
    apply gramMatrix_eq_of_inverseMetricOperator_eq (Module.finBasis ℝ V)
      (isUnit_iff_ne_zero.mpr (nativeChartGram_det_pos g α hx).ne')
    rwa [← nativeChartPrincipal_eq_inverseMetricOperator g α hx,
      ← nativeChartPrincipal_eq_inverseMetricOperator h α hx]
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  let e := trivializationAt V (TangentSpace (𝓡∂ (n + 1))) α
  have hbase : x ∈ e.baseSet := by
    change x ∈ (trivializationAt V (TangentSpace (𝓡∂ (n + 1))) α).baseSet
    rw [TangentBundle.trivializationAt_baseSet]
    exact hx
  let D : V ≃L[ℝ] TangentSpace (𝓡∂ (n + 1)) x :=
    (e.continuousLinearEquivAt ℝ x hbase).symm
  have hD : (D : V → TangentSpace (𝓡∂ (n + 1)) x) = e.symmL ℝ x :=
    e.symm_continuousLinearEquivAt_eq hbase
  let B : V →L[ℝ] V →L[ℝ] ℝ :=
    (ContinuousLinearMap.precomp ℝ D.toContinuousLinearMap).comp
      ((g.inner x).comp D.toContinuousLinearMap)
  let C : V →L[ℝ] V →L[ℝ] ℝ :=
    (ContinuousLinearMap.precomp ℝ D.toContinuousLinearMap).comp
      ((h.inner x).comp D.toContinuousLinearMap)
  have hbilin : B.toBilinForm = C.toBilinForm := by
    apply LinearMap.BilinForm.ext_basis (Module.finBasis ℝ V)
    intro i j
    have hg := congrArg (fun G => G i j) hG
    simp only [nativeChartGram_apply] at hg
    change g.inner x (D (Module.finBasis ℝ V i)) (D (Module.finBasis ℝ V j)) =
      h.inner x (D (Module.finBasis ℝ V i)) (D (Module.finBasis ℝ V j))
    rw [hD]
    exact hg
  ext v w
  have hv := congrArg (fun L => L (D.symm v) (D.symm w)) hbilin
  change g.inner x (D (D.symm v)) (D (D.symm w)) =
    h.inner x (D (D.symm v)) (D (D.symm w)) at hv
  simpa only [D.apply_symm_apply] using hv

end ConformalPoisson

end ProofPart_NativeMetricUniqueness

/- Proof support: NativeConformalPrincipal.lean, SHA256 100763909a155c4ff846b2cac2d25e9059816a9803a64820d927bf32b25036ad -/
noncomputable section ProofPart_NativeConformalPrincipal



/-
A proportional inverse chart coefficient gives the reciprocal proportionality
of the actual native metrics. The scalar is positive before rescaling.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem nativeChartGram_rescale (g : Metric (n := n) (M := M))
    (f : M → ℝ) (hf : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f) (hpos : ∀ x, 0 < f x)
    (α x : M) : nativeChartGram (g.rescale f hf hpos) α x = f x • nativeChartGram g α x := by
  ext i j
  simp only [nativeChartGram_apply, Matrix.smul_apply, smul_eq_mul,
    ContMDiffRiemannianMetric.rescale_inner]

without_proof_info in
theorem nativeChartPrincipal_rescale (g : Metric (n := n) (M := M))
    (f : M → ℝ) (hf : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f) (hpos : ∀ x, 0 < f x)
    (α : M) {x : M} (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source) :
    nativeChartPrincipal (g.rescale f hf hpos) α (extChartAt (𝓡∂ (n + 1)) α x) =
      (f x)⁻¹ • nativeChartPrincipal g α (extChartAt (𝓡∂ (n + 1)) α x) := by
  rw [nativeChartPrincipal_eq_inverseMetricOperator _ α hx,
    nativeChartPrincipal_eq_inverseMetricOperator _ α hx, nativeChartGram_rescale]
  have hunit : IsUnit (nativeChartGram g α x).det :=
    isUnit_iff_ne_zero.mpr (nativeChartGram_det_pos g α hx).ne'
  have hi := Matrix.inv_smul' (nativeChartGram g α x) (Units.mk0 (f x) (hpos x).ne') hunit
  simp only [Units.smul_def, Units.val_inv_eq_inv_val, Units.val_mk0] at hi
  rw [hi, inverseMetricOperator_smul]

without_proof_info in
theorem nativeMetric_inner_eq_inv_smul_of_chartPrincipal_eq_smul
    (g h : Metric (n := n) (M := M)) (α : M) {x : M}
    (hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) α).source)
    (μ : ℝ) (hμ : 0 < μ)
    (heq : nativeChartPrincipal h α (extChartAt (𝓡∂ (n + 1)) α x) =
      μ • nativeChartPrincipal g α (extChartAt (𝓡∂ (n + 1)) α x))
    (v w : TangentSpace (𝓡∂ (n + 1)) x) :
    h.inner x v w = μ⁻¹ * g.inner x v w := by
  let g' := g.rescale (fun _ => μ⁻¹) contMDiff_const (fun _ => inv_pos.mpr hμ)
  have ha : nativeChartPrincipal h α (extChartAt (𝓡∂ (n + 1)) α x) =
      nativeChartPrincipal g' α (extChartAt (𝓡∂ (n + 1)) α x) := by
    rw [nativeChartPrincipal_rescale g _ _ _ α hx]
    simpa only [inv_inv] using heq
  have hh := nativeMetric_inner_eq_of_chartPrincipal_eq h g' α hx ha
  have hvw := congrArg (fun B => B v w) hh
  change h.inner x v w =
    (g.rescale (fun _ => μ⁻¹) contMDiff_const (fun _ => inv_pos.mpr hμ)).inner x v w at hvw
  rw [ContMDiffRiemannianMetric.rescale_inner] at hvw
  exact hvw

end ConformalPoisson

end ProofPart_NativeConformalPrincipal

/- Proof support: NativeOpenMetricRecovery.lean, SHA256 43dd5d9e5a8a4460460867efd1c9f2b123eb2e48bd3d1e269438787cc8463619 -/
noncomputable section ProofPart_NativeOpenMetricRecovery





/-
The actual native metric is conformal at each point when multiplication carries
the original full supported solution family into the second homogeneous equation
on an open submanifold. All coordinate jet premises are supplied by project proofs.
-/

open Bundle Set
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

variable {g : Metric (n := n) (M := M)} {q : M → ℝ}

set_option maxHeartbeats 400000 in
without_proof_info in
theorem nativeMetric_conformal_at_of_open_scaled_family
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge : RungeJetApproximationFor g q)
    (hdim : 2 ≤ n) (hcompact : IsCompact (univ : Set M))
    (hconnected : IsConnected ((𝓡∂ (n + 1)).interior M))
    
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) (S : DirichletSolver g q)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (U : TopologicalSpace.Opens M) (h : Metric (n := n) (M := U)) (p r : U → ℝ)
    (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r) (hrpos : ∀ x, 0 < r x)
    (x : U) (hx : (𝓡∂ (n + 1)).IsInteriorPoint (x : M))
    (hsolutions : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      schrodinger h p (fun y : U => r y * S.solve f.val y) x = 0) :
    ∃ a : ℝ, 0 < a ∧ ∀ v w : TangentSpace (𝓡∂ (n + 1)) x,
      h.inner x v w = a * (g.restrictOpenTangentSpace U).inner x v w := by
  obtain ⟨k, hk, hA, _, _⟩ := coordinateCoefficients_of_open_scaled_native_family
    hSchauder hRunge hdim hcompact hconnected hq hNR S Γ hΓ U h p r hr hrpos x hx hsolutions
  let z := extChartAt (𝓡∂ (n + 1)) (x : M) (x : M)
  have hg := (nativeChartCoefficients_restrictOpen g q U x hx).1
  have hcoeff : nativeChartPrincipal h x z =
      (k / r x) • nativeChartPrincipal (g.restrictOpenTangentSpace U) x z := by
    calc
      nativeChartPrincipal h x z = (r x)⁻¹ • (r x • nativeChartPrincipal h x z) := by
        rw [inv_smul_smul₀ (hrpos x).ne']
      _ = (r x)⁻¹ • (k • nativeChartPrincipal g (x : M) z) := by rw [hA]
      _ = (k / r x) • nativeChartPrincipal (g.restrictOpenTangentSpace U) x z := by
        rw [hg, smul_smul, div_eq_mul_inv, mul_comm k]
  dsimp only [z] at hcoeff
  rw [← extChartAt_restrictOpen_self (I := 𝓡∂ (n + 1)) U x] at hcoeff
  refine ⟨r x / k, div_pos (hrpos x) hk, ?_⟩
  intro v w
  have hvw := nativeMetric_inner_eq_inv_smul_of_chartPrincipal_eq_smul
    (g.restrictOpenTangentSpace U) h x (mem_chart_source _ _) (k / r x)
    (div_pos hk (hrpos x)) hcoeff v w
  simpa only [inv_div] using hvw

end ConformalPoisson

end ProofPart_NativeOpenMetricRecovery

/- Proof support: NativeScaledMetric.lean, SHA256 bfe55afda14ddd2983fd6c5892eb02483a07bdc978dfa572e4b20b6d4aeca3e0 -/
noncomputable section ProofPart_NativeScaledMetric





/-
Actual pointwise conformality of the pulled-back second metric, derived from the
original all-data solution relation. Neither metric recovery nor the pullback
map's regularity/invertibility is a new premise. Smooth factor selection and its
conformal exponent/constant are the subsequent obligations.
-/

open Bundle Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂] [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁]
  [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem native_scaled_solution_relation_pointwise_conformal
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hdim : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ (𝓡∂ (n + 1)).interior M₁)
    (J : M₁ → M₂) (c : M₁ → ℝ) (hJcont : ContinuousOn J U)
    (hJinterior : ∀ x ∈ U, J x ∈ (𝓡∂ (n + 1)).interior M₂)
    (hcpos : ∀ x ∈ U, 0 < c x)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x)) :
    ∃ hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun x : U => J x),
      ∃ hinv : ∀ x : U, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun x : U => J x) x).IsInvertible,
      ∀ x : U, ∃ a : ℝ, 0 < a ∧ ∀ v w : TangentSpace (𝓡∂ (n + 1)) x,
        (nativePullbackMetric A₂.smoothMetric (fun x : U => J x) hJ hinv).inner x v w =
          a * (A₁.smoothMetric.restrictOpenTangentSpace U).inner x v w := by
  obtain ⟨hJ, hinv, hc⟩ := native_scaled_solution_relation_open_geometry hSchauder hRunge₁ hRunge₂
    hReg₁ hReg₂ hdim hcompact₁ hcompact₂ hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D U hU J c hJcont
    hJinterior (fun x hx => (hcpos x hx).ne') hrel
  refine ⟨hJ, hinv, ?_⟩
  intro x
  let Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₁) :=
    ⟨observedPatch (n := n) V₁, V₁.isOpen.preimage continuous_subtype_val⟩
  let r : U → ℝ := fun y => (c y)⁻¹
  have hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r :=
    hc.inv₀ (fun y => (hcpos y y.property).ne')
  have hrpos : ∀ y : U, 0 < r y := fun y => inv_pos.mpr (hcpos y y.property)
  apply nativeMetric_conformal_at_of_open_scaled_family hSchauder (hRunge₁ A₁) hdim hcompact₁
    hconnected₁ (A₁.analytic_potential.of_le (by decide))
    A₁.nonresonant D.solver₁ Γ D.patch_nonempty U
    (nativePullbackMetric A₂.smoothMetric (fun y : U => J y) hJ hinv)
    (fun y : U => A₂.potential (J y)) r hr hrpos x (hU x.property)
  intro f
  have hhom := native_scaled_relation_pullback_homogeneous A₁ A₂ V₁ V₂ D U J c hJ hinv
    (fun y => hJinterior y y.property) (fun y => (hcpos y y.property).ne')
    (fun f y => hrel f y y.property) f x
  convert hhom using 2
  funext y
  change (c y)⁻¹ * D.solver₁.solve f.val y = D.solver₁.solve f.val y / c y
  rw [div_eq_mul_inv, mul_comm]

end ConformalPoisson

end ProofPart_NativeScaledMetric

/- Proof support: SmoothConformalFactor.lean, SHA256 896ef8f841189282b6a9854334ea5eae7611517fc37fcdca45595a8cd1c84374 -/
noncomputable section ProofPart_SmoothConformalFactor




/-
Pointwise conformality of two actual smooth native metrics supplies a smooth
positive factor. Local nonvanishing tangent fields identify that factor as a
ratio of smooth metric evaluations, independently of pointwise choices.
-/

open Bundle Filter
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem contMDiffAt_metric_eval_self (g : Metric (n := n) (M := M))
    (X : (y : M) → TangentSpace (𝓡∂ (n + 1)) y) (x : M)
    (hX : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)).tangent ∞
      (fun y => (⟨y, X y⟩ : TangentBundle (𝓡∂ (n + 1)) M)) x) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y => g.inner y (X y) (X y)) x := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  change ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y => inner ℝ (X y) (X y)) x
  exact hX.inner_bundle hX

set_option maxHeartbeats 400000 in
without_proof_info in
theorem exists_smooth_positive_conformal_factor (g h : Metric (n := n) (M := M))
    (hp : ∀ x : M, ∃ a : ℝ, 0 < a ∧ ∀ v w : TangentSpace (𝓡∂ (n + 1)) x,
      h.inner x v w = a * g.inner x v w) :
    ∃ a : M → ℝ, ∃ ha : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a,
      ∃ hpos : ∀ x, 0 < a x, h = g.rescale a ha hpos := by
  choose a hpos heq using hp
  have hsmooth : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a := by
    intro x
    let v : TangentSpace (𝓡∂ (n + 1)) x := EuclideanSpace.single (0 : Fin (n + 1)) 1
    have hv : v ≠ 0 := by
      change (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ)) ≠ 0
      simp
    let X : (y : M) → TangentSpace (𝓡∂ (n + 1)) y := FiberBundle.extend V v
    have hX : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)).tangent ∞
        (fun y => (⟨y, X y⟩ : TangentBundle (𝓡∂ (n + 1)) M)) x :=
      FiberBundle.contMDiffAt_extend (𝓡∂ (n + 1)) V v
    have hN := contMDiffAt_metric_eval_self h X x hX
    have hD := contMDiffAt_metric_eval_self g X x hX
    have hDx : g.inner x (X x) (X x) ≠ 0 := by
      simpa only [X, FiberBundle.extend_apply_self] using (g.pos x v hv).ne'
    have hne : ∀ᶠ y in 𝓝 x, g.inner y (X y) (X y) ≠ 0 :=
      hD.continuousAt.eventually (eventually_ne_nhds hDx)
    have hratio : a =ᶠ[𝓝 x] (fun y => h.inner y (X y) (X y) / g.inner y (X y) (X y)) := by
      filter_upwards [hne] with y hy
      exact (eq_div_iff hy).mpr (heq y (X y) (X y)).symm
    exact (hN.div₀ hD hDx).congr_of_eventuallyEq hratio
  refine ⟨a, hsmooth, hpos, ?_⟩
  apply ContMDiffRiemannianMetric.ext
  intro x v w
  rw [ContMDiffRiemannianMetric.rescale_inner]
  exact heq x v w

end ConformalPoisson

end ProofPart_SmoothConformalFactor

