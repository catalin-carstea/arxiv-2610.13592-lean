/- The actual C3 solution difference becomes analytic under tangential
localized translations. Coefficient families and the inverse are concrete
internal inputs; no reflected spatial analyticity is asserted. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "BX" => BallSpace α V ℝ

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem exists_analytic_tangential_solution_difference_family
    (hα : α ≤ 1)
    (A : V → V →L[ℝ] V) (b : V → V) (q source u χ : V → ℝ)
    (hχ : ContDiff ℝ ∞ χ) (hχbound : ∀ x, ‖χ x‖ ≤ 1)
    (hχsphere : ∀ x ∈ sphere (0 : V) 1, χ x = 0)
    (hu : ContDiffOn ℝ 3 u (ball 0 3))
    (hLu : ∀ x ∈ ball (0 : V) 3, coordinateSchrodinger A b q u x = source x)
    (AH : V → H (V →L[ℝ] V)) (BH : V → H V) (QH GH : V → H ℝ)
    (hAH : AnalyticAt ℝ AH 0) (hBH : AnalyticAt ℝ BH 0)
    (hQH : AnalyticAt ℝ QH 0) (hGH : AnalyticAt ℝ GH 0)
    (hAread : ∀ᶠ a in 𝓝 (0 : V), ∀ x : closedBall (0 : V) 1,
      AH a x = A (localizedTranslation χ (boundaryTangentialProjection a) x))
    (hBread : ∀ᶠ a in 𝓝 (0 : V), ∀ x : closedBall (0 : V) 1,
      BH a x = b (localizedTranslation χ (boundaryTangentialProjection a) x))
    (hQread : ∀ᶠ a in 𝓝 (0 : V), ∀ x : closedBall (0 : V) 1,
      QH a x = q (localizedTranslation χ (boundaryTangentialProjection a) x))
    (hGread : ∀ᶠ a in 𝓝 (0 : V), ∀ x : closedBall (0 : V) 1,
      GH a x = source (localizedTranslation χ (boundaryTangentialProjection a) x))
    (S : (H ℝ) →L[ℝ] BX)
    (hinv : (S.comp (ballSchrodinger hα (AH 0) (BH 0) (QH 0))).IsInvertible) :
    ∃ J : V → BX, AnalyticAt ℝ J 0 ∧
      ∀ a ∈ ball (0 : V) 1, ∀ x : closedBall (0 : V) 1,
        (J a).val.1 x = localizedSolutionDifference χ u (boundaryTangentialProjection a) x ∧
        (J a).val.2.1 x =
          fderiv ℝ (localizedSolutionDifference χ u (boundaryTangentialProjection a)) x ∧
        (J a).val.2.2 x =
          fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u (boundaryTangentialProjection a))) x := by
  let P : V →L[ℝ] V := boundaryTangentialProjection
  have hP0 : P 0 = 0 := P.map_zero
  have hPball {a : V} (ha : a ∈ ball (0 : V) 1) : P a ∈ ball (0 : V) 1 := by
    exact mem_ball_zero_iff.mpr
      ((norm_boundaryTangentialProjection_le a).trans_lt (mem_ball_zero_iff.mp ha))
  obtain ⟨jχ, hjχ⟩ := exists_holderJet_of_local_smooth hα χ
    (fun x _ => hχ.contDiffAt)
  let η := jχ.2.1
  let C := jχ.2.2
  let KH : V → H (V →L[ℝ] V) := fun a => holderTranslationInverseJacobian η (P a)
  have hKH : AnalyticAt ℝ KH 0 := by
    have hout : AnalyticAt ℝ (holderTranslationInverseJacobian η) (P 0) := by
      rw [hP0]
      exact analyticAt_holderTranslationInverseJacobian η
    exact hout.comp (P.analyticAt 0)
  have hKH0 : KH 0 = 1 := by simp [KH, holderTranslationInverseJacobian]
  have hK3 : closedBall (0 : V) 1 ⊆ ball 0 3 :=
    closedBall_subset_ball (by norm_num : (1 : ℝ) < 3)
  obtain ⟨ju, hju⟩ := exists_holderJet_of_local_c3 hα u
    (fun x hx => (hu x (hK3 hx)).contDiffAt (isOpen_ball.mem_nhds (hK3 hx)))
  obtain ⟨J0, hJ0, hJ0eq⟩ := exists_localizedSolutionDifference_ballJets_c3
    hα χ u hχ hχbound hχsphere hu
  let J : V → BX := fun a => J0 (P a)
  have hJcont : ContinuousAt J 0 := by
    have hout : ContinuousAt J0 (P 0) := by
      rw [hP0]
      exact hJ0.continuousAt (isOpen_ball.mem_nhds (mem_ball_self zero_lt_one))
    exact hout.comp P.continuous.continuousAt
  have hunit : ∀ᶠ a in 𝓝 (0 : V), IsUnit (holderTranslationJacobian η (P a)) := by
    have ht : Tendsto P (𝓝 (0 : V)) (𝓝 (0 : V)) := by
      have ht' : Tendsto P (𝓝 (0 : V)) (𝓝 (P 0)) := P.continuous.continuousAt
      rw [hP0] at ht'
      exact ht'
    exact ht.eventually (eventually_isUnit_holderTranslationJacobian η)
  have heq : ∀ᶠ a in 𝓝 (0 : V),
      pulledBackBallOperator hα (AH a) (BH a) (QH a) (KH a) C (P a) (J a) =
        GH a - pulledBackHolderOperator (AH a) (BH a) (QH a) (KH a) C (P a) ju := by
    filter_upwards [hAread, hBread, hQread, hGread,
      isOpen_ball.mem_nhds (mem_ball_self (zero_lt_one : (0 : ℝ) < 1)), hunit]
      with a haA haB haQ haG ha haunit
    have hK (x : closedBall (0 : V) 1) :
        (fderiv ℝ (localizedTranslation χ (P a)) x).comp (KH a x) =
          ContinuousLinearMap.id ℝ V := by
      have hd : fderiv ℝ (localizedTranslation χ (P a)) x =
          holderTranslationJacobian η (P a) x := by
        rw [(hasFDerivAt_localizedTranslation χ (P a) x
          (hχ.differentiable (by simp) x)).fderiv]
        ext v
        simp [holderTranslationJacobian_apply, η, (hjχ x).2.1]
      rw [hd]
      exact holderTranslationJacobian_comp_inverse η haunit x
    exact localizedSolutionDifference_inhomogeneous_operator_equation hα A b q χ u source
      (P a) hχ hχbound (hu.of_le (by norm_num)) (hPball ha) hLu
      (AH a) (BH a) (QH a) (KH a) C ju (J a) (GH a)
      haG haA haB haQ (fun x => (hjχ x).2.2) hK hju (hJ0eq (P a) (hPball ha))
  have hInv : (S.comp (pulledBackBallOperator hα (AH 0) (BH 0) (QH 0)
      (KH 0) C (P 0))).IsInvertible := by
    rw [hKH0, hP0, pulledBackBallOperator_at_zero]
    exact hinv
  have hJan : AnalyticAt ℝ J 0 :=
    analyticAt_jetFamily_of_inhomogeneous_pulledBack_equation hα AH KH BH QH GH P
      hAH hBH hQH hKH hGH (P.analyticAt 0) C ju S J hJcont hInv heq
  exact ⟨J, hJan, fun a ha => hJ0eq (P a) (hPball ha)⟩

end ConformalPoisson

end ProofPart_BoundaryAnalytic_TangentialAnalyticSolutionFamily

/- Boundary analytic support: AnalyticFactorialBounds.lean, SHA256 822d8746516b032d356127f15f68f5ae70bcd03aee2a27efcf43bc6c05dadec6 -/
noncomputable section ProofPart_BoundaryAnalytic_AnalyticFactorialBounds



/- Only the nonoptimal factorial consequence needed for the coefficient and
solution-jet parameter families. One Banach-valued series controls all orders. -/
open scoped BigOperators ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
  {f : E → F} {p : FormalMultilinearSeries ℝ E F} {x : E} {r : ℝ≥0∞}

without_proof_info in
theorem norm_iteratedFDeriv_le_factorial_series
    (hp : HasFPowerSeriesOnBall f p x r) (k : ℕ) :
    ‖iteratedFDeriv ℝ k f x‖ ≤ (k.factorial : ℝ) * ‖p k‖ := by
  classical
  apply ContinuousMultilinearMap.opNorm_le_bound (by positivity)
  intro v
  rw [hp.iteratedFDeriv_eq_sum_of_completeSpace v]
  calc
    ‖∑ σ : Equiv.Perm (Fin k), p k (fun i => v (σ i))‖ ≤
        ∑ σ : Equiv.Perm (Fin k), ‖p k (fun i => v (σ i))‖ := norm_sum_le _ _
    _ ≤ ∑ σ : Equiv.Perm (Fin k), ‖p k‖ * ∏ i, ‖v (σ i)‖ := by
      exact Finset.sum_le_sum fun σ _ => (p k).le_opNorm _
    _ = ((k.factorial : ℝ) * ‖p k‖) * ∏ i, ‖v i‖ := by
      calc
        _ = ∑ _σ : Equiv.Perm (Fin k), ‖p k‖ * ∏ i, ‖v i‖ := by
          apply Finset.sum_congr rfl
          intro σ _
          exact congrArg (fun c : ℝ => ‖p k‖ * c)
            (Equiv.prod_comp σ (fun i => ‖v i‖))
        _ = _ := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin,
            nsmul_eq_mul]
          exact (mul_assoc _ _ _).symm

without_proof_info in
theorem exists_factorial_bound_of_analyticAt (hf : AnalyticAt ℝ f x) :
    ∃ M B : ℝ, 0 < M ∧ 0 < B ∧ ∀ k : ℕ,
      ‖iteratedFDeriv ℝ k f x‖ ≤ M * B ^ k * (k.factorial : ℝ) := by
  obtain ⟨p, r, hp⟩ := hf
  obtain ⟨M, B, hM, hB, hbound⟩ :=
    p.le_mul_pow_of_radius_pos (hp.r_pos.trans_le hp.r_le)
  refine ⟨M, B, hM, hB, fun k => ?_⟩
  calc
    ‖iteratedFDeriv ℝ k f x‖ ≤ (k.factorial : ℝ) * ‖p k‖ :=
      norm_iteratedFDeriv_le_factorial_series hp k
    _ ≤ (k.factorial : ℝ) * (M * B ^ k) :=
      mul_le_mul_of_nonneg_left (hbound k) (by positivity)
    _ = M * B ^ k * (k.factorial : ℝ) := by ac_rfl

without_proof_info in
theorem exists_uniform_factorial_bound_of_analytic_linear_readings
    {I G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
    (hf : AnalyticAt ℝ f x) (L : I → F →L[ℝ] G)
    (D : ℝ) (hD : 0 ≤ D) (hL : ∀ i, ‖L i‖ ≤ D) :
    ∃ M B : ℝ, 0 < M ∧ 0 < B ∧ ∀ i k,
      ‖iteratedFDeriv ℝ k ((L i) ∘ f) x‖ ≤ (D * M) * B ^ k * (k.factorial : ℝ) := by
  obtain ⟨M, B, hM, hB, hbound⟩ := exists_factorial_bound_of_analyticAt hf
  refine ⟨M, B, hM, hB, fun i k => ?_⟩
  rw [(L i).iteratedFDeriv_comp_left (n := k) (hf.contDiffAt (n := k)) le_rfl]
  calc
    _ ≤ ‖L i‖ * ‖iteratedFDeriv ℝ k f x‖ :=
      (L i).norm_compContinuousMultilinearMap_le _
    _ ≤ ‖L i‖ * (M * B ^ k * (k.factorial : ℝ)) :=
      mul_le_mul_of_nonneg_left (hbound k) (norm_nonneg _)
    _ ≤ D * (M * B ^ k * (k.factorial : ℝ)) :=
      mul_le_mul_of_nonneg_right (hL i) (by positivity)
    _ = _ := by ac_rfl

end ConformalPoisson

end ProofPart_BoundaryAnalytic_AnalyticFactorialBounds

/- Boundary analytic support: NormalDirectionalLeibniz.lean, SHA256 7f074f935d102c41e2dd228bd591626682367a84f18580437bca6c4e79d316c9 -/
noncomputable section ProofPart_BoundaryAnalytic_NormalDirectionalLeibniz




/- Normal derivatives on an open physical cap are ordinary derivatives
of the actual affine line. This transfers the existing exact Leibniz rule
without assuming a smooth continuation through the boundary. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

def derivativeAffineLine (x e : E) : ℝ →ᴬ[ℝ] E :=
  ContinuousAffineMap.const ℝ ℝ x +
    ((ContinuousLinearMap.id ℝ ℝ).smulRight e).toContinuousAffineMap

without_proof_info in
@[simp] theorem derivativeAffineLine_apply (x e : E) (t : ℝ) :
    derivativeAffineLine x e t = x + t • e := rfl

without_proof_info in
@[simp] theorem derivativeAffineLine_contLinear (x e : E) :
    (derivativeAffineLine x e).contLinear = (ContinuousLinearMap.id ℝ ℝ).smulRight e := by
  simp [derivativeAffineLine, ContinuousAffineMap.add_contLinear]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem iteratedFDerivWithinAlong_replicate_eq_iteratedDeriv_line
    {S : Set E} (hS : IsOpen S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    {x : E} (hx : x ∈ S) (e : E) (k : ℕ) :
    iteratedFDerivWithinAlong S (List.replicate k e) f x =
      iteratedDeriv k (fun t : ℝ => f (x + t • e)) 0 := by
  let g := derivativeAffineLine x e
  let U : Set ℝ := g ⁻¹' S
  have hU : IsOpen U := hS.preimage g.continuous
  have h0 : (0 : ℝ) ∈ U := by simpa [U, g] using hx
  have hp := (hf.ftaylorSeriesWithin hS.uniqueDiffOn).comp_continuousAffineMap g
  have heq := hp.eq_iteratedFDerivWithin_of_uniqueDiffOn (m := k) (by simp) hU.uniqueDiffOn h0
  have heval := congrArg (fun A => A (fun _ : Fin k => (1 : ℝ))) heq
  rw [iteratedFDerivWithin_of_isOpen k hU h0] at heval
  have hword := iteratedFDerivWithinAlong_ofFn hS.uniqueDiffOn hf
    (fun _ : Fin k => e) hx
  rw [List.ofFn_const] at hword
  rw [hword, iteratedDeriv_eq_iteratedFDeriv]
  simpa [g, ftaylorSeriesWithin, Function.comp_def] using heval

without_proof_info in
theorem iteratedFDerivWithinAlong_replicate_mul
    {S : Set E} (hS : IsOpen S) {f g : E → ℝ}
    (hf : ContDiffOn ℝ ∞ f S) (hg : ContDiffOn ℝ ∞ g S)
    {x : E} (hx : x ∈ S) (e : E) (k : ℕ) :
    iteratedFDerivWithinAlong S (List.replicate k e) (f * g) x =
      ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) *
        iteratedFDerivWithinAlong S (List.replicate i e) f x *
        iteratedFDerivWithinAlong S (List.replicate (k - i) e) g x := by
  have hline : ContDiffAt ℝ ∞ (fun t : ℝ => x + t • e) 0 :=
    contDiffAt_const.add (contDiffAt_id.smul contDiffAt_const)
  have hfl : ContDiffAt ℝ ∞ (fun t : ℝ => f (x + t • e)) 0 := by
    have hfx : ContDiffAt ℝ ∞ f (x + (0 : ℝ) • e) := by
      simpa only [zero_smul, add_zero] using (hf x hx).contDiffAt (hS.mem_nhds hx)
    exact hfx.comp 0 hline
  have hgl : ContDiffAt ℝ ∞ (fun t : ℝ => g (x + t • e)) 0 := by
    have hgx : ContDiffAt ℝ ∞ g (x + (0 : ℝ) • e) := by
      simpa only [zero_smul, add_zero] using (hg x hx).contDiffAt (hS.mem_nhds hx)
    exact hgx.comp 0 hline
  change iteratedFDerivWithinAlong S (List.replicate k e) (fun y => f y * g y) x = _
  rw [iteratedFDerivWithinAlong_replicate_eq_iteratedDeriv_line hS (hf.mul hg) hx e k]
  simp_rw [iteratedFDerivWithinAlong_replicate_eq_iteratedDeriv_line hS hf hx e,
    iteratedFDerivWithinAlong_replicate_eq_iteratedDeriv_line hS hg hx e]
  simpa only [Pi.mul_def] using
    iteratedDeriv_mul (hfl.of_le (by simp)) (hgl.of_le (by simp))

end ConformalPoisson

end ProofPart_BoundaryAnalytic_NormalDirectionalLeibniz

/- Boundary analytic support: MixedDerivativeJets.lean, SHA256 edfaeacdc6dcddb7645ec28a4c974bc61b13034a6f8ad25fba8d6392850ac854 -/
noncomputable section ProofPart_BoundaryAnalytic_MixedDerivativeJets



/- Actual mixed derivatives: all tangential slots are pulled back by one
fixed linear projection, while normal derivatives are taken first. Affine
restriction identifies these with ordinary parameter derivatives on an open
physical cap. -/
open Set
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup G] [NormedSpace ℝ G]

def normalDerivativeWithin (S : Set E) (e : E) (j : ℕ) (f : E → F) : E → F :=
  iteratedFDerivWithinAlong S (List.replicate j e) f

def mixedDerivativeWithin (S : Set E) (P : E →L[ℝ] E) (e : E)
    (p j : ℕ) (f : E → F) (x : E) : ContinuousMultilinearMap ℝ (fun _ : Fin p => E) F :=
  (iteratedFDerivWithin ℝ p (normalDerivativeWithin S e j f) S x).compContinuousLinearMap
    (fun _ => P)

def derivativeAffineParameter (x : E) (P : E →L[ℝ] E) : E →ᴬ[ℝ] E :=
  ContinuousAffineMap.const ℝ E x + P.toContinuousAffineMap

without_proof_info in
@[simp] theorem derivativeAffineParameter_apply (x : E) (P : E →L[ℝ] E) (y : E) :
    derivativeAffineParameter x P y = x + P y := rfl

without_proof_info in
@[simp] theorem derivativeAffineParameter_contLinear (x : E) (P : E →L[ℝ] E) :
    (derivativeAffineParameter x P).contLinear = P := by
  simp [derivativeAffineParameter, ContinuousAffineMap.add_contLinear]

without_proof_info in
theorem iteratedFDerivWithin_comp_affine_on_open
    {S : Set E} (hS : IsOpen S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    (g : G →ᴬ[ℝ] E) {z : G} (hz : g z ∈ S) (k : ℕ) :
    (iteratedFDerivWithin ℝ k f S (g z)).compContinuousLinearMap (fun _ => g.contLinear) =
      iteratedFDeriv ℝ k (f ∘ g) z := by
  have hU : IsOpen (g ⁻¹' S) := hS.preimage g.continuous
  have hp := (hf.ftaylorSeriesWithin hS.uniqueDiffOn).comp_continuousAffineMap g
  have heq := hp.eq_iteratedFDerivWithin_of_uniqueDiffOn (m := k) (by simp) hU.uniqueDiffOn hz
  rw [iteratedFDerivWithin_of_isOpen k hU hz] at heq
  exact heq

without_proof_info in
theorem contDiffOn_normalDerivativeWithin
    {S : Set E} (hS : UniqueDiffOn ℝ S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    (e : E) (j : ℕ) : ContDiffOn ℝ ∞ (normalDerivativeWithin S e j f) S :=
  contDiffOn_iteratedFDerivWithinAlong hS hf (List.replicate j e)

without_proof_info in
theorem mixedDerivativeWithin_eq_iteratedFDeriv_parameter
    {S : Set E} (hS : IsOpen S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    {x : E} (hx : x ∈ S) (P : E →L[ℝ] E) (e : E) (p j : ℕ) :
    mixedDerivativeWithin S P e p j f x = iteratedFDeriv ℝ p
      (fun y => normalDerivativeWithin S e j f (x + P y)) 0 := by
  have hz : derivativeAffineParameter x P 0 ∈ S := by simpa using hx
  have heq := iteratedFDerivWithin_comp_affine_on_open hS
    (contDiffOn_normalDerivativeWithin hS.uniqueDiffOn hf e j)
    (derivativeAffineParameter x P) hz p
  simpa [mixedDerivativeWithin, Function.comp_def] using heq

end ConformalPoisson

end ProofPart_BoundaryAnalytic_MixedDerivativeJets

/- Boundary analytic support: UniformTangentialFactorialBounds.lean, SHA256 4f79e5e2eb1ba59190451d6f1d60be94da77e152ce2f4bd1b5d31981d5c46742 -/
noncomputable section ProofPart_BoundaryAnalytic_UniformTangentialFactorialBounds





/- One analytic Holder-jet family gives uniform factorial bounds for
both required tangent base traces: u and its first normal derivative. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
open DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "J" => HolderJet α V
local notation "e" => (EuclideanSpace.single 0 1 : V)

set_option maxHeartbeats 1400000 in
without_proof_info in
theorem exists_uniform_tangential_factorial_bounds
    {S K : Set V} (hS : IsOpen S) (hKS : K ⊆ S)
    (hKball : K ⊆ closedBall (0 : V) 1)
    {u : V → ℝ} (hu : ContDiffOn ℝ ∞ u S)
    (Ψ : V → J) (hΨ : AnalyticAt ℝ Ψ 0)
    (hvalue : ∀ x (hx : x ∈ K), ∀ᶠ a in 𝓝 (0 : V),
      (Ψ a).1 ⟨x, hKball hx⟩ = u (x + boundaryTangentialProjection a))
    (hnormal : ∀ x (hx : x ∈ K), ∀ᶠ a in 𝓝 (0 : V),
      (Ψ a).2.1 ⟨x, hKball hx⟩ e =
        fderiv ℝ u (x + boundaryTangentialProjection a) e) :
    ∃ M B : ℝ, 0 < M ∧ 0 < B ∧ ∀ x ∈ K, ∀ p j, j ≤ 1 →
      ‖mixedDerivativeWithin S boundaryTangentialProjection e p j u x‖ ≤
        M * B ^ p * (p.factorial : ℝ) := by
  let R0 : J →L[ℝ] H ℝ :=
    ContinuousLinearMap.fst ℝ (H ℝ) ((H (V →L[ℝ] ℝ)) × (H (V →L[ℝ] V →L[ℝ] ℝ)))
  let R1 : J →L[ℝ] H ℝ := holderJetGradient (TauCeti.HolderSpace.const e)
  let L : (closedBall (0 : V) 1 × Bool) → J →L[ℝ] ℝ :=
    fun i => (TauCeti.HolderSpace.evalCLM i.1).comp (if i.2 then R1 else R0)
  let D : ℝ := 1 + ‖R0‖ + ‖R1‖
  have hD : 0 < D := by dsimp [D]; positivity
  have hL : ∀ i, ‖L i‖ ≤ D := by
    intro i
    calc
      _ ≤ ‖TauCeti.HolderSpace.evalCLM (α := α) (Y := ℝ) i.1‖ *
          ‖(if i.2 then R1 else R0)‖ := ContinuousLinearMap.opNorm_comp_le _ _
      _ ≤ 1 * ‖(if i.2 then R1 else R0)‖ :=
        mul_le_mul_of_nonneg_right (TauCeti.HolderSpace.norm_evalCLM_le_one _) (norm_nonneg _)
      _ ≤ D := by
        simp only [one_mul]
        dsimp [D]
        split_ifs <;> nlinarith [norm_nonneg R0, norm_nonneg R1]
  obtain ⟨M, B, hM, hB, hbound⟩ :=
    exists_uniform_factorial_bound_of_analytic_linear_readings hΨ L D hD.le hL
  refine ⟨D * M, B, mul_pos hD hM, hB, ?_⟩
  intro x hx p j hj
  let xK : closedBall (0 : V) 1 := ⟨x, hKball hx⟩
  interval_cases j
  · have hread : ((L (xK, false)) ∘ Ψ) =ᶠ[𝓝 (0 : V)]
        (fun a => normalDerivativeWithin S e 0 u (x + boundaryTangentialProjection a)) := by
      filter_upwards [hvalue x hx] with a ha
      simpa [L, R0, xK, normalDerivativeWithin, Function.comp_def] using ha
    have heq := (Filter.EventuallyEq.iteratedFDeriv ℝ hread p).eq_of_nhds
    calc
