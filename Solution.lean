  refine ⟨r, hr, hrMax, htarget, S, fun u => ?_⟩
  change A u =ᵐ[μ.restrict (D : Set V)] (u : Lp ℝ 2 (μ.restrict (Ω : Set V)))
  rw [hA]
  exact hR _

end ConformalPoisson

