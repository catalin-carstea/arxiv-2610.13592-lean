/- Uniform bounded next-direction readings give Lipschitz continuity of
point evaluations in OPERATOR NORM on the closed physical cap. This is the
needed strengthening of separate scalar smoothness for joint regularity. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module Filter
open scoped Manifold ContDiff ENNReal NNReal InnerProductSpace Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
namespace AllOrderSobolevReading

def capGradientBound (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) : ℝ :=
  ∑ i : Fin (n + 1), ‖capReading c hr (S.directional ((EuclideanSpace.basisFun (Fin (n + 1)) ℝ) i))‖ *
    ‖innerSL ℝ ((EuclideanSpace.basisFun (Fin (n + 1)) ℝ) i)‖

without_proof_info in
theorem capGradientBound_nonneg (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) :
    0 ≤ capGradientBound c hr S := by
  exact Finset.sum_nonneg (fun i _ => mul_nonneg
    (norm_nonneg (capReading c hr (S.directional ((EuclideanSpace.basisFun (Fin (n + 1)) ℝ) i))))
    (norm_nonneg (innerSL ℝ ((EuclideanSpace.basisFun (Fin (n + 1)) ℝ) i))))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem capGradient_norm_le (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) (u : H)
    {x : V} (hx : x ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) :
    ‖capGradient c hr S u x‖ ≤ capGradientBound c hr S * ‖u‖ := by
  let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
  have heval : ∀ i, ‖capEvaluation c hr (S.directional (b i)) x u‖ ≤
      ‖capReading c hr (S.directional (b i))‖ * ‖u‖ := by
    intro i
    rw [capEvaluation_apply_of_mem c hr _ hx u]
    exact ((capReading c hr (S.directional (b i)) u).norm_coe_le_norm ⟨x, hx⟩).trans
      ((capReading c hr (S.directional (b i))).le_opNorm u)
  calc
    ‖capGradient c hr S u x‖ ≤
        ∑ i : Fin (n + 1), ‖capEvaluation c hr (S.directional (b i)) x u • innerSL ℝ (b i)‖ :=
      norm_sum_le _ _
    _ = ∑ i : Fin (n + 1), ‖capEvaluation c hr (S.directional (b i)) x u‖ * ‖innerSL ℝ (b i)‖ := by
      simp only [norm_smul]
    _ ≤ ∑ i : Fin (n + 1), (‖capReading c hr (S.directional (b i))‖ * ‖u‖) * ‖innerSL ℝ (b i)‖ :=
      Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_right (heval i) (norm_nonneg _))
    _ = capGradientBound c hr S * ‖u‖ := by
      rw [capGradientBound, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i _
      ring

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem capEvaluation_norm_sub_le (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H)
    {x y : V} (hx : x ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V))
    (hy : y ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) :
    ‖capEvaluation c hr S y - capEvaluation c hr S x‖ ≤ capGradientBound c hr S * ‖y - x‖ := by
  have hconv : Convex ℝ (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) :=
    ((convex_ball _ _).inter ((𝓡∂ (n + 1)).convex_range.interior)).closure
