local instance analyticRungeBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary

without_proof_info in
theorem analytic_finite_jet_runge
    (hReg : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (hGreen : GreenKernelAssumption (n := n) (M := M))
    (hInverse : ForwardInhomogeneousAssumption (n := n) (M := M))
    (A : AnalyticProblem (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal A.smoothMetric y (ν y)) :
    RungeJetApproximationFor A.smoothMetric A.potential := by
  intro hdim _hcompact hconnected _hq _hNR S Γ hΓ N points hinj hpoints U hpointU hU v hv hLv
  obtain ⟨f, hf⟩ := exists_datum_with_local_jets_from_retained_inputs hReg hGreen hInverse
    A hdim hconnected.isPreconnected ν hν S Γ hΓ N points hinj hpoints U hpointU hU v hv hLv
  refine ⟨fun _ => f, ?_⟩
  have heq : (fun (_m : ℕ) i => secondJet A.smoothMetric (S.solve f.val) (points i)) =
      (fun _ => fun i => secondJet A.smoothMetric (v i) (points i)) := by
    funext m i
    exact hf i
  rw [heq]
  exact tendsto_const_nhds

without_proof_info in
theorem analytic_finite_jet_runge_for_all_operators
    (hReg : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (hGreen : GreenKernelAssumption (n := n) (M := M))
    (hInverse : ForwardInhomogeneousAssumption (n := n) (M := M)) :
    AnalyticRungeJetApproximation (n := n) (M := M) := by
  intro A
  exact analytic_finite_jet_runge hReg hGreen hInverse A
    (fun y => nativeNegativeUnitGradient A.smoothMetric
