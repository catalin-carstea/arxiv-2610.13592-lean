/- Boundary Cauchy uniqueness and analytic propagation off finitely many
interior poles. This will be applied to the actual Green-jet combination. -/
open Set Filter
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem analytic_zero_off_finite_poles
    (hReg : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (A : AnalyticProblem (n := n) (M := M)) (hdim : 2 ≤ n)
    (hconnected : IsPreconnected ((𝓡∂ (n + 1)).interior M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal A.smoothMetric y (ν y))
    (P : Set M) (hP : P.Finite) (hPI : P ⊆ (𝓡∂ (n + 1)).interior M)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M))
    (hΓ : (Γ : Set ((𝓡∂ (n + 1)).boundary M)).Nonempty)
    (H : M → ℝ) (hH : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ H Pᶜ)
    (hL : ∀ x ∈ (𝓡∂ (n + 1)).interior M \ P,
      schrodinger A.smoothMetric A.potential H x = 0)
    (hC : ∀ y ∈ Γ, H y = 0 ∧ normalDerivative ν H y = 0) :
    EqOn H 0 ((𝓡∂ (n + 1)).interior M \ P) := by
  let V : TopologicalSpace.Opens M := ⟨Pᶜ, hP.isClosed.isOpen_compl⟩
  have hΓV : ∀ y ∈ Γ, (y : M) ∈ V := by
    intro y _ hy
    exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary (hPI hy) y.property
  obtain ⟨y, hy⟩ := hΓ
  have hq := A.analytic_potential.of_le (show (∞ : ℕ∞ω) ≤ ω by decide)
  obtain ⟨W, hyW, hWV, hWzero⟩ := boundary_cauchy_uniqueness_of_analytic_metric A.smoothMetric A.potential hq.continuous ν hν
    V (metricAnalyticOn_of_analytic A.metric V) Γ hΓV H hH (fun x hx hxI => hL x ⟨hxI, hx⟩) hC y hy
  let U : TopologicalSpace.Opens M :=
    ⟨(𝓡∂ (n + 1)).interior M \ P,
      ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).inter hP.isClosed.isOpen_compl⟩
  have hω : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω H U :=
    hReg A.metric A.potential A.analytic_potential U (fun x hx => hx.1) H
      (hH.mono (fun x hx => hx.2)) hL
  have hc : IsPreconnected ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M) := by
    have heq : ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M) = U :=
      inter_eq_self_of_subset_left (fun x hx => hx.1)
    rw [heq]
    exact nativeInterior_diff_finite_isPreconnected hdim hconnected hP
  have hnonempty : ((W ⊓ U : TopologicalSpace.Opens M) : Set M).Nonempty := by
    obtain ⟨x, hxI, hxW⟩ := (dense_nativeInterior (n := n) (M := M)).exists_mem_open
      W.isOpen ⟨y, hyW⟩
    exact ⟨x, hxW, hxI, hWV hxW⟩
  exact native_analytic_eqOn_of_open_match U hc hω contMDiffOn_const (W ⊓ U)
    hnonempty (fun x hx => ⟨hx.2, hx.2.1⟩) (fun x hx => hWzero hx.1)

end ConformalPoisson

