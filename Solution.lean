    ((contDiffOn_split_boundary_chart_reading c hrt hu.1).of_le (by simp)) hU
  have hclass : ∀ᵐ z ∂volume.restrict (splitBoundaryChartCap (n := n) c r : Set P),
      traceCLM ℝ P (splitChartPrincipal g c z ∘L Wkp.iteratedGradient 1 U z) =
        splitChartTraceForcing g c q F u z := by
    filter_upwards [hH, ae_restrict_mem (splitBoundaryChartCap (n := n) c r).isOpen.measurableSet]
      with z hHz hz
    rw [hHz, splitChartPrincipal]
