          (lpNorm (fun z => ζ z • Wkp.iteratedGradient 1 u z) (r : ℝ≥0∞)
              (volume.restrict (Ω : Set P)) +
            (1 + 2 * M₁) * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)‖ +
