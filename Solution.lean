  have hS : ΩP ⊓ (⟨ball x₀ (R / 4), isOpen_ball⟩ : Opens P) = Ωp := by
    apply SetLike.coe_injective
    exact splitBoundaryChartCap_inter_smaller_ball c (by linarith : R / 4 ≤ R)
  rw [hS, splitBoundaryChartCap_inter_smaller_ball c (by linarith : R / 4 ≤ R),
    splitBoundaryChartCap_inter_smaller_ball c le_rfl] at hreading
  have hdom : (Ωv : Set V) = e.symm ⁻¹' (Ωp : Set P) := by
    ext z
    change z ∈ (Ωv : Set V) ↔ e (e.symm z) ∈ (Ωv : Set V)
    rw [e.apply_symm_apply]
  have he : MeasurePreserving e.symm (volume : Measure V) (volume : Measure P) := e.symm.measurePreserving
  have heSmall : MeasurePreserving e.symm ((volume : Measure V).restrict (Ωv : Set V))
      ((volume : Measure P).restrict (Ωp : Set P)) := hdom ▸ he.restrict_preimage Ωp.isOpen.measurableSet
  let J := haarChangeW1pL (p := (2 : ℝ≥0∞)) (volume : Measure V) μ Ωv
  obtain ⟨A, hA, hAall⟩ := exists_haar_lpNorm_factor (F := ℝ) (volume : Measure V) μ (p := (2 : ℝ≥0∞)) (by norm_num)
  refine ⟨‖J‖ * (B * A), by positivity, fun u hu hu0 hPu => ?_⟩
  obtain ⟨U, hU, hzero, hHess⟩ := hDall u hu hu0 (fun z hz => hPu (e z) hz)
  rw [splitBoundaryChartCap_inter_smaller_ball c le_rfl] at hHess
  obtain ⟨v, hv, hvnorm⟩ := hreading U hzero hHess
  have hUsmall : Wkp.value 2 U =ᵐ[volume.restrict (Ωp : Set P)]
      fun z => u ((extChartAt Ihalf c).symm (e z)) :=
    ae_restrict_of_ae_restrict_of_subset (splitBoundaryChartCap_mono c (by linarith : R / 4 ≤ R)) hU
  have hvu : W1p.value v =ᵐ[volume.restrict (Ωp : Set P)]
      fun z => u ((extChartAt Ihalf c).symm (e z)) := hv.trans hUsmall
  let vV := Wkp.compLinearIsometryEquiv he hdom 1 v
  have hvV : W1p.value vV =ᵐ[(volume : Measure V).restrict (Ωv : Set V)] u ∘ (extChartAt Ihalf c).symm := by
    have hiso := Wkp.value_compLinearIsometryEquiv_ae he hdom 1 v
    rw [Wkp.value_one, Wkp.value_one] at hiso
    filter_upwards [hiso, heSmall.quasiMeasurePreserving.ae hvu] with z hz hzu
    exact hz.trans (by simpa only [e.apply_symm_apply, Function.comp_apply] using hzu)
  have hvVnorm : ‖vV‖ = ‖v‖ := (Wkp.compLinearIsometryEquiv he hdom 1).norm_map v
  obtain ⟨fV, hfV⟩ := exists_Wkp_boundary_chart_reading (μ := (volume : Measure V)) (p := (2 : ℝ≥0∞)) c htargetR hu 0
  have hf : MemLp (u ∘ (extChartAt Ihalf c).symm) 2
      ((volume : Measure V).restrict (boundaryChartCap (I := Ihalf) c R : Set V)) :=
    (Lp.memLp (Wkp.value 0 fV)).ae_eq hfV
  have heR : MeasurePreserving e ((volume : Measure P).restrict (ΩP : Set P))
      ((volume : Measure V).restrict (boundaryChartCap (I := Ihalf) c R : Set V)) :=
    e.measurePreserving.restrict_preimage (boundaryChartCap (I := Ihalf) c R).isOpen.measurableSet
  have hnorm : lpNorm (Wkp.value 2 U) 2 ((volume : Measure P).restrict (ΩP : Set P)) =
      A * lpNorm (u ∘ (extChartAt Ihalf c).symm) 2
        (μ.restrict (boundaryChartCap (I := Ihalf) c R : Set V)) := by
    rw [lpNorm_congr_ae hU, ← hAall (boundaryChartCap (I := Ihalf) c R : Set V) (u ∘ (extChartAt Ihalf c).symm)]
    unfold lpNorm
    exact congrArg ENNReal.toReal (eLpNorm_comp_measurePreserving hf.aestronglyMeasurable heR)
  refine ⟨J vV, ?_, ?_⟩
  · have h := haarChangeW1pL_value_ae (μ := (volume : Measure V)) (ν := μ) vV
    have hread : W1p.value vV =ᵐ[μ.restrict (Ωv : Set V)] u ∘ (extChartAt Ihalf c).symm :=
      (haar_restrict_absolutelyContinuous (μ := (volume : Measure V)) (ν := μ) Ωv).ae_eq hvV
    exact h.trans hread
  · calc
      _ ≤ ‖J‖ * ‖vV‖ := J.le_opNorm vV
      _ = ‖J‖ * ‖v‖ := by rw [hvVnorm]
      _ ≤ ‖J‖ * (B * lpNorm (Wkp.value 2 U) 2 ((volume : Measure P).restrict (ΩP : Set P))) :=
        mul_le_mul_of_nonneg_left hvnorm (norm_nonneg J)
      _ = _ := by rw [hnorm]; ring

end ConformalPoisson

