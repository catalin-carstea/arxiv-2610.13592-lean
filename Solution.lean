variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P] {p : P}

without_proof_info in
theorem analyticAt_holderVectorApplication {v : P → H V} {K : P → H (V →L[ℝ] V)}
    (hv : AnalyticAt ℝ v p) (hK : AnalyticAt ℝ K p) :
    AnalyticAt ℝ (fun a => holderVectorApplication (v a) (K a)) p := by
  let L : (H V) →L[ℝ] (H (V →L[ℝ] V)) →L[ℝ] H V :=
    (ContinuousLinearMap.apply ℝ V : V →L[ℝ] (V →L[ℝ] V) →L[ℝ] V).compHolder₂
