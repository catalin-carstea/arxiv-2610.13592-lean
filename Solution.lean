/- Proof support: ReflectedDivergenceField.lean, SHA256 bceeb2efbd95ca1d59f59eb65eddd544abfe696296cfdf815e65851214901372 -/
noncomputable section ProofPart_ReflectedDivergenceField



/- Identification and integrability of the genuine reflected
forcing. The value assigned on the plane is immaterial to its L2 class;
the plane is proved null for a nonzero normal. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped NNReal InnerProductSpace Distributions Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def positiveNormalHalfSpace (ν : V) : Opens V :=
  ⟨{x | 0 < ⟪ν, x⟫_ℝ}, isOpen_lt continuous_const (continuous_const.inner continuous_id)⟩

without_proof_info in
theorem positiveNormalHalfSpace_mem_iff (ν x : V) :
    x ∈ positiveNormalHalfSpace ν ↔ 0 < ⟪x, ν⟫_ℝ := by
  change 0 < ⟪ν, x⟫_ℝ ↔ 0 < ⟪x, ν⟫_ℝ
  rw [real_inner_comm ν x]

without_proof_info in
theorem hyperplaneReflection_zero_eq_linear (ν x : V) :
    hyperplaneReflection ν 0 x = (ℝ ∙ ν)ᗮ.reflection x := by
  rw [hyperplaneReflection_eq_reflection_add]
  simp only [zero_div, mul_zero, zero_smul, add_zero]

without_proof_info in
theorem indicator_reflection_forcing_eq (ν : V) (hν : ν ≠ 0) (F : V → V)
    {x : V} (hxplane : ⟪ν, x⟫_ℝ ≠ 0) :
    (positiveNormalHalfSpace ν : Set V).indicator F x -
      (ℝ ∙ ν)ᗮ.reflection ((positiveNormalHalfSpace ν : Set V).indicator F (hyperplaneReflection ν 0 x)) =
      reflectedDivergenceForcing ν F x := by
  have hheight := inner_hyperplaneReflection_zero_left ν hν x
  by_cases hx : 0 < ⟪ν, x⟫_ℝ
  · have hxH : x ∈ positiveNormalHalfSpace ν := hx
    have hxRH : hyperplaneReflection ν 0 x ∉ positiveNormalHalfSpace ν := by
      change ¬ 0 < ⟪ν, hyperplaneReflection ν 0 x⟫_ℝ
      rw [hheight]
      exact not_lt.2 (neg_nonpos.2 hx.le)
    simp only [indicator_of_mem hxH, indicator_of_notMem hxRH, map_zero, sub_zero,
      reflectedDivergenceForcing, ite_eq_left hx]
  · have hxH : x ∉ positiveNormalHalfSpace ν := hx
    have hxneg : ⟪ν, x⟫_ℝ < 0 := lt_of_le_of_ne (not_lt.1 hx) hxplane
    have hxRH : hyperplaneReflection ν 0 x ∈ positiveNormalHalfSpace ν := by
      change 0 < ⟪ν, hyperplaneReflection ν 0 x⟫_ℝ
      rw [hheight]
      exact neg_pos.2 hxneg
    rw [indicator_of_notMem hxH, indicator_of_mem hxRH, zero_sub]
    simp only [reflectedDivergenceForcing, ite_eq_right hx, hyperplaneReflection_zero_eq_linear]

without_proof_info in
theorem indicator_reflection_forcing_ae_eq {U : Opens V} (ν : V) (hν : ν ≠ 0) (F : V → V) :
    (fun x => (positiveNormalHalfSpace ν : Set V).indicator F x -
      (ℝ ∙ ν)ᗮ.reflection ((positiveNormalHalfSpace ν : Set V).indicator F (hyperplaneReflection ν 0 x)))
      =ᵐ[volume.restrict (U : Set V)] reflectedDivergenceForcing ν F := by
  have hnull := measure_eq_zero_iff_ae_notMem.1 (Measure.addHaar_setOf_inner_eq volume hν 0)
  filter_upwards [ae_restrict_of_ae hnull] with x hx
  apply indicator_reflection_forcing_eq ν hν F
  simpa only [mem_ofPred_eq, real_inner_comm ν x] using hx

set_option maxHeartbeats 400000 in
without_proof_info in
theorem memLp_reflectedDivergenceForcing {U : Opens V} (ν : V) (hν : ν ≠ 0)
    (hU : MapsTo (hyperplaneReflection ν 0) U U) {F : V → V}
    (hF : MemLp F 2 (volume.restrict ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V))) :
    MemLp (reflectedDivergenceForcing ν F) 2 (volume.restrict (U : Set V)) := by
  have hHm := (positiveNormalHalfSpace ν).isOpen.measurableSet
  have hg : MemLp ((positiveNormalHalfSpace ν : Set V).indicator F) 2 (volume.restrict (U : Set V)) := by
