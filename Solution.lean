  calc
    _ ≤ ‖mixedDerivativeWithin S P e (p + 1) q f x‖ *
        ∏ i : Fin (p + 1), ‖(Fin.cons v m : Fin (p + 1) → E) i‖ :=
      (mixedDerivativeWithin S P e (p + 1) q f x).le_opNorm (Fin.cons v m)
    _ = _ := by rw [Fin.prod_univ_succ]; simp only [Fin.cons_zero, Fin.cons_succ]; ring

without_proof_info in
theorem mixedDerivativeWithin_normalDerivativeWithin
    (S : Set E) (P : E →L[ℝ] E) (e : E) (p q ell : ℕ) (f : E → F) (x : E) :
    mixedDerivativeWithin S P e p q (normalDerivativeWithin S e ell f) x =
      mixedDerivativeWithin S P e p (q + ell) f x := by
  have hnormal : normalDerivativeWithin S e q (normalDerivativeWithin S e ell f) =
      normalDerivativeWithin S e (q + ell) f := by
    unfold normalDerivativeWithin
    rw [List.replicate_add, iteratedFDerivWithinAlong_append]
  simp only [mixedDerivativeWithin, hnormal]

end ConformalPoisson

