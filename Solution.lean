without_proof_info in
theorem energyFormH1_oddReflection_eq_forcing {U : Opens V} (ν : V) (hν : ν ≠ 0)
    (hU : MapsTo (hyperplaneReflection ν 0) U U) (u : W1p volume U 2)
    (hu0 : ∀ᵐ x ∂volume.restrict (U : Set V), x ∉ positiveNormalHalfSpace ν → W1p.value u x = 0)
    {F : V → V}
    (hF : MemLp F 2 (volume.restrict ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V)))
    (hu : ∀ v : W1p0 volume (U ⊓ positiveNormalHalfSpace ν) 2,
      energyFormH1 (fun _ => 1) 0 0 (W1p.restrictL (inf_le_left : U ⊓ positiveNormalHalfSpace ν ≤ U) u)
        (v : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) =
      ∫ x in ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V),
        ⟪F x, W1p.gradient (v : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) x⟫_ℝ)
    (φ : W1p0 volume U 2) :
    energyFormH1 (fun _ => 1) 0 0
      (u - W1p.compHyperplaneReflectionL ENNReal.ofNat_ne_top ν 0 hU u) (φ : W1p volume U 2) =
      ∫ x in (U : Set V), ⟪reflectedDivergenceForcing ν F x, W1p.gradient (φ : W1p volume U 2) x⟫_ℝ := by
  let H := positiveNormalHalfSpace ν
  let ℓ : W1p0 volume (U ⊓ H) 2 →L[ℝ] ℝ :=
    ((innerSL ℝ hF.toLp).comp W1p.gradientL).comp (w1p0Submodule volume (U ⊓ H) 2).toSubmodule.subtypeL
  have hℓ (v : W1p0 volume (U ⊓ H) 2) : ℓ v =
      ∫ x in ((U ⊓ H : Opens V) : Set V), ⟪F x, W1p.gradient (v : W1p volume (U ⊓ H) 2) x⟫_ℝ := by
    simp only [ℓ, ContinuousLinearMap.comp_apply,
      innerSL_apply_apply, W1p.gradientL_apply]
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [hF.coeFn_toLp] with x hx
    rw [hx]
    rfl
  have hcoeff : MemLp (fun x : V => energyIntegrand
      (reflectPrincipal ν 0 (fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) x)
      (reflectDrift ν 0 (0 : V → V) x) (reflectDensity ν 0 (0 : V → ℝ) x))
      ⊤ (volume.restrict (U : Set V)) := by
    rw [reflectPrincipal_one, reflectDrift_zero, reflectDensity_zero]
    simpa using memLp_top_const (μ := volume.restrict (U : Set V))
      (energyIntegrand (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) 0 0)
  have hw := energyFormH1_reflectPrincipal_sub_compHyperplaneReflectionL
    (a := fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) (b := 0) (c := 0)
    (u := u) hν (positiveNormalHalfSpace_mem_iff ν) hU hcoeff hu0
    (ℓ := ℓ) (fun v => (hu v).trans (hℓ v).symm) φ
  have henergy : energyFormH1
      (reflectPrincipal ν 0 (fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)))
      (reflectDrift ν 0 (0 : V → V)) (reflectDensity ν 0 (0 : V → ℝ)) =
      energyFormH1 (mu := volume) (Omega := U) (fun _ => 1) 0 0 := by
    rw [reflectPrincipal_one (n := n) ν 0, reflectDrift_zero, reflectDensity_zero]
  rw [henergy] at hw
  exact hw.trans ((hℓ _).trans
    (setIntegral_inner_gradient_restrictSubReflection_eq_reflectedForcing ν hν hU hF φ))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_holderOnWith_gradient_of_odd_dirichlet_reflection {U : Opens V}
    (ν : V) (hν : ‖ν‖ = 1) (hU : MapsTo (hyperplaneReflection ν 0) U U)
    (u : W1p volume U 2)
    (hu0 : ∀ᵐ x ∂volume.restrict (U : Set V), x ∉ positiveNormalHalfSpace ν → W1p.value u x = 0)
    {F : V → V} {K α : ℝ≥0} {S : Set V} {R : ℝ}
    (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R) (hS : thickening R S ⊆ U)
    (hFHolder : HolderOnWith K α F {x | 0 ≤ ⟪ν, x⟫_ℝ})
    (hF : MemLp F 2 (volume.restrict ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V)))
    (hu : ∀ v : W1p0 volume (U ⊓ positiveNormalHalfSpace ν) 2,
      energyFormH1 (fun _ => 1) 0 0 (W1p.restrictL (inf_le_left : U ⊓ positiveNormalHalfSpace ν ≤ U) u)
        (v : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) =
      ∫ x in ((U ⊓ positiveNormalHalfSpace ν : Opens V) : Set V),
        ⟪F x, W1p.gradient (v : W1p volume (U ⊓ positiveNormalHalfSpace ν) 2) x⟫_ℝ) :
    ∃ L : ℝ≥0, HolderOnWith L α
      (TauCeti.MeasureTheory.preciseRepresentative volume (W1p.gradient
        (u - W1p.compHyperplaneReflectionL ENNReal.ofNat_ne_top ν 0 hU u) : V → V)) S := by
  have hν0 : ν ≠ 0 := norm_ne_zero_iff.mp (by rw [hν]; exact one_ne_zero)
