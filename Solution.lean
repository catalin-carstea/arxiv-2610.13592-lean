noncomputable section ProofPart_InteriorAnalytic_AnalyticOperatorEquation


/- Analytic dependence for the actual preconditioned local equation.
This is an ordinary helper for the interior translation argument. Analyticity
of the concrete operator family remains a separate producer obligation. -/
open Filter
open scoped Topology ContDiff
namespace ConformalPoisson
variable {E X : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

def operatorResidual (A : E → X →L[ℝ] X) (F : E → X) (z : E × X) : X :=
  A z.1 z.2 - F z.1

omit [CompleteSpace E] in
without_proof_info in
theorem analyticAt_operatorResidual
    {A : E → X →L[ℝ] X} {F : E → X} {p : E} {x : X}
    (hA : AnalyticAt ℝ A p) (hF : AnalyticAt ℝ F p) :
    AnalyticAt ℝ (operatorResidual A F) (p, x) := by
  exact (((hA.contDiffAt.comp (p, x) contDiffAt_fst).clm_apply contDiffAt_snd).sub
    (hF.contDiffAt.comp (p, x) contDiffAt_fst)).analyticAt

without_proof_info in
/-- A continuous actual solution family of an analytic invertible linear
equation is analytic. No selected regularity or boundary input is used. -/
theorem analyticAt_of_operator_equation
    {A : E → X →L[ℝ] X} {F g : E → X} {p : E}
    (hA : AnalyticAt ℝ A p) (hF : AnalyticAt ℝ F p)
    (hg : ContinuousAt g p) (hinv : (A p).IsInvertible)
    (heq : ∀ᶠ q in 𝓝 p, A q (g q) = F q) :
    AnalyticAt ℝ g p := by
  have hR := analyticAt_operatorResidual (x := g p) hA hF
  have hpartial : HasFDerivAt (fun x => operatorResidual A F (p, x))
      (A p) (g p) := (A p).hasFDerivAt.sub_const (F p)
  have hunique := (hR.differentiableAt.hasFDerivAt.comp (g p)
    (hasFDerivAt_prodMk_right (𝕜 := ℝ) p (g p))).unique hpartial
  apply analyticAt_of_implicit_equation (operatorResidual A F) g p hR hg
  · rwa [hunique]
  · have hbase := heq.self_of_nhds
    filter_upwards [heq] with q hq
    simp only [operatorResidual, hq, hbase, sub_self]

without_proof_info in
theorem analyticAt_evaluation_of_operator_equation
    {A : E → X →L[ℝ] X} {F g : E → X} {p : E}
    (hA : AnalyticAt ℝ A p) (hF : AnalyticAt ℝ F p)
    (hg : ContinuousAt g p) (hinv : (A p).IsInvertible)
    (heq : ∀ᶠ q in 𝓝 p, A q (g q) = F q) (ev : X →L[ℝ] ℝ) :
    AnalyticAt ℝ (fun q => ev (g q)) p :=
  (ev.analyticAt _).comp (analyticAt_of_operator_equation hA hF hg hinv heq)

end ConformalPoisson

