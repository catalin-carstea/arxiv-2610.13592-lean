  intro i _
  apply ContDiffOn.sum
  intro j _
  exact (contDiffOn_chartInverseMetric_entry α i j).smul
    (((contDiffOn_chartChristoffel α).clm_apply contDiffOn_const).clm_apply contDiffOn_const)

omit [IsManifold I 2 M]
  [RiemannianBundle (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun y : M => TangentSpace I y)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I] in
without_proof_info in
theorem contDiffOn_chartPotentialCoefficient (α : M) {q : M → ℝ}
    (hq : ContMDiffOn I 𝓘(ℝ) ∞ q (chartAt H α).source) :
    ContDiffOn ℝ ∞ (chartPotentialCoefficient (I := I) α q)
