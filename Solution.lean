/- Assignment268, /root. The SAME amplitude, phase and original boundary
identification give literally the SAME global boundary data in both native
charts, including outside their targets and for all finite truncation orders. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson.LocalDN
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem commonCharts_boundary_target_iff
    (β : Diffeomorph (𝓡 n) (𝓡 n) ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (x : (𝓡∂ (n + 1)).boundary M₁)
    {g₁ : Metric (n := n) (M := M₁)} {g₂ : Metric (n := n) (M := M₂)}
    {U₁ : TopologicalSpace.Opens M₁} {U₂ : TopologicalSpace.Opens M₂}
    (C : CommonNormalCharts β x g₁ g₂ U₁ U₂) (y : (𝓡∂ (n + 1)).boundary M₁) :
    (y : M₁) ∈ C.chart₁.target ↔ (β y : M₂) ∈ C.chart₂.target := by
  constructor
  · intro hy
    let z := C.chart₁.symm (y : M₁)
    have hz : z ∈ C.chart₁.source := C.chart₁.symm.map_source hy
    have he : C.chart₁ z = (y : M₁) := C.chart₁.right_inv hy
    have hB : C.chart₁ z ∈ (𝓡∂ (n + 1)).boundary M₁ := he.symm ▸ y.property
    have hz0 := (chart_boundary_iff_coordinate_zero C.chart₁ hz).mp hB
    have hβ := C.boundary z hz hz0 hB
    have heB : (⟨C.chart₁ z, hB⟩ : (𝓡∂ (n + 1)).boundary M₁) = y := Subtype.ext he
    rw [heB] at hβ
    rw [← hβ]
    exact C.chart₂.map_source (C.source_eq ▸ hz)
  · intro hy
    let z := C.chart₂.symm (β y : M₂)
    have hz₂ : z ∈ C.chart₂.source := C.chart₂.symm.map_source hy
    have hz₁ : z ∈ C.chart₁.source := C.source_eq.symm ▸ hz₂
    have he : C.chart₂ z = (β y : M₂) := C.chart₂.right_inv hy
    have hz0 := (chart_boundary_iff_coordinate_zero C.chart₂ hz₂).mp (he.symm ▸ (β y).property)
    have hB := (chart_boundary_iff_coordinate_zero C.chart₁ hz₁).mpr hz0
    have hβ := C.boundary z hz₁ hz0 hB
    have heB : (⟨C.chart₁ z, hB⟩ : (𝓡∂ (n + 1)).boundary M₁) = y :=
      β.injective (Subtype.ext (hβ.symm.trans he))
    have he₁ : C.chart₁ z = (y : M₁) := congrArg Subtype.val heB
    exact he₁ ▸ C.chart₁.map_source hz₁

namespace BoundaryLayerCoefficients

without_proof_info in
theorem nativeWave_common_boundary
    (β : Diffeomorph (𝓡 n) (𝓡 n) ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    (x : (𝓡∂ (n + 1)).boundary M₁)
    {g₁ : Metric (n := n) (M := M₁)} {g₂ : Metric (n := n) (M := M₂)}
    {O₁ : TopologicalSpace.Opens M₁} {O₂ : TopologicalSpace.Opens M₂}
    (C : CommonNormalCharts β x g₁ g₂ O₁ O₂)
    {ξ : Fin n → ℝ} {U₁ U₂ : Set Y} (B₁ : BoundaryLayerCoefficients ξ U₁) (B₂ : BoundaryLayerCoefficients ξ U₂)
    (a : Y → ℂ) (η₁ η₂ : ℝ → ℝ) (hη₁ : η₁ 0 = 1) (hη₂ : η₂ 0 = 1)
    (N₁ N₂ : ℕ) (h : ℝ) (y : (𝓡∂ (n + 1)).boundary M₁) :
    B₂.nativeWave C.chart₂ a η₂ N₂ h (β y) = B₁.nativeWave C.chart₁ a η₁ N₁ h y := by
  by_cases hy : (y : M₁) ∈ C.chart₁.target
  · let z := C.chart₁.symm (y : M₁)
    have hz : z ∈ C.chart₁.source := C.chart₁.symm.map_source hy
    have he : C.chart₁ z = (y : M₁) := C.chart₁.right_inv hy
    have hB : C.chart₁ z ∈ (𝓡∂ (n + 1)).boundary M₁ := he.symm ▸ y.property
    have hz0 := (chart_boundary_iff_coordinate_zero C.chart₁ hz).mp hB
    have hβ := C.boundary z hz hz0 hB
    have heB : (⟨C.chart₁ z, hB⟩ : (𝓡∂ (n + 1)).boundary M₁) = y := Subtype.ext he
    rw [heB] at hβ
    rw [← he, ← hβ]
    rw [B₂.nativeWave_boundary_chart C.chart₂ a η₂ hη₂ N₂ h (C.source_eq ▸ hz) hz0,
      B₁.nativeWave_boundary_chart C.chart₁ a η₁ hη₁ N₁ h hz hz0]
  · have hy₂ : (β y : M₂) ∉ C.chart₂.target :=
      fun hy₂ => hy ((commonCharts_boundary_target_iff β x C y).mpr hy₂)
    exact (coordinatePushforward_eq_zero_outside C.chart₂ _ hy₂).trans
      (coordinatePushforward_eq_zero_outside C.chart₁ _ hy).symm

end BoundaryLayerCoefficients
end ConformalPoisson.LocalDN

