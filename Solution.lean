  have hA : ContMDiff ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) ((𝓡∂ (n + 1)).tangent) ∞
      (fun z : M × M => (TotalSpace.mk' V z.2 (X z.2) : TangentBundle Ihalf M)) :=
