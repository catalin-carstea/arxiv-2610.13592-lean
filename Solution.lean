        (volume.restrict (splitBoundaryChartCap (n := n) c (R / 4 ^ N) : Set P)) ≤
      C * lpNorm (fun z : P => f ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (a : ℝ≥0∞)
