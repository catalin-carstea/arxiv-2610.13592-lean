noncomputable section ProofPart_FirstOrderCovectorRecovery



/-
Arbitrary zero-value solution covectors determine the actual first-order drift
identity between a conformal metric factor and the solution multiplier.
OpenValueCovectorJets supplies this range from the original compact problem.
-/

open Bundle
open scoped Manifold ContDiff InnerProductSpace

namespace ConformalPoisson

variable {n : ℕ} {M D : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem conformal_firstOrder_covector_of_scaled_family
    (g : Metric (n := n) (M := M)) (q p a r : M → ℝ) (u : D → M → ℝ)
    (ha : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ a) (hapos : ∀ x, 0 < a x)
    (hr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ r)
    (hu : ∀ f, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (u f)) (x : M)
    (hjets : ∀ ξ : TangentSpace (𝓡∂ (n + 1)) x →L[ℝ] ℝ,
      ∃ f, u f x = 0 ∧ mvfderiv (𝓡∂ (n + 1)) (u f) x = ξ)
    (hLu : ∀ f, schrodinger g q (u f) x = 0)
    (hscaled : ∀ f, schrodinger (g.rescale a ha hapos) p (r * u f) x = 0) :
    (2 : ℝ) • mvfderiv (𝓡∂ (n + 1)) r x +
      ((((n + 1 : ℝ) - 2) / (2 * a x)) * r x) • mvfderiv (𝓡∂ (n + 1)) a x = 0 := by
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  ext v
  obtain ⟨f, hf, hD⟩ := hjets (g.inner x v)
  have hgrad : TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) (u f) x = v := by
    apply ext_inner_right ℝ
    intro w
    rw [TauCeti.Manifold.inner_mgradient, hD]
    rfl
  have hp := conformal_firstOrder_pairing_of_zero_solution g q p a r (u f)
    ha hapos hr (hu f) x hf (hLu f) (hscaled f)
  change 2 * inner ℝ (TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) r x)
      (TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) (u f) x) +
    (((n + 1 : ℝ) - 2) / (2 * a x)) * r x *
      inner ℝ (TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) a x)
        (TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) (u f) x) = 0 at hp
  rw [hgrad, TauCeti.Manifold.inner_mgradient, TauCeti.Manifold.inner_mgradient] at hp
  exact hp

end ConformalPoisson

end ProofPart_FirstOrderCovectorRecovery

