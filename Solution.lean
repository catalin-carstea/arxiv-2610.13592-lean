noncomputable section ProofPart_GreenTrace_SchwartzScalarProductDeriv



/- Exact Leibniz expansions for the scalar formal transpose. -/
open TauCeti LineDeriv
open scoped SchwartzMap ContDiff
namespace ConformalPoisson
variable {d : ℕ}

without_proof_info in
theorem schwartz_second_deriv_smulLeft
    {c : CoordinateSpace d → ℂ} (hc : c.HasTemperateGrowth)
    (f : 𝓢(CoordinateSpace d, ℂ)) (v w : CoordinateSpace d) :
    ∂_{v} (∂_{w} (SchwartzMap.smulLeftCLM ℂ c f)) =
      SchwartzMap.smulLeftCLM ℂ c (∂_{v} (∂_{w} f)) +
      SchwartzMap.smulLeftCLM ℂ (fun x => fderiv ℝ c x v) (∂_{w} f) +
      SchwartzMap.smulLeftCLM ℂ (fun x => fderiv ℝ c x w) (∂_{v} f) +
      SchwartzMap.smulLeftCLM ℂ (fun x => fderiv ℝ (fun z => fderiv ℝ c z w) x v) f := by
  rw [SchwartzMap.lineDerivOp_smulLeftCLM hc f w, lineDerivOp_add,
    SchwartzMap.lineDerivOp_smulLeftCLM (hc.fderiv_apply w) f v,
    SchwartzMap.lineDerivOp_smulLeftCLM hc (∂_{w} f) v]
  abel

without_proof_info in
theorem fderiv_ofReal_apply {c : CoordinateSpace d → ℝ}
    (hc : Differentiable ℝ c) (x v : CoordinateSpace d) :
    fderiv ℝ (fun z => (c z : ℂ)) x v = (fderiv ℝ c x v : ℂ) := by
  have h := (Complex.ofRealCLM.hasFDerivAt.comp x (hc x).hasFDerivAt).fderiv
  exact congrArg (fun L => L v) h

without_proof_info in
theorem fderiv_fderiv_ofReal_apply {c : CoordinateSpace d → ℝ}
    (hc : ContDiff ℝ ∞ c) (x v w : CoordinateSpace d) :
    fderiv ℝ (fun z => fderiv ℝ (fun a => (c a : ℂ)) z w) x v =
      (fderiv ℝ (fun z => fderiv ℝ c z w) x v : ℂ) := by
  have hfun : (fun z => fderiv ℝ (fun a => (c a : ℂ)) z w) =
      (fun z => (fderiv ℝ c z w : ℂ)) := by
    funext z
    exact fderiv_ofReal_apply (hc.differentiable (by simp)) z w
  rw [hfun]
  apply fderiv_ofReal_apply
  exact ((hc.fderiv_right (m := 1) (by simp)).clm_apply contDiff_const).differentiable (by simp)

end ConformalPoisson

end ProofPart_GreenTrace_SchwartzScalarProductDeriv

/- Green/trace proof support: FormalTransposeScalarSymbol.lean, SHA256 6203c6ccb12b1961042719401a451e41dd3ece4e2a05c79e5c25b0b8eb765cb3 -/
noncomputable section ProofPart_GreenTrace_FormalTransposeScalarSymbol



/- Expanded coefficients of the scalar formal transpose. The principal
part is unchanged; all derivative terms retain their actual signs. -/
open TauCeti
open scoped ContDiff InnerProductSpace
namespace ConformalPoisson
set_option backward.isDefEq.respectTransparency false
variable {d : ℕ}

abbrev FormalTransposeTerm (d : ℕ) := ((Fin d × Fin d) × Fin 4) ⊕ ((Fin d × Fin 2) ⊕ Unit)

def formalTransposeTermOrder : FormalTransposeTerm d → ℕ
  | Sum.inl (_, ⟨0, _⟩) => 2
  | Sum.inl (_, ⟨1, _⟩) => 1
  | Sum.inl (_, ⟨2, _⟩) => 1
  | Sum.inl (_, ⟨_ + 3, _⟩) => 0
  | Sum.inr (Sum.inl (_, ⟨0, _⟩)) => 1
  | Sum.inr (Sum.inl (_, ⟨_ + 1, _⟩)) => 0
  | Sum.inr (Sum.inr _) => 0

def formalTransposeTermDirections : ∀ i : FormalTransposeTerm d,
    Fin (formalTransposeTermOrder i) → CoordinateSpace d
  | Sum.inl (ij, ⟨0, _⟩) => ![EuclideanSpace.single ij.1 1, EuclideanSpace.single ij.2 1]
  | Sum.inl (ij, ⟨1, _⟩) => fun _ => EuclideanSpace.single ij.2 1
  | Sum.inl (ij, ⟨2, _⟩) => fun _ => EuclideanSpace.single ij.1 1
  | Sum.inl (_, ⟨_ + 3, _⟩) => Fin.elim0
  | Sum.inr (Sum.inl (i, ⟨0, _⟩)) => fun _ => EuclideanSpace.single i 1
  | Sum.inr (Sum.inl (_, ⟨_ + 1, _⟩)) => Fin.elim0
  | Sum.inr (Sum.inr _) => Fin.elim0

def principalScalarEntry
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d) (i j : Fin d) :
    CoordinateSpace d → ℝ := fun x => (A x (EuclideanSpace.single i 1)) j

def formalTransposeTermCoefficient
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ) :
    FormalTransposeTerm d → CoordinateSpace d → ℝ
  | Sum.inl (ij, ⟨0, _⟩) => fun x => -principalScalarEntry A ij.1 ij.2 x
  | Sum.inl (ij, ⟨1, _⟩) => fun x => -coordinateDeriv [ij.1] (principalScalarEntry A ij.1 ij.2) x
  | Sum.inl (ij, ⟨2, _⟩) => fun x => -coordinateDeriv [ij.2] (principalScalarEntry A ij.1 ij.2) x
  | Sum.inl (ij, ⟨_ + 3, _⟩) => fun x => -coordinateDeriv [ij.1, ij.2] (principalScalarEntry A ij.1 ij.2) x
  | Sum.inr (Sum.inl (i, ⟨0, _⟩)) => fun x => -b x i
  | Sum.inr (Sum.inl (i, ⟨_ + 1, _⟩)) => fun x => -coordinateDeriv [i] (fun z => b z i) x
  | Sum.inr (Sum.inr _) => q

without_proof_info in
theorem formalTransposeTermOrder_le_two (i : FormalTransposeTerm d) :
    formalTransposeTermOrder i ≤ 2 := by
  rcases i with ⟨ij, l⟩ | (⟨i, l⟩ | u)
  · fin_cases l <;> simp [formalTransposeTermOrder]
  · fin_cases l <;> simp [formalTransposeTermOrder]
  · simp [formalTransposeTermOrder]

without_proof_info in
theorem contDiff_principalScalarEntry
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (hA : ContDiff ℝ ∞ A) (i j : Fin d) : ContDiff ℝ ∞ (principalScalarEntry A i j) := by
  change ContDiff ℝ ∞ (fun x => (A x (EuclideanSpace.single i 1)) j)
  exact (EuclideanSpace.proj j).contDiff.comp (hA.clm_apply contDiff_const)

without_proof_info in
theorem contDiff_formalTransposeTermCoefficient
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q)
    (t : FormalTransposeTerm d) : ContDiff ℝ ∞ (formalTransposeTermCoefficient A b q t) := by
  rcases t with ⟨ij, l⟩ | (⟨i, l⟩ | u)
  · have he := contDiff_principalScalarEntry A hA ij.1 ij.2
    fin_cases l
    · exact he.neg
    · exact (he.coordinateDeriv [ij.1]).neg
    · exact (he.coordinateDeriv [ij.2]).neg
    · exact (he.coordinateDeriv [ij.1, ij.2]).neg
  · have he := (EuclideanSpace.proj i).contDiff.comp hb
    fin_cases l
    · exact he.neg
    · exact (he.coordinateDeriv [i]).neg
  · exact hq

def formalTransposeScalarSymbol
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q) : ClassicalSymbol d ℂ ℂ 2 :=
  realScalarDifferentialSymbol formalTransposeTermOrder formalTransposeTermDirections
    (formalTransposeTermCoefficient A b q) (contDiff_formalTransposeTermCoefficient A b q hA hb hq)
    formalTransposeTermOrder_le_two

without_proof_info in
theorem formalTransposeTerm_quadratic_sum
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (x ξ : CoordinateSpace d) :
    -(∑ i : FormalTransposeTerm d, if formalTransposeTermOrder i = 2 then
      (∏ j, ⟪ξ, formalTransposeTermDirections i j⟫_ℝ) * formalTransposeTermCoefficient A b q i x else 0) =
      ⟪A x ξ, ξ⟫_ℝ := by
  convert secondOrderTerm_quadratic_sum A b q x ξ using 1
  simp [Fintype.sum_sum_type, Fintype.sum_prod_type, Fin.sum_univ_four, Fin.sum_univ_two,
    formalTransposeTermOrder, formalTransposeTermDirections, formalTransposeTermCoefficient,
    secondOrderTermOrder, secondOrderTermDirections, secondOrderTermCoefficient, principalScalarEntry]

def formalTransposePotential
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ) : CoordinateSpace d → ℝ :=
  fun x => q x - (∑ i, ∑ j, coordinateDeriv [i, j] (principalScalarEntry A i j) x) -
    ∑ i, coordinateDeriv [i] (fun z => b z i) x

without_proof_info in
theorem formalTransposeTerm_zero_sum
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (x ξ : CoordinateSpace d) :
    (∑ i : FormalTransposeTerm d, if formalTransposeTermOrder i = 0 then
      (∏ j, ⟪ξ, formalTransposeTermDirections i j⟫_ℝ) * formalTransposeTermCoefficient A b q i x else 0) =
      formalTransposePotential A b q x := by
  simp [Fintype.sum_sum_type, Fintype.sum_prod_type, Fin.sum_univ_four, Fin.sum_univ_two,
    formalTransposeTermOrder, formalTransposeTermDirections, formalTransposeTermCoefficient,
    formalTransposePotential, Finset.sum_neg_distrib]
  ring

without_proof_info in
theorem contDiff_formalTransposePotential
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q) :
    ContDiff ℝ ∞ (formalTransposePotential A b q) := by
  have hb' : ∀ i : Fin d, ContDiff ℝ ∞ (fun z => b z i) := by
    intro i
    simpa only [Function.comp_def, PiLp.proj_apply] using
      (EuclideanSpace.proj i : CoordinateSpace d →L[ℝ] ℝ).contDiff.comp hb
  exact (hq.sub (ContDiff.sum fun i _ => ContDiff.sum fun j _ =>
    (contDiff_principalScalarEntry A hA i j).coordinateDeriv [i, j])).sub
      (ContDiff.sum fun i _ => (hb' i).coordinateDeriv [i])

without_proof_info in
theorem formalTransposeScalarSymbol_uniformly_elliptic
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q)
    {lam C₀ : ℝ} (hlam : 0 < lam) (hC₀ : 0 ≤ C₀)
    (hell : ∀ x ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪A x ξ, ξ⟫_ℝ)
    (hzero : ∀ x, -C₀ ≤ formalTransposePotential A b q x) :
    ∃ R > 0, (formalTransposeScalarSymbol A b q hA hb hq).toSymbol.IsUniformlyEllipticAbove R := by
  apply realScalarDifferentialSymbol_uniformly_elliptic _ _ _ _ _ hlam hC₀
  · intro x ξ
    rw [formalTransposeTerm_quadratic_sum]
    exact hell x ξ
  · intro x ξ
    rw [formalTransposeTerm_zero_sum]
    exact hzero x

end ConformalPoisson

end ProofPart_GreenTrace_FormalTransposeScalarSymbol

