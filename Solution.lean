    have hjM : j ≤ M := by have hhj := Finset.mem_range.mp hj; omega
    have hp : ‖(h ^ j : ℂ)‖ ≤ 1 := by
      simpa only [norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hh] using pow_le_one₀ (n := j) hh.le hh1
    have hτ' : ‖(F.tau z : ℂ)‖ ≤ T := by simpa only [Complex.norm_real, Real.norm_eq_abs] using hτ z hz ht
    rw [norm_mul]
    exact (mul_le_mul hp (hb₁ j hjM y hz t ht.1 h hh hh1 (F.tau z) hτ')
      (norm_nonneg _) (by positivity)).trans_eq (one_mul _)
  change ‖∑ j ∈ range (M + 1), (h ^ j : ℂ) * ((h : ℂ) ^ 2 *
    complexSplitOperator A (F.tau z) c (normalCutoffWave η (scaledPlaneWave ξ h (B.profile a j))) y t)‖ ≤ _
  rw [heq, norm_mul, norm_tangentialWave, one_mul]
