    rw [hjet.1, (hju x).1]
    simp [localizedSolutionDifference, localizedTranslation, hχx]
  · change (ballHolderJetL hα (Jdiff a)).2.1 x + ju.2.1 x = _
    rw [hjet.2.1, (hju x).2.1]
