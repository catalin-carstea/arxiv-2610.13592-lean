    simpa only [extChartAt_source] using hx.1
  have hfront := (TauCeti.ModelWithCorners.isBoundaryPoint_iff_mem_frontier_range
    (I := Ihalf) (k := ∞) (by simp) (IsManifold.chart_mem_maximalAtlas c) hsrc).1 hxB
  change extChartAt Ihalf c x ∈ frontier (range Ihalf) at hfront
  rw [frontier_range_modelWithCornersEuclideanHalfSpace] at hfront
