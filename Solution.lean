open DirichletSobolev
variable {c : M} (L : BoundaryChartLocalization (I := I) c)

without_proof_info in
theorem inner_chart_norm_bounds_of_native_value_ae
    (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x})
    (w : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x})
    (hval : (valueL (I := I) {x : M | I.IsBoundaryPoint x} u : M → ℝ)
      =ᵐ[riemannianVolume I M] w.val) :
    lpNorm (w.val ∘ (extChartAt I c).symm) 2
        ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) ≤ ‖L.innerReadingL‖ * ‖u‖ ∧
    lpNorm (∇ (w.val ∘ (extChartAt I c).symm)) 2
        ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) ≤ ‖L.innerReadingL‖ * ‖u‖ := by
  have heq := L.innerReadingL_eq_smooth_of_native_value_ae u w hval
  have hv := L.innerReadingL_smooth_value_ae w
  have hg := L.innerReadingL_smooth_gradient_ae w
  rw [← heq] at hv hg
  have hvnorm : lpNorm (w.val ∘ (extChartAt I c).symm) 2
      ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) =
      ‖W1p.value (L.innerReadingL u)‖ := by
    rw [Lp.norm_def, lpNorm, eLpNorm_congr_ae hv]
  have hgnorm : lpNorm (∇ (w.val ∘ (extChartAt I c).symm)) 2
      ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) =
      ‖W1p.gradient (L.innerReadingL u)‖ := by
    rw [Lp.norm_def, lpNorm, eLpNorm_congr_ae hg]
  rw [hvnorm, hgnorm]
  exact ⟨(W1p.norm_value_le _).trans (L.innerReadingL.le_opNorm u),
    (W1p.norm_gradient_le _).trans (L.innerReadingL.le_opNorm u)⟩

end ConformalPoisson.BoundaryChartLocalization

