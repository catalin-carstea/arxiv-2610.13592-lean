open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem native_trace_highest_jet_response {S : TopologicalSpace.Opens H}
    (F₁ F₂ : NormalMetricField S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hA₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.inverse S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.inverse S)
    {U W : Set Y} (hUS : MapsTo (EuclideanHalfSpace.boundaryParam n) U S)
    (hU : IsOpen U) {K : Set Y} (hK : IsClosed K) (a : Y → ℂ)
    (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (hW : IsOpen W) (hWU : W ⊆ U) (ha1 : EqOn a (fun _ => 1) W) (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) (L : ℕ)
    (hj : ∀ r ≤ L, EqOn (normalJet r F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet r F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W) :
    let B₁ := nativeBoundaryLayerCoefficients F₁ hG₁ hA₁ hUS ξ hξ;
    let B₂ := nativeBoundaryLayerCoefficients F₂ hG₂ hA₂ hUS ξ hξ;
    ∀ y ∈ W, B₁.traceCoefficient a (L + 1) y - B₂.traceCoefficient a (L + 1) y =
      -Complex.ofReal ((normalMatrixQuadratic (normalJet L F₁.K (EuclideanHalfSpace.boundaryParam n y)) ξ -
        normalMatrixQuadratic (normalJet L F₂.K (EuclideanHalfSpace.boundaryParam n y)) ξ) /
        (2 * F₁.principal ξ (EuclideanHalfSpace.boundaryParam n y)) ^ (L + 2)) := by
  let B₁ := nativeBoundaryLayerCoefficients F₁ hG₁ hA₁ hUS ξ hξ
  let B₂ := nativeBoundaryLayerCoefficients F₂ hG₂ hA₂ hUS ξ hξ
  obtain ⟨hκ, hAi, hτ, hc⟩ := native_coefficient_jet_comparison F₁ F₂ hG₁ hA₁ hG₂ hA₂ hUS hW hWU ξ hξ L hj
  dsimp only
  intro y hy
  have he := B₁.traceCoefficient_top_difference B₂ hU hK a ha ha0 hW hWU hκ ha1 (L + 1) (by omega)
    (fun l hl i r => hAi l (by omega) i r) (fun l hl => hτ l (by omega))
    (fun l hl i => hc l (by omega) i) hy
  simp only [Nat.add_sub_cancel] at he
  rw [native_inverseTaylor_quadratic F₁ hG₁ hA₁ hUS ξ hξ (L + 1) (hWU hy),
    native_inverseTaylor_quadratic F₂ hG₂ hA₂ hUS ξ hξ (L + 1) (hWU hy),
    native_normalTaylor_reading F₁ hG₁ hA₁ hUS ξ hξ L y,
    native_normalTaylor_reading F₂ hG₂ hA₂ hUS ξ hξ L y] at he
  let z := EuclideanHalfSpace.boundaryParam n y
  let k := F₁.principal ξ z
  have hk : (k : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (F₁.principal_pos ξ hξ z (hUS (hWU hy))).ne'
  have hK := normalJet_K_quadratic_difference F₁ F₂ L (hUS (hWU hy)) (fun r hr => hj r hr hy) ξ hξ
  rw [he]
