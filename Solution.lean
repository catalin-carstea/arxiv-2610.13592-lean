noncomputable section ProofPart_DirichletHolderSpace
/-
Copyright (c) 2026 The Tau Ceti contributors. All rights reserved.
Released under Apache 2.0 license as described in External/LICENSE.tauceti.
The derivative-graph construction is adapted by actual /root from
TauCeti.Analysis.Holder.One and TauCeti.Analysis.Holder.Two,
revision 4d91513e4d30746eb1fa96658c18e051c772e55e,
for fields on a closed domain and derivatives on its open interior.
-/





/- A complete space of C2-alpha fields on a closed domain with zero
boundary values. Derivative identities are required only on the open
interior; no extension theorem across the boundary is assumed. -/
open Set Filter Topology
open scoped BoundedContinuousFunction NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

local instance : NormedAddCommGroup (E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := F)
local instance : NormedAddCommGroup (E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := E →L[ℝ] F)

/-- The closed-domain value, first derivative and Holder Hessian fields. -/
abbrev DomainJet (α : ℝ≥0) (s : Set E) :=
  (s →ᵇ F) × (s →ᵇ (E →L[ℝ] F)) × TauCeti.HolderSpace α s (E →L[ℝ] E →L[ℝ] F)

instance normedAddCommGroup_domainJet (α : ℝ≥0) (s : Set E) :
    NormedAddCommGroup (DomainJet (F := F) α s) := inferInstanceAs
      (NormedAddCommGroup ((s →ᵇ F) × (s →ᵇ (E →L[ℝ] F)) ×
        TauCeti.HolderSpace α s (E →L[ℝ] E →L[ℝ] F)))

/-- Compatibility of the actual derivatives on U and zero trace on B. -/
def dirichletGraph (α : ℝ≥0) (s U : Set E) (B : Set s) :
    Submodule ℝ (DomainJet (F := F) α s) where
  carrier := {J | (∀ x ∈ U, HasFDerivAt (domainRead s J.1) (domainRead s J.2.1 x) x) ∧
    (∀ x ∈ U, HasFDerivAt (domainRead s J.2.1)
      (domainRead s J.2.2.toBoundedContinuousFunction x) x) ∧
    ∀ x ∈ B, J.1 x = 0}
  zero_mem' := by
    refine ⟨?_, ?_, ?_⟩
    · intro x hx
      simpa using hasFDerivAt_zero (𝕜 := ℝ) (F := F) x
    · intro x hx
      simpa using hasFDerivAt_zero (𝕜 := ℝ) (F := E →L[ℝ] F) x
    · simp
  add_mem' := by
    intro J K hJ hK
    refine ⟨?_, ?_, ?_⟩
    · intro x hx
      simpa using (hJ.1 x hx).add (hK.1 x hx)
    · intro x hx
      simpa using (hJ.2.1 x hx).add (hK.2.1 x hx)
    · intro x hx
      change J.1 x + K.1 x = 0
      rw [hJ.2.2 x hx, hK.2.2 x hx, add_zero]
  smul_mem' := by
    intro c J hJ
    refine ⟨?_, ?_, ?_⟩
    · intro x hx
      simpa using (hJ.1 x hx).const_smul c
    · intro x hx
      convert (hJ.2.1 x hx).const_smul c using 1
      · funext y
        classical
        by_cases hy : y ∈ s <;> simp [domainRead, hy]
      · classical
        by_cases hy : x ∈ s <;> simp [domainRead, hy]
    · intro x hx
      change c • J.1 x = 0
      rw [hJ.2.2 x hx, smul_zero]

instance normedAddCommGroup_dirichletGraph (α : ℝ≥0) (s U : Set E) (B : Set s) :
    NormedAddCommGroup (dirichletGraph (F := F) α s U B) := by
  unfold dirichletGraph
  infer_instance

instance normedSpace_dirichletGraph (α : ℝ≥0) (s U : Set E) (B : Set s) :
    NormedSpace ℝ (dirichletGraph (F := F) α s U B) := by
  unfold dirichletGraph
  infer_instance

without_proof_info in
/-- Uniform limits preserve both derivative identities and the trace. -/
theorem isClosed_dirichletGraph (α : ℝ≥0) (s : Set E) {U : Set E}
    (hU : IsOpen U) (hUs : U ⊆ s) (B : Set s) :
    IsClosed (dirichletGraph (F := F) α s U B : Set (DomainJet (F := F) α s)) := by
  have hfirst : Continuous (fun J : DomainJet (F := F) α s => (J.1, J.2.1)) :=
    continuous_fst.prodMk (continuous_fst.comp continuous_snd)
  have hsecond : Continuous (fun J : DomainJet (F := F) α s =>
      (J.2.1, J.2.2.toBoundedContinuousFunction)) :=
    (continuous_fst.comp continuous_snd).prodMk (by
      simpa only [Function.comp_def, TauCeti.HolderSpace.toBoundedContinuousFunctionCLM_apply] using
      (TauCeti.HolderSpace.toBoundedContinuousFunctionCLM.continuous.comp
        (continuous_snd.comp continuous_snd)))
  have h1 := (isClosed_domainDerivativeGraph (Y := F) s hU hUs id uniformContinuous_id).preimage hfirst
  have h2 := (isClosed_domainDerivativeGraph (Y := E →L[ℝ] F) s hU hUs
    id uniformContinuous_id).preimage hsecond
  have h0 : IsClosed {J : DomainJet (F := F) α s | ∀ x ∈ B, J.1 x = 0} := by
    simp only [Set.ofPred_forall]
    exact isClosed_iInter fun x => isClosed_iInter fun _ =>
      isClosed_eq ((BoundedContinuousFunction.evalCLM ℝ x).continuous.comp continuous_fst)
        continuous_const
  exact h1.inter (h2.inter h0)

/-- The graph is Banach for Banach-valued fields. -/
instance completeSpace_dirichletGraph [CompleteSpace F] (α : ℝ≥0) (s : Set E)
    {U : Set E} [hU : Fact (IsOpen U)] [hUs : Fact (U ⊆ s)] (B : Set s) :
    CompleteSpace (dirichletGraph (F := F) α s U B) :=
  (isClosed_dirichletGraph α s hU.out hUs.out B).completeSpace_coe

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
without_proof_info in
/-- A field is continuous on its original domain despite the arbitrary
choice of its values outside that domain. -/
theorem continuousOn_domainRead (s : Set E) (f : s →ᵇ F) :
    ContinuousOn (domainRead s f) s := by
  rw [continuousOn_iff_continuous_domRestrict]
  have heq : s.domRestrict (domainRead s f) = (f : s → F) := by
    funext x
    exact domainRead_of_mem s f x.property
  rw [heq]
  exact f.continuous

without_proof_info in
/-- The graph imposes actual C2 regularity on the open interior. -/
theorem dirichletGraph_contDiffOn (α : ℝ≥0) (s : Set E) {U : Set E}
    (hU : IsOpen U) (hUs : U ⊆ s) (B : Set s)
    (J : dirichletGraph (F := F) α s U B) :
    ContDiffOn ℝ 2 (domainRead s J.val.1) U := by
  have hfirst : ContDiffOn ℝ 1 (domainRead s J.val.2.1) U := by
    rw [show (1 : ℕ∞ω) = 0 + 1 from rfl,
      contDiffOn_succ_iff_hasFDerivWithinAt_of_uniqueDiffOn hU.uniqueDiffOn]
    refine ⟨by simp, domainRead s J.val.2.2.toBoundedContinuousFunction, ?_, ?_⟩
    · rw [contDiffOn_zero]
      exact (continuousOn_domainRead s _).mono hUs
    · intro x hx
      exact (J.property.2.1 x hx).hasFDerivWithinAt
  rw [show (2 : ℕ∞ω) = 1 + 1 from rfl,
    contDiffOn_succ_iff_hasFDerivWithinAt_of_uniqueDiffOn hU.uniqueDiffOn]
  refine ⟨by simp, domainRead s J.val.2.1, hfirst, ?_⟩
  intro x hx
  exact (J.property.1 x hx).hasFDerivWithinAt

without_proof_info in
/-- The first derivative is the stored field at every interior point. -/
theorem dirichletGraph_fderiv (α : ℝ≥0) (s U : Set E) (B : Set s)
    (J : dirichletGraph (F := F) α s U B) {x : E} (hx : x ∈ U) :
    fderiv ℝ (domainRead s J.val.1) x = domainRead s J.val.2.1 x :=
  (J.property.1 x hx).fderiv

without_proof_info in
/-- The Hessian of the actual value function agrees with the stored
Holder Hessian; it is not a separately chosen formal jet. -/
theorem dirichletGraph_secondFDeriv (α : ℝ≥0) (s : Set E) {U : Set E}
    (hU : IsOpen U) (B : Set s) (J : dirichletGraph (F := F) α s U B)
    {x : E} (hx : x ∈ U) :
    fderiv ℝ (fderiv ℝ (domainRead s J.val.1)) x =
      domainRead s J.val.2.2.toBoundedContinuousFunction x := by
  have heq : fderiv ℝ (domainRead s J.val.1) =ᶠ[𝓝 x] domainRead s J.val.2.1 := by
    filter_upwards [hU.mem_nhds hx] with y hy
    exact dirichletGraph_fderiv α s U B J hy
  exact ((J.property.2.1 x hx).congr_of_eventuallyEq heq).fderiv

end ConformalPoisson.DirichletHolder

end ProofPart_DirichletHolderSpace

/- Proof support: BallDirichletHolder.lean, SHA256 8d55a6f76c4bfeb5a30cdadfb9f1b3f5622a932b3b97f5592846bf05385bcf7d -/
noncomputable section ProofPart_BallDirichletHolder



/- The complete zero-boundary ball space has the actual derivatives and
max-type C2-alpha bound used by the selected local Schauder input. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

/-- The unit-ball C2-alpha space with actual zero Dirichlet values. -/
abbrev BallSpace (α : ℝ≥0) (E F : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] :=
  dirichletGraph (F := F) α (closedBall (0 : E) 1) (ball 0 1)
    {x | (x : E) ∈ sphere 0 1}

instance completeSpace_ballSpace [CompleteSpace F] (α : ℝ≥0) :
    CompleteSpace (BallSpace α E F) :=
  (isClosed_dirichletGraph α (closedBall (0 : E) 1) isOpen_ball ball_subset_closedBall
    {x | (x : E) ∈ sphere 0 1}).completeSpace_coe

/-- The ordinary function represented by a ball jet. -/
def ballValue {α : ℝ≥0} (J : BallSpace α E F) : E → F :=
  domainRead (closedBall 0 1) J.val.1

without_proof_info in
theorem ballValue_continuousOn {α : ℝ≥0} (J : BallSpace α E F) :
    ContinuousOn (ballValue J) (closedBall 0 1) := continuousOn_domainRead _ _

without_proof_info in
theorem ballValue_zero_boundary {α : ℝ≥0} (J : BallSpace α E F) :
    EqOn (ballValue J) 0 (sphere 0 1) := by
  intro x hx
  rw [ballValue, domainRead_of_mem _ _ (sphere_subset_closedBall hx)]
  exact J.property.2.2 ⟨x, sphere_subset_closedBall hx⟩ hx

without_proof_info in
theorem ballValue_contDiffOn {α : ℝ≥0} (J : BallSpace α E F) :
    ContDiffOn ℝ 2 (ballValue J) (ball 0 1) :=
  dirichletGraph_contDiffOn α _ isOpen_ball ball_subset_closedBall _ J

without_proof_info in
theorem ballValue_fderiv {α : ℝ≥0} (J : BallSpace α E F) {x : E} (hx : x ∈ ball 0 1) :
    fderiv ℝ (ballValue J) x = J.val.2.1 ⟨x, ball_subset_closedBall hx⟩ := by
  rw [ballValue, dirichletGraph_fderiv α _ _ _ J hx,
    domainRead_of_mem _ _ (ball_subset_closedBall hx)]

without_proof_info in
theorem ballValue_secondFDeriv {α : ℝ≥0} (J : BallSpace α E F) {x : E}
    (hx : x ∈ ball 0 1) :
    fderiv ℝ (fderiv ℝ (ballValue J)) x = J.val.2.2 ⟨x, ball_subset_closedBall hx⟩ := by
  rw [ballValue, dirichletGraph_secondFDeriv α _ isOpen_ball _ J hx,
    domainRead_of_mem _ _ (ball_subset_closedBall hx),
    TauCeti.HolderSpace.toBoundedContinuousFunction_apply]

without_proof_info in
/-- The inherited jet norm bounds the value field. -/
theorem norm_value_le {α : ℝ≥0} (J : BallSpace α E F) : ‖J.val.1‖ ≤ ‖J‖ :=
  norm_fst_le J.val

without_proof_info in
/-- The inherited jet norm bounds the first derivative field. -/
theorem norm_first_le {α : ℝ≥0} (J : BallSpace α E F) : ‖J.val.2.1‖ ≤ ‖J‖ :=
  (norm_fst_le J.val.2).trans (norm_snd_le J.val)

without_proof_info in
/-- The inherited jet norm bounds the full Holder norm of the Hessian. -/
theorem norm_second_le {α : ℝ≥0} (J : BallSpace α E F) : ‖J.val.2.2‖ ≤ ‖J‖ :=
  (norm_snd_le J.val.2).trans (norm_snd_le J.val)

without_proof_info in
/-- This is the exact max-type bound in the frozen Schauder interface,
with actual Frechet derivatives of the represented scalar function. -/
theorem ballValue_secondOrderHolderBound {d : ℕ} {α : ℝ≥0}
    (J : BallSpace α (EuclideanSpace ℝ (Fin d)) ℝ) :
    secondOrderHolderBound α (ball 0 1) (ballValue J) ‖J‖₊ := by
  refine ⟨?_, ?_⟩
  · intro x hx
    refine ⟨?_, ?_, ?_⟩
    · rw [ballValue, domainRead_of_mem _ _ (ball_subset_closedBall hx)]
      exact (J.val.1.norm_coe_le_norm _).trans (norm_value_le J)
    · rw [ballValue_fderiv J hx]
      exact (J.val.2.1.norm_coe_le_norm _).trans (norm_first_le J)
    · rw [ballValue_secondFDeriv J hx]
      exact (J.val.2.2.norm_apply_le _).trans (norm_second_le J)
  · intro x hx y hy
    dsimp only
    rw [ballValue_secondFDeriv J hx, ballValue_secondFDeriv J hy]
    have hbound : ‖J.val.2.2‖₊ ≤ ‖J‖₊ := by exact_mod_cast norm_second_le J
    exact (J.val.2.2.holderWith_nnnorm.mono hbound)
      ⟨x, ball_subset_closedBall hx⟩ ⟨y, ball_subset_closedBall hy⟩

end ConformalPoisson.DirichletHolder

end ProofPart_BallDirichletHolder

/- Proof support: SchauderLowerOrderBounds.lean, SHA256 0f3b5caf6c1fc64bb62bbd50003e41cd139029432c3f7b6dada792670849f9ec -/
noncomputable section ProofPart_SchauderLowerOrderBounds



/- Concrete lower-derivative Hölder bounds needed to control the
coefficient perturbation in the selected Schauder norm. -/
open Set Metric
open scoped NNReal ContDiff
namespace ConformalPoisson
variable {d : ℕ}
local notation "E" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem secondOrderHolderBound.mono {α K L : ℝ≥0} {U : Set E} {u : E → ℝ}
    (h : secondOrderHolderBound α U u K) (hKL : K ≤ L) : secondOrderHolderBound α U u L := by
  have hKLr : (K : ℝ) ≤ L := hKL
  refine ⟨?_, h.2.mono_const hKL⟩
  intro x hx
  exact ⟨(h.1 x hx).1.trans hKLr, (h.1 x hx).2.1.trans hKLr, (h.1 x hx).2.2.trans hKLr⟩

without_proof_info in
theorem secondOrderHolderBound.value_holderBound
    {α K : ℝ≥0} (hα : α ≤ 1) {u : E → ℝ}
    (hu : ContDiffOn ℝ 2 u (ball 0 1))
    (hb : secondOrderHolderBound α (ball 0 1) u K) :
    holderBound α (ball 0 1) u (3 * K) := by
  have hd : ∀ x ∈ ball (0 : E) 1, DifferentiableAt ℝ u x := by
    intro x hx
    exact ((hu x hx).contDiffAt (isOpen_ball.mem_nhds hx)).differentiableAt (by simp)
  have hL : LipschitzOnWith K u (ball 0 1) :=
    Convex.lipschitzOnWith_of_nnNorm_fderiv_le hd
      (fun x hx => by exact_mod_cast (hb.1 x hx).2.1) (convex_ball (0 : E) 1)
  have hH := hL.holderOnWith_of_norm_le (fun x hx => (hb.1 x hx).1) hα
  refine ⟨fun x hx => (hb.1 x hx).1.trans ?_, ?_⟩
  · have h : K ≤ 3 * K := le_mul_of_one_le_left (show (0 : ℝ≥0) ≤ K from zero_le) (by norm_num)
    exact_mod_cast h
  · convert hH using 1
    ring

without_proof_info in
theorem secondOrderHolderBound.fderiv_holderBound
    {α K : ℝ≥0} (hα : α ≤ 1) {u : E → ℝ}
    (hu : ContDiffOn ℝ 2 u (ball 0 1))
    (hb : secondOrderHolderBound α (ball 0 1) u K) :
    holderBound α (ball 0 1) (fderiv ℝ u) (3 * K) := by
  have hd : ∀ x ∈ ball (0 : E) 1, DifferentiableAt ℝ (fderiv ℝ u) x := by
    intro x hx
    exact (((hu x hx).contDiffAt (isOpen_ball.mem_nhds hx)).fderiv_right
      (m := 1) (by norm_num)).differentiableAt (by simp)
  have hL : LipschitzOnWith K (fderiv ℝ u) (ball 0 1) :=
    Convex.lipschitzOnWith_of_nnNorm_fderiv_le hd
      (fun x hx => by exact_mod_cast (hb.1 x hx).2.2) (convex_ball (0 : E) 1)
  have hH := hL.holderOnWith_of_norm_le (fun x hx => (hb.1 x hx).2.1) hα
  refine ⟨fun x hx => (hb.1 x hx).2.1.trans ?_, ?_⟩
  · have h : K ≤ 3 * K := le_mul_of_one_le_left (show (0 : ℝ≥0) ≤ K from zero_le) (by norm_num)
    exact_mod_cast h
  · convert hH using 1
    ring

without_proof_info in
theorem secondOrderHolderBound.secondFDeriv_holderBound
    {α K : ℝ≥0} {u : E → ℝ}
    (hb : secondOrderHolderBound α (ball 0 1) u K) :
    holderBound α (ball 0 1) (fderiv ℝ (fderiv ℝ u)) K :=
  ⟨fun x hx => (hb.1 x hx).2.2, hb.2⟩
end ConformalPoisson

end ProofPart_SchauderLowerOrderBounds

/- Proof support: BallHolderReadings.lean, SHA256 7ec5a89c2a1037436188a8d351473e3248faee5d4b3c525df29c9207d30c9495 -/
noncomputable section ProofPart_BallHolderReadings



/- Bounded Holder readings of the lower derivative fields on the closed
ball. The mean value theorem is used on the open ball and continuity
passes its bound to the boundary. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem holderWith_of_ball_derivative {α K : ℝ≥0} (hα : α ≤ 1)
    (f : closedBall (0 : E) 1 →ᵇ F) (D : closedBall (0 : E) 1 →ᵇ (E →L[ℝ] F))
    (hD : ∀ x, ∀ hx : x ∈ ball (0 : E) 1,
      HasFDerivAt (domainRead (closedBall 0 1) f) (D ⟨x, ball_subset_closedBall hx⟩) x)
    (hf : ‖f‖ ≤ K) (hb : ‖D‖ ≤ K) : HolderWith (3 * K) α f := by
  have hL : LipschitzOnWith K (domainRead (closedBall 0 1) f) (ball 0 1) :=
    (convex_ball (0 : E) 1).lipschitzOnWith_of_nnNorm_hasFDerivWithin_le
      (f' := domainRead (closedBall 0 1) D)
      (fun x hx => by
        simpa only [domainRead_of_mem _ _ (ball_subset_closedBall hx)] using
          (hD x hx).hasFDerivWithinAt (s := ball 0 1))
      (fun x hx => by
        rw [domainRead_of_mem _ _ (ball_subset_closedBall hx)]
        exact_mod_cast (D.norm_coe_le_norm ⟨x, ball_subset_closedBall hx⟩).trans hb)
  have hLC : LipschitzOnWith K (domainRead (closedBall 0 1) f) (closedBall 0 1) := by
    have h := hL.closure (by simpa only [closure_ball (0 : E) one_ne_zero] using
      continuousOn_domainRead (closedBall 0 1) f)
    simpa only [closure_ball (0 : E) one_ne_zero] using h
  have hH := hLC.holderOnWith_of_norm_le (M := K) (fun x hx => by
    rw [domainRead_of_mem _ _ hx]
    exact (f.norm_coe_le_norm _).trans hf) hα
  have hres : HolderWith (K + 2 * K) α f := by
    intro x y
    simpa only [domainRead_of_mem _ _ x.property, domainRead_of_mem _ _ y.property,
      Subtype.edist_eq] using hH x.val x.property y.val y.property
  convert hres using 1
  ring

without_proof_info in
/-- Value fields on the closed ball are Holder with one uniform bound. -/
theorem ballValue_holderWith {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    HolderWith (3 * ‖J‖₊) α J.val.1 :=
  holderWith_of_ball_derivative hα J.val.1 J.val.2.1
    (by
      intro x hx
      simpa only [domainRead_of_mem _ _ (ball_subset_closedBall hx)] using (J.property.1 x hx))
    (norm_value_le J) (norm_first_le J)

without_proof_info in
/-- First derivative fields have the same uniform Holder bound. -/
theorem ballFirst_holderWith {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    HolderWith (3 * ‖J‖₊) α J.val.2.1 :=
  holderWith_of_ball_derivative hα J.val.2.1 J.val.2.2.toBoundedContinuousFunction
    (by
      intro x hx
      simpa only [domainRead_of_mem _ _ (ball_subset_closedBall hx)] using (J.property.2.1 x hx))
    (norm_first_le J) (J.val.2.2.norm_toBoundedContinuousFunction_le.trans (norm_second_le J))

def ballValueHolder {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    TauCeti.HolderSpace α (closedBall (0 : E) 1) F :=
  TauCeti.HolderSpace.ofBoundedContinuousFunction J.val.1 (ballValue_holderWith hα J).memHolder

def ballFirstHolder {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    TauCeti.HolderSpace α (closedBall (0 : E) 1) (E →L[ℝ] F) :=
  TauCeti.HolderSpace.ofBoundedContinuousFunction J.val.2.1 (ballFirst_holderWith hα J).memHolder

without_proof_info in
@[simp] theorem ballValueHolder_apply {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F)
    (x : closedBall (0 : E) 1) : ballValueHolder hα J x = J.val.1 x := by
  simp [ballValueHolder]

without_proof_info in
@[simp] theorem ballFirstHolder_apply {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F)
    (x : closedBall (0 : E) 1) : ballFirstHolder hα J x = J.val.2.1 x := by
  simp [ballFirstHolder]

without_proof_info in
theorem norm_ballValueHolder_le {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    ‖ballValueHolder hα J‖ ≤ 4 * ‖J‖ := by
  have h := TauCeti.HolderSpace.norm_le_of_norm_le_of_holderWith
    (f := ballValueHolder hα J) (M := ‖J‖) (norm_nonneg J)
    (fun x => by simpa using (J.val.1.norm_coe_le_norm x).trans (norm_value_le J))
    (by simpa only [funext (ballValueHolder_apply hα J)] using ballValue_holderWith hα J)
  convert h using 1
  push_cast
  ring

without_proof_info in
theorem norm_ballFirstHolder_le {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    ‖ballFirstHolder hα J‖ ≤ 4 * ‖J‖ := by
  have h := TauCeti.HolderSpace.norm_le_of_norm_le_of_holderWith
    (f := ballFirstHolder hα J) (M := ‖J‖) (norm_nonneg J)
    (fun x => by simpa using (J.val.2.1.norm_coe_le_norm x).trans (norm_first_le J))
    (by simpa only [funext (ballFirstHolder_apply hα J)] using ballFirst_holderWith hα J)
  convert h using 1
  push_cast
  ring

/-- The closed-ball value reading is bounded and linear in the actual jet. -/
def ballValueHolderL {α : ℝ≥0} (hα : α ≤ 1) :
    BallSpace α E F →L[ℝ] TauCeti.HolderSpace α (closedBall (0 : E) 1) F :=
  LinearMap.mkContinuous
    { toFun := ballValueHolder hα
      map_add' := fun J K => TauCeti.HolderSpace.ext fun x => by simp
      map_smul' := fun c J => TauCeti.HolderSpace.ext fun x => by simp }
    4 (norm_ballValueHolder_le hα)

/-- The closed-ball first derivative reading is bounded and linear. -/
def ballFirstHolderL {α : ℝ≥0} (hα : α ≤ 1) :
    BallSpace α E F →L[ℝ] TauCeti.HolderSpace α (closedBall (0 : E) 1) (E →L[ℝ] F) :=
  LinearMap.mkContinuous
    { toFun := ballFirstHolder hα
      map_add' := fun J K => TauCeti.HolderSpace.ext fun x => by simp
      map_smul' := fun c J => TauCeti.HolderSpace.ext fun x => by simp }
    4 (norm_ballFirstHolder_le hα)

/-- The top derivative is already a Holder field in the definition of
the graph. No norm is lost by this projection. -/
def ballSecondHolderL {α : ℝ≥0} :
    BallSpace α E F →L[ℝ]
      TauCeti.HolderSpace α (closedBall (0 : E) 1) (E →L[ℝ] E →L[ℝ] F) :=
  LinearMap.mkContinuous
    { toFun := fun J : BallSpace α E F => J.val.2.2
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
    1 (fun J => by
      change ‖J.val.2.2‖ ≤ 1 * ‖J‖
      simpa only [one_mul] using norm_second_le J)

without_proof_info in
@[simp] theorem ballValueHolderL_apply {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    ballValueHolderL hα J = ballValueHolder hα J := rfl

without_proof_info in
@[simp] theorem ballFirstHolderL_apply {α : ℝ≥0} (hα : α ≤ 1) (J : BallSpace α E F) :
    ballFirstHolderL hα J = ballFirstHolder hα J := rfl

without_proof_info in
@[simp] theorem ballSecondHolderL_apply {α : ℝ≥0} (J : BallSpace α E F) :
    ballSecondHolderL J = J.val.2.2 := rfl

without_proof_info in
theorem norm_ballValueHolderL_le {α : ℝ≥0} (hα : α ≤ 1) :
    ‖ballValueHolderL (E := E) (F := F) hα‖ ≤ 4 :=
  LinearMap.mkContinuous_norm_le _ (by norm_num) _

without_proof_info in
theorem norm_ballFirstHolderL_le {α : ℝ≥0} (hα : α ≤ 1) :
    ‖ballFirstHolderL (E := E) (F := F) hα‖ ≤ 4 :=
  LinearMap.mkContinuous_norm_le _ (by norm_num) _

without_proof_info in
theorem norm_ballSecondHolderL_le {α : ℝ≥0} :
    ‖ballSecondHolderL (α := α) (E := E) (F := F)‖ ≤ 1 :=
  LinearMap.mkContinuous_norm_le _ zero_le_one _

section HessianPostcompose
variable {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G]
local instance : NormedAddCommGroup (E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := F)
local instance : NormedAddCommGroup (E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := E →L[ℝ] F)
local instance : NormedAddCommGroup ((E →L[ℝ] E →L[ℝ] F) →L[ℝ] G) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E →L[ℝ] E →L[ℝ] F) (F := G)
local instance : Norm ((E →L[ℝ] E →L[ℝ] F) →L[ℝ] G) :=
  ContinuousLinearMap.hasOpNorm (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E →L[ℝ] E →L[ℝ] F) (F := G)

without_proof_info in
/-- A fixed linear contraction of the Hessian field is controlled by
the norm of that contraction and the native ball-space norm. -/
theorem norm_ballSecond_postcompose_le {α : ℝ≥0}
    (B : (E →L[ℝ] E →L[ℝ] F) →L[ℝ] G) (J : BallSpace α E F) :
    ‖TauCeti.HolderSpace.compLeftL B (ballSecondHolderL J)‖ ≤ ‖B‖ * ‖J‖ := by
  have hJ : ‖ballSecondHolderL J‖ ≤ ‖J‖ := by
    rw [ballSecondHolderL_apply]
    exact norm_second_le J
  exact (TauCeti.HolderSpace.compLeftL (α := α) (X := closedBall (0 : E) 1)
      (Y := E →L[ℝ] E →L[ℝ] F) (Y' := G) B).le_of_opNorm_le_of_le
    (TauCeti.HolderSpace.norm_compLeftL_le (α := α) (X := closedBall (0 : E) 1)
      (Y := E →L[ℝ] E →L[ℝ] F) (Y' := G) B) hJ
end HessianPostcompose

end ConformalPoisson.DirichletHolder

end ProofPart_BallHolderReadings

/- Proof support: SchauderPerturbation.lean, SHA256 c2593e4c008d2ff4ef708e99dab812d12150304aee8cc26e483b032e8f2c9e12 -/
noncomputable section ProofPart_SchauderPerturbation



/- The uniform Banach perturbation step for the local Schauder inverse.
The actual ball Laplacian right inverse and coefficient-to-operator norm
estimate remain separate producers. This lemma supplies no new premise
to the selected theorem. -/
namespace ConformalPoisson
variable {X Y : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

without_proof_info in
/-- A bounded right inverse survives an operator perturbation of relative
norm at most one half, with a uniform doubled bound. Completeness is needed
only on the forcing space. -/
theorem exists_preimage_of_small_perturbation
    (L : X →L[ℝ] Y) (T : Y →L[ℝ] X) (hT : ∀ y, L (T y) = y)
    (R : X →L[ℝ] Y) (hsmall : ‖R‖ * ‖T‖ ≤ (1 / 2 : ℝ)) (y : Y) :
    ∃ x : X, L x + R x = y ∧ ‖x‖ ≤ 2 * ‖T‖ * ‖y‖ := by
  have hnorm : ‖-(R.comp T)‖ < 1 := by
    rw [norm_neg]
    exact lt_of_le_of_lt ((R.opNorm_comp_le T).trans hsmall) (by norm_num)
  have hunit : IsUnit (1 + R.comp T) := by
    simpa only [sub_neg_eq_add] using isUnit_one_sub_of_norm_lt_one hnorm
  have hsurj : Function.Surjective (⇑(1 + R.comp T : Y →L[ℝ] Y)) :=
    (ContinuousLinearMap.isUnit_iff_bijective.mp hunit).surjective
  obtain ⟨v, hv⟩ := hsurj y
  have heq : v + R (T v) = y := by
    simpa only [add_apply, one_apply_eq_self,
      ContinuousLinearMap.comp_apply] using hv
  have herr : ‖R (T v)‖ ≤ (1 / 2 : ℝ) * ‖v‖ := calc
    ‖R (T v)‖ ≤ ‖R‖ * ‖T v‖ := R.le_opNorm _
    _ ≤ ‖R‖ * (‖T‖ * ‖v‖) :=
      mul_le_mul_of_nonneg_left (T.le_opNorm _) (norm_nonneg R)
    _ = (‖R‖ * ‖T‖) * ‖v‖ := by ring
    _ ≤ (1 / 2 : ℝ) * ‖v‖ :=
      mul_le_mul_of_nonneg_right hsmall (norm_nonneg v)
  have hvbound : ‖v‖ ≤ 2 * ‖y‖ := by
    have hvsub : v = y - R (T v) := eq_sub_of_add_eq heq
    have hn : ‖v‖ ≤ ‖y‖ + ‖R (T v)‖ := calc
      ‖v‖ = ‖y - R (T v)‖ := congrArg norm hvsub
      _ ≤ ‖y‖ + ‖R (T v)‖ := norm_sub_le y (R (T v))
    linarith
  refine ⟨T v, (congrArg (fun z => z + R (T v)) (hT v)).trans heq, ?_⟩
  calc
    ‖T v‖ ≤ ‖T‖ * ‖v‖ := T.le_opNorm _
    _ ≤ ‖T‖ * (2 * ‖y‖) := mul_le_mul_of_nonneg_left hvbound (norm_nonneg T)
    _ = 2 * ‖T‖ * ‖y‖ := by ring

without_proof_info in
/-- The constants can be selected before coefficients/forcing: an a priori
right-inverse bound K gives the same estimate 2K for every perturbation
whose norm times K is at most one half. -/
theorem exists_preimage_of_uniform_small_perturbation
    (L : X →L[ℝ] Y) (T : Y →L[ℝ] X) (hT : ∀ y, L (T y) = y)
    {K : ℝ} (hK : ‖T‖ ≤ K) (R : X →L[ℝ] Y)
    (hsmall : ‖R‖ * K ≤ (1 / 2 : ℝ)) (y : Y) :
    ∃ x : X, L x + R x = y ∧ ‖x‖ ≤ 2 * K * ‖y‖ := by
  have hs : ‖R‖ * ‖T‖ ≤ (1 / 2 : ℝ) :=
    (mul_le_mul_of_nonneg_left hK (norm_nonneg R)).trans hsmall
  obtain ⟨x, hx, hb⟩ := exists_preimage_of_small_perturbation L T hT R hs y
  refine ⟨x, hx, hb.trans ?_⟩
  gcongr
end ConformalPoisson

end ProofPart_SchauderPerturbation

/- Proof support: BallSchrodingerOperator.lean, SHA256 a74055a947eac3374f55416b1436da171a0b377ec77eb3fddab6c332a382d28a -/
noncomputable section ProofPart_BallSchrodingerOperator




/- The actual coordinate Schrodinger operator as a bounded linear map
from the complete zero-Dirichlet C2-alpha space to C0-alpha on the closed
ball. This is the concrete caller of the Banach perturbation theorem. -/
open Set Metric
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "JSpace" => BallSpace α V ℝ

def ballPrincipalTerm (a : H (V →L[ℝ] V)) (i : Fin d) : JSpace →L[ℝ] H ℝ :=
    ((ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂
      (TauCeti.HolderSpace.compLeftL
        (ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i 1)) a)).comp
      ((TauCeti.HolderSpace.compLeftL
        (ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) (EuclideanSpace.single i 1))).comp
          ballSecondHolderL)

def ballSchrodinger (hα : α ≤ 1) (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ) :
    JSpace →L[ℝ] H ℝ :=
  -(∑ i : Fin d, ballPrincipalTerm a i) +
    ((ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂ b).comp
      (ballFirstHolderL hα) +
    ((ContinuousLinearMap.mul ℝ ℝ).compHolder₂ q).comp (ballValueHolderL hα)

without_proof_info in
/-- Evaluation of the bounded operator is the contraction of the same
compatible Hessian, gradient and value fields. -/
theorem ballSchrodinger_apply (hα : α ≤ 1) (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ)
    (J : JSpace) (x : closedBall (0 : V) 1) :
    ballSchrodinger hα a b q J x =
      -(∑ i : Fin d, J.val.2.2 x (EuclideanSpace.single i 1)
        (a x (EuclideanSpace.single i 1))) + J.val.2.1 x (b x) + q x * J.val.1 x := by
  simp [ballSchrodinger, ballPrincipalTerm]

without_proof_info in
/-- At an interior point this is exactly the frozen coordinate operator
acting on the represented ordinary scalar function. -/
theorem ballSchrodinger_eq_coordinate (hα : α ≤ 1)
    (a : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ)
    (A : H (V →L[ℝ] V)) (B : H V) (Q : H ℝ)
    (hA : ∀ x, A x = a x) (hB : ∀ x, B x = b x) (hQ : ∀ x, Q x = q x)
    (J : JSpace) {x : V} (hx : x ∈ ball 0 1) :
    ballSchrodinger hα A B Q J ⟨x, ball_subset_closedBall hx⟩ =
      coordinateSchrodinger a b q (ballValue J) x := by
  rw [ballSchrodinger_apply, coordinateSchrodinger,
    ballValue_fderiv J hx, ballValue_secondFDeriv J hx,
    ballValue, domainRead_of_mem _ _ (ball_subset_closedBall hx)]
  simp only [hA, hB, hQ]

def ballLaplacian (hα : α ≤ 1) : JSpace →L[ℝ] H ℝ :=
  ballSchrodinger hα (TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)) 0 0

without_proof_info in
/-- A concrete conditional solver: the sole inverse below is that of
the actual zero-boundary ball Laplacian on the just-constructed spaces. -/
theorem exists_ballJet_of_small_perturbation (hα : α ≤ 1)
    (T : (H ℝ) →L[ℝ] JSpace) (hT : ∀ f : H ℝ, ballLaplacian (d := d) hα (T f) = f)
    (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ)
    (hsmall : ‖ballSchrodinger hα a b q - ballLaplacian (d := d) hα‖ * ‖T‖ ≤ 1 / 2)
    (F : H ℝ) : ∃ J : JSpace,
      ballSchrodinger hα a b q J = F ∧ ‖J‖ ≤ 2 * ‖T‖ * ‖F‖ := by
  obtain ⟨J, hJ, hbound⟩ := exists_preimage_of_small_perturbation
    (ballLaplacian (d := d) hα) T hT
      (ballSchrodinger hα a b q - ballLaplacian (d := d) hα) hsmall F
  refine ⟨J, ?_, hbound⟩
  simpa only [sub_apply, add_sub_cancel] using hJ

end ConformalPoisson.DirichletHolder

end ProofPart_BallSchrodingerOperator

/- Proof support: BallDirichletUniqueness.lean, SHA256 9517faf73ebbd443b23482db4fb64c746fbc180a575e0bef5719ee962e067aa3 -/
noncomputable section ProofPart_BallDirichletUniqueness



/- Uniqueness for the actual ball Dirichlet Laplacian. Compatible
continuous derivative fields are determined by their value field, and
the classical maximum principle then proves injectivity. -/
open Set Metric Filter Topology TauCeti
open scoped NNReal ContDiff BoundedContinuousFunction Laplacian
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
section Value
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] {α : ℝ≥0}

without_proof_info in
/-- Equality of values determines all compatible jet fields, including
those stored at the physical boundary. -/
theorem ballSpace_ext_value {J K : BallSpace α E F}
    (hval : EqOn (ballValue J) (ballValue K) (closedBall 0 1)) : J = K := by
  have hv : ballValue J = ballValue K := by
    funext x
    by_cases hx : x ∈ closedBall (0 : E) 1
    · exact hval hx
    · simp only [ballValue, domainRead, hx, dite_false]
  have h1 : EqOn (domainRead (closedBall 0 1) J.val.2.1)
      (domainRead (closedBall 0 1) K.val.2.1) (ball 0 1) := by
    intro x hx
    rw [domainRead_of_mem _ _ (ball_subset_closedBall hx),
      domainRead_of_mem _ _ (ball_subset_closedBall hx), ← ballValue_fderiv J hx,
      ← ballValue_fderiv K hx, hv]
  have h2 : EqOn (domainRead (closedBall 0 1) J.val.2.2.toBoundedContinuousFunction)
      (domainRead (closedBall 0 1) K.val.2.2.toBoundedContinuousFunction) (ball 0 1) := by
    intro x hx
    rw [domainRead_of_mem _ _ (ball_subset_closedBall hx),
      domainRead_of_mem _ _ (ball_subset_closedBall hx)]
    simp only [TauCeti.HolderSpace.toBoundedContinuousFunction_apply]
    change J.val.2.2 ⟨x, ball_subset_closedBall hx⟩ = K.val.2.2 ⟨x, ball_subset_closedBall hx⟩
    rw [← ballValue_secondFDeriv J hx, ← ballValue_secondFDeriv K hx, hv]
  have hclosed : closedBall (0 : E) 1 ⊆ closure (ball 0 1) := by
    rw [closure_ball (0 : E) (by norm_num : (1 : ℝ) ≠ 0)]
  have h1c := h1.of_subset_closure (continuousOn_domainRead _ _) (continuousOn_domainRead _ _)
    ball_subset_closedBall hclosed
  have h2c := h2.of_subset_closure (continuousOn_domainRead _ _) (continuousOn_domainRead _ _)
    ball_subset_closedBall hclosed
  apply Subtype.ext
  apply Prod.ext
  · apply BoundedContinuousFunction.ext
    intro x
    exact (domainRead_of_mem _ _ x.property).symm.trans
      ((hval x.property).trans (domainRead_of_mem _ _ x.property))
  · apply Prod.ext
    · apply BoundedContinuousFunction.ext
      intro x
      exact (domainRead_of_mem _ _ x.property).symm.trans
        ((h1c x.property).trans (domainRead_of_mem _ _ x.property))
    · apply TauCeti.HolderSpace.ext
      intro x
      have h := h2c x.property
      rw [domainRead_of_mem _ _ x.property, domainRead_of_mem _ _ x.property] at h
      simpa only [TauCeti.HolderSpace.toBoundedContinuousFunction_apply] using h
end Value

variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem ballLaplacian_eq_negative_laplacian (hα : α ≤ 1)
    (J : BallSpace α V ℝ) {x : V} (hx : x ∈ ball 0 1) :
    ballLaplacian hα J ⟨x, ball_subset_closedBall hx⟩ = -Δ (ballValue J) x := by
  rw [ballLaplacian, ballSchrodinger_apply,
    InnerProductSpace.laplacian_eq_iteratedFDeriv_orthonormalBasis (ballValue J) (EuclideanSpace.basisFun (Fin d) ℝ)]
  simp only [iteratedFDeriv_two_apply]
  rw [ballValue_secondFDeriv J hx]
  simp [TauCeti.HolderSpace.const_apply, ContinuousLinearMap.id_apply,
    TauCeti.HolderSpace.zero_apply, map_zero, zero_mul, add_zero, EuclideanSpace.basisFun_apply]

without_proof_info in
theorem ballLaplacian_injective (hd : 0 < d) (hα : α ≤ 1) :
    Function.Injective (ballLaplacian (d := d) hα) := by
  let : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp hd
  intro J K hJK
  apply ballSpace_ext_value
  apply eqOn_of_laplacian_eqOn_of_eqOn_frontier (isCompact_closedBall (0 : V) 1)
    (ballValue_continuousOn J) (ballValue_continuousOn K)
  · intro x hx
    rw [interior_closedBall (0 : V) (by norm_num : (1 : ℝ) ≠ 0)] at hx
    exact (ballValue_contDiffOn J).contDiffAt (isOpen_ball.mem_nhds hx)
  · intro x hx
    rw [interior_closedBall (0 : V) (by norm_num : (1 : ℝ) ≠ 0)] at hx
    exact (ballValue_contDiffOn K).contDiffAt (isOpen_ball.mem_nhds hx)
  · intro x hx
    rw [interior_closedBall (0 : V) (by norm_num : (1 : ℝ) ≠ 0)] at hx
    have h := congrArg (fun f : TauCeti.HolderSpace α (closedBall (0 : V) 1) ℝ =>
      f ⟨x, ball_subset_closedBall hx⟩) hJK
    rw [ballLaplacian_eq_negative_laplacian hα J hx,
      ballLaplacian_eq_negative_laplacian hα K hx] at h
    exact neg_injective h
  · intro x hx
    rw [frontier_closedBall (0 : V) (by norm_num : (1 : ℝ) ≠ 0)] at hx
    exact (ballValue_zero_boundary J hx).trans (ballValue_zero_boundary K hx).symm
end ConformalPoisson.DirichletHolder

end ProofPart_BallDirichletUniqueness

/- Proof support: BallSchrodingerBound.lean, SHA256 37711ceb711cbe3bc2d1be59a8f24763a1fd4b5bf76e813017d5a77e509f425a -/
/- Import-context adaptation: norm_ballPrincipalTerm_apply_le uses an explicit
product-of-norms inequality instead of gcongr. Statement and bound unchanged. -/
noncomputable section ProofPart_BallSchrodingerBound


/- Dimension-dependent coefficient-to-operator bounds, with constants
chosen before the exponent, coefficients and forcing. -/
open Set Metric
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "JSpace" => BallSpace α V ℝ

local instance : NormedAddCommGroup (V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := V) (F := (V →L[ℝ] ℝ) →L[ℝ] ℝ)
local instance : NormedAddCommGroup ((V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := V →L[ℝ] V →L[ℝ] ℝ) (F := V →L[ℝ] ℝ)

local instance realLinearNormedGroup {A B : Type*} [NormedAddCommGroup A]
    [NormedAddCommGroup B] [NormedSpace ℝ A] [NormedSpace ℝ B] :
    NormedAddCommGroup (A →L[ℝ] B) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := A) (F := B)

local instance realLinearNorm {A B : Type*} [NormedAddCommGroup A]
    [NormedAddCommGroup B] [NormedSpace ℝ A] [NormedSpace ℝ B] : Norm (A →L[ℝ] B) :=
  ContinuousLinearMap.hasOpNorm (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ) (E := A) (F := B)

without_proof_info in
private theorem norm_compLeft_apply_le {A B Z : Type*} [MetricSpace Z]
    [NormedAddCommGroup A] [NormedSpace ℝ A]
    [NormedAddCommGroup B] [NormedSpace ℝ B]
    (T : A →L[ℝ] B) (f : TauCeti.HolderSpace α Z A) :
    ‖TauCeti.HolderSpace.compLeftL T f‖ ≤ ‖T‖ * ‖f‖ :=
  ((TauCeti.HolderSpace.compLeftL T).le_opNorm f).trans
    (mul_le_mul_of_nonneg_right (TauCeti.HolderSpace.norm_compLeftL_le T) (norm_nonneg f))

def principalBound (i : Fin d) : ℝ :=
  ‖(ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ)‖ *
    ‖ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i (1 : ℝ))‖ *
    ‖ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) (EuclideanSpace.single i (1 : ℝ))‖

without_proof_info in
theorem norm_ballPrincipalTerm_apply_le (a : H (V →L[ℝ] V)) (i : Fin d) (J : JSpace) :
    ‖ballPrincipalTerm a i J‖ ≤ principalBound i * ‖a‖ * ‖J‖ := by
  let T : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ
  let A : (V →L[ℝ] V) →L[ℝ] V :=
    ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i 1)
  let B : (V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ :=
    ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) (EuclideanSpace.single i 1)
  have hA : ‖TauCeti.HolderSpace.compLeftL A a‖ ≤ ‖A‖ * ‖a‖ :=
    norm_compLeft_apply_le A a
  have hB : ‖TauCeti.HolderSpace.compLeftL B J.val.2.2‖ ≤ ‖B‖ * ‖J‖ := by
    simpa only [ballSecondHolderL_apply] using
      norm_ballSecond_postcompose_le (E := V) (F := ℝ) (G := V →L[ℝ] ℝ) (α := α) B J
  change ‖T.compHolder₂ (TauCeti.HolderSpace.compLeftL A a)
    (TauCeti.HolderSpace.compLeftL B J.val.2.2)‖ ≤ _
  calc
    _ ≤ ‖T‖ * ‖TauCeti.HolderSpace.compLeftL A a‖ *
        ‖TauCeti.HolderSpace.compLeftL B J.val.2.2‖ := T.norm_compHolder₂_apply_le _ _
    _ ≤ ‖T‖ * (‖A‖ * ‖a‖) * (‖B‖ * ‖J‖) := by
      exact mul_le_mul (mul_le_mul_of_nonneg_left hA (norm_nonneg T)) hB
        (norm_nonneg _)
        (mul_nonneg (norm_nonneg T) (mul_nonneg (norm_nonneg A) (norm_nonneg a)))
    _ = principalBound i * ‖a‖ * ‖J‖ := by dsimp [T, A, B, principalBound]; ring

without_proof_info in
theorem norm_ballSchrodinger_apply_le (hα : α ≤ 1)
    (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ) (J : JSpace) :
    ‖ballSchrodinger hα a b q J‖ ≤
      ((∑ i : Fin d, principalBound i) * ‖a‖ +
        4 * ‖(ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ)‖ * ‖b‖ +
        4 * ‖ContinuousLinearMap.mul ℝ ℝ‖ * ‖q‖) * ‖J‖ := by
  let T : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ
  let R : ℝ →L[ℝ] ℝ →L[ℝ] ℝ := ContinuousLinearMap.mul ℝ ℝ
  have hp : ‖∑ i : Fin d, ballPrincipalTerm a i J‖ ≤
      (∑ i : Fin d, principalBound i) * ‖a‖ * ‖J‖ := by
    calc
      _ ≤ ∑ i : Fin d, ‖ballPrincipalTerm a i J‖ := norm_sum_le _ _
      _ ≤ ∑ i : Fin d, principalBound i * ‖a‖ * ‖J‖ :=
        Finset.sum_le_sum fun i _ => norm_ballPrincipalTerm_apply_le a i J
      _ = _ := by rw [Finset.sum_mul, Finset.sum_mul]
  have hb : ‖T.compHolder₂ b (ballFirstHolder hα J)‖ ≤ 4 * ‖T‖ * ‖b‖ * ‖J‖ := by
    calc
      _ ≤ ‖T‖ * ‖b‖ * ‖ballFirstHolder hα J‖ := T.norm_compHolder₂_apply_le _ _
      _ ≤ ‖T‖ * ‖b‖ * (4 * ‖J‖) := by gcongr; exact norm_ballFirstHolder_le hα J
      _ = _ := by ring
  have hq : ‖R.compHolder₂ q (ballValueHolder hα J)‖ ≤ 4 * ‖R‖ * ‖q‖ * ‖J‖ := by
    calc
      _ ≤ ‖R‖ * ‖q‖ * ‖ballValueHolder hα J‖ := R.norm_compHolder₂_apply_le _ _
      _ ≤ ‖R‖ * ‖q‖ * (4 * ‖J‖) := by gcongr; exact norm_ballValueHolder_le hα J
      _ = _ := by ring
  simp only [ballSchrodinger, add_apply, neg_apply, sum_apply, ContinuousLinearMap.comp_apply,
    ballFirstHolderL_apply, ballValueHolderL_apply]
  calc
    _ ≤ (‖∑ i : Fin d, ballPrincipalTerm a i J‖ + ‖T.compHolder₂ b (ballFirstHolder hα J)‖) +
        ‖R.compHolder₂ q (ballValueHolder hα J)‖ := by
      simpa only [norm_neg] using (norm_add₃_le
        (a := -(∑ i : Fin d, ballPrincipalTerm a i J))
        (b := T.compHolder₂ b (ballFirstHolder hα J)) (c := R.compHolder₂ q (ballValueHolder hα J)))
    _ ≤ _ := by dsimp only [T, R] at hb hq; nlinarith [hp, hb, hq]

without_proof_info in
theorem ballSchrodinger_sub_laplacian (hα : α ≤ 1)
    (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ) :
    ballSchrodinger hα a b q - ballLaplacian (d := d) hα =
      ballSchrodinger hα (a - TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)) b q := by
  apply ContinuousLinearMap.ext
  intro J
  apply TauCeti.HolderSpace.ext
  intro x
  simp [ballLaplacian, ballSchrodinger_apply, map_sub, Finset.sum_sub_distrib]
  ring

/-- A positive constant depending only on dimension, before the Holder
exponent or coefficients are chosen. -/
def ballCoefficientBound : ℝ :=
  (∑ i : Fin d, principalBound i) +
    4 * ‖(ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ)‖ +
    4 * ‖ContinuousLinearMap.mul ℝ ℝ‖ + 1

without_proof_info in
theorem principalBound_nonneg (i : Fin d) : 0 ≤ principalBound i := by
  unfold principalBound
  positivity

without_proof_info in
theorem ballCoefficientBound_pos : 0 < ballCoefficientBound (d := d) := by
  have hs : 0 ≤ ∑ i : Fin d, principalBound i :=
    Finset.sum_nonneg fun i _ => principalBound_nonneg i
  unfold ballCoefficientBound
  positivity

without_proof_info in
/-- Smallness in the canonical closed-ball Holder norms controls the
operator perturbation on the complete Dirichlet space. -/
theorem norm_ballSchrodinger_sub_laplacian_le (hα : α ≤ 1) {ε : ℝ} (hε : 0 ≤ ε)
    (a : H (V →L[ℝ] V)) (b : H V) (q : H ℝ)
    (ha : ‖a - TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)‖ ≤ ε)
    (hb : ‖b‖ ≤ ε) (hq : ‖q‖ ≤ ε) :
    ‖ballSchrodinger hα a b q - ballLaplacian (d := d) hα‖ ≤
      ballCoefficientBound (d := d) * ε := by
  rw [ballSchrodinger_sub_laplacian]
  refine ContinuousLinearMap.opNorm_le_bound _
    (mul_nonneg ballCoefficientBound_pos.le hε) ?_
  intro J
  have hs : 0 ≤ ∑ i : Fin d, principalBound i :=
    Finset.sum_nonneg fun i _ => principalBound_nonneg i
  refine (norm_ballSchrodinger_apply_le hα _ _ _ J).trans ?_
  calc
    _ ≤ ((∑ i : Fin d, principalBound i) * ε +
        4 * ‖(ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ)‖ * ε +
        4 * ‖ContinuousLinearMap.mul ℝ ℝ‖ * ε) * ‖J‖ := by
      gcongr
    _ ≤ ballCoefficientBound (d := d) * ε * ‖J‖ := by
      unfold ballCoefficientBound
      nlinarith [mul_nonneg hε (norm_nonneg J)]

end ConformalPoisson.DirichletHolder

end ProofPart_BallSchrodingerBound

/- Proof support: ClosedBallHolderRestriction.lean, SHA256 b089bc5e49318f24618777483a588b41dbcf829d6bb4f85143eb6d2156c9ddac -/
noncomputable section ProofPart_ClosedBallHolderRestriction


/- Restrict the actual continuous coefficients or forcing with the
frozen max-type Holder bound to the canonical Holder forcing space. -/
open Set Metric
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] {α K : ℝ≥0}

def closedBallHolderRestriction (f : E → F) (hf : ContinuousOn f (closedBall 0 1))
    (hb : holderBound α (closedBall 0 1) f K) :
    TauCeti.HolderSpace α (closedBall (0 : E) 1) F :=
  TauCeti.HolderSpace.ofBoundedContinuousFunction
    (BoundedContinuousFunction.ofNormedAddCommGroup ((closedBall (0 : E) 1).domRestrict f)
      hf.domRestrict K (fun x => hb.1 x x.property))
    ((show HolderWith K α (fun x : closedBall (0 : E) 1 => f x) from
      fun x y => hb.2 x x.property y y.property).memHolder)

omit [NormedSpace ℝ E] in
without_proof_info in
@[simp] theorem closedBallHolderRestriction_apply (f : E → F)
    (hf : ContinuousOn f (closedBall 0 1)) (hb : holderBound α (closedBall 0 1) f K)
    (x : closedBall (0 : E) 1) : closedBallHolderRestriction f hf hb x = f x := by
  unfold closedBallHolderRestriction
  rw [TauCeti.HolderSpace.ofBoundedContinuousFunction_apply]
  rfl

omit [NormedSpace ℝ E] in
without_proof_info in
theorem norm_closedBallHolderRestriction_le (f : E → F)
    (hf : ContinuousOn f (closedBall 0 1)) (hb : holderBound α (closedBall 0 1) f K) :
    ‖closedBallHolderRestriction f hf hb‖ ≤ 2 * K := by
  have hH : HolderWith K α (closedBallHolderRestriction f hf hb) := by
    intro x y
    simpa only [closedBallHolderRestriction_apply, Subtype.edist_eq] using
      hb.2 x x.property y y.property
  have h := TauCeti.HolderSpace.norm_le_of_norm_le_of_holderWith
    (f := closedBallHolderRestriction f hf hb) (M := (K : ℝ)) K.coe_nonneg
    (fun x => by simpa only [closedBallHolderRestriction_apply] using hb.1 x x.property) hH
  convert h using 1
  ring

end ConformalPoisson.DirichletHolder

end ProofPart_ClosedBallHolderRestriction

/- Proof support: BallSchauderC2Caller.lean, SHA256 72dd31142c01a66fd358246a05af575d979a38421c92cb6422904fc850b6a48a -/
noncomputable section ProofPart_BallSchauderC2Caller



/- Uniform C2-alpha Dirichlet solvability conditional on the actual
ball Laplacian inverse. The smooth interior bootstrap remains separate;
this helper does not assert the frozen smooth Schauder input. -/
open Set Metric
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F

/-- The exact selected forward estimate with C2 interior regularity;
promotion to smoothness is an explicit remaining obligation. -/
def SchauderDirichletC2Estimate (d : ℕ) (α δ C : ℝ≥0) : Prop :=
  ∀ (a : EuclideanSpace ℝ (Fin d) →
      (EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)))
    (b : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (q : EuclideanSpace ℝ (Fin d) → ℝ),
    ContDiffOn ℝ ∞ a (closedBall 0 1) →
    ContDiffOn ℝ ∞ b (closedBall 0 1) →
    ContDiffOn ℝ ∞ q (closedBall 0 1) →
    holderBound α (closedBall 0 1) (fun z => a z - ContinuousLinearMap.id ℝ _) δ →
    holderBound α (closedBall 0 1) b δ → holderBound α (closedBall 0 1) q δ →
    ∀ (F : EuclideanSpace ℝ (Fin d) → ℝ) (K : ℝ≥0),
      ContDiffOn ℝ ∞ F (closedBall 0 1) → holderBound α (closedBall 0 1) F K →
      ∃ u : EuclideanSpace ℝ (Fin d) → ℝ,
        ContDiffOn ℝ 2 u (ball 0 1) ∧ ContinuousOn u (closedBall 0 1) ∧
        EqOn u 0 (sphere 0 1) ∧
        (∀ z ∈ ball 0 1, coordinateSchrodinger a b q u z = F z) ∧
        secondOrderHolderBound α (ball 0 1) u (C * K)

without_proof_info in
theorem exists_uniform_schauder_C2_constants_of_ball_inverse (hα : α ≤ 1)
    (T : (H ℝ) →L[ℝ] BallSpace α V ℝ)
    (hT : ∀ F : H ℝ, ballLaplacian (d := d) hα (T F) = F) :
    ∃ δ C : ℝ≥0, 0 < δ ∧ 0 < C ∧ SchauderDirichletC2Estimate d α δ C := by
  let D : ℝ := ballCoefficientBound (d := d)
  have hD : 0 < D := ballCoefficientBound_pos
  let δr : ℝ := (4 * D * (‖T‖ + 1))⁻¹
  have hδr : 0 < δr := inv_pos.mpr (by positivity)
  let δ : ℝ≥0 := ⟨δr, hδr.le⟩
  let C : ℝ≥0 := 4 * (‖T‖₊ + 1)
  refine ⟨δ, C, hδr, by dsimp [C]; positivity, ?_⟩
  intro a b q ha hb hq haδ hbδ hqδ F K hF hFK
  let AR : H (V →L[ℝ] V) := closedBallHolderRestriction
    (fun z => a z - ContinuousLinearMap.id ℝ V)
    (ha.continuousOn.sub continuousOn_const) haδ
  let A : H (V →L[ℝ] V) := AR + TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)
  let B : H V := closedBallHolderRestriction b hb.continuousOn hbδ
  let Q : H ℝ := closedBallHolderRestriction q hq.continuousOn hqδ
  let FH : H ℝ := closedBallHolderRestriction F hF.continuousOn hFK
  have hAeval : ∀ x : closedBall (0 : V) 1, A x = a x := by
    intro x
    simp [A, AR]
  have hBeval : ∀ x : closedBall (0 : V) 1, B x = b x := by
    intro x
    simp [B]
  have hQeval : ∀ x : closedBall (0 : V) 1, Q x = q x := by
    intro x
    simp [Q]
  have hAnorm : ‖A - TauCeti.HolderSpace.const (ContinuousLinearMap.id ℝ V)‖ ≤ 2 * (δ : ℝ) := by
    simpa only [A, add_sub_cancel_right] using
      norm_closedBallHolderRestriction_le (fun z => a z - ContinuousLinearMap.id ℝ V)
        (ha.continuousOn.sub continuousOn_const) haδ
  have hBnorm : ‖B‖ ≤ 2 * (δ : ℝ) := norm_closedBallHolderRestriction_le b hb.continuousOn hbδ
  have hQnorm : ‖Q‖ ≤ 2 * (δ : ℝ) := norm_closedBallHolderRestriction_le q hq.continuousOn hqδ
  have hFnorm : ‖FH‖ ≤ 2 * (K : ℝ) := norm_closedBallHolderRestriction_le F hF.continuousOn hFK
  have hδeq : 4 * D * (‖T‖ + 1) * (δ : ℝ) = 1 := by
    exact mul_inv_cancel₀ (ne_of_gt (show 0 < 4 * D * (‖T‖ + 1) by positivity))
  have hδsmall : D * (2 * (δ : ℝ)) * ‖T‖ ≤ 1 / 2 := by
    have hn : 0 ≤ D * (δ : ℝ) := mul_nonneg hD.le δ.coe_nonneg
    nlinarith
  have hop : ‖ballSchrodinger hα A B Q - ballLaplacian (d := d) hα‖ ≤ D * (2 * (δ : ℝ)) :=
    norm_ballSchrodinger_sub_laplacian_le hα (by positivity) A B Q hAnorm hBnorm hQnorm
  have hsmall : ‖ballSchrodinger hα A B Q - ballLaplacian (d := d) hα‖ * ‖T‖ ≤ 1 / 2 :=
    (mul_le_mul_of_nonneg_right hop (norm_nonneg T)).trans hδsmall
  obtain ⟨J, hJ, hJnorm⟩ := exists_ballJet_of_small_perturbation hα T hT A B Q hsmall FH
  have hJK : ‖J‖₊ ≤ C * K := by
    have hreal : ‖J‖ ≤ (C * K : ℝ≥0) := by
      calc
        _ ≤ 2 * ‖T‖ * ‖FH‖ := hJnorm
        _ ≤ 2 * ‖T‖ * (2 * (K : ℝ)) := by gcongr
        _ ≤ (C * K : ℝ≥0) := by
          dsimp [C]
          nlinarith [K.coe_nonneg]
    exact_mod_cast hreal
  refine ⟨ballValue J, ballValue_contDiffOn J, ballValue_continuousOn J,
    ballValue_zero_boundary J, ?_, (ballValue_secondOrderHolderBound J).mono hJK⟩
  intro x hx
  rw [← ballSchrodinger_eq_coordinate hα a b q A B Q hAeval hBeval hQeval J hx, hJ]
  simp [FH]

end ConformalPoisson.DirichletHolder

end ProofPart_BallSchauderC2Caller

/- Proof support: CoordinateEllipticity.lean, SHA256 38dbce916b2a313f5ca030809114d5276f074ad437bd01830bfccd07185d6acf -/
noncomputable section ProofPart_CoordinateEllipticity


/- The small principal-field bound in the frozen local Schauder input
gives actual uniform ellipticity of the same divergence-form matrix. -/
open Set InnerProductSpace TauCeti.PDE
open scoped ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem coordinatePrincipalMatrix_uniformlyEllipticOn {U : Set V}
    {a : V → V →L[ℝ] V}
    (ha : ∀ x ∈ U, ‖a x - ContinuousLinearMap.id ℝ V‖ ≤ 1 / 2) :
    UniformlyEllipticOn U (fun x => coordinatePrincipalMatrix (a x)) (1 / 2) 2 := by
  rw [uniformlyEllipticOn_iff]
  refine ⟨by norm_num, by norm_num, ?_⟩
  intro x hx
  have hanorm : ‖a x‖ ≤ 3 / 2 := by
    have heq : a x = (a x - ContinuousLinearMap.id ℝ V) + ContinuousLinearMap.id ℝ V :=
      (sub_add_cancel _ _).symm
    calc
      _ = ‖(a x - ContinuousLinearMap.id ℝ V) + ContinuousLinearMap.id ℝ V‖ := congrArg norm heq
      _ ≤ ‖a x - ContinuousLinearMap.id ℝ V‖ + ‖ContinuousLinearMap.id ℝ V‖ := norm_add_le _ _
      _ ≤ 3 / 2 := by
        have hid := ContinuousLinearMap.norm_id_le (𝕜 := ℝ) (E := V)
        linarith [ha x hx]
  refine ⟨?_, ?_⟩
  · intro ξ
    rw [← matrixBilinearForm_self, coordinatePrincipalMatrix_bilinear]
    have herror : |⟪(a x - ContinuousLinearMap.id ℝ V) ξ, ξ⟫_ℝ| ≤ (1 / 2) * ‖ξ‖ ^ 2 := by
      calc
        _ ≤ ‖(a x - ContinuousLinearMap.id ℝ V) ξ‖ * ‖ξ‖ := abs_real_inner_le_norm _ _
        _ ≤ (‖a x - ContinuousLinearMap.id ℝ V‖ * ‖ξ‖) * ‖ξ‖ := by
          gcongr
          exact (a x - ContinuousLinearMap.id ℝ V).le_opNorm ξ
        _ = ‖a x - ContinuousLinearMap.id ℝ V‖ * ‖ξ‖ ^ 2 := by ring
        _ ≤ (1 / 2) * ‖ξ‖ ^ 2 := mul_le_mul_of_nonneg_right (ha x hx) (sq_nonneg _)
    have hlow := (abs_le.mp herror).1
    simp only [sub_apply, ContinuousLinearMap.id_apply, inner_sub_left,
      real_inner_self_eq_norm_sq] at hlow
    linarith
  · intro η ξ
    rw [← matrixBilinearForm_apply, coordinatePrincipalMatrix_bilinear]
    calc
      _ ≤ ‖a x η‖ * ‖ξ‖ := abs_real_inner_le_norm _ _
      _ ≤ (‖a x‖ * ‖η‖) * ‖ξ‖ := by gcongr; exact (a x).le_opNorm η
      _ ≤ (3 / 2) * ‖η‖ * ‖ξ‖ := by gcongr
      _ ≤ 2 * ‖η‖ * ‖ξ‖ := by gcongr; norm_num

end ConformalPoisson

end ProofPart_CoordinateEllipticity

/- Proof support: CoordinateSobolevWeak.lean, SHA256 0f34c58f1214229081e7d162cbb8fa6008e54e4e79814ea5f44cf66dc136dcd4 -/
noncomputable section ProofPart_CoordinateSobolevWeak



/- The actual classical coordinate equation supplies the canonical
Sobolev energy identity. Integrability of the coefficients and forcing
is explicit; no weak/classical compatibility premise is assumed. -/
open Set MeasureTheory InnerProductSpace TauCeti TauCeti.PDE
open scoped ContDiff Gradient Distributions InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)
variable {μ : Measure (EuclideanSpace ℝ (Fin d))} [μ.IsAddHaarMeasure]
  {Ω : TopologicalSpace.Opens (EuclideanSpace ℝ (Fin d))}

without_proof_info in
theorem coordinate_energyForm_testFunction
    {a : V → V →L[ℝ] V} {b : V → V} {q u : V → ℝ}
    (hu : ContDiffOn ℝ 2 u Ω) (U : W1p μ Ω 2)
    (hU : W1p.value U =ᵐ[μ.restrict Ω] u) (φ : 𝓓(Ω, ℝ)) :
    energyFormH1 (ι := Fin d) (mu := μ) (Omega := Ω) (fun x => coordinatePrincipalMatrix (a x))
        (fun x => b x + coordinateDivergenceDrift a x) q U (W1p.ofTestFunctionₗ μ Ω 2 φ) =
      (∫ x, ⟪∇ (φ : V → ℝ) x, coordinateConormalFlux a u x⟫_ℝ +
        φ x * (fderiv ℝ u x (b x + coordinateDivergenceDrift a x) + q x * u x) ∂μ) := by
  have hgrad := W1p.gradient_ae_eq_of_contDiffOn U (hu.of_le one_le_two) hU
  rw [energyFormH1_def]
  calc
    _ = ∫ x in Ω, ⟪∇ (φ : V → ℝ) x, coordinateConormalFlux a u x⟫_ℝ +
        φ x * (fderiv ℝ u x (b x + coordinateDivergenceDrift a x) + q x * u x) ∂μ := by
      apply integral_congr_ae
      filter_upwards [hU, hgrad, W1p.value_ofTestFunctionₗ_ae (mu := μ) (p := 2) φ,
        gradientTestFunctionLp_apply_ae (mu := μ) 2 φ] with x hux hgx hφx hgφx
      simp only [energyIntegrand_apply, jetField_apply, hux, hgx, hφx,
        W1p.gradient_ofTestFunctionₗ, hgφx, driftForm_apply, massForm_apply,
        coordinatePrincipalMatrix_gradient, inner_coordinateConormalFlux,
        inner_gradient_right, conj_trivial]
      ring
    _ = _ := setIntegral_eq_integral_of_forall_compl_eq_zero fun x hx => by
      have hgφ : ∇ (φ : V → ℝ) x = 0 :=
        gradient_of_notMem_tsupport (fun h => hx (φ.tsupport_subset h))
      simp only [hgφ, inner_zero_left, φ.zero_on_compl hx, Pi.zero_apply, zero_mul, add_zero]

without_proof_info in
theorem coordinate_energyForm_of_classical
    {a : V → V →L[ℝ] V} {b : V → V} {q u F : V → ℝ}
    (ha : ContDiffOn ℝ 1 a Ω) (hu : ContDiffOn ℝ 2 u Ω)
    (hb : ContinuousOn b Ω) (hq : ContinuousOn q Ω) (hF : ContinuousOn F Ω)
    (heq : ∀ x ∈ Ω, coordinateSchrodinger a b q u x = F x)
    (U : W1p μ Ω 2) (hU : W1p.value U =ᵐ[μ.restrict Ω] u)
    (hcoeff : MemLp (fun x => energyIntegrand (coordinatePrincipalMatrix (a x))
      (b x + coordinateDivergenceDrift a x) (q x)) ⊤ (μ.restrict Ω))
    (hFLp : MemLp F 2 (μ.restrict Ω)) (v : W1p0 μ Ω 2) :
    energyFormH1 (ι := Fin d) (mu := μ) (Omega := Ω) (fun x => coordinatePrincipalMatrix (a x))
        (fun x => b x + coordinateDivergenceDrift a x) q U (v : W1p μ Ω 2) =
      (∫ x in Ω, F x * W1p.value (v : W1p μ Ω 2) x ∂μ) := by
  have htest : ∀ φ : 𝓓(Ω, ℝ),
      energyFormH1 (ι := Fin d) (mu := μ) (Omega := Ω) (fun x => coordinatePrincipalMatrix (a x))
          (fun x => b x + coordinateDivergenceDrift a x) q U (W1p.ofTestFunctionₗ μ Ω 2 φ) =
        ∫ x in Ω, (hFLp.toLp F) x * φ x ∂μ := by
    intro φ
    rw [coordinate_energyForm_testFunction (μ := μ) (Ω := Ω) (a := a) (b := b) (q := q) hu U hU φ,
      coordinateSchrodinger_testFunction_identity (μ := μ) (Ω := Ω) ha hu hb hq hF heq φ]
    calc
      _ = ∫ x in Ω, φ x * F x ∂μ :=
        (setIntegral_eq_integral_of_forall_compl_eq_zero
          (fun x hx => by simp [φ.zero_on_compl hx])).symm
      _ = _ := by
        apply integral_congr_ae
        filter_upwards [hFLp.coeFn_toLp] with x hx
        rw [hx, mul_comm]
  have h := (forall_energyFormH1_eq_setIntegral_iff_forall_testFunction (mu := μ) (Omega := Ω) hcoeff
    (hFLp.toLp F) U).2 htest v
  refine h.trans (integral_congr_ae ?_)
  filter_upwards [hFLp.coeFn_toLp] with x hx
  rw [hx]

end ConformalPoisson

