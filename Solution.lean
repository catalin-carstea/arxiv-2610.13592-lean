  simpa only [Measure.restrict_univ] using
    (hasFDerivAt_integral_of_continuousOn_fderiv (𝕜 := ℝ) (μ := μ)
      (u := U) (k := univ) (s := univ) (hU.mem_nhds hx) isCompact_univ
      MeasurableSet.univ (measure_ne_top μ univ) subset_rfl hF (fun y _ => hd y) hD)

without_proof_info in
theorem secondFDeriv_compact_integral {U : Set E} (hU : IsOpen U)
    {x : E} (hx : x ∈ U) {F : E → Y → F}
    (hF : ContinuousOn (uncurry F) (U ×ˢ univ))
    (hd : ∀ y, DifferentiableOn ℝ (fun z => F z y) U)
    (hD : ContinuousOn (fun p : E × Y => fderiv ℝ (fun z => F z p.2) p.1) (U ×ˢ univ))
    (hdd : ∀ y, DifferentiableOn ℝ (fderiv ℝ (fun z => F z y)) U)
    (hDD : ContinuousOn (fun p : E × Y => fderiv ℝ (fderiv ℝ (fun z => F z p.2)) p.1)
      (U ×ˢ univ)) :
    fderiv ℝ (fderiv ℝ (fun z => ∫ y, F z y ∂μ)) x =
      ∫ y, fderiv ℝ (fderiv ℝ (fun z => F z y)) x ∂μ := by
  have hfirst : fderiv ℝ (fun z => ∫ y, F z y ∂μ) =ᶠ[𝓝 x]
      (fun z => ∫ y, fderiv ℝ (fun z => F z y) z ∂μ) := by
    filter_upwards [hU.mem_nhds hx] with z hz
    exact (hasFDerivAt_compact_integral hU hz hF hd hD).fderiv
  rw [hfirst.fderiv_eq]
  exact (hasFDerivAt_compact_integral hU hx hD hdd hDD).fderiv

without_proof_info in
theorem ordinaryJet_compact_integral {U : Set E} (hU : IsOpen U)
    {x : E} (hx : x ∈ U) {F : E → Y → ℝ}
    (hF : ContinuousOn (uncurry F) (U ×ˢ univ))
    (hd : ∀ y, DifferentiableOn ℝ (fun z => F z y) U)
    (hD : ContinuousOn (fun p : E × Y => fderiv ℝ (fun z => F z p.2) p.1) (U ×ˢ univ))
    (hdd : ∀ y, DifferentiableOn ℝ (fderiv ℝ (fun z => F z y)) U)
    (hDD : ContinuousOn (fun p : E × Y => fderiv ℝ (fderiv ℝ (fun z => F z p.2)) p.1)
      (U ×ˢ univ)) :
    Integrable (fun y => ordinaryJet (F x y) (fderiv ℝ (fun z => F z y) x)
      (fderiv ℝ (fderiv ℝ (fun z => F z y)) x)) μ ∧
    ordinaryJet (∫ y, F x y ∂μ) (fderiv ℝ (fun z => ∫ y, F z y ∂μ) x)
      (fderiv ℝ (fderiv ℝ (fun z => ∫ y, F z y ∂μ)) x) =
        ∫ y, ordinaryJet (F x y) (fderiv ℝ (fun z => F z y) x)
          (fderiv ℝ (fderiv ℝ (fun z => F z y)) x) ∂μ := by
  dsimp only [ordinaryJet, OrdinaryJet, instNormedAddCommGroupOrdinaryJet]
  letI : ContinuousENorm (E →L[ℝ] E →L[ℝ] ℝ) :=
    (SeminormedAddGroup.toESeminormedAddMonoid (E := E →L[ℝ] E →L[ℝ] ℝ)).toContinuousENorm
  have hi0 : Integrable (F x) μ := by
    simpa only [integrableOn_univ] using
      ContinuousOn.integrableOn_compact isCompact_univ (hF.uncurry_left x hx)
  have hi1 : Integrable (fun y => fderiv ℝ (fun z => F z y) x) μ := by
    simpa only [integrableOn_univ] using
      ContinuousOn.integrableOn_compact (μ := μ)
        (f := fun y => fderiv ℝ (fun z => F z y) x) isCompact_univ (hD.uncurry_left (f := fun z y => fderiv ℝ (fun z => F z y) z) x hx)
  have hi2 : Integrable (fun y => fderiv ℝ (fderiv ℝ (fun z => F z y)) x) μ := by
    simpa only [integrableOn_univ] using
      ContinuousOn.integrableOn_compact (μ := μ)
        (f := fun y => fderiv ℝ (fderiv ℝ (fun z => F z y)) x) isCompact_univ (hDD.uncurry_left (f := fun z y => fderiv ℝ (fderiv ℝ (fun z => F z y)) z) x hx)
  refine ⟨hi0.prodMk (hi1.prodMk hi2), ?_⟩
  change (_, _, _) = ∫ y, (F x y, _, _) ∂μ
  have hp2 := integral_pair (E := E →L[ℝ] ℝ) (F := E →L[ℝ] E →L[ℝ] ℝ) hi1 hi2
  have hp3 := integral_pair (E := ℝ)
    (F := (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)) hi0 (hi1.prodMk hi2)
  have hp := hp3.trans (congrArg (fun b => (∫ y, F x y ∂μ, b)) hp2)
  calc
    _ = (∫ y, F x y ∂μ,
        ∫ y, fderiv ℝ (fun z => F z y) x ∂μ,
        ∫ y, fderiv ℝ (fderiv ℝ (fun z => F z y)) x ∂μ) := by
      exact Prod.ext rfl (Prod.ext
        (hasFDerivAt_compact_integral (μ := μ) hU hx hF hd hD).fderiv
        (secondFDeriv_compact_integral (μ := μ) hU hx hF hd hD hdd hDD))
    _ = _ := hp.symm

end ConformalPoisson

