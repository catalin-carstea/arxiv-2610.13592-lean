      (Jdiff a).val.2.2 x =
        fderiv ℝ (fderiv ℝ (localizedSolutionDifference χ u (boundaryTangentialProjection a))) x) :
    ∃ Ψ : V → J, AnalyticAt ℝ Ψ 0 ∧
      ∀ x : closedBall (0 : V) 1, (∀ᶠ y in 𝓝 (x : V), χ y = 1) →
        ∀ᶠ a in 𝓝 (0 : V),
