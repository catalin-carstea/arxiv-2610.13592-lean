/- The remaining two exact integration identities in the Riemannian
Carleman commutator. All integrands have actual compact supports and
the same Riemannian volume; no omitted boundary term is assumed. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M] [SigmaCompactSpace M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
local notation "μ" => riemannianVolume I M

set_option maxHeartbeats 800000 in
without_proof_info in
theorem integral_laplacian_weight_laplacian {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hc : HasCompactSupport v) :
    (∫ x, laplaceBeltrami I v x * laplaceBeltrami I φ x * v x ∂μ) =
      -(∫ x, laplaceBeltrami I φ x * ‖mgradient I v x‖ ^ 2 ∂μ) +
        (1 / 2 : ℝ) * ∫ x, v x ^ 2 * laplaceBeltrami I (laplaceBeltrami I φ) x ∂μ := by
  have hΔφ := smooth_laplaceBeltrami hφ
  have hnorm : Integrable (fun x => laplaceBeltrami I φ x * ‖mgradient I v x‖ ^ 2) μ :=
    (hΔφ.continuous.mul (smooth_normSq_mgradient hv).continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_normSq_mgradient hc).mul_left
  have hmix : Integrable (fun x => v x * ⟪mgradient I (laplaceBeltrami I φ) x, mgradient I v x⟫_ℝ) μ :=
    (hv.continuous.mul (smooth_inner_mgradients hΔφ hv).continuous).integrable_of_hasCompactSupport hc.mul_right
  have hgreen := integral_mul_laplaceBeltrami ((hΔφ.mul hv).of_le (by simp))
    hc.mul_left (hv.of_le (by simp))
  have hfun : laplaceBeltrami I φ * v = (fun y => laplaceBeltrami I φ y * v y) := rfl
  rw [hfun] at hgreen
  have hgrad : (∫ x, ⟪mgradient I (fun y => laplaceBeltrami I φ y * v y) x,
      mgradient I v x⟫_ℝ ∂μ) =
      (∫ x, laplaceBeltrami I φ x * ‖mgradient I v x‖ ^ 2 ∂μ) +
        ∫ x, v x * ⟪mgradient I (laplaceBeltrami I φ) x, mgradient I v x⟫_ℝ ∂μ := by
    rw [← integral_add hnorm hmix]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun x => by
      dsimp only
      rw [inner_gradient_product hΔφ hv, real_inner_self_eq_norm_sq])
  rw [hgrad] at hgreen
  have hsq := integral_mul_laplaceBeltrami ((hv.pow 2).of_le (by simp))
    (hasCompactSupport_square hc) (hΔφ.of_le (by simp))
  have hsqgrad : (∫ x, ⟪mgradient I (fun y => v y ^ 2) x,
      mgradient I (laplaceBeltrami I φ) x⟫_ℝ ∂μ) =
      2 * ∫ x, v x * ⟪mgradient I (laplaceBeltrami I φ) x, mgradient I v x⟫_ℝ ∂μ := by
    rw [← integral_const_mul]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun x => by
      dsimp only
      rw [mgradient_square hv, real_inner_smul_left, real_inner_comm]
      ring)
  rw [hsqgrad] at hsq
  have hcomm : (∫ x, laplaceBeltrami I v x * laplaceBeltrami I φ x * v x ∂μ) =
      ∫ x, (laplaceBeltrami I φ x * v x) * laplaceBeltrami I v x ∂μ :=
    integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
  rw [hcomm]
  linarith

set_option maxHeartbeats 800000 in
without_proof_info in
theorem integral_weight_gradient_transport {φ v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hc : HasCompactSupport v) :
    (∫ x, ‖mgradient I φ x‖ ^ 2 * v x * ⟪mgradient I φ x, mgradient I v x⟫_ℝ ∂μ) =
      -(∫ x, hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2 ∂μ) -
        (1 / 2 : ℝ) * ∫ x, ‖mgradient I φ x‖ ^ 2 * laplaceBeltrami I φ x * v x ^ 2 ∂μ := by
  have hq := smooth_normSq_mgradient hφ
  have hvsq := hv.pow 2
  have hHess := contMDiff_hessian_gradient_pair hφ hφ hφ
  have hH : Integrable (fun x => hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2) μ :=
    (hHess.continuous.mul hvsq.continuous).integrable_of_hasCompactSupport
      (hasCompactSupport_square hc).mul_left
  have hmix : Integrable (fun x => ‖mgradient I φ x‖ ^ 2 * v x *
      ⟪mgradient I φ x, mgradient I v x⟫_ℝ) μ :=
    ((hq.continuous.mul hv.continuous).mul (smooth_inner_mgradients hφ hv).continuous).integrable_of_hasCompactSupport
      hc.mul_left.mul_right
  have hgreen := integral_mul_laplaceBeltrami ((hq.mul hvsq).of_le (by simp))
    (hasCompactSupport_square hc).mul_left (hφ.of_le (by simp))
  have hfun : (fun y => ‖mgradient I φ y‖ ^ 2) * (fun y => v y ^ 2) =
      (fun y => ‖mgradient I φ y‖ ^ 2 * v y ^ 2) := rfl
  rw [hfun] at hgreen
  have hgrad : (∫ x, ⟪mgradient I (fun y => ‖mgradient I φ y‖ ^ 2 * v y ^ 2) x,
      mgradient I φ x⟫_ℝ ∂μ) =
      2 * (∫ x, ‖mgradient I φ x‖ ^ 2 * v x * ⟪mgradient I φ x, mgradient I v x⟫_ℝ ∂μ) +
      2 * ∫ x, hessian I φ x (mgradient I φ x) (mgradient I φ x) * v x ^ 2 ∂μ := by
    rw [← integral_const_mul, ← integral_const_mul, ← integral_add (hmix.const_mul 2) (hH.const_mul 2)]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall (fun x => by
      dsimp only
      have hqinner : ⟪mgradient I (fun y => ‖mgradient I φ y‖ ^ 2) x, mgradient I φ x⟫_ℝ =
          2 * hessian I φ x (mgradient I φ x) (mgradient I φ x) := by
        rw [real_inner_comm]
        exact inner_gradient_normSq_gradient_eq_hessian (φ := φ) hφ x
      have hpair : ⟪mgradient I v x, mgradient I φ x⟫_ℝ = ⟪mgradient I φ x, mgradient I v x⟫_ℝ :=
        real_inner_comm _ _
      rw [inner_gradient_product hq hvsq, mgradient_square hv, real_inner_smul_left, hqinner, hpair]
      ring)
  rw [hgrad] at hgreen
  have hcomm : (∫ x, (‖mgradient I φ x‖ ^ 2 * v x ^ 2) * laplaceBeltrami I φ x ∂μ) =
      ∫ x, ‖mgradient I φ x‖ ^ 2 * laplaceBeltrami I φ x * v x ^ 2 ∂μ :=
    integral_congr_ae (Filter.Eventually.of_forall fun x => by ring)
  rw [hcomm] at hgreen
  linarith
end ConformalPoisson

