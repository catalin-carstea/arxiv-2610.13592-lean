      (fun z hz => (extChartAt Ihalf c).map_target hz)).contDiffOn).mono
      (fun z hz => htarget ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩)
  have hgrad := W1p.gradient_ae_eq_of_contDiffOn w (hs.of_le (by simp)) hw
  have hclass : ∀ z ∈ (Ω : Set V), |v z| + ‖∇ v z‖ ≤ C := by
