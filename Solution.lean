      ∃ D ≥ 0, ∀ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ u →
      (∀ x, (𝓡∂ (n + 1)).IsBoundaryPoint x → u x = 0) →
      (∀ z ∈ (splitBoundaryChartCap (n := n) c R : Set P),
        schrodinger g q u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z)) = 0) →
      ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
      (Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
        fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
      (∀ η : P → ℝ, ContDiff ℝ ∞ η → HasCompactSupport η →
        tsupport η ⊆ ball ((euclideanNormalSplit n).symm (extChartAt Ihalf c c)) R →
        ∀ w : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c R) p 2,
          Wkp.value 2 w =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)]
            (fun z => η z * Wkp.value 2 U z) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume (splitBoundaryChartCap (n := n) c R) p) ∧
