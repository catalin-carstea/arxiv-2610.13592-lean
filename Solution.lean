  compactSpace_nativeBoundary

without_proof_info in
theorem DirichletGreenKernel.nativeJet_forcing_moment_of_compact_support
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {N : ℕ} (points : Fin N → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : Fin N) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    (w : M → ℝ) (hw : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w)
    (hwc : HasCompactSupport w) (hwi : tsupport w ⊆ (𝓡∂ (n + 1)).interior M)
    (hFP : Disjoint (tsupport (schrodinger g q w)) (range points)) :
    Integrable (fun y => greenJetSection g points ℓ G.kernel y * schrodinger g q w y)
