    (hA : ∀ i j, A i j = A j i) (hDG : ∀ l i j, DG l i j = DG l j i)
    (hDA : ∀ l, DA l = -(A * DG l * A)) (k : Fin n) :
    contractedChristoffel A DG k =
      -(∑ i, (DA i i k + (1 / 2 : ℝ) * A i k * metricJetTrace A (DG i))) := by
  let T1 : ℝ := ∑ i, ∑ j, ∑ l, A i j * A k l * DG i j l
  let T2 : ℝ := ∑ i, ∑ j, ∑ l, A i j * A k l * DG j i l
  let T3 : ℝ := ∑ i, ∑ j, ∑ l, A i j * A k l * DG l i j
