/- Lift a holomorphic compact-field family into its closed compatibility
graph. Intended caller: analytic C1 coefficient fields, then Holder readings. -/
open Set Filter
open scoped Topology
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [FiniteDimensional ℂ E] [NormedAddCommGroup F] [NormedSpace ℂ F] [CompleteSpace F]

without_proof_info in
theorem analyticAt_closedSubspace
    (S : Submodule ℂ F) (hS : IsClosed (S : Set F))
    {g : E → S} {U : Set E} (hU : IsOpen U)
    (hf : AnalyticOnNhd ℂ (fun x => (g x : F)) U) {x : E} (hx : x ∈ U) :
    AnalyticAt ℂ g x := by
  letI : CompleteSpace S := hS.completeSpace_coe
  have hgc : ContinuousOn g U :=
    (S.subtypeₗᵢ.isEmbedding.continuousOn_iff).mpr hf.continuousOn
  apply DifferentiableOn.analyticAt_of_finiteDimensional (s := U) _ (hU.mem_nhds hx)
  intro y hy
  let D := fderiv ℂ (fun x => (g x : F)) y
  have hD : HasFDerivAt (fun x => (g x : F)) D y :=
    (hf y hy).differentiableAt.hasFDerivAt
  have hDS : ∀ v, D v ∈ S := fun v =>
    hD.apply_mem_of_eventually_sub_mem hS
      (Eventually.of_forall fun z => S.sub_mem (g z).property (g y).property) v
  let DS : E →L[ℂ] S := D.codRestrict S hDS
  have hcomp : S.subtypeL.comp DS = D := by ext v; rfl
  have hgD : HasFDerivAt g DS y :=
    HasFDerivAt.of_comp_of_isEmbedding (hgc.continuousAt (hU.mem_nhds hy))
      S.subtypeL.hasFDerivAt S.subtypeₗᵢ.isEmbedding
      (hcomp.symm ▸ hD) (Eventually.of_forall fun z => rfl)
  exact hgD.differentiableAt.differentiableWithinAt

end ConformalPoisson

