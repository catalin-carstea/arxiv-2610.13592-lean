    ∃ N : Opens M, c ∈ N ∧ ∃ C ≥ 0,
      ∀ F u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F → ∀ hu : IsZeroDirichletSolution g q F u,
        ∀ x ∈ N, nativeC1Function g u (hu.1.of_le (by simp)) x ≤
