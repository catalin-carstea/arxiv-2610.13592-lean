/-- Every Euclidean test on the cap has an actual smooth native
zero-boundary transplant supported in the corresponding native region. -/
theorem exists_native_test_transplant (φ : 𝓓(L.innerCap, ℝ)) :
    ∃ v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x},
      tsupport v.val ⊆ (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V) ∧
      ∀ z ∈ (L.innerCap : Set V), v.val ((extChartAt I c).symm z) = φ z := by
  obtain ⟨v, hv, _, hsupp, hread⟩ := exists_contMDiff_comp_extChartAt_symm_eq (I := I) (c := c)
    φ.contDiff φ.hasCompactSupport (φ.tsupport_subset.trans (L.innerCap_subset_interior_target.trans interior_subset))
  have hs : tsupport v ⊆ (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V) := by
    intro x hx
    obtain ⟨z, hz, rfl⟩ := hsupp hx
    have hzΩ := φ.tsupport_subset hz
    have hzt := interior_subset (L.innerCap_subset_interior_target hzΩ)
    exact ⟨(extChartAt I c).map_target hzt, by
      simpa only [mem_preimage, (extChartAt I c).right_inv hzt] using hzΩ⟩
  have hv0 : ∀ x : M, I.IsBoundaryPoint x → v x = 0 := by
    intro x hx
    by_contra hn
    have hxs := hs (subset_tsupport v hn)
    have hxsource : x ∈ (chartAt H c).source := by simpa only [extChartAt_source] using hxs.1
