/- Fixed Haar-normalization factors for the actual coordinate Lp norms.
No normalization of Module.finBasis is silently identified with volume. -/
open MeasureTheory MeasureTheory.Measure Set
open scoped ENNReal NNReal
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
  [LocallyCompactSpace E] [SecondCountableTopology E] [NormedAddCommGroup F]

without_proof_info in
theorem exists_haar_lpNorm_factor (μ ν : Measure E) [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure]
    {p : ℝ≥0∞} (hp : p ≠ ⊤) :
    ∃ C ≥ 0, ∀ S : Set E, ∀ f : E → F,
      lpNorm f p (μ.restrict S) = C * lpNorm f p (ν.restrict S) := by
  let c := addHaarScalarFactor μ ν
  have hμ : μ = c • ν := isAddLeftInvariant_eq_smul μ ν
  refine ⟨(c : ℝ) ^ p.toReal⁻¹, Real.rpow_nonneg c.coe_nonneg _, fun S f => ?_⟩
  rw [hμ, Measure.restrict_smul]
  rw [lpNorm_smul_measure_of_ne_top hp c]
  simp only [NNReal.smul_def, NNReal.coe_rpow, smul_eq_mul]

end ConformalPoisson

end ProofPart_GreenTrace_HaarLpComparison

