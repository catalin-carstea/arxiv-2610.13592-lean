  have hKc := hK.image_of_continuousOn ((continuousOn_extChartAt α).mono hKs)
  exact HasCompactSupport.intro hKc (fun _ hz => supportedNativeCoordinateFlux_eq_zero g α X hz)

set_option maxHeartbeats 500000 in
without_proof_info in
theorem supportedNativeCoordinateFlux_contDiffOn
    (g : Metric (n := n) (M := M)) (α : M)
    (X : (x : M) → TangentSpace Ihalf x)
    (hX : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M)))
    (hK : IsCompact (tsupport (α := V) X))
    (hKs : tsupport (α := V) X ⊆ (extChartAt Ihalf α).source) :
    ContDiffOn ℝ 1 (supportedNativeCoordinateFlux g α X) (range Ihalf) := by
  have hKc := hK.image_of_continuousOn ((continuousOn_extChartAt α).mono hKs)
  intro z hz
  by_cases ht : z ∈ (extChartAt Ihalf α).target
  · have hn := extChartAt_target_mem_nhdsWithin_of_mem ht
    have heq : supportedNativeCoordinateFlux g α X =ᶠ[𝓝[range Ihalf] z] nativeCoordinateFlux g α X := by
      filter_upwards [hn] with w hw
