without_proof_info in
theorem exists_cutoff_scalar_residual_bound {S : TopologicalSpace.Opens H}
    (F : NormalMetricField S) {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) {K : Set Y} (hK : IsCompact K) (hKU : K ⊆ U)
    (a : Y → ℂ) (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (η : ContDiffBump (0 : ℝ)) (M : ℕ) {CT T : ℝ} (hCT : 0 ≤ CT) (hT : 0 ≤ T)
    (he : LayerCoefficientTaylorError F B K η.rOut M CT)
    (hS : ∀ z : H, (nativeNormalCoordinates z).1 ∈ K →
      (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) η.rOut → z ∈ S)
    (hτ : ∀ z : H, (nativeNormalCoordinates z).1 ∈ K →
      (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) η.rOut → |F.tau z| ≤ T) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : H,
      (nativeNormalCoordinates z).1 ∈ K → (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) η.rOut →
      ∀ h : ℝ, 0 < h → h ≤ 1 →
      ‖∑ j ∈ range (M + 1), (h ^ j : ℂ) * ((h : ℂ) ^ 2 *
        complexSplitOperator (fun i l => (F.inverse z i l : ℂ)) (F.tau z)
          (fun i => (metricTangentialDrift F i z : ℂ))
          (normalCutoffWave η (scaledPlaneWave ξ h (B.profile a j)))
          (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2)‖ ≤ C * h ^ (M + 1) := by
  obtain ⟨C₀, hC₀, hb₀⟩ := B.exists_uncut_scalar_residual_bound F hU hK hKU a ha ha0 M hCT he
  obtain ⟨C₁, hC₁, hb₁⟩ := B.exists_cutoff_defect_bound hU hK hKU a ha ha0 η hT M (M + 1)
  refine ⟨C₀ + (M + 1 : ℕ) * C₁, by positivity, ?_⟩
