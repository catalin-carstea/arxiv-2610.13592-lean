/- Mixed relative derivatives respect the actual equation and finite
sums on the physical domain. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem mixedDerivativeWithin_congr
    {S : Set E} {f g : E → F} (hfg : EqOn f g S) {x : E} (hx : x ∈ S)
    (P : E →L[ℝ] E) (e : E) (p q : ℕ) :
    mixedDerivativeWithin S P e p q f x = mixedDerivativeWithin S P e p q g x := by
  have hnormal : EqOn (normalDerivativeWithin S e q f) (normalDerivativeWithin S e q g) S :=
    iteratedFDerivWithinAlong_congr hfg (List.replicate q e)
  unfold mixedDerivativeWithin
  rw [iteratedFDerivWithin_congr (𝕜 := ℝ) hnormal hx p]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem mixedDerivativeWithin_sum
    {S : Set E} (hS : UniqueDiffOn ℝ S) {ι : Type*} (s : Finset ι)
    (f : ι → E → F) (hf : ∀ i ∈ s, ContDiffOn ℝ ∞ (f i) S)
    {x : E} (hx : x ∈ S) (P : E →L[ℝ] E) (e : E) (p q : ℕ) :
    mixedDerivativeWithin S P e p q (fun y => ∑ i ∈ s, f i y) x =
      ∑ i ∈ s, mixedDerivativeWithin S P e p q (f i) x := by
  have hnormal : EqOn (normalDerivativeWithin S e q (fun y => ∑ i ∈ s, f i y))
      (fun y => ∑ i ∈ s, normalDerivativeWithin S e q (f i) y) S := by
    intro y hy
    have hleft := iteratedFDerivWithinAlong_ofFn hS (ContDiffOn.sum hf)
      (fun _ : Fin q => e) hy
    rw [List.ofFn_const] at hleft
    change iteratedFDerivWithinAlong S (List.replicate q e) (fun y => ∑ i ∈ s, f i y) y = _
    rw [hleft, iteratedFDerivWithin_fun_sum_apply hS hy
      (fun i hi => (hf i hi y hy).of_le (by simp))]
    simp only [ContinuousMultilinearMap.sum_apply]
    apply Finset.sum_congr rfl
    intro i hi
    have hiword := iteratedFDerivWithinAlong_ofFn hS (hf i hi) (fun _ : Fin q => e) hy
    rw [List.ofFn_const] at hiword
    exact hiword.symm
  apply ContinuousMultilinearMap.ext
  intro m
  change iteratedFDerivWithin ℝ p
    (normalDerivativeWithin S e q (fun y => ∑ i ∈ s, f i y)) S x (fun i => P (m i)) = _
  rw [iteratedFDerivWithin_congr hnormal hx p,
    iteratedFDerivWithin_fun_sum_apply hS hx
      (fun i hi => (contDiffOn_normalDerivativeWithin hS (hf i hi) e q x hx).of_le (by simp))]
  simp only [ContinuousMultilinearMap.sum_apply]
  rfl

end ConformalPoisson

