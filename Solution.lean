    (ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i 1))).analyticAt _).comp hK

without_proof_info in
theorem analyticAt_pullbackHessianTerm {A K : P → H (V →L[ℝ] V)}
    (hA : AnalyticAt ℝ A p) (hK : AnalyticAt ℝ K p) (i : Fin d) :
    AnalyticAt ℝ (fun a => pullbackHessianTerm (A a) (K a) i) p :=
