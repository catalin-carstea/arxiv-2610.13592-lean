noncomputable section ProofPart_DNSymbol_DNComplexNativeOperator



/- Assignment268, /root. The complex native residual is exactly the pair
of original real native Schrodinger residuals. Its real linearity and locality
are proved from the already checked original native operator. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson.LocalDN
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

def complexSchrodinger (g : Metric (n := n) (M := M)) (q : M → ℝ) (U : M → ℂ) (x : M) : ℂ :=
  Complex.mk (schrodinger g q (fun y => (U y).re) x) (schrodinger g q (fun y => (U y).im) x)

without_proof_info in
theorem complexSchrodinger_zero (g : Metric (n := n) (M := M)) (q : M → ℝ) (x : M) :
    complexSchrodinger g q (fun _ => 0) x = 0 := by
  apply Complex.ext <;> exact schrodinger_zero g q x

without_proof_info in
theorem complexSchrodinger_add (g : Metric (n := n) (M := M)) (q : M → ℝ)
    {U V : M → ℂ} (hU : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ U)
    (hV : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ V) (x : M) :
    complexSchrodinger g q (U + V) x = complexSchrodinger g q U x + complexSchrodinger g q V x := by
  have hUr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y => (U y).re) := Complex.reCLM.contDiff.contMDiff.comp hU
  have hUi : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y => (U y).im) := Complex.imCLM.contDiff.contMDiff.comp hU
  have hVr := Complex.reCLM.contDiff.contMDiff.comp hV
  have hVi := Complex.imCLM.contDiff.contMDiff.comp hV
  apply Complex.ext
  · exact schrodinger_add g q hUr hVr x
  · exact schrodinger_add g q hUi hVi x

without_proof_info in
theorem complexSchrodinger_smul (g : Metric (n := n) (M := M)) (q : M → ℝ) (a : ℝ)
    {U : M → ℂ} (hU : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ U) (x : M) :
    complexSchrodinger g q (a • U) x = (a : ℂ) * complexSchrodinger g q U x := by
  have hUr : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y => (U y).re) := Complex.reCLM.contDiff.contMDiff.comp hU
  have hUi : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (fun y => (U y).im) := Complex.imCLM.contDiff.contMDiff.comp hU
  have hr : (fun y => ((a • U) y).re) = a • (fun y => (U y).re) := by
    funext y
    simp only [Pi.smul_apply, Complex.real_smul, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero, smul_eq_mul]
  have hi : (fun y => ((a • U) y).im) = a • (fun y => (U y).im) := by
    funext y
    simp only [Pi.smul_apply, Complex.real_smul, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, add_zero, smul_eq_mul]
  unfold complexSchrodinger
  rw [hr, hi, schrodinger_smul g q a hUr, schrodinger_smul g q a hUi]
  apply Complex.ext <;> simp

without_proof_info in
theorem complexSchrodinger_finsetSum (g : Metric (n := n) (M := M)) (q : M → ℝ)
    {ι : Type*} (A : Finset ι) (U : ι → M → ℂ)
    (hU : ∀ i ∈ A, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (U i)) (x : M) :
    complexSchrodinger g q (∑ i ∈ A, U i) x = ∑ i ∈ A, complexSchrodinger g q (U i) x := by
  classical
  induction A using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact complexSchrodinger_zero g q x
  | @insert i A hi ih =>
    have hiU := hU i (Finset.mem_insert_self i A)
    have hAU : ∀ j ∈ A, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (U j) :=
      fun j hj => hU j (Finset.mem_insert_of_mem hj)
    have hASmooth : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (∑ j ∈ A, U j) := by
      have hfun : (∑ j ∈ A, U j) = fun z => ∑ j ∈ A, U j z := by
        funext z
        simp only [Finset.sum_apply]
      rw [hfun]
      exact ContMDiff.sum hAU
    rw [Finset.sum_insert hi, Finset.sum_insert hi,
      complexSchrodinger_add g q hiU hASmooth, ih hAU]

without_proof_info in
theorem complexSchrodinger_eq_of_eventuallyEq (g : Metric (n := n) (M := M)) (q : M → ℝ)
    {U V : M → ℂ} (hU : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ U)
    (hV : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ V) {x : M} (he : U =ᶠ[𝓝 x] V) :
    complexSchrodinger g q U x = complexSchrodinger g q V x := by
  apply Complex.ext
  · exact schrodinger_eq_of_eventuallyEq g q
      ((Complex.reCLM.contDiff.contMDiff.comp hU).of_le (by decide)).contMDiffAt
      ((Complex.reCLM.contDiff.contMDiff.comp hV).of_le (by decide)).contMDiffAt
      (he.mono (fun y hy => congrArg Complex.re hy))
  · exact schrodinger_eq_of_eventuallyEq g q
      ((Complex.imCLM.contDiff.contMDiff.comp hU).of_le (by decide)).contMDiffAt
      ((Complex.imCLM.contDiff.contMDiff.comp hV).of_le (by decide)).contMDiffAt
      (he.mono (fun y hy => congrArg Complex.im hy))

without_proof_info in
theorem complexSchrodinger_zero_outside (g : Metric (n := n) (M := M)) (q : M → ℝ)
    {U : M → ℂ} (hU : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ U) {x : M} (hx : x ∉ tsupport U) :
    complexSchrodinger g q U x = 0 :=
  (complexSchrodinger_eq_of_eventuallyEq g q hU contMDiff_const
    (notMem_tsupport_iff_eventuallyEq.mp hx)).trans (complexSchrodinger_zero g q x)

without_proof_info in
theorem tsupport_complexSchrodinger_subset (g : Metric (n := n) (M := M)) (q : M → ℝ)
    {U : M → ℂ} (hU : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ U) :
    tsupport (complexSchrodinger g q U) ⊆ tsupport U := by
  apply closure_minimal ?_ (isClosed_tsupport U)
  intro x hx
  by_contra hn
  exact hx (complexSchrodinger_zero_outside g q hU hn)

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNComplexNativeOperator

