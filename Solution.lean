noncomputable section ProofPart_GreenTrace_NativeInverseEvaluation





/- Bounded native point-evaluation functionals of the actual inverse on Lp.
This is the first inverse-kernel construction step, with the same native volume.
The Hahn--Banach extension need not be chosen compatibly in the point yet. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

def nativeSmoothValueLinearMap : C^∞⟮Ihalf, M; ℝ⟯ →ₗ[ℝ] C(M, ℝ) where
  toFun F := ⟨F, F.contMDiff.continuous⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def nativeSmoothForcingToLp (g : Metric (n := n) (M := M)) (p : ℝ≥0∞)
    [Fact (1 ≤ p)] : C^∞⟮Ihalf, M; ℝ⟯ →ₗ[ℝ] Lp ℝ p (nativeVolume g) := by
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  exact (ContinuousMap.toLp p (nativeVolume g) ℝ).toLinearMap.comp nativeSmoothValueLinearMap

without_proof_info in
theorem norm_nativeSmoothForcingToLp (g : Metric (n := n) (M := M)) (p : ℝ≥0∞)
    [Fact (1 ≤ p)] (F : C^∞⟮Ihalf, M; ℝ⟯) :
    ‖nativeSmoothForcingToLp g p F‖ = (eLpNorm F p (nativeVolume g)).toReal := by
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  exact norm_continuousMap_toLp (μ := nativeVolume g) (p := p) (nativeSmoothValueLinearMap F)

without_proof_info in
theorem nativeSmoothForcingToLp_ae (g : Metric (n := n) (M := M)) (p : ℝ≥0∞)
    [Fact (1 ≤ p)] (F : C^∞⟮Ihalf, M; ℝ⟯) :
    nativeSmoothForcingToLp g p F =ᵐ[nativeVolume g] F := by
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  exact ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℝ) (nativeVolume g)
    (nativeSmoothValueLinearMap F)

def nativeSmoothEvaluation (x : M) : C^∞⟮Ihalf, M; ℝ⟯ →ₗ[ℝ] ℝ where
  toFun F := F x
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_inverse_evaluation_functionals
    {r : ℝ≥0} [Fact (1 ≤ (r : ℝ≥0∞))]
    (hr : (n + 1 : ℝ≥0) < r) (hp : 2 < (r : ℝ≥0∞))
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q) :
    ∃ C ≥ 0, ∀ x : M, ∃ L : Lp ℝ (r : ℝ≥0∞) (nativeVolume g) →L[ℝ] ℝ,
      ‖L‖ ≤ C ∧ ∀ F : C^∞⟮Ihalf, M; ℝ⟯, ∀ u : M → ℝ,
        IsZeroDirichletSolution g q F u → L (nativeSmoothForcingToLp g r F) = u x := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  obtain ⟨S⟩ := nonempty_zeroDirichletSolver g q hq hNR
  obtain ⟨C, hC, hbound⟩ := native_zero_dirichlet_c1_bound hr hp g q hq hNR
  refine ⟨C, hC, fun x => ?_⟩
  let f := (nativeSmoothEvaluation x).comp (S.smoothInverseLinearMap hNR)
  have hbd : ∀ F, ‖f F‖ ≤ C * ‖nativeSmoothForcingToLp g r F‖ := by
    intro F
    have hu := S.correct F F.contMDiff
    have hv : |S.solve F x| ≤ ‖nativeC1Function g (S.solve F) (hu.1.of_le (by simp))‖ :=
      (le_add_of_nonneg_right (norm_nonneg (TauCeti.Manifold.mgradient Ihalf (S.solve F) x))).trans
        (native_value_gradient_le_c1_norm g (S.solve F) _ x)
    rw [norm_nativeSmoothForcingToLp]
    exact hv.trans (hbound F (S.solve F) F.contMDiff hu)
  obtain ⟨L, hL, hLC⟩ := exists_functional_extension_of_reading_bound
    (nativeSmoothForcingToLp g (r : ℝ≥0∞)) f hC hbd
  refine ⟨L, hLC, fun F u hu => ?_⟩
  rw [hL]
  exact congrFun (hNR.zeroDirichlet_solution_unique (S.correct F F.contMDiff) hu) x

end ConformalPoisson

end ProofPart_GreenTrace_NativeInverseEvaluation

