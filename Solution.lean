without_proof_info in
theorem contDiff_cutoff_smul_on_open
    {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    {Ω : Set E} (hΩ : IsOpen Ω) {χ : E → ℝ} {a : E → F}
    (hχ : ContDiff ℝ ∞ χ) (ha : ContDiffOn ℝ ∞ a Ω) (hs : tsupport χ ⊆ Ω) :
    ContDiff ℝ ∞ (fun z => χ z • a z) := by
  rw [contDiff_iff_contDiffAt]
  intro z
  by_cases hz : z ∈ tsupport χ
  · exact hχ.contDiffAt.smul ((ha z (hs hz)).contDiffAt (hΩ.mem_nhds (hs hz)))
  · apply (contDiffAt_const (c := (0 : F))).congr_of_eventuallyEq
    filter_upwards [notMem_tsupport_iff_eventuallyEq.mp hz] with w hw
    simp only [hw, Pi.zero_apply, zero_smul]

without_proof_info in
theorem inner_lower_of_small_operator_difference
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (A A₀ : E →L[ℝ] E) {lam ε : ℝ}
    (hcenter : ∀ ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪A₀ ξ, ξ⟫_ℝ)
    (hsmall : ‖A - A₀‖ ≤ ε) :
    ∀ ξ, (lam - ε) * ‖ξ‖ ^ 2 ≤ ⟪A ξ, ξ⟫_ℝ := by
  intro ξ
  have hbound : |⟪(A - A₀) ξ, ξ⟫_ℝ| ≤ ε * ‖ξ‖ ^ 2 := by
    calc
      _ ≤ ‖(A - A₀) ξ‖ * ‖ξ‖ := abs_real_inner_le_norm _ _
      _ ≤ (‖A - A₀‖ * ‖ξ‖) * ‖ξ‖ :=
        mul_le_mul_of_nonneg_right ((A - A₀).le_opNorm ξ) (norm_nonneg _)
      _ ≤ (ε * ‖ξ‖) * ‖ξ‖ :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hsmall (norm_nonneg _)) (norm_nonneg _)
      _ = _ := by ring
  have hdiff : ⟪(A - A₀) ξ, ξ⟫_ℝ = ⟪A ξ, ξ⟫_ℝ - ⟪A₀ ξ, ξ⟫_ℝ := by
    simp only [sub_apply, inner_sub_left]
  rw [hdiff] at hbound
  nlinarith [hcenter ξ, (abs_le.mp hbound).1]

without_proof_info in
theorem cutoff_principal_lower
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (A A₀ : E →L[ℝ] E) {lam ε θ : ℝ}
    (hθ : 0 ≤ θ ∧ θ ≤ 1) (hε : 0 ≤ ε)
    (hcenter : ∀ ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪A₀ ξ, ξ⟫_ℝ)
    (hsmall : ‖A - A₀‖ ≤ ε) :
    ∀ ξ, (lam - ε) * ‖ξ‖ ^ 2 ≤ ⟪(θ • A + (1 - θ) • A₀) ξ, ξ⟫_ℝ := by
  intro ξ
  have hA := inner_lower_of_small_operator_difference A A₀ hcenter hsmall ξ
  have hA₀ := hcenter ξ
  have hmulA := mul_le_mul_of_nonneg_left hA hθ.1
  have hmulA₀ := mul_le_mul_of_nonneg_left hA₀ (sub_nonneg.mpr hθ.2)
  simp only [add_apply, smul_apply, inner_add_left, real_inner_smul_left]
  have herror : 0 ≤ (1 - θ) * ε * ‖ξ‖ ^ 2 :=
    mul_nonneg (mul_nonneg (sub_nonneg.mpr hθ.2) hε) (sq_nonneg _)
  nlinarith

structure SmoothEllipticExtensionData (d : ℕ)
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (z₀ : CoordinateSpace d) where
  principal : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d
  drift : CoordinateSpace d → CoordinateSpace d
  potential : CoordinateSpace d → ℝ
  principal_smooth : ContDiff ℝ ∞ principal
  drift_smooth : ContDiff ℝ ∞ drift
  potential_smooth : ContDiff ℝ ∞ potential
  deviation_compact : HasCompactSupport (fun z => principal z - A z₀)
  drift_compact : HasCompactSupport drift
  potential_compact : HasCompactSupport potential
  agrees : ∀ᶠ z in 𝓝 z₀, principal z = A z ∧ drift z = b z ∧ potential z = q z
  lam : ℝ
  lam_pos : 0 < lam
  coercive : ∀ z ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪principal z ξ, ξ⟫_ℝ

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_smooth_elliptic_extension
    {d : ℕ} {Ω : Set (CoordinateSpace d)} (hΩ : IsOpen Ω) {z₀ : CoordinateSpace d} (hz₀ : z₀ ∈ Ω)
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiffOn ℝ ∞ A Ω) (hb : ContDiffOn ℝ ∞ b Ω) (hq : ContDiffOn ℝ ∞ q Ω)
    {lam : ℝ} (hlam : 0 < lam)
    (hcenter : ∀ ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪A z₀ ξ, ξ⟫_ℝ)
    (hosc : ∀ z ∈ Ω, ‖A z - A z₀‖ ≤ lam / 4) :
    Nonempty (SmoothEllipticExtensionData d A b q z₀) := by
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hΩ z₀ hz₀
  let β : ContDiffBump z₀ :=
    { rIn := r / 4
      rOut := r / 2
      rIn_pos := by positivity
      rIn_lt_rOut := by linarith }
  have hβs : tsupport β ⊆ Ω := by
    rw [β.tsupport_eq]
    exact (closedBall_subset_ball (by dsimp only [β]; linarith : β.rOut < r)).trans hball
  let A' : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d :=
    fun z => β z • A z + (1 - β z) • A z₀
  let b' : CoordinateSpace d → CoordinateSpace d := fun z => β z • b z
  let q' : CoordinateSpace d → ℝ := fun z => β z * q z
  have hAc : ContDiff ℝ ∞ A' :=
