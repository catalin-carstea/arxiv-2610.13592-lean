        ⟪v, Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) x⟫_ℝ := by
  obtain ⟨D, hD⟩ := exists_w2p_directional_gradient_lift (μ := μ) (p := (r : ℝ≥0∞)) v
