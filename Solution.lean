/- Assignment268, /root. The coefficient Taylor errors used by the scalar
residual are produced for BOTH actual metric fields on ONE common collar. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti Finset
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

def LayerCoefficientTaylorError {S : TopologicalSpace.Opens H} (F : NormalMetricField S)
    {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (K : Set Y) (r : ℝ) (N : ℕ) (C : ℝ) : Prop :=
  ∀ z : H, (nativeNormalCoordinates z).1 ∈ K → (nativeNormalCoordinates z).2 ∈ Icc (0 : ℝ) r →
    (∀ i j, ‖(F.inverse z i j : ℂ) - B.matrixTaylor N (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2 i j‖ ≤
      C * (nativeNormalCoordinates z).2 ^ (N + 1)) ∧
    ‖(F.tau z : ℂ) - B.normalTaylor N (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2‖ ≤
      C * (nativeNormalCoordinates z).2 ^ (N + 1) ∧
    (∀ i, ‖(metricTangentialDrift F i z : ℂ) - B.tangentTaylor N (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2 i‖ ≤
      C * (nativeNormalCoordinates z).2 ^ (N + 1))

without_proof_info in
theorem native_matrixTaylor_eq_reading
    {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    {U : Set (EuclideanSpace ℝ (Fin n))} (hUS : MapsTo (EuclideanHalfSpace.boundaryParam n) U S)
    (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) (N : ℕ) (y : Y) (t : ℝ) (i j : Fin n) :
    (nativeBoundaryLayerCoefficients F hG hA hUS ξ hξ).matrixTaylor N y t i j =
      complexNormalTaylor (coefficientInverseReading i j ∘ normalCoefficientBundle F) y N t := by
  unfold BoundaryLayerCoefficients.matrixTaylor complexNormalTaylor
  apply sum_congr rfl
  intro l hl
  change (t : ℂ) ^ l * faceTaylor (fun z => F.inverse z i j) l y =
    faceTaylor (fun z => F.inverse z i j) l y * (t : ℂ) ^ l
  ring

without_proof_info in
theorem native_normalTaylor_eq_reading
    {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))} (F : NormalMetricField S)
    (hG : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.gram S)
    (hA : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F.inverse S)
    {U : Set (EuclideanSpace ℝ (Fin n))} (hUS : MapsTo (EuclideanHalfSpace.boundaryParam n) U S)
    (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) (N : ℕ) (y : Y) (t : ℝ) :
    (nativeBoundaryLayerCoefficients F hG hA hUS ξ hξ).normalTaylor N y t =
      complexNormalTaylor ((coefficientNormalReading (n := n)) ∘ normalCoefficientBundle F) y N t := by
  unfold BoundaryLayerCoefficients.normalTaylor complexNormalTaylor
  apply sum_congr rfl
  intro l hl
