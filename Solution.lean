its entire frontier, including its flat boundary. -/
theorem boundary_chart_cutoff_continuous_zero_frontier (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r : ℝ} (hbr : b.rOut < r)
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    {u : M → ℝ} (hu : Continuous u)
    (hu0 : ∀ x, I.IsBoundaryPoint x → u x = 0) :
    ContinuousOn (fun z => b z * u ((extChartAt I c).symm z))
      (closure (boundaryChartCap (I := I) c r : Set E)) ∧
    ∀ z ∈ frontier (boundaryChartCap (I := I) c r : Set E),
      b z * u ((extChartAt I c).symm z) = 0 := by
  have hcl := closure_boundaryChartCap_subset (I := I) c r
  have htarget := hcl.trans hrt
  refine ⟨b.continuous.continuousOn.mul
    (hu.comp_continuousOn ((continuousOn_extChartAt_symm c).mono htarget)), ?_⟩
  intro z hz
  by_cases hbz : b z = 0
  · simp [hbz]
  have hzball : z ∈ ball (extChartAt I c c) r := by
    have hzb : z ∈ ball (extChartAt I c c) b.rOut := by
      rw [← b.support_eq]
      exact hbz
    exact ball_subset_ball hbr.le hzb
  have hzcl := hcl hz.1
  have hzt := hrt hzcl
  have hnot : z ∉ interior (range I) := by
    intro hzi
    have hznot := hz.2
    rw [(boundaryChartCap (I := I) c r).isOpen.interior_eq] at hznot
    exact hznot ⟨hzball, hzi⟩
  have hbd := isBoundaryPoint_symm_extChartAt_of_not_mem_interior_range c hzt hnot
  rw [hu0 _ hbd, mul_zero]

without_proof_info in
/-- The original cutoff is C1 on the open cap, with ordinary rather than
within-domain derivatives. -/
theorem boundary_chart_cutoff_contDiffOn (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r : ℝ}
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) 1 u) :
    ContDiffOn ℝ 1 (fun z => b z * u ((extChartAt I c).symm z))
      (boundaryChartCap (I := I) c r : Set E) := by
  intro z hz
  have hzi := boundaryChartCap_subset_interior_target (I := I) c hrt hz
  have hinv : ContMDiffAt 𝓘(ℝ, E) I 1 (extChartAt I c).symm z :=
    (contMDiffOn_extChartAt_symm c z (interior_subset hzi)).contMDiffAt
      (Filter.mem_of_superset (isOpen_interior.mem_nhds hzi) interior_subset)
  exact (b.contDiffAt.mul ((hu.contMDiffAt.comp z hinv).contDiffAt)).contDiffWithinAt

variable [MeasurableSpace E] [BorelSpace E] {μ : Measure E} [μ.IsAddHaarMeasure]
  [CompactSpace M] [Bundle.RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]

without_proof_info in
/-- An actual smooth zero-native-boundary function gives a canonical
zero-trace Sobolev representative of its chart cutoff on the bounded cap.
The derivative comparison is precisely the one already constructed in
BoundaryChartEnergyBounds; no Sobolev trace theorem is postulated. -/
theorem exists_W1p0_boundary_chart_cutoff (c : M)
    (b : ContDiffBump (extChartAt I c c)) {r C : ℝ} (hbr : b.rOut < r)
    (hrt : closedBall (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target)
    (hC : 0 ≤ C)
    (hcmp : ∀ z ∈ (boundaryChartCap (I := I) c r : Set E), ∀ f : M → ℝ,
      MDifferentiableAt I 𝓘(ℝ) f ((extChartAt I c).symm z) →
      ‖fderiv ℝ (f ∘ (extChartAt I c).symm) z‖ ≤
        C * ‖Manifold.mgradient I f ((extChartAt I c).symm z)‖)
    {u : M → ℝ} (hu : ContMDiff I 𝓘(ℝ) 1 u)
    (hu0 : ∀ x, I.IsBoundaryPoint x → u x = 0) :
    ∃ U : W1p0 μ (boundaryChartCap (I := I) c r) 2,
      W1p.value (U : W1p μ (boundaryChartCap (I := I) c r) 2) =ᵐ[μ.restrict
        (boundaryChartCap (I := I) c r : Set E)]
        (fun z => b z * u ((extChartAt I c).symm z)) ∧
      W1p.gradient (U : W1p μ (boundaryChartCap (I := I) c r) 2) =ᵐ[μ.restrict
        (boundaryChartCap (I := I) c r : Set E)]
        ∇ (fun z => b z * u ((extChartAt I c).symm z)) := by
  let Ω := boundaryChartCap (I := I) c r
  let w : E → ℝ := fun z => b z * u ((extChartAt I c).symm z)
  have hΩb : Bornology.IsBounded (Ω : Set E) := isBounded_ball.subset inter_subset_left
  have : IsFiniteMeasure (μ.restrict (Ω : Set E)) :=
    isFiniteMeasure_restrict.2 hΩb.measure_lt_top.ne
  obtain ⟨G, hG⟩ := (b.hasCompactSupport.fderiv (𝕜 := ℝ)).exists_bound_of_continuous
    ((b.contDiff (n := (⊤ : ℕ∞))).continuous_fderiv (𝕜 := ℝ) (by simp))
  obtain ⟨K, hK⟩ := isCompact_univ.exists_bound_of_continuousOn hu.continuous.continuousOn
  obtain ⟨L, hL⟩ := isCompact_univ.exists_bound_of_continuousOn
    (Manifold.continuous_norm_mgradient hu).continuousOn
  have hw := boundary_chart_cutoff_contDiffOn c b hrt hu
  have hv : MemLp w 2 (μ.restrict (Ω : Set E)) := by
    apply MemLp.of_bound (hw.continuousOn.aestronglyMeasurable Ω.isOpen.measurableSet) K
    filter_upwards [ae_restrict_mem Ω.isOpen.measurableSet] with z hz
    calc ‖w z‖ = ‖b z‖ * ‖u ((extChartAt I c).symm z)‖ := norm_mul _ _
      _ ≤ 1 * K := mul_le_mul (by simpa [Real.norm_eq_abs, abs_of_nonneg b.nonneg] using b.le_one)
        (hK _ (mem_univ _)) (norm_nonneg _) (by norm_num)
      _ = K := one_mul _
  have hg : MemLp (∇ w) 2 (μ.restrict (Ω : Set E)) := by
    apply MemLp.of_bound (measurable_gradient w).aestronglyMeasurable (C * L + G * K)
    filter_upwards [ae_restrict_mem Ω.isOpen.measurableSet] with z hz
    rw [norm_gradient_eq_norm_fderiv]
    have hzi := boundaryChartCap_subset_interior_target (I := I) c hrt hz
    have hder := norm_fderiv_boundary_chart_cutoff_le c b hu hG hzi
    have hc := hcmp z hz u (hu.mdifferentiable one_ne_zero _)
    have hL' : ‖Manifold.mgradient I u ((extChartAt I c).symm z)‖ ≤ L := by
      simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hL ((extChartAt I c).symm z) (mem_univ _)
    have hG0 : 0 ≤ G := (norm_nonneg _).trans (hG 0)
    exact hder.trans (add_le_add (hc.trans (mul_le_mul_of_nonneg_left hL' hC))
      (mul_le_mul_of_nonneg_left (by simpa only [Real.norm_eq_abs] using hK ((extChartAt I c).symm z) (mem_univ _)) hG0))
  obtain ⟨U, hUv, hUg⟩ := W1p.exists_value_gradient_ae_eq_of_contDiffOn hw hv hg
  have htrace := boundary_chart_cutoff_continuous_zero_frontier c b hbr hrt hu.continuous hu0
  exact ⟨⟨U, W1p.mem_w1p0Submodule_of_continuousOn_closure (by norm_num) hΩb
    htrace.1 htrace.2 hUv⟩, hUv, hUg⟩

end ConformalPoisson

end ProofPart_BoundaryChartDirichlet

