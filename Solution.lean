noncomputable section ProofPart_BoundaryNestedCaps


/- Fixed nested ambient balls and a cutoff for boundary derivative
regularity. All radii are chosen from the actual localization before
any solution, forcing or tangent direction is supplied. -/
open Bundle Set Metric TopologicalSpace TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.BoundaryChartLocalization
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  {c : M} (L : BoundaryChartLocalization (I := I) c)

def derivativeOuterBall : Opens E := ⟨ball (extChartAt I c c) (L.bump.rIn / 2), isOpen_ball⟩
def derivativeInnerBall : Opens E := ⟨ball (extChartAt I c c) (L.bump.rIn / 8), isOpen_ball⟩
def derivativeBump : ContDiffBump (extChartAt I c c) :=
  ⟨L.bump.rIn / 8, L.bump.rIn / 4, div_pos L.bump.rIn_pos (by norm_num),
    by linarith [L.bump.rIn_pos]⟩

without_proof_info in
theorem derivativeOuterBall_compact_closure : IsCompact (closure (L.derivativeOuterBall : Set E)) :=
  isBounded_ball.isCompact_closure

without_proof_info in
theorem derivativeOuterBall_closure_subset :
    closure (L.derivativeOuterBall : Set E) ⊆ ball (extChartAt I c c) L.bump.rIn := by
  have hc : closure (L.derivativeOuterBall : Set E) ⊆ closedBall (extChartAt I c c) (L.bump.rIn / 2) :=
    closure_minimal ball_subset_closedBall isClosed_closedBall
  intro x hx
  exact mem_ball.mpr ((mem_closedBall.mp (hc hx)).trans_lt (by linarith [L.bump.rIn_pos]))

without_proof_info in
theorem derivativeInnerBall_le_outer : L.derivativeInnerBall ≤ L.derivativeOuterBall :=
  ball_subset_ball (by linarith [L.bump.rIn_pos])

without_proof_info in
theorem derivativeInnerBall_subset_inner :
    (L.derivativeInnerBall : Set E) ⊆ ball (extChartAt I c c) L.bump.rIn :=
  ball_subset_ball (by linarith [L.bump.rIn_pos])

without_proof_info in
theorem derivativeBump_tsupport_subset : tsupport L.derivativeBump ⊆ L.derivativeOuterBall := by
  rw [L.derivativeBump.tsupport_eq]
  intro x hx
  exact mem_ball.mpr ((mem_closedBall.mp hx).trans_lt (by
    change L.bump.rIn / 4 < L.bump.rIn / 2
    linarith [L.bump.rIn_pos]))

without_proof_info in
theorem derivativeBump_one (x : E) (hx : x ∈ L.derivativeInnerBall) : L.derivativeBump x = 1 :=
  L.derivativeBump.one_of_mem_closedBall (ball_subset_closedBall hx)

without_proof_info in
theorem derivativeInnerBall_center : extChartAt I c c ∈ L.derivativeInnerBall :=
  mem_ball_self (div_pos L.bump.rIn_pos (by norm_num))
end ConformalPoisson.BoundaryChartLocalization

