        conjugatedSplitOperator (fun i l => (F.inverse z i l : ℂ)) (F.tau z)
          (fun i => (metricTangentialDrift F i z : ℂ)) ξ h (B.profile a j)
          (nativeNormalCoordinates z).1 ((nativeNormalCoordinates z).2 / h)‖ ≤ C * h ^ (M + 1) := by
  obtain ⟨C₀, hC₀, hb₀⟩ := B.finiteResidualProfile_bound hU hK hKU a ha ha0 M
  obtain ⟨C₁, hC₁, hb₁⟩ := B.exists_native_taylor_operator_error_bound F hU hK hKU a ha ha0 M hCT he
  refine ⟨C₀ + (M + 1 : ℕ) * C₁, by positivity, ?_⟩
  intro z hz ht h hh hh1
  let y := (nativeNormalCoordinates z).1
  let t := (nativeNormalCoordinates z).2
  let s := t / h
  let A : Matrix (Fin n) (Fin n) ℂ := fun i l => (F.inverse z i l : ℂ)
  let T (j : ℕ) := conjugatedSplitOperator (B.matrixTaylor M y t) (B.normalTaylor M y t)
    (B.tangentTaylor M y t) ξ h (B.profile a j) y s
  let V (j : ℕ) := conjugatedSplitOperator A (F.tau z)
    (fun i => (metricTangentialDrift F i z : ℂ)) ξ h (B.profile a j) y s
  have hts : h * s = t := by dsimp [s]; field_simp
  have heq : (∑ j ∈ range (M + 1), (h ^ j : ℂ) * V j) =
      B.finiteResidualProfile a M h (y, s) + ∑ j ∈ range (M + 1), (h ^ j : ℂ) * (V j - T j) := by
    rw [B.finiteResidualProfile_eq_TaylorOperator_sum hU hK.isClosed a ha ha0 M (hKU hz) h s, hts, ← sum_add_distrib]
    apply sum_congr rfl
    intro j hj
    change (h ^ j : ℂ) * V j = (h ^ j : ℂ) * T j + (h ^ j : ℂ) * (V j - T j)
    ring
  have heach (j : ℕ) (hj : j ∈ range (M + 1)) :
      ‖(h ^ j : ℂ) * (V j - T j)‖ ≤ C₁ * h ^ (M + 1) := by
    have hp : ‖(h ^ j : ℂ)‖ ≤ 1 := by
      simpa only [norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hh] using
        pow_le_one₀ (n := j) hh.le hh1
    have hjM : j ≤ M := by have hj' := Finset.mem_range.mp hj; omega
    calc
      _ ≤ 1 * (C₁ * h ^ (M + 1)) := by
        rw [norm_mul]
        exact mul_le_mul hp (hb₁ j hjM z hz ht h hh hh1) (norm_nonneg _) (by positivity)
      _ = _ := one_mul _
  change ‖∑ j ∈ range (M + 1), (h ^ j : ℂ) * V j‖ ≤ _
  rw [heq]
  calc
    _ ≤ ‖B.finiteResidualProfile a M h (y, s)‖ + ‖∑ j ∈ range (M + 1), (h ^ j : ℂ) * (V j - T j)‖ := norm_add_le _ _
    _ ≤ C₀ * h ^ (M + 1) + ∑ j ∈ range (M + 1), C₁ * h ^ (M + 1) := by
      apply add_le_add (hb₀ y hz h hh hh1 s (div_nonneg ht.1 hh.le))
      exact (norm_sum_le _ _).trans (sum_le_sum heach)
    _ = _ := by simp only [sum_const, card_range, nsmul_eq_mul]; ring

end ConformalPoisson.LocalDN.BoundaryLayerCoefficients

