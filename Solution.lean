/- Proof support: LocalSobolevTrace.lean, SHA256 3c9ca5876efce1cc475c5538d0e4ebeda691cbd3c47340505d39041f68253110 -/
noncomputable section ProofPart_LocalSobolevTrace



/- Local agreement transfers weak derivatives and the actual zero
Dirichlet trace. These bridges identify the differentiated native
reading with the global zero-trace derivative of a cutoff reading. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal Gradient
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω H B : Opens E}

without_proof_info in
theorem local_weak_derivative_eq {f g d e : E → ℝ} {τ : E}
    (hd : HasWeakLineDerivOn μ Ω f d τ) (he : HasWeakLineDerivOn μ H g e τ)
    (hΩBH : Ω ⊓ B ≤ H) (hfg : f =ᵐ[μ.restrict (Ω ⊓ B : Opens E)] g) :
    d =ᵐ[μ.restrict (Ω ⊓ B : Opens E)] e :=
  ((hd.mono inf_le_left).congr_ae hfg).ae_eq (he.mono hΩBH)

without_proof_info in
theorem exists_zeroTrace_cutoff_of_local_agreement (hΩH : Ω ≤ H)
    (hHB : (H : Set E) ∩ B ⊆ Ω) (u : W1p μ Ω 2) (v : W1p0 μ H 2)
    (hagree : W1p.value u =ᵐ[μ.restrict (Ω ⊓ B : Opens E)] W1p.value v.val)
    {ψ : E → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ) (hψB : tsupport ψ ⊆ B) :
    ∃ w : W1p0 μ Ω 2, W1p.value w.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x := by
  obtain ⟨N, hN, hψN, hgN⟩ := exists_compact_smooth_multiplier_bound hψ hψc
  let wΩ := W1p.contDiffSMul ψ hψ hN (fun x _ => hψN x) (fun x _ => hgN x) u
  let wH := W1p.contDiffSMul ψ hψ hN (fun x _ => hψN x) (fun x _ => hgN x) v.val
  have hwH : wH ∈ w1p0Submodule μ H 2 :=
    W1p.contDiffSMul_mem_w1p0Submodule hψ hN (fun x _ => hψN x) (fun x _ => hgN x) v.property
  have hwH0 : ∀ᵐ x ∂μ.restrict H, x ∉ tsupport ψ → W1p.value wH x = 0 := by
    filter_upwards [W1p.value_contDiffSMul_ae hψ hN (fun x _ => hψN x) (fun x _ => hgN x) v.val]
      with x hx hxψ
    rw [hx, image_eq_zero_of_notMem_tsupport hxψ, zero_smul]
  have hnear : (H : Set E) ∩ B = (Ω : Set E) ∩ B :=
    Subset.antisymm (fun _ hx => ⟨hHB hx, hx.2⟩) (fun _ hx => ⟨hΩH hx.1, hx.2⟩)
  have hwΩ := W1p.value_contDiffSMul_ae hψ hN (fun x _ => hψN x) (fun x _ => hgN x) u
  have hwHval := ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hΩH)
    (W1p.value_contDiffSMul_ae hψ hN (fun x _ => hψN x) (fun x _ => hgN x) v.val)
  have hagr := ae_restrict_of_ae (s := (Ω : Set E))
    ((ae_restrict_iff' (Ω ⊓ B).isOpen.measurableSet).1 hagree)
  have hident : W1p.value wΩ =ᵐ[μ.restrict Ω] (H : Set E).indicator (W1p.value wH) := by
    filter_upwards [hwΩ, hwHval, hagr, ae_restrict_mem Ω.isOpen.measurableSet]
      with x hΩx hHx hax hxΩ
    rw [indicator_of_mem (hΩH hxΩ), hΩx, hHx]
    by_cases hxψ : x ∈ tsupport ψ
    · rw [hax ⟨hxΩ, hψB hxψ⟩]
    · rw [image_eq_zero_of_notMem_tsupport hxψ, zero_smul, zero_smul]
  have hw0 := W1p.mem_w1p0Submodule_of_inter_eq_of_isCompact hnear hψc hψB hwH hwH0 hident
  refine ⟨⟨wΩ, hw0⟩, ?_⟩
  filter_upwards [hwΩ] with x hx
  simpa only [smul_eq_mul] using hx
end ConformalPoisson

end ProofPart_LocalSobolevTrace

/- Proof support: LocalTangentialTrace.lean, SHA256 9b7013a6e2fee7e467209421e5834da9222917d849e2cb96dcad3dcee05e9207 -/
noncomputable section ProofPart_LocalTangentialTrace





/- Local zero trace for tangential derivatives of an H2 function on
a cap agreeing locally with the first-coordinate half-space. This
Euclidean statement also applies to the differentiated equations in
the higher-order boundary induction. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {Ω U B : Opens (EuclideanSpace ℝ (Fin (n + 1)))}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem exists_local_zeroTrace_tangential_derivative
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set V) ∩ U ⊆ Ω)
    (u : W1p μ Ω 2) (W : Wkp μ Ω 2 2) (hW : Wkp.value 2 W = W1p.value u)
    (hu0 : ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ U →
      ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x)
    (hB : IsCompact (closure (B : Set V))) (hBU : closure (B : Set V) ⊆ U)
    (τ : V) (hτ : τ 0 = 0) (d : W1p μ Ω 2)
    (hd : HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value d) τ) :
    ∀ ψ : V → ℝ, ContDiff ℝ ∞ ψ → HasCompactSupport ψ → tsupport ψ ⊆ B →
      ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value d x := by
  obtain ⟨χ, N, hχ, _, hχ1, hχc, hχU, _, _, _⟩ :=
    hB.exists_contDiff_cutoff_with_bounds U.isOpen hBU
  have hχB : ∀ x ∈ B, χ x = 1 := fun x hx =>
    interior_subset (hχ1 (subset_closure hx))
  have hχ0 : ∃ v : W1p0 μ Ω 2,
      W1p.value v.val =ᵐ[μ.restrict Ω] fun x => χ x * Wkp.value 2 W x := by
    simpa only [hW] using hu0 χ hχ hχc hχU
  obtain ⟨Z, hZ, hZ0⟩ := exists_wkp_relative_cutoff hΩH 1 hχ hχc
    (fun x hx => hHU ⟨hx.1, hχU hx.2⟩) W hχ0
  obtain ⟨v, hv⟩ := exists_w1p0_euclidean_tangential_derivative Z hZ0 τ hτ
  have hΩBH : Ω ⊓ B ≤ euclideanOpenHalfSpace n 0 := fun x hx => hΩH hx.1
  have hvalue : W1p.value u =ᵐ[μ.restrict (Ω ⊓ B : Opens V)] Wkp.value 2 Z := by
    filter_upwards [ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hΩBH) hZ,
      ae_restrict_mem (Ω ⊓ B).isOpen.measurableSet] with x hz hx
    rw [hz, indicator_of_mem hx.1, hχB x hx.2, one_mul, hW]
  have hderivative := local_weak_derivative_eq hd hv hΩBH hvalue
  have hHB : (euclideanOpenHalfSpace n 0 : Set V) ∩ B ⊆ Ω := fun x hx =>
    hHU ⟨hx.1, hBU (subset_closure hx.2)⟩
  exact fun _ hψ hψc hψB => exists_zeroTrace_cutoff_of_local_agreement hΩH hHB d v
    hderivative hψ hψc hψB
end ConformalPoisson

end ProofPart_LocalTangentialTrace

/- Proof support: StrongPrincipalEquation.lean, SHA256 40bb98b6fc0701af1129c8e70464f11036c4ff79500fe50a12f47eba5e1d2a3f -/
noncomputable section ProofPart_StrongPrincipalEquation




/- The strong almost-everywhere principal equation of an H2 weak
solution. The integration-by-parts identity is the public theorem of
the pinned Tau Ceti `Regularity/DifferentiatedEquation.lean`; the
fundamental lemma then identifies its locally integrable right side.
No classical representative or boundary regularity is assumed. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {ι : Type*} [Fintype ι] {μ : Measure (EuclideanSpace ℝ ι)} [μ.IsAddHaarMeasure]
  {Ω : Opens (EuclideanSpace ℝ ι)}

without_proof_info in
theorem ae_strong_principal_equation
    {a : EuclideanSpace ℝ ι → Matrix ι ι ℝ}
    (ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) Ω)
    {u : W1p μ Ω 2} {D : ι → W1p μ Ω 2}
    (hD : ∀ j, HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value (D j))
      (EuclideanSpace.basisFun ι ℝ j))
    (f : Lp ℝ 2 (μ.restrict Ω))
    (hu : ∀ φ : 𝓓(Ω, ℝ), energyFormH1 a 0 0 u (W1p.ofTestFunctionₗ μ Ω 2 φ) =
      ∫ x in Ω, f x * φ x ∂μ) :
    ∀ᵐ x ∂μ.restrict Ω, f x + ∑ i, ∑ j,
      (fderiv ℝ (fun y => a y i j) x (EuclideanSpace.basisFun ι ℝ i) *
          ⟪W1p.gradient u x, EuclideanSpace.basisFun ι ℝ j⟫_ℝ +
        a x i j * ⟪W1p.gradient (D j) x, EuclideanSpace.basisFun ι ℝ i⟫_ℝ) = 0 := by
  let b := EuclideanSpace.basisFun ι ℝ
  let R := fun x => ∑ i, ∑ j,
    (fderiv ℝ (fun y => a y i j) x (b i) * ⟪W1p.gradient u x, b j⟫_ℝ +
      a x i j * ⟪W1p.gradient (D j) x, b i⟫_ℝ)
  have hgrad : ∀ (w : W1p μ Ω 2) v,
      LocallyIntegrableOn (fun x => ⟪W1p.gradient w x, v⟫_ℝ) Ω μ := fun w v => by
    simpa only [innerSL_apply_apply] using
      ((W1p.hasWeakFDerivOn w).hasWeakLineDerivOn v).locallyIntegrableOn_deriv
  have hR : LocallyIntegrableOn R Ω μ :=
    locallyIntegrableOn_finsetSum Finset.univ fun i _ =>
      locallyIntegrableOn_finsetSum Finset.univ fun j _ =>
        ((hgrad u (b j)).continuousOn_mul
          (((ha i j).continuousOn_fderiv_of_isOpen Ω.isOpen (by simp)).clm_apply continuousOn_const)
          Ω.isOpen.isLocallyClosed).add
        ((hgrad (D j) (b i)).continuousOn_mul (ha i j).continuousOn Ω.isOpen.isLocallyClosed)
  have hf : LocallyIntegrableOn (f : EuclideanSpace ℝ ι → ℝ) Ω μ :=
    Lp.locallyIntegrableOn f (by norm_num)
  have hz := Ω.isOpen.ae_eq_zero_of_integral_contDiff_smul_eq_zero (hf.add hR) (by
    intro φ hφ hφc hφs
    let Φ : 𝓓(Ω, ℝ) := ⟨φ, hφ, hφc, hφs⟩
    have hi₁ : Integrable (fun x => φ x * f x) μ := Φ.integrable_smul hf
    have hi₂ : Integrable (fun x => φ x * R x) μ := Φ.integrable_smul hR
    have heq := (hu Φ).symm.trans
      (energyFormH1_ofTestFunctionₗ_eq_neg_setIntegral_of_hasWeakLineDerivOn ha hD Φ)
    have hintegral : (∫ x, φ x * f x ∂μ) = -(∫ x, φ x * R x ∂μ) := by
      have h₁ : (∫ x in Ω, f x * Φ x ∂μ) = ∫ x, φ x * f x ∂μ := by
        rw [setIntegral_eq_integral_of_forall_compl_eq_zero (μ := μ) (s := (Ω : Set _))]
        · exact integral_congr_ae (ae_of_all _ fun x => mul_comm _ _)
        · intro x hx
          change f x * φ x = 0
          rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hφs h)), mul_zero]
      have h₂ : (∫ x in Ω, R x * Φ x ∂μ) = ∫ x, φ x * R x ∂μ := by
        rw [setIntegral_eq_integral_of_forall_compl_eq_zero (μ := μ) (s := (Ω : Set _))]
        · exact integral_congr_ae (ae_of_all _ fun x => mul_comm _ _)
        · intro x hx
          change R x * φ x = 0
          rw [image_eq_zero_of_notMem_tsupport (fun h => hx (hφs h)), mul_zero]
      exact h₁.symm.trans (heq.trans (congrArg Neg.neg h₂))
    simp only [Pi.add_apply, smul_eq_mul, mul_add]
    rw [integral_add hi₁ hi₂, hintegral, neg_add_cancel])
  rw [ae_restrict_iff' Ω.isOpen.measurableSet]
  exact hz
end ConformalPoisson

end ProofPart_StrongPrincipalEquation

/- Proof support: RelativeNormalRecovery.lean, SHA256 86978d96850275119e3a11dcd8c8c65745df6febe927cf774aeffd34cab082d7 -/
noncomputable section ProofPart_RelativeNormalRecovery



/- Recover the pure normal Hessian component in Hk from the equation,
the Hk forcing and first derivatives, and the other Hessian components.
All coefficient products and the reciprocal of the noncharacteristic
coefficient use smoothness on the relative target. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {ι : Type*} [Fintype ι] {μ : Measure (EuclideanSpace ℝ ι)} [μ.IsAddHaarMeasure]
  {Ω : Opens (EuclideanSpace ℝ ι)} {S K : Set (EuclideanSpace ℝ ι)}

without_proof_info in
theorem exists_relative_normal_hessian_sobolev
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ K) (hΩS : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ interior S)
    {a : EuclideanSpace ℝ ι → Matrix ι ι ℝ}
    (ha : ∀ i j, ContDiffOn ℝ ∞ (fun x => a x i j) S)
    (ν : ι) (haν : ∀ x ∈ S, a x ν ν ≠ 0)
    (k : ℕ) (F : Wkp μ Ω 2 k) {u : W1p μ Ω 2} {D : ι → W1p μ Ω 2}
    (hD : ∀ j, HasWeakLineDerivOn μ Ω (W1p.value u) (W1p.value (D j))
      (EuclideanSpace.basisFun ι ℝ j))
    (hu : ∀ φ : 𝓓(Ω, ℝ), energyFormH1 a 0 0 u (W1p.ofTestFunctionₗ μ Ω 2 φ) =
      ∫ x in Ω, Wkp.value k F x * φ x ∂μ)
    (hG : ∀ j, ∃ w : Wkp μ Ω 2 k, Wkp.value k w =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient u x, EuclideanSpace.basisFun ι ℝ j⟫_ℝ)
    (hH : ∀ i j, i ≠ ν ∨ j ≠ ν → ∃ w : Wkp μ Ω 2 k, Wkp.value k w =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient (D j) x, EuclideanSpace.basisFun ι ℝ i⟫_ℝ) :
    ∃ w : Wkp μ Ω 2 k, Wkp.value k w =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient (D ν) x, EuclideanSpace.basisFun ι ℝ ν⟫_ℝ := by
  classical
  let b := EuclideanSpace.basisFun ι ℝ
  choose G hG using hG
  have hH' : ∀ i j, ∃ w : Wkp μ Ω 2 k, Wkp.value k w =ᵐ[μ.restrict Ω]
      fun x => if i = ν ∧ j = ν then 0 else ⟪W1p.gradient (D j) x, b i⟫_ℝ := by
    intro i j
    by_cases h : i = ν ∧ j = ν
    · refine ⟨0, ?_⟩
      simp only [ite_eq_left h]
      have hv : Wkp.value k (0 : Wkp μ Ω 2 k) = 0 := by
        simpa only [Wkp.valueL_apply] using map_zero (Wkp.valueL (mu := μ) (Omega := Ω) (p := 2) k)
      rw [hv]
      exact Lp.coeFn_zero ℝ 2 (μ.restrict Ω)
    · obtain ⟨w, hw⟩ := hH i j (by tauto)
      exact ⟨w, by simpa only [ite_eq_right h] using hw⟩
  choose H hH using hH'
  choose P hP using fun i j => exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k
    (relative_smooth_directional_derivative hS (ha i j) (b i)) (G j)
  choose Q hQ using fun i j => exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k
    (ha i j) (H i j)
  have hP' : ∀ᵐ x ∂μ.restrict Ω, ∀ i j, Wkp.value k (P i j) x =
      fderiv ℝ (fun y => a y i j) x (b i) * ⟪W1p.gradient u x, b j⟫_ℝ := by
    refine eventually_all.2 fun i => eventually_all.2 fun j => ?_
    filter_upwards [hP i j, hG j, ae_restrict_mem Ω.isOpen.measurableSet] with x hp hg hx
    rw [hp, hg, fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp (hΩS hx))]
  have hQ' : ∀ᵐ x ∂μ.restrict Ω, ∀ i j, Wkp.value k (Q i j) x =
      a x i j * (if i = ν ∧ j = ν then 0 else ⟪W1p.gradient (D j) x, b i⟫_ℝ) := by
    refine eventually_all.2 fun i => eventually_all.2 fun j => ?_
    filter_upwards [hQ i j, hH i j] with x hq hh
    rw [hq, hh]
  let R := F + ∑ i, ∑ j, (P i j + Q i j)
  have hR := Wkp.ae_value_add_sum_eq F Finset.univ Finset.univ P Q
    (hP'.mono fun x h i _ j _ => h i j) (hQ'.mono fun x h i _ j _ => h i j)
  let N := (-1 : ℝ) • R
  obtain ⟨w, hw⟩ := exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k
    ((ha ν ν).inv haν) N
  have heq := ae_strong_principal_equation
    (fun i j => (ha i j).mono (hΩS.trans interior_subset)) hD (Wkp.value k F) hu
  refine ⟨w, ?_⟩
  have hN : Wkp.value k N = (-1 : ℝ) • Wkp.value k R := Wkp.value_smul k (-1) R
  filter_upwards [hw, hR, heq, Lp.coeFn_smul (-1 : ℝ) (Wkp.value k R),
    ae_restrict_mem Ω.isOpen.measurableSet] with x hwx hRx heqx hNx hx
  have hsplit : (∑ i, ∑ j,
      (fderiv ℝ (fun y => a y i j) x (b i) * ⟪W1p.gradient u x, b j⟫_ℝ +
        a x i j * ⟪W1p.gradient (D j) x, b i⟫_ℝ)) =
      (∑ i, ∑ j,
      (fderiv ℝ (fun y => a y i j) x (b i) * ⟪W1p.gradient u x, b j⟫_ℝ +
        a x i j * (if i = ν ∧ j = ν then 0 else ⟪W1p.gradient (D j) x, b i⟫_ℝ))) +
        a x ν ν * ⟪W1p.gradient (D ν) x, b ν⟫_ℝ := by
    have hentry : ∀ i j, a x i j * ⟪W1p.gradient (D j) x, b i⟫_ℝ =
        a x i j * (if i = ν ∧ j = ν then 0 else ⟪W1p.gradient (D j) x, b i⟫_ℝ) +
        (if i = ν ∧ j = ν then a x i j * ⟪W1p.gradient (D j) x, b i⟫_ℝ else 0) := by
      intro i j
      split_ifs <;> simp
    calc
      _ = ∑ i, ∑ j,
          ((fderiv ℝ (fun y => a y i j) x (b i) * ⟪W1p.gradient u x, b j⟫_ℝ +
            a x i j * (if i = ν ∧ j = ν then 0 else ⟪W1p.gradient (D j) x, b i⟫_ℝ)) +
            (if i = ν ∧ j = ν then a x i j * ⟪W1p.gradient (D j) x, b i⟫_ℝ else 0)) := by
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          conv_lhs => rw [hentry i j]
          exact (add_assoc _ _ _).symm
      _ = _ := by simp [Finset.sum_add_distrib, ite_and]
  change Wkp.value k w x = _
  rw [hwx, hN, hNx, Pi.smul_apply, smul_eq_mul, neg_one_mul, hRx]
  have hnonzero := haν x (interior_subset (hΩS hx))
  have hsolve : Wkp.value k F x +
      (∑ i, ∑ j,
        (fderiv ℝ (fun y => a y i j) x (b i) * ⟪W1p.gradient u x, b j⟫_ℝ +
          a x i j * (if i = ν ∧ j = ν then 0 else ⟪W1p.gradient (D j) x, b i⟫_ℝ))) =
      -(a x ν ν * ⟪W1p.gradient (D ν) x, b ν⟫_ℝ) := by
    rw [hsplit] at heqx
    linarith
  rw [hsolve, neg_neg]
  change (a x ν ν)⁻¹ * (a x ν ν * _) = _
  rw [← mul_assoc, inv_mul_cancel₀ hnonzero, one_mul]
end ConformalPoisson

end ProofPart_RelativeNormalRecovery

