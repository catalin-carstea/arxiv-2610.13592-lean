/- Proof support: FiniteJetRangeDuality.lean, SHA256 9edfc772354d65ed6d5766d0991c9b6d814833014e9df41abb98beeb8f646e85 -/
noncomputable section ProofPart_FiniteJetRangeDuality





/- Algebraic range separation for the actual simultaneous native jet map.
The analytical producer must show that every annihilator of the supported
solver jets annihilates the selected local jets. No Runge input is used here. -/

open Set
open scoped Manifold ContDiff
namespace ConformalPoisson

without_proof_info in
theorem exists_functional_extension_of_injective
    {D J : Type*} [AddCommGroup D] [Module ℝ D]
    [AddCommGroup J] [Module ℝ J] (T : D →ₗ[ℝ] J)
    (hT : Function.Injective T) (ℓ : D →ₗ[ℝ] ℝ) :
    ∃ L : J →ₗ[ℝ] ℝ, L.comp T = ℓ := by
  exact LinearMap.dualMap_surjective_of_injective hT ℓ

without_proof_info in
/-- The functional can be extended continuously when its original space is
finite dimensional. The ambient space need not have a finite-dimensional
instance; Hahn--Banach supplies the actual continuous extension. -/
theorem exists_continuous_functional_extension_of_injective
    {D J : Type*} [NormedAddCommGroup D] [NormedSpace ℝ D]
    [FiniteDimensional ℝ D] [NormedAddCommGroup J] [NormedSpace ℝ J]
    (T : D →ₗ[ℝ] J) (hT : Function.Injective T) (ℓ : D →ₗ[ℝ] ℝ) :
    ∃ L : J →L[ℝ] ℝ, ∀ d, L (T d) = ℓ d := by
  let e : D ≃ₗ[ℝ] LinearMap.range T := LinearEquiv.ofInjective T hT
  let f : LinearMap.range T →L[ℝ] ℝ := (ℓ.comp e.symm.toLinearMap).toContinuousLinearMap
  obtain ⟨L, hL, _⟩ := exists_extension_norm_eq (LinearMap.range T) f
  refine ⟨L, fun d => ?_⟩
  have h := hL (e d)
  change L (T d) = ℓ (e.symm (e d)) at h
  simpa only [e.symm_apply_apply] using h

without_proof_info in
theorem mem_range_of_annihilator
    {D J : Type*} [AddCommGroup D] [Module ℝ D]
    [AddCommGroup J] [Module ℝ J] (T : D →ₗ[ℝ] J) (j : J)
    (h : ∀ ℓ : J →ₗ[ℝ] ℝ, (∀ f, ℓ (T f) = 0) → ℓ j = 0) :
    j ∈ LinearMap.range T := by
  apply (Subspace.forall_mem_dualAnnihilator_apply_eq_zero_iff (LinearMap.range T) j).mp
  intro ℓ hℓ
  exact h ℓ fun f => (Submodule.mem_dualAnnihilator ℓ).mp hℓ (T f)
    (LinearMap.mem_range_self T f)

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
/-- A conditional caller isolates exactly the annihilator identity required
from Green representation and analytic propagation. The target is the actual
value, covector and raised covariant Hessian, at every selected point. -/
theorem exists_datum_with_jets_of_annihilator
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (S : DirichletSolver g q) (hNR : Nonresonant g q)
    (Γ : Set ((𝓡∂ (n + 1)).boundary M)) {ι : Type*} (points : ι → M)
    (v : ι → M → ℝ)
    (h : ∀ ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ,
      (∀ f : BoundaryDatum Γ,
        ℓ (fun i => secondJet g (S.solve f.val) (points i)) = 0) →
      ℓ (fun i => secondJet g (v i) (points i)) = 0) :
    ∃ f : BoundaryDatum Γ,
      ∀ i, secondJet g (S.solve f.val) (points i) = secondJet g (v i) (points i) := by
  let T : BoundaryDatum Γ →ₗ[ℝ] ((i : ι) → JetSpace g (points i)) :=
    LinearMap.pi fun i => S.jetLinearMap g q hNR Γ (points i)
  obtain ⟨f, hf⟩ := mem_range_of_annihilator T
    (fun i => secondJet g (v i) (points i)) h
  exact ⟨f, fun i => congrFun hf i⟩

end ConformalPoisson

end ProofPart_FiniteJetRangeDuality

