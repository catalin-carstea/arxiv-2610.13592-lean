    ‖w‖ ≤ ‖Wkp.lowerOrder 1 w‖ + ‖Wkp.iteratedGradient 1 w‖ :=
      Wkp.norm_le_norm_lowerOrder_add_norm_iteratedGradient 1 w
    _ ≤ (‖Wkp.value 1 (Wkp.lowerOrder 1 w)‖ +
          ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 w)‖) + ‖Wkp.iteratedGradient 1 w‖ := by
      have hl := Wkp.norm_le_norm_lowerOrder_add_norm_iteratedGradient 0 (Wkp.lowerOrder 1 w)
      rw [Wkp.lowerOrder_zero, ← Wkp.value_one] at hl
      exact add_le_add hl (le_refl _)
