/- The full localized pullback operator on actual Holder jets, followed
by its restriction to the same complete zero-Dirichlet ball graph. -/
open Set Metric
open scoped NNReal ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F
local notation "J" => HolderJet α V
local notation "BX" => BallSpace α V ℝ

def holderVectorApplication (v : H V) (K : H (V →L[ℝ] V)) : H V :=
  (ContinuousLinearMap.apply ℝ V : V →L[ℝ] (V →L[ℝ] V) →L[ℝ] V).compHolder₂ v K

def holderEndBasis (K : H (V →L[ℝ] V)) (i : Fin d) : H V :=
  TauCeti.HolderSpace.compLeftL (ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i 1)) K

def pullbackHessianTerm (A K : H (V →L[ℝ] V)) (i : Fin d) : J →L[ℝ] H ℝ :=
  holderJetHessian (holderEndBasis K i) (holderVectorApplication (holderEndBasis A i) K)

def pullbackCorrection (A K : H (V →L[ℝ] V)) (C : H (V →L[ℝ] V →L[ℝ] ℝ)) : H ℝ :=
  ∑ i : Fin d, pullbackHessianTerm A K i (0, 0, C)

def pulledBackHolderOperator (A : H (V →L[ℝ] V)) (B : H V) (Q : H ℝ)
    (K : H (V →L[ℝ] V)) (C : H (V →L[ℝ] V →L[ℝ] ℝ)) (a : V) : J →L[ℝ] H ℝ :=
  -(∑ i : Fin d, pullbackHessianTerm A K i) +
    holderJetGradient (holderVectorApplication B K) +
    ((ContinuousLinearMap.mul ℝ ℝ).compHolder₂ (pullbackCorrection A K C)).comp
      (holderJetGradient (holderVectorApplication (TauCeti.HolderSpace.const a) K)) +
    holderJetPotential Q

def pulledBackBallOperator (hα : α ≤ 1) (A : H (V →L[ℝ] V)) (B : H V) (Q : H ℝ)
    (K : H (V →L[ℝ] V)) (C : H (V →L[ℝ] V →L[ℝ] ℝ)) (a : V) : BX →L[ℝ] H ℝ :=
  (pulledBackHolderOperator A B Q K C a).comp (ballHolderJetL hα)

without_proof_info in
@[simp] theorem holderVectorApplication_apply (v : H V) (K : H (V →L[ℝ] V))
    (x : closedBall (0 : V) 1) : holderVectorApplication v K x = K x (v x) := by
  simp [holderVectorApplication]

without_proof_info in
@[simp] theorem holderEndBasis_apply (K : H (V →L[ℝ] V)) (i : Fin d)
    (x : closedBall (0 : V) 1) : holderEndBasis K i x = K x (EuclideanSpace.single i 1) := by
  simp [holderEndBasis]

without_proof_info in
theorem pulledBackHolderOperator_apply (A : H (V →L[ℝ] V)) (B : H V) (Q : H ℝ)
    (K : H (V →L[ℝ] V)) (C : H (V →L[ℝ] V →L[ℝ] ℝ)) (a : V) (j : J)
    (x : closedBall (0 : V) 1) :
    pulledBackHolderOperator A B Q K C a j x =
      -(∑ i : Fin d, j.2.2 x (K x (EuclideanSpace.single i 1))
        (K x (A x (EuclideanSpace.single i 1)))) + j.2.1 x (K x (B x)) +
      (∑ i : Fin d, C x (K x (EuclideanSpace.single i 1))
        (K x (A x (EuclideanSpace.single i 1)))) * j.2.1 x (K x a) + Q x * j.1 x := by
  simp [pulledBackHolderOperator, pullbackHessianTerm, pullbackCorrection, Finset.sum_mul]

without_proof_info in
theorem pulledBackBallOperator_at_zero (hα : α ≤ 1) (A : H (V →L[ℝ] V))
    (B : H V) (Q : H ℝ) (C : H (V →L[ℝ] V →L[ℝ] ℝ)) :
    pulledBackBallOperator hα A B Q 1 C 0 = ballSchrodinger hα A B Q := by
  ext j x
