  obtain ⟨β, hβ, γ, hγ, hlower⟩ := exists_native_boundary_lower_order_bounds g c hq htarget
  refine ⟨R₀, hR₀, hRMax, htarget, fun R hR hRR₀ => ?_⟩
  have hsub : closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆
      closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf := fun z hz =>
    ⟨closedBall_subset_closedBall hRR₀ hz.1, hz.2⟩
  have htargetR := hsub.trans htarget
  let e := euclideanNormalSplit n
  let x₀ := e.symm (extChartAt Ihalf c c)
  let Ω := splitBoundaryChartCap (n := n) c R
  let μ : Measure P := volume.restrict ((Ω : Set P) ∩ ball x₀ R)
  have hmem : ∀ z ∈ ((Ω : Set P) ∩ ball x₀ R),
      e z ∈ closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf :=
    fun z hz => hsub ⟨ball_subset_closedBall hz.1.1, interior_subset hz.1.2⟩
  have hA₀ : ∀ ξ : P, lam * ‖ξ‖ ^ 2 ≤ ⟪splitChartPrincipal g c x₀ ξ, ξ⟫_ℝ := by
    intro ξ
    rw [splitChartPrincipal, inner_conjugate_principal_isometry]
    change lam * ‖ξ‖ ^ 2 ≤ ⟪nativeChartPrincipal g c (e x₀) (e ξ), e ξ⟫_ℝ
    rw [show e x₀ = extChartAt Ihalf c c from e.apply_symm_apply _, ← e.norm_map ξ]
    exact hcoercive (e ξ)
  have hAm : AEStronglyMeasurable (splitChartPrincipal g c) μ :=
    ((continuousOn_splitChartPrincipal_cap g c htargetR).mono inter_subset_left).aestronglyMeasurable
      (Ω.isOpen.inter isOpen_ball).measurableSet
  have hA : ∀ᵐ z ∂μ, ‖splitChartPrincipal g c z - splitChartPrincipal g c x₀‖ ≤ δ * lam := by
    filter_upwards [ae_restrict_mem (Ω.isOpen.inter isOpen_ball).measurableSet] with z hz
    rw [splitChartPrincipal, splitChartPrincipal, norm_sub_conjugate_principal_isometry]
    change ‖nativeChartPrincipal g c (e z) - nativeChartPrincipal g c (e x₀)‖ ≤ δ * lam
    rw [show e x₀ = extChartAt Ihalf c c from e.apply_symm_apply _]
    exact (hbounds _ (hmem z hz)).1
  have hAΛ : ∀ᵐ z ∂μ, ‖splitChartPrincipal g c z‖ ≤ Λ := by
    filter_upwards [ae_restrict_mem (Ω.isOpen.inter isOpen_ball).measurableSet] with z hz
    rw [splitChartPrincipal, norm_conjugate_principal_isometry]
    exact (hbounds _ (hmem z hz)).2
  have hDrift : ContinuousOn (splitChartHomogeneousDrift g c) (Ω : Set P) :=
    ((e.symm.continuous.comp_continuousOn
      ((continuousOn_nativeChartDrift_target g c).comp e.continuous.continuousOn
        (fun (z : P) (hz : z ∈ (Ω : Set P)) => htargetR ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩))).neg)
  have hPotential : ContinuousOn (splitChartHomogeneousPotential c q) (Ω : Set P) :=
    ((hq.comp_continuousOn (continuousOn_extChartAt_symm c)).comp e.continuous.continuousOn
      (fun (z : P) (hz : z ∈ (Ω : Set P)) => htargetR ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩)).neg
  have hbm : AEStronglyMeasurable (splitChartHomogeneousDrift g c) μ :=
    (hDrift.mono inter_subset_left).aestronglyMeasurable (Ω.isOpen.inter isOpen_ball).measurableSet
  have hcm : AEStronglyMeasurable (splitChartHomogeneousPotential c q) μ :=
    (hPotential.mono inter_subset_left).aestronglyMeasurable (Ω.isOpen.inter isOpen_ball).measurableSet
  have hb : ∀ᵐ z ∂μ, ‖splitChartHomogeneousDrift g c z‖ ≤ β := by
    filter_upwards [ae_restrict_mem (Ω.isOpen.inter isOpen_ball).measurableSet] with z hz
    change ‖-(e.symm (nativeChartDrift g c (e z)))‖ ≤ β
    rw [norm_neg, e.symm.norm_map]
    exact (hlower _ (hmem z hz)).1
