/- First and second ordinary derivatives commute with compact-parameter
integration when the actual derivatives are jointly continuous. These lemmas
will be applied only after the Green forcing has removed the diagonal. -/
open Set Filter MeasureTheory Function
open scoped ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F Y : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [TopologicalSpace Y] [T2Space Y] [CompactSpace Y]
  [MeasurableSpace Y] [OpensMeasurableSpace Y]
  {μ : Measure Y} [IsFiniteMeasure μ]

without_proof_info in
theorem hasFDerivAt_compact_integral {U : Set E} (hU : IsOpen U)
    {x : E} (hx : x ∈ U) {F : E → Y → F}
    (hF : ContinuousOn (uncurry F) (U ×ˢ univ))
    (hd : ∀ y, DifferentiableOn ℝ (fun z => F z y) U)
    (hD : ContinuousOn (fun p : E × Y => fderiv ℝ (fun z => F z p.2) p.1) (U ×ˢ univ)) :
    HasFDerivAt (fun z => ∫ y, F z y ∂μ)
