    modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v)
        f (EuclideanHalfSpace.boundaryParam n x) =
      modelDirectionalDeriv (𝓡∂ (n + 1)) (euclideanHalfSpaceBoundaryParam n v)
        g (EuclideanHalfSpace.boundaryParam n x) := by
  rw [← analytic_boundary_restriction_deriv hf v, ← analytic_boundary_restriction_deriv hg v]
