/- The normal derivative of a Green-jet combination is the corresponding
combination of jets of the actual normal kernel. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenJetNormalBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary
local notation "K" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem DirichletGreenKernel.contMDiffAt_chartKernel
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace K (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {x y : M} (hx : x ∈ (𝓡∂ (n + 1)).interior M) (hxy : x ≠ y) :
    ContMDiffAt (𝓘(ℝ, V).prod K) 𝓘(ℝ) ∞
      (fun p : V × M => G.kernel ((extChartAt K x).symm p.1) p.2)
      (extChartAt K x x, y) := by
  let c := extChartAt K x
  have hcx : c x ∈ interior c.target := ModelWithCorners.isInteriorPoint_iff.mp hx
  have hround : c.symm (c x) = x := c.left_inv (mem_extChartAt_source x)
  have hcinv : ContMDiffAt 𝓘(ℝ, V) K ∞ c.symm (c x) :=
    (contMDiffOn_extChartAt_symm x (c x) (interior_subset hcx)).contMDiffAt
      (Filter.mem_of_superset (isOpen_interior.mem_nhds hcx) interior_subset)
  have hG := (G.smooth_off_diagonal (x, y) hxy).contMDiffAt
    ((isOpen_ne_fun continuous_fst continuous_snd).mem_nhds hxy)
  apply hG.comp_of_eq
    ((hcinv.comp (c x, y) contMDiffAt_fst).prodMk contMDiffAt_snd)
  exact Prod.ext hround rfl

without_proof_info in
theorem DirichletGreenKernel.greenJetSection_normal_chart_read
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace K (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {ι : Type*} [Fintype ι] (points : ι → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    (L : (ι → OrdinaryJet V) →L[ℝ] ℝ)
    (hL : ∀ j, L (fun i => nativeChartJetLinearMap g (points i) (j i)) = ℓ j)
    (y : (𝓡∂ (n + 1)).boundary M) :
    normalDerivative ν (greenJetSection g points ℓ G.kernel) y =
      L (fun i => chartOrdinarySecondJet (n := n) (points i)
        (fun x => normalDerivative ν (fun z => G.kernel x z) y)) := by
  have hxy (i : ι) : points i ≠ (y : M) := by
    rintro heq
    exact Set.disjoint_left.mp (𝓡∂ (n + 1)).disjoint_interior_boundary
      (heq ▸ hpoints i) y.property
  have hyP : (y : M) ∉ range points := by
    rintro ⟨i, hi⟩
    exact hxy i hi
  let J : M → ι → OrdinaryJet V := fun r i =>
    chartOrdinarySecondJet (n := n) (points i) (fun z => G.kernel z r)
  have heq : greenJetSection g points ℓ G.kernel =ᶠ[𝓝 (y : M)] (L ∘ J) := by
    filter_upwards [(finite_range points).isClosed.isOpen_compl.mem_nhds hyP] with r hr
    have hread (i : ι) :
        nativeChartJetLinearMap g (points i) (secondJet g (fun z => G.kernel z r) (points i)) =
