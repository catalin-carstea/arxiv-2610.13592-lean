  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_native_interior_partialDiffeomorph
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁} {T₀ : Set M₂}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (B : OpenScaledExtension
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) => D.symm.solver₁.solve g.val)
      (fun g : BoundaryDatum (observedPatch (n := n) V₂) =>
        D.symm.solver₂.solve (g.val ∘ D.symm.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₂) ((𝓡∂ (n + 1)).interior M₁) T₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
    (hB : (B.domain : Set M₂) = (𝓡∂ (n + 1)).interior M₂) :
    ∃ F : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω,
      F.source = (𝓡∂ (n + 1)).interior M₁ ∧ F.target = (𝓡∂ (n + 1)).interior M₂ ∧
      (F : M₁ → M₂) = A.map ∧
      ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω A.multiplier ((𝓡∂ (n + 1)).interior M₁) := by
  have hinverse := native_global_candidates_are_inverse hSchauder hRunge₁ hRunge₂ hn hcompact₁ hcompact₂
    hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D A B hA hB
  obtain ⟨F, hFs, hFt, hFmap, hc⟩ := exists_native_scaled_partialDiffeomorph hSchauder hRunge₁ hRunge₂
    hReg₁ hReg₂ hn hcompact₁ hcompact₂ hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D
    A.domain A.inside A.map A.multiplier A.continuous A.image (fun z hz => (A.positive z hz).ne') A.solutions
  have htarget : F.target = (𝓡∂ (n + 1)).interior M₂ := by
    rw [hFt]
    apply Subset.antisymm
    · rintro z ⟨a, ha, rfl⟩
      exact A.image ha
    · intro z hz
      refine ⟨B.map z, ?_, (hinverse.2 z hz).1⟩
      rw [hA]
      exact B.image (by change z ∈ (B.domain : Set M₂); rw [hB]; exact hz)
  exact ⟨F, hFs.trans hA, htarget, hFmap, by simpa only [hA] using hc⟩
end ConformalPoisson

