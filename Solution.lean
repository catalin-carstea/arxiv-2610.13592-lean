noncomputable section ProofPart_InteriorAnalytic_HolderJetEvaluation


/- A bounded operator can act on all three actual Holder jet fields,
without imposing zero trace on a fixed inhomogeneous boundary value.  The
canonical ball graph has a bounded reading into these fields. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F

local instance : NormedAddCommGroup ((V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := V →L[ℝ] V →L[ℝ] ℝ) (F := V →L[ℝ] ℝ)
local instance : NormedAddCommGroup (V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := V) (F := (V →L[ℝ] ℝ) →L[ℝ] ℝ)

abbrev HolderJet (α : ℝ≥0) (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] :=
  TauCeti.HolderSpace α (closedBall (0 : E) 1) ℝ ×
    TauCeti.HolderSpace α (closedBall (0 : E) 1) (E →L[ℝ] ℝ) ×
    TauCeti.HolderSpace α (closedBall (0 : E) 1) (E →L[ℝ] E →L[ℝ] ℝ)

local notation "J" => HolderJet α V

def ballHolderJetL (hα : α ≤ 1) : BallSpace α V ℝ →L[ℝ] J :=
  (ballValueHolderL hα).prod ((ballFirstHolderL hα).prod ballSecondHolderL)

def holderJetHessian (v w : H V) : J →L[ℝ] H ℝ :=
  ((ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂ w).comp
    (((ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) :
      V →L[ℝ] (V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ).compHolder₂
        (E := V) (F := V →L[ℝ] V →L[ℝ] ℝ) (G := V →L[ℝ] ℝ) v).comp
        ((ContinuousLinearMap.snd ℝ (H (V →L[ℝ] ℝ)) (H (V →L[ℝ] V →L[ℝ] ℝ))).comp
          (ContinuousLinearMap.snd ℝ (H ℝ)
            ((H (V →L[ℝ] ℝ)) × (H (V →L[ℝ] V →L[ℝ] ℝ))))))

def holderJetGradient (v : H V) : J →L[ℝ] H ℝ :=
  ((ContinuousLinearMap.apply ℝ ℝ : V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂ v).comp
    ((ContinuousLinearMap.fst ℝ (H (V →L[ℝ] ℝ)) (H (V →L[ℝ] V →L[ℝ] ℝ))).comp
      (ContinuousLinearMap.snd ℝ (H ℝ)
        ((H (V →L[ℝ] ℝ)) × (H (V →L[ℝ] V →L[ℝ] ℝ)))))

def holderJetPotential (q : H ℝ) : J →L[ℝ] H ℝ :=
  ((ContinuousLinearMap.mul ℝ ℝ).compHolder₂ q).comp
    (ContinuousLinearMap.fst ℝ (H ℝ)
      ((H (V →L[ℝ] ℝ)) × (H (V →L[ℝ] V →L[ℝ] ℝ))))

without_proof_info in
@[simp] theorem holderJetHessian_apply (v w : H V) (j : J) (x : closedBall (0 : V) 1) :
    holderJetHessian v w j x = j.2.2 x (v x) (w x) := by simp [holderJetHessian]

without_proof_info in
@[simp] theorem holderJetGradient_apply (v : H V) (j : J) (x : closedBall (0 : V) 1) :
    holderJetGradient v j x = j.2.1 x (v x) := by simp [holderJetGradient]

without_proof_info in
@[simp] theorem holderJetPotential_apply (q : H ℝ) (j : J) (x : closedBall (0 : V) 1) :
    holderJetPotential q j x = q x * j.1 x := by simp [holderJetPotential]

variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P] {p : P}

without_proof_info in
theorem analyticAt_holderJetHessian {v w : P → H V}
    (hv : AnalyticAt ℝ v p) (hw : AnalyticAt ℝ w p) :
    AnalyticAt ℝ (fun a => holderJetHessian (v a) (w a)) p := by
  unfold holderJetHessian
  let A : (H V) →L[ℝ] (H (V →L[ℝ] ℝ)) →L[ℝ] H ℝ := (ContinuousLinearMap.apply ℝ ℝ :
    V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂ (α := α) (X := closedBall (0 : V) 1)
  let B : (H V) →L[ℝ] (H (V →L[ℝ] V →L[ℝ] ℝ)) →L[ℝ] H (V →L[ℝ] ℝ) :=
    (ContinuousLinearMap.apply ℝ (V →L[ℝ] ℝ) :
    V →L[ℝ] (V →L[ℝ] V →L[ℝ] ℝ) →L[ℝ] V →L[ℝ] ℝ).compHolder₂
      (α := α) (X := closedBall (0 : V) 1)
  have hw' := (A.analyticAt _).comp hw
  have hv' := (B.analyticAt _).comp hv
  exact (hw'.contDiffAt.clm_comp
    (hv'.contDiffAt.clm_comp contDiffAt_const)).analyticAt

without_proof_info in
theorem analyticAt_holderJetGradient {v : P → H V} (hv : AnalyticAt ℝ v p) :
    AnalyticAt ℝ (fun a => holderJetGradient (v a)) p := by
  unfold holderJetGradient
  let A : (H V) →L[ℝ] (H (V →L[ℝ] ℝ)) →L[ℝ] H ℝ := (ContinuousLinearMap.apply ℝ ℝ :
    V →L[ℝ] (V →L[ℝ] ℝ) →L[ℝ] ℝ).compHolder₂ (α := α) (X := closedBall (0 : V) 1)
  exact (((A.analyticAt _).comp hv).contDiffAt.clm_comp contDiffAt_const).analyticAt

without_proof_info in
theorem analyticAt_holderJetPotential {q : P → H ℝ} (hq : AnalyticAt ℝ q p) :
    AnalyticAt ℝ (fun a => holderJetPotential (q a)) p := by
  unfold holderJetPotential
  let A : (H ℝ) →L[ℝ] (H ℝ) →L[ℝ] H ℝ :=
    (ContinuousLinearMap.mul ℝ ℝ).compHolder₂ (α := α) (X := closedBall (0 : V) 1)
  exact (((A.analyticAt _).comp hq).contDiffAt.clm_comp contDiffAt_const).analyticAt

end ConformalPoisson.DirichletHolder

end ProofPart_InteriorAnalytic_HolderJetEvaluation

