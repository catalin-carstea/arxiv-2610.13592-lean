    _ = ∫ x in (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V), F x * v.val x
        ∂riemannianVolume I M := by
      symm
      apply setIntegral_eq_integral_of_forall_compl_eq_zero
