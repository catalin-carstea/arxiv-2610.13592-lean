    simpa [affinePullback, T, LinearIsometryEquiv.coe_toContinuousLinearEquiv] using hy
  rw [coordinateSchrodinger_congr_germ _ _ _ heq, coordinateSchrodinger_smul]
  have h := coordinateSchrodinger_affinePullback T 0 A b q u x
