    (hw0 : Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω p)
    {S : Set P} (hS : IsOpen S) (hSΩ : S ⊆ Ω)
    (hSH : S ⊆ (normalHalfSpace (E := E) a : Set P)) (hη1 : EqOn η 1 S)
    (ε : ℝ) (hε : 0 < ε) :
    lpNorm (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)) p ((volume : Measure P).restrict S) ≤
      ε * (‖Wkp.iteratedGradient 1 u‖ +
        (2 * c₁ * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u)‖ + c₂ * ‖Wkp.value 2 u‖)) +
      (4 * (finrank ℝ P : ℝ) ^ 2 / ε) * ‖Wkp.value 2 u‖ := by
  let H := normalHalfSpace (E := E) a
  have hwK : ∀ᵐ x ∂(volume : Measure P).restrict Ω,
      x ∉ tsupport η → Wkp.value 2 w x = 0 := by
    filter_upwards [hw] with x hx hxK
    rw [hx, image_eq_zero_of_notMem_tsupport hxK, zero_mul]
  have hHK : (H : Set P) ∩ tsupport η ⊆ Ω := fun x hx =>
    ((hΩU.symm ▸ ⟨hx.1, hηU hx.2⟩ : x ∈ (Ω : Set P) ∩ U)).1
  obtain ⟨v, hv, _⟩ := exists_halfSpace_extension_le_components a hΩU hηc hηU w hw0 hwK
  let v₀ : Wkp (volume : Measure P) H p 2 := v
  have hD := Wkp.iteratedGradient_ae_eq_indicator_of_isClosed hηc.isClosed hHK 1 hwK hv
  have hDw : ‖Wkp.iteratedGradient 1 v₀‖ ≤ ‖Wkp.iteratedGradient 1 w‖ :=
    norm_lp_le_of_ae_eq_indicator _ _ hD
  have hvw : ‖Wkp.value 2 v₀‖ ≤ ‖Wkp.value 2 w‖ := norm_lp_le_of_ae_eq_indicator _ _ hv
  have hwu : ‖Wkp.value 2 w‖ ≤ ‖Wkp.value 2 u‖ := by
    refine Lp.norm_le_norm_of_ae_le ?_
    filter_upwards [hw] with x hx
    rw [hx, norm_mul, Real.norm_eq_abs]
    exact mul_le_of_le_one_left (norm_nonneg _) (habs x)
  have hw1 : Wkp.value 1 (Wkp.lowerOrder 1 w) =ᵐ[(volume : Measure P).restrict Ω]
      (fun x => η x * Wkp.value 1 (Wkp.lowerOrder 1 u) x) := by
    rw [← Wkp.value_succ, ← Wkp.value_succ]
    exact hw
  have hv1 : Wkp.value 1 (Wkp.lowerOrder 1 v₀) =ᵐ[(volume : Measure P).restrict H]
      (Ω : Set P).indicator (Wkp.value 1 (Wkp.lowerOrder 1 w)) := by
    rw [← Wkp.value_succ, ← Wkp.value_succ]
    exact hv
  have hwK1 : ∀ᵐ x ∂(volume : Measure P).restrict Ω,
      x ∉ tsupport η → Wkp.value 1 (Wkp.lowerOrder 1 w) x = 0 := by
    rw [← Wkp.value_succ]
    exact hwK
