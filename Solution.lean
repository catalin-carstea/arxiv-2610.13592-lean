      (fun p : V × Y => (c.symm p.1, p.2)) (W ×ˢ univ) :=
    (hcW.comp contMDiffOn_fst (fun p (hp : p ∈ W ×ˢ (univ : Set Y)) => hp.1)).prodMk
      contMDiffOn_snd
  have hcomp : ContMDiffOn (𝓘(ℝ, V).prod J) 𝓘(ℝ) ∞
      (fun p : V × Y => F (c.symm p.1) p.2) (W ×ˢ univ) :=
    hF.comp hmap
