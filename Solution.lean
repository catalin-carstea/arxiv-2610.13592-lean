      change (R - R / 2) ^ 2 * lpNorm (Wkp.iteratedGradient 1 u) p
        ((volume : Measure P).restrict Ωt) ≤ D * Z at hhalf
      nlinarith
    have hdiv := (le_div_iff₀ (sq_pos_of_pos hR)).mpr hnum
    convert hdiv using 1 <;> ring
  have hGread : (Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 uR) : P → P) =ᵐ[(volume : Measure P).restrict Ωt]
      Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 u) := by
    rw [show uR = Wkp.restrictL (inf_le_left : Ωt ≤ Ω) 2 u from rfl, Wkp.lowerOrder_restrictL]
    exact Wkp.iteratedGradient_restrictL_ae (inf_le_left : Ωt ≤ Ω) 0 (Wkp.lowerOrder 1 u)
  have hGn : ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 uR)‖ ≤ Cg * Z := by
    rw [Lp.norm_eq_lpNorm_of_ae_eq hGread]
    exact hgrad u hzero hH
  have hVn : ‖Wkp.value 2 uR‖ ≤ Z := by
    rw [Lp.norm_eq_lpNorm_of_ae_eq (Wkp.value_restrictL_ae (inf_le_left : Ωt ≤ Ω) 2 u)]
    exact halfBall_lpNorm_mono_radius (x₀ := x₀) (Wkp.value 2 u) (by linarith)
  have hvbound : ‖v‖ ≤ B₀ * Z := by
    have hcoeffG : 0 ≤ 1 + 2 * c₁ := by positivity
    have hcoeffV : 0 ≤ 1 + c₁ + c₂ := by positivity
    calc
      ‖v‖ ≤ lpNorm (fun x => η x • Wkp.iteratedGradient 1 uR x) p ((volume : Measure P).restrict Ωt) +
          (1 + 2 * c₁) * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 uR)‖ +
          (1 + c₁ + c₂) * ‖Wkp.value 2 uR‖ := hvnorm.trans hcomp
