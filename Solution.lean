without_proof_info in
theorem secondFDeriv_fderivWithin_slice_apply_comm {G : E → Y → F} {s : Set Y}
    {x : E} {y : Y}
    (hG : ContDiffWithinAt ℝ 3 (uncurry G) (univ ×ˢ s) (x, y))
