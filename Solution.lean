  have hAEU : (fun x => N x + boundaryPoissonSection ν G.kernel y x) =ᵐ[(nativeVolume g).restrict U] 0 :=
    (ae_restrict_iff' hU.measurableSet).mpr hAE
  have hZero := Measure.eqOn_open_of_ae_eq hAEU hU hD continuousOn_const
  intro x hx
  have hz := hZero hx
