noncomputable section ProofPart_GreenTrace_NativeInverseNormalEvaluation




/- Actual boundary-normal evaluation of the native inverse extends boundedly
to Lp, using the proved exact normal-trace estimate. -/
open Bundle Set MeasureTheory TauCeti
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

def nativeSmoothNormalLinearMap
    (ν : (y : (Ihalf).boundary M) → TangentSpace Ihalf (y : M))
    (y : (Ihalf).boundary M) : C^∞⟮Ihalf, M; ℝ⟯ →ₗ[ℝ] ℝ where
  toFun U := normalDerivative ν U y
  map_add' U V := by
    change mvfderiv Ihalf ((U : M → ℝ) + (V : M → ℝ)) (y : M) (ν y) = _
    rw [mvfderiv_add (U.contMDiff.mdifferentiable (by decide) y)
      (V.contMDiff.mdifferentiable (by decide) y)]
    rfl
  map_smul' a U := by
    change mvfderiv Ihalf (a • (U : M → ℝ)) (y : M) (ν y) = _
    rw [mvfderiv_const_smul_field]
    rfl

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_inverse_normal_functionals
    (hn : 1 ≤ n) {r : ℝ≥0} [Fact (1 ≤ (r : ℝ≥0∞))]
    (hr : (n + 1 : ℝ≥0) < r)
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (ν : (y : (Ihalf).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y)) :
    ∃ C ≥ 0, ∀ y : (Ihalf).boundary M,
      ∃ L : Lp ℝ (r : ℝ≥0∞) (nativeVolume g) →L[ℝ] ℝ,
        ‖L‖ ≤ C ∧ ∀ F : C^∞⟮Ihalf, M; ℝ⟯, ∀ u : M → ℝ,
          IsZeroDirichletSolution g q F u →
            L (nativeSmoothForcingToLp g r F) = normalDerivative ν u y := by
  obtain ⟨S⟩ := nonempty_zeroDirichletSolver g q hq hNR
  have hrReal : (n + 1 : ℝ) < (r : ℝ) := by exact_mod_cast hr
  obtain ⟨C, hbound⟩ := nativeNormalTraceInverseEstimate hn isCompact_univ g q hq hNR ν hν r hrReal
  refine ⟨C, C.coe_nonneg, fun y => ?_⟩
  let f := (nativeSmoothNormalLinearMap ν y).comp (S.smoothInverseLinearMap hNR)
  have hbd : ∀ F, ‖f F‖ ≤ (C : ℝ) * ‖nativeSmoothForcingToLp g r F‖ := by
    intro F
    change |normalDerivative ν (S.solve F) y| ≤ (C : ℝ) * ‖nativeSmoothForcingToLp g r F‖
    rw [norm_nativeSmoothForcingToLp]
    have h := hbound F (S.solve F) F.contMDiff (S.correct F F.contMDiff) y
    simpa only [ENNReal.ofReal_coe_nnreal] using h
  obtain ⟨L, hL, hLC⟩ := exists_functional_extension_of_reading_bound
    (nativeSmoothForcingToLp g (r : ℝ≥0∞)) f C.coe_nonneg hbd
  refine ⟨L, hLC, fun F u hu => ?_⟩
  rw [hL]
  change normalDerivative ν (S.solve F) y = normalDerivative ν u y
  rw [hNR.zeroDirichlet_solution_unique (S.correct F F.contMDiff) hu]

end ConformalPoisson

end ProofPart_GreenTrace_NativeInverseNormalEvaluation

