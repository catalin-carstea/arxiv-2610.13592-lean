integrand used in the classical-to-Sobolev localization. -/
open Set TauCeti.PDE
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin d)

without_proof_info in
theorem coordinatePrincipalMatrix_entry_contDiffOn {k : ℕ∞ω} {U : Set V}
    {a : V → V →L[ℝ] V} (ha : ContDiffOn ℝ k a U) (i j : Fin d) :
    ContDiffOn ℝ k (fun x => coordinatePrincipalMatrix (a x) i j) U := by
  exact (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin d => ℝ) j).contDiff.comp_contDiffOn
    (ha.clm_apply (contDiffOn_const (c := EuclideanSpace.single i 1)))

without_proof_info in
theorem coordinatePrincipalMatrix_continuousOn {U : Set V}
    {a : V → V →L[ℝ] V} (ha : ContinuousOn a U) :
    ContinuousOn (fun x => coordinatePrincipalMatrix (a x)) U := by
  apply continuousOn_pi.mpr
  intro i
  apply continuousOn_pi.mpr
  intro j
  exact (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin d => ℝ) j).continuous.comp_continuousOn
    (ha.clm_apply (continuousOn_const (c := EuclideanSpace.single i 1)))

without_proof_info in
theorem coordinate_energyIntegrand_continuousOn {U : Set V} (hU : IsOpen U)
    {a : V → V →L[ℝ] V} {b : V → V} {q : V → ℝ}
    (ha : ContDiffOn ℝ 1 a U) (hb : ContinuousOn b U) (hq : ContinuousOn q U) :
    ContinuousOn (fun x => energyIntegrand (coordinatePrincipalMatrix (a x))
      (b x + coordinateDivergenceDrift a x) (q x)) U :=
  (coordinatePrincipalMatrix_continuousOn ha.continuousOn).energyIntegrand
    (hb.add (coordinateDivergenceDrift_continuousOn hU ha)) hq

end ConformalPoisson

