without_proof_info in
theorem ordinaryJet_fderivWithin_comm {G : E → Y → ℝ} {s : Set Y}
    {x : E} {y : Y}
    (hG : ContDiffWithinAt ℝ ∞ (uncurry G) (univ ×ˢ s) (x, y))
    (hs : UniqueDiffOn ℝ s) (hy : y ∈ s) (hycl : y ∈ closure (interior s)) (v : Y) :
    fderivWithin ℝ (fun z => ordinaryJet (G x z)
      (fderiv ℝ (fun a => G a z) x) (fderiv ℝ (fderiv ℝ (fun a => G a z)) x)) s y v =
    ordinaryJet (fderivWithin ℝ (G x) s y v)
      (fderiv ℝ (fun a => fderivWithin ℝ (G a) s y v) x)
      (fderiv ℝ (fderiv ℝ (fun a => fderivWithin ℝ (G a) s y v)) x) := by
  letI : Module ℝ (ℝ × (E →L[ℝ] ℝ) × (E →L[ℝ] E →L[ℝ] ℝ)) := inferInstance
  have h0 : ContDiffWithinAt ℝ ∞ (G x) s y :=
    hG.comp y (contDiffWithinAt_const.prodMk contDiffWithinAt_id)
      (fun z hz => ⟨mem_univ _, hz⟩)
  have hD := contDiffWithinAt_joint_fderiv_fst hG hy (m := ∞) (by simp)
  have hDD := contDiffWithinAt_joint_fderiv_fst
    (G := fun a z => fderiv ℝ (fun b => G b z) a) hD hy (m := ∞) (by simp)
  have h1 : ContDiffWithinAt ℝ ∞ (fun z => fderiv ℝ (fun a => G a z) x) s y :=
    hD.comp y (contDiffWithinAt_const.prodMk contDiffWithinAt_id)
      (fun z hz => ⟨mem_univ _, hz⟩)
