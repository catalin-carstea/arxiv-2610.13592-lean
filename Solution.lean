theorem NativeInverseNormalLpRowFamily.chart_homogeneous_test_identity
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseNormalLpRowFamily g q ν s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
