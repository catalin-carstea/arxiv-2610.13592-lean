noncomputable section ProofPart_InteriorAnalytic_RealLocalizedHolderCoefficients




/- Actual real analytic coefficients, with the original real spatial ball.
The complex extension is obtained from the pinned neighborhood theorem and
then read back at real translations.  No complexification is a new premise.
-/
open Set Metric Filter Topology
open scoped BoundedContinuousFunction NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [ProperSpace V] {d : ℕ}

without_proof_info in
theorem exists_real_analytic_localized_holder_family {α : ℝ≥0} (hα : α ≤ 1)
    (T : V ≃L[ℝ] (Fin d → ℝ)) (f χ : V → ℝ) (hχ : ContDiff ℝ 1 χ)
    {W : Set V} (hW : IsOpen W) (hKW : closedBall (0 : V) 1 ⊆ W)
    (hf : AnalyticOnNhd ℝ f W) :
    ∃ (U : Set V) (H : V → TauCeti.HolderSpace α (closedBall (0 : V) 1) ℝ),
      IsOpen U ∧ (0 : V) ∈ U ∧ AnalyticOnNhd ℝ H U ∧
        ∀ a ∈ U, ∀ x : closedBall (0 : V) 1, H a x = f (x + χ x • a) := by
  let K := closedBall (0 : V) 1
  let Wr : Set (Fin d → ℝ) := T.symm ⁻¹' W
  have hWr : IsOpen Wr := hW.preimage T.symm.continuous
  have hfr : AnalyticOnNhd ℝ (fun y => f (T.symm y)) Wr := by
    intro y hy
    exact (hf _ hy).comp (T.symm.analyticAt y)
  obtain ⟨Wc, hWc, hreal, hstar, F, hF, hFreal, hFstar⟩ :=
    hfr.exists_complexification hWr
  let ι : V →L[ℝ] (Fin d → ℂ) := ofRealPiL.comp T.toContinuousLinearMap
  have hFi (x : K) : AnalyticAt ℂ F (ι x) := by
    apply hF
    apply (hreal (T x)).2
    change T.symm (T x) ∈ W
    simpa only [T.symm_apply_apply] using hKW x.property
  obtain ⟨Uc, Hc, hUc, h0c, hHc, hHceq⟩ :=
    exists_analytic_localized_holder_family hα ι F χ hχ hFi
  have hnear : ∀ᶠ a in 𝓝 (0 : V), ∀ x : K, (x : V) + χ x • a ∈ W := by
    have h := isCompact_univ.eventually_forall_of_forall_eventually
      (x₀ := (0 : V)) (P := fun a (x : K) => (x : V) + χ x • a ∈ W)
      fun x (_ : x ∈ (univ : Set K)) =>
        ((continuous_subtype_val.comp continuous_snd).add
          ((hχ.continuous.comp (continuous_subtype_val.comp continuous_snd)).smul
            continuous_fst)).continuousAt.eventually
          (by simpa using hW.mem_nhds (hKW x.property))
    simpa only [mem_univ, forall_true_left] using h
  have hpre : ∀ᶠ a in 𝓝 (0 : V), ι a ∈ Uc := by
    apply ι.continuous.continuousAt.eventually
    change Uc ∈ 𝓝 (ι 0)
    simpa only [map_zero] using hUc.mem_nhds h0c
  obtain ⟨U, hU, hUopen, h0⟩ := _root_.eventually_nhds_iff.1 (hpre.and hnear)
  let R : TauCeti.HolderSpace α K ℂ →L[ℝ] TauCeti.HolderSpace α K ℝ :=
    TauCeti.HolderSpace.compLeftL Complex.reCLM
  let H : V → TauCeti.HolderSpace α K ℝ := fun a => R (Hc (ι a))
  refine ⟨U, H, hUopen, h0, ?_, ?_⟩
  · intro a ha
    have hcomp : AnalyticAt ℝ (fun b => Hc (ι b)) a :=
      (hHc _ (hU a ha).1).comp (ι.analyticAt a)
    exact (R.analyticAt _).comp hcomp
  · intro a ha x
    change (R (Hc (ι a))) x = _
    rw [TauCeti.HolderSpace.compLeftL_apply, hHceq _ (hU a ha).1]
    have hpoint : ι x + χ x • ι a = ι ((x : V) + χ x • a) := by
      simp only [map_add, map_smul]
    rw [hpoint]
    change (F (fun j => (T ((x : V) + χ x • a) j : ℂ))).re = _
    rw [hFreal _ (by
      change T.symm (T ((x : V) + χ x • a)) ∈ W
      simpa only [T.symm_apply_apply] using (hU a ha).2 x)]
    simp only [Complex.ofReal_re, T.symm_apply_apply]

end ConformalPoisson

end ProofPart_InteriorAnalytic_RealLocalizedHolderCoefficients

