    simpa only [List.length_append, List.length_map, vs] using hparts.length_eq
  have hvsP : ∀ v ∈ vs, boundaryTangentialProjection v = v := by
    intro v hv
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hv
    apply boundaryTangentialProjection_eq_self
    have hi0 := ht0 i hi
    simp [b, hi0, Ne.symm hi0]
