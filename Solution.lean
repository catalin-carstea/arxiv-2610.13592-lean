/- Finite-pole deletion is performed in the actual interior. No boundaryless
structure is installed on the original manifold. Tau Ceti supplies the local
punctured-ball and closed discrete deletion theorems. -/

open Set Topology TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

/-- Restrict the extended chart to the interior of its target. -/
def interiorExtendedChart (x : M) :
    OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin (n + 1))) where
  toPartialEquiv := ((extChartAt (𝓡∂ (n + 1)) x).symm.restr
    (interior (extChartAt (𝓡∂ (n + 1)) x).target)).symm
  open_source := (continuousOn_extChartAt x).isOpen_inter_preimage
    (isOpen_extChartAt_source x) isOpen_interior
  open_target := by
    change IsOpen ((extChartAt (𝓡∂ (n + 1)) x).target ∩
      interior (extChartAt (𝓡∂ (n + 1)) x).target)
    rw [inter_eq_right.mpr interior_subset]
    exact isOpen_interior
  continuousOn_toFun := (continuousOn_extChartAt x).mono inter_subset_left
  continuousOn_invFun := (continuousOn_extChartAt_symm x).mono inter_subset_left

without_proof_info in
theorem mem_interiorExtendedChart_source {x : M}
    (hx : x ∈ (𝓡∂ (n + 1)).interior M) : x ∈ (interiorExtendedChart (n := n) x).source := by
  exact ⟨mem_extChartAt_source x, ModelWithCorners.isInteriorPoint_iff.mp hx⟩

without_proof_info in
theorem isPreconnected_interior_open_diff_finite [T2Space M]
    (hdim : 2 ≤ n) {U P : Set M} (hU : IsOpen U) (hc : IsPreconnected U)
    (hi : U ⊆ (𝓡∂ (n + 1)).interior M) (hP : P.Finite) :
    IsPreconnected (U \ P) := by
  let V : TopologicalSpace.Opens M := ⟨U, hU⟩
  letI : PreconnectedSpace V := isPreconnected_iff_preconnectedSpace.mp hc
  have hdim' : 1 < Module.rank ℝ (EuclideanSpace ℝ (Fin (n + 1))) := by
    rw [← Module.finrank_eq_rank]
    simp only [finrank_euclideanSpace, Fintype.card_fin]
    exact_mod_cast (show 1 < n + 1 by omega)
  have hpre : (Subtype.val ⁻¹' P : Set V).Finite := hP.preimage Subtype.val_injective.injOn
  have hdelete : IsPreconnected (Subtype.val ⁻¹' P : Set V)ᶜ := by
    refine TauCeti.isPreconnected_compl_of_isDiscrete hpre.isClosed hpre.isDiscrete ?_
    intro x _ W hW
    let e := (interiorExtendedChart (n := n) (x : M)).subtypeRestr (s := V) ⟨x⟩
    have hx : x ∈ e.source := by
      simpa only [e, OpenPartialHomeomorph.subtypeRestr_source, mem_preimage] using
        (mem_interiorExtendedChart_source (n := n) (hi x.property))
    exact TauCeti.exists_mem_nhds_subset_isConnected_sdiff_singleton_of_mem_source
      hdim' e hx hW
  have himage : Subtype.val '' (Subtype.val ⁻¹' P : Set V)ᶜ = U \ P := by
    rw [image_compl_preimage, Subtype.range_val]
    rfl
  rw [← himage]
  exact hdelete.image _ continuous_subtype_val.continuousOn

without_proof_info in
theorem nativeInterior_diff_finite_isPreconnected [T2Space M]
    (hdim : 2 ≤ n) (hc : IsPreconnected ((𝓡∂ (n + 1)).interior M))
    {P : Set M} (hP : P.Finite) :
    IsPreconnected ((𝓡∂ (n + 1)).interior M \ P) :=
  isPreconnected_interior_open_diff_finite hdim
    ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)) hc subset_rfl hP

end ConformalPoisson

