theorem conjugatedTaylor_profile {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) (M k : ℕ) {P : Y → ℂ[X]} (hP : CoeffContDiffOn P U)
    (hD : ∀ y ∈ U, (P y).natDegree ≤ 2 * k) {y : Y} (hy : y ∈ U) (h s : ℝ) :
