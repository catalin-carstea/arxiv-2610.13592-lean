  apply ContinuousLinearMap.isInvertible_iff_bijective.mpr
  constructor
  · intro v w hvw
    apply ambientPartialDiffeomorph_fderiv_injective A.chart z.property
    rw [← R.normalCoordinateMap_mfderiv A z v, ← R.normalCoordinateMap_mfderiv A z w]
    exact hvw
  · intro w
    obtain ⟨v, hv⟩ := ambientPartialDiffeomorph_fderiv_surjective A.chart z.property (show V from w)
