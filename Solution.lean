    (contMDiff_native_unitNormal g ν hν)
  have heq : normalDerivative ν u =
      (fun y : (Ihalf).boundary M => mvfderiv Ihalf u (y : M) (ν y)) := rfl
  rw [heq]
  exact h
end ConformalPoisson

