    (mul_nonneg (capGradientBound_nonneg c hr S) (norm_nonneg (y - x)))
  intro u
  have h := Convex.norm_image_sub_le_of_norm_hasFDerivWithin_le
    (fun z hz => capEvaluation_hasFDerivWithinAt c hr S u hz)
    (fun z hz => capGradient_norm_le c hr S u hz) hconv hx hy
  simpa only [ContinuousLinearMap.sub_apply, mul_assoc, mul_comm, mul_left_comm] using h

without_proof_info in
theorem capEvaluation_lipschitzOn (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) :
    LipschitzOnWith ⟨capGradientBound c hr S, capGradientBound_nonneg c hr S⟩
      (capEvaluation c hr S) (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) := by
  apply LipschitzOnWith.of_dist_le_mul
  intro x hx y hy
  rw [dist_eq_norm, dist_eq_norm]
  change ‖capEvaluation c hr S x - capEvaluation c hr S y‖ ≤ capGradientBound c hr S * ‖x - y‖
  exact capEvaluation_norm_sub_le c hr S hy hx

without_proof_info in
theorem capEvaluation_continuousOn (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) :
    ContinuousOn (capEvaluation c hr S) (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) :=
  (capEvaluation_lipschitzOn c hr S).continuousOn

end AllOrderSobolevReading
end ConformalPoisson

