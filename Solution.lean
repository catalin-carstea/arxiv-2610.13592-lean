/- The bounded ball inverse is equivalent to genuine C2-alpha
Dirichlet existence. Uniqueness is proved by the maximum principle;
the Banach inverse theorem supplies the bound before variable
coefficients or forcing are chosen. Surjectivity itself remains open. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {d : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin d)
local notation "H" => TauCeti.HolderSpace α (closedBall (0 : V) 1) ℝ
local notation "B" => BallSpace α V ℝ

without_proof_info in
/-- Genuine surjectivity of the actual bounded Laplacian on the complete
zero-boundary derivative graph yields its bounded linear right inverse. -/
theorem exists_ballLaplacian_inverse_of_surjective (hd : 0 < d) (hα : α ≤ 1)
    (hsurj : Function.Surjective (ballLaplacian (d := d) hα)) :
    ∃ T : H →L[ℝ] B, ∀ f : H, ballLaplacian hα (T f) = f := by
  let L := ballLaplacian (d := d) hα
  have hker : L.toLinearMap.ker = ⊥ := LinearMap.ker_eq_bot.mpr (ballLaplacian_injective hd hα)
  have hrange : L.toLinearMap.range = ⊤ := LinearMap.range_eq_top.mpr hsurj
  let e := ContinuousLinearEquiv.ofBijective L hker hrange
  refine ⟨e.symm.toContinuousLinearMap, ?_⟩
  intro f
  exact ContinuousLinearEquiv.ofBijective_apply_symm_apply L hker hrange f

without_proof_info in
theorem ballLaplacian_surjective_iff_has_bounded_inverse (hd : 0 < d) (hα : α ≤ 1) :
    Function.Surjective (ballLaplacian (d := d) hα) ↔
      ∃ T : H →L[ℝ] B, ∀ f : H, ballLaplacian hα (T f) = f := by
  refine ⟨exists_ballLaplacian_inverse_of_surjective hd hα, ?_⟩
  rintro ⟨T, hT⟩ f
  exact ⟨T f, hT f⟩

without_proof_info in
/-- The uniform small-perturbation Schauder input now needs only genuine
C2-alpha Dirichlet existence on the ball. The boundedness and uniqueness
of its inverse do not remain as separate unproved obligations. -/
theorem localSchauder_of_ballLaplacian_surjective (hd : 0 < d)
    (honto : ∀ β : ℝ≥0, 0 < β → ∀ hβ : β < 1,
      Function.Surjective (ballLaplacian (d := d) hβ.le)) :
    LocalSchauderDirichletAssumption d := by
  apply localSchauder_of_ball_laplacian_inverse
  intro β hβ hβlt
  exact exists_ballLaplacian_inverse_of_surjective hd hβlt.le (honto β hβ hβlt)
