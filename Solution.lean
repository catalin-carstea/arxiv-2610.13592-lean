  rw [heq.mvfderiv_eq]
  convert hmix using 1 <;>
    simp only [J, chartOrdinarySecondJet, hround, Function.comp_def, normalDerivative]

without_proof_info in
theorem DirichletGreenKernel.greenJetSection_normal_eq_poisson_jets
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace K (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {ι : Type*} [Fintype ι] (points : ι → M)
    (hpoints : ∀ i, points i ∈ (𝓡∂ (n + 1)).interior M)
    (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
