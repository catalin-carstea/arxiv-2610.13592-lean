variable [CompactSpace M₂] [MeasurableSpace M₂] [BorelSpace M₂]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₂)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₂)]

local instance closureContinuationBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M₂) :=
  compactSpace_nativeBoundary

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem native_local_extension_at_closure
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hBoundaryReg₂ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₂))
    (hGreen₂ : GreenKernelAssumption (n := n) (M := M₂))
    (hInverse₂ : ForwardInhomogeneousAssumption (n := n) (M := M₂))
    (hEstimate₂ : NormalTraceInverseEstimateAssumption (n := n) (M := M₂))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (hx : x ∈ (𝓡∂ (n + 1)).interior M₁)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hclosure : x ∈ closure (A.domain : Set M₁)) :
    ∃ B : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀, x ∈ B.domain := by
  obtain ⟨a, ha, hax, y, p, hp, hpy⟩ := exists_compact_native_image_subsequence (n := n)
    hcompact₁ isCompact_univ hclosure A.map
  let xs : ℕ → M₁ := fun k => a (p k)
  have hxs : Tendsto xs atTop (𝓝 x) := hax.comp hp.tendsto_atTop
  have hs : ∀ k, xs k ∈ A.domain := fun k => ha (p k)
  have hys : Tendsto (A.map ∘ xs) atTop (𝓝 y) := hpy
  obtain ⟨F, hFs, _, hFmap, _⟩ := exists_native_scaled_partialDiffeomorph hSchauder hRunge₁ hRunge₂
    hReg₁ hReg₂ hn hcompact₁ isCompact_univ hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D
    A.domain A.inside A.map A.multiplier A.continuous A.image (fun z hz => (A.positive z hz).ne') A.solutions
  have hsource : IsPreconnected F.source := by simpa only [hFs] using A.connected.isPreconnected
  have hFI : F.source ⊆ (𝓡∂ (n + 1)).interior M₁ := by rw [hFs]; exact A.inside
  have htarget : ∀ z ∈ F.source, F z ∈ (𝓡∂ (n + 1)).interior M₂ := by
    intro z hz
    rw [hFmap]
    exact A.image (by simpa only [hFs] using hz)
  have hpos : ∀ z ∈ F.source, 0 < A.multiplier z := by
    intro z hz
    exact A.positive z (by rw [hFs] at hz; exact hz)
  have hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ F.source,
      D.solver₁.solve f.val z = A.multiplier z * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (F z) := by
    intro f z hz
    rw [hFmap]
    exact A.solutions f z (by rw [hFs] at hz; exact hz)
  have hsF : ∀ k, xs k ∈ F.source := by
    intro k
    rw [hFs]
    exact hs k
  have hysF : Tendsto (F ∘ xs) atTop (𝓝 y) := by simpa only [hFmap] using hys
  have hy := native_scaled_relation_limit_isInterior hSchauder hRunge₁ hReg₁ hBoundaryReg₂ hGreen₂
    hInverse₂ hEstimate₂ hRunge₂ hReg₂ hn hcompact₁ hconnected₁ hconnected₂
    A₁ A₂ V₁ V₂ D x hx F hsource hFI htarget A.multiplier hpos hrel hxs hsF hysF
  exact native_local_extension_of_interior_limit hSchauder hRunge₁ hRunge₂ hReg₁ hReg₂ hn
    hcompact₁ isCompact_univ hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D x hx y hy A hxs hs hys
end ConformalPoisson

