noncomputable section ProofPart_BoundaryDerivativeAssembly



/- Assemble smooth scalar representatives of the directional weak
derivatives into the Fréchet derivative through a convex boundary. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}
  {ι : Type*} [Fintype ι]

without_proof_info in
theorem contDiffOn_closure_of_directional_representatives
    (b : OrthonormalBasis ι ℝ E) (hconv : Convex ℝ (Ω : Set E))
    (huniq : UniqueDiffOn ℝ (closure (Ω : Set E)))
    (u : W1p μ Ω 2) {f : E → ℝ} (hf : ContinuousOn f (closure (Ω : Set E)))
    (huf : W1p.value u =ᵐ[μ.restrict Ω] f) (k : ℕ)
    (g : ι → E → ℝ) (hg : ∀ i, ContDiffOn ℝ k (g i) (closure (Ω : Set E)))
    (hgr : ∀ i, g i =ᵐ[μ.restrict Ω] fun x => ⟪W1p.gradient u x, b i⟫_ℝ) :
    ContDiffOn ℝ (k + 1) f (closure (Ω : Set E)) := by
  classical
  let G := fun x => ∑ i, g i x • innerSL ℝ (b i)
  have hGb : ∀ x i, G x (b i) = g i x := by
    intro x i
    simp [G, innerSL_apply_apply, OrthonormalBasis.inner_eq_ite]
  have hG : ContDiffOn ℝ k G (closure (Ω : Set E)) :=
    ContDiffOn.sum fun i _ => (hg i).smul contDiffOn_const
  have hw : HasWeakFDerivOn μ Ω (W1p.value u) G :=
    b.toBasis.hasWeakFDerivOn_of_forall (W1p.hasWeakFDerivOn u).locallyIntegrableOn (by
      intro i
      refine ((W1p.hasWeakFDerivOn u).hasWeakLineDerivOn (b i)).congr_ae_deriv ?_
      filter_upwards [hgr i] with x hx
      change innerSL ℝ (W1p.gradient u x) (b i) = G x (b i)
      rw [hGb, hx, innerSL_apply_apply])
  exact contDiffOn_closure_of_weak_derivative hconv huniq hw hf huf k hG
end ConformalPoisson

end ProofPart_BoundaryDerivativeAssembly

/- Proof support: BoundarySmoothRepresentative.lean, SHA256 f385f1efbd902640f94a12b19bd1f95b500eb7d8385772f9b2acb7d40b0debff -/
noncomputable section ProofPart_BoundarySmoothRepresentative




/- Smooth representatives on the closure of convex boundary caps.
All local Hk estimates supply smooth representatives of the weak first
derivatives by induction; their continuous boundary limits determine
the Fréchet derivative within the closure. -/
open Module Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {Ω U D : Opens (EuclideanSpace ℝ (Fin (n + 1)))} {f : EuclideanSpace ℝ (Fin (n + 1)) → ℝ}
local notation "X" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 500000 in
without_proof_info in
theorem HasLocalBoundarySobolev.exists_contDiffOn_closure
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hAll : HasLocalBoundarySobolev μ Ω U 2 f)
    (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U)
    (hconv : Convex ℝ ((Ω ⊓ D : Opens X) : Set X))
    (huniq : UniqueDiffOn ℝ (closure ((Ω ⊓ D : Opens X) : Set X))) (k : ℕ) :
    ∃ g : X → ℝ, Continuous g ∧ ContDiffOn ℝ k g (closure ((Ω ⊓ D : Opens X) : Set X)) ∧
      g =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] f := by
  classical
  induction k generalizing Ω U D f with
  | zero =>
    obtain ⟨g, hg, hgf⟩ := hAll.exists_continuous_representative hΩH hHU hD hDU
    exact ⟨g, hg, contDiffOn_zero.2 hg.continuousOn, hgf⟩
  | succ k ih =>
    obtain ⟨g, hg, hgf⟩ := hAll.exists_continuous_representative hΩH hHU hD hDU
    obtain ⟨Wset, hWopen, hDW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hD U.isOpen hDU
    let W : Opens X := ⟨Wset, hWopen⟩
    have hW_U : W ≤ U := subset_closure.trans hWU
    have hD_W : D ≤ W := subset_closure.trans hDW
    have hEq : (Ω ⊓ W) ⊓ D = Ω ⊓ D := by rw [inf_assoc, inf_eq_right.mpr hD_W]
    have hsub : Ω ⊓ D ≤ Ω ⊓ W := inf_le_inf le_rfl hD_W
    obtain ⟨Z, hZ⟩ := hAll W hWc hWU 0
    let R := Wkp.firstOrder 1 Z
    have hRv : W1p.value R =ᵐ[μ.restrict (Ω ⊓ W : Opens X)] f := by
      rw [Wkp.value_firstOrder]
      exact hZ
    let RD := W1p.restrictL hsub R
    have hRDf : W1p.value RD =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] f :=
      (W1p.value_restrictL_ae hsub R).trans
        (ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hsub) hRv)
    have hΩWH : Ω ⊓ W ≤ euclideanOpenHalfSpace n 0 := (inf_le_left : Ω ⊓ W ≤ Ω).trans hΩH
    have hHW : (euclideanOpenHalfSpace n 0 : Set X) ∩ W ⊆ (Ω ⊓ W : Opens X) := fun x hx =>
      ⟨hHU ⟨hx.1, hW_U hx.2⟩, hx.2⟩
    have hAllW := hAll.restrict hW_U
    let b := EuclideanSpace.basisFun (Fin (n + 1)) ℝ
    have hderivatives : ∀ i, ∃ gi : X → ℝ,
        ContDiffOn ℝ k gi (closure ((Ω ⊓ D : Opens X) : Set X)) ∧
        gi =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] fun x => ⟪W1p.gradient RD x, b i⟫_ℝ := by
      intro i
      have hAllG := hAllW.directional R hRv (b i)
      have hconvW : Convex ℝ (((Ω ⊓ W) ⊓ D : Opens X) : Set X) := by rwa [hEq]
      have huniqW : UniqueDiffOn ℝ (closure (((Ω ⊓ W) ⊓ D : Opens X) : Set X)) := by rwa [hEq]
      obtain ⟨gi, _, hgi, hgir⟩ := ih hΩWH hHW hAllG hD hDW hconvW huniqW
      rw [hEq] at hgi hgir
      refine ⟨gi, hgi, ?_⟩
      filter_upwards [hgir, W1p.gradient_restrictL_ae hsub R] with x h₁ h₂
      rw [h₁, h₂]
    choose gi hgi hgir using hderivatives
    refine ⟨g, hg, ?_, hgf⟩
    exact contDiffOn_closure_of_directional_representatives b hconv huniq RD hg.continuousOn
      (hRDf.trans hgf.symm) k gi hgi hgir

without_proof_info in
theorem HasLocalBoundarySobolev.exists_smoothOn_closure
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hAll : HasLocalBoundarySobolev μ Ω U 2 f)
    (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U)
    (hconv : Convex ℝ ((Ω ⊓ D : Opens X) : Set X))
    (huniq : UniqueDiffOn ℝ (closure ((Ω ⊓ D : Opens X) : Set X))) :
    ∃ g : X → ℝ, Continuous g ∧ ContDiffOn ℝ ∞ g (closure ((Ω ⊓ D : Opens X) : Set X)) ∧
      g =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] f := by
  obtain ⟨g, hg, hgf⟩ := hAll.exists_continuous_representative hΩH hHU hD hDU
  refine ⟨g, hg, contDiffOn_infty.2 (fun k => ?_), hgf⟩
  obtain ⟨gk, hgk, hkg, hkf⟩ := hAll.exists_contDiffOn_closure hΩH hHU hD hDU hconv huniq k
  have heq : EqOn gk g (Ω ⊓ D : Opens X) :=
    Measure.eqOn_open_of_ae_eq (hkf.trans hgf.symm) (Ω ⊓ D).isOpen hgk.continuousOn hg.continuousOn
  exact hkg.congr (heq.closure hgk hg).symm
end ConformalPoisson

end ProofPart_BoundarySmoothRepresentative

