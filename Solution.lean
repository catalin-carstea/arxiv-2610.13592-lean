without_proof_info in
/-- Inverse metric entries are continuous through the relative boundary
of an actual chart. -/
theorem continuousOn_chartInvGram_target (c : M) (i j : Fin (Module.finrank ℝ V)) :
    ContinuousOn (fun z => chartInvGramMatrix (I := I) c ((extChartAt I c).symm z) i j)
      (extChartAt I c).target := by
  have hn : ContinuousOn (fun x => chartInvGramMatrix (I := I) c x i j) (extChartAt I c).source := by
    simpa only [TangentBundle.trivializationAt_baseSet, extChartAt_source] using
      (contMDiffOn_chartInvGramMatrix_entry (I := I) (n := 0) c i j).continuousOn
  exact hn.comp (continuousOn_extChartAt_symm c) (fun z hz => (extChartAt I c).map_target hz)

without_proof_info in
theorem continuousOn_chartDensity_target (c : M) :
    ContinuousOn (fun z => chartVolumeDensity (I := I) c ((extChartAt I c).symm z))
      (extChartAt I c).target := by
  have hn : ContinuousOn (chartVolumeDensity (I := I) c) (extChartAt I c).source := by
    simpa only [TangentBundle.trivializationAt_baseSet, extChartAt_source] using
      (contMDiffOn_chartVolumeDensity (I := I) (n := 0) c).continuousOn
  exact hn.comp (continuousOn_extChartAt_symm c) (fun z hz => (extChartAt I c).map_target hz)

without_proof_info in
theorem continuousOn_chartPrincipal_target (c : M) :
    ContinuousOn (chartPrincipalCoefficient (I := I) c) (extChartAt I c).target := by
  unfold chartPrincipalCoefficient inverseMetricOperator
  apply continuousOn_finsetSum
  intro i hi
  apply continuousOn_finsetSum
  intro j hj
  exact (continuousOn_chartInvGram_target c i j).smul continuousOn_const

without_proof_info in
theorem continuousOn_chartWeightedPrincipal_target (c : M) :
    ContinuousOn (chartWeightedPrincipal (I := I) c) (extChartAt I c).target :=
  coordinatePrincipalMatrix_continuousOn
    ((continuousOn_chartDensity_target c).smul (continuousOn_chartPrincipal_target c))

without_proof_info in
theorem continuousOn_chartWeightedPotential_target (c : M) {q : M → ℝ} (hq : Continuous q) :
    ContinuousOn (chartWeightedPotential (I := I) c q) (extChartAt I c).target :=
  (continuousOn_chartDensity_target c).mul (hq.comp_continuousOn (continuousOn_extChartAt_symm c))

without_proof_info in
/-- The full canonical energy bilinear field is continuous up to the
relative boundary of the chart target. -/
theorem continuousOn_chartWeightedEnergy_target (c : M) {q : M → ℝ} (hq : Continuous q) :
    ContinuousOn (fun z => energyIntegrand (chartWeightedPrincipal (I := I) c z) 0
      (chartWeightedPotential (I := I) c q z)) (extChartAt I c).target :=
  (continuousOn_chartWeightedPrincipal_target c).energyIntegrand continuousOn_const
    (continuousOn_chartWeightedPotential_target c hq)
section SmoothBoundaryTarget
variable [IsManifold I ∞ M]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
local instance energySmoothManifoldSucc : IsManifold I (∞ + 1) M := by
  simpa using (inferInstance : IsManifold I ∞ M)

without_proof_info in
/-- Reading a smooth native scalar field in a chart is smooth within
the whole relative chart target, including its model boundary. -/
theorem contDiffOn_read_relativeChart (c : M) {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : M → F} (hf : ContMDiffOn I 𝓘(ℝ, F) ∞ f (extChartAt I c).source) :
    ContDiffOn ℝ ∞ (f ∘ (extChartAt I c).symm) (extChartAt I c).target :=
  (hf.comp (contMDiffOn_extChartAt_symm c) (fun z hz => (extChartAt I c).map_target hz)).contDiffOn

without_proof_info in
theorem contDiffOn_chartInvGram_target (c : M) (i j : Fin (Module.finrank ℝ V)) :
    ContDiffOn ℝ ∞ (fun z => chartInvGramMatrix (I := I) c ((extChartAt I c).symm z) i j)
      (extChartAt I c).target := by
  apply contDiffOn_read_relativeChart (I := I) c (f := fun x => chartInvGramMatrix (I := I) c x i j)
  simpa only [TangentBundle.trivializationAt_baseSet, extChartAt_source] using
