      intro p hp x hx
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx), hv2eq p hp]
      have hG : ContDiffAt ℝ ∞ (D1 p) x :=
        (hf1.comp (contDiffOn_const.prodMk contDiffOn_id)
          (fun y hy => ⟨hp, hy⟩) x (hKW (ball_subset_closedBall hx))).contDiffAt
            (hW.mem_nhds (hKW (ball_subset_closedBall hx)))
      exact hasFDerivAt_domainRead_of_ball_values (v1 p) (D1 p) (hv1eq p hp) hx
