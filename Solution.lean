noncomputable section ProofPart_GreenTrace_SmoothDirichletInverseLinear



/- The actual smooth native zero-Dirichlet inverse is linear by the original
smooth nonresonance. Its value is independent of the supplied solver. -/
open Bundle Set
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {q : M → ℝ}
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem IsZeroDirichletSolution.add {F H u v : M → ℝ}
    (hu : IsZeroDirichletSolution g q F u) (hv : IsZeroDirichletSolution g q H v) :
    IsZeroDirichletSolution g q (F + H) (u + v) := by
  refine ⟨hu.1.add hv.1, fun x hx => ?_, fun x => ?_⟩
  · rw [schrodinger_add g q hu.1 hv.1, hu.2.1 x hx, hv.2.1 x hx]
    rfl
  · simp only [Pi.add_apply, hu.2.2 x, hv.2.2 x, add_zero]

without_proof_info in
theorem IsZeroDirichletSolution.smul {F u : M → ℝ}
    (hu : IsZeroDirichletSolution g q F u) (a : ℝ) :
    IsZeroDirichletSolution g q (a • F) (a • u) := by
  refine ⟨contMDiff_const.smul (I := 𝓘(ℝ)) hu.1, fun x hx => ?_, fun x => ?_⟩
  · rw [schrodinger_smul g q a hu.1, hu.2.1 x hx]
    rfl
  · simp only [Pi.smul_apply, hu.2.2 x, smul_zero]

def ZeroDirichletSolver.smoothInverseLinearMap (S : ZeroDirichletSolver g q)
    (hNR : Nonresonant g q) : C^∞⟮Ihalf, M; ℝ⟯ →ₗ[ℝ] C^∞⟮Ihalf, M; ℝ⟯ where
  toFun F := ⟨S.solve F, (S.correct F F.contMDiff).1⟩
  map_add' F H := by
    apply DFunLike.ext
    intro x
    exact congrFun (hNR.zeroDirichlet_solution_unique
      (S.correct (F + H) (F + H).contMDiff)
      ((S.correct F F.contMDiff).add (S.correct H H.contMDiff))) x
  map_smul' a F := by
    apply DFunLike.ext
    intro x
    exact congrFun (hNR.zeroDirichlet_solution_unique
      (S.correct (a • F) (a • F).contMDiff)
      ((S.correct F F.contMDiff).smul a)) x

without_proof_info in
@[simp] theorem ZeroDirichletSolver.smoothInverseLinearMap_apply
    (S : ZeroDirichletSolver g q) (hNR : Nonresonant g q)
    (F : C^∞⟮Ihalf, M; ℝ⟯) (x : M) :
    S.smoothInverseLinearMap hNR F x = S.solve F x := rfl

without_proof_info in
theorem ZeroDirichletSolver.solve_eq_of_smooth (S T : ZeroDirichletSolver g q)
    (hNR : Nonresonant g q) (F : M → ℝ) (hF : ContMDiff Ihalf 𝓘(ℝ) ∞ F) :
    S.solve F = T.solve F :=
  hNR.zeroDirichlet_solution_unique (S.correct F hF) (T.correct F hF)

end ConformalPoisson

end ProofPart_GreenTrace_SmoothDirichletInverseLinear

/- Green/trace proof support: BoundedRangeFunctional.lean, SHA256 7ade66eb2d3bd84bbcf6ecacb6ce44c972fe5307367431a7430cf120afd792dc -/
noncomputable section ProofPart_GreenTrace_BoundedRangeFunctional



/- A scalar functional bounded by an actual normed reading extends to the
ambient normed space. No density or injectivity of the reading is assumed. -/
namespace ConformalPoisson

without_proof_info in
theorem exists_functional_extension_of_reading_bound
    {A E : Type*} [AddCommGroup A] [Module ℝ A]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (J : A →ₗ[ℝ] E) (f : A →ₗ[ℝ] ℝ) {C : ℝ} (hC : 0 ≤ C)
    (hbound : ∀ a, ‖f a‖ ≤ C * ‖J a‖) :
    ∃ L : E →L[ℝ] ℝ, (∀ a, L (J a) = f a) ∧ ‖L‖ ≤ C := by
  have hker : LinearMap.ker J.rangeRestrict ≤ LinearMap.ker f := by
    intro a ha
    have hzero : J a = 0 := congrArg Subtype.val (LinearMap.mem_ker.mp ha)
    apply LinearMap.mem_ker.mpr
    exact norm_eq_zero.mp (le_antisymm (by simpa [hzero] using hbound a) (norm_nonneg _))
  let fR : LinearMap.range J →ₗ[ℝ] ℝ :=
    J.rangeRestrict.liftOfSurjective J.surjective_rangeRestrict ⟨f, hker⟩
  have hfR (a : A) : fR (J.rangeRestrict a) = f a :=
    LinearMap.equivOfSurjective_apply J.surjective_rangeRestrict hker
  have hR : ∀ x : LinearMap.range J, ‖fR x‖ ≤ C * ‖x‖ := by
    intro x
    obtain ⟨a, rfl⟩ := J.surjective_rangeRestrict x
    change ‖fR (J.rangeRestrict a)‖ ≤ C * ‖J a‖
    rw [hfR]
    exact hbound a
  let LR : LinearMap.range J →L[ℝ] ℝ := fR.mkContinuous C hR
  obtain ⟨L, hL, hnorm⟩ := exists_extension_norm_eq (LinearMap.range J) LR
  refine ⟨L, fun a => (hL (J.rangeRestrict a)).trans (hfR a), ?_⟩
  rw [hnorm]
  exact LR.opNorm_le_bound hC hR

end ConformalPoisson

end ProofPart_GreenTrace_BoundedRangeFunctional

