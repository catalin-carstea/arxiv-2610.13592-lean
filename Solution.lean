without_proof_info in
theorem nativeVolume_isLocallyFiniteMeasure (g : Metric (n := n) (M := M)) :
    IsLocallyFiniteMeasure (nativeVolume g) := by
  unfold nativeVolume
  infer_instance

without_proof_info in
theorem nativeVolume_boundary (g : Metric (n := n) (M := M)) :
    nativeVolume g ((𝓡∂ (n + 1)).boundary M) = 0 := by
  let : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  change TauCeti.riemannianVolume (𝓡∂ (n + 1)) M ((𝓡∂ (n + 1)).boundary M) = 0
  exact (TauCeti.isNullSet_boundary (I := 𝓡∂ (n + 1))).riemannianVolume_eq_zero

without_proof_info in
theorem nativeVolume_ae_interior (g : Metric (n := n) (M := M)) :
    ∀ᵐ x ∂nativeVolume g, x ∈ (𝓡∂ (n + 1)).interior M := by
  apply ae_iff.mpr
  change nativeVolume g ((𝓡∂ (n + 1)).interior M)ᶜ = 0
  rw [(𝓡∂ (n + 1)).compl_interior]
  exact nativeVolume_boundary g

without_proof_info in
theorem nativeVolume_isFiniteMeasure [CompactSpace M] (g : Metric (n := n) (M := M)) :
    IsFiniteMeasure (nativeVolume g) := by
  let := nativeVolume_isLocallyFiniteMeasure g
  infer_instance

without_proof_info in
theorem contMDiff_memLp_nativeVolume [CompactSpace M]
    (g : Metric (n := n) (M := M)) (F : M → ℝ)
    (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F) (p : ℝ≥0∞) :
    MemLp F p (nativeVolume g) := by
  let := nativeVolume_isLocallyFiniteMeasure g
  exact hF.continuous.memLp_of_hasCompactSupport (HasCompactSupport.of_compactSpace F)

end ConformalPoisson

end ProofPart_NativeVolumeProperties

