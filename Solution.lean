  change lpNorm (fun z => b (e z) * splitChartTraceForcing g c q F u z) p μ ≤
    B₁ * lpNorm (∇ w) p μ + Q₁ * lpNorm w p μ +
      lpNorm (fun z : P => F ((extChartAt Ihalf c).symm (e z))) p μ at hRhsBound
  rw [hvalnorm, hgradnorm] at hRhsBound
  refine ⟨U, hU, hest.trans ?_⟩
  calc A * lpNorm (fun z => b (e z) * splitChartTraceForcing g c q F u z) p μ +
        B₀ * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + D₀ * ‖Wkp.value 2 U‖
      ≤ A * (B₁ * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + Q₁ * ‖Wkp.value 2 U‖ +
          lpNorm (fun z : P => F ((extChartAt Ihalf c).symm (e z))) p μ) +
        B₀ * ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 U)‖ + D₀ * ‖Wkp.value 2 U‖ :=
      add_le_add (add_le_add (mul_le_mul_of_nonneg_left hRhsBound hA) (le_refl _)) (le_refl _)
