set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integral_carleman_schrodinger_coercivity_of_tsupport_subset {φ q v : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hq : Continuous q)
    (hv : ContMDiff I 𝓘(ℝ) ∞ v) (hvc : HasCompactSupport v)
    {S : Set M} (hvs : tsupport v ⊆ S)
    {τ c h w d Q : ℝ} (hτ : 1 ≤ τ) (hc : 0 ≤ c) (hd : 0 ≤ d) (hgap : 0 < h - c * w)
    (hlarge : 8 * c ^ 2 + d ≤ 2 * (h - c * w) * τ)
    (hQ : 0 ≤ Q) (hlargeQ : 4 * Q ^ 2 ≤ (h - c * w) * τ ^ 3)
    (hqbound : ∀ x ∈ S, |q x| ≤ Q)
    (hHess : ∀ x ∈ S, ∀ (ξ : TangentSpace I x), -c * ‖ξ‖ ^ 2 ≤ hessian I φ x ξ ξ)
    (hNormal : ∀ x ∈ S, h ≤ hessian I φ x (mgradient I φ x) (mgradient I φ x))
    (hGrad : ∀ x ∈ S, ‖mgradient I φ x‖ ^ 2 ≤ w)
    (hBiLap : ∀ x ∈ S, |laplaceBeltrami I (laplaceBeltrami I φ) x| ≤ d) :
    ((h - c * w) / 4) * τ ^ 3 * (∫ x, v x ^ 2 ∂μ) ≤
      ∫ x, (carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x - q x * v x) ^ 2 ∂μ := by
  obtain ⟨hvLp, hALp, hBLp⟩ := memLp_carleman_parts hφ hv hvc τ
  have hqvLp : MemLp (fun x => q x * v x) 2 μ :=
    (hq.mul hv.continuous).memLp_of_hasCompactSupport hvc.mul_left
  let vL : Lp ℝ 2 μ := hvLp.toLp v
  let A : Lp ℝ 2 μ := hALp.toLp (carlemanSymmetricPart I φ τ v)
  let B : Lp ℝ 2 μ := hBLp.toLp (carlemanSkewPart I φ τ v)
  let Qv : Lp ℝ 2 μ := hqvLp.toLp (fun x => q x * v x)
  have hvread : (vL : M → ℝ) =ᵐ[μ] v := hvLp.coeFn_toLp
  have hAread : (A : M → ℝ) =ᵐ[μ] carlemanSymmetricPart I φ τ v := hALp.coeFn_toLp
  have hBread : (B : M → ℝ) =ᵐ[μ] carlemanSkewPart I φ τ v := hBLp.coeFn_toLp
  have hQread : (Qv : M → ℝ) =ᵐ[μ] fun x => q x * v x := hqvLp.coeFn_toLp
  have hsum : (A + B : Lp ℝ 2 μ) =ᵐ[μ]
      fun x => carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x := by
    filter_upwards [Lp.coeFn_add A B, hAread, hBread] with x hx hax hbx
    rw [hx, Pi.add_apply, hax, hbx]
  have hdiff : (A + B - Qv : Lp ℝ 2 μ) =ᵐ[μ]
      fun x => carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x - q x * v x := by
    filter_upwards [Lp.coeFn_sub (A + B) Qv, hsum, hQread] with x hx hs hqx
    rw [hx, Pi.sub_apply, hs, hqx]
  have hV := normSq_L2_eq_integral_of_ae hvread
  have hPN := normSq_L2_eq_integral_of_ae hsum
  have hDN := normSq_L2_eq_integral_of_ae hdiff
  have hQN := normSq_L2_eq_integral_of_ae hQread
  have hcoercive : ((h - c * w) * τ ^ 3) * ‖vL‖ ^ 2 ≤ ‖A + B‖ ^ 2 := by
    rw [hV, hPN]
    exact integral_carleman_coercivity_of_tsupport_subset hφ hv hvc hvs hτ hc hd hgap hlarge hHess hNormal hGrad hBiLap
  have hQnorm : ‖Qv‖ ≤ Q * ‖vL‖ := by
    apply (sq_le_sq₀ (norm_nonneg Qv) (mul_nonneg hQ (norm_nonneg vL))).mp
    rw [hQN, mul_pow, hV, ← integral_const_mul]
    have hVint : Integrable (fun x => v x ^ 2) μ :=
      (hv.pow 2).continuous.integrable_of_hasCompactSupport (hasCompactSupport_square hvc)
    have hQint : Integrable (fun x => (q x * v x) ^ 2) μ :=
      ((hq.mul hv.continuous).pow 2).integrable_of_hasCompactSupport
        (hasCompactSupport_square (show HasCompactSupport (fun x => q x * v x) from hvc.mul_left))
    apply integral_mono hQint (hVint.const_mul _)
    intro x
    by_cases hx : x ∈ S
    · have hq2 : q x ^ 2 ≤ Q ^ 2 := by nlinarith [sq_abs (q x), hqbound x hx, abs_nonneg (q x)]
      have hm := mul_le_mul_of_nonneg_right hq2 (sq_nonneg (v x))
      nlinarith
    · have hzero : v x = 0 := image_eq_zero_of_notMem_tsupport (fun ht => hx (hvs ht))
      simp only [hzero, mul_zero, zero_pow (by decide : 2 ≠ 0), le_refl]
  have hresult := carleman_absorb_bounded_potential hQ hlargeQ hcoercive hQnorm
  rw [hV, hDN] at hresult
  convert hresult using 1 <;> ring


set_option maxHeartbeats 1000000 in
without_proof_info in
theorem integral_carleman_schrodinger_coercivity {φ q v : M → ℝ}
