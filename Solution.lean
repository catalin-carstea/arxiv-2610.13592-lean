noncomputable section ProofPart_DNSymbol_DNChartAmbientGerm



/- Assignment268, /root. On the actual physical interior, the actual native
zero extension has the SAME ordinary ambient coordinate germ. The model
inverse is only read where its actual right-inverse property applies. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Filter Topology TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson.LocalDN
variable {n : ℕ} {M F : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem coordinatePushforward_ambient_germ
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (W : Y × ℝ → F) {z : H} (hz : z ∈ χ.source) (hpos : 0 < z.val 0) :
    (fun v : V => coordinatePushforward χ (fun w => W (nativeNormalCoordinates w))
      (χ ((𝓡∂ (n + 1)).symm v))) =ᶠ[𝓝 z.val]
        (fun v => W ((euclideanHalfSpaceBoundaryNormalEquiv n).symm v)) := by
  have hsOpen : IsOpen ((𝓡∂ (n + 1)).symm ⁻¹' χ.source) := χ.open_source.preimage (𝓡∂ (n + 1)).continuous_symm
  have hzS : z.val ∈ (𝓡∂ (n + 1)).symm ⁻¹' χ.source := by
    change (𝓡∂ (n + 1)).symm ((𝓡∂ (n + 1)) z) ∈ χ.source
    rw [(𝓡∂ (n + 1)).left_inv z]
    exact hz
  have hpOpen : IsOpen {v : V | 0 < v 0} :=
    isOpen_lt continuous_const (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous
  filter_upwards [hsOpen.mem_nhds hzS, hpOpen.mem_nhds hpos] with v hvS hvP
  rw [coordinatePushforward_chart χ _ hvS]
  have hi : (𝓡∂ (n + 1)) ((𝓡∂ (n + 1)).symm v) = v :=
    (𝓡∂ (n + 1)).right_inv (by simpa only [range_modelWithCornersEuclideanHalfSpace, mem_ofPred_eq] using hvP.le)
  unfold nativeNormalCoordinates
  rw [hi]

