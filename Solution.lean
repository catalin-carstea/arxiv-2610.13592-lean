      MemLp (fun z : P => G.kernel x ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (b : ℝ≥0∞)
        (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)) ∧
      lpNorm (fun z : P => G.kernel x ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) (b : ℝ≥0∞)
