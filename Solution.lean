      apply closedBall_subset_ball
      dsimp only [inn, mid]
      linarith)
    filter_upwards [hB] with z hz
    exact mid.one_of_mem_closedBall (ball_subset_closedBall hz)
  exact ⟨⟨inn, mid, out, fun z hz => (hOut hz).1,
    fun z hz => (hOut hz).2, hmidout, houtone, hnear⟩⟩

