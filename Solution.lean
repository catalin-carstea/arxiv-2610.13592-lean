theorem NativeClassicalValueKernel.exists_continuous_localL2_rows
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p : ℝ≥0∞} [Fact (1 ≤ p)]
    {K : NativeInverseLpRowFamily g q p} (G : NativeClassicalValueKernel K)
    (hG : ContinuousOn (fun t : M × M => G.kernel t.1 t.2) {t | t.1 ≠ t.2})
    (c : M) {r : ℝ}
    (htarget : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    (U : Opens M) (hKU : nativeClosedChartCap (n := n) c r ⊆ U)
    {A : Type*} [TopologicalSpace A] (pole : C(A, M)) (hPole : ∀ a, pole a ∉ (U : Set M)) :
    ∃ R : C(A, nativeLocalL2SolutionSpace (g := g) (q := q) htarget),
      ∀ a, ((R a : nativeLocalL2SolutionSpace (g := g) (q := q) htarget) :
        Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c r : Set V))) =ᵐ[
          (Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c r : Set V)]
          (fun z => G.kernel (pole a) ((extChartAt Ihalf c).symm z)) := by
