local notation "V" => EuclideanSpace ℝ (Fin d)
local instance zeroTraceChartContinuousMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := 1)
open DirichletSobolev
variable {c : M} (L : BoundaryChartLocalization (I := I) c)

without_proof_info in
/-- Every smooth compactly supported cutoff inside the inner ambient
ball times the H1 reading is an actual zero-trace Sobolev function on
the inner cap. This is the boundary condition in flat-boundary H2 regularity. -/
theorem innerReadingL_zeroBoundary_cutoff
    (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x})
    (ψ : V → ℝ) (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψs : tsupport ψ ⊆ ball (extChartAt I c c) L.bump.rIn) :
    ∃ v : W1p0 (Module.finBasis ℝ V).addHaar L.innerCap 2,
      W1p.value v.val =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)]
        fun z => ψ z * W1p.value (L.innerReadingL u) z := by
  let Ω := boundaryChartCap (I := I) c L.radius
  let μ := (Module.finBasis ℝ V).addHaar
  let w : W1p0 μ Ω 2 := L.readingL u
  obtain ⟨N, hN, hψbound, hgbound⟩ := exists_compact_smooth_multiplier_bound hψ hψc
  have hψN : ∀ z ∈ Ω, |ψ z| ≤ N := fun z _ => hψbound z
  have hgN : ∀ z ∈ Ω, ‖∇ ψ z‖ ≤ N := fun z _ => hgbound z
  have hs : (Ω : Set V) ∩ tsupport ψ ⊆ L.innerCap :=
    fun z hz => ⟨hψs hz.2, hz.1.2⟩
  have ht : (L.innerCap : Set V) ∩ tsupport ψ ⊆ Ω :=
    fun _ hz => L.innerCap_le_outer hz.1
  let v : W1p μ L.innerCap 2 :=
    W1p.localizeL (inf_le_right : Ω ⊓ L.innerCap ≤ L.innerCap) ψ hψ hN
      (fun z hz => hψN z hz.1) (fun z hz => hgN z hz.1)
      (fun _ hz => ⟨ht hz, hz.1⟩) (W1p.restrictL inf_le_left w.val)
  have hv : v ∈ w1p0Submodule μ L.innerCap 2 :=
    W1p.localizeL_restrictL_mem_w1p0Submodule hψ hN hψN hgN ht hs w.property
  refine ⟨⟨v, hv⟩, ?_⟩
  have hval := W1p.value_localizeL_ae (μ := μ) (p := 2)
    (inf_le_right : Ω ⊓ L.innerCap ≤ L.innerCap) hψ hN
    (fun z hz => hψN z hz.1) (fun z hz => hgN z hz.1)
    (fun _ hz => ⟨ht hz, hz.1⟩) (W1p.restrictL inf_le_left w.val)
  have hsub : (L.innerCap : Set V) ⊆ (Ω ⊓ L.innerCap : TopologicalSpace.Opens V) :=
    fun _ hz => ⟨L.innerCap_le_outer hz, hz⟩
  have hr := ae_restrict_of_ae_restrict_of_subset hsub
    (W1p.value_restrictL_ae (inf_le_left : Ω ⊓ L.innerCap ≤ Ω) w.val)
  have hinner := W1p.value_restrictL_ae L.innerCap_le_outer w.val
  filter_upwards [hval, hr, hinner, ae_restrict_mem L.innerCap.isOpen.measurableSet]
    with z hz hrz hiz hzcap
  change W1p.value v z = ψ z * W1p.value (W1p.restrictL L.innerCap_le_outer w.val) z
  rw [hz, indicator_of_mem (hsub hzcap), hrz, hiz, smul_eq_mul]
end ConformalPoisson.BoundaryChartLocalization

