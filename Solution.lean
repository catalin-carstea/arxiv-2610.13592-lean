/-- The native signed-potential energy of actual smooth zero-boundary
functions is its ordinary native volume integral, without using a
Boundaryless Green identity. -/
theorem schrodingerForm_smooth_eq_integral {q : M → ℝ} (hq : Continuous q)
    (u v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    schrodingerForm (I := I) {x : M | I.IsBoundaryPoint x}
      (ContinuousMap.toLp ⊤ (riemannianVolume I M) ℝ ⟨q, hq⟩)
      (smoothInclusion (E := V) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u)
      (smoothInclusion (E := V) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} v) =
      ∫ x, (⟪mgradient I u.val x, mgradient I v.val x⟫_ℝ + q x * u.val x * v.val x)
        ∂riemannianVolume I M := by
  rw [schrodingerForm_apply]
  change SobolevH1.dirichletForm (SobolevH1.ofSmooth u.val) (SobolevH1.ofSmooth v.val) +
    SobolevH1.potentialForm _ (SobolevH1.ofSmooth u.val) (SobolevH1.ofSmooth v.val) = _
  rw [SobolevH1.dirichletForm_ofSmooth, SobolevH1.potentialForm_ofSmooth]
  have hpot : ∫ x, (ContinuousMap.toLp ⊤ (riemannianVolume I M) ℝ ⟨q, hq⟩) x * u.val x * v.val x
      ∂riemannianVolume I M = ∫ x, q x * u.val x * v.val x ∂riemannianVolume I M := by
    apply integral_congr_ae
    filter_upwards [ContinuousMap.coeFn_toLp (p := ⊤) (𝕜 := ℝ) (riemannianVolume I M) ⟨q, hq⟩] with x hx
    rw [hx]
    rfl
  rw [hpot]
  exact (integral_add
    (continuous_inner_mgradient (u.val.contMDiff.of_le (by simp))
      (v.val.contMDiff.of_le (by simp))).integrable_of_compactSpace
    ((hq.mul u.val.contMDiff.continuous).mul v.val.contMDiff.continuous).integrable_of_compactSpace).symm

