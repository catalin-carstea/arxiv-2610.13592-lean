  TauCeti.isManifold_boundary (n := n) (k := ω) M (by decide)
local instance poissonRep_compact : CompactSpace ((𝓡∂ (n + 1)).boundary M) := compactSpace_nativeBoundary

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem NativeClassicalValueKernel.poisson_representation
    {g : Metric (n := n) (M := M)} {q : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) {s : ℝ≥0∞}
    {K : NativeInverseLpRowFamily g q s} (G : NativeClassicalValueKernel K)
    (S : DirichletSolver g q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (f : (𝓡∂ (n + 1)).boundary M → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f)
    (x : M) (hx : x ∈ (Ihalf).interior M) :
    Integrable (fun y => boundaryPoissonSection ν G.kernel y x * f y) (nativeSurfaceMeasure g) ∧
      S.solve f x = ∫ y, boundaryPoissonSection ν G.kernel y x * f y ∂nativeSurfaceMeasure g := by
  let : IsLocallyFiniteMeasure (nativeSurfaceMeasure g) := nativeSurfaceMeasure_isLocallyFiniteMeasure g
  let : IsFiniteMeasure (nativeSurfaceMeasure g) := inferInstance
  obtain ⟨O, hxO, hOI, E, hE, hE0, hEf⟩ := exists_native_boundary_extension_away_point S f hf x hx
  obtain ⟨θ, hθ, hθO, u, hu, hu0, huG⟩ := G.exists_smooth_pole_removal_in x O hxO
  have hPE0 (z : M) (hz : z ∈ O) : schrodinger g q E z = 0 := by
    have he : E =ᶠ[𝓝 z] (0 : M → ℝ) := Filter.eventually_of_mem (O.isOpen.mem_nhds hz) hE0
    exact (schrodinger_eq_of_eventuallyEq g q ((hE z).of_le (by simp)) contMDiffAt_const he).trans
      (schrodinger_zero g q z)
  have huOutside (z : M) (hz : z ∉ O) : u =ᶠ[𝓝 z] G.kernel x :=
    huG z (fun h => hz (hθO h))
  have hVol : (fun z => u z * schrodinger g q E z - E z * schrodinger g q u z) =ᵐ[nativeVolume g]
      (fun z => G.kernel x z * schrodinger g q E z) := by
    filter_upwards [nativeVolume_ae_interior g] with z hzI
    by_cases hzO : z ∈ O
    · have hzE : E z = 0 := hE0 hzO
      simp only [hPE0 z hzO, hzE, mul_zero, zero_mul, sub_self]
    · have hzx : z ≠ x := by intro he; subst z; exact hzO hxO
      have hGrow : ContMDiffAt Ihalf 𝓘(ℝ) ∞ (G.kernel x) z :=
        ((G.row_smooth x) z hzx).contMDiffAt (isOpen_compl_singleton.mem_nhds hzx)
      have hPu : schrodinger g q u z = 0 :=
        (schrodinger_eq_of_eventuallyEq g q ((hu z).of_le (by simp)) (hGrow.of_le (by simp))
          (huOutside z hzO)).trans (G.row_equation x z ⟨hzI, hzx⟩)
      rw [(huOutside z hzO).eq_of_nhds, hPu, mul_zero, sub_zero]
  have hNu (y : (Ihalf).boundary M) : normalDerivative ν u y = normalDerivative ν (G.kernel x) y := by
    apply normalDerivative_eq_of_eventuallyEq ν y
    apply huG
    intro hy
    exact ((Ihalf).isInteriorPoint_iff_not_isBoundaryPoint (y : M)).mp (hOI (hθO hy)) y.property
  have hPoisson (y : (Ihalf).boundary M) :
      boundaryPoissonSection ν G.kernel y x = -normalDerivative ν u y := by
    change -normalDerivative ν (G.kernel x) y = -normalDerivative ν u y
    rw [hNu y]
  let H : (Ihalf).boundary M → ℝ := fun y => boundaryPoissonSection ν G.kernel y x * f y
  have hNormalInt : Integrable (fun y => normalDerivative ν u y * f y) (nativeSurfaceMeasure g) :=
    ((contMDiff_native_normalDerivative g ν hν hu).continuous.mul hf.continuous).integrable_of_compactSpace
  have hInt : Integrable H (nativeSurfaceMeasure g) := hNormalInt.neg.congr
    (Filter.Eventually.of_forall (fun y => by
      change -(normalDerivative ν u y * f y) = boundaryPoissonSection ν G.kernel y x * f y
      rw [hPoisson, neg_mul]))
  have hGreen := native_green_second_zero_boundary g q ν hν u E hu hE hu0
  have hMoment : (∫ z, G.kernel x z * schrodinger g q E z ∂nativeVolume g) =
      -(∫ y, H y ∂nativeSurfaceMeasure g) := by
    calc
      _ = ∫ z, u z * schrodinger g q E z - E z * schrodinger g q u z ∂nativeVolume g := integral_congr_ae hVol.symm
      _ = ∫ y, E y * normalDerivative ν u y ∂nativeSurfaceMeasure g := hGreen
      _ = ∫ y, -H y ∂nativeSurfaceMeasure g := by
        apply integral_congr_ae
        filter_upwards with y
        dsimp only [H]
        rw [hEf y, hPoisson y]
        ring
      _ = _ := integral_neg _
  let w := E - S.solve f
  have hw : IsZeroDirichletSolution g q (schrodinger g q E) w := by
    refine ⟨hE.sub (S.correct f hf).1, ?_, ?_⟩
    · intro z hz
      rw [schrodinger_sub g q hE (S.correct f hf).1, (S.correct f hf).2.1 z hz, sub_zero]
    · intro y
      change E y - S.solve f y = 0
      rw [hEf y, (S.correct f hf).2.2 y, sub_self]
  have hRep := (G.representation x ⟨schrodinger g q E, contMDiff_schrodinger g q E hq hE⟩ w hw).2
  have hEx : E x = 0 := hE0 hxO
  have hValue : -S.solve f x = -(∫ y, H y ∂nativeSurfaceMeasure g) := by
    calc
      _ = w x := by simp only [w, Pi.sub_apply, hEx, zero_sub]
      _ = _ := hRep.trans hMoment
  exact ⟨hInt, neg_injective hValue⟩
end ConformalPoisson

