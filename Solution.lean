  let Ω := boundaryChartCap (I := Ihalf) c r
  let ν : Measure V := μ.restrict (Ω : Set V)
  have hΩb : Bornology.IsBounded (Ω : Set V) := isBounded_ball.subset inter_subset_left
  letI : IsFiniteMeasure ν := isFiniteMeasure_restrict.2 hΩb.measure_lt_top.ne
