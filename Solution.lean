/- Native cutoff commutators: locality and skew pairing. The pairing is a
consequence of the already-proved SAME inverse reciprocity, so no boundary
Green formula or general very-weak boundary regularity is assumed. -/
open Bundle Set MeasureTheory TauCeti Filter TopologicalSpace
open scoped Manifold ContDiff Topology ENNReal
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

def nativeCutoffCommutator (g : Metric (n := n) (M := M)) (q θ u : M → ℝ) : M → ℝ :=
  fun x => schrodinger g q (θ * u) x - θ x * schrodinger g q u x

without_proof_info in
theorem contMDiff_nativeCutoffCommutator
    (g : Metric (n := n) (M := M)) (q θ u : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hθ : ContMDiff Ihalf 𝓘(ℝ) ∞ θ)
    (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) :
    ContMDiff Ihalf 𝓘(ℝ) ∞ (nativeCutoffCommutator g q θ u) :=
  (contMDiff_schrodinger g q (θ * u) hq (hθ.mul hu)).sub
    (hθ.mul (contMDiff_schrodinger g q u hq hu))

without_proof_info in
theorem nativeCutoffCommutator_eq_zero_of_eventually_const
    (g : Metric (n := n) (M := M)) (q θ u : M → ℝ)
    (hθ : ContMDiff Ihalf 𝓘(ℝ) ∞ θ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (x : M) (a : ℝ) (he : θ =ᶠ[𝓝 x] fun _ => a) :
    nativeCutoffCommutator g q θ u x = 0 := by
  have heprod : θ * u =ᶠ[𝓝 x] fun y => a * u y := by
    filter_upwards [he] with y hy
    simp only [Pi.mul_apply, Pi.smul_apply, smul_eq_mul, hy]
  have hP := schrodinger_eq_of_eventuallyEq g q
    ((hθ.mul hu).of_le (by simp)).contMDiffAt
    ((contMDiff_const.mul hu).of_le (by simp)).contMDiffAt heprod
  have hsm := schrodinger_smul g q a hu x
  change schrodinger g q (fun y => a * u y) x = a * schrodinger g q u x at hsm
  dsimp only [nativeCutoffCommutator]
  rw [hP]
  change schrodinger g q (fun y => a * u y) x - θ x * schrodinger g q u x = 0
  rw [hsm, he.eq_of_nhds]
  exact sub_self _

without_proof_info in
theorem tsupport_nativeCutoffCommutator_subset
    (g : Metric (n := n) (M := M)) (q θ u : M → ℝ)
    (hθ : ContMDiff Ihalf 𝓘(ℝ) ∞ θ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (O : Opens M) (hθ1 : EqOn θ (fun _ => 1) O) :
    tsupport (nativeCutoffCommutator g q θ u) ⊆ tsupport θ \ (O : Set M) := by
  apply closure_minimal ?_ ((isClosed_tsupport θ).inter O.isOpen.isClosed_compl)
  intro x hx
  by_contra hn
  apply hx
  by_cases hxO : x ∈ O
  · exact nativeCutoffCommutator_eq_zero_of_eventually_const g q θ u hθ hu x 1
      (Filter.eventually_of_mem (O.isOpen.mem_nhds hxO) hθ1)
  · have hxθ : x ∉ tsupport θ := fun h => hn ⟨h, hxO⟩
