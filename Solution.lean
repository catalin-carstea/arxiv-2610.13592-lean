  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  let : SecondCountableTopology M := native_secondCountable_of_compact (n := n) isCompact_univ
  let : (nativeVolume g).WeaklyRegular := by infer_instance
  have hC := ContinuousMap.toLp_denseRange (p := p) (μ := nativeVolume g) (𝕜 := ℝ) (E := ℝ) hp
