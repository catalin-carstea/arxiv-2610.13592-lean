/- Bounded C0 readings whose SAME representatives are smooth on the compact
physical cap. Closed graph is applied to an injective actual value map.
Intended caller: native L2 solution closure and bounded derivative evaluations. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

instance boundaryChartCapClosure_compactSpace (c : M) (r : ℝ) :
    CompactSpace (closure (boundaryChartCap (I := Ihalf) c r : Set V)) := by
  have hb : Bornology.IsBounded (boundaryChartCap (I := Ihalf) c r : Set V) :=
    isBounded_ball.subset (fun _ hz => hz.1)
  exact isCompact_iff_compactSpace.mp hb.isCompact_closure

instance boundaryChartCap_isFiniteMeasure
    (μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))) [μ.IsAddHaarMeasure] (c : M) (r : ℝ) :
    IsFiniteMeasure (μ.restrict (boundaryChartCap (I := Ihalf) c r : Set V)) := by
  have hb : Bornology.IsBounded (boundaryChartCap (I := Ihalf) c r : Set V) :=
    isBounded_ball.subset (fun _ hz => hz.1)
  exact ⟨by rw [Measure.restrict_apply_univ]; exact hb.measure_lt_top⟩

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_bounded_smooth_cap_reading
    {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
    (c : M) {r : ℝ} (hr : 0 < r)
    (A : H →L[ℝ] Lp ℝ 2 (μ.restrict (boundaryChartCap (I := Ihalf) c r : Set V)))
    (hall : ∀ k : ℕ, ∃ T : H →L[ℝ] Wkp μ (boundaryChartCap (I := Ihalf) c r) 2 (k + 2),
      ∀ u, Wkp.value (k + 2) (T u) =ᵐ[μ.restrict (boundaryChartCap (I := Ihalf) c r : Set V)] A u) :
    ∃ T : H →L[ℝ] C(closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V), ℝ),
      ∀ u, ∃ v : V → ℝ, Continuous v ∧
        ContDiffOn ℝ ∞ v (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) ∧
        (∀ x (hx : x ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)),
          T u ⟨x, hx⟩ = v x) ∧
        v =ᵐ[μ.restrict (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)] A u := by
  let Ω := boundaryChartCap (I := Ihalf) c r
  let D := boundaryChartCap (I := Ihalf) c (r / 2)
  have hsub : D ≤ Ω := fun _ hz => ⟨ball_subset_ball (by linarith : r / 2 ≤ r) hz.1, hz.2⟩
  let R : Lp ℝ 2 (μ.restrict (Ω : Set V)) →L[ℝ] Lp ℝ 2 (μ.restrict (D : Set V)) :=
    Lp.LpToLpOfMeasureLeSMul (c := 1) (by simp) (by
      simpa only [one_smul] using Measure.restrict_mono_set μ (SetLike.coe_subset_coe.mpr hsub))
  have hR : ∀ w : Lp ℝ 2 (μ.restrict (Ω : Set V)), R w =ᵐ[μ.restrict (D : Set V)] w :=
    fun w => Lp.coeFn_LpToLpOfMeasureLeSMul _ _ w
  let B : C(closure (D : Set V), ℝ) →L[ℝ] Lp ℝ 2 (μ.restrict (D : Set V)) :=
    continuousClosureToLp
  have hB : Function.Injective B := continuousClosureToLp_injective
  have hrep : ∀ u : H, ∃ v : V → ℝ, Continuous v ∧ ContDiffOn ℝ ∞ v (closure (D : Set V)) ∧
      v =ᵐ[μ.restrict (D : Set V)] A u := by
    intro u
    exact exists_smooth_boundaryChartCap_reading c hr (A u) (fun k => by
      obtain ⟨T, hT⟩ := hall k
      exact ⟨T u, hT u⟩)
  have hBrep : ∀ u : H, ∀ v : V → ℝ, ∀ hv : Continuous v,
      v =ᵐ[μ.restrict (D : Set V)] A u →
      B (⟨fun x => v x, hv.comp continuous_subtype_val⟩ : C(closure (D : Set V), ℝ)) = R (A u) := by
    intro u v hv hvA
    apply Lp.ext
