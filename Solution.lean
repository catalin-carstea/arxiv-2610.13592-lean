    (D : ℕ) (hD : ∀ y ∈ U, (P y).natDegree < D)
    {K : Set E} (hK : IsClosed K) (hKU : K ⊆ U) (hP0 : ∀ y ∉ K, P y = 0) (h : ℝ) :
