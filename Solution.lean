        schrodinger g q u ((extChartAt (𝓡∂ (n + 1)) α).symm (A.chart (z : V))) := by
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  have hinv : ContMDiffAt 𝓘(ℝ, V) (𝓡∂ (n + 1)) 2
      (extChartAt (𝓡∂ (n + 1)) α).symm (A.chart (z : V)) :=
    ((contMDiffOn_extChartAt_symm (I := 𝓡∂ (n + 1)) (n := ω) α)
      _ (interior_subset hz)).contMDiffAt
        (Filter.mem_of_superset (isOpen_interior.mem_nhds hz) interior_subset) |>.of_le (by decide)
