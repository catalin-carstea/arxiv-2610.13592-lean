theorem exists_analytic_holder_jet_translation_readings
    (hα : α ≤ 1) (χ u : V → ℝ) (hχ : ContDiff ℝ ∞ χ)
    (hχbound : ∀ x, ‖χ x‖ ≤ 1) (hu : ContDiffOn ℝ 3 u (ball 0 3))
    (Jdiff : V → BX) (hJ : AnalyticAt ℝ Jdiff 0)
