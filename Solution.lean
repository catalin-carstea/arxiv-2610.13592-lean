/- Proof support: CauchyZeroExtension.lean, SHA256 55901806dccc14fc35d7edc9ff0595961263557ea52f0f4e6a398ade5d9a0a83 -/
noncomputable section ProofPart_CauchyZeroExtension



/- Zero Cauchy traces give an actual H2 zero extension. The first
jet traces are explicit inputs here; deriving them from the native
Dirichlet and normal data is a separate caller obligation. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω U : Opens E}
  {ι : Type*} [Fintype ι]

set_option maxHeartbeats 500000 in
without_proof_info in
theorem exists_H2_zeroExtension_of_zeroTrace_firstJets
    (b : OrthonormalBasis ι ℝ E) (hsub : Ω ≤ U)
    (u : W1p0 μ Ω 2) (d : ι → W1p0 μ Ω 2)
    (hd : ∀ i, W1p.value (d i).val =ᵐ[μ.restrict Ω]
      fun x => ⟪W1p.gradient u.val x, b i⟫_ℝ) :
    ∃ W : Wkp μ U 2 2,
      Wkp.firstOrder 1 W = (W1p0.extendByZeroL hsub u).val ∧
      Wkp.value 2 W =ᵐ[μ.restrict U]
