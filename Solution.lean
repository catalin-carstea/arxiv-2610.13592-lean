def FinitePowerExpansion (f : ℝ → ℂ) (a : ℕ → ℂ) : Prop :=
  ∀ N, ∃ C h0 : ℝ, 0 ≤ C ∧ 0 < h0 ∧ ∀ h : ℝ, 0 < h → h < h0 →
    ‖f h - ∑ j ∈ Finset.range (N + 1), (h : ℂ) ^ j * a j‖ ≤ C * h ^ (N + 1)

without_proof_info in
theorem coefficients_eq_of_common_finite_expansions
    (f : ℝ → ℂ) (a b : ℕ → ℂ) (ha : FinitePowerExpansion f a)
    (hb : FinitePowerExpansion f b) : a = b := by
  funext r
  induction r using Nat.strong_induction_on with
  | ind r ih =>
    obtain ⟨Ca, ha0, hCa, hha0, ha⟩ := ha r
    obtain ⟨Cb, hb0, hCb, hhb0, hb⟩ := hb r
    have hsmall (h : ℝ) (hh : 0 < h) (hha : h < ha0) (hhb : h < hb0) :
        ‖a r - b r‖ ≤ (Ca + Cb) * h := by
      let pa := ∑ j ∈ Finset.range (r + 1), (h : ℂ) ^ j * a j
      let pb := ∑ j ∈ Finset.range (r + 1), (h : ℂ) ^ j * b j
      have hprev : (∑ j ∈ Finset.range r, (h : ℂ) ^ j * a j) =
          ∑ j ∈ Finset.range r, (h : ℂ) ^ j * b j :=
        Finset.sum_congr rfl (fun j hj => by rw [ih j (Finset.mem_range.mp hj)])
      have hpoly : pa - pb = (h : ℂ) ^ r * (a r - b r) := by
        dsimp only [pa, pb]
        rw [Finset.sum_range_succ, Finset.sum_range_succ, hprev]
        ring
      have hnorm : ‖(h : ℂ) ^ r * (a r - b r)‖ = h ^ r * ‖a r - b r‖ := by
        simp only [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hh]
      have hbound : h ^ r * ‖a r - b r‖ ≤ h ^ r * ((Ca + Cb) * h) := by
        calc
          _ = ‖pa - pb‖ := by rw [hpoly, hnorm]
          _ ≤ ‖pa - f h‖ + ‖f h - pb‖ := norm_sub_le_norm_sub_add_norm_sub pa (f h) pb
          _ ≤ Ca * h ^ (r + 1) + Cb * h ^ (r + 1) :=
            add_le_add (by simpa only [norm_sub_rev] using ha h hh hha) (hb h hh hhb)
          _ = _ := by rw [pow_succ]; ring
      exact (mul_le_mul_iff_right₀ (pow_pos hh r)).mp (by simpa only [mul_comm] using hbound)
    apply sub_eq_zero.mp
    apply norm_eq_zero.mp
    apply le_antisymm ?_ (norm_nonneg _)
    apply le_of_forall_pos_le_add
    intro ε hε
    have hden : 0 < Ca + Cb + 1 := by linarith
    let h := min (ha0 / 2) (min (hb0 / 2) (ε / (Ca + Cb + 1)))
    have hh : 0 < h := lt_min (by positivity) (lt_min (by positivity) (div_pos hε hden))
    have hha : h < ha0 := lt_of_le_of_lt (min_le_left _ _) (by linarith)
    have hhb : h < hb0 := lt_of_le_of_lt ((min_le_right _ _).trans (min_le_left _ _)) (by linarith)
    have heps : h ≤ ε / (Ca + Cb + 1) := (min_le_right _ _).trans (min_le_right _ _)
    have heps' : h * (Ca + Cb + 1) ≤ ε := (le_div_iff₀ hden).mp heps
    have hbound := hsmall h hh hha hhb
    nlinarith

without_proof_info in
theorem FinitePowerExpansion.congr_positive {f g : ℝ → ℂ} {a : ℕ → ℂ}
    (hf : FinitePowerExpansion f a) (he : ∀ h : ℝ, 0 < h → f h = g h) :
    FinitePowerExpansion g a := by
  intro N
  obtain ⟨C, h0, hC, hh0, hb⟩ := hf N
  refine ⟨C, h0, hC, hh0, fun h hh hsmall => ?_⟩
  rw [← he h hh]
  exact hb h hh hsmall

