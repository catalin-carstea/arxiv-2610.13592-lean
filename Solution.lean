/- Taylor's actual segment remainder is bounded by a geometric factor
times n+1. The weaker Mathlib denominator n! is retained explicitly. -/
open Set Metric
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem relative_taylor_remainder_bound
    {S : Set E} (hS : UniqueDiffOn ℝ S) (hconv : Convex ℝ S) (h0 : (0 : E) ∈ S)
    {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    {M D : ℝ} (hbound : ∀ x ∈ S, ∀ k, ‖iteratedFDerivWithin ℝ k f S x‖ ≤
      M * D ^ k * (k.factorial : ℝ)) {y : E} (hy : y ∈ S) (N : ℕ) :
    ‖f y - ∑ k ∈ Finset.range (N + 1), relativeTaylorPowerSeries f S 0 k (fun _ => y)‖ ≤
      M * (N + 1 : ℝ) * (D * ‖y‖) ^ (N + 1) := by
  have hsegment : ∀ t ∈ Icc (0 : ℝ) 1, t • y ∈ S :=
    fun _ ht => hconv.smul_mem_of_zero_mem h0 hy ht
  have hseries := hasFTaylorSeriesUpToOn_relative_segment hS hf y hsegment
  have hcurve : ContDiffOn ℝ ∞ (fun t : ℝ => f (t • y)) (Icc (0 : ℝ) 1) := hseries.contDiffOn
  have hpoly : taylorWithinEval (fun t : ℝ => f (t • y)) N (Icc (0 : ℝ) 1) 0 1 =
      ∑ k ∈ Finset.range (N + 1), relativeTaylorPowerSeries f S 0 k (fun _ => y) := by
    rw [taylor_within_apply]
    apply Finset.sum_congr rfl
    intro k _
    rw [iteratedDerivWithin_segment_eq_relative_jet hS hf y hsegment (by norm_num) k]
    simp [relativeTaylorPowerSeries]
  have hTaylor := taylor_mean_remainder_bound (a := (0 : ℝ)) (b := 1) (x := 1) (n := N)
    (by norm_num) (hcurve.of_le (by simp)) (by norm_num)
    (fun t ht => norm_iteratedDerivWithin_segment_le hS hf y hsegment hbound ht (N + 1))
  rw [hpoly] at hTaylor
  have hfac : (N.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero N)
  calc
    _ ≤ (M * D ^ (N + 1) * ((N + 1).factorial : ℝ) * ‖y‖ ^ (N + 1)) / (N.factorial : ℝ) := by
      simpa only [one_smul, sub_zero, one_pow, mul_one] using hTaylor
    _ = _ := by
      rw [Nat.factorial_succ, mul_pow]
      push_cast
      field_simp
      <;> ring

end ConformalPoisson

