theorem homogeneous_multi_frequency {d : ℤ} {b : NativeSymbol n}
    (hA : SymbolContMDiffOn S ω b) (hb : Homogeneous S d b) (α : Fin n → ℕ) :
    Homogeneous S (d - ∑ i, (α i : ℤ)) (symbolMultiDeriv symbolFrequencyDeriv α b) := by
  have hi : ∀ (i : Fin n) (m : ℕ) (d : ℤ) (b : NativeSymbol n),
      SymbolContMDiffOn S ω b → Homogeneous S d b →
      SymbolContMDiffOn S ω ((symbolFrequencyDeriv i)^[m] b) ∧
      Homogeneous S (d - (m : ℤ)) ((symbolFrequencyDeriv i)^[m] b) := by
    intro i m
    induction m with
    | zero => intro d b hA hb; exact ⟨hA, by simpa using hb⟩
    | succ m ih =>
      intro d b hA hb
      obtain ⟨hA', hh⟩ := ih d b hA hb
      rw [Function.iterate_succ_apply']
      refine ⟨symbolFrequencyDeriv_contMDiffOn S.isOpen hA' le_top i, ?_⟩
      have h := frequencyDeriv_homogeneous hh
        (fun _ hz _ hξ => frequency_slice_differentiable hA' hz hξ) i
      simpa only [Nat.cast_add, Nat.cast_one, sub_sub] using h
  have hl : ∀ (l : List (Fin n)) (d : ℤ) (b : NativeSymbol n),
      SymbolContMDiffOn S ω b → Homogeneous S d b →
      Homogeneous S (d - (l.map (fun i => (α i : ℤ))).sum)
        (l.foldl (fun f i => (symbolFrequencyDeriv i)^[α i] f) b) := by
    intro l
    induction l with
    | nil => intro d b hA hb; simpa using hb
    | cons i l ih =>
      intro d b hA hb
      obtain ⟨hA', hh⟩ := hi i (α i) d b hA hb
      have h := ih (d - (α i : ℤ)) _ hA' hh
      simpa only [List.map_cons, List.sum_cons, List.foldl_cons, sub_sub] using h
  simpa only [symbolMultiDeriv, ← List.sum_toFinset _ (List.nodup_finRange n),
    List.toFinset_finRange] using hl (List.finRange n) d b hA hb

