without_proof_info in
theorem coordinate_mem_closure_innerCap_inf (D : Opens V)
    (hDU : (D : Set V) ⊆ ball (extChartAt Ihalf c c) L.bump.rIn)
    {z : V} (hzR : z ∈ range Ihalf) (hzD : z ∈ D) :
    z ∈ closure ((L.innerCap ⊓ D : Opens V) : Set V) := by
  have heq : (D : Set V) ∩ interior (range Ihalf) = ((L.innerCap ⊓ D : Opens V) : Set V) := by
    ext y
    constructor
    · rintro ⟨hyD, hyI⟩
      exact ⟨⟨hDU hyD, hyI⟩, hyD⟩
    · rintro ⟨⟨_, hyI⟩, hyD⟩
      exact ⟨hyD, hyI⟩
