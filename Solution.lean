/- Quantitative normalization of the actual mixed Leibniz terms. The
normal/tangential weights are different so leading tangential derivatives
are absorbed while inducting only on normal order. -/
open scoped BigOperators
namespace ConformalPoisson

set_option maxHeartbeats 600000 in
without_proof_info in
theorem normal_majorant_power_identity
    {A B C : ℝ} (hB : 0 < B) (hC : 0 < C)
    (p q a b k ell : ℕ) (ha : a ≤ p) (hb : b ≤ q) (hell : ell ≤ 2) :
    B ^ (p - a + k) * C ^ (q - b + ell) * A ^ (a + b) =
      B ^ p * C ^ (q + 2) * (B ^ k / C ^ (2 - ell)) * (A / B) ^ a * (A / C) ^ b := by
  have hBp : B ^ p = B ^ (p - a) * B ^ a := by rw [← pow_add]; congr 1; omega
  have hCq : C ^ (q + 2) = C ^ (q - b + ell) * C ^ (2 - ell) * C ^ b := by
    rw [← pow_add, ← pow_add]
    congr 1
    omega
  rw [hBp, hCq, pow_add B (p - a) k, pow_add A a b, div_pow, div_pow]
  field_simp
  <;> ring

set_option maxHeartbeats 600000 in
without_proof_info in
theorem mixedLeibniz_majorant_term_le
    {A B C L M D : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hC : 0 < C)
    (hL : 0 ≤ L) (hM : 0 ≤ M)
    (p q a b k ell : ℕ) (ha : a ≤ p) (hb : b ≤ q) (hell : ell ≤ 1)
    (hkell : k + ell ≤ 2)
    (hD : D ≤ M * B ^ (p - a + k) * C ^ (q - b + ell) *
      ((p - a + k + (q - b + ell)).factorial : ℝ)) :
    (p.choose a : ℝ) * (q.choose b : ℝ) *
      (L * A ^ (a + b) * ((a + b).factorial : ℝ)) * D ≤
      (M * B ^ p * C ^ (q + 2) * ((p + q + 2).factorial : ℝ)) *
        (L * (B ^ k / C ^ (2 - ell))) * (A / B) ^ a * (A / C) ^ b := by
  have hfactorial : (p.choose a : ℝ) * (q.choose b : ℝ) * ((a + b).factorial : ℝ) *
      ((p - a + k + (q - b + ell)).factorial : ℝ) ≤ ((p + q + 2).factorial : ℝ) := by
    have h := mixedLeibniz_factorial_le p q a b k ell ha hb hkell
    have hindex : p - a + (q - b) + k + ell = p - a + k + (q - b + ell) := by omega
    rw [hindex] at h
    exact_mod_cast h
  have hweight : 0 ≤ (p.choose a : ℝ) * (q.choose b : ℝ) *
      (L * A ^ (a + b) * ((a + b).factorial : ℝ)) := by positivity
  calc
    _ ≤ (p.choose a : ℝ) * (q.choose b : ℝ) *
        (L * A ^ (a + b) * ((a + b).factorial : ℝ)) *
        (M * B ^ (p - a + k) * C ^ (q - b + ell) *
          ((p - a + k + (q - b + ell)).factorial : ℝ)) :=
      mul_le_mul_of_nonneg_left hD hweight
    _ = (L * M * (B ^ (p - a + k) * C ^ (q - b + ell) * A ^ (a + b))) *
        ((p.choose a : ℝ) * (q.choose b : ℝ) * ((a + b).factorial : ℝ) *
          ((p - a + k + (q - b + ell)).factorial : ℝ)) := by ring
    _ ≤ (L * M * (B ^ (p - a + k) * C ^ (q - b + ell) * A ^ (a + b))) *
        ((p + q + 2).factorial : ℝ) := mul_le_mul_of_nonneg_left hfactorial (by positivity)
    _ = _ := by
      rw [normal_majorant_power_identity hB hC p q a b k ell ha hb (by omega)]
      ring

without_proof_info in
theorem normal_majorant_forcing_le_half
    {A B C F M : ℝ} (hA : 0 ≤ A) (hB : 0 < B) (hC : 0 < C)
    (hF : 0 ≤ F) (hFM : F ≤ M) (hAB : A ≤ B) (hAC : A ≤ C)
    (hC2 : 2 ≤ C ^ 2) (p q : ℕ) :
    F * A ^ (p + q) * ((p + q).factorial : ℝ) ≤
      (1 / 2) * (M * B ^ p * C ^ (q + 2) * ((p + q + 2).factorial : ℝ)) := by
  have hM : 0 ≤ M := hF.trans hFM
  have hpow : A ^ (p + q) ≤ B ^ p * C ^ q := by
    rw [pow_add]
    exact mul_le_mul (pow_le_pow_left₀ hA hAB p) (pow_le_pow_left₀ hA hAC q)
      (pow_nonneg hA q) (pow_nonneg hB.le p)
  have hcoeff : F * A ^ (p + q) ≤ M * (B ^ p * C ^ q) :=
    mul_le_mul hFM hpow (pow_nonneg hA _) hM
  have hfac : ((p + q).factorial : ℝ) ≤ ((p + q + 2).factorial : ℝ) := by
    exact_mod_cast Nat.factorial_le (show p + q ≤ p + q + 2 by omega)
  let K : ℝ := M * B ^ p * C ^ q * ((p + q + 2).factorial : ℝ)
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have hscale : M * B ^ p * C ^ (q + 2) * ((p + q + 2).factorial : ℝ) = K * C ^ 2 := by
    dsimp [K]
    rw [pow_add]
    ring
  calc
    _ ≤ M * (B ^ p * C ^ q) * ((p + q + 2).factorial : ℝ) :=
      mul_le_mul hcoeff hfac (Nat.cast_nonneg _) (by positivity)
    _ = K := by dsimp [K]; ring
    _ ≤ _ := by
      rw [hscale]
      nlinarith [mul_nonneg hK (sub_nonneg.mpr hC2)]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_NormalMajorantPowerBounds

/- Boundary analytic support: FactorialNormalMajorant.lean, SHA256 5942bfc73cf12c26f29054623863b58eb385314724511f8e943eab7745281e91 -/
noncomputable section ProofPart_BoundaryAnalytic_FactorialNormalMajorant


/- Sufficient factorial estimates for the mixed normal-form recurrence.
The proof inducts on normal order only, uniformly in tangential order. -/
open scoped BigOperators
namespace ConformalPoisson

set_option maxHeartbeats 1800000 in
without_proof_info in
theorem factorial_normal_majorant_of_recurrence
    {ι : Type*} [Fintype ι]
    (D : ℕ → ℕ → ℝ) (k ell : ι → ℕ) (L : ι → ℝ) (A B C F M : ℝ)
    (hA : 0 ≤ A) (hB : 0 < B) (hC : 0 < C) (hF : 0 ≤ F) (hFM : F ≤ M)
    (hAB2 : 2 * A ≤ B) (hAC2 : 2 * A ≤ C) (hC2 : 2 ≤ C ^ 2)
    (hL : ∀ i, 0 ≤ L i) (hell : ∀ i, ell i ≤ 1) (hkell : ∀ i, k i + ell i ≤ 2)
    (hweights : ∑ i, L i * (B ^ k i / C ^ (2 - ell i)) ≤ 1 / 8)
    (hbase : ∀ p j, j ≤ 1 → D p j ≤ M * B ^ p * C ^ j * ((p + j).factorial : ℝ))
    (hrec : ∀ p q, D p (q + 2) ≤ F * A ^ (p + q) * ((p + q).factorial : ℝ) +
      ∑ i, ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
        (p.choose a : ℝ) * (q.choose b : ℝ) *
          (L i * A ^ (a + b) * ((a + b).factorial : ℝ)) *
          D (p - a + k i) (q - b + ell i)) :
    ∀ p j, D p j ≤ M * B ^ p * C ^ j * ((p + j).factorial : ℝ) := by
  classical
  have hM : 0 ≤ M := hF.trans hFM
  have hr0 : 0 ≤ A / B := div_nonneg hA hB.le
  have hs0 : 0 ≤ A / C := div_nonneg hA hC.le
  have hr : A / B ≤ 1 / 2 := (div_le_iff₀ hB).mpr (by linarith)
  have hs : A / C ≤ 1 / 2 := (div_le_iff₀ hC).mpr (by linarith)
  intro p j
  induction j using Nat.strong_induction_on generalizing p with
  | ind j ih =>
    by_cases hj : j ≤ 1
    · exact hbase p j hj
    · obtain ⟨q, rfl⟩ : ∃ q, j = q + 2 := ⟨j - 2, by omega⟩
      let N : ℝ := M * B ^ p * C ^ (q + 2) * ((p + q + 2).factorial : ℝ)
      let ρ : ι → ℝ := fun i => L i * (B ^ k i / C ^ (2 - ell i))
      have hN : 0 ≤ N := by dsimp [N]; positivity
      have hρ (i : ι) : 0 ≤ ρ i := by
        have hi := hL i
        dsimp [ρ]
        positivity
      have hinner (i : ι) :
          (∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
            (p.choose a : ℝ) * (q.choose b : ℝ) *
              (L i * A ^ (a + b) * ((a + b).factorial : ℝ)) *
              D (p - a + k i) (q - b + ell i)) ≤ N * ρ i * 4 := by
        calc
          _ ≤ ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
              N * ρ i * (A / B) ^ a * (A / C) ^ b := by
            apply Finset.sum_le_sum
            intro a ha
            apply Finset.sum_le_sum
            intro b hb
            have ha' : a ≤ p := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)
            have hb' : b ≤ q := Nat.lt_succ_iff.mp (Finset.mem_range.mp hb)
            have horder : q - b + ell i < q + 2 := by have := hell i; omega
            exact mixedLeibniz_majorant_term_le hA hB hC (hL i) hM
              p q a b (k i) (ell i) ha' hb' (hell i) (hkell i)
              (ih (q - b + ell i) horder (p - a + k i))
          _ = (N * ρ i) *
              (∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
                (A / B) ^ a * (A / C) ^ b) := by
            simp only [Finset.mul_sum, mul_assoc]
          _ ≤ N * ρ i * 4 := mul_le_mul_of_nonneg_left
            (double_geometric_sum_le_four hr0 hr hs0 hs p q) (mul_nonneg hN (hρ i))
      have hforcing : F * A ^ (p + q) * ((p + q).factorial : ℝ) ≤ (1 / 2) * N :=
        normal_majorant_forcing_le_half hA hB hC hF hFM (by linarith) (by linarith) hC2 p q
      have hsum : (∑ i, N * ρ i * 4) ≤ N * (1 / 2) := by
        calc
          _ = N * (4 * ∑ i, ρ i) := by
            rw [← Finset.sum_mul, ← Finset.mul_sum]
            ring
          _ ≤ _ := mul_le_mul_of_nonneg_left (by dsimp [ρ]; linarith) hN
      calc
        D p (q + 2) ≤ F * A ^ (p + q) * ((p + q).factorial : ℝ) +
            ∑ i, ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
              (p.choose a : ℝ) * (q.choose b : ℝ) *
                (L i * A ^ (a + b) * ((a + b).factorial : ℝ)) *
                D (p - a + k i) (q - b + ell i) := hrec p q
        _ ≤ (1 / 2) * N + ∑ i, N * ρ i * 4 :=
          add_le_add hforcing (Finset.sum_le_sum (fun i _ => hinner i))
        _ ≤ N := by linarith

end ConformalPoisson

end ProofPart_BoundaryAnalytic_FactorialNormalMajorant

