/- Assignment268, /root. Scalar drift comparison is the coefficient-level
part of the frozen firstOrderSymbol_jetComparison argument. Its existing
local hcoeff calculation is reused here at the actual scalar caller; the
frozen original declaration is preserved. No next inverse-metric jet is used. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}
  {W : Set (EuclideanSpace ℝ (Fin n))} {L : ℕ}

without_proof_info in
theorem metricTangentialDrift_jetComparison (F₁ F₂ : NormalMetricField S)
    (hW : IsOpen W) (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hG₁ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₁.gram S)
    (hG₂ : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, Matrix (Fin n) (Fin n) ℝ) ω F₂.gram S)
    (hA : BoundaryJetComparison S W L F₁.inverse F₂.inverse) (a : Fin n) :
    BoundaryJetComparison S W L (metricTangentialDrift F₁ a) (metricTangentialDrift F₂ a) := by
  have hG : BoundaryJetComparison S W L F₁.gram F₂.gram := by
    refine ⟨hG₁, hG₂, ?_⟩
    intro k hk y hy
    exact F₁.inverse_jet_transfer F₂ (hWS hy) L (fun r hr => hA.jets r hr hy) k hk
  have hDA := fun i => hA.tangential S.isOpen hW hWS (EuclideanSpace.single i 1)
  have hDG := fun i => hG.tangential S.isOpen hW hWS (EuclideanSpace.single i 1)
  have htrace := fun i => (hA.bilinear S.isOpen hWS (hDG i) normalMatrixMultiplication).clm
    S.isOpen hWS (normalMatrixTrace (n := n))
  have hcoeff := fun b => ((hDA b).clm S.isOpen hWS (normalMatrixEntry b a)).add S.isOpen hWS
    (((BoundaryJetComparison.const (S := (S : Set _)) (W := W) (L := L) (1 / 2 : ℝ)).bilinear
      S.isOpen hWS (hA.clm S.isOpen hWS (normalMatrixEntry b a))
      (ContinuousLinearMap.mul ℝ ℝ)).bilinear S.isOpen hWS (htrace b) (ContinuousLinearMap.mul ℝ ℝ))
  exact BoundaryJetComparison.sum Finset.univ S.isOpen hWS (fun b _ => hcoeff b)

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNTangentialDriftJetComparison

