    (I := K)
    (G := fun i a r => G.kernel ((extChartAt K (points i)).symm a) r)
    (x := fun i => extChartAt K (points i) (points i))
    (hG := fun i => G.contMDiffAt_chartKernel g q ν S (hpoints i) (hxy i)) L (ν y)
  have hround (i : ι) : (extChartAt K (points i)).symm
      (extChartAt K (points i) (points i)) = points i :=
    (extChartAt K (points i)).left_inv (mem_extChartAt_source (points i))
