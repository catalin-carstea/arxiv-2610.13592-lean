    exact ((nativeCoordinateFlux_contDiffOn g α X hX z ht).mono_of_mem_nhdsWithin hn).congr_of_eventuallyEq heq (indicator_of_mem ht _)
  · have hzK : z ∉ extChartAt Ihalf α '' tsupport (α := V) X := by
      rintro ⟨x, hx, rfl⟩
      exact ht ((extChartAt Ihalf α).map_source (hKs hx))
    have heq : supportedNativeCoordinateFlux g α X =ᶠ[𝓝 z] 0 :=
      Filter.eventually_of_mem (hKc.isClosed.isOpen_compl.mem_nhds hzK)
        (fun _ hw => supportedNativeCoordinateFlux_eq_zero g α X hw)
    exact (contDiffAt_const.congr_of_eventuallyEq heq).contDiffWithinAt

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem supportedNativeCoordinateFlux_divergence
    (g : Metric (n := n) (M := M)) (α : M)
    (X : (x : M) → TangentSpace Ihalf x)
    (hX : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) 1
      (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M)))
    (hK : IsCompact (tsupport (α := V) X))
    (hKs : tsupport (α := V) X ⊆ (extChartAt Ihalf α).source)
    {z : V} (hz : z ∈ interior (range Ihalf)) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
      IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
    LinearMap.trace ℝ V (fderivWithin ℝ (supportedNativeCoordinateFlux g α X) (range Ihalf) z) =
      (extChartAt Ihalf α).target.indicator (fun w =>
        nativeStandardChartDensity g α ((extChartAt Ihalf α).symm w) *
          divergence Ihalf X ((extChartAt Ihalf α).symm w)) z := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  have hT : range Ihalf ∈ 𝓝 z := mem_of_superset (isOpen_interior.mem_nhds hz) interior_subset
  rw [fderivWithin_of_mem_nhds hT]
  by_cases ht : z ∈ (extChartAt Ihalf α).target
  · have hn : (extChartAt Ihalf α).target ∈ 𝓝 z := by
      simpa only [nhdsWithin_eq_nhds.mpr hT] using extChartAt_target_mem_nhdsWithin_of_mem ht
    have heq : supportedNativeCoordinateFlux g α X =ᶠ[𝓝 z] nativeCoordinateFlux g α X :=
      Filter.eventually_of_mem hn (fun _ hw => indicator_of_mem hw _)
    rw [heq.fderiv_eq, indicator_of_mem ht]
    exact nativeCoordinateFlux_divergence g α X hX (mem_interior_iff_mem_nhds.mpr hn)
  · have hKc := hK.image_of_continuousOn ((continuousOn_extChartAt α).mono hKs)
    have hzK : z ∉ extChartAt Ihalf α '' tsupport (α := V) X := by
      rintro ⟨x, hx, rfl⟩
      exact ht ((extChartAt Ihalf α).map_source (hKs hx))
    have heq : supportedNativeCoordinateFlux g α X =ᶠ[𝓝 z] 0 :=
      Filter.eventually_of_mem (hKc.isClosed.isOpen_compl.mem_nhds hzK)
        (fun _ hw => supportedNativeCoordinateFlux_eq_zero g α X hw)
    rw [heq.fderiv_eq, fderiv_zero, Pi.zero_apply, indicator_of_notMem ht]
    exact map_zero _
end ConformalPoisson

