/- First-order extension across the physical flat face for the exact
Euclidean chart model and every Sobolev exponent. The source Haar
normalization is arbitrary; the whole-space output uses canonical
volume, so the standard Sobolev and Morrey embeddings apply directly. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {p : ℝ≥0∞} [Fact (1 ≤ p)]
local notation "X" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

without_proof_info in
theorem exists_wholeSpace_extension_euclidean_halfSpace
    (u : W1p μ (euclideanOpenHalfSpace n 0) p) :
    ∃ Z : W1p (volume : Measure X) ⊤ p,
      W1p.value Z =ᵐ[μ.restrict (euclideanOpenHalfSpace n 0 : Set X)] W1p.value u := by
  let e := euclideanNormalSplit n
  let H := euclideanOpenHalfSpace n 0
  let HP := normalHalfSpace (E := EuclideanSpace ℝ (Fin n)) 0
  let uV := haarChangeW1pL μ volume H u
  let uP := Wkp.compLinearIsometryEquiv (p := p) e.measurePreserving
    (normalSplit_preimage_halfSpace n 0) 1 uV
  have huP : W1p.value uP =ᵐ[volume.restrict (HP : Set P)]
      fun x => W1p.value uV (e x) := by
    simpa only [Wkp.value_one] using Wkp.value_compLinearIsometryEquiv_ae e.measurePreserving
      (normalSplit_preimage_halfSpace n 0) 1 uV
  let ZP := W1p.extendByReflectionL 0 uP
  have hZP : W1p.value ZP =ᵐ[volume.restrict (HP : Set P)] W1p.value uP := by
    have h := W1p.value_restrictL_ae (le_top : HP ≤ ⊤) ZP
    rw [W1p.restrictL_extendByReflectionL] at h
    exact h.symm
  have htop : (⊤ : Set X) = e.symm ⁻¹' (⊤ : Set P) := by simp
  let Z := Wkp.compLinearIsometryEquiv (p := p) (U := (⊤ : Opens X)) (W := (⊤ : Opens P))
    e.symm.measurePreserving htop 1 ZP
  have hZ : W1p.value Z =ᵐ[(volume : Measure X)] fun x => W1p.value ZP (e.symm x) := by
    have h := Wkp.value_compLinearIsometryEquiv_ae (U := (⊤ : Opens X)) (W := (⊤ : Opens P))
      e.symm.measurePreserving htop 1 ZP
    simpa only [Wkp.value_one, Opens.coe_top, Measure.restrict_univ] using h
  have hInvH : (H : Set X) = e.symm ⁻¹' (HP : Set P) := by
    ext x
    change 0 < x 0 ↔ e.symm x ∈ normalHalfSpace (E := EuclideanSpace ℝ (Fin n)) 0
    rw [mem_normalHalfSpace]
    change 0 < x 0 ↔ 0 < ((euclideanNormalSplit n).symm x).fst
    rw [euclideanNormalSplit_symm_fst]
  have heH : MeasurePreserving e.symm ((volume : Measure X).restrict H)
      ((volume : Measure P).restrict HP) :=
    hInvH ▸ e.symm.measurePreserving.restrict_preimage HP.isOpen.measurableSet
  have hsame : W1p.value Z =ᵐ[(volume : Measure X).restrict H] W1p.value uV := by
    filter_upwards [ae_restrict_of_ae hZ, heH.quasiMeasurePreserving.ae (hZP.trans huP)] with x hz hx
    simpa only [LinearIsometryEquiv.apply_symm_apply] using hz.trans hx
  have hμ : μ.restrict H ≪ (volume : Measure X).restrict H :=
    haar_restrict_absolutelyContinuous (μ := volume) (ν := μ) H
  exact ⟨Z, hμ.ae_eq (hsame.trans (haarChangeW1pL_value_ae (ν := volume) u))⟩
