/- Proof support: BallHessianRegularityProved.lean, SHA256 046f62e4853f25b0efad2f0dd178db36b45f23c6df07416dcedeff7b5cb4712a -/
noncomputable section ProofPart_BallHessianRegularityProved






/- Global Holder regularity of the actual Hessian for the classical
zero-Dirichlet ball solution. Boundary caps use the proved Kelvin
argument in two charts; interior neighborhoods use pinned Schauder
regularity. A relative compact-cover argument supplies one finite
constant on the whole open ball. -/
open Set Metric Filter TopologicalSpace TauCeti TauCeti.PDE
open scoped NNReal ContDiff Laplacian Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem ballHessianRegularity (hα : 0 < α) (hαlt : α < 1) : BallHessianRegularity (n + 1) α := by
  intro f u hu hc hzero heq
  have hF := holderOnWith_domainRead_closedBall f
  have hΔ : ∀ x ∈ ball (0 : V) 1, ∃ T ∈ 𝓝 x, ∃ K : ℝ≥0, HolderOnWith K α (Δ u) T := by
    intro x hx
    refine ⟨ball 0 1, isOpen_ball.mem_nhds hx, ‖f‖₊, HolderOnWith.of_dist_le ?_⟩
    intro y hy z hz
    have hdy : Δ u y = -domainRead (closedBall 0 1) f y := by linarith [heq y hy]
    have hdz : Δ u z = -domainRead (closedBall 0 1) f z := by linarith [heq z hz]
    rw [hdy, hdz, dist_neg_neg]
    exact hF.dist_le (ball_subset_closedBall hy) (ball_subset_closedBall hz)
  apply exists_holderOnWith_of_compact_relative_cover (isCompact_closedBall (0 : V) 1) ball_subset_closedBall
  intro p hp
  by_cases hpB : p ∈ ball (0 : V) 1
  · obtain ⟨T, hTp, K, hK⟩ := exists_mem_nhds_holderOnWith_iteratedFDeriv_two_of_laplacian
      hαlt isOpen_ball hu hΔ hpB
    obtain ⟨δ, hδ, hδT⟩ := Metric.mem_nhds_iff.mp hTp
    have hH : HolderOnWith K α (fderiv ℝ (fderiv ℝ u)) T :=
      (holderOnWith_fderiv_fderiv_iff_iteratedFDeriv_two u).mpr hK
    exact ⟨δ, hδ, K, hH.mono (fun y hy => hδT hy.1)⟩
  · have hpS : p ∈ sphere (0 : V) 1 := by
      change dist p 0 = 1
      change ¬dist p 0 < 1 at hpB
      exact le_antisymm (show dist p 0 ≤ 1 from hp) (le_of_not_gt hpB)
    exact SphereFlattening.exists_local_holderOnWith_hessian_on_sphere hα hαlt f u hu hc hzero heq hpS

without_proof_info in
theorem localSchauderDirichlet (n : ℕ) : LocalSchauderDirichletAssumption (n + 1) :=
  localSchauder_of_ball_hessian_regularity (fun β hβ hβlt => ballHessianRegularity hβ hβlt)
end ConformalPoisson.DirichletHolder

end ProofPart_BallHessianRegularityProved

/- Sole selected open claim. -/
noncomputable section
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

variable [CompactSpace M₁] [CompactSpace M₂]
  [MeasurableSpace M₁] [BorelSpace M₁] [MeasurableSpace M₂] [BorelSpace M₂]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₁)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₁)]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M₂)] [BorelSpace ((𝓡∂ (n + 1)).boundary M₂)]

local instance priorNineBoundaryCompact₁ : CompactSpace ((𝓡∂ (n + 1)).boundary M₁) := compactSpace_nativeBoundary
local instance priorNineBoundaryCompact₂ : CompactSpace ((𝓡∂ (n + 1)).boundary M₂) := compactSpace_nativeBoundary

set_option maxHeartbeats 2000000 in
without_proof_info in
theorem theorem_1_1_nine_inputs
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hBoundaryReg₁ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₁))
    (hBoundaryReg₂ : BoundaryAnalyticRegularityAssumption (n := n) (M := M₂))
    (hGreen₁ : GreenKernelAssumption (n := n) (M := M₁))
    (hGreen₂ : GreenKernelAssumption (n := n) (M := M₂))
    (hEstimate₁ : NormalTraceInverseEstimateAssumption (n := n) (M := M₁))
    (hEstimate₂ : NormalTraceInverseEstimateAssumption (n := n) (M := M₂))
    (hSymbol : letI : SecondCountableTopology M₁ := native_secondCountable_of_compact (n := n) isCompact_univ
      letI : SecondCountableTopology M₂ := native_secondCountable_of_compact (n := n) isCompact_univ
      LocalizedDNSymbolAssumption (n := n) (M₁ := M₁) (M₂ := M₂))
    (hn : 2 ≤ n)
    (hconnected₁ : IsConnected (univ : Set M₁)) (hconnected₂ : IsConnected (univ : Set M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) : TheoremOneOneResult A₁ A₂ V₁ V₂ D := by
  -- Name the conditional caller before applying its proved analytical inputs.
  -- This preserves the frozen export's binder names under expression sharing.
  have assemble
      (hSchauder : LocalSchauderDirichletAssumption (n + 1))
      (hInverse₁ : ForwardInhomogeneousAssumption (n := n) (M := M₁))
      (hInverse₂ : ForwardInhomogeneousAssumption (n := n) (M := M₂)) :
      TheoremOneOneResult A₁ A₂ V₁ V₂ D := by
    exact theorem_1_1_with_analytic_runge
      hSchauder
      (analytic_finite_jet_runge_for_all_operators hReg₁ hGreen₁ hInverse₁)
      (analytic_finite_jet_runge_for_all_operators hReg₂ hGreen₂ hInverse₂)
      hReg₁ hReg₂ hBoundaryReg₁ hBoundaryReg₂ hGreen₁ hGreen₂
      hInverse₁ hInverse₂ hEstimate₁ hEstimate₂ hSymbol hn hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D
  exact assemble (DirichletHolder.localSchauderDirichlet n)
    forwardInhomogeneous forwardInhomogeneous
end ConformalPoisson
end

