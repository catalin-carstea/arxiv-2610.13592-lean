noncomputable section ProofPart_H2CarlemanDensity



/- A weighted coercivity inequality for smooth tests passes to the
actual H2-zero-trace graph by continuity of the same coefficient
operator and the same weight. The geometric smooth-test estimate and
its coordinate/volume identification must supply the test hypothesis. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ENNReal InnerProductSpace Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}
  {ι : Type*} [Fintype ι]

without_proof_info in
theorem h2_weighted_coercivity_of_test_coercivity (e : ι → E)
    (a : ι → ι → Lp ℝ ∞ (μ.restrict Ω)) (b : ι → Lp ℝ ∞ (μ.restrict Ω))
    (q w : Lp ℝ ∞ (μ.restrict Ω)) (C : ℝ)
    (h : ∀ ψ : 𝓓(Ω, ℝ),
      C * ‖h2ScalarMultiplier w (Wkp.valueL 2 (Wkp.ofTestFunctionₗ 2 ψ))‖ ^ 2 ≤
        ‖h2ScalarMultiplier w (h2CoefficientOperator e a b q (Wkp.ofTestFunctionₗ 2 ψ))‖ ^ 2)
    (u : Wkp μ Ω 2 2) (hu : u ∈ wkp0Submodule μ Ω 2 2) :
    C * ‖h2ScalarMultiplier w (Wkp.valueL 2 u)‖ ^ 2 ≤
      ‖h2ScalarMultiplier w (h2CoefficientOperator e a b q u)‖ ^ 2 := by
  let S : Set (Wkp μ Ω 2 2) := {v |
    C * ‖h2ScalarMultiplier w (Wkp.valueL 2 v)‖ ^ 2 ≤
      ‖h2ScalarMultiplier w (h2CoefficientOperator e a b q v)‖ ^ 2}
  have hS : IsClosed S :=
    isClosed_le
      (continuous_const.mul (((h2ScalarMultiplier w).comp (Wkp.valueL 2)).continuous.norm.pow 2))
      (((h2ScalarMultiplier w).comp (h2CoefficientOperator e a b q)).continuous.norm.pow 2)
  have htest : Set.range (Wkp.ofTestFunctionₗ (mu := μ) (Omega := Ω) (p := 2) 2) ⊆ S := by
    rintro v ⟨ψ, rfl⟩
    exact h ψ
  have hclosure : u ∈ closure (Set.range (Wkp.ofTestFunctionₗ (mu := μ) (Omega := Ω) (p := 2) 2)) := by
    rwa [← coe_wkp0Submodule]
  exact (closure_minimal htest hS) hclosure
end ConformalPoisson

end ProofPart_H2CarlemanDensity

/- Proof support: CarlemanL2Readings.lean, SHA256 71c386b979bb4be48777312026bc687b426c627d8f573b219e19802cbbb548d3 -/
noncomputable section ProofPart_CarlemanL2Readings


/- The real L2 pairings and norms read from actual representatives.
These identities bridge the proved integral commutator to the
Hilbert-space Carleman absorption estimate. -/
open MeasureTheory Filter
open scoped InnerProductSpace
namespace ConformalPoisson
variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

without_proof_info in
theorem inner_L2_eq_integral_of_ae {F G : Lp ℝ 2 μ} {f g : X → ℝ}
    (hF : F =ᵐ[μ] f) (hG : G =ᵐ[μ] g) :
    ⟪F, G⟫_ℝ = ∫ x, f x * g x ∂μ := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [hF, hG] with x hx hy
  simp [hx, hy, mul_comm]

without_proof_info in
theorem normSq_L2_eq_integral_of_ae {F : Lp ℝ 2 μ} {f : X → ℝ} (hF : F =ᵐ[μ] f) :
    ‖F‖ ^ 2 = ∫ x, f x ^ 2 ∂μ := by
  rw [← real_inner_self_eq_norm_sq, inner_L2_eq_integral_of_ae hF hF]
  simp only [pow_two]
end ConformalPoisson

end ProofPart_CarlemanL2Readings

/- Proof support: H2CarlemanIntegral.lean, SHA256 b7994d7135de53e9f27f519bc601b1efc1ad5021f84671e823f8e803c91c7aae -/
noncomputable section ProofPart_H2CarlemanIntegral




/- The weighted integral inequality passes from actual coordinate
smooth tests to H2_0, with the same constructed coefficients and
weight. The remaining geometric bridge identifies the smooth-test
integrals here with the proved ambient Riemannian estimate. -/
open Set MeasureTheory TopologicalSpace TauCeti Filter
open scoped ENNReal InnerProductSpace ContDiff Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}

without_proof_info in
theorem normSq_h2ScalarMultiplier_eq_integral
    (w : Lp ℝ ∞ (μ.restrict Ω)) (v : Lp ℝ 2 (μ.restrict Ω))
    {weight f : E → ℝ} (hw : w =ᵐ[μ.restrict Ω] weight) (hv : v =ᵐ[μ.restrict Ω] f) :
    ‖h2ScalarMultiplier w v‖ ^ 2 = ∫ x, weight x ^ 2 * f x ^ 2 ∂μ.restrict Ω := by
  have hread : h2ScalarMultiplier w v =ᵐ[μ.restrict Ω] fun x => weight x * f x := by
    filter_upwards [h2ScalarMultiplier_ae w v, hw, hv] with x hx hwx hvx
    rw [hx, hwx, hvx]
  rw [normSq_L2_eq_integral_of_ae hread]
  apply integral_congr_ae
  exact Eventually.of_forall fun x => mul_pow (weight x) (f x) 2

without_proof_info in
theorem integrable_sq_h2ScalarMultiplier_reading
    (w : Lp ℝ ∞ (μ.restrict Ω)) (v : Lp ℝ 2 (μ.restrict Ω))
    {weight f : E → ℝ} (hw : w =ᵐ[μ.restrict Ω] weight) (hv : v =ᵐ[μ.restrict Ω] f) :
    Integrable (fun x => weight x ^ 2 * f x ^ 2) (μ.restrict Ω) := by
  apply (Lp.memLp (h2ScalarMultiplier w v)).integrable_sq.congr
  filter_upwards [h2ScalarMultiplier_ae w v, hw, hv] with x hx hwx hvx
  rw [hx, hwx, hvx, mul_pow]

section Euclidean
variable {d : ℕ} {ν : Measure (EuclideanSpace ℝ (Fin d))} [ν.IsAddHaarMeasure]
  {U : Opens (EuclideanSpace ℝ (Fin d))}
  {A : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d)}
  {B : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)}
  {Q : EuclideanSpace ℝ (Fin d) → ℝ}

set_option maxHeartbeats 800000 in
without_proof_info in
theorem h2_weightedIntegral_coercivity_of_test_coercivity
    (C : H2CoordinateCoefficients (ν := ν) (U := U) A B Q)
    (w : Lp ℝ ∞ (ν.restrict U)) {weight : EuclideanSpace ℝ (Fin d) → ℝ}
    (hw : w =ᵐ[ν.restrict U] weight) (c : ℝ)
    (h : ∀ ψ : 𝓓(U, ℝ),
      c * (∫ x, weight x ^ 2 * ψ x ^ 2 ∂ν.restrict U) ≤
        ∫ x, weight x ^ 2 * coordinateSchrodinger A B Q ψ x ^ 2 ∂ν.restrict U)
    (u : Wkp ν U 2 2) (hu : u ∈ wkp0Submodule ν U 2 2) :
    c * (∫ x, weight x ^ 2 * Wkp.value 2 u x ^ 2 ∂ν.restrict U) ≤
      ∫ x, weight x ^ 2 * C.operator u x ^ 2 ∂ν.restrict U := by
  have htest (ψ : 𝓓(U, ℝ)) :
      c * ‖h2ScalarMultiplier w (Wkp.valueL 2 (Wkp.ofTestFunctionₗ 2 ψ))‖ ^ 2 ≤
        ‖h2ScalarMultiplier w (C.operator (Wkp.ofTestFunctionₗ 2 ψ))‖ ^ 2 := by
    let v := Wkp.ofTestFunctionₗ (mu := ν) (p := 2) 2 ψ
    have hv : Wkp.value 2 v =ᵐ[ν.restrict U] (ψ : EuclideanSpace ℝ (Fin d) → ℝ) := by
      rw [Wkp.value_ofTestFunctionₗ]
      exact testFunctionLp_apply_ae (mu := ν) 2 ψ
    have hvL : Wkp.valueL 2 v =ᵐ[ν.restrict U] (ψ : EuclideanSpace ℝ (Fin d) → ℝ) := by
      rw [Wkp.valueL_apply]
      exact hv
    have hP := C.operator_of_contDiffOn v (ψ.contDiff.of_le (by simp)).contDiffOn hv
    have hleft := normSq_h2ScalarMultiplier_eq_integral w (Wkp.valueL 2 v) hw hvL
    have hright := normSq_h2ScalarMultiplier_eq_integral w (C.operator v) hw hP
    change c * ‖h2ScalarMultiplier w (Wkp.valueL 2 v)‖ ^ 2 ≤ ‖h2ScalarMultiplier w (C.operator v)‖ ^ 2
    rw [hleft, hright]
    exact h ψ
  have hresult := h2_weighted_coercivity_of_test_coercivity (EuclideanSpace.basisFun (Fin d) ℝ)
    C.principal C.drift C.potential w c htest u hu
  have hvL : Wkp.valueL 2 u =ᵐ[ν.restrict U] (Wkp.value 2 u : EuclideanSpace ℝ (Fin d) → ℝ) := by
    rw [Wkp.valueL_apply]
  have hleft := normSq_h2ScalarMultiplier_eq_integral w (Wkp.valueL 2 u) hw hvL
  have hright := normSq_h2ScalarMultiplier_eq_integral w (C.operator u) hw EventuallyEq.rfl
  change c * ‖h2ScalarMultiplier w (Wkp.valueL 2 u)‖ ^ 2 ≤ ‖h2ScalarMultiplier w (C.operator u)‖ ^ 2 at hresult
  rwa [hleft, hright] at hresult
end Euclidean
end ConformalPoisson

end ProofPart_H2CarlemanIntegral

