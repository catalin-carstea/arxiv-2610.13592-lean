noncomputable section ProofPart_InteriorAnalytic_HolderTranslationJacobian




/- The actual localized-translation Jacobian and its inverse in the
Holder Banach algebra.  A unit in this one algebra supplies the same inverse
at every spatial point, with no independently chosen pointwise witnesses. -/
open Set Filter
open scoped Topology NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {V X : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [CompleteSpace V]
  [MetricSpace X] {α : ℝ≥0}

def localizedTranslation (χ : V → ℝ) (a x : V) : V := x + χ x • a

def holderTranslationJacobian (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ))
    (a : V) : TauCeti.HolderSpace α X (V →L[ℝ] V) :=
  1 + (ContinuousLinearMap.smulRightL ℝ V V).compHolder₂ η
    (TauCeti.HolderSpace.const a)

without_proof_info in
@[simp] theorem holderTranslationJacobian_apply
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) (a : V) (x : X) (v : V) :
    holderTranslationJacobian η a x v = v + η x v • a := by
  simp [holderTranslationJacobian, ContinuousLinearMap.one_apply]

without_proof_info in
@[simp] theorem holderTranslationJacobian_zero
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) :
    holderTranslationJacobian η 0 = 1 := by
  ext x v
  simp

without_proof_info in
theorem analyticAt_holderTranslationJacobian
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) (a : V) :
    AnalyticAt ℝ (holderTranslationJacobian η) a := by
  let L : V →L[ℝ] TauCeti.HolderSpace α X (V →L[ℝ] V) :=
    ((ContinuousLinearMap.smulRightL ℝ V V).compHolder₂ η).comp
      TauCeti.HolderSpace.constL
  have hL : AnalyticAt ℝ (fun a =>
      (ContinuousLinearMap.smulRightL ℝ V V).compHolder₂ η
        (TauCeti.HolderSpace.const a)) a := by
    simpa only [L, Function.comp_def, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.coe_comp, TauCeti.HolderSpace.constL_apply] using L.analyticAt a
  exact analyticAt_const.add hL

def holderTranslationInverseJacobian
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) (a : V) :
    TauCeti.HolderSpace α X (V →L[ℝ] V) :=
  Ring.inverse (holderTranslationJacobian η a)

without_proof_info in
theorem analyticAt_holderTranslationInverseJacobian
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) :
    AnalyticAt ℝ (holderTranslationInverseJacobian η) 0 := by
  have hi : AnalyticAt ℝ
      (Ring.inverse : TauCeti.HolderSpace α X (V →L[ℝ] V) →
        TauCeti.HolderSpace α X (V →L[ℝ] V)) 1 :=
    analyticAt_inverse (𝕜 := ℝ) (A := TauCeti.HolderSpace α X (V →L[ℝ] V))
      (1 : (TauCeti.HolderSpace α X (V →L[ℝ] V))ˣ)
  exact hi.comp_of_eq (analyticAt_holderTranslationJacobian η 0)
    (holderTranslationJacobian_zero η)

without_proof_info in
theorem eventually_isUnit_holderTranslationJacobian
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) :
    ∀ᶠ a in 𝓝 (0 : V), IsUnit (holderTranslationJacobian η a) := by
  apply (analyticAt_holderTranslationJacobian η 0).continuousAt.eventually
  change {J : TauCeti.HolderSpace α X (V →L[ℝ] V) | IsUnit J} ∈
    𝓝 (holderTranslationJacobian η 0)
  rw [holderTranslationJacobian_zero]
  exact (Units.isOpen (R := TauCeti.HolderSpace α X (V →L[ℝ] V))).mem_nhds
    (isUnit_one : IsUnit (1 : TauCeti.HolderSpace α X (V →L[ℝ] V)))

without_proof_info in
theorem holderTranslationInverseJacobian_comp
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) {a : V}
    (ha : IsUnit (holderTranslationJacobian η a)) (x : X) :
    (holderTranslationInverseJacobian η a x).comp (holderTranslationJacobian η a x) =
      ContinuousLinearMap.id ℝ V := by
  ext v
  have h := congrArg (fun J : TauCeti.HolderSpace α X (V →L[ℝ] V) => J x v)
    (Ring.inverse_mul_cancel _ ha)
  simpa [holderTranslationInverseJacobian] using h

without_proof_info in
theorem holderTranslationJacobian_comp_inverse
    (η : TauCeti.HolderSpace α X (V →L[ℝ] ℝ)) {a : V}
    (ha : IsUnit (holderTranslationJacobian η a)) (x : X) :
    (holderTranslationJacobian η a x).comp (holderTranslationInverseJacobian η a x) =
      ContinuousLinearMap.id ℝ V := by
  ext v
  have h := congrArg (fun J : TauCeti.HolderSpace α X (V →L[ℝ] V) => J x v)
    (Ring.mul_inverse_cancel _ ha)
  simpa [holderTranslationInverseJacobian] using h

without_proof_info in
theorem hasFDerivAt_localizedTranslation (χ : V → ℝ) (a x : V)
    (hχ : DifferentiableAt ℝ χ x) :
    HasFDerivAt (localizedTranslation χ a)
      (ContinuousLinearMap.id ℝ V + (fderiv ℝ χ x).smulRight a) x :=
  (hasFDerivAt_id x).add (hχ.hasFDerivAt.smul_const a)

end ConformalPoisson

