    (by simpa only [← extChartAt_source (I := Ihalf)] using hys)
    (by simpa only [hround] using hzi) q
    ((hu.1.of_le (by simp)).contMDiffAt (x := (extChartAt Ihalf c).symm z))
  rw [hround, hu.2.1 _ hi] at heq
  have hs : ContDiffOn ℝ ∞ (u ∘ (extChartAt Ihalf c).symm) (extChartAt Ihalf c).target := by
    have hS : ContMDiffOn Ihalf 𝓘(ℝ) ∞ u (extChartAt Ihalf c).source := hu.1.contMDiffOn
    exact (hS.comp (contMDiffOn_extChartAt_symm c)
      (fun x hx => (extChartAt Ihalf c).map_target hx)).contDiffOn
  have h2 : ContDiffAt ℝ 2 (u ∘ (extChartAt Ihalf c).symm) z :=
    (hs.contDiffAt (mem_interior_iff_mem_nhds.mp hzi)).of_le (by simp)
  rw [coordinateSchrodinger_eq_negative_trace _ _ _ _ h2] at heq
  simp only [Function.comp_apply] at heq
  linarith
end Native
end ConformalPoisson

