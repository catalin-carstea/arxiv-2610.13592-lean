open scoped InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem matrixBilinearForm_one_eq_inner (x y : V) :
    matrixBilinearForm (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) x y = ⟪x, y⟫_ℝ := by
  rw [matrixBilinearForm_one_apply, EuclideanSpace.inner_eq_star_dotProduct]
  simp only [star_trivial]
  exact dotProduct_comm _ _

set_option maxHeartbeats 400000 in
without_proof_info in
theorem pullbackPrincipal_hyperplaneReflection_one (ν : V) (a : ℝ) (x : V) :
    pullbackPrincipal (hyperplaneReflection ν a) (fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) x = 1 := by
  let R := (ℝ ∙ ν)ᗮ.reflection
  have hbil (v w : V) : matrixBilinearForm
      (pullbackPrincipal (hyperplaneReflection ν a) (fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) x) v w =
      matrixBilinearForm (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) v w := by
    have hdet : (fderiv ℝ (hyperplaneReflection ν a) x).det ≠ 0 := by
      have h := abs_det_fderiv_hyperplaneReflection ν a x
      exact abs_ne_zero.1 (h.trans_ne one_ne_zero)
    have h := matrixBilinearForm_pullbackPrincipal
      (fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) hdet (R v) (R w)
    rw [abs_det_fderiv_hyperplaneReflection, one_mul] at h
    rw [fderiv_hyperplaneReflection, (Submodule.isSelfAdjoint_reflection _).adjoint_eq,
      LinearIsometryEquiv.coe_coe'', Submodule.reflection_reflection,
      Submodule.reflection_reflection] at h
    rw [matrixBilinearForm_one_eq_inner, R.inner_map_map, ← matrixBilinearForm_one_eq_inner] at h
    exact h
  ext i j
  simpa [matrixBilinearForm_apply] using
    hbil (EuclideanSpace.single i 1) (EuclideanSpace.single j 1)

without_proof_info in
theorem reflectPrincipal_one (ν : V) (a : ℝ) :
    reflectPrincipal ν a (fun _ => (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ)) = fun _ => 1 := by
  funext x
  by_cases hx : ⟪x, ν⟫_ℝ < a
  · rw [reflectPrincipal_of_lt hx, pullbackPrincipal_hyperplaneReflection_one]
  · exact reflectPrincipal_of_le (not_lt.1 hx)
end ConformalPoisson

