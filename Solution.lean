set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set MeasureTheory TauCeti Finset
open scoped Manifold ContDiff ENNReal
namespace ConformalPoisson.LocalDN.BoundaryLayerCoefficients
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem nativeBoundaryLayerApproximation_of_native_residuals
    (hM : IsCompact (univ : Set M)) (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) {K : Set Y} (hK : IsCompact K) (hKU : K ⊆ U) (a : Y → ℂ)
    (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (η : ContDiffBump (0 : ℝ)) (hη : η 0 = 1) (hdη : HasDerivAt η 0 0)
    (hcap : (nativeNormalCoordinates (n := n)) ⁻¹' (K ×ˢ tsupport η) ⊆ χ.source)
    (fr fi : ℝ → (𝓡∂ (n + 1)).boundary M → ℝ)
    (hfr : ∀ (h : ℝ) (N : ℕ) (y : (𝓡∂ (n + 1)).boundary M), (B.nativeWave χ a η N h y).re = fr h y)
    (hfi : ∀ (h : ℝ) (N : ℕ) (y : (𝓡∂ (n + 1)).boundary M), (B.nativeWave χ a η N h y).im = fi h y)
    (hres : ∀ N : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ h : ℝ, 0 < h → h ≤ 1 → ∀ x : M,
      ‖complexSchrodinger g q (B.nativeWave χ a η (N + 2) h) x‖ ≤ C * h ^ N)
    (y : Y) (hy : EuclideanHalfSpace.boundaryParam n y ∈ χ.source) :
    NativeBoundaryLayerApproximation g q χ fr fi ξ (EuclideanHalfSpace.boundaryParam n y)
      (fun j => B.traceCoefficient a j y) := by
  obtain ⟨CL, hCL, hLp⟩ := exists_paired_native_residualLp_bound hM g q hq
  intro N
  obtain ⟨C, hC, hresN⟩ := hres N
  let V (h : ℝ) := B.nativeWave χ a η (N + 2) h
  let Ur (h : ℝ) (x : M) := (V h x).re
  let Ui (h : ℝ) (x : M) := (V h x).im
  let Ct := ‖B.traceCoefficient a (N + 1) y‖ + ‖B.traceCoefficient a (N + 2) y‖
