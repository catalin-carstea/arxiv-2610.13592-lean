/- Green/trace proof support: LpFunctionalDensity.lean, SHA256 1524fbaa562d8f755bff5ba18ab0bf74e41821fbfe1da6f4afce46408af0b9f2 -/
noncomputable section ProofPart_GreenTrace_LpFunctionalDensity



/- Integral densities for scalar functionals bounded by an actual Lp reading.
The representation is obtained from Hahn--Banach and standard Lp duality. -/
open MeasureTheory
open scoped ENNReal
namespace ConformalPoisson
variable {X A : Type*} [MeasurableSpace X] {μ : Measure X} [SigmaFinite μ]
  [AddCommGroup A] [Module ℝ A]
  {p s : ℝ≥0∞} [Fact (1 ≤ p)] [Fact (1 ≤ s)] [s.HolderConjugate p]

without_proof_info in
theorem exists_lp_density_of_reading_bound
    (hp : 1 < p) (hpfin : p ≠ ∞)
    (J : A →ₗ[ℝ] Lp ℝ p μ) (f : A →ₗ[ℝ] ℝ)
    {C : ℝ} (hC : 0 ≤ C) (hbound : ∀ a, ‖f a‖ ≤ C * ‖J a‖) :
    ∃ k : Lp ℝ s μ, ‖k‖ ≤ C ∧ ∀ a,
      Integrable (fun x => k x * J a x) μ ∧ f a = ∫ x, k x * J a x ∂μ := by
  obtain ⟨L, hL, hLC⟩ := exists_functional_extension_of_reading_bound J f hC hbound
  obtain ⟨k, hk⟩ := Lp.toDual_surjective (p := s) hp hpfin L
  refine ⟨k, ?_, fun a => ⟨(Lp.memLp k).integrable_mul (Lp.memLp (J a)), ?_⟩⟩
  · have hnorm := (Lp.toDual ℝ μ s p).norm_map k
    rw [hk] at hnorm
    exact hnorm.symm.le.trans hLC
  · rw [← Lp.toDual_apply, hk, hL]

end ConformalPoisson

end ProofPart_GreenTrace_LpFunctionalDensity

