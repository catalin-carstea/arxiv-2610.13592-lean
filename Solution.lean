/- /root, unselected intake. The direct finite-layer highest-jet response
is an explicit OPEN hypothesis. This caller checks that precisely that
response and equality of actual trace coefficients suffice for all jets. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}

def DirectTraceJetResponse (F₁ F₂ : NormalMetricField S)
    (W : Set (EuclideanSpace ℝ (Fin n))) (c₁ c₂ : ℕ → NativeSymbol n) : Prop :=
  ∀ L : ℕ,
    (∀ r ≤ L, EqOn (normalJet r F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet r F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W) →
    ∀ ξ : Fin n → ℝ, ξ ≠ 0 → ∀ y ∈ W,
      c₁ (L + 1) ξ (EuclideanHalfSpace.boundaryParam n y) -
        c₂ (L + 1) ξ (EuclideanHalfSpace.boundaryParam n y) =
      -Complex.ofReal ((normalMatrixQuadratic (normalJet L F₁.K
          (EuclideanHalfSpace.boundaryParam n y)) ξ -
        normalMatrixQuadratic (normalJet L F₂.K (EuclideanHalfSpace.boundaryParam n y)) ξ) /
        (2 * F₁.principal ξ (EuclideanHalfSpace.boundaryParam n y)) ^ (L + 2))

without_proof_info in
theorem all_inverse_normalJets_eq_of_direct_trace_response
    (F₁ F₂ : NormalMetricField S) (hn : 2 ≤ n)
    {W : Set (EuclideanSpace ℝ (Fin n))}
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (c₁ c₂ : ℕ → NativeSymbol n)
    (hp₁ : ∀ ξ, ξ ≠ 0 → ∀ y ∈ W, c₁ 0 ξ (EuclideanHalfSpace.boundaryParam n y) =
      -Complex.ofReal (F₁.principal ξ (EuclideanHalfSpace.boundaryParam n y)))
    (hp₂ : ∀ ξ, ξ ≠ 0 → ∀ y ∈ W, c₂ 0 ξ (EuclideanHalfSpace.boundaryParam n y) =
      -Complex.ofReal (F₂.principal ξ (EuclideanHalfSpace.boundaryParam n y)))
    (hc : ∀ r ξ, ξ ≠ 0 → ∀ y ∈ W,
      c₁ r ξ (EuclideanHalfSpace.boundaryParam n y) = c₂ r ξ (EuclideanHalfSpace.boundaryParam n y))
    (hResponse : DirectTraceJetResponse F₁ F₂ W c₁ c₂) :
    ∀ k, EqOn (normalJet k F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet k F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W := by
  intro k
  induction k using Nat.strong_induction_on with
  | ind k ih =>
    cases k with
    | zero =>
      intro y hy
      apply normalMatrix_eq_of_principal_eq _ _ (F₁.inverse_posDef _ (hWS hy))
        (F₂.inverse_posDef _ (hWS hy))
      intro ξ hξ
      have he := hc 0 ξ hξ y hy
      rw [hp₁ ξ hξ y hy, hp₂ ξ hξ y hy] at he
      exact Complex.ofReal_injective (neg_injective he)
    | succ L =>
      have hA : ∀ r ≤ L, EqOn (normalJet r F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
          (normalJet r F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W :=
        fun r hr => ih r (by omega)
      intro y hy
      apply F₁.inverse_jet_step F₂ (hWS hy) hn L (fun r hr => hA r hr hy)
      apply normalMatrix_eq_of_quadratic_eq _ _ (F₁.K_normalJet_symmetric L (hWS hy))
        (F₂.K_normalJet_symmetric L (hWS hy))
      intro ξ hξ
      have he := hResponse L hA ξ hξ y hy
      rw [hc (L + 1) ξ hξ y hy, sub_self] at he
      have hz : (normalMatrixQuadratic (normalJet L F₁.K
          (EuclideanHalfSpace.boundaryParam n y)) ξ -
        normalMatrixQuadratic (normalJet L F₂.K (EuclideanHalfSpace.boundaryParam n y)) ξ) /
          (2 * F₁.principal ξ (EuclideanHalfSpace.boundaryParam n y)) ^ (L + 2) = 0 := by
        apply Complex.ofReal_injective
        simpa only [Complex.ofReal_zero] using (neg_eq_zero.mp he.symm)
      have hd : (2 * F₁.principal ξ (EuclideanHalfSpace.boundaryParam n y)) ^ (L + 2) ≠ 0 :=
        pow_ne_zero _ (mul_ne_zero (by norm_num) (F₁.principal_pos ξ hξ _ (hWS hy)).ne')
      exact sub_eq_zero.mp ((div_eq_zero_iff.mp hz).resolve_right hd)

without_proof_info in
theorem all_gram_normalJets_eq_of_inverse_normalJets
    (F₁ F₂ : NormalMetricField S) {W : Set (EuclideanSpace ℝ (Fin n))}
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    (hA : ∀ k, EqOn (normalJet k F₁.inverse ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet k F₂.inverse ∘ EuclideanHalfSpace.boundaryParam n) W) :
    ∀ k, EqOn (normalJet k F₁.gram ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet k F₂.gram ∘ EuclideanHalfSpace.boundaryParam n) W := by
  intro k y hy
  exact F₁.inverse_jet_transfer F₂ (hWS hy) k (fun r _ => hA r hy) k le_rfl

end ConformalPoisson.LocalDN

