    (hM.contDiffAt.clm_comp hGa.contDiffAt).analyticAt).add (analyticAt_holderJetPotential hQ)

without_proof_info in
theorem analyticAt_pulledBackBallOperator (hα : α ≤ 1)
    {A K : P → H (V →L[ℝ] V)} {B : P → H V} {Q : P → H ℝ} {a : P → V}
    (hA : AnalyticAt ℝ A p) (hB : AnalyticAt ℝ B p) (hQ : AnalyticAt ℝ Q p)
    (hK : AnalyticAt ℝ K p) (ha : AnalyticAt ℝ a p)
    (C : H (V →L[ℝ] V →L[ℝ] ℝ)) :
    AnalyticAt ℝ (fun z => pulledBackBallOperator hα (A z) (B z) (Q z) (K z) C (a z)) p := by
  exact ((analyticAt_pulledBackHolderOperator hA hB hQ hK ha C).contDiffAt.clm_comp
    contDiffAt_const).analyticAt

end ConformalPoisson.DirichletHolder

