theorem trace_principal_classical_hessian_comp_isometry
    (e : E ≃ₗᵢ[ℝ] F) (A : F →L[ℝ] F) (u : F → ℝ) (x : E) :
    traceCLM ℝ E (((e.symm : F →L[ℝ] E) ∘L A ∘L (e : E →L[ℝ] F)) ∘L
