open Set MeasureTheory TopologicalSpace Filter TauCeti TauCeti.PDE
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {ι : Type*} [Fintype ι] {μ : Measure (EuclideanSpace ℝ ι)} [μ.IsAddHaarMeasure]
  {Ω : Opens (EuclideanSpace ℝ ι)} {S K : Set (EuclideanSpace ℝ ι)}

without_proof_info in
theorem exists_relative_principal_forcing
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ K) (hΩS : (Ω : Set (EuclideanSpace ℝ ι)) ⊆ interior S)
    {a : EuclideanSpace ℝ ι → Matrix ι ι ℝ}
    {b : EuclideanSpace ℝ ι → EuclideanSpace ℝ ι} {c : EuclideanSpace ℝ ι → ℝ}
    (ha : MemLp (fun x => energyIntegrand (a x) 0 0) ⊤ (μ.restrict Ω))
    (hb : ContDiffOn ℝ ∞ b S) (hc : ContDiffOn ℝ ∞ c S) (k : ℕ)
    {F : Wkp μ Ω 2 k} {u : W1p μ Ω 2}
    (hw : ∃ w : Wkp μ Ω 2 (k + 1), Wkp.value (k + 1) w = W1p.value u)
    (hu : ∀ v : W1p0 μ Ω 2, energyFormH1 a b c u v.val =
      ∫ x in Ω, Wkp.value k F x * W1p.value v.val x ∂μ) :
    ∃ G : Wkp μ Ω 2 k, ∀ v : W1p0 μ Ω 2, energyFormH1 a 0 0 u v.val =
      ∫ x in Ω, Wkp.value k G x * W1p.value v.val x ∂μ := by
  obtain ⟨w, hw⟩ := hw
  let e := EuclideanSpace.basisFun ι ℝ
  choose D hD using fun i => Wkp.exists_hasWeakLineDerivOn_value k w (e i)
  rw [hw] at hD
  choose M hM using fun i => exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k
    (hb.inner ℝ (contDiffOn_const (c := e i))) (D i)
  obtain ⟨N, hN⟩ := exists_wkp_mul_of_relative_smooth hS hK hKS hΩK hΩS k hc (Wkp.lowerOrder k w)
  refine ⟨F - ∑ i, M i - N, fun v => ?_⟩
  rw [energyFormH1_principal_eq_setIntegral_sub ha
    ((hb.continuousOn.mono hKS).memLp_top_restrict_of_subset_isCompact hK Ω.isOpen.measurableSet hΩK)
    ((hc.continuousOn.mono hKS).memLp_top_restrict_of_subset_isCompact hK Ω.isOpen.measurableSet hΩK) hu v]
  refine integral_congr_ae ?_
  have hDi : ∀ᵐ x ∂μ.restrict Ω, ∀ i, Wkp.value k (D i) x = ⟪e i, W1p.gradient u x⟫_ℝ :=
    Filter.eventually_all.2 fun i => by
      filter_upwards [(hD i).ae_eq ((W1p.hasWeakFDerivOn u).hasWeakLineDerivOn (e i))] with x hx
      rw [hx, innerSL_apply_apply, real_inner_comm]
  have hMi : ∀ᵐ x ∂μ.restrict Ω, ∀ i, Wkp.value k (M i) x =
      ⟪b x, e i⟫_ℝ * Wkp.value k (D i) x := Filter.eventually_all.2 hM
  have hval : Wkp.value k (Wkp.lowerOrder k w) = W1p.value u := by rw [← Wkp.value_succ, hw]
  rw [Wkp.value_sub, Wkp.value_sub]
  filter_upwards [Lp.coeFn_sub (Wkp.value k F - Wkp.value k (∑ i, M i)) (Wkp.value k N),
    Lp.coeFn_sub (Wkp.value k F) (Wkp.value k (∑ i, M i)),
    Wkp.value_finsetSum_ae k Finset.univ M, hDi, hMi, hN] with x h₁ h₂ h₃ h₄ h₅ h₆
  rw [h₁, Pi.sub_apply, h₂, Pi.sub_apply, h₃, h₆, hval,
    ← e.sum_inner_mul_inner (b x) (W1p.gradient u x)]
  simp only [h₅, h₄]
end ConformalPoisson

end ProofPart_RelativeLowerOrderForcing

