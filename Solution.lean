noncomputable section ProofPart_NativeRellichCompactness




/- Rellich compactness for the actual native zero-trace H1 space,
including compact manifolds with boundary. The proof uses the constructed
finite chart cover, actual compact cutoff readings and norm domination. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
section GeneralModel
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [CompactSpace M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
variable [MeasurableSpace E] [BorelSpace E]
open DirichletSobolev
namespace FiniteBoundaryChartCover
variable (K : FiniteBoundaryChartCover (I := I) (M := M))

without_proof_info in
/-- A single real constant controls the native value by the finite
coordinate product. The constant is fixed before the smooth function. -/
theorem norm_valueL_smooth_le
    (u : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    ‖valueL (I := I) {x : M | I.IsBoundaryPoint x}
      (smoothInclusion (E := E) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u)‖ ≤
      (1 + ∑ c : K.centers, (K.data c).densityUpper) *
        ‖K.readingsL (smoothInclusion (E := E) (I := I) (M := M)
          {x : M | I.IsBoundaryPoint x} u)‖ := by
  classical
  let U := smoothInclusion (E := E) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u
  let B := valueL (I := I) {x : M | I.IsBoundaryPoint x} U
  let A := K.readingsL U
  let S : ℝ := ∑ c : K.centers, (K.data c).densityUpper
  have hS : 0 ≤ S := Finset.sum_nonneg (fun c _ => (K.data c).densityUpper_pos.le)
  have hs : (∑ c : K.centers, ENNReal.ofReal (K.data c).densityUpper).toReal = S := by
    rw [ENNReal.toReal_sum (fun _ _ => ENNReal.ofReal_ne_top)]
    apply Finset.sum_congr rfl
    intro c hc
    exact ENNReal.toReal_ofReal (K.data c).densityUpper_pos.le
  have henergy := K.enorm_valueL_smooth_sq_le u
  have hfinite : (∑ c : K.centers, ENNReal.ofReal (K.data c).densityUpper) * ‖A‖ₑ ^ 2 ≠ ⊤ := by
    rw [← ofReal_norm A]
    exact ENNReal.mul_ne_top (ENNReal.sum_ne_top.mpr (fun _ _ => ENNReal.ofReal_ne_top))
      (by finiteness)
  have hr := ENNReal.toReal_mono hfinite henergy
  have hreal : ‖B‖ ^ 2 ≤ S * ‖A‖ ^ 2 := by
    simpa only [ENNReal.toReal_mul, ENNReal.toReal_pow, toReal_eNorm, hs] using hr
  have hC : S ≤ (1 + S) ^ 2 := by nlinarith [sq_nonneg S]
  apply (sq_le_sq₀ (norm_nonneg B) (mul_nonneg (by linarith) (norm_nonneg A))).mp
  calc
    ‖B‖ ^ 2 ≤ S * ‖A‖ ^ 2 := hreal
    _ ≤ (1 + S) ^ 2 * ‖A‖ ^ 2 := mul_le_mul_of_nonneg_right hC (sq_nonneg _)
    _ = ((1 + S) * ‖A‖) ^ 2 := (mul_pow _ _ _).symm

without_proof_info in
/-- Density passes the same finite-chart comparison to the entire
native zero-trace H1 completion. -/
theorem norm_valueL_le (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x}) :
    ‖valueL (I := I) {x : M | I.IsBoundaryPoint x} u‖ ≤
      (1 + ∑ c : K.centers, (K.data c).densityUpper) * ‖K.readingsL u‖ := by
  refine (denseRange_smoothInclusion (E := E) (I := I) (M := M)
    {x : M | I.IsBoundaryPoint x}).induction_on u
      (isClosed_le (valueL (I := I) {x : M | I.IsBoundaryPoint x}).continuous.norm
        (continuous_const.mul K.readingsL.continuous.norm)) ?_
  intro v
  exact K.norm_valueL_smooth_le v
end FiniteBoundaryChartCover

without_proof_info in
/-- Native Rellich compactness, proved for the actual zero-boundary
closure in canonical H1 without any Boundaryless assumption. -/
theorem isCompactOperator_zeroTrace_valueL :
    IsCompactOperator (valueL (I := I) {x : M | I.IsBoundaryPoint x}) := by
  let K : FiniteBoundaryChartCover (I := I) (M := M) :=
    Classical.choice (nonempty_finiteBoundaryChartCover (I := I) (M := M))
  exact isCompactOperator_of_norm_domination K.readingsL (valueL (I := I) {x : M | I.IsBoundaryPoint x})
    K.isCompactOperator_readingsL K.norm_valueL_le
end GeneralModel

section PaperMetric
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]

without_proof_info in
/-- Discharge the precise compactness obligation in the native
Dirichlet Fredholm caller for every actual paper metric. -/
theorem nativeZeroTraceCompactness (g : Metric (n := n) (M := M)) :
    NativeZeroTraceCompactness g := by
  letI : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  letI : IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
