/- The ordinary parameter jet commutes with the actual manifold differential,
including at a boundary point. All chart readings use the model range. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E Y H M : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [TopologicalSpace H]
  {I : ModelWithCorners ℝ Y H} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I 1 M]

without_proof_info in
theorem ordinaryJet_mvfderiv_comm {G : E → M → ℝ} {x : E} {y : M}
    (hG : ContMDiffAt (𝓘(ℝ, E).prod I) 𝓘(ℝ) ∞ (uncurry G) (x, y))
    (v : TangentSpace I y) :
    mvfderiv I (fun z => ordinaryJet (G x z)
      (fderiv ℝ (fun a => G a z) x) (fderiv ℝ (fderiv ℝ (fun a => G a z)) x)) y v =
    ordinaryJet (mvfderiv I (G x) y v)
      (fderiv ℝ (fun a => mvfderiv I (G a) y v) x)
      (fderiv ℝ (fderiv ℝ (fun a => mvfderiv I (G a) y v)) x) := by
  have hchart : ContDiffWithinAt ℝ ∞
      (fun p : E × Y => G p.1 ((extChartAt I y).symm p.2))
      (univ ×ˢ range I) (x, extChartAt I y y) := by
    have h := (contMDiffAt_iff.mp hG).2
    rw [ModelWithCorners.range_prod, (𝓘(ℝ, E)).range_eq_univ] at h
    convert h using 1 <;> ext <;> rfl
  have hswap : ContMDiffAt (I.prod 𝓘(ℝ, E)) 𝓘(ℝ) ∞
      (uncurry (fun z a => G a z)) (y, x) :=
    hG.comp (y, x) (contMDiffAt_snd.prodMk contMDiffAt_fst)
  have hjet := (contMDiffAt_fixed_ordinaryJet hswap).mdifferentiableAt (by simp)
  have hnear := (contMDiffAt_iff_contMDiffAt_nhds (n := 1) (by simp)).mp
    (hG.of_le (by simp))
  have heq : (fun a => mvfderiv I (G a) y v) =ᶠ[𝓝 x]
      (fun a => fderivWithin ℝ (fun b => G a ((extChartAt I y).symm b))
        (range I) (extChartAt I y y) v) := by
    filter_upwards [(continuous_id.prodMk continuous_const).continuousAt.eventually hnear]
      with a ha
    have ha' : MDifferentiableAt I 𝓘(ℝ) (G a) y :=
      (ha.comp y (contMDiffAt_const.prodMk contMDiffAt_id)).mdifferentiableAt
      (by simp : (1 : ℕ∞ω) ≠ 0)
    erw [ha'.mvfderiv]
    simp only [writtenInExtChartAt, extChartAt_model_space_eq_id, PartialEquiv.refl_coe,
      Function.id_comp]
    rfl
  have hdg : fderiv ℝ (fun a => mvfderiv I (G a) y v) =ᶠ[𝓝 x]
      fderiv ℝ (fun a => fderivWithin ℝ (fun b => G a ((extChartAt I y).symm b))
        (range I) (extChartAt I y y) v) :=
    heq.eventuallyEq_nhds.mono (fun a ha => ha.fderiv_eq (𝕜 := ℝ))
  have hdd : fderiv ℝ (fderiv ℝ (fun a => mvfderiv I (G a) y v)) x =
      fderiv ℝ (fderiv ℝ (fun a => fderivWithin ℝ
        (fun b => G a ((extChartAt I y).symm b)) (range I) (extChartAt I y y) v)) x :=
    hdg.fderiv_eq (𝕜 := ℝ)
  rw [heq.eq_of_nhds, heq.fderiv_eq (𝕜 := ℝ), hdd, hjet.mvfderiv]
  simp only [writtenInExtChartAt, extChartAt_model_space_eq_id, PartialEquiv.refl_coe,
    Function.comp_def, id_eq]
  convert ordinaryJet_fderivWithin_comm
      (G := fun a b => G a ((extChartAt I y).symm b)) hchart I.uniqueDiffOn (mem_range_self _)
      (I.range_subset_closure_interior (mem_range_self _)) v using 1

without_proof_info in
theorem finiteOrdinaryJet_mvfderiv_comp_comm {ι : Type*} [Fintype ι]
    (G : ι → E → M → ℝ) (x : ι → E) {y : M}
    (hG : ∀ i, ContMDiffAt (𝓘(ℝ, E).prod I) 𝓘(ℝ) ∞ (uncurry (G i)) (x i, y))
    (L : (ι → OrdinaryJet E) →L[ℝ] ℝ) (v : TangentSpace I y) :
    mvfderiv I (fun z => L (fun i => ordinaryJet (G i (x i) z)
      (fderiv ℝ (fun a => G i a z) (x i))
      (fderiv ℝ (fderiv ℝ (fun a => G i a z)) (x i)))) y v =
    L (fun i => ordinaryJet (mvfderiv I (G i (x i)) y v)
      (fderiv ℝ (fun a => mvfderiv I (G i a) y v) (x i))
      (fderiv ℝ (fderiv ℝ (fun a => mvfderiv I (G i a) y v)) (x i))) := by
  let J : M → ι → OrdinaryJet E := fun z i => ordinaryJet (G i (x i) z)
    (fderiv ℝ (fun a => G i a z) (x i))
    (fderiv ℝ (fderiv ℝ (fun a => G i a z)) (x i))
  have hJ : ContMDiffAt I 𝓘(ℝ, ι → OrdinaryJet E) ∞ J y :=
    contMDiffAt_pi_module_iff.mpr fun i => contMDiffAt_fixed_ordinaryJet
      (G := fun z a => G i a z) (p := y) (x := x i)
      ((hG i).comp (y, x i) (contMDiffAt_snd.prodMk contMDiffAt_fst))
  have hdiff := hJ.mdifferentiableAt (by simp)
  have hpi : mvfderiv I J y v = fun i => ordinaryJet (mvfderiv I (G i (x i)) y v)
      (fderiv ℝ (fun a => mvfderiv I (G i a) y v) (x i))
      (fderiv ℝ (fderiv ℝ (fun a => mvfderiv I (G i a) y v)) (x i)) := by
    funext i
    have hp := (ContinuousLinearMap.proj i).mvfderiv_comp_apply hdiff v
    exact hp.symm.trans (ordinaryJet_mvfderiv_comm (hG i) v)
  exact (L.mvfderiv_comp_apply hdiff v).trans (congrArg L hpi)

end ConformalPoisson

end ProofPart_ManifoldOrdinaryJetMixedDerivative

/- Proof support: OrdinaryJetCoordinates.lean, SHA256 e56cee8394a4dcfac59a9e82fa2344f4d5d90908be888143a81e34aeeb7c4c0d -/
noncomputable section ProofPart_OrdinaryJetCoordinates


/- Finite coordinate evaluations span all linear functionals of an ordinary
second jet. This uses a finite family of separating forms, without choosing
any new topology on the jet space. -/
open Set Submodule
namespace ConformalPoisson
variable {E κ : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

abbrev OrdinaryJetCoordinateIndex (κ : Type*) := Unit ⊕ (κ ⊕ (κ × κ))

def ordinaryJetCoordinate (b : Module.Basis κ ℝ E)
    (k : OrdinaryJetCoordinateIndex κ) : OrdinaryJet E →ₗ[ℝ] ℝ where
  toFun j := match k with
    | .inl _ => j.1
    | .inr (.inl i) => j.2.1 (b i)
    | .inr (.inr (i, l)) => j.2.2 (b i) (b l)
  map_add' j l := by rcases k with _ | (_ | ⟨_, _⟩) <;> rfl
  map_smul' a j := by rcases k with _ | (_ | ⟨_, _⟩) <;> rfl

without_proof_info in
theorem ordinaryJetCoordinates_injective (b : Module.Basis κ ℝ E) :
    Function.Injective (fun j : OrdinaryJet E => fun k => ordinaryJetCoordinate b k j) := by
  intro j l h
  have hval : j.1 = l.1 := congrFun h (.inl ())
  have hfirst : j.2.1 = l.2.1 := by
    apply ContinuousLinearMap.coe_injective
    exact b.ext fun i => congrFun h (.inr (.inl i))
  have hsecond : j.2.2 = l.2.2 := by
    apply ContinuousLinearMap.coe_injective
    apply b.ext
    intro i
    apply ContinuousLinearMap.coe_injective
    exact b.ext fun k => congrFun h (.inr (.inr (i, k)))
  exact Prod.ext hval (Prod.ext hfirst hsecond)

without_proof_info in
theorem exists_ordinaryJet_coordinate_weights [Fintype κ] (b : Module.Basis κ ℝ E)
    (L : OrdinaryJet E →ₗ[ℝ] ℝ) :
    ∃ c : OrdinaryJetCoordinateIndex κ → ℝ,
      ∀ j, L j = ∑ k, c k * ordinaryJetCoordinate b k j := by
  have hker : (⨅ k, LinearMap.ker (ordinaryJetCoordinate b k)) ≤ LinearMap.ker L := by
    intro j hj
    have hj0 : j = 0 := ordinaryJetCoordinates_injective b (by
      funext k
      exact (LinearMap.mem_ker.mp ((Submodule.mem_iInf _).mp hj k)).trans
        (map_zero (ordinaryJetCoordinate b k)).symm)
    exact LinearMap.mem_ker.mpr (hj0 ▸ map_zero L)
  obtain ⟨c, hc⟩ := (mem_span_range_iff_exists_fun ℝ).mp
    (mem_span_of_iInf_ker_le_ker hker)
  refine ⟨c, fun j => ?_⟩
  have h := LinearMap.congr_fun hc j
  simpa only [LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul] using h.symm

def piOrdinaryJetCoordinate {ι : Type*} (b : Module.Basis κ ℝ E)
    (k : ι × OrdinaryJetCoordinateIndex κ) : (ι → OrdinaryJet E) →ₗ[ℝ] ℝ :=
  (ordinaryJetCoordinate b k.2).comp (LinearMap.proj k.1)

without_proof_info in
theorem exists_piOrdinaryJet_coordinate_weights {ι : Type*} [Fintype ι] [Fintype κ]
    (b : Module.Basis κ ℝ E) (L : (ι → OrdinaryJet E) →ₗ[ℝ] ℝ) :
    ∃ c : (ι × OrdinaryJetCoordinateIndex κ) → ℝ,
      ∀ j, L j = ∑ k, c k * ordinaryJetCoordinate b k.2 (j k.1) := by
  have hker : (⨅ k, LinearMap.ker (piOrdinaryJetCoordinate (ι := ι) b k)) ≤ LinearMap.ker L := by
    intro j hj
    have hj0 : j = 0 := by
      funext i
      apply ordinaryJetCoordinates_injective b
      funext k
      exact (LinearMap.mem_ker.mp ((Submodule.mem_iInf _).mp hj (i, k))).trans
        (map_zero (ordinaryJetCoordinate b k)).symm
    exact LinearMap.mem_ker.mpr (hj0 ▸ map_zero L)
  obtain ⟨c, hc⟩ := (mem_span_range_iff_exists_fun ℝ).mp
    (mem_span_of_iInf_ker_le_ker hker)
  refine ⟨c, fun j => ?_⟩
  have h := LinearMap.congr_fun hc j
  simpa only [LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul,
    piOrdinaryJetCoordinate, LinearMap.comp_apply, LinearMap.proj_apply] using h.symm

end ConformalPoisson

end ProofPart_OrdinaryJetCoordinates

/- Proof support: OrdinaryJetFunctionalCalculus.lean, SHA256 27b5c76458ead959fd192d0c4ccded1e6a0a2a44e081d86ec499b91bb2735f2d -/
noncomputable section ProofPart_OrdinaryJetFunctionalCalculus




/- Continuous linear functionals of a spatial jet commute with ordinary
parameter differentiation. This is the local calculus for the Green equation. -/
open Set Filter Function
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E Y : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

def ordinarySecondJet (f : E → ℝ) (x : E) : OrdinaryJet E :=
  ordinaryJet (f x) (fderiv ℝ f x) (fderiv ℝ (fderiv ℝ f) x)

without_proof_info in
theorem ordinarySecondJet_eq_of_eventuallyEq {f g : E → ℝ} {x : E}
    (h : f =ᶠ[𝓝 x] g) : ordinarySecondJet f x = ordinarySecondJet g x := by
  have hd : fderiv ℝ f =ᶠ[𝓝 x] fderiv ℝ g :=
    h.eventuallyEq_nhds.mono fun a ha => ha.fderiv_eq (𝕜 := ℝ)
  unfold ordinarySecondJet
  rw [h.eq_of_nhds, h.fderiv_eq (𝕜 := ℝ), hd.fderiv_eq (𝕜 := ℝ)]

without_proof_info in
theorem contDiffAt_ordinaryJet_family {G : E → Y → ℝ} {x : E} {y : Y}
    (hG : ContDiffAt ℝ ∞ (uncurry G) (x, y)) :
    ContDiffAt ℝ ∞ (fun a => ordinarySecondJet (G a) y) x := by
  have hGM : ContMDiffAt (𝓘(ℝ, E).prod 𝓘(ℝ, Y)) 𝓘(ℝ) ∞ (uncurry G) (x, y) := by
    rwa [← modelWithCornersSelf_prod, chartedSpaceSelf_prod, contMDiffAt_iff_contDiffAt]
  exact (contMDiffAt_fixed_ordinaryJet hGM).contDiffAt

without_proof_info in
theorem ordinarySecondJet_family_fderiv {G : E → Y → ℝ} {x : E} {y : Y}
    (hG : ContDiffAt ℝ ∞ (uncurry G) (x, y)) (v : E) :
    fderiv ℝ (fun a => ordinarySecondJet (G a) y) x v =
      ordinarySecondJet (fun b => fderiv ℝ (fun a => G a b) x v) y := by
  have hswap : ContDiffWithinAt ℝ ∞ (uncurry (fun b a => G a b))
      (univ ×ˢ (univ : Set E)) (y, x) := by
    rw [univ_prod_univ, contDiffWithinAt_univ]
    exact hG.comp (y, x) (contDiffAt_snd.prodMk contDiffAt_fst)
  simpa only [fderivWithin_univ, ordinarySecondJet] using
    ordinaryJet_fderivWithin_comm (G := fun b a => G a b) hswap uniqueDiffOn_univ
      (mem_univ x) (by simp) v

without_proof_info in
theorem jetFunctional_family_fderiv {G : E → Y → ℝ} {x : E} {y : Y}
    (hG : ContDiffAt ℝ ∞ (uncurry G) (x, y))
    (L : OrdinaryJet Y →L[ℝ] ℝ) (v : E) :
    fderiv ℝ (fun a => L (ordinarySecondJet (G a) y)) x v =
      L (ordinarySecondJet (fun b => fderiv ℝ (fun a => G a b) x v) y) := by
  have hJ := (contDiffAt_ordinaryJet_family hG).differentiableAt (by simp)
  have h := L.hasFDerivAt.comp x hJ.hasFDerivAt
  exact (congrArg (fun A : E →L[ℝ] ℝ => A v) h.fderiv).trans
    (congrArg L (ordinarySecondJet_family_fderiv hG v))

without_proof_info in
theorem contDiffAt_joint_partial_fderiv {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {G : E → Y → F} {x : E} {y : Y}
    (hG : ContDiffAt ℝ ∞ (uncurry G) (x, y)) :
    ContDiffAt ℝ ∞ (fun r : E × Y => fderiv ℝ (fun a => G a r.2) r.1) (x, y) := by
  have hwithin : ContDiffWithinAt ℝ ∞ (uncurry G) (univ ×ˢ (univ : Set Y)) (x, y) := by
    simpa only [univ_prod_univ, contDiffWithinAt_univ] using hG
  simpa only [univ_prod_univ, contDiffWithinAt_univ] using
    contDiffWithinAt_joint_fderiv_fst hwithin (mem_univ y) (m := ∞) (by simp)

without_proof_info in
theorem jetFunctional_family_secondFDeriv {G : E → Y → ℝ} {U : Set E} {V : Set Y}
    (hU : IsOpen U) (hV : IsOpen V) {x : E} (hx : x ∈ U) {y : Y} (hy : y ∈ V)
    (hG : ContDiffOn ℝ ∞ (uncurry G) (U ×ˢ V))
    (L : OrdinaryJet Y →L[ℝ] ℝ) (v w : E) :
    fderiv ℝ (fderiv ℝ (fun a => L (ordinarySecondJet (G a) y))) x w v =
      L (ordinarySecondJet (fun b => fderiv ℝ (fderiv ℝ (fun a => G a b)) x w v) y) := by
  have hAt (a : E) (ha : a ∈ U) : ContDiffAt ℝ ∞ (uncurry G) (a, y) :=
    (hG (a, y) ⟨ha, hy⟩).contDiffAt ((hU.prod hV).mem_nhds ⟨ha, hy⟩)
  have heq : (fun a => fderiv ℝ (fun z => L (ordinarySecondJet (G z) y)) a v) =ᶠ[𝓝 x]
      (fun a => L (ordinarySecondJet (fun b => fderiv ℝ (fun z => G z b) a v) y)) :=
    eventuallyEq_of_mem (hU.mem_nhds hx) fun a ha => jetFunctional_family_fderiv (hAt a ha) L v
  have hH : ContDiffAt ℝ ∞ (fun a => L (ordinarySecondJet (G a) y)) x :=
    L.contDiff.contDiffAt.comp x (contDiffAt_ordinaryJet_family (hAt x hx))
  have hD : ContDiffAt ℝ ∞
      (uncurry (fun a b => fderiv ℝ (fun z => G z b) a v)) (x, y) :=
    (contDiffAt_joint_partial_fderiv (hAt x hx)).clm_apply contDiffAt_const
  calc
    fderiv ℝ (fderiv ℝ (fun a => L (ordinarySecondJet (G a) y))) x w v =
        fderiv ℝ (fun a => fderiv ℝ (fun z => L (ordinarySecondJet (G z) y)) a v) x w :=
      (TauCeti.fderiv_clm_apply_const_apply
        ((hH.fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)) v w).symm
    _ = fderiv ℝ (fun a => L
        (ordinarySecondJet (fun b => fderiv ℝ (fun z => G z b) a v) y)) x w :=
      congrArg (fun A : E →L[ℝ] ℝ => A w) (heq.fderiv_eq (𝕜 := ℝ))
    _ = L (ordinarySecondJet (fun b => fderiv ℝ
        (fun a => fderiv ℝ (fun z => G z b) a v) x w) y) :=
      jetFunctional_family_fderiv hD L w
    _ = _ := by
      apply congrArg L
      apply ordinarySecondJet_eq_of_eventuallyEq
      filter_upwards [hV.mem_nhds hy] with b hb
      have hGb : ContDiffAt ℝ ∞ (fun a => G a b) x :=
        ((hG (x, b) ⟨hx, hb⟩).contDiffAt
          ((hU.prod hV).mem_nhds ⟨hx, hb⟩)).comp x (contDiffAt_id.prodMk contDiffAt_const)
      exact TauCeti.fderiv_clm_apply_const_apply
        ((hGb.fderiv_right (m := ∞) (by simp)).differentiableAt (by simp)) v w

end ConformalPoisson

end ProofPart_OrdinaryJetFunctionalCalculus

/- Proof support: OrdinaryJetKernelGerms.lean, SHA256 b78c4a9e37588e49a76a15ebd8364d5e7eac69b46a9352efa68a9aa208dec9fb -/
noncomputable section ProofPart_OrdinaryJetKernelGerms



/- Smooth germs annihilated by a fixed second-jet functional form a vector
space. Parameter derivatives of a smooth family remain in that space. -/
open Set Filter Function
open scoped ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E Y : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y]

without_proof_info in
theorem ordinarySecondJet_zero (x : E) : ordinarySecondJet (0 : E → ℝ) x = 0 := by
  change ordinaryJet 0 (fderiv ℝ (0 : E → ℝ) x)
    (fderiv ℝ (fderiv ℝ (0 : E → ℝ)) x) = 0
  simp only [fderiv_zero]
  rfl

without_proof_info in
theorem ordinarySecondJet_add {f g : E → ℝ} {x : E}
    (hf : ContDiffAt ℝ 2 f x) (hg : ContDiffAt ℝ 2 g x) :
    ordinarySecondJet (f + g) x = ordinarySecondJet f x + ordinarySecondJet g x := by
  refine Prod.ext rfl (Prod.ext ?_ ?_)
  · exact fderiv_add (hf.differentiableAt (by norm_num)) (hg.differentiableAt (by norm_num))
  · exact secondFDeriv_add hf hg

without_proof_info in
theorem ordinarySecondJet_smul (a : ℝ) (f : E → ℝ) (x : E) :
    ordinarySecondJet (a • f) x = a • ordinarySecondJet f x := by
  have hd : fderiv ℝ (a • f) = a • fderiv ℝ f := fderiv_const_smul_field a
  have hdd : fderiv ℝ (fderiv ℝ (a • f)) = a • fderiv ℝ (fderiv ℝ f) := by
    rw [hd]
    exact fderiv_const_smul_field (𝕜 := ℝ) (f := fderiv ℝ f) a
  refine Prod.ext rfl (Prod.ext (congrFun hd x) (congrFun hdd x))

def jetKernelGerms (L : OrdinaryJet E →L[ℝ] ℝ) (x : E) : Submodule ℝ (E → ℝ) where
  carrier := {f | ContDiffAt ℝ ∞ f x ∧ L (ordinarySecondJet f x) = 0}
  zero_mem' := ⟨contDiffAt_const, by rw [ordinarySecondJet_zero, map_zero]⟩
  add_mem' hf hg := ⟨hf.1.add hg.1, by
    rw [ordinarySecondJet_add (hf.1.of_le (by simp)) (hg.1.of_le (by simp)),
      map_add, hf.2, hg.2, add_zero]⟩
  smul_mem' a f hf := ⟨hf.1.const_smul a, by
    rw [ordinarySecondJet_smul, map_smul, hf.2, smul_zero]⟩

without_proof_info in
theorem parameter_jet_coordinates_mem_kernel
    {κ : Type*} (b : Module.Basis κ ℝ E) {G : E → Y → ℝ} {U : Set E} {V : Set Y}
    (hU : IsOpen U) (hV : IsOpen V) {x : E} (hx : x ∈ U) {y : Y} (hy : y ∈ V)
    (hG : ContDiffOn ℝ ∞ (uncurry G) (U ×ˢ V))
    (L : OrdinaryJet Y →L[ℝ] ℝ)
    (hEq : ∀ a ∈ U, L (ordinarySecondJet (G a) y) = 0)
    (k : OrdinaryJetCoordinateIndex κ) :
    (fun z => ordinaryJetCoordinate b k (ordinarySecondJet (fun a => G a z) x)) ∈
      jetKernelGerms L y := by
  have hAt : ContDiffAt ℝ ∞ (uncurry G) (x, y) :=
    (hG (x, y) ⟨hx, hy⟩).contDiffAt ((hU.prod hV).mem_nhds ⟨hx, hy⟩)
  have hD := contDiffAt_joint_partial_fderiv hAt
  have hDD := contDiffAt_joint_partial_fderiv
    (G := fun a z => fderiv ℝ (fun w => G w z) a) hD
  have heq : (fun a => L (ordinarySecondJet (G a) y)) =ᶠ[𝓝 x] 0 :=
    eventuallyEq_of_mem (hU.mem_nhds hx) hEq
  have hJzero : ordinarySecondJet (fun a => L (ordinarySecondJet (G a) y)) x = 0 :=
    (ordinarySecondJet_eq_of_eventuallyEq heq).trans (ordinarySecondJet_zero x)
  rcases k with _ | (i | ⟨i, j⟩)
  · refine ⟨?_, hEq x hx⟩
    exact hAt.comp y (contDiffAt_const.prodMk contDiffAt_id)
  · refine ⟨?_, ?_⟩
    · exact (hD.clm_apply contDiffAt_const).comp y (contDiffAt_const.prodMk contDiffAt_id)
    · change L (ordinarySecondJet (fun z => fderiv ℝ (fun a => G a z) x (b i)) y) = 0
      rw [← jetFunctional_family_fderiv hAt L (b i)]
      exact congrArg (fun J : OrdinaryJet E => J.2.1 (b i)) hJzero
  · refine ⟨?_, ?_⟩
    · exact ((hDD.clm_apply contDiffAt_const).clm_apply contDiffAt_const).comp y
        (contDiffAt_const.prodMk contDiffAt_id)
    · change L (ordinarySecondJet
        (fun z => fderiv ℝ (fderiv ℝ (fun a => G a z)) x (b i) (b j)) y) = 0
      rw [← jetFunctional_family_secondFDeriv hU hV hx hy hG L (b j) (b i)]
      exact congrArg (fun J : OrdinaryJet E => J.2.2 (b i) (b j)) hJzero

end ConformalPoisson

end ProofPart_OrdinaryJetKernelGerms

/- Proof support: FiniteJetOperatorKernel.lean, SHA256 bddf8a2ef545297b39fc626e41bf6d3994c5ab1b15d4c0e79066c2a36d9144c4 -/
noncomputable section ProofPart_FiniteJetOperatorKernel


/- A finite functional of parameter jets preserves a fixed spatial
second-order equation in a jointly smooth homogeneous family. -/
open Set Filter Function
open scoped ContDiff Topology BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E Y κ ι : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [Fintype κ] [Fintype ι]

without_proof_info in
theorem jetFunctional_finite_parameter_kernel
    (b : Module.Basis κ ℝ E) (G : ι → E → Y → ℝ)
    (U : ι → Set E) (V : ι → Set Y) (hU : ∀ i, IsOpen (U i)) (hV : ∀ i, IsOpen (V i))
    (x : ι → E) (hx : ∀ i, x i ∈ U i) (y : Y) (hy : ∀ i, y ∈ V i)
    (hG : ∀ i, ContDiffOn ℝ ∞ (uncurry (G i)) (U i ×ˢ V i))
    (L : OrdinaryJet Y →L[ℝ] ℝ)
    (hEq : ∀ i a, a ∈ U i → L (ordinarySecondJet (G i a) y) = 0)
    (A : (ι → OrdinaryJet E) →ₗ[ℝ] ℝ) :
    (fun z => A (fun i => ordinarySecondJet (fun a => G i a z) (x i))) ∈
      jetKernelGerms L y := by
  classical
  obtain ⟨c, hc⟩ := exists_piOrdinaryJet_coordinate_weights b A
  let F : (ι × OrdinaryJetCoordinateIndex κ) → Y → ℝ :=
    fun k z => ordinaryJetCoordinate b k.2 (ordinarySecondJet (fun a => G k.1 a z) (x k.1))
  have hF (k : ι × OrdinaryJetCoordinateIndex κ) : F k ∈ jetKernelGerms L y :=
    parameter_jet_coordinates_mem_kernel b (hU k.1) (hV k.1) (hx k.1) (hy k.1)
      (hG k.1) L (hEq k.1) k.2
  have hsum : (∑ k, c k • F k) ∈ jetKernelGerms L y :=
    (jetKernelGerms L y).sum_mem fun k _ => (jetKernelGerms L y).smul_mem (c k) (hF k)
  have heq : (fun z => A (fun i => ordinarySecondJet (fun a => G i a z) (x i))) =
      ∑ k, c k • F k := by
    funext z
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, F] using
      hc (fun i => ordinarySecondJet (fun a => G i a z) (x i))
  exact heq ▸ hsum

end ConformalPoisson

end ProofPart_FiniteJetOperatorKernel

/- Proof support: GreenJetCalculus.lean, SHA256 1666d6c3666110e414dd89512daf48f4d7b4e0702852fa0b1491f9d7d45d5039 -/
noncomputable section ProofPart_GreenJetCalculus



/- The open calculus boundary for finite-jet Runge. Every field is an identity
about the same actual Green kernel, native covariant jets and metric measures.
This is a project helper obligation, not an additional literature premise or a
permitted parameter of the selected fourteen-input theorem. -/
open Set MeasureTheory
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

def greenJetSection (g : Metric (n := n) (M := M)) {ι : Type*}
    (points : ι → M) (ℓ : ((i : ι) → JetSpace g (points i)) →ₗ[ℝ] ℝ)
    (kernel : M → M → ℝ) (y : M) : ℝ :=
  ℓ (fun i => secondJet g (fun x => kernel x y) (points i))

variable [T2Space M] [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]
local instance greenJetBoundaryCompact : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary

/-- Missing analytical producers are exposed at their precise downstream use.
The forcing identity is required only with support separated from all poles. -/
structure GreenJetCalculus
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    {N : ℕ} (points : Fin N → M) : Prop where
  smooth : ∀ ℓ, ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞
    (greenJetSection g points ℓ G.kernel) (range points)ᶜ
  equation : ∀ ℓ, ∀ y ∈ (𝓡∂ (n + 1)).interior M \ range points,
    schrodinger g q (greenJetSection g points ℓ G.kernel) y = 0
  zero_boundary : ∀ ℓ, ∀ y : (𝓡∂ (n + 1)).boundary M,
    greenJetSection g points ℓ G.kernel y = 0
  normal_moment : ∀ ℓ,
    ∀ (Γ : Set ((𝓡∂ (n + 1)).boundary M)) (f : BoundaryDatum Γ),
      Integrable (fun y => normalDerivative ν (greenJetSection g points ℓ G.kernel) y * f.val y)
        (nativeSurfaceMeasure g) ∧
      ℓ (fun i => secondJet g (S.solve f.val) (points i)) =
        -∫ y, normalDerivative ν (greenJetSection g points ℓ G.kernel) y * f.val y
          ∂nativeSurfaceMeasure g
  forcing_moment : ∀ ℓ, ∀ w : M → ℝ,
    ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ w →
    HasCompactSupport w → tsupport w ⊆ (𝓡∂ (n + 1)).interior M →
    Disjoint (tsupport (schrodinger g q w)) (range points) →
      Integrable (fun y => greenJetSection g points ℓ G.kernel y * schrodinger g q w y)
        (nativeVolume g) ∧
      ℓ (fun i => secondJet g w (points i)) =
        ∫ y, greenJetSection g points ℓ G.kernel y * schrodinger g q w y ∂nativeVolume g

end ConformalPoisson

end ProofPart_GreenJetCalculus

