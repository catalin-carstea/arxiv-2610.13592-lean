noncomputable section ProofPart_CarlemanWeighted


/- The actual weighted Schrödinger Carleman inequality. Its parameter
threshold precedes every compactly supported test. Explicit geometric
weight bounds are the remaining local geometric data; no existence
of a suitable boundary weight or boundary uniqueness is assumed. -/
open Bundle FiberBundle Set MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} [I.Boundaryless]
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [T2Space M] [SigmaCompactSpace M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ E (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M]
local notation "μ" => riemannianVolume I M

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_weighted_carleman_schrodinger_estimate_on {φ q : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hq : Continuous q)
    (S : Set M)
    {c h w d Q : ℝ} (hc : 0 ≤ c) (hd : 0 ≤ d) (hgap : 0 < h - c * w)
    (hQ : 0 ≤ Q) (hqbound : ∀ x ∈ S, |q x| ≤ Q)
    (hHess : ∀ x ∈ S, ∀ (ξ : TangentSpace I x), -c * ‖ξ‖ ^ 2 ≤ hessian I φ x ξ ξ)
    (hNormal : ∀ x ∈ S, h ≤ hessian I φ x (mgradient I φ x) (mgradient I φ x))
    (hGrad : ∀ x ∈ S, ‖mgradient I φ x‖ ^ 2 ≤ w)
    (hBiLap : ∀ x ∈ S, |laplaceBeltrami I (laplaceBeltrami I φ) x| ≤ d) :
    ∃ T : ℝ, 1 ≤ T ∧ ∀ τ : ℝ, T ≤ τ → ∀ u : M → ℝ,
      ContMDiff I 𝓘(ℝ) ∞ u → HasCompactSupport u → tsupport u ⊆ S →
      ((h - c * w) / 4) * τ ^ 3 * (∫ x, Real.exp (2 * τ * φ x) * u x ^ 2 ∂μ) ≤
        ∫ x, Real.exp (2 * τ * φ x) * (laplaceBeltrami I u x - q x * u x) ^ 2 ∂μ := by
  obtain ⟨T, hT, hcarleman⟩ := exists_uniform_carleman_schrodinger_parameter_on hφ hq S hc hd hgap hQ
    hqbound hHess hNormal hGrad hBiLap
  refine ⟨T, hT, ?_⟩
  intro τ hτ u hu huc hus
  let v : M → ℝ := fun x => Real.exp (τ * φ x) * u x
  have hE : ContDiff ℝ ∞ (fun t : ℝ => Real.exp (τ * t)) := by fun_prop
  have hv : ContMDiff I 𝓘(ℝ) ∞ v := (hE.contMDiff.comp hφ).mul hu
  have hvc : HasCompactSupport v := huc.mul_left
  have hvs : tsupport v ⊆ S :=
    (show tsupport v ⊆ tsupport u from tsupport_mul_subset_right).trans hus
  have hexp (x : M) : Real.exp (-τ * φ x) * Real.exp (τ * φ x) = 1 := by
    rw [← Real.exp_add]
    convert Real.exp_zero using 1 <;> congr 1 <;> ring
  have hexp2 (x : M) : Real.exp (τ * φ x) ^ 2 = Real.exp (2 * τ * φ x) := by
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  have hrecovery : (fun x => Real.exp (-τ * φ x) * v x) = u := by
    funext x
    dsimp only [v]
    rw [← mul_assoc, hexp, one_mul]
  have hleft : (∫ x, v x ^ 2 ∂μ) = ∫ x, Real.exp (2 * τ * φ x) * u x ^ 2 ∂μ := by
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x => by dsimp only [v]; rw [mul_pow, hexp2]
  have hright : (∫ x, (carlemanSymmetricPart I φ τ v x + carlemanSkewPart I φ τ v x - q x * v x) ^ 2 ∂μ) =
      ∫ x, Real.exp (2 * τ * φ x) * (laplaceBeltrami I u x - q x * u x) ^ 2 ∂μ := by
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun x => by
      dsimp only
      have hconj := exponential_conjugation_laplaceBeltrami hφ hv τ x
      rw [hrecovery] at hconj
      rw [← hconj]
      change (Real.exp (τ * φ x) * laplaceBeltrami I u x - q x * (Real.exp (τ * φ x) * u x)) ^ 2 = _
      calc
        _ = Real.exp (τ * φ x) ^ 2 * (laplaceBeltrami I u x - q x * u x) ^ 2 := by ring
        _ = _ := by rw [hexp2]
  have hresult := hcarleman τ hτ v hv hvc hvs
  rwa [hleft, hright] at hresult

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_weighted_carleman_schrodinger_estimate {φ q : M → ℝ}
    (hφ : ContMDiff I 𝓘(ℝ) ∞ φ) (hq : Continuous q)
    {c h w d Q : ℝ} (hc : 0 ≤ c) (hd : 0 ≤ d) (hgap : 0 < h - c * w)
    (hQ : 0 ≤ Q) (hqbound : ∀ x, |q x| ≤ Q)
    (hHess : ∀ x (ξ : TangentSpace I x), -c * ‖ξ‖ ^ 2 ≤ hessian I φ x ξ ξ)
    (hNormal : ∀ x, h ≤ hessian I φ x (mgradient I φ x) (mgradient I φ x))
    (hGrad : ∀ x, ‖mgradient I φ x‖ ^ 2 ≤ w)
    (hBiLap : ∀ x, |laplaceBeltrami I (laplaceBeltrami I φ) x| ≤ d) :
    ∃ T : ℝ, 1 ≤ T ∧ ∀ τ : ℝ, T ≤ τ → ∀ u : M → ℝ,
      ContMDiff I 𝓘(ℝ) ∞ u → HasCompactSupport u →
      ((h - c * w) / 4) * τ ^ 3 * (∫ x, Real.exp (2 * τ * φ x) * u x ^ 2 ∂μ) ≤
        ∫ x, Real.exp (2 * τ * φ x) * (laplaceBeltrami I u x - q x * u x) ^ 2 ∂μ := by
  obtain ⟨T, hT, hestimate⟩ := exists_weighted_carleman_schrodinger_estimate_on hφ hq Set.univ
    hc hd hgap hQ (fun x _ => hqbound x) (fun x _ ξ => hHess x ξ)
    (fun x _ => hNormal x) (fun x _ => hGrad x) (fun x _ => hBiLap x)
  exact ⟨T, hT, fun τ hτ u hu huc => hestimate τ hτ u hu huc (Set.subset_univ _)⟩

end ConformalPoisson

end ProofPart_CarlemanWeighted

