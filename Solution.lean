    (hα : α ≤ 1)
    (A : V → V →L[ℝ] V) (β : V → V) (q G u : V → ℝ)
    (hA : AnalyticOnNhd ℝ A (ball 0 4)) (hβ : AnalyticOnNhd ℝ β (ball 0 4))
    (hq : AnalyticOnNhd ℝ q (ball 0 4)) (hG : AnalyticOnNhd ℝ G (ball 0 4))
    (hu : ContDiffOn ℝ ∞ u (boundaryHalfBall 4))
    (hAn : ∀ x ∈ ball (0 : V) 4, A x e = e)
    (hArow : ∀ x ∈ ball (0 : V) 4, ∀ v : V, A x v 0 = v 0)
    (hzero : ∀ x ∈ ball (0 : V) 4, x 0 = 0 → u x = 0)
    (hLu : ∀ x ∈ ball (0 : V) 4, 0 < x 0 →
      coordinateSchrodinger A (boundaryNormalDrift β) q u x = x 0 * G x)
    (A0 : H (V →L[ℝ] V)) (B0 : H V) (Q0 : H ℝ)
    (hA0 : ∀ x : closedBall (0 : V) 1, A0 x = A (boundaryFold x))
    (hB0 : ∀ x : closedBall (0 : V) 1, B0 x = normalFactorReflectedDrift β x)
    (hQ0 : ∀ x : closedBall (0 : V) 1, Q0 x = q (boundaryFold x))
    (S : (H ℝ) →L[ℝ] BX) (hinv : (S.comp (ballSchrodinger hα A0 B0 Q0)).IsInvertible) :
    AnalyticWithinAt ℝ u {x : V | 0 ≤ x 0} 0 := by
  let P := boundaryHalfBall (n := n) 4
  have hP : UniqueDiffOn ℝ P := uniqueDiffOn_boundaryHalfBall (by norm_num)
  have hPc : ∀ x ∈ P, x ∈ closure (interior P) := boundaryHalfBall_subset_closure_interior (by norm_num)
  let F : V → ℝ := fun x => x 0 * G x
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  have hF : AnalyticOnNhd ℝ F (ball 0 4) := fun x hx => (N.analyticAt x).mul (hG x hx)
  have hb := boundaryNormalDrift_analyticOnNhd β hβ
  have hLeq : EqOn (relativeCoordinateSchrodinger P A (boundaryNormalDrift β) q u) F P := by
    apply relativeCoordinateSchrodinger_eq_source_on_closure hP hPc
      (hA.continuousOn.mono inter_subset_left) (hb.continuousOn.mono inter_subset_left)
      (hq.continuousOn.mono inter_subset_left) hu (hF.continuousOn.mono inter_subset_left)
    intro x hx
    rw [interior_boundaryHalfBall] at hx
    exact hLu x hx.1 hx.2
  have hnn : ∀ x ∈ ball (0 : V) 4, x 0 = 0 →
      iteratedFDerivWithinAlong P [e, e] u x = 0 := by
    intro x hx hx0
    apply boundary_normal_second_trace_eq_zero_of_equation hP hu (Subset.rfl) hzero
      A (boundaryNormalDrift β) q hx hx0 (hAn x hx)
    · intro i hi
      rw [hArow x hx]
      simp [hi, Ne.symm hi]
    · simp [hx0]
    · simpa [F, hx0] using hLeq ⟨hx, hx0.ge⟩
  let w := boundaryOddReflection u
  have hw : ContDiffOn ℝ 3 w (ball 0 3) :=
    (contDiffOn_boundaryOddReflection_of_zero_normal_second_trace hP hPc hu
      (by norm_num : (3 : ℝ) < 4) (Subset.rfl) hzero hnn).mono ball_subset_closedBall
  have h34 : ball (0 : V) 3 ⊆ ball 0 4 := ball_subset_ball (by norm_num)
  have huAt (x : V) (hx : x ∈ ball (0 : V) 3) (hx0 : 0 < x 0) : ContDiffAt ℝ 2 u x := by
    have hxi : x ∈ interior P := by rw [interior_boundaryHalfBall]; exact ⟨h34 hx, hx0⟩
    exact ((hu x (interior_subset hxi)).contDiffAt (mem_interior_iff_mem_nhds.mp hxi)).of_le (by simp)
  have hLw : ∀ x ∈ ball (0 : V) 3,
      coordinateSchrodinger (fun y => A (boundaryFold y)) (normalFactorReflectedDrift β)
        (fun y => q (boundaryFold y)) w x = x 0 * G (boundaryFold x) :=
    coordinateSchrodinger_boundaryOddReflection_on_ball A (boundaryNormalDrift β) β q G u
      (hA.continuousOn.mono h34) (hβ.continuousOn.mono h34)
      (hq.continuousOn.mono h34) (hG.continuousOn.mono h34)
      (fun x hx _ => hAn x (h34 hx)) (fun x hx _ => hArow x (h34 hx))
      (fun _ _ _ => rfl) huAt (fun x hx hx0 => hLu x (h34 hx) hx0) hw
  obtain ⟨χ, hχ, hχbound, hχnear, hχsphere, _, hχfold⟩ := exists_boundaryTranslation_cutoff (n := n)
  have hχ1 : ContDiff ℝ 1 χ := hχ.of_le (by simp)
  have hK4 : closedBall (0 : V) 1 ⊆ ball 0 4 := closedBall_subset_ball (by norm_num)
  obtain ⟨Tnormal, hTnormal⟩ := exists_normalCoordinateHolder (n := n) hα
  obtain ⟨UA, AH, hUA, h0A, hAH, hAread⟩ :=
    exists_tangential_evenFold_holder_family hα A χ hχ1 hχfold isOpen_ball hK4 hA
  obtain ⟨UB, BH, hUB, h0B, hBH, hBread⟩ :=
    exists_tangential_reflectedDrift_holder_family hα Tnormal hTnormal β χ hχ1 hχfold isOpen_ball hK4 hβ
  obtain ⟨UQ, QH, hUQ, h0Q, hQH, hQread⟩ :=
    exists_tangential_evenFold_holder_family hα q χ hχ1 hχfold isOpen_ball hK4 hq
  obtain ⟨UG, GH, hUG, h0G, hGH, hGread⟩ :=
    exists_tangential_normalFactor_holder_family hα Tnormal hTnormal G χ hχ1 hχfold isOpen_ball hK4 hG
  have hAH0 : AH 0 = A0 := by
    apply TauCeti.HolderSpace.ext
    intro x
    rw [hAread 0 h0A x, hA0 x]
    simp [localizedTranslation]
  have hBH0 : BH 0 = B0 := by
    apply TauCeti.HolderSpace.ext
    intro x
    rw [hBread 0 h0B x, hB0 x]
    simp [localizedTranslation]
  have hQH0 : QH 0 = Q0 := by
    apply TauCeti.HolderSpace.ext
    intro x
    rw [hQread 0 h0Q x, hQ0 x]
    simp [localizedTranslation]
  obtain ⟨Jdiff, hJdiff, hJread⟩ := exists_analytic_tangential_solution_difference_family hα
    (fun y => A (boundaryFold y)) (normalFactorReflectedDrift β) (fun y => q (boundaryFold y))
    (fun y => y 0 * G (boundaryFold y)) w χ hχ hχbound hχsphere hw hLw AH BH QH GH
    (hAH 0 h0A) (hBH 0 h0B) (hQH 0 h0Q) (hGH 0 h0G)
    (by filter_upwards [hUA.mem_nhds h0A] with a ha; exact hAread a ha)
    (by filter_upwards [hUB.mem_nhds h0B] with a ha; exact hBread a ha)
    (by filter_upwards [hUQ.mem_nhds h0Q] with a ha; exact hQread a ha)
    (by
      filter_upwards [hUG.mem_nhds h0G] with a ha
      intro x
      simpa [localizedTranslation] using hGread a ha x)
    S (by rwa [hAH0, hBH0, hQH0])
  obtain ⟨Ψ, hΨ, hΨread⟩ := exists_analytic_holder_jet_translation_readings hα χ w hχ hχbound hw
    Jdiff hJdiff hJread
  obtain ⟨ρ, hρ, hρχ⟩ := Metric.mem_nhds_iff.mp hχnear
  let r : ℝ := min (ρ / 2) (1 / 2)
  have hr : 0 < r := lt_min (by positivity) (by norm_num)
  have hr1 : r ≤ 1 := (min_le_right _ _).trans (by norm_num)
  have hrρ : r < ρ := (min_le_left _ _).trans_lt (by linarith)
  let K := boundaryHalfBall (n := n) r
  let O : Set V := ball 0 3 ∩ {x : V | 0 < x 0}
  have hO : IsOpen O := isOpen_ball.inter (isOpen_lt continuous_const N.continuous)
  have hKO : interior K ⊆ O := by
    rw [interior_boundaryHalfBall]
    intro x hx
    exact ⟨(ball_subset_ball (hr1.trans (by norm_num : (1 : ℝ) ≤ 3))) hx.1, hx.2⟩
  have hKball : interior K ⊆ closedBall (0 : V) 1 := by
    rw [interior_boundaryHalfBall]
    exact fun _ hx => ball_subset_closedBall ((ball_subset_ball hr1) hx.1)
  have hKP : K ⊆ P := inter_subset_inter_left _ (ball_subset_ball (hr1.trans (by norm_num)))
  have hOP : O ⊆ P := by
    intro x hx
    change x ∈ ball (0 : V) 3 ∧ 0 < x 0 at hx
    exact ⟨h34 hx.1, le_of_lt hx.2⟩
  have hquiet (x : V) (hx : x ∈ interior K) : ∀ᶠ y in 𝓝 x, χ y = 1 := by
    have hxρ : x ∈ ball (0 : V) ρ :=
      (ball_subset_ball hrρ.le) ((interior_boundaryHalfBall r ▸ hx).1)
    exact Filter.mem_of_superset (isOpen_ball.mem_nhds hxρ) hρχ
  have hanalytic : AnalyticWithinAt ℝ u K 0 := by
    apply analyticWithinAt_zero_of_coordinate_equation_and_tangent_family (S := O) (W := ball 0 4) (T := K)
      hα hO isOpen_ball (fun _ hx => h34 hx.1) hK4 hKO hKball (uniqueDiffOn_boundaryHalfBall hr)
      (convex_boundaryHalfBall r) ⟨mem_ball_self hr, by simp⟩
      (boundaryHalfBall_subset_closure_interior hr) χ hχ1
      (fun x hx => (hquiet x hx).self_of_nhds) A (boundaryNormalDrift β) q F u
      hA hb hq hF (hu.mono hOP) (hu.mono hKP)
      (fun x hx => hAn x (h34 hx.1)) (fun x hx => hArow x (h34 hx.1))
      (fun x hx => hLu x (h34 hx.1) hx.2) Ψ hΨ
    · intro x hx
      filter_upwards [hΨread ⟨x, hKball hx⟩ (hquiet x hx)] with a ha
      rw [ha.1]
      exact boundaryOddReflection_eq_of_nonneg u _ (by
        simpa using (hKO hx).2.le)
    · intro x hx
      filter_upwards [hΨread ⟨x, hKball hx⟩ (hquiet x hx)] with a ha
      rw [ha.2]
      rw [(boundaryOddReflection_eventuallyEq_of_pos u
        (show 0 < (x + boundaryTangentialProjection a) 0 by simpa using (hKO hx).2)).fderiv_eq]
  exact hanalytic.mono_of_mem_nhdsWithin (boundaryHalfBall_mem_nhdsWithin hr)

end ConformalPoisson

