noncomputable section ProofPart_GreenTrace_NativeMixedDerivatives







/- Interchanging derivatives in the two native factors, including physical
boundary points. Genuine smooth fields through the two supplied vectors have
commuting horizontal and vertical lifts, so the native Lie-bracket identity
supplies the interchange without an ambient reflection. -/
open Bundle Set Filter TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "Evec" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem native_mvfderiv_slice_fst {F : M × M → ℝ} {x y : M}
    (hF : MDifferentiableAt ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) 𝓘(ℝ) F (x, y))
    (v : TangentSpace Ihalf x) :
    mvfderiv Ihalf (fun z => F (z, y)) x v =
      mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) F (x, y) (v, 0) := by
  have hd := mvfderiv_comp_of_eq hF
    (mdifferentiableAt_id.prodMk mdifferentiableAt_const) (rfl : (x, y) = (x, y))
  dsimp only [id_eq] at hd
  rw [mfderiv_prod_left] at hd
  exact congrArg (fun L => L v) (hd.trans (by ext w; rfl))

set_option maxHeartbeats 1200000 in
without_proof_info in
theorem native_mixed_derivatives_commute {F : M × M → ℝ} {x y : M}
    (hF : ContMDiffAt ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) 𝓘(ℝ) ∞ F (x, y))
    (v : TangentSpace Ihalf x) (w : TangentSpace Ihalf y) :
    mvfderiv Ihalf (fun z => mvfderiv Ihalf (fun r => F (z, r)) y w) x v =
      mvfderiv Ihalf (fun r => mvfderiv Ihalf (fun z => F (z, r)) x v) y w := by
  let : ContMDiffVectorBundle ∞ Evec (TangentSpace Ihalf : M → Type _) Ihalf := TangentBundle.contMDiffVectorBundle
  obtain ⟨X, hX, hXx⟩ := FiberBundle.exists_contMDiff_section_eq Ihalf Evec ∞ v
  obtain ⟨Y, hY, hYy⟩ := FiberBundle.exists_contMDiff_section_eq Ihalf Evec ∞ w
  have h0 : ContMDiff Ihalf ((𝓡∂ (n + 1)).tangent) ∞
      (fun z : M => (TotalSpace.mk' Evec z 0 : TangentBundle Ihalf M)) :=
    contMDiff_tangentBundle_mk_zero contMDiff_id
  have hH := contMDiff_prodVectorField hX h0
  have hV := contMDiff_prodVectorField h0 hY
  let A : M × M → ℝ := fun p => mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) F p
    (prodVectorField (0 : (z : M) → TangentSpace Ihalf z) Y p)
  let B : M × M → ℝ := fun p => mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) F p
    (prodVectorField X (0 : (z : M) → TangentSpace Ihalf z) p)
  have hA : MDifferentiableAt ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) 𝓘(ℝ) A (x, y) :=
    (((hF.contMDiffAt_mvfderiv_apply (m := ∞) (by simp : (∞ : ℕ∞ω) + 1 ≤ (∞ : ℕ∞ω))).comp (x, y) (hV (x, y))).mdifferentiableAt (by simp : (∞ : ℕ∞ω) ≠ 0))
  have hB : MDifferentiableAt ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) 𝓘(ℝ) B (x, y) :=
    (((hF.contMDiffAt_mvfderiv_apply (m := ∞) (by simp : (∞ : ℕ∞ω) + 1 ≤ (∞ : ℕ∞ω))).comp (x, y) (hH (x, y))).mdifferentiableAt (by simp : (∞ : ℕ∞ω) ≠ 0))
  have hNear := hF.eventually_mdifferentiableAt (by simp : (∞ : ℕ∞ω) ≠ 0)
  have hASlice : (fun z => A (z, y)) =ᶠ[𝓝 x]
      (fun z => mvfderiv Ihalf (fun r => F (z, r)) y w) := by
    filter_upwards [(continuous_id.prodMk continuous_const).continuousAt.eventually hNear] with z hz
    have h := congrArg (fun L => L w) (TauCeti.mvfderiv_curry_right z y hz)
    have hpair : prodVectorField (0 : (r : M) → TangentSpace Ihalf r) Y (z, y) = (0, w) := by
      apply Prod.ext <;> simp only [prodVectorField_fst, prodVectorField_snd, Pi.zero_apply, hYy]
    change mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) F (z, y) _ = _
    rw [hpair]
    exact h.symm
  have hBSlice : (fun r => B (x, r)) =ᶠ[𝓝 y]
      (fun r => mvfderiv Ihalf (fun z => F (z, r)) x v) := by
    filter_upwards [(continuous_const.prodMk continuous_id).continuousAt.eventually hNear] with r hr
    have hpair : prodVectorField X (0 : (z : M) → TangentSpace Ihalf z) (x, r) = (v, 0) := by
      apply Prod.ext <;> simp only [prodVectorField_fst, prodVectorField_snd, Pi.zero_apply, hXx]
    change mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) F (x, r) _ = _
    rw [hpair]
    exact (native_mvfderiv_slice_fst hr v).symm
  have hLie := mvfderiv_mlieBracket
    (V := prodVectorField X (0 : (z : M) → TangentSpace Ihalf z))
    (W := prodVectorField (0 : (z : M) → TangentSpace Ihalf z) Y) hF (by simp : minSmoothness ℝ 2 ≤ (∞ : ℕ∞ω))
    ((hH (x, y)).mdifferentiableAt (by simp)) ((hV (x, y)).mdifferentiableAt (by simp))
  have hBracket := mlieBracket_prodVectorField_horizontal_vertical
    (I := Ihalf) (J := Ihalf) (p := (x, y)) (X := X) (V := Y)
    ((hX x).mdifferentiableAt (by simp)) ((hY y).mdifferentiableAt (by simp))
  rw [hBracket, map_zero] at hLie
  have hHorizontal : prodVectorField X (0 : (z : M) → TangentSpace Ihalf z) (x, y) = (v, 0) := by
    apply Prod.ext <;> simp only [prodVectorField_fst, prodVectorField_snd, Pi.zero_apply, hXx]
  have hVertical : prodVectorField (0 : (z : M) → TangentSpace Ihalf z) Y (x, y) = (0, w) := by
    apply Prod.ext <;> simp only [prodVectorField_fst, prodVectorField_snd, Pi.zero_apply, hYy]
  rw [hHorizontal, hVertical] at hLie
  change 0 = mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) A (x, y) (v, 0) -
    mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) B (x, y) (0, w) at hLie
  have hOutA := native_mvfderiv_slice_fst hA v
  have hOutB := congrArg (fun L => L w) (TauCeti.mvfderiv_curry_right x y hB)
  change mvfderiv Ihalf (fun r => B (x, r)) y w =
    mvfderiv ((𝓡∂ (n + 1)).prod (𝓡∂ (n + 1))) B (x, y) (0, w) at hOutB
  rw [← hOutA, ← hOutB, hASlice.mvfderiv_eq, hBSlice.mvfderiv_eq] at hLie
  linarith only [hLie]
end ConformalPoisson

end ProofPart_GreenTrace_NativeMixedDerivatives

/- Green/trace proof support: ScalarSymbolEllipticity.lean, SHA256 ad402af4e3d951054d06e611c0231555b4c30d03767abf22bd5024cfc2825284 -/
noncomputable section ProofPart_GreenTrace_ScalarSymbolEllipticity



/- Scalar second-order symbols with a positive quadratic real part are
uniformly elliptic above a fixed radius. The bounded zeroth-order error
may have either sign. -/
open TauCeti
namespace ConformalPoisson

without_proof_info in
theorem scalar_id_isInvertible_and_norm_inverse (c : ℂ) (hc : c ≠ 0) :
    (c • ContinuousLinearMap.id ℂ ℂ).IsInvertible ∧
      ‖(c • ContinuousLinearMap.id ℂ ℂ).inverse‖ = ‖c‖⁻¹ := by
  have hleft : (c • ContinuousLinearMap.id ℂ ℂ) ∘L (c⁻¹ • ContinuousLinearMap.id ℂ ℂ) =
      ContinuousLinearMap.id ℂ ℂ := by
    ext z
    simp [smul_eq_mul, hc]
  have hright : (c⁻¹ • ContinuousLinearMap.id ℂ ℂ) ∘L (c • ContinuousLinearMap.id ℂ ℂ) =
      ContinuousLinearMap.id ℂ ℂ := by
    ext z
    simp [smul_eq_mul, hc]
  refine ⟨ContinuousLinearMap.IsInvertible.of_inverse hleft hright, ?_⟩
  rw [ContinuousLinearMap.inverse_eq hleft hright, norm_smul, ContinuousLinearMap.norm_id,
    mul_one, norm_inv]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem scalar_symbol_uniformly_elliptic_of_re_lower_bound
    {d : ℕ} (a : Symbol d ℂ ℂ 2) (s : CoordinateSpace d → CoordinateSpace d → ℂ)
    (hcoeff : ∀ x ξ, a.coefficient (x, ξ) = s x ξ • ContinuousLinearMap.id ℂ ℂ)
    {lam C₀ : ℝ} (hlam : 0 < lam) (hC₀ : 0 ≤ C₀)
    (hlower : ∀ x ξ, lam * ‖ξ‖ ^ 2 - C₀ ≤ (s x ξ).re) :
    ∃ R > 0, a.IsUniformlyEllipticAbove R := by
  let R := 1 + 2 * C₀ / lam
  have hRone : 1 ≤ R := le_add_of_nonneg_right (div_nonneg (mul_nonneg (by norm_num) hC₀) hlam.le)
  have hRpos : 0 < R := zero_lt_one.trans_le hRone
  have hRL : lam * R = lam + 2 * C₀ := by
    dsimp only [R]
    field_simp <;> ring
  refine ⟨R, hRpos, ?_⟩
  apply Symbol.isUniformlyEllipticAbove_iff.mpr
  refine ⟨4 / lam, fun x ξ hξ => ?_⟩
  have hN : 1 ≤ ‖ξ‖ := hRone.trans hξ
  have hNpos : 0 < ‖ξ‖ := zero_lt_one.trans_le hN
  have hsq : ‖ξ‖ ≤ ‖ξ‖ ^ 2 := by nlinarith
  have hNlam := mul_le_mul_of_nonneg_left hξ hlam.le
  have hsqlam := mul_le_mul_of_nonneg_left hsq hlam.le
  have hquad : 2 * C₀ ≤ lam * ‖ξ‖ ^ 2 := by linarith
  have hlow : lam / 2 * ‖ξ‖ ^ 2 ≤ (s x ξ).re := by linarith [hlower x ξ]
  have hbase : 0 < lam / 2 * ‖ξ‖ ^ 2 := mul_pos (div_pos hlam (by norm_num)) (sq_pos_of_pos hNpos)
  have hsne : s x ξ ≠ 0 := by
    intro hz
    have hp := hbase.trans_le hlow
    simpa only [hz, Complex.zero_re, lt_self_iff_false] using hp
  have hnorm : lam / 2 * ‖ξ‖ ^ 2 ≤ ‖s x ξ‖ := hlow.trans (Complex.re_le_norm _)
  have hinv : ‖s x ξ‖⁻¹ ≤ (lam / 2 * ‖ξ‖ ^ 2)⁻¹ :=
    by simpa only [one_div] using one_div_le_one_div_of_le hbase hnorm
  have hden : 0 < 1 + ‖ξ‖ ^ 2 := by positivity
  have hfrac : (lam / 2 * ‖ξ‖ ^ 2)⁻¹ ≤ (4 / lam) * (1 + ‖ξ‖ ^ 2)⁻¹ := by
    rw [← one_div, ← div_eq_mul_inv]
    apply (div_le_div_iff₀ hbase hden).mpr
    have heq : (4 / lam) * (lam / 2 * ‖ξ‖ ^ 2) = 2 * ‖ξ‖ ^ 2 := by
      field_simp <;> ring
    rw [heq, one_mul]
    nlinarith
  rw [hcoeff]
  obtain ⟨hInv, hInvnorm⟩ := scalar_id_isInvertible_and_norm_inverse (s x ξ) hsne
  refine ⟨hInv, ?_⟩
  rw [hInvnorm]
  norm_num only [neg_div, neg_neg, div_self (by norm_num : (2 : ℝ) ≠ 0), Real.rpow_neg_one]
  exact hinv.trans hfrac

end ConformalPoisson

end ProofPart_GreenTrace_ScalarSymbolEllipticity

/- Green/trace proof support: RealScalarDifferentialSymbol.lean, SHA256 81cc68a6de6ecd5ea90b70d1a7e8b3133d20f56c916698509ef5872e4227ff98 -/
noncomputable section ProofPart_GreenTrace_RealScalarDifferentialSymbol




/- Actual classical symbols of real scalar differential expressions of
order at most two. Ellipticity uses the quadratic part and a bounded
negative zeroth-order error; the first-order part is purely imaginary. -/
open TauCeti
open scoped ContDiff InnerProductSpace BigOperators
namespace ConformalPoisson
set_option backward.isDefEq.respectTransparency false
variable {d : ℕ} {ι : Type*} [Fintype ι]

def realScalarDifferentialSymbol (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (c : ι → CoordinateSpace d → ℝ) (hc : ∀ i, ContDiff ℝ ∞ (c i)) (hk : ∀ i, k i ≤ 2) :
    ClassicalSymbol d ℂ ℂ 2 :=
  ClassicalSymbol.ofDifferentialSymbol 2 Finset.univ v
    (fun i x => (c i x : ℂ) • ContinuousLinearMap.id ℂ ℂ)
    (fun i _ => by
      change ContDiff ℝ ∞ (fun x : CoordinateSpace d =>
        Complex.ofRealCLM (c i x) • ContinuousLinearMap.id ℂ ℂ)
      exact (Complex.ofRealCLM.contDiff.comp (hc i)).smul contDiff_const)
    (fun i _ => hk i)

def realScalarDifferentialPolynomial (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (c : ι → CoordinateSpace d → ℝ) (x ξ : CoordinateSpace d) : ℂ :=
  ∑ i, Complex.I ^ k i * (((∏ j, ⟪ξ, v i j⟫_ℝ) * c i x : ℝ) : ℂ)

without_proof_info in
theorem realScalarDifferentialSymbol_coefficient
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (c : ι → CoordinateSpace d → ℝ) (hc : ∀ i, ContDiff ℝ ∞ (c i)) (hk : ∀ i, k i ≤ 2)
    (x ξ : CoordinateSpace d) :
    (realScalarDifferentialSymbol k v c hc hk).toSymbol.coefficient (x, ξ) =
      realScalarDifferentialPolynomial k v c x ξ • ContinuousLinearMap.id ℂ ℂ := by
  rw [realScalarDifferentialSymbol, ClassicalSymbol.coefficient_toSymbol_ofDifferentialSymbol,
    differentialSymbol_eq_sum_pow_mul, realScalarDifferentialPolynomial]
  dsimp only
  rw [show (∑ i, Complex.I ^ k i * ↑((∏ j, ⟪ξ, v i j⟫_ℝ) * c i x)) •
      ContinuousLinearMap.id ℂ ℂ =
      ∑ i, (Complex.I ^ k i * ↑((∏ j, ⟪ξ, v i j⟫_ℝ) * c i x)) •
        ContinuousLinearMap.id ℂ ℂ from
          Finset.sum_smul (f := fun i : ι =>
            Complex.I ^ k i * ↑((∏ j, ⟪ξ, v i j⟫_ℝ) * c i x))
            (s := Finset.univ) (x := ContinuousLinearMap.id ℂ ℂ)]
  apply Finset.sum_congr rfl
  intro i _
  rw [smul_smul]
  congr 1
  push_cast
  ring

without_proof_info in
theorem re_I_pow_mul_real_of_le_two (k : ℕ) (hk : k ≤ 2) (r : ℝ) :
    (Complex.I ^ k * (r : ℂ)).re = (if k = 0 then r else 0) - (if k = 2 then r else 0) := by
  interval_cases k <;> simp [Complex.I_sq]

without_proof_info in
theorem realScalarDifferentialPolynomial_re
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (c : ι → CoordinateSpace d → ℝ) (hk : ∀ i, k i ≤ 2) (x ξ : CoordinateSpace d) :
    (realScalarDifferentialPolynomial k v c x ξ).re =
      (∑ i, if k i = 0 then (∏ j, ⟪ξ, v i j⟫_ℝ) * c i x else 0) -
      ∑ i, if k i = 2 then (∏ j, ⟪ξ, v i j⟫_ℝ) * c i x else 0 := by
  rw [realScalarDifferentialPolynomial, Complex.re_sum,
    ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i _
  exact re_I_pow_mul_real_of_le_two (k i) (hk i) _

without_proof_info in
theorem realScalarDifferentialSymbol_uniformly_elliptic
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (c : ι → CoordinateSpace d → ℝ) (hc : ∀ i, ContDiff ℝ ∞ (c i)) (hk : ∀ i, k i ≤ 2)
    {lam C₀ : ℝ} (hlam : 0 < lam) (hC₀ : 0 ≤ C₀)
    (hquadratic : ∀ x ξ, lam * ‖ξ‖ ^ 2 ≤
      -(∑ i, if k i = 2 then (∏ j, ⟪ξ, v i j⟫_ℝ) * c i x else 0))
    (hzero : ∀ x ξ, -C₀ ≤ ∑ i, if k i = 0 then (∏ j, ⟪ξ, v i j⟫_ℝ) * c i x else 0) :
    ∃ R > 0, (realScalarDifferentialSymbol k v c hc hk).toSymbol.IsUniformlyEllipticAbove R := by
  apply scalar_symbol_uniformly_elliptic_of_re_lower_bound
    (realScalarDifferentialSymbol k v c hc hk).toSymbol
    (realScalarDifferentialPolynomial k v c)
    (realScalarDifferentialSymbol_coefficient k v c hc hk) hlam hC₀
  intro x ξ
  rw [realScalarDifferentialPolynomial_re k v c hk]
  linarith [hquadratic x ξ, hzero x ξ]

end ConformalPoisson

end ProofPart_GreenTrace_RealScalarDifferentialSymbol

/- Green/trace proof support: SecondOrderScalarSymbol.lean, SHA256 8a4c93f19f4f6dbe187a937ba4886763e8faa1a5471a3e4a6f2092e38fa1f0f6 -/
noncomputable section ProofPart_GreenTrace_SecondOrderScalarSymbol



/- The actual scalar Fourier symbol of a non-divergence second-order
operator, with its native principal sign and arbitrary real lower terms. -/
open TauCeti
open scoped ContDiff InnerProductSpace
namespace ConformalPoisson
set_option backward.isDefEq.respectTransparency false

abbrev SecondOrderTerm (d : ℕ) := (Fin d × Fin d) ⊕ (Fin d ⊕ Unit)

def secondOrderTermOrder {d : ℕ} : SecondOrderTerm d → ℕ
  | Sum.inl _ => 2
  | Sum.inr (Sum.inl _) => 1
  | Sum.inr (Sum.inr _) => 0

def secondOrderTermDirections {d : ℕ} : ∀ i : SecondOrderTerm d,
    Fin (secondOrderTermOrder i) → CoordinateSpace d
  | Sum.inl ij => ![EuclideanSpace.single ij.1 1, EuclideanSpace.single ij.2 1]
  | Sum.inr (Sum.inl i) => fun _ => EuclideanSpace.single i 1
  | Sum.inr (Sum.inr _) => Fin.elim0

def secondOrderTermCoefficient {d : ℕ}
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ) :
    SecondOrderTerm d → CoordinateSpace d → ℝ
  | Sum.inl ij => fun x => -(A x (EuclideanSpace.single ij.1 1)) ij.2
  | Sum.inr (Sum.inl i) => fun x => b x i
  | Sum.inr (Sum.inr _) => q

without_proof_info in
theorem secondOrderTermOrder_le_two {d : ℕ} (i : SecondOrderTerm d) :
    secondOrderTermOrder i ≤ 2 := by
  rcases i with ij | (i | u) <;> simp [secondOrderTermOrder]

without_proof_info in
theorem contDiff_secondOrderTermCoefficient {d : ℕ}
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q)
    (i : SecondOrderTerm d) : ContDiff ℝ ∞ (secondOrderTermCoefficient A b q i) := by
  rcases i with ij | (i | u)
  · exact ((EuclideanSpace.proj ij.2).contDiff.comp (hA.clm_apply contDiff_const)).neg
  · exact (EuclideanSpace.proj i).contDiff.comp hb
  · exact hq

def secondOrderScalarSymbol {d : ℕ}
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q) :
    ClassicalSymbol d ℂ ℂ 2 :=
  realScalarDifferentialSymbol secondOrderTermOrder secondOrderTermDirections
    (secondOrderTermCoefficient A b q) (contDiff_secondOrderTermCoefficient A b q hA hb hq)
    secondOrderTermOrder_le_two

without_proof_info in
theorem secondOrderTerm_zero_sum {d : ℕ}
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (x ξ : CoordinateSpace d) :
    (∑ i : SecondOrderTerm d, if secondOrderTermOrder i = 0 then
      (∏ j, ⟪ξ, secondOrderTermDirections i j⟫_ℝ) * secondOrderTermCoefficient A b q i x else 0) = q x := by
  simp [Fintype.sum_sum_type, secondOrderTermOrder, secondOrderTermDirections,
    secondOrderTermCoefficient]

without_proof_info in
theorem secondOrderTerm_quadratic_sum {d : ℕ}
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (x ξ : CoordinateSpace d) :
    -(∑ i : SecondOrderTerm d, if secondOrderTermOrder i = 2 then
      (∏ j, ⟪ξ, secondOrderTermDirections i j⟫_ℝ) * secondOrderTermCoefficient A b q i x else 0) =
      ⟪A x ξ, ξ⟫_ℝ := by
  simp only [Fintype.sum_sum_type, secondOrderTermOrder, secondOrderTermDirections,
    secondOrderTermCoefficient, if_true, if_false, Finset.sum_const_zero, add_zero,
    Fin.prod_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    EuclideanSpace.inner_single_right, one_mul, RCLike.conj_to_real, Fintype.sum_prod_type]
  norm_num only [show (1 : ℕ) ≠ 2 by decide, show (0 : ℕ) ≠ 2 by decide,
    if_false, Finset.sum_const_zero, add_zero]
  rw [← coordinatePrincipalMatrix_bilinear, TauCeti.PDE.matrixBilinearForm_apply]
  simp only [dotProduct, Matrix.mulVec, coordinatePrincipalMatrix, Finset.mul_sum,
    ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

without_proof_info in
theorem secondOrderScalarSymbol_uniformly_elliptic {d : ℕ}
    (A : CoordinateSpace d → CoordinateSpace d →L[ℝ] CoordinateSpace d)
    (b : CoordinateSpace d → CoordinateSpace d) (q : CoordinateSpace d → ℝ)
    (hA : ContDiff ℝ ∞ A) (hb : ContDiff ℝ ∞ b) (hq : ContDiff ℝ ∞ q)
    {lam C₀ : ℝ} (hlam : 0 < lam) (hC₀ : 0 ≤ C₀)
    (hell : ∀ x ξ, lam * ‖ξ‖ ^ 2 ≤ ⟪A x ξ, ξ⟫_ℝ)
    (hzero : ∀ x, -C₀ ≤ q x) :
    ∃ R > 0, (secondOrderScalarSymbol A b q hA hb hq).toSymbol.IsUniformlyEllipticAbove R := by
  apply realScalarDifferentialSymbol_uniformly_elliptic _ _ _ _ _ hlam hC₀
  · intro x ξ
    rw [secondOrderTerm_quadratic_sum]
    exact hell x ξ
  · intro x ξ
    rw [secondOrderTerm_zero_sum]
    exact hzero x

end ConformalPoisson

end ProofPart_GreenTrace_SecondOrderScalarSymbol

/- Green/trace proof support: QuantizeTranspose.lean, SHA256 7b3ad44e7aca4f8df1134c5bb24757018b39a1446db8afe443267146746c8c3a -/
noncomputable section ProofPart_GreenTrace_QuantizeTranspose



/- A Schwartz transposition identity determines the quantized operator
on every Sobolev order. This is the bridge from native weak test equations
to the pinned elliptic parametrix. -/
open TauCeti MeasureTheory TemperedDistribution
open scoped SchwartzMap BesselPotentialSpace
namespace ConformalPoisson
variable {d : ℕ}

def besselToDistributionCLM (d : ℕ) (s : ℝ) :
    H^{s}(CoordinateSpace d, ℂ) →L[ℂ] 𝓢'(CoordinateSpace d, ℂ) :=
  besselPotential (CoordinateSpace d) ℂ (-s) ∘L
    Lp.toTemperedDistributionCLM (E := CoordinateSpace d) ℂ volume 2 ∘L
      (BesselPotentialSpace.toLpₗᵢ (CoordinateSpace d) ℂ s 2).toContinuousLinearEquiv.toContinuousLinearMap

without_proof_info in
@[simp] theorem besselToDistributionCLM_apply (s : ℝ)
    (u : H^{s}(CoordinateSpace d, ℂ)) : besselToDistributionCLM d s u = u.toDistr := by
  simp only [besselToDistributionCLM, ContinuousLinearMap.comp_apply,
    ContinuousLinearEquiv.coe_coe, LinearIsometryEquiv.coe_toContinuousLinearEquiv,
    BesselPotentialSpace.toLpₗᵢ_apply, Lp.toTemperedDistributionCLM_apply]
  exact BesselPotentialSpace.besselPotential_neg_toLp_eq (f := u)

without_proof_info in
theorem quantizeSobolev_eq_transpose_of_schwartz
    {m : ℝ} (a : Symbol d ℂ ℂ m) (ha : a.HasCompactSpatialSupport)
    (B : 𝓢(CoordinateSpace d, ℂ) →L[ℂ] 𝓢(CoordinateSpace d, ℂ))
    (hB : ∀ u ψ : 𝓢(CoordinateSpace d, ℂ),
      (∫ x, ψ x * quantizeSchwartzValue a.coefficient u x) = ∫ x, B ψ x * u x)
    (s : ℝ) (u : H^{s}(CoordinateSpace d, ℂ)) :
    (a.quantizeSobolev ha s u).toDistr = PointwiseConvergenceCLM.precomp ℂ B u.toDistr := by
  have h : besselToDistributionCLM d (s - m) ∘L a.quantizeSobolev ha s =
      (PointwiseConvergenceCLM.precomp ℂ B) ∘L besselToDistributionCLM d s := by
    apply BesselPotentialSpace.continuousLinearMap_ext (s := s) (p := 2) ENNReal.ofNat_ne_top
    intro v
    ext ψ
    simp only [ContinuousLinearMap.comp_apply, besselToDistributionCLM_apply,
      Symbol.toDistr_quantizeSobolev_toBesselPotentialSpaceCLM_apply,
      SchwartzMap.toDistr_toBesselPotentialSpaceCLM]
    change (∫ x, ψ x * quantizeSchwartzValue a.coefficient v x) =
      (v : 𝓢'(CoordinateSpace d, ℂ)) (B ψ)
    rw [SchwartzMap.coe_apply]
    exact hB v ψ
  simpa only [ContinuousLinearMap.comp_apply, besselToDistributionCLM_apply] using
    congrArg (fun T => T u) h

without_proof_info in
theorem quantizeSobolev_eq_zero_of_transpose_tests
    {m : ℝ} (a : Symbol d ℂ ℂ m) (ha : a.HasCompactSpatialSupport)
    (B : 𝓢(CoordinateSpace d, ℂ) →L[ℂ] 𝓢(CoordinateSpace d, ℂ))
    (hB : ∀ u ψ : 𝓢(CoordinateSpace d, ℂ),
      (∫ x, ψ x * quantizeSchwartzValue a.coefficient u x) = ∫ x, B ψ x * u x)
    (s : ℝ) (u : H^{s}(CoordinateSpace d, ℂ))
    (hzero : ∀ ψ : 𝓢(CoordinateSpace d, ℂ), u.toDistr (B ψ) = 0) :
    (a.quantizeSobolev ha s u).toDistr = 0 := by
  rw [quantizeSobolev_eq_transpose_of_schwartz a ha B hB s u]
  ext ψ
  exact hzero ψ

end ConformalPoisson

end ProofPart_GreenTrace_QuantizeTranspose

/- Green/trace proof support: ScalarDifferentialTranspose.lean, SHA256 2bee1be1e929ef04a32e474c1ecdfb14368dee6875fcf6b62b98a15b6bb7222d -/
noncomputable section ProofPart_GreenTrace_ScalarDifferentialTranspose




/- Transposition of scalar differential expressions of order at most two,
with their actual signs and coefficient multiplications. -/
open TauCeti MeasureTheory LineDeriv
open scoped SchwartzMap ContDiff BesselPotentialSpace
namespace ConformalPoisson
variable {d : ℕ} {ι : Type*} [Fintype ι]

without_proof_info in
theorem integral_mul_iteratedLineDeriv_le_two {k : ℕ} (hk : k ≤ 2)
    (v : Fin k → CoordinateSpace d) (f g : 𝓢(CoordinateSpace d, ℂ)) :
    (∫ x, f x * ∂^{v} g x) = (-1 : ℂ) ^ k * ∫ x, ∂^{v} f x * g x := by
  interval_cases k
  · simp
  · simpa using SchwartzMap.integral_mul_lineDerivOp_right_eq_neg_left f g (v 0)
  · simp only [iteratedLineDerivOp_succ_left, iteratedLineDerivOp_one,
      iteratedLineDerivOp_fin_zero, Fin.tail_def, Fin.succ_zero_eq_one, neg_one_sq, one_mul]
    rw [SchwartzMap.integral_mul_lineDerivOp_right_eq_neg_left,
      SchwartzMap.integral_mul_lineDerivOp_right_eq_neg_left, neg_neg]
    rw [SchwartzMap.lineDerivOp_comm f (v 0) (v 1)]

def scalarDifferentialTransposeTestCLM
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) :
    𝓢(CoordinateSpace d, ℂ) →L[ℂ] 𝓢(CoordinateSpace d, ℂ) :=
  ∑ i, (-1 : ℂ) ^ k i •
    (iteratedLineDerivOpCLM ℂ 𝓢(CoordinateSpace d, ℂ) (v i) ∘L
      SchwartzMap.smulLeftCLM ℂ (b i))

without_proof_info in
theorem scalarDifferentialTransposeTestCLM_apply
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) (ψ : 𝓢(CoordinateSpace d, ℂ)) :
    scalarDifferentialTransposeTestCLM k v b ψ =
      ∑ i, (-1 : ℂ) ^ k i • ∂^{v i} (SchwartzMap.smulLeftCLM ℂ (b i) ψ) := by
  simp only [scalarDifferentialTransposeTestCLM, ContinuousLinearMap.sum_apply,
    ContinuousLinearMap.smul_apply, ContinuousLinearMap.comp_apply,
    iteratedLineDerivOpCLM_apply]

def scalarDifferentialSymbol
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) (hb : ∀ i, (b i).HasTemperateGrowth)
    (hk : ∀ i, k i ≤ 2) : ClassicalSymbol d ℂ ℂ 2 :=
  ClassicalSymbol.ofDifferentialSymbol 2 Finset.univ v
    (fun i x => b i x • ContinuousLinearMap.id ℂ ℂ)
    (fun i _ => (hb i).1.smul contDiff_const) (fun i _ => hk i)

without_proof_info in
theorem scalarDifferentialSymbol_quantize
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) (hb : ∀ i, (b i).HasTemperateGrowth)
    (hk : ∀ i, k i ≤ 2) (u : 𝓢(CoordinateSpace d, ℂ)) (x : CoordinateSpace d) :
    quantizeSchwartzValue (scalarDifferentialSymbol k v b hb hk).toSymbol.coefficient u x =
      ∑ i, b i x * ∂^{v i} u x := by
  rw [scalarDifferentialSymbol, ClassicalSymbol.quantizeSchwartzValue_ofDifferentialSymbol]
  simp only [smul_apply, ContinuousLinearMap.id_apply, smul_eq_mul]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem integral_scalarDifferentialSymbol_transpose
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) (hb : ∀ i, (b i).HasTemperateGrowth)
    (hk : ∀ i, k i ≤ 2) (u ψ : 𝓢(CoordinateSpace d, ℂ)) :
    (∫ x, ψ x * quantizeSchwartzValue
      (scalarDifferentialSymbol k v b hb hk).toSymbol.coefficient u x) =
      ∫ x, scalarDifferentialTransposeTestCLM k v b ψ x * u x := by
  let f : ι → 𝓢(CoordinateSpace d, ℂ) := fun i => SchwartzMap.smulLeftCLM ℂ (b i) ψ
  have hleft : ∀ i, Integrable (fun x => f i x * ∂^{v i} u x) := fun i =>
    (SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (f i) (∂^{v i} u)).integrable
  have hright : ∀ i, Integrable (fun x => (-1 : ℂ) ^ k i * ∂^{v i} (f i) x * u x) := by
    intro i
    exact ((SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (∂^{v i} (f i)) u).integrable.const_mul
      ((-1 : ℂ) ^ k i)).congr (Filter.Eventually.of_forall fun x => by
        simp only [SchwartzMap.pairing_apply_apply]
        change (-1 : ℂ) ^ k i * (∂^{v i} (f i) x * u x) =
          (-1 : ℂ) ^ k i * ∂^{v i} (f i) x * u x
        ring)
  calc
    _ = ∫ x, ∑ i, f i x * ∂^{v i} u x := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [scalarDifferentialSymbol_quantize, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      simp only [f, SchwartzMap.smulLeftCLM_apply_apply (hb i), smul_eq_mul]
      ring
    _ = ∑ i, ∫ x, f i x * ∂^{v i} u x := integral_finsetSum _ (fun i _ => hleft i)
    _ = ∑ i, (-1 : ℂ) ^ k i * ∫ x, ∂^{v i} (f i) x * u x := by
      apply Finset.sum_congr rfl
      intro i _
      exact integral_mul_iteratedLineDeriv_le_two (hk i) (v i) (f i) u
    _ = ∑ i, ∫ x, (-1 : ℂ) ^ k i * ∂^{v i} (f i) x * u x := by
      apply Finset.sum_congr rfl
      intro i _
      rw [← integral_const_mul]
      apply integral_congr_ae
      exact Filter.Eventually.of_forall fun x => by ring
    _ = ∫ x, ∑ i, (-1 : ℂ) ^ k i * ∂^{v i} (f i) x * u x :=
      (integral_finsetSum _ (fun i _ => hright i)).symm
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with x
      rw [scalarDifferentialTransposeTestCLM_apply]
      simp only [sum_apply, smul_apply, smul_eq_mul, Finset.sum_mul, f]

without_proof_info in
theorem scalarDifferentialSymbol_quantizeSobolev_eq_transpose
    (k : ι → ℕ) (v : ∀ i, Fin (k i) → CoordinateSpace d)
    (b : ι → CoordinateSpace d → ℂ) (hb : ∀ i, (b i).HasTemperateGrowth)
    (hk : ∀ i, k i ≤ 2)
    (ha : (scalarDifferentialSymbol k v b hb hk).toSymbol.HasCompactSpatialSupport)
    (s : ℝ) (u : H^{s}(CoordinateSpace d, ℂ)) :
    ((scalarDifferentialSymbol k v b hb hk).toSymbol.quantizeSobolev ha s u).toDistr =
      PointwiseConvergenceCLM.precomp ℂ (scalarDifferentialTransposeTestCLM k v b) u.toDistr :=
  quantizeSobolev_eq_transpose_of_schwartz _ ha _
    (integral_scalarDifferentialSymbol_transpose k v b hb hk) s u

end ConformalPoisson

end ProofPart_GreenTrace_ScalarDifferentialTranspose

