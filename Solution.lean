        intro F hF hFc hFU
        obtain ⟨w, hw⟩ := exists_zeroDirichletSolution g q hq hNR F hF
        obtain ⟨hPi, hPe⟩ := G.forcing_normal_representation hq hNR ha hp ν F hF hFU w hw y
        obtain ⟨hLi, hLe⟩ := L.representation y ⟨F, hF⟩ w hw
        have hRead : (fun z => L.row y z * F z) =ᵐ[nativeVolume g] (fun z => N z * F z) :=
          hNae.symm.mono (fun z hz => congrArg (fun t => t * F z) hz)
        have hNi := hLi.congr hRead
