/- Proof support: BoundarySobolevExponents.lean, SHA256 965d71ced32a0ca6500f6350b3e9cb8281951867de61c6118c4c878339d756fc -/
noncomputable section ProofPart_BoundarySobolevExponents



/- Improving all local Sobolev orders through the face, and obtaining
continuous local representatives once the exponent exceeds dimension.
The neighborhoods may be shrunk at each gain; the target cap is fixed
before any of its Sobolev witnesses is chosen. -/
open Module Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
section Definition
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

def HasLocalBoundarySobolev (μ : Measure E) [μ.IsAddHaarMeasure]
    (Ω U : Opens E) (p : ℝ≥0∞) [Fact (1 ≤ p)] (f : E → ℝ) : Prop :=
  ∀ D : Opens E, IsCompact (closure (D : Set E)) → closure (D : Set E) ⊆ U →
    ∀ k : ℕ, ∃ w : Wkp μ (Ω ⊓ D) p (k + 2),
      Wkp.value (k + 2) w =ᵐ[μ.restrict (Ω ⊓ D : Opens E)] f
end Definition

section Restriction
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω U W : Opens E}
  {p : ℝ≥0∞} [Fact (1 ≤ p)] {f : E → ℝ}

without_proof_info in
theorem HasLocalBoundarySobolev.restrict (hAll : HasLocalBoundarySobolev μ Ω U p f)
    (hWU : W ≤ U) : HasLocalBoundarySobolev μ (Ω ⊓ W) W p f := by
  intro D hD hDW k
  obtain ⟨Z, hZ⟩ := hAll D hD (hDW.trans (SetLike.coe_subset_coe.mpr hWU)) k
  have hsub : (Ω ⊓ W) ⊓ D ≤ Ω ⊓ D := fun x hx => ⟨hx.1.1, hx.2⟩
  refine ⟨Wkp.restrictL hsub (k + 2) Z, ?_⟩
  filter_upwards [Wkp.value_restrictL_ae hsub (k + 2) Z,
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hsub) hZ] with x h₁ h₂
  rw [h₁, h₂]
end Restriction

variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {Ω U : Opens (EuclideanSpace ℝ (Fin (n + 1)))} {f : EuclideanSpace ℝ (Fin (n + 1)) → ℝ}
  {p q : ℝ≥0} [Fact (1 ≤ (p : ℝ≥0∞))] [Fact (1 ≤ (q : ℝ≥0∞))]
local notation "X" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem HasLocalBoundarySobolev.of_exponent_gain
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hpq : p ≤ q) (hgap : (p : ℝ)⁻¹ - (q : ℝ)⁻¹ < (finrank ℝ X : ℝ)⁻¹)
    (hAll : HasLocalBoundarySobolev μ Ω U (p : ℝ≥0∞) f) :
    HasLocalBoundarySobolev μ Ω U (q : ℝ≥0∞) f := by
  intro D hD hDU k
  obtain ⟨Wset, hWopen, hDW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hD U.isOpen hDU
  let W : Opens X := ⟨Wset, hWopen⟩
  have hW_U : (W : Set X) ⊆ U := subset_closure.trans hWU
  have hD_W : (D : Set X) ⊆ W := subset_closure.trans hDW
  obtain ⟨Z, hZ⟩ := hAll W hWc hWU (k + 1)
  have hΩWH : Ω ⊓ W ≤ euclideanOpenHalfSpace n 0 := (inf_le_left : Ω ⊓ W ≤ Ω).trans hΩH
  have hHW : (euclideanOpenHalfSpace n 0 : Set X) ∩ W ⊆ (Ω ⊓ W : Opens X) := fun x hx =>
    ⟨hHU ⟨hx.1, hW_U hx.2⟩, hx.2⟩
  obtain ⟨v, hv⟩ := exists_wkp_of_local_halfSpace_sobolev_gain hΩWH hHW hD hDW hpq hgap (k + 2) Z
  have hsub : Ω ⊓ D ≤ (Ω ⊓ W) ⊓ D := fun x hx => ⟨⟨hx.1, hD_W hx.2⟩, hx.2⟩
  refine ⟨Wkp.restrictL hsub (k + 2) v, ?_⟩
  filter_upwards [Wkp.value_restrictL_ae hsub (k + 2) v,
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hsub) hv,
    ae_restrict_of_ae_restrict_of_subset
      (SetLike.coe_subset_coe.mpr (hsub.trans inf_le_left)) hZ] with x h₁ h₂ h₃
  rw [h₁, h₂, h₃]

without_proof_info in
theorem exists_local_continuous_boundary_representative
    {D : Opens X} (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U)
    (hq : (finrank ℝ X : ℝ≥0) < q) (u : W1p μ Ω (q : ℝ≥0∞)) :
    ∃ g : X → ℝ, Continuous g ∧ g =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] W1p.value u := by
  obtain ⟨Z, hZ⟩ := exists_local_wholeSpace_extension_euclidean_halfSpace hΩH hHU hD hDU u
  let g : HolderSpace (1 - finrank ℝ X / q) X ℝ := W1p.morreyEmbedding (mu := volume) hq Z
  have hg : Continuous (g : X → ℝ) := g.continuous
  have hrep : W1p.value Z =ᵐ[(volume : Measure X)] (g : X → ℝ) :=
    W1p.value_ae_eq_morreyEmbedding (mu := volume) hq Z
  have hac : μ ≪ (volume : Measure X) := by
    simpa only [Opens.coe_top, Measure.restrict_univ] using
      haar_restrict_absolutelyContinuous (μ := volume) (ν := μ) (⊤ : Opens X)
  have hrepD : W1p.value Z =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] (g : X → ℝ) :=
    ae_restrict_of_ae (hac.ae_eq hrep)
  exact ⟨g, hg, hrepD.symm.trans hZ⟩
end ConformalPoisson

end ProofPart_BoundarySobolevExponents

/- Proof support: BoundaryExponentLadder.lean, SHA256 12a8a748319fec1e8a48566578ac3f21316dbec64b0feffda0ee3c18199c566d -/
noncomputable section ProofPart_BoundaryExponentLadder


/- An explicit finite boundary Sobolev exponent ladder in every
dimension. Small additive steps keep the reciprocal gain strictly
subcritical, including at source exponents equal to dimension. -/
open Module Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

def boundarySobolevExponent (n j : ℕ) : ℝ≥0 := 2 + j / (n + 2 : ℕ)

without_proof_info in
theorem boundarySobolevExponent_one_le (n j : ℕ) : 1 ≤ boundarySobolevExponent n j := by
  exact le_trans (by norm_num : (1 : ℝ≥0) ≤ 2) (le_add_of_nonneg_right (by positivity))

instance boundarySobolevExponent_fact (n j : ℕ) : Fact (1 ≤ (boundarySobolevExponent n j : ℝ≥0∞)) :=
  ⟨by exact_mod_cast boundarySobolevExponent_one_le n j⟩

without_proof_info in
theorem boundarySobolevExponent_step (n j : ℕ) :
    boundarySobolevExponent n (j + 1) = boundarySobolevExponent n j + 1 / (n + 2 : ℕ) := by
  simp only [boundarySobolevExponent, Nat.cast_add, Nat.cast_one, add_div]
  ring

without_proof_info in
theorem boundarySobolevExponent_mono (n j : ℕ) :
    boundarySobolevExponent n j ≤ boundarySobolevExponent n (j + 1) := by
  rw [boundarySobolevExponent_step]
  exact le_add_of_nonneg_right (by positivity)

without_proof_info in
private theorem inv_sub_inv_le_sub_of_one_le {p q : ℝ} (hp : 1 ≤ p) (hpq : p ≤ q) :
    p⁻¹ - q⁻¹ ≤ q - p := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hq0 : 0 < q := hp0.trans_le hpq
  have heq : p⁻¹ - q⁻¹ = (q - p) / (p * q) := by
    field_simp
  rw [heq]
  exact div_le_self (sub_nonneg.mpr hpq) (one_le_mul_of_one_le_of_one_le hp (hp.trans hpq))

without_proof_info in
theorem boundarySobolevExponent_gap (n j : ℕ) :
    (boundarySobolevExponent n j : ℝ)⁻¹ - (boundarySobolevExponent n (j + 1) : ℝ)⁻¹ <
      (finrank ℝ (EuclideanSpace ℝ (Fin (n + 1))) : ℝ)⁻¹ := by
  have hp : (1 : ℝ) ≤ boundarySobolevExponent n j := by
    exact_mod_cast boundarySobolevExponent_one_le n j
  have hpq : (boundarySobolevExponent n j : ℝ) ≤ boundarySobolevExponent n (j + 1) := by
    exact_mod_cast boundarySobolevExponent_mono n j
  have hs : (boundarySobolevExponent n (j + 1) : ℝ) - boundarySobolevExponent n j =
      1 / (n + 2 : ℕ) := by
    have h := congrArg (fun x : ℝ≥0 => (x : ℝ)) (boundarySobolevExponent_step n j)
    push_cast at h
    push_cast
    linarith
  refine (inv_sub_inv_le_sub_of_one_le hp hpq).trans_lt ?_
  rw [hs]
  simp only [finrank_euclideanSpace, Fintype.card_fin]
  simpa only [one_div, Nat.cast_add, Nat.cast_one, Nat.cast_ofNat] using
    (one_div_lt_one_div_of_lt (by positivity : (0 : ℝ) < n + 1)
      (by linarith : (n : ℝ) + 1 < n + 2))

without_proof_info in
theorem boundarySobolevExponent_supercritical (n : ℕ) :
    (finrank ℝ (EuclideanSpace ℝ (Fin (n + 1))) : ℝ≥0) <
      boundarySobolevExponent n ((n + 1) * (n + 2)) := by
  have hden : ((n + 2 : ℕ) : ℝ≥0) ≠ 0 := by positivity
  simp only [boundarySobolevExponent, Nat.cast_mul, mul_div_cancel_right₀ _ hden,
    finrank_euclideanSpace, Fintype.card_fin]
  exact lt_add_of_pos_left _ (by norm_num)

variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {Ω U : Opens (EuclideanSpace ℝ (Fin (n + 1)))} {f : EuclideanSpace ℝ (Fin (n + 1)) → ℝ}
local notation "X" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem HasLocalBoundarySobolev.exponent_ladder
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hAll : HasLocalBoundarySobolev μ Ω U 2 f) :
    ∀ j : ℕ, HasLocalBoundarySobolev μ Ω U (boundarySobolevExponent n j : ℝ≥0∞) f := by
  intro j
  induction j with
  | zero => simpa [boundarySobolevExponent] using hAll
  | succ j ih =>
    exact HasLocalBoundarySobolev.of_exponent_gain hΩH hHU (boundarySobolevExponent_mono n j)
      (boundarySobolevExponent_gap n j) ih
end ConformalPoisson

end ProofPart_BoundaryExponentLadder

/- Proof support: BoundaryContinuousRepresentative.lean, SHA256 f6529dc7add198c4a682b316723e655886f8b8dcd40678486f1b3da23e5a67c9 -/
noncomputable section ProofPart_BoundaryContinuousRepresentative


/- Local continuous representatives through the face from all local
Hk estimates. The same mechanism applies to each weak directional
derivative of the original H1 reading. -/
open Module Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {Ω U : Opens (EuclideanSpace ℝ (Fin (n + 1)))} {f : EuclideanSpace ℝ (Fin (n + 1)) → ℝ}
local notation "X" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem HasLocalBoundarySobolev.exists_continuous_representative
    (hΩH : Ω ≤ euclideanOpenHalfSpace n 0)
    (hHU : (euclideanOpenHalfSpace n 0 : Set X) ∩ U ⊆ Ω)
    (hAll : HasLocalBoundarySobolev μ Ω U 2 f)
    {D : Opens X} (hD : IsCompact (closure (D : Set X))) (hDU : closure (D : Set X) ⊆ U) :
    ∃ g : X → ℝ, Continuous g ∧ g =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] f := by
  let N := (n + 1) * (n + 2)
  let q := boundarySobolevExponent n N
  have hAllq := hAll.exponent_ladder hΩH hHU N
  obtain ⟨Wset, hWopen, hDW, hWU, hWc⟩ := exists_open_between_and_isCompact_closure hD U.isOpen hDU
  let W : Opens X := ⟨Wset, hWopen⟩
  have hW_U : (W : Set X) ⊆ U := subset_closure.trans hWU
  have hD_W : (D : Set X) ⊆ W := subset_closure.trans hDW
  obtain ⟨Z, hZ⟩ := hAllq W hWc hWU 0
  have hΩWH : Ω ⊓ W ≤ euclideanOpenHalfSpace n 0 := (inf_le_left : Ω ⊓ W ≤ Ω).trans hΩH
  have hHW : (euclideanOpenHalfSpace n 0 : Set X) ∩ W ⊆ (Ω ⊓ W : Opens X) := fun x hx =>
    ⟨hHU ⟨hx.1, hW_U hx.2⟩, hx.2⟩
  obtain ⟨g, hg, hgrepr⟩ := exists_local_continuous_boundary_representative hΩWH hHW hD hDW
    (boundarySobolevExponent_supercritical n) (Wkp.firstOrder 1 Z)
  have hsub : Ω ⊓ D ≤ (Ω ⊓ W) ⊓ D := fun x hx => ⟨⟨hx.1, hD_W hx.2⟩, hx.2⟩
  refine ⟨g, hg, ?_⟩
  filter_upwards [ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr hsub) hgrepr,
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr (hsub.trans inf_le_left)) hZ]
      with x h₁ h₂
  rw [h₁, Wkp.value_firstOrder, h₂]

without_proof_info in
theorem HasLocalBoundarySobolev.directional
    (hAll : HasLocalBoundarySobolev μ Ω U 2 f)
    (u : W1p μ Ω 2) (huf : W1p.value u =ᵐ[μ.restrict Ω] f) (v : X) :
    HasLocalBoundarySobolev μ Ω U 2 (fun x => ⟪W1p.gradient u x, v⟫_ℝ) := by
  intro D hD hDU k
  obtain ⟨Z, hZ⟩ := hAll D hD hDU (k + 1)
  obtain ⟨d, hd⟩ := Wkp.exists_hasWeakLineDerivOn_value (k + 2) Z v
  have hufD : W1p.value u =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] f :=
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr (inf_le_left : Ω ⊓ D ≤ Ω)) huf
  have hsource : Wkp.value (k + 3) Z =ᵐ[μ.restrict (Ω ⊓ D : Opens X)] W1p.value u :=
    hZ.trans hufD.symm
  refine ⟨d, (hd.congr_ae hsource).ae_eq ?_⟩
  exact ((W1p.hasWeakFDerivOn u).hasWeakLineDerivOn v).mono (inf_le_left : Ω ⊓ D ≤ Ω)
end ConformalPoisson

end ProofPart_BoundaryContinuousRepresentative

/- Proof support: NativeBoundaryContinuous.lean, SHA256 5971910123c983d902adb6cebced3d9b309226db84904bed4eb0f53941057ebc -/
noncomputable section ProofPart_NativeBoundaryContinuous




/- Continuous representatives through the physical face for the actual
native weak value and its weak directional first derivatives. -/
open Bundle Set Metric MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.BoundaryChartLocalization
