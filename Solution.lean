/- Proof support: CompactNormDomination.lean, SHA256 9cf2e7d708b16b5300d2e55ad833d8fbfb568fa07dfa82de4ff211734d47d163 -/
noncomputable section ProofPart_CompactNormDomination






/- Norm domination transfers compactness without an explicit global
reconstruction map. Intended caller: finite-chart native Rellich assembly. -/
open Set Topology
namespace ConformalPoisson
variable {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]

without_proof_info in
/-- If the norm of a linear map is dominated by the image norm of a
compact map, it is compact. The factor is constructed on the closure of
the compact map's range by the canonical bounded extension. -/
theorem isCompactOperator_of_norm_domination (A : E →L[ℝ] F) (B : E →L[ℝ] G)
    (hA : IsCompactOperator A) {C : ℝ} (hbound : ∀ x, ‖B x‖ ≤ C * ‖A x‖) :
    IsCompactOperator B := by
  let V : Submodule ℝ F := A.range.topologicalClosure
  have hmem : ∀ x, A x ∈ V := fun x =>
    A.range.le_topologicalClosure (LinearMap.mem_range_self A.toLinearMap x)
  let e : E →L[ℝ] V := A.codRestrict V hmem
  have hdense : DenseRange e := by
    rw [DenseRange, Subtype.dense_iff, ← Set.range_comp]
    have hr : Set.range (fun x => (e x).val) = (A.range : Set F) := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨x, rfl⟩
      · rintro ⟨x, rfl⟩
        exact ⟨x, rfl⟩
    change (V : Set F) ⊆ closure (Set.range (fun x => (e x).val))
    rw [hr]
    exact subset_rfl
  let T : V →L[ℝ] G := B.toLinearMap.extendOfNorm e.toLinearMap
  have hfactor : T.comp e = B := by
    ext x
    exact LinearMap.extendOfNorm_eq (f := B.toLinearMap) (e := e.toLinearMap)
      hdense ⟨C, hbound⟩ x
  have he : IsCompactOperator e := hA.codRestrict hmem A.range.isClosed_topologicalClosure
  rw [← hfactor]
  exact he.clm_comp T

end ConformalPoisson

end ProofPart_CompactNormDomination

/- Proof support: NativeFiniteCharts.lean, SHA256 4475789d67d8158552147f459d4064c04009293a30b2046b46424e763c6d6b2c -/
noncomputable section ProofPart_NativeFiniteCharts



/- A finite family of the actual boundary-chart readings controls the
native value norm. This is the geometric assembly step for native Rellich. -/
open Bundle Set Metric Filter MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ E H} {M : Type*} [TopologicalSpace M]
  [ChartedSpace H M] [CompactSpace M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]

/-- Finitely many actual chart localizations whose native inner
neighborhoods cover the entire manifold, including its boundary. -/
structure FiniteBoundaryChartCover where
  centers : Finset M
  data : ∀ c : centers, BoundaryChartLocalization (I := I) c.val
  covers : ∀ x : M, ∃ c : centers, x ∈ (data c).innerNeighborhood

without_proof_info in
theorem nonempty_finiteBoundaryChartCover : Nonempty (FiniteBoundaryChartCover (I := I) (M := M)) := by
  classical
  let L : ∀ c : M, BoundaryChartLocalization (I := I) c := fun c =>
    Classical.choice (nonempty_boundaryChartLocalization (I := I) c)
  obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover
    (fun c : M => ((L c).innerNeighborhood : Set M)) (fun c => (L c).innerNeighborhood.isOpen)
    (fun x _ => mem_iUnion.mpr ⟨x, (L x).mem_innerNeighborhood⟩)
  refine ⟨{ centers := s, data := fun c => L c.val, covers := ?_ }⟩
  intro x
  obtain ⟨c, hc, hx⟩ := mem_iUnion₂.mp (hs (mem_univ x))
  exact ⟨⟨c, hc⟩, hx⟩

variable [MeasurableSpace M] [BorelSpace M]
variable [MeasurableSpace E] [BorelSpace E]
open DirichletSobolev

without_proof_info in
/-- The native H1 value of an included smooth zero-boundary function
agrees with its original values almost everywhere. -/
theorem zeroTrace_valueL_smooth_ae
    (u : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    valueL (I := I) {x : M | I.IsBoundaryPoint x}
      (smoothInclusion (E := E) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u)
      =ᵐ[riemannianVolume I M] u.val :=
  SobolevH1.toLp_ofSmooth_ae_eq u.val

namespace FiniteBoundaryChartCover
variable (K : FiniteBoundaryChartCover (I := I) (M := M))

/-- The finite product of the actual compact Euclidean L2 readings. -/
def readingsL : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x} →L[ℝ]
    (∀ c : K.centers, Lp ℝ 2 ((Module.finBasis ℝ E).addHaar.restrict
      (boundaryChartCap (I := I) c.val (K.data c).radius : Set E))) :=
  ContinuousLinearMap.pi (fun c => (K.data c).valueReadingL)

without_proof_info in
theorem isCompactOperator_readingsL : IsCompactOperator K.readingsL :=
  IsCompactOperator.pi (fun c => (K.data c).isCompactOperator_value_readingL)

without_proof_info in
/-- The native squared L2 norm is bounded by the finite sum of the
coordinate squared L2 norms, each weighted by its chart density bound. -/
theorem enorm_valueL_smooth_sq_le
    (u : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    ‖valueL (I := I) {x : M | I.IsBoundaryPoint x}
      (smoothInclusion (E := E) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u)‖ₑ ^ 2 ≤
      (∑ c : K.centers, ENNReal.ofReal (K.data c).densityUpper) *
        ‖K.readingsL (smoothInclusion (E := E) (I := I) (M := M)
          {x : M | I.IsBoundaryPoint x} u)‖ₑ ^ 2 := by
  classical
  let U := smoothInclusion (E := E) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u
  let B := valueL (I := I) {x : M | I.IsBoundaryPoint x} U
  let f : M → ℝ≥0∞ := fun x => ‖u.val x‖ₑ ^ 2
  have hB : ‖B‖ₑ ^ 2 = ∫⁻ x, f x ∂riemannianVolume I M := by
    have h := lintegral_enorm_pow_eq_eLpNorm_pow (n := 2) (by norm_num) (Lp.memLp B).aestronglyMeasurable
    norm_num only [Nat.cast_ofNat] at h
    rw [← Lp.eNorm_def B] at h
    exact h.symm.trans (lintegral_congr_ae ((zeroTrace_valueL_smooth_ae u).fun_comp (fun t : ℝ => ‖t‖ₑ ^ 2)))
  rw [hB]
  have hpt (x : M) : f x ≤ ∑ c : K.centers, ((K.data c).innerNeighborhood : Set M).indicator f x := by
    obtain ⟨c, hc⟩ := K.covers x
    calc
      f x = ((K.data c).innerNeighborhood : Set M).indicator f x := (Set.indicator_of_mem hc f).symm
      _ ≤ _ := Finset.single_le_sum (f := fun d : K.centers => ((K.data d).innerNeighborhood : Set M).indicator f x) (fun _ _ => bot_le) (Finset.mem_univ c)
  calc
    _ ≤ ∫⁻ x, ∑ c : K.centers, ((K.data c).innerNeighborhood : Set M).indicator f x
        ∂riemannianVolume I M := lintegral_mono hpt
    _ = ∑ c : K.centers, ∫⁻ x in ((K.data c).innerNeighborhood : Set M), f x
        ∂riemannianVolume I M := by
      rw [lintegral_finsetSum]
      · apply Finset.sum_congr rfl
        intro c hc
        exact lintegral_indicator (K.data c).innerNeighborhood.isOpen.measurableSet f
      · intro c hc
        exact ((u.val.contMDiff.continuous.measurable.eNorm).pow_const 2).indicator
          (K.data c).innerNeighborhood.isOpen.measurableSet
    _ ≤ ∑ c : K.centers, ENNReal.ofReal (K.data c).densityUpper *
        ‖(K.data c).valueReadingL U‖ₑ ^ 2 := by
      apply Finset.sum_le_sum
      intro c hc
      exact (K.data c).setLIntegral_innerNeighborhood_enorm_sq_le u
    _ ≤ ∑ c : K.centers, ENNReal.ofReal (K.data c).densityUpper * ‖K.readingsL U‖ₑ ^ 2 := by
      apply Finset.sum_le_sum
      intro c hc
      gcongr
      rw [← ofReal_norm, ← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (norm_le_pi_norm (K.readingsL U) c)
    _ = _ := by rw [Finset.sum_mul]

end FiniteBoundaryChartCover
end ConformalPoisson

end ProofPart_NativeFiniteCharts

