      (smoothInclusion (E := V) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u)
      (smoothInclusion (E := V) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} v) =
    energyFormH1 (mu := (Module.finBasis ℝ V).addHaar) (Omega := L.innerCap)
      (chartWeightedPrincipal (I := I) c) 0 (chartWeightedPotential (I := I) c q)
      (L.innerReadingL (smoothInclusion (E := V) (I := I) (M := M) {x : M | I.IsBoundaryPoint x} u))
