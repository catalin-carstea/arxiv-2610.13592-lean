    (hw0 : Wkp.firstOrder 1 w ∈ w1p0Submodule μ Ω p) :
    Wkp.firstOrder 1 (Wkp.restrictL (inf_le_left : Ω ⊓ V ≤ Ω) 2 w) ∈
