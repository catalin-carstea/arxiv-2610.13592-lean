without_proof_info in
theorem coordinateSchrodinger_odd_reflection_negative
    (A : V → V →L[ℝ] V) (b : V → V) (q u : V → ℝ)
    {x : V} (hx : x 0 < 0)
    (hu : ContDiffAt ℝ 2 u (boundaryReflection n x)) :
    coordinateSchrodinger
      (affinePrincipalCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 A)
      (affineDriftCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 b)
      (affinePotentialCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 q)
