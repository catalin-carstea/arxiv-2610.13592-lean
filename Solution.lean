without_proof_info in
theorem NativeMetricAmbientExtension.contMDiffAt_boundary_of_normal_chart
    (hcompat : ∀ z ∈ R.domain, 0 ≤ z 0 → z ∈ (extChartAt (𝓡∂ (n + 1)) (α : M)).target)
    (q u : M → ℝ) (f : (𝓡∂ (n + 1)).boundary M → ℝ)
    (hq : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω q (α : M))
    (hu : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u) (hf : ContMDiffAt (𝓡 n) 𝓘(ℝ) ω f α)
    (htrace : ∀ y : (𝓡∂ (n + 1)).boundary M, u y = f y)
    (hLu : ∀ y ∈ (𝓡∂ (n + 1)).interior M, schrodinger g q u y = 0) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω u (α : M) := by
  let z0 := extChartAt (𝓡∂ (n + 1)) (α : M) α
  let p : R.normalCoordinateDomain A := ⟨z0, R.normalCoordinateBase_mem A⟩
  let a := chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p
  let b := chartDriftCoefficient (I := 𝓘(ℝ, V)) p
  let v := R.normalCoordinateFunction A u
  obtain ⟨qbar, hqbar, hqread⟩ := R.exists_normalCoordinate_potential_extension A q hq
  obtain ⟨fbar, hfbar, hfread⟩ := R.exists_normalCoordinate_trace_extension A hcompat f u hf htrace
  let W : TopologicalSpace.Opens V :=
    (R.normalCoordinateDomain A) ⊓ ⟨{x | AnalyticAt ℝ qbar x}, isOpen_analyticAt ℝ qbar⟩
  have hzW : z0 ∈ W := ⟨R.normalCoordinateBase_mem A, hqbar⟩
  have hWD : (W : Set V) ⊆ R.normalCoordinateDomain A := inter_subset_left
  have hvs := R.normalCoordinateFunction_smooth A hcompat u hu
  have hv : ContDiffOn ℝ ∞ v ((W : Set V) ∩ {x : V | 0 ≤ x 0}) :=
    hvs.mono (fun x hx => ⟨hWD hx.1, hx.2⟩)
  obtain ⟨T, hT⟩ := R.exists_normalCoordinatePrincipal_normalizer A p p
  have ha : AnalyticOnNhd ℝ a W := (R.normalCoordinatePrincipal_analytic A p).mono hWD
  have hb : AnalyticOnNhd ℝ b W := (R.normalCoordinateDrift_analytic A p).mono hWD
  have hnormal (x : V) (hx : x ∈ W) : a x (EuclideanSpace.single 0 1) = EuclideanSpace.single 0 1 ∧
      ∀ w : V, a x w 0 = w 0 := R.normalCoordinatePrincipal_normal A p ⟨x, hWD hx⟩
  have hLv (x : V) (hx : x ∈ W) (hx0 : 0 < x 0) : coordinateSchrodinger a b qbar v x = 0 := by
    let z : R.normalCoordinateDomain A := ⟨x, hWD hx⟩
    let Qnormal : R.normalCoordinateDomain A → ℝ := fun y => qbar y
    have hci := R.normalCoordinate_physical_interior A hcompat (hWD hx) hx0
    have hux : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u
        ((extChartAt (𝓡∂ (n + 1)) (α : M)).symm (A.chart x)) := hu.contMDiffAt.of_le (by decide)
    have hop := R.normalCoordinateSchrodinger_eq_original A p z hci Qnormal q u
      (hqread x (hWD hx) hx0.le) hux
    have heq : coordinateSchrodinger a b qbar v x =
        coordinateSchrodinger a b (chartPotentialCoefficient (I := 𝓘(ℝ, V)) p Qnormal) v x :=
      coordinateSchrodinger_congr_coefficients_at v x rfl rfl
        (ambient_chartPotential_restriction (R.normalCoordinateDomain A) p z qbar).symm
    rw [heq, hop]
    exact hLu _ (inverseChart_interior_of_mem_interior_target (α : M) hci)
