/- An analytic germ of the ORIGINAL intrinsic boundary datum gives an
actual ambient trace extension in the SAME normal chart. -/
open Bundle Set TauCeti
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Y" => EuclideanSpace ℝ (Fin n)
variable {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)} {α : (𝓡∂ (n + 1)).boundary M}
  (R : NativeMetricAmbientExtension g (α : M))
local instance : RiemannianBundle (fun x : R.domain => TangentSpace 𝓘(ℝ, V) x) :=
  ⟨R.metric.toRiemannianMetric⟩
local instance : IsContMDiffRiemannianBundle 𝓘(ℝ, V) 1 V
    (fun x : R.domain => TangentSpace 𝓘(ℝ, V) x) :=
  IsContMDiffRiemannianBundle.of_le (n := ω) (by decide)
variable {D : BoundaryNormalMapData R.domain R.boundaryBase}
  {Q : BoundaryNormalRectangle R.domain D} (A : NormalModelChartData R.domain D Q)

set_option maxHeartbeats 1600000 in
without_proof_info in
theorem NativeMetricAmbientExtension.exists_normalCoordinate_trace_extension
    (hcompat : ∀ z ∈ R.domain, 0 ≤ z 0 → z ∈ (extChartAt (𝓡∂ (n + 1)) (α : M)).target)
    (f : (𝓡∂ (n + 1)).boundary M → ℝ) (u : M → ℝ)
    (hf : ContMDiffAt (𝓡 n) 𝓘(ℝ) ω f α)
    (htrace : ∀ y : (𝓡∂ (n + 1)).boundary M, u y = f y) :
    ∃ fbar : V → ℝ, AnalyticAt ℝ fbar (extChartAt (𝓡∂ (n + 1)) (α : M) α) ∧
      ∀ x ∈ R.normalCoordinateDomain A, x 0 = 0 → R.normalCoordinateFunction A u x = fbar x := by
  letI := TauCeti.isManifold_boundary (n := n) (k := ω) M (by decide)
  obtain ⟨F, hF, hFeq, _⟩ := exists_native_analytic_chart_extension hf
  let P := euclideanHalfSpaceBoundaryProj n
  let z0 := extChartAt (𝓡∂ (n + 1)) (α : M) α
  have hPbase : P z0 = extChartAt (𝓡 n) α α := by
    have h := congrArg P (boundaryParam_extChartAt (mem_extChartAt_source (I := 𝓡 n) α))
    simpa only [P, euclideanHalfSpaceBoundaryProj_param] using h.symm
  have hFP : AnalyticAt ℝ F (P z0) := hPbase.symm ▸ hF
  refine ⟨F ∘ P, hFP.comp (P.analyticAt z0), ?_⟩
  let χ := R.normalChart A
  have hsrc {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ χ.source) : z.val ∈ A.chart.source := by
    rwa [R.normalChart_source A hcompat] at hz
  let L : NormalChartLabels χ α :=
    ⟨(fun z hz => R.normalChart_image_in_original_source A hcompat (hsrc hz)),
      (fun z hz hzero => R.normalChart_boundary_value A (hsrc hz) hzero),
      (fun z hz hzero => R.normalChart_boundary_coordinate A hcompat (hsrc hz) hzero)⟩
  intro x hx hx0
  let z : EuclideanHalfSpace (n + 1) := ⟨x, hx0.ge⟩
  have hz : z ∈ χ.source := by
    rw [R.normalChart_source A hcompat]
    exact hx
  let y : (𝓡∂ (n + 1)).boundary M := ⟨χ z, partialDiffeomorph_halfSpace_boundary χ hz hx0⟩
  have hy : y ∈ (extChartAt (𝓡 n) α).source := L.boundary_source hz hx0
  have hcoord : extChartAt (𝓡 n) α y = P x := by
    simpa only [P, euclideanHalfSpaceBoundaryNormalEquiv_symm_apply_fst] using L.boundary_read hz hx0
  have hround : (extChartAt (𝓡 n) α).symm (P x) = y := by
    rw [← hcoord]
    exact (extChartAt (𝓡 n) α).left_inv hy
  have hval := hFeq (x := P x) (by simp)
  change R.normalCoordinateFunction A u x = F (P x)
  have hux : R.normalCoordinateFunction A u x = u (y : M) := by
    change R.normalCoordinateFunction A u x = u (R.normalChart A z)
    rw [R.normalChart_apply A z]
    rfl
  rw [hux, htrace y]
  simpa only [Function.comp_apply, hround] using hval

end ConformalPoisson

