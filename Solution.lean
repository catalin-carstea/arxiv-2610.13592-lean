/- Symmetry of the two normal derivatives of the SAME Green kernel at
separated boundary points. This is only the off-diagonal identity needed by
the remote boundary-data formula. -/
open Bundle Set Filter MeasureTheory TauCeti
open scoped Manifold ContDiff Topology ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem NativeClassicalValueKernel.mixed_normal_symmetric
    {g : Metric (n := n) (M := M)} {q : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    {a : ℝ≥0} (ha : 1 < a) [Fact (1 ≤ (a : ℝ≥0∞))]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] [(a : ℝ≥0∞).HolderConjugate p] (hp : p ≠ ⊤)
    {K : NativeInverseLpRowFamily g q (a : ℝ≥0∞)} (G : NativeClassicalValueKernel K)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (y z : (𝓡∂ (n + 1)).boundary M) (hyz : (y : M) ≠ (z : M)) :
    normalDerivative ν (boundaryPoissonSection ν G.kernel z) y =
      normalDerivative ν (boundaryPoissonSection ν G.kernel y) z := by
  have hSym (r : M) : (fun s => G.kernel s r) = G.kernel r := by
    funext s
    by_cases hsr : s = r
    · subst s; rfl
    · exact G.symmetric (p := p) hq hNR hp s r hsr
  have hComm := native_mixed_derivatives_commute
    (G.contMDiffAt_offDiagonal hq hNR ha hp (y : M) (z : M) hyz) (ν y) (ν z)
  have hFun : (fun r : M => mvfderiv Ihalf (fun s => G.kernel s r) (y : M) (ν y)) =
      (fun r : M => mvfderiv Ihalf (G.kernel r) (y : M) (ν y)) := by
    funext r
    rw [hSym r]
  rw [hFun] at hComm
  have hP (r : (Ihalf).boundary M) : boundaryPoissonSection ν G.kernel r =
      -(fun x : M => mvfderiv Ihalf (G.kernel x) (r : M) (ν r)) := rfl
  change mvfderiv Ihalf (boundaryPoissonSection ν G.kernel z) (y : M) (ν y) =
    mvfderiv Ihalf (boundaryPoissonSection ν G.kernel y) (z : M) (ν z)
  rw [hP z, hP y, mvfderiv_neg, mvfderiv_neg]
  exact congrArg Neg.neg hComm
end ConformalPoisson

