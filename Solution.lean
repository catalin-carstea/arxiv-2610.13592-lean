    _ ≤ ∑ i, L i * (B / (8 * H * B)) :=
      Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_left
        (normal_majorant_coefficient_ratio_le hB hC (hell i) (hkell i)) (hL i))
    _ = (∑ i, L i) * (B / (8 * H * B)) := (Finset.sum_mul ..).symm
