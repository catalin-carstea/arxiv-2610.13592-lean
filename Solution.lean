without_proof_info in
theorem memLp_ball_holder_forcing (hα : 0 < α) (f : HolderSpace α (closedBall (0 : V) 1) ℝ) :
    MemLp (domainRead (closedBall 0 1) f) 2 (volume.restrict (ball (0 : V) 1)) := by
