noncomputable section ProofPart_NativeForcingApproximation




/- The actual smooth compact-interior forcing approximation needed by the Green caller. -/

open Set Filter MeasureTheory
open scoped Manifold ContDiff Topology ENNReal

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]

without_proof_info in
/-- Approximation is a project proof using cutoffs, boundary nullity and dominated convergence.
Both extended-norm convergence and finiteness are explicit before the real norm is used. -/
theorem exists_native_interior_forcing_approximation
    (g : Metric (n := n) (M := M)) (p : ℝ≥0∞) (hp0 : p ≠ 0) (hptop : p ≠ (⊤ : ℝ≥0∞))
    (F : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F) :
    ∃ Fm : ℕ → M → ℝ,
      (∀ m, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (Fm m)) ∧
      (∀ m, HasCompactSupport (Fm m)) ∧
      (∀ m, tsupport (Fm m) ⊆ (𝓡∂ (n + 1)).interior M) ∧
      (∀ m, MemLp (Fm m - F) p (nativeVolume g)) ∧
      Tendsto (fun m => eLpNorm (Fm m - F) p (nativeVolume g)) atTop (𝓝 0) ∧
      Tendsto (fun m => (eLpNorm (Fm m - F) p (nativeVolume g)).toReal) atTop (𝓝 0) := by
  obtain ⟨χ⟩ := nonempty_smoothInteriorCutoffs (n := n) (M := M)
  let Fm : ℕ → M → ℝ := fun m x => χ.cutoff m x * F x
  have hFm (m : ℕ) : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (Fm m) := (χ.smooth m).mul hF
  have ht := χ.tendsto_forcing_eLpNorm (nativeVolume g) (nativeVolume_ae_interior g)
    p hp0 hptop F hF (contMDiff_memLp_nativeVolume g F hF p)
  refine ⟨Fm, hFm, (fun m => (χ.compact_support m).mul_right),
    (fun m => (tsupport_mul_subset_left (f := χ.cutoff m) (g := F)).trans (χ.support_interior m)),
    (fun m => contMDiff_memLp_nativeVolume g (Fm m - F) ((hFm m).sub hF) p), ht, ?_⟩
  change Tendsto (fun m => (eLpNorm (fun x => χ.cutoff m x * F x - F x) p
    (nativeVolume g)).toReal) atTop (𝓝 0)
  exact (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp ht

end ConformalPoisson

end ProofPart_NativeForcingApproximation

