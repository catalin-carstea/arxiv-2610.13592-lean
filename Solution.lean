noncomputable section ProofPart_SobolevRelativeCutoff






/- Higher Sobolev cutoff extension across an artificial chart edge,
preserving only the first-order zero Dirichlet trace. No vanishing of
normal derivatives at the physical boundary is required. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω V : Opens E}

without_proof_info in
/-- A zero-trace cutoff product restricts to a smaller open set
containing its compact support, retaining its actual cutoff value. -/
theorem exists_zeroTrace_restrict_cutoff (u : W1p μ Ω 2)
    {D : Opens E} {ψ : E → ℝ} (hψc : HasCompactSupport ψ) (hψD : tsupport ψ ⊆ D)
    (hu0 : ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω]
      fun x => ψ x * W1p.value u x) :
    ∃ v : W1p0 μ (Ω ⊓ D) 2,
      W1p.value v.val =ᵐ[μ.restrict (Ω ⊓ D : Opens E)]
        fun x => ψ x * W1p.value (W1p.restrictL (inf_le_left : Ω ⊓ D ≤ Ω) u) x := by
  obtain ⟨v, hv⟩ := hu0
  have hv0 : ∀ᵐ x ∂μ.restrict Ω, x ∉ tsupport ψ → W1p.value v.val x = 0 := by
    filter_upwards [hv] with x hx hxψ
    rw [hx, image_eq_zero_of_notMem_tsupport hxψ, zero_mul]
  have hm := W1p.restrictL_mem_w1p0Submodule_of_isCompact hψc hψD v.property hv0
  refine ⟨⟨W1p.restrictL (inf_le_left : Ω ⊓ D ≤ Ω) v.val, hm⟩, ?_⟩
  filter_upwards [W1p.value_restrictL_ae (inf_le_left : Ω ⊓ D ≤ Ω) v.val,
    W1p.value_restrictL_ae (inf_le_left : Ω ⊓ D ≤ Ω) u,
    ae_restrict_of_ae_restrict_of_subset (SetLike.coe_subset_coe.mpr (inf_le_left : Ω ⊓ D ≤ Ω)) hv]
      with x hvx hux hx
  rw [hvx, hux, hx]

without_proof_info in
theorem exists_wkp_relative_cutoff (hΩV : Ω ≤ V) (k : ℕ)
    {ψ : E → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hs : (V : Set E) ∩ tsupport ψ ⊆ Ω) (u : Wkp μ Ω 2 (k + 1))
    (hu0 : ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω]
      fun x => ψ x * Wkp.value (k + 1) u x) :
    ∃ w : Wkp μ V 2 (k + 1),
      Wkp.value (k + 1) w =ᵐ[μ.restrict V]
        (Ω : Set E).indicator (fun x => ψ x * Wkp.value (k + 1) u x) ∧
      Wkp.firstOrder k w ∈ w1p0Submodule μ V 2 := by
  obtain ⟨w, hwψ⟩ := exists_wkp_relative_cutoff_extension (k + 1) hψ hψc hs u
  have hΩm := Ω.isOpen.measurableSet
  obtain ⟨v, hv⟩ := hu0
  let vext := W1p0.extendByZeroL hΩV v
  have hvext : W1p.value vext.val =ᵐ[μ.restrict V] (Ω : Set E).indicator (W1p.value v.val) := by
    rw [W1p0.value_extendByZeroL]
    exact coeFn_extendByZeroLpₗᵢ ℝ hΩm (SetLike.coe_subset_coe.mpr hΩV) (W1p.value v.val)
  have heq : Wkp.firstOrder k w = vext.val := by
    apply W1p.ext_value
    apply Lp.ext
    have hv' := (ae_restrict_iff' hΩm).1 hv
    filter_upwards [hwψ, hvext, ae_restrict_of_ae hv'] with x hwx hvx hvc
    rw [Wkp.value_firstOrder, hwx, hvx]
    by_cases hxΩ : x ∈ (Ω : Set E)
    · rw [indicator_of_mem hxΩ, indicator_of_mem hxΩ, hvc hxΩ]
    · rw [indicator_of_notMem hxΩ, indicator_of_notMem hxΩ]
  refine ⟨w, hwψ, ?_⟩
  rw [heq]
  exact vext.property
end ConformalPoisson

