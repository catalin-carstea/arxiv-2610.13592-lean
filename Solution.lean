noncomputable section ProofPart_DNSymbol_DNGaussianSplitReading




/- Assignment268, /root. The protected actual Gaussian scalar expression
is read in the literal tangent/normal product coordinates, including signed q. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti Finset
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ}
local notation "Y" => EuclideanSpace ℝ (Fin n)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" => EuclideanHalfSpace (n + 1)
local notation "e" => EuclideanSpace.basisFun (Fin (n + 1)) ℝ
local notation "b" => EuclideanSpace.basisFun (Fin n) ℝ

def realSplitOperator (A : Matrix (Fin n) (Fin n) ℝ) (τ : ℝ) (c : Fin n → ℝ)
    (W : Y × ℝ → ℝ) (y : Y) (t : ℝ) : ℝ :=
  -deriv (deriv (fun r : ℝ => W (y, r))) t -
    (∑ i, ∑ j, A i j * fderiv ℝ (fun z => fderiv ℝ (fun w => W (w, t)) z (b j)) y (b i)) +
    τ / 2 * deriv (fun r : ℝ => W (y, r)) t -
    ∑ i, c i * fderiv ℝ (fun z => W (z, t)) y (b i)

without_proof_info in
theorem normalCoordinateSchrodinger_eq_realSplit
    {S : TopologicalSpace.Opens H} (F : NormalMetricField S) (q : H → ℝ)
    {W : Y × ℝ → ℝ} (hW : ContDiff ℝ ∞ W) (z : H) :
    normalCoordinateSchrodinger F q (W ∘ (euclideanHalfSpaceBoundaryNormalEquiv n).symm) z =
      realSplitOperator (F.inverse z) (F.tau z) (fun a => metricTangentialDrift F a z) W
        (nativeNormalCoordinates z).1 (nativeNormalCoordinates z).2 +
      q z * W (nativeNormalCoordinates z) := by
  let Q := euclideanHalfSpaceBoundaryNormalEquiv n
  let y := (nativeNormalCoordinates z).1
  let t := (nativeNormalCoordinates z).2
  have hw : Q.symm z.val = (y, t) := rfl
  have hq0 : Q.symm (e 0) = ((0 : Y), (1 : ℝ)) := by
    rw [gaussian_basis_zero, Q.symm_apply_apply]
  have hqi (i : Fin n) : Q.symm (e i.succ) = (b i, (0 : ℝ)) := by
    apply Q.injective
    rw [Q.apply_symm_apply, euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam]
    simpa only [EuclideanSpace.basisFun_apply] using gaussian_basis_succ i
  have hf : ContDiff ℝ ∞ (W ∘ Q.symm) := hW.comp Q.symm.contDiff
  have hN : fderiv ℝ (W ∘ Q.symm) z.val (e 0) = deriv (fun r : ℝ => W (y, r)) t := by
    calc
      _ = fderiv ℝ W (Q.symm z.val) (Q.symm (e 0)) :=
        clm_pre_fderiv_direction Q.symm.toContinuousLinearMap (hW.differentiable (by decide) _) (e 0)
      _ = _ := by rw [hq0, hw]; exact product_normal_direction hW y t
  have hT (i : Fin n) : fderiv ℝ (W ∘ Q.symm) z.val (e i.succ) = fderiv ℝ (fun w => W (w, t)) y (b i) := by
    calc
      _ = fderiv ℝ W (Q.symm z.val) (Q.symm (e i.succ)) :=
        clm_pre_fderiv_direction Q.symm.toContinuousLinearMap (hW.differentiable (by decide) _) (e i.succ)
      _ = _ := by rw [hqi, hw]; exact product_tangent_direction hW y t (b i)
  have hNN : fderiv ℝ (fderiv ℝ (W ∘ Q.symm)) z.val (e 0) (e 0) =
      deriv (deriv (fun r : ℝ => W (y, r))) t := by
    calc
      _ = fderiv ℝ (fun w => fderiv ℝ (W ∘ Q.symm) w (e 0)) z.val (e 0) :=
        fderiv_fderiv_apply_eq_directional hf z.val (e 0) (e 0)
      _ = fderiv ℝ (fun w => fderiv ℝ W w (Q.symm (e 0))) (Q.symm z.val) (Q.symm (e 0)) :=
        clm_pre_fderiv_twice_direction Q.symm.toContinuousLinearMap hW z.val (e 0) (e 0)
      _ = _ := by rw [hq0, hw]; exact product_normal_twice_direction hW y t
  have hTT (i j : Fin n) : fderiv ℝ (fderiv ℝ (W ∘ Q.symm)) z.val (e i.succ) (e j.succ) =
      fderiv ℝ (fun w => fderiv ℝ (fun v => W (v, t)) w (b j)) y (b i) := by
    calc
      _ = fderiv ℝ (fun w => fderiv ℝ (W ∘ Q.symm) w (e j.succ)) z.val (e i.succ) :=
        fderiv_fderiv_apply_eq_directional hf z.val (e i.succ) (e j.succ)
      _ = fderiv ℝ (fun w => fderiv ℝ W w (Q.symm (e j.succ))) (Q.symm z.val) (Q.symm (e i.succ)) :=
        clm_pre_fderiv_twice_direction Q.symm.toContinuousLinearMap hW z.val (e i.succ) (e j.succ)
      _ = _ := by rw [hqi, hqi, hw]; exact product_tangent_twice_direction hW y t (b i) (b j)
  dsimp only [Q, y, t] at hN hT hNN hTT
  unfold normalCoordinateSchrodinger realSplitOperator metricTangentialDrift
  simp only [hN, hT, hNN, hTT]
  rfl

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNGaussianSplitReading

