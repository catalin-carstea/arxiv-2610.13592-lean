    refine ⟨h R, ?_⟩
    rintro v ⟨σ, hσ, rfl⟩
    exact halfBall_lpNorm_mono_radius (x₀ := x₀) G (by linarith [hσ.2])
  apply hbound h k y (y R) lpNorm_nonneg (fun _ => lpNorm_nonneg)
    (fun _ => lpNorm_nonneg) (fun _ => lpNorm_nonneg) hbdd
  · intro σ hσ
    exact halfBall_lpNorm_mono_radius (x₀ := x₀) V (by linarith [hσ.2])
  · intro σ hσ
    exact hH σ (by linarith [hσ.1]) (by linarith [hσ.2])
  · intro s t hs hst ht η hη
    simpa only [add_assoc] using hstep a Ω x₀ R hmatch u hzero s t
      (by linarith) hst (by linarith) η hη

end ConformalPoisson

