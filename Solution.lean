  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem exists_holderBounds_jets_of_contDiffAt_three_isCompact
    {C : Set E} (hC : IsCompact C) {u : E → F}
    (hu : ∀ x ∈ C, ContDiffAt ℝ 3 u x) {α : ℝ≥0} (hα : α ≤ 1) :
    ∃ K0 K1 K2 : ℝ≥0, holderBound α C u K0 ∧
      holderBound α C (fderiv ℝ u) K1 ∧
      holderBound α C (fderiv ℝ (fderiv ℝ u)) K2 := by
  obtain ⟨K0, hK0⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (fun x hx => (hu x hx).of_le (by norm_num)) hα
  obtain ⟨K1, hK1⟩ := exists_holderBound_of_contDiffAt_isCompact hC
