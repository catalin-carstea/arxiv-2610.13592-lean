/- Open-domain native gluing, adapted from the pinned Tau Ceti local
representative argument (Apache 2.0, External/LICENSE.tauceti). Unlike the
preserved global helper, this requires local data only on the stated domain. -/
open Set MeasureTheory TopologicalSpace Filter
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [SecondCountableTopology M]
  [MeasurableSpace M] [OpensMeasurableSpace M]
  {μ : Measure M} [μ.IsOpenPosMeasure] {u : M → ℝ} {U : Set M}

without_proof_info in
theorem exists_native_contMDiffOn_ae_eq_of_locally
    (h : ∀ x ∈ U, ∃ O : Opens M, x ∈ O ∧ (O : Set M) ⊆ U ∧
      ∃ f : M → ℝ, ContMDiffOn I 𝓘(ℝ) ∞ f O ∧ f =ᵐ[μ.restrict O] u) :
    ∃ g : M → ℝ, ContMDiffOn I 𝓘(ℝ) ∞ g U ∧ g =ᵐ[μ] u := by
  classical
  choose! O hxO hOU f hf hfu using h
  let g := U.piecewise (fun x => f x x) u
  have hgu : ∀ x ∉ U, g x = u x := fun x hx => piecewise_eq_of_notMem U _ _ hx
  have heq : ∀ c ∈ U, EqOn g (f c) (O c) := by
    intro c hc y hy
    have hyU := hOU c hc hy
    rw [show g y = f y y from piecewise_eq_of_mem U _ _ hyU]
    have hyu : f y =ᵐ[μ.restrict ((O y ⊓ O c : Opens M) : Set M)] u :=
      ae_restrict_of_ae_restrict_of_subset
        (SetLike.coe_subset_coe.mpr (inf_le_left : O y ⊓ O c ≤ O y)) (hfu y hyU)
    have hcu : f c =ᵐ[μ.restrict ((O y ⊓ O c : Opens M) : Set M)] u :=
      ae_restrict_of_ae_restrict_of_subset
        (SetLike.coe_subset_coe.mpr (inf_le_right : O y ⊓ O c ≤ O c)) (hfu c hc)
    exact Measure.eqOn_open_of_ae_eq (hyu.trans hcu.symm) (O y ⊓ O c).isOpen
      ((hf y hyU).continuousOn.mono (SetLike.coe_subset_coe.mpr inf_le_left))
      ((hf c hc).continuousOn.mono (SetLike.coe_subset_coe.mpr inf_le_right))
      ⟨hxO y hyU, hy⟩
  refine ⟨g, ?_, ?_⟩
  · intro x hx
    apply ContMDiffAt.contMDiffWithinAt
    apply ((hf x hx).contMDiffAt ((O x).isOpen.mem_nhds (hxO x hx))).congr_of_eventuallyEq
    exact Filter.eventually_of_mem ((O x).isOpen.mem_nhds (hxO x hx)) (heq x hx)
  · apply ae_iff.2
    refine measure_null_of_locally_null _ fun x hx => ?_
    have hxU : x ∈ U := by
      by_contra hxU
      exact hx (hgu x hxU)
    refine ⟨_, inter_mem_nhdsWithin _ ((O x).isOpen.mem_nhds (hxO x hxU)),
      measure_mono_null ?_ (ae_iff.1 (ae_imp_of_ae_restrict (hfu x hxU)))⟩
    rintro y ⟨hy, hyO⟩
    exact not_imp.2 ⟨hyO, by rwa [← heq x hxU hyO]⟩
