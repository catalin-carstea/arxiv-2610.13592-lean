/- Relative Taylor data restrict to a physical line segment. The same
one-sided function is used; an ambient analytic extension is not assumed. -/
open Set Metric
open scoped ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

def relativeTaylorPowerSeries (f : E → F) (S : Set E) (x : E) :
    FormalMultilinearSeries ℝ E F := fun k =>
  ((k.factorial : ℝ)⁻¹) • iteratedFDerivWithin ℝ k f S x

without_proof_info in
theorem norm_relativeTaylorPowerSeries_le
    {S : Set E} {f : E → F} {x : E} {M D : ℝ} (hM : 0 ≤ M) (hD : 0 ≤ D)
    (hbound : ∀ k, ‖iteratedFDerivWithin ℝ k f S x‖ ≤
      M * D ^ k * (k.factorial : ℝ)) (k : ℕ) :
    ‖relativeTaylorPowerSeries f S x k‖ ≤ M * D ^ k := by
  have hfac : 0 < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
  rw [relativeTaylorPowerSeries, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hfac.le)]
  calc
    _ ≤ (k.factorial : ℝ)⁻¹ * (M * D ^ k * (k.factorial : ℝ)) :=
      mul_le_mul_of_nonneg_left (hbound k) (inv_nonneg.mpr hfac.le)
    _ = _ := by field_simp

without_proof_info in
theorem hasFTaylorSeriesUpToOn_relative_segment
    {S : Set E} (hS : UniqueDiffOn ℝ S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    (y : E) (hsegment : ∀ t ∈ Icc (0 : ℝ) 1, t • y ∈ S) :
    HasFTaylorSeriesUpToOn ∞ (fun t : ℝ => f (t • y))
      (fun t k => (iteratedFDerivWithin ℝ k f S (t • y)).compContinuousLinearMap
        (fun _ => (ContinuousLinearMap.id ℝ ℝ).smulRight y)) (Icc (0 : ℝ) 1) := by
  let L := (ContinuousLinearMap.id ℝ ℝ).smulRight y
  have hmap : Icc (0 : ℝ) 1 ⊆ L ⁻¹' S := by
    intro t ht
    exact hsegment t ht
  simpa [L, ftaylorSeriesWithin, Function.comp_def] using
    ((hf.ftaylorSeriesWithin hS).compContinuousLinearMap L).mono hmap

without_proof_info in
theorem iteratedDerivWithin_segment_eq_relative_jet
    {S : Set E} (hS : UniqueDiffOn ℝ S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    (y : E) (hsegment : ∀ t ∈ Icc (0 : ℝ) 1, t • y ∈ S)
    {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) (k : ℕ) :
    iteratedDerivWithin k (fun s : ℝ => f (s • y)) (Icc (0 : ℝ) 1) t =
      iteratedFDerivWithin ℝ k f S (t • y) (fun _ => y) := by
  have hp := hasFTaylorSeriesUpToOn_relative_segment hS hf y hsegment
  have heq := hp.eq_iteratedFDerivWithin_of_uniqueDiffOn (m := k) (by simp)
    (uniqueDiffOn_Icc (by norm_num : (0 : ℝ) < 1)) ht
  have heval := congrArg (fun A => A (fun _ : Fin k => (1 : ℝ))) heq
  simpa [iteratedDerivWithin_eq_iteratedFDerivWithin] using heval.symm

without_proof_info in
theorem norm_iteratedDerivWithin_segment_le
    {S : Set E} (hS : UniqueDiffOn ℝ S) {f : E → F} (hf : ContDiffOn ℝ ∞ f S)
    (y : E) (hsegment : ∀ t ∈ Icc (0 : ℝ) 1, t • y ∈ S)
    {M D : ℝ} (hbound : ∀ x ∈ S, ∀ k, ‖iteratedFDerivWithin ℝ k f S x‖ ≤
      M * D ^ k * (k.factorial : ℝ)) {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) (k : ℕ) :
    ‖iteratedDerivWithin k (fun s : ℝ => f (s • y)) (Icc (0 : ℝ) 1) t‖ ≤
