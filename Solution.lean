/-- A single positive bound near the chart base controls every smooth
function's actual interior coordinate derivative by its native gradient. -/
theorem eventually_coordinate_derivative_le_native_gradient (α : M) :
    ∃ C > 0, ∀ᶠ y in 𝓝 α, ∀ f : M → ℝ,
      MDifferentiableAt I 𝓘(ℝ) f y →
      extChartAt I α y ∈ interior (extChartAt I α).target →
      ‖fderiv ℝ (f ∘ (extChartAt I α).symm) (extChartAt I α y)‖ ≤
        C * ‖Manifold.mgradient I f y‖ := by
  obtain ⟨C, hC, hs⟩ :=
    eventually_norm_symmL_trivializationAt_lt E (fun y : M => TangentSpace I y) α
  refine ⟨C, hC, ?_⟩
  filter_upwards [hs, chart_source_mem_nhds H α] with y hy hsource f hf hinterior
  rw [Manifold.norm_mgradient_eq_norm_mvfderiv]
  refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) ?_
  intro v
  rw [← mvfderiv_inverseChart_vector α hsource hinterior hf v]
  calc
    ‖mvfderiv I f y ((trivializationAt E (TangentSpace I) α).symmL ℝ y v)‖ ≤
        ‖mvfderiv I f y‖ * ‖(trivializationAt E (TangentSpace I) α).symmL ℝ y v‖ :=
      ContinuousLinearMap.le_opNorm _ _
    _ ≤ ‖mvfderiv I f y‖ * (C * ‖v‖) := by
      gcongr
      exact ((trivializationAt E (TangentSpace I) α).symmL ℝ y).le_opNorm v |>.trans
        (mul_le_mul_of_nonneg_right hy.le (norm_nonneg v))
    _ = C * ‖mvfderiv I f y‖ * ‖v‖ := by ring

without_proof_info in
/-- A relative coordinate ball at any chart base has uniformly comparable
density and controls ordinary derivatives on its open interior cap. This
does not require a ball across the boundary to lie in the chart target. -/
theorem exists_relative_ball_coordinate_energy_bounds (c : M) :
    ∃ C > 0, ∃ r > 0,
      ball (extChartAt I c c) r ∩ range I ⊆ (extChartAt I c).target ∧
