noncomputable section ProofPart_AmbientChartReadback




/- The actual ambient open Euclidean chart reads by subtype value.
Its Riemannian integral and coordinate Schrodinger operator therefore
use the same point, density and native operator. -/
open Bundle Set MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold Filter
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
set_option synthInstance.maxHeartbeats 100000
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

without_proof_info in
theorem ambient_extChartAt_apply (D : Opens E) (p x : D) :
    extChartAt 𝓘(ℝ, E) p x = (x : E) := by
  simp [extChartAt, Opens.chartAt_eq, OpenPartialHomeomorph.extend, mfld_simps]

without_proof_info in
theorem ambient_extChartAt_source (D : Opens E) (p : D) :
    (extChartAt 𝓘(ℝ, E) p).source = Set.univ := by
  simp [Opens.chartAt_eq, mfld_simps]

without_proof_info in
theorem ambient_extChartAt_target (D : Opens E) (p : D) :
    (extChartAt 𝓘(ℝ, E) p).target = (D : Set E) := by
  simp [Opens.chartAt_eq, OpenPartialHomeomorph.subtypeRestr, mfld_simps]

without_proof_info in
theorem ambient_extChartAt_symm_val (D : Opens E) (p : D) {z : E} (hz : z ∈ D) :
    ((extChartAt 𝓘(ℝ, E) p).symm z : E) = z := by
  have ht : z ∈ (extChartAt 𝓘(ℝ, E) p).target := by rw [ambient_extChartAt_target]; exact hz
  have he := (extChartAt 𝓘(ℝ, E) p).right_inv ht
  rwa [ambient_extChartAt_apply] at he

section Integration
variable [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  (D : Opens E)
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, E) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, E) ∞ E (fun x : D => TangentSpace 𝓘(ℝ, E) x)]
  [MeasurableSpace D] [BorelSpace D]

local instance : IsContinuousRiemannianBundle E (fun x : D => TangentSpace 𝓘(ℝ, E) x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := 𝓘(ℝ, E)) (n := ∞)

local instance : LocallyCompactSpace D := D.isOpen.locallyCompactSpace

without_proof_info in
theorem setIntegral_ambient_chart (p : D) {U : Opens E} (hUD : U ≤ D) (f : D → ℝ) :
    ∫ x in (Subtype.val ⁻¹' (U : Set E) : Set D), f x ∂riemannianVolume 𝓘(ℝ, E) D =
      ∫ z in (U : Set E), chartVolumeDensity (I := 𝓘(ℝ, E)) p ((extChartAt 𝓘(ℝ, E) p).symm z) *
        f ((extChartAt 𝓘(ℝ, E) p).symm z) ∂(Module.finBasis ℝ E).addHaar := by
  have ht : (U : Set E) ⊆ (extChartAt 𝓘(ℝ, E) p).target := by
    rw [ambient_extChartAt_target]
    exact hUD
  have h := setIntegral_native_chart_preimage p U.isOpen ht f
  have he : (extChartAt 𝓘(ℝ, E) p).source ∩ extChartAt 𝓘(ℝ, E) p ⁻¹' (U : Set E) =
      (Subtype.val ⁻¹' (U : Set E) : Set D) := by
    ext x
    simp only [ambient_extChartAt_source, mem_inter_iff, mem_univ, true_and, mem_preimage,
      ambient_extChartAt_apply]
  rwa [he] at h
end Integration

section Operator
variable {d : ℕ} (D : Opens (EuclideanSpace ℝ (Fin d)))
  [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]
  [IsContMDiffRiemannianBundle 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) ∞
    (EuclideanSpace ℝ (Fin d)) (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem coordinateSchrodinger_ambient_restriction_at (p x : D) (q : D → ℝ)
    {f : EuclideanSpace ℝ (Fin d) → ℝ} (hf : ContDiffAt ℝ 2 f (x : EuclideanSpace ℝ (Fin d))) :
    coordinateSchrodinger (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q) f x =
        -laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) (fun y : D => f y) x + q x * f x := by
  let F : D → ℝ := fun y => f y
  have hF : ContMDiffAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) 𝓘(ℝ) 2 F x :=
    hf.contMDiffAt.comp x contMDiff_subtype_val.contMDiffAt
  have hy : x ∈ (chartAt (EuclideanSpace ℝ (Fin d)) p).source := by
    rw [← extChartAt_source (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))), ambient_extChartAt_source]
    trivial
  have hint : extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p x ∈
      interior (extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).target := by
    rw [ambient_extChartAt_target, D.isOpen.interior_eq, ambient_extChartAt_apply]
    exact x.property
  have he : F ∘ (extChartAt 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) p).symm =ᶠ[𝓝 (x : EuclideanSpace ℝ (Fin d))] f := by
    filter_upwards [D.isOpen.mem_nhds x.property] with z hz
    exact congrArg f (ambient_extChartAt_symm_val D p hz)
  have h := coordinateSchrodinger_eq_native p hy hint q hF
  rw [ambient_extChartAt_apply, coordinateSchrodinger_eq_of_eventuallyEq _ _ _ he] at h
  exact h
without_proof_info in
theorem coordinateSchrodinger_ambient_restriction (p x : D) (q : D → ℝ)
    {f : EuclideanSpace ℝ (Fin d) → ℝ} (hf : ContDiff ℝ 2 f) :
    coordinateSchrodinger (chartPrincipalCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartDriftCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p)
      (chartPotentialCoefficient (I := 𝓘(ℝ, EuclideanSpace ℝ (Fin d))) p q) f x =
        -laplaceBeltrami 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) (fun y : D => f y) x + q x * f x :=
  coordinateSchrodinger_ambient_restriction_at D p x q hf.contDiffAt
end Operator
end ConformalPoisson

end ProofPart_AmbientChartReadback

