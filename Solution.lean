/- Green/trace proof support: AllOrderCapEvaluation.lean, SHA256 8e3d1ecd476c66b393566cec740763632849570369040389ffb0259fdc19d912 -/
noncomputable section ProofPart_GreenTrace_AllOrderCapEvaluation



/- Bounded point evaluations of all-order Sobolev readings on one fixed
closed native cap. The SAME scalar evaluations are boundary smooth and their
actual weak directional equations agree with the directional reading family.
Operator-valued smoothness remains a separate downstream proof. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
  {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
namespace AllOrderSobolevReading

def capReading (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) :
    H →L[ℝ] C(closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V), ℝ) :=
  Classical.choose (exists_bounded_smooth_cap_reading c hr S.value (fun k =>
    ⟨S.reading k, S.reading_value k⟩))

without_proof_info in
theorem capReading_spec (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) (u : H) :
    ∃ v : V → ℝ, Continuous v ∧
      ContDiffOn ℝ ∞ v (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) ∧
      (∀ x (hx : x ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)),
        capReading c hr S u ⟨x, hx⟩ = v x) ∧
      v =ᵐ[μ.restrict (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)] S.value u :=
  Classical.choose_spec (exists_bounded_smooth_cap_reading c hr S.value (fun k =>
    ⟨S.reading k, S.reading_value k⟩)) u

def capEvaluation (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) (x : V) : H →L[ℝ] ℝ := by
  classical
  exact if hx : x ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V) then
    (ContinuousMap.evalCLM ℝ ⟨x, hx⟩).comp (capReading c hr S)
  else 0

without_proof_info in
theorem capEvaluation_apply_of_mem (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H)
    {x : V} (hx : x ∈ closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) (u : H) :
    capEvaluation c hr S x u = capReading c hr S u ⟨x, hx⟩ := by
  rw [capEvaluation, dite_eq_left hx]
  rfl

without_proof_info in
theorem capEvaluation_smooth_apply (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) (u : H) :
    ContDiffOn ℝ ∞ (fun x => capEvaluation c hr S x u)
      (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) := by
  obtain ⟨v, _, hv, hTv, _⟩ := capReading_spec c hr S u
  exact hv.congr (fun x hx => (capEvaluation_apply_of_mem c hr S hx u).trans (hTv x hx))

without_proof_info in
theorem capEvaluation_continuousOn_apply (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) (u : H) :
    ContinuousOn (fun x => capEvaluation c hr S x u)
      (closure (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)) :=
  (capEvaluation_smooth_apply c hr S u).continuousOn

without_proof_info in
theorem capEvaluation_ae (c : M) {r : ℝ} (hr : 0 < r)
    (S : AllOrderSobolevReading μ (boundaryChartCap (I := Ihalf) c r) H) (u : H) :
    (fun x => capEvaluation c hr S x u) =ᵐ[
      μ.restrict (boundaryChartCap (I := Ihalf) c (r / 2) : Set V)] S.value u := by
  obtain ⟨v, _, _, hTv, hv⟩ := capReading_spec c hr S u
  filter_upwards [hv, ae_restrict_mem (boundaryChartCap (I := Ihalf) c (r / 2)).isOpen.measurableSet]
