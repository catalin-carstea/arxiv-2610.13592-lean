  let β : ℝ := ((n : ℝ) + 1) + 2 * α
  have hβ : β < ((n + 1 + 2 : ℕ) : ℝ) := by
    dsimp only [β]
    have hα' : (α : ℝ) < 1 := hαlt
    push_cast
    linarith
  obtain ⟨ε₀, C, hε, hC, hiter⟩ := exists_le_mul_div_rpow_mul_add_mul_rpow_of_le_mul_add
    (A := 4 * D) (α := ((n + 1 + 2 : ℕ) : ℝ)) (β := β) (γ := β) (by positivity) hβ hβ
  let B0 := (4 * D + 2) * M
  have hB0 : 0 ≤ B0 := by dsimp only [B0, D]; positivity
  let A := C * (R ^ (-β) * ‖W1p.gradient u‖ ^ 2 + B0)
  refine ⟨A, by dsimp only [A]; positivity, ?_⟩
  intro z hz t ht htR
  have hball : ball z R ⊆ Ω := (ball_subset_thickening hz R).trans hS
  let φ : ℝ → ℝ := fun s => ∫ x in ball z s,
    ‖W1p.gradient u x - ⨍ y in ball z s, W1p.gradient u y‖ ^ 2
  have hmono : MonotoneOn φ (Ioc 0 R) :=
    monotoneOn_setIntegral_norm_gradient_sub_setAverage_sq u hball
  have hnonneg : ∀ r ∈ Ioc 0 R, 0 ≤ φ r := fun r _ => integral_nonneg fun _ => sq_nonneg _
  have hstep : ∀ ρ r, 0 < ρ → ρ ≤ r → r ≤ R →
      φ ρ ≤ 4 * D * ((ρ / r) ^ ((n + 1 + 2 : ℕ) : ℝ) + 0) * φ r + B0 * r ^ β := by
    intro ρ r hρ hρr hrR
    have hr : 0 < r := hρ.trans_le hρr
    have hB : (⟨ball z r, isOpen_ball⟩ : Opens V) ≤ Ω := (ball_subset_ball hrR).trans hball
    obtain ⟨G, hG, hnorm⟩ := hres z hz r hr hrR hB
    have hzero : SobolevDivergenceFree ⟨ball z r, isOpen_ball⟩
        (0 : Lp V 2 (volume.restrict (ball z r))) := by
      intro v
      exact inner_zero_left _
    have hc := gradient_oscillation_le_of_divergenceFree_reference (W1p.restrictL hB u)
      G 0 hG hzero hρ hρr
    simp only [sub_zero] at hc
    rw [gradient_oscillation_restrictL hB u (ball_subset_ball hρr),
      gradient_oscillation_restrictL hB u subset_rfl] at hc
    change φ ρ ≤ 4 * D * (ρ / r) ^ (n + 1 + 2) * φ r + (4 * D + 2) * ‖G‖ ^ 2 at hc
    rw [add_zero, Real.rpow_natCast]
    calc
      φ ρ ≤ 4 * D * (ρ / r) ^ (n + 1 + 2) * φ r + (4 * D + 2) * ‖G‖ ^ 2 := hc
      _ ≤ 4 * D * (ρ / r) ^ (n + 1 + 2) * φ r + (4 * D + 2) * (M * r ^ β) :=
        add_le_add le_rfl (mul_le_mul_of_nonneg_left hnorm (by dsimp only [D]; positivity))
      _ = _ := by dsimp only [B0]; ring
  have hd := hiter (R := R) (B := B0) (ε := 0) hB0 hε.le hmono hnonneg hstep t R ht htR le_rfl
  have hmass : φ R ≤ ‖W1p.gradient u‖ ^ 2 :=
    (setIntegral_norm_gradient_sub_setAverage_sq_le u hball).trans
      (Lp.setIntegral_norm_sq_le_norm_sq (W1p.gradient u) hball)
  have hq : (t / R) ^ β = t ^ β * R ^ (-β) := by
    rw [Real.div_rpow ht.le hR.le, Real.rpow_neg hR.le, div_eq_mul_inv]
  calc
    φ t ≤ C * ((t / R) ^ β * φ R + B0 * t ^ β) := hd
    _ ≤ C * ((t / R) ^ β * ‖W1p.gradient u‖ ^ 2 + B0 * t ^ β) := by gcongr
    _ = A * t ^ β := by rw [hq]; dsimp only [A]; ring

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_holderOnWith_gradient_of_local_residuals {Ω : Opens V}
    (u : W1p volume Ω 2) {S : Set V} {α : ℝ≥0} {R M : ℝ}
    (hα : 0 < α) (hαlt : α < 1) (hR : 0 < R) (hM : 0 ≤ M) (hS : thickening R S ⊆ Ω)
