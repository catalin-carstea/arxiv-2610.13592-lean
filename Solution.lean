theorem setLIntegral_innerNeighborhood_enorm_sq_le
    (u : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x}) :
    ∫⁻ x in (L.innerNeighborhood : Set M), ‖u.val x‖ₑ ^ 2 ∂riemannianVolume I M ≤
      ENNReal.ofReal L.densityUpper *
        ‖L.valueReadingL (smoothInclusion (E := E) (I := I) (M := M)
          {x : M | I.IsBoundaryPoint x} u)‖ₑ ^ 2 := by
  have h := L.setLIntegral_innerNeighborhood_le (fun x hx => u.property x hx)
    (fun t => ‖t‖ₑ ^ 2) (by simp)
  refine h.trans_eq (congrArg (ENNReal.ofReal L.densityUpper * ·) ?_)
  let U := L.valueReadingL (smoothInclusion (E := E) (I := I) (M := M)
    {x : M | I.IsBoundaryPoint x} u)
