      (R.normalCoordinateMap A z) := contMDiff_subtype_val.contMDiffAt
  have hF : ContMDiffAt 𝓘(ℝ, V) 𝓘(ℝ) 2 F (R.normalCoordinateMap A z) := by
    have hc := ContMDiffAt.comp_of_eq
