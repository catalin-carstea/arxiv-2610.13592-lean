    filter_upwards [ae_restrict_mem (Ω.isOpen.inter isOpen_ball).measurableSet] with z hz
    change |-nativeChartPotential c q (e z)| ≤ γ
    rw [abs_neg]
    exact (hlower _ (hmem z hz)).2
  obtain ⟨D, hD, hDall⟩ := hbound 0 Ω x₀ R hR (splitBoundaryChartCap_inter_ball c R)
    (splitChartPrincipal g c x₀) lam hlam hA₀ (splitChartPrincipal g c) (δ * lam) Λ
    hAm le_rfl hA hΛ hAΛ (splitChartHomogeneousDrift g c) (splitChartHomogeneousPotential c q)
    β γ hβ hγ hbm hb hcm hc
  refine ⟨D, hD, fun u hu hu0 hLu => ?_⟩
  obtain ⟨U, hU, hzero, heq⟩ := exists_native_split_homogeneous_reading hpfin g q u c htargetR hu hu0 hLu
  refine ⟨U, hU, hzero, hDall U hzero ?_⟩
