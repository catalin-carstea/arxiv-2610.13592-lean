without_proof_info in
theorem NativePoleCutoffData.cutoff_center {x : M} {G : M → ℝ}
    (D : NativePoleCutoffData (n := n) x G) : D.cutoff x = 1 := D.one D.center

without_proof_info in
theorem NativePoleCutoffData.extension_zero_boundary {x : M} {G : M → ℝ}
    (D : NativePoleCutoffData (n := n) x G) (y : (Ihalf).boundary M) : D.extension y = 0 := by
  apply image_eq_zero_of_notMem_tsupport
  intro hy
  have hiy := D.extension_interior_support hy
  have hyc : (y : M) ∈ ((Ihalf).interior M)ᶜ := by
    rw [(Ihalf).compl_interior]
    exact y.property
  exact hyc hiy

without_proof_info in
theorem exists_nativePoleCutoffData_within
    (W : Opens M) (hWI : (W : Set M) ⊆ (Ihalf).interior M)
    (x : M) (hxW : x ∈ W) (G : M → ℝ)
    (hG : ContMDiffOn Ihalf 𝓘(ℝ) ∞ G ((Ihalf).interior M \ {x})) :
    ∃ D : NativePoleCutoffData (n := n) x G, tsupport D.cutoff ⊆ (W : Set M) := by
  let : SecondCountableTopology M := native_secondCountable_of_compact (n := n) isCompact_univ
  have hI : IsOpen ((Ihalf).interior M) := (Ihalf).isOpen_interior (n := ω) (by decide)
  obtain ⟨θ, hθ, hθone, hθc, hθW, _⟩ :=
    (isCompact_singleton (x := x)).exists_contMDiff_one_nhds_tsupport_subset Ihalf W.isOpen
      (singleton_subset_iff.mpr hxW)
  have hθI : tsupport θ ⊆ (Ihalf).interior M := hθW.trans hWI
  let O : Opens M := ⟨interior {z : M | θ z = 1}, isOpen_interior⟩
  have hxO : x ∈ O := by
    apply mem_interior_iff_mem_nhds.mpr
    change ∀ᶠ z in 𝓝 x, θ z = 1
    simpa only [nhdsSet_singleton] using hθone
  have hθO : EqOn θ (fun _ => 1) O := fun z hz => interior_subset hz
  let T : Set M := tsupport θ \ (O : Set M)
  have hTc : IsCompact T := hθc.of_isClosed_subset
    ((isClosed_tsupport θ).inter O.isOpen.isClosed_compl) (fun _ hz => hz.1)
  let U : Set M := (Ihalf).interior M \ {x}
  have hU : IsOpen U := hI.inter isOpen_compl_singleton
  have hTU : T ⊆ U := by
    intro z hz
    refine ⟨hθI hz.1, ?_⟩
    intro hzx
    exact hz.2 (mem_singleton_iff.mp hzx ▸ hxO)
