    filter_upwards [hU.mem_nhds hy] with x hx
    exact fderiv_polynomialProfile_direction hU hP hκ D hD hx s v
  rw [he.fderiv_eq]
  exact fderiv_polynomialProfile_direction hU (hP.profileSpatialDeriv hU hκ D v) hκ (D + 1)
