noncomputable section ProofPart_GreenTrace_StandardChartDensity



/- The native Riemannian density read with the standard Euclidean model
basis and standard Euclidean volume. This changes only the coordinate
normalization; the underlying native measure and metric are unchanged. -/
open Bundle Module MeasureTheory Set TauCeti Riemannian.Tensor
open scoped Manifold
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

section ModelBorel
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M => TangentSpace I x)]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
  [MeasurableSpace E] [BorelSpace E]

without_proof_info in
/-- Transport the existing chart integral to the model's existing Borel
structure, as in the prior NativeChartIntegration helpers. -/
theorem setIntegral_native_chart_of_subset (α : M) {S : Set M}
    (hS : MeasurableSet S) (hSs : S ⊆ (chartAt H α).source) (f : M → ℝ) :
    (∫ x in S, f x ∂riemannianVolume I M) =
      ∫ z in extChartAt I α '' S,
        chartVolumeDensity (I := I) α ((extChartAt I α).symm z) * f ((extChartAt I α).symm z)
          ∂(Module.finBasis ℝ E).addHaar := by
  obtain rfl : ‹MeasurableSpace E› = extChartAtMeasurableSpaceE := BorelSpace.measurable_eq
  letI : MeasurableSpace E := extChartAtMeasurableSpaceE
  exact setIntegral_riemannianVolume_of_subset hSs hS f
end ModelBorel

def standardModelFinBasis (m : ℕ) : Basis (Fin m) ℝ (EuclideanSpace ℝ (Fin m)) :=
  (Module.finBasis ℝ (EuclideanSpace ℝ (Fin m))).reindex (finCongr (by simp))

variable {m : ℕ} {H M : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin m)) H}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 1 M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
local notation "E" => EuclideanSpace ℝ (Fin m)

def standardChartDensity (α x : M) : ℝ :=
  chartVolumeDensity (I := I) α x /
    |(EuclideanSpace.basisFun (Fin m) ℝ).toBasis.det (standardModelFinBasis m)|

without_proof_info in
theorem chartVolumeDensity_eq_standard (α x : M) :
    chartVolumeDensity (I := I) α x =
      |(EuclideanSpace.basisFun (Fin m) ℝ).toBasis.det (standardModelFinBasis m)| *
        standardChartDensity (I := I) α x := by
  have hd := ((EuclideanSpace.basisFun (Fin m) ℝ).toBasis.isUnit_det (standardModelFinBasis m)).ne_zero
  unfold standardChartDensity
  field_simp

set_option maxHeartbeats 500000 in
without_proof_info in
theorem standardChartDensity_eq_sqrt_gram (α : M) {x : M}
    (hx : x ∈ (trivializationAt E (TangentSpace I) α).baseSet) :
    standardChartDensity (I := I) α x = Real.sqrt (Matrix.gram ℝ
      (fun i : Fin m => (trivializationAt E (TangentSpace I) α).symmL ℝ x
        (EuclideanSpace.basisFun (Fin m) ℝ i))).det := by
  let e := trivializationAt E (TangentSpace I) α
  let L : E ≃ₗ[ℝ] TangentSpace I x := (e.continuousLinearEquivAt ℝ x hx).symm.toLinearEquiv
  let b := standardModelFinBasis m
  let c := (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
  have hL (v : E) : L v = e.symmL ℝ x v :=
    congrFun (e.symm_continuousLinearEquivAt_eq hx) v
  have hBasis : b.map L = e.basisAt b hx := by
    ext i
    simp only [Basis.map_apply, hL, TauCeti.Manifold.basisAt_apply]
  have hFin : Real.sqrt (Matrix.gram ℝ (b.map L)).det = chartVolumeDensity (I := I) α x := by
    rw [hBasis, chartVolumeDensity_def]
    unfold b standardModelFinBasis
    rw [gram_basisAt_finBasis_reindex, Matrix.det_submatrix_equiv_self]
  have hStd : (c.map L : Fin m → TangentSpace I x) =
      (fun i => e.symmL ℝ x (EuclideanSpace.basisFun (Fin m) ℝ i)) := by
    funext i
    simp only [Basis.map_apply, hL, c, OrthonormalBasis.coe_toBasis]
  have hchange := sqrt_det_gram_changeBasis b c L
  rw [hFin, hStd] at hchange
  have hd := (c.isUnit_det b).ne_zero
  unfold standardChartDensity
  rw [hchange]
  exact mul_div_cancel_left₀ _ (abs_ne_zero.mpr hd)

variable [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
  [IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin m)) (fun x : M => TangentSpace I x)]

without_proof_info in
/-- The chart density and coordinate measure are normalized together. -/
theorem integral_chartVolumeDensity_eq_standard (α : M) (f : E → ℝ) (S : Set E) :
    (∫ z in S, chartVolumeDensity (I := I) α ((extChartAt I α).symm z) * f z
      ∂(Module.finBasis ℝ E).addHaar) =
    ∫ z in S, standardChartDensity (I := I) α ((extChartAt I α).symm z) * f z := by
  have h := integral_gramDensity_changeBasis (standardModelFinBasis m)
    (EuclideanSpace.basisFun (Fin m) ℝ).toBasis
    (fun z => chartVolumeDensity (I := I) α ((extChartAt I α).symm z))
    (fun z => standardChartDensity (I := I) α ((extChartAt I α).symm z))
    (fun z => chartVolumeDensity_eq_standard α _) f S
  simpa only [standardModelFinBasis, Basis.addHaar_reindex, OrthonormalBasis.addHaar_eq_volume] using h

without_proof_info in
/-- Native volume integration in one chart, now with standard Euclidean
volume and the Gram density of the standard coordinate frame. -/
theorem setIntegral_nativeVolume_eq_standard (α : M) {S : Set M}
    (hS : MeasurableSet S) (hSs : S ⊆ (chartAt H α).source) (f : M → ℝ) :
    (∫ x in S, f x ∂riemannianVolume I M) =
      ∫ z in extChartAt I α '' S,
        standardChartDensity (I := I) α ((extChartAt I α).symm z) * f ((extChartAt I α).symm z) := by
  rw [setIntegral_native_chart_of_subset (I := I) α hS hSs]
  simp only [smul_eq_mul]
  exact integral_chartVolumeDensity_eq_standard (I := I) α _ _
end ConformalPoisson

end ProofPart_GreenTrace_StandardChartDensity

