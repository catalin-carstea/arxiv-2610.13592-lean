open Set Metric Function Manifold Module EuclideanGeometry
open scoped Manifold ContDiff InnerProductSpace Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e₀" => (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ))

without_proof_info in
theorem inversion_apply_zero {y : EuclideanSpace ℝ (Fin (n + 1))} (hy : y ≠ -e₀) :
    inversion (-e₀) √2 y 0 = (1 - ‖y‖ ^ 2) / ‖y + e₀‖ ^ 2 := by
  have hd : ‖y + e₀‖ ≠ 0 := by
    rwa [norm_ne_zero_iff, ← sub_neg_eq_add, sub_ne_zero]
  have hsq : ‖y + e₀‖ ^ 2 = ‖y‖ ^ 2 + 2 * y 0 + 1 := by
    rw [norm_add_sq_real, EuclideanSpace.inner_single_right, PiLp.norm_single]
    simp
  simp only [inversion, dist_eq_norm, vsub_eq_sub, vadd_eq_add, sub_neg_eq_add, div_pow,
    Real.sq_sqrt zero_le_two, PiLp.add_apply, PiLp.smul_apply, PiLp.neg_apply,
    PiLp.single_apply, ite_true, smul_eq_mul]
  field_simp
  rw [hsq]
  ring

without_proof_info in
theorem norm_add_single_sq_pos {y : EuclideanSpace ℝ (Fin (n + 1))} (hy : y ≠ -e₀) :
    0 < ‖y + e₀‖ ^ 2 := by
  have : y + e₀ ≠ 0 := by rwa [← sub_neg_eq_add, sub_ne_zero]
  positivity

without_proof_info in
/-- The inversion carries the closed unit ball minus its centre into the half-space. -/
theorem inversion_apply_zero_nonneg_iff {y : EuclideanSpace ℝ (Fin (n + 1))} (hy : y ≠ -e₀) :
    0 ≤ inversion (-e₀) √2 y 0 ↔ ‖y‖ ≤ 1 := by
  rw [inversion_apply_zero hy, le_div_iff₀ (norm_add_single_sq_pos hy), zero_mul, sub_nonneg,
    sq_le_one_iff₀ (norm_nonneg _)]

without_proof_info in
/-- The inversion carries the open unit ball into the open half-space. -/
theorem inversion_apply_zero_pos_iff {y : EuclideanSpace ℝ (Fin (n + 1))} (hy : y ≠ -e₀) :
    0 < inversion (-e₀) √2 y 0 ↔ ‖y‖ < 1 := by
  rw [inversion_apply_zero hy, div_pos_iff_of_pos_right (norm_add_single_sq_pos hy), sub_pos,
    sq_lt_one_iff₀ (norm_nonneg _)]

without_proof_info in
/-- The centre of the inversion lies outside the half-space. -/
theorem ne_neg_single_of_nonneg {y : EuclideanSpace ℝ (Fin (n + 1))} (hy : 0 ≤ y 0) :
    y ≠ -e₀ := by
  rintro rfl
  norm_num at hy

without_proof_info in
/-- The inversion carries the half-space back into the closed unit ball. -/
theorem norm_inversion_le_one {y : EuclideanSpace ℝ (Fin (n + 1))} (hy : 0 ≤ y 0) :
    ‖inversion (-e₀) √2 y‖ ≤ 1 := by
  have hc := ne_neg_single_of_nonneg hy
  have hR : (√2 : ℝ) ≠ 0 := by positivity
  rw [← inversion_apply_zero_nonneg_iff ((inversion_eq_center hR).not.2 hc),
    inversion_inversion _ hR]
  exact hy


without_proof_info in
theorem norm_inversion_lt_one {y : V} (hy : 0 < y 0) :
    ‖inversion (-e₀) √2 y‖ < 1 := by
  have hc := ne_neg_single_of_nonneg hy.le
  have hR : (√2 : ℝ) ≠ 0 := by positivity
  rw [← inversion_apply_zero_pos_iff ((inversion_eq_center hR).not.2 hc), inversion_inversion _ hR]
  exact hy

without_proof_info in
theorem norm_inversion_eq_one_of_face {y : V} (hy : y 0 = 0) :
    ‖inversion (-e₀) √2 y‖ = 1 := by
  have hc := ne_neg_single_of_nonneg (le_of_eq hy.symm)
  have hR : (√2 : ℝ) ≠ 0 := by positivity
  apply le_antisymm (norm_inversion_le_one (le_of_eq hy.symm))
  apply le_of_not_gt
  rw [← inversion_apply_zero_pos_iff ((inversion_eq_center hR).not.2 hc), inversion_inversion _ hR, hy]
  exact lt_irrefl 0

def chartMap (n : ℕ) : EuclideanSpace ℝ (Fin (n + 1)) → EuclideanSpace ℝ (Fin (n + 1)) :=
  inversion (-(EuclideanSpace.single 0 1)) √2

without_proof_info in
theorem chartMap_mem_closedBall {y : V} (hy : 0 ≤ y 0) : chartMap n y ∈ closedBall (0 : V) 1 :=
  mem_closedBall_zero_iff.2 (norm_inversion_le_one hy)

without_proof_info in
theorem chartMap_mem_ball {y : V} (hy : 0 < y 0) : chartMap n y ∈ ball (0 : V) 1 :=
  mem_ball_zero_iff.2 (norm_inversion_lt_one hy)

without_proof_info in
theorem chartMap_mem_sphere_of_face {y : V} (hy : y 0 = 0) : chartMap n y ∈ sphere (0 : V) 1 :=
  mem_sphere_zero_iff_norm.2 (norm_inversion_eq_one_of_face hy)

without_proof_info in
theorem chartMap_chartMap (y : V) : chartMap n (chartMap n y) = y :=
  inversion_inversion _ (by positivity : (√2 : ℝ) ≠ 0) y
end ConformalPoisson.SphereFlattening

end ProofPart_SphereInversionGeometry

/- Proof support: SphereKelvinEquation.lean, SHA256 8a773d88d87cd0903a84935451c3fca7a681051e3dc7eef62b83a2517a9ffe03 -/
noncomputable section ProofPart_SphereKelvinEquation


/- The actual transformed Dirichlet problem on the half-space:
classical equation, C2 interior, continuous boundary values and zero
face trace all follow from the original ball data. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace EuclideanGeometry
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e₀" => (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ))

def chartKelvin (u : V → ℝ) : V → ℝ := kelvinTransformAt (-e₀) √2 u

without_proof_info in
theorem contDiffOn_chartKelvin {u : V → ℝ} (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1)) :
    ContDiffOn ℝ 2 (chartKelvin u) {y : V | 0 < y 0} := by
  intro y hy
  have hmem := chartMap_mem_ball hy
  have huI : ContDiffAt ℝ 2 u (chartMap n y) :=
    (hu (chartMap n y) hmem).contDiffAt (isOpen_ball.mem_nhds hmem)
  exact (contDiffAt_kelvinTransformAt (-e₀) √2 (ne_neg_single_of_nonneg hy.le) huI).contDiffWithinAt

set_option maxHeartbeats 400000 in
without_proof_info in
theorem negative_laplacian_chartKelvin {u f : V → ℝ}
    (hu : ContDiffOn ℝ 2 u (ball (0 : V) 1))
    (heq : ∀ z ∈ ball (0 : V) 1, -Δ u z = f z) {y : V} (hy : 0 < y 0) :
    -Δ (chartKelvin u) y =
      4 * ‖y + e₀‖ ^ (-((n : ℝ) + 1) - 2) * f (chartMap n y) := by
  have huI : ContDiffAt ℝ 2 u (inversion (-e₀) √2 y) :=
    (hu _ (chartMap_mem_ball hy)).contDiffAt (isOpen_ball.mem_nhds (chartMap_mem_ball hy))
  have hfour : (√2 : ℝ) ^ 4 = 4 := by
    calc
      (√2 : ℝ) ^ 4 = ((√2 : ℝ) ^ 2) ^ 2 := by ring
      _ = 4 := by rw [Real.sq_sqrt zero_le_two]; norm_num
  have hΔ : Δ u (chartMap n y) = -f (chartMap n y) := by linarith [heq _ (chartMap_mem_ball hy)]
  rw [chartKelvin, laplacian_kelvinTransformAt (-e₀) √2 (ne_neg_single_of_nonneg hy.le) huI,
    hfour, sub_neg_eq_add]
  change -(4 * ‖y + e₀‖ ^ (-((n : ℝ) + 1) - 2) * Δ u (chartMap n y)) = _
  rw [hΔ]
  ring

without_proof_info in
theorem continuousOn_chartKelvin_closedHalfSpace {u : V → ℝ}
    (hu : ContinuousOn u (closedBall (0 : V) 1)) :
    ContinuousOn (chartKelvin u) {y : V | 0 ≤ y 0} := by
  have hw : ContinuousOn (fun y : V => ‖y - (-e₀)‖ ^ (2 - ((n : ℝ) + 1))) {y : V | 0 ≤ y 0} := by
    intro y hy
    exact (contDiffAt_norm_sub_rpow (-e₀) (2 - ((n : ℝ) + 1))
      (k := 0) (ne_neg_single_of_nonneg hy)).continuousAt.continuousWithinAt
  have hI : ContinuousOn (chartMap n) {y : V | 0 ≤ y 0} := by
    intro y hy
    exact (EuclideanGeometry.contDiffAt_inversion (ne_neg_single_of_nonneg hy)
      (R := √2) (n := 0)).continuousAt.continuousWithinAt
  exact hw.mul (hu.comp hI (fun y hy => chartMap_mem_closedBall hy))

without_proof_info in
theorem chartKelvin_eq_zero_on_face {u : V → ℝ} (hu0 : EqOn u 0 (sphere (0 : V) 1)) :
    EqOn (chartKelvin u) 0 {y : V | y 0 = 0} := by
  intro y hy
  change ‖y - (-e₀)‖ ^ (2 - ((n : ℝ) + 1)) * u (chartMap n y) = 0
  rw [hu0 (chartMap_mem_sphere_of_face hy)]
  exact mul_zero _
end ConformalPoisson.SphereFlattening

end ProofPart_SphereKelvinEquation

/- Proof support: SphereChartSobolev.lean, SHA256 4526976f313926e28b6a55e87fc4151f322cd495858fc3bfb02d7ebf92eb1065 -/
noncomputable section ProofPart_SphereChartSobolev




/- The sphere chart transports actual finite-energy representatives.
The Jacobian lower bound is obtained on a compact cap away from the pole;
in particular, pulling back an almost-everywhere equality is justified by
the change-of-variables measure bound. The Kelvin weight is multiplied
only on a cap compactly contained in the punctured ambient space. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti EuclideanGeometry
open scoped NNReal ContDiff ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e₀" => (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ))
local notation "B₁" => (TopologicalSpace.Opens.mk (ball (0 : V) 1) isOpen_ball)

without_proof_info in
theorem chartMap_derivative_bounds_on_compact {K : Set V} (hK : IsCompact K)
    (hKhalf : K ⊆ {y : V | 0 ≤ y 0}) :
    ∃ L c : ℝ, 0 < c ∧ (∀ y ∈ K, ‖fderiv ℝ (chartMap n) y‖ ≤ L) ∧
      ∀ y ∈ K, c ≤ |(fderiv ℝ (chartMap n) y).det| := by
  have hD : ContinuousOn (fderiv ℝ (chartMap n)) K := by
    intro y hy
    exact ((EuclideanGeometry.contDiffAt_inversion
      (ne_neg_single_of_nonneg (hKhalf hy)) (R := √2) (n := 1)).continuousAt_fderiv
        (by norm_num)).continuousWithinAt
  have hdet : ContinuousOn (fun y : V => |(fderiv ℝ (chartMap n) y).det|) K :=
    (ContinuousLinearMap.continuous_det.comp_continuousOn hD).abs
  have hpos : ∀ y ∈ K, 0 < |(fderiv ℝ (chartMap n) y).det| := by
    intro y hy
    exact abs_pos.mpr (ne_of_lt (det_fderiv_inversion_neg
      (Real.sqrt_ne_zero'.mpr (by norm_num : (0 : ℝ) < 2))
      (ne_neg_single_of_nonneg (hKhalf hy))))
  obtain ⟨L, hL⟩ := hK.exists_bound_of_continuousOn hD
  by_cases hne : K.Nonempty
  · obtain ⟨z, hz, hmin⟩ := hK.exists_isMinOn hne hdet
    exact ⟨L, |(fderiv ℝ (chartMap n) z).det|, hpos z hz, hL,
      fun y hy => hmin hy⟩
  · refine ⟨L, 1, zero_lt_one, hL, ?_⟩
    intro y hy
    exact (hne ⟨y, hy⟩).elim

without_proof_info in
theorem exists_chartKelvin_w1p {Ω : Opens V} {K : Set V}
    (hK : IsCompact K) (hΩK : (Ω : Set V) ⊆ K)
    (hKhalf : K ⊆ {y : V | 0 ≤ y 0})
    (hΩhalf : (Ω : Set V) ⊆ {y : V | 0 < y 0})
    {u : V → ℝ} (U : W1p volume B₁ 2)
    (hU : W1p.value U =ᵐ[volume.restrict B₁] u) :
    ∃ v : W1p volume Ω 2, W1p.value v =ᵐ[volume.restrict Ω] chartKelvin u := by
  obtain ⟨L, c, hc, hL, hdet⟩ := chartMap_derivative_bounds_on_compact hK hKhalf
  have hΦ : DifferentiableOn ℝ (chartMap n) Ω := by
    intro y hy
    exact (EuclideanGeometry.contDiffAt_inversion
      (ne_neg_single_of_nonneg (hΩhalf hy).le) (R := √2) (n := 1)).differentiableAt
        (by norm_num) |>.differentiableWithinAt
  have hinj : InjOn (chartMap n) Ω :=
    (Function.Involutive.injective (chartMap_chartMap (n := n))).injOn
  have hmaps : MapsTo (chartMap n) Ω B₁ := fun y hy => chartMap_mem_ball (hΩhalf hy)
  have hLΩ : ∀ y ∈ (Ω : Set V), ‖fderiv ℝ (chartMap n) y‖ ≤ L := fun y hy => hL y (hΩK hy)
  have hdetΩ : ∀ y ∈ (Ω : Set V), c ≤ |(fderiv ℝ (chartMap n) y).det| :=
    fun y hy => hdet y (hΩK hy)
  let v := W1p.compL (chartMap n) (by norm_num : (2 : ℝ≥0∞) ≠ ⊤)
    hΦ hinj hmaps hLΩ hc hdetΩ U
  have hv : W1p.value v =ᵐ[volume.restrict Ω] fun y => u (chartMap n y) := by
    refine (W1p.value_compL_ae (chartMap n) (by norm_num : (2 : ℝ≥0∞) ≠ ⊤)
      hΦ hinj hmaps hLΩ hc hdetΩ U).trans ?_
    exact ae_comp_of_map_absolutelyContinuous (hΦ.continuousOn.aemeasurable Ω.isOpen.measurableSet)
      (Measure.absolutelyContinuous_of_le_smul
        (map_restrict_le_smul_restrict_of_differentiableOn volume Ω.isOpen hΦ hinj hmaps hc hdetΩ)) hU
  let S : Set V := {-e₀}ᶜ
  have hS : IsOpen S := isOpen_compl_singleton
  have hKS : K ⊆ S := fun y hy => ne_neg_single_of_nonneg (hKhalf hy)
  have hw : ContDiffOn ℝ ∞ (fun y : V => ‖y - (-e₀)‖ ^ (2 - ((n : ℝ) + 1))) S := by
    intro y hy
    exact (contDiffAt_norm_sub_rpow (-e₀) (2 - ((n : ℝ) + 1)) hy).contDiffWithinAt
  obtain ⟨w, hw⟩ := exists_wkp_mul_of_relative_smooth hS.uniqueDiffOn hK hKS hΩK
    (by simpa only [hS.interior_eq] using hΩK.trans hKS) 1 hw v
  refine ⟨w, ?_⟩
  simp only [Wkp.value_one] at hw
  filter_upwards [hw, hv] with y hy hyv
  change W1p.value w y = ‖y - (-e₀)‖ ^ (2 - ((n : ℝ) + 1)) * u (chartMap n y)
  rw [hy, hyv]
end ConformalPoisson.SphereFlattening

end ProofPart_SphereChartSobolev

/- Proof support: CompactLocalHolderBound.lean, SHA256 4eee0ab8cd95fdc354ec8d615c0490914d5422bae145fd844ae984834d4f0a59 -/
noncomputable section ProofPart_CompactLocalHolderBound


/- Local C1 regularity on a compact set supplies one bounded Holder
norm on that set. The pinned compact-thickening theorem combines local
Lipschitz neighborhoods, without requiring a convex compact set. -/
open Set Metric Filter TauCeti
open scoped NNReal ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem exists_holderBound_of_contDiffAt_isCompact {C : Set E} (hC : IsCompact C) {f : E → F}
    (hf : ∀ x ∈ C, ContDiffAt ℝ 1 f x) {α : ℝ≥0} (hα : α ≤ 1) :
    ∃ K : ℝ≥0, holderBound α C f K := by
  obtain ⟨δ, hδ, L, M, hL, hM⟩ := hC.exists_holderOnWith_thickening_and_norm_le (α := 1) (f := f) (by
    intro x hx
    obtain ⟨A, t, ht, hA⟩ := (hf x hx).exists_lipschitzOnWith
    obtain ⟨r, hr, hrt⟩ := Metric.mem_nhds_iff.1 ht
    exact ⟨r, hr, A, (hA.mono hrt).holderOnWith⟩)
  have hsub : C ⊆ thickening δ C := self_subset_thickening hδ C
  have hb : ∀ x ∈ C, ‖f x‖ ≤ M := fun x hx => hM x (hsub hx)
  have hh := ((holderOnWith_one.1 hL).mono hsub).holderOnWith_of_norm_le hb hα
  have hMM : M ≤ L + 2 * M := by
    calc
      M ≤ 2 * M := le_mul_of_one_le_left (by positivity) (by norm_num)
      _ ≤ L + 2 * M := le_add_of_nonneg_left (by positivity)
  exact ⟨L + 2 * M, (fun x hx => (hb x hx).trans (by exact_mod_cast hMM)), hh⟩
end ConformalPoisson

end ProofPart_CompactLocalHolderBound

/- Proof support: SphereForcingHolder.lean, SHA256 0d08b196269176a81b98c22b2916398bb889ec6cc01ae8670292efe46e73fb27 -/
noncomputable section ProofPart_SphereForcingHolder



/- The actual transformed forcing has a bounded Holder norm on
every compact closed half-ball. The original forcing is read from its
canonical closed-ball Holder space, and the sphere chart maps the
whole closed half-space into that closed ball. -/
open Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace EuclideanGeometry
open scoped NNReal ContDiff Gradient Laplacian InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.SphereFlattening
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e₀" => (EuclideanSpace.single (0 : Fin (n + 1)) (1 : ℝ))

def transformedForcing (f : HolderSpace α (closedBall (0 : V) 1) ℝ) : V → ℝ :=
  fun y => 4 * ‖y + e₀‖ ^ (-((n : ℝ) + 1) - 2) *
    DirichletHolder.domainRead (closedBall 0 1) f (chartMap n y)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_holderBound_transformedForcing_closedCap (hα : α ≤ 1)
    (f : HolderSpace α (closedBall (0 : V) 1) ℝ) (z : V) (r : ℝ) :
    ∃ K : ℝ≥0, holderBound α (closedBall z r ∩ {y : V | 0 ≤ y 0}) (transformedForcing f) K := by
  let C := closedBall z r ∩ {y : V | 0 ≤ y 0}
  have h0 : Continuous (fun y : V => y 0) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous
  have hC : IsCompact C := (isCompact_closedBall z r).inter_right (isClosed_le continuous_const h0)
  obtain ⟨L, hL⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (f := chartMap n) (fun y hy => EuclideanGeometry.contDiffAt_inversion (ne_neg_single_of_nonneg hy.2))
    (α := 1) le_rfl
  have hmap : MapsTo (chartMap n) C (closedBall (0 : V) 1) := fun y hy => chartMap_mem_closedBall hy.2
  have hcomp : HolderOnWith (‖f‖₊ * L ^ (α : ℝ)) α
      (fun y => DirichletHolder.domainRead (closedBall 0 1) f (chartMap n y)) C := by
    simpa only [mul_one, Function.comp_def] using
      (DirichletHolder.holderOnWith_domainRead_closedBall f).comp hL.2 hmap
  let N : ℝ≥0 := ‖f‖₊ + ‖f‖₊ * L ^ (α : ℝ)
  have hbcomp : holderBound α C
      (fun y => DirichletHolder.domainRead (closedBall 0 1) f (chartMap n y)) N := by
    refine ⟨?_, hcomp.mono_const (le_add_of_nonneg_left (by positivity))⟩
    intro y hy
    change ‖DirichletHolder.domainRead (closedBall 0 1) f (chartMap n y)‖ ≤ (N : ℝ)
    rw [DirichletHolder.domainRead_of_mem _ _ (hmap hy)]
    exact (f.norm_apply_le _).trans (by dsimp only [N]; push_cast; exact le_add_of_nonneg_right (by positivity))
  let q : ℝ := -((n : ℝ) + 1) - 2
  obtain ⟨M, hM⟩ := exists_holderBound_of_contDiffAt_isCompact hC
    (f := fun y : V => ‖y + e₀‖ ^ q) (fun y hy => by
      simpa only [sub_neg_eq_add] using
        (contDiffAt_norm_sub_rpow (-e₀) q (k := 1) (ne_neg_single_of_nonneg hy.2))) hα
  have hp := hM.bilinear hbcomp (ContinuousLinearMap.mul ℝ ℝ)
  have hfour := hp.const_smul 4
  refine ⟨‖(4 : ℝ)‖₊ * (‖ContinuousLinearMap.mul ℝ ℝ‖₊ * (M * N + N * M)), ?_⟩
  change holderBound α C (fun y : V => 4 * ‖y + e₀‖ ^ q *
    DirichletHolder.domainRead (closedBall 0 1) f (chartMap n y)) _
  simpa only [smul_eq_mul, ContinuousLinearMap.mul_apply', mul_assoc] using hfour
end ConformalPoisson.SphereFlattening

end ProofPart_SphereForcingHolder

