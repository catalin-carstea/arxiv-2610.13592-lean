      (fun z => fderiv ℝ (fderiv ℝ (fun a => G a z)) x) s y :=
    hDD.comp y (contDiffWithinAt_const.prodMk contDiffWithinAt_id)
      (fun z hz => ⟨mem_univ _, hz⟩)
