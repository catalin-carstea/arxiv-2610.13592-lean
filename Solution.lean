  simp only [affinePrincipalCoefficient, boundaryReflection_linearEquiv_symm,
    zero_add, LinearIsometryEquiv.coe_toContinuousLinearEquiv]
  exact principalCongruence_boundaryReflection_normal_form _ hAn hA0

without_proof_info in
theorem affineDriftCoefficient_boundaryReflection (b : V → V) (x : V) :
    affineDriftCoefficient (boundaryReflection n).toContinuousLinearEquiv 0 b x =
      boundaryReflection n (b (boundaryReflection n x)) := by
