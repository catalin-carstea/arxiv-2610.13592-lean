  have hU : IsOpen U := (Ihalf).isOpen_interior (n := ω) (by decide)
  have hUy : U ⊆ ({(y : M)}ᶜ : Set M) := by
    intro x hx he
    have hxy : x = (y : M) := mem_singleton_iff.mp he
