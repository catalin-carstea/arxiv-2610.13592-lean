/- Assignment268, /root. Two extra finite profile orders only change the
truncated trace by O(h^(N+1)). No infinite asymptotic summation is needed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Finset
namespace ConformalPoisson.LocalDN

without_proof_info in
theorem finite_trace_two_order_tail (a : ℕ → ℂ) (N : ℕ) {h : ℝ} (hh : 0 < h) (hh1 : h ≤ 1) :
    ‖(∑ j ∈ range ((N + 2) + 1), (h : ℂ) ^ j * a j) -
        ∑ j ∈ range (N + 1), (h : ℂ) ^ j * a j‖ ≤
      (‖a (N + 1)‖ + ‖a (N + 2)‖) * h ^ (N + 1) := by
  have he : (∑ j ∈ range ((N + 2) + 1), (h : ℂ) ^ j * a j) -
      ∑ j ∈ range (N + 1), (h : ℂ) ^ j * a j =
      (h : ℂ) ^ (N + 1) * a (N + 1) + (h : ℂ) ^ (N + 2) * a (N + 2) := by
    rw [sum_range_succ, sum_range_succ]
    ring
  rw [he]
  calc
    _ ≤ ‖(h : ℂ) ^ (N + 1) * a (N + 1)‖ + ‖(h : ℂ) ^ (N + 2) * a (N + 2)‖ := norm_add_le _ _
    _ = h ^ (N + 1) * ‖a (N + 1)‖ + h ^ (N + 2) * ‖a (N + 2)‖ := by
      simp only [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hh]
    _ ≤ h ^ (N + 1) * ‖a (N + 1)‖ + h ^ (N + 1) * ‖a (N + 2)‖ := by
      exact add_le_add le_rfl (mul_le_mul_of_nonneg_right
        (pow_le_pow_of_le_one hh.le hh1 (by omega : N + 1 ≤ N + 2)) (norm_nonneg (a (N + 2))))
    _ = _ := by ring

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNFiniteTraceTail

