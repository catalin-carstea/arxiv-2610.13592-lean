variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem nativeGaugePairOfPartial_metric_of_ambient
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (E : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hs : E.source = (observedDomain (𝓡∂ (n + 1)) V₁ : Set M₁))
    (ht : E.target = (observedDomain (𝓡∂ (n + 1)) V₂ : Set M₂))
    (c : M₁ → ℝ)
    (hc : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω c (observedDomain (𝓡∂ (n + 1)) V₁))
    (hpos : ∀ x ∈ observedDomain (𝓡∂ (n + 1)) V₁, 0 < c x)
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (hmetric : ∀ y ∈ observedDomain (𝓡∂ (n + 1)) V₁,
      ∀ v w : TangentSpace (𝓡∂ (n + 1)) y,
      g₂.inner (E y) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E y v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E y w) =
      c y ^ conformalGaugeExponent n * g₁.inner y v w) :
    let P := nativeGaugePairOfPartial V₁ V₂ E hs ht c hc hpos
    ∀ x : observedDomain (𝓡∂ (n + 1)) V₁, ∀ v w : TangentSpace (𝓡∂ (n + 1)) x,
      g₂.inner (P.map x)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z => (P.map z : M₂)) x v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z => (P.map z : M₂)) x w) =
      Real.rpow (P.multiplier x) (4 / ((n + 1 : ℝ) - 2)) *
        g₁.inner x (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1))
          (Subtype.val : observedDomain (𝓡∂ (n + 1)) V₁ → M₁) x v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1))
          (Subtype.val : observedDomain (𝓡∂ (n + 1)) V₁ → M₁) x w) := by
  intro P x v w
  let U := observedDomain (𝓡∂ (n + 1)) V₁
  have hxE : (x : M₁) ∈ E.source := hs.symm ▸ x.property
  have hD : mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : U => E z) x =
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E (x : M₁)).comp
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (Subtype.val : U → M₁) x) :=
    mfderiv_comp x (E.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) hxE)
      ((contMDiff_subtype_val (I := 𝓡∂ (n + 1)) (n := ω)).mdifferentiable (by decide) x)
  change g₂.inner (E x) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : U => E z) x v)
    (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : U => E z) x w) =
    c x ^ conformalGaugeExponent n * g₁.inner x
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (Subtype.val : U → M₁) x v)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (Subtype.val : U → M₁) x w)
  rw [hD]
  exact hmetric x x.property _ _
end ConformalPoisson

end ProofPart_NativeGaugePairMetric

/- Proof support: NativeObservedSolutions.lean, SHA256 073f1872e53e2597903bd1219d0cbc97ba015958ba64fbfde5476faf99315a45 -/
noncomputable section ProofPart_NativeObservedSolutions




/- Actual boundary traces attach the SAME all-original-data relation
to the observed boundary; the multiplier is positive everywhere by its
explicit boundary value, with no unobserved analytic assertion. -/
open Set TauCeti
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}


without_proof_info in
theorem native_boundary_extension_solution_relation
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
 :
    ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ observedDomain (𝓡∂ (n + 1)) V₁,
      D.solver₁.solve f.val z = nativeBoundaryMultiplier (n := n) A.multiplier z *
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)
          (nativeBoundaryExtension D.boundaryIdentification A.map z) := by
  intro f z _
  rcases (𝓡∂ (n + 1)).isInteriorPoint_or_isBoundaryPoint z with hi | hb
  · rw [nativeBoundaryExtension_of_interior D.boundaryIdentification A.map hi,
      nativeBoundaryMultiplier_of_interior A.multiplier hi]
    exact A.solutions f z (by change z ∈ (A.domain : Set M₁); rw [hA]; exact hi)
  · let b : (𝓡∂ (n + 1)).boundary M₁ := ⟨z, hb⟩
    let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
      transportBoundaryDatum D.boundaryIdentification D.patches_match f
    change D.solver₁.solve f.val b = nativeBoundaryMultiplier (n := n) A.multiplier b *
      D.solver₂.solve f₂.val (nativeBoundaryExtension D.boundaryIdentification A.map b)
    rw [nativeBoundaryMultiplier_boundary, nativeBoundaryExtension_boundary, one_mul,
      (D.solver₁.correct f.val f.property.1).2.2 b,
      (D.solver₂.correct f₂.val f₂.property.1).2.2 (D.boundaryIdentification b)]
    change f.val b = f.val (D.boundaryIdentification.symm (D.boundaryIdentification b))
    rw [D.boundaryIdentification.symm_apply_apply]

without_proof_info in
theorem native_boundary_multiplier_positive
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
 : ∀ z : M₁, 0 < nativeBoundaryMultiplier (n := n) A.multiplier z := by
  intro z
  by_cases hi : z ∈ (𝓡∂ (n + 1)).interior M₁
  · rw [nativeBoundaryMultiplier_of_interior A.multiplier hi]
    exact A.positive z (by change z ∈ (A.domain : Set M₁); rw [hA]; exact hi)
  · simp only [nativeBoundaryMultiplier, if_neg hi]
    exact zero_lt_one
end ConformalPoisson

end ProofPart_NativeObservedSolutions

/- Proof support: NativeGaugePairRealization.lean, SHA256 5b5d40dc6f5bfb821d42ac445d60320e3ab601da1daf902a5549116e8dd31657 -/
noncomputable section ProofPart_NativeGaugePairRealization




/- Assemble ALL selected claims for ONE concrete shared GaugePair.
The final main caller must supply the produced observed metric and
normal identities, and the SAME normalized recovery witness. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}


set_option maxHeartbeats 1000000 in
without_proof_info in
theorem nativeGaugePair_realizes_of_normalized_recovery
    (hn : 2 ≤ n)
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun z : A.domain => A.map z))
    (hinv : ∀ z : A.domain, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun z : A.domain => A.map z) z).IsInvertible)
    (G : NativeGaugeRecovery (A₁.smoothMetric.restrictOpenTangentSpace A.domain)
      (nativePullbackMetric A₂.smoothMetric (fun z : A.domain => A.map z) hJ hinv)
      (fun z : A.domain => A₁.potential z) (fun z : A.domain => A₂.potential (A.map z))
      (fun z : A.domain => A.multiplier z))
    (hG : G.constant = 1)
    (E : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (hs : E.source = (observedDomain (𝓡∂ (n + 1)) V₁ : Set M₁))
    (ht : E.target = (observedDomain (𝓡∂ (n + 1)) V₂ : Set M₂))
    (hEmap : (E : M₁ → M₂) = nativeBoundaryExtension D.boundaryIdentification A.map)
    (hc : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω (nativeBoundaryMultiplier (n := n) A.multiplier)
      (observedDomain (𝓡∂ (n + 1)) V₁))
    (hpos : ∀ z ∈ observedDomain (𝓡∂ (n + 1)) V₁, 0 < nativeBoundaryMultiplier (n := n) A.multiplier z)
    (hNormal : ∀ b : (𝓡∂ (n + 1)).boundary M₁, (b : M₁) ∈ V₁ →
      normalDerivative D.normal₁ (nativeBoundaryMultiplier (n := n) A.multiplier) b = 0)
    (hMetric : ∀ z ∈ observedDomain (𝓡∂ (n + 1)) V₁, ∀ v w : TangentSpace (𝓡∂ (n + 1)) z,
      A₂.smoothMetric.inner (E z) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E z v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) E z w) =
      nativeBoundaryMultiplier (n := n) A.multiplier z ^ conformalGaugeExponent n * A₁.smoothMetric.inner z v w) :
    let P := nativeGaugePairOfPartial V₁ V₂ E hs ht (nativeBoundaryMultiplier (n := n) A.multiplier) hc hpos
    P.RealizesTheorem V₁ V₂ D.boundaryIdentification A₁.smoothMetric A₂.smoothMetric
      A₁.potential A₂.potential D.solver₁ D.solver₂ D.normal₁ := by
  intro P
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro b hb
    let z : observedDomain (𝓡∂ (n + 1)) V₁ := ⟨b, Or.inr hb⟩
    have hpoint : E (b : M₁) = (D.boundaryIdentification b : M₂) :=
      (congrFun hEmap b).trans (nativeBoundaryExtension_boundary D.boundaryIdentification A.map b)
    have hmul : P.multiplier z = 1 := nativeBoundaryMultiplier_boundary A.multiplier b
    have hgerm : extendFromOpen (observedDomain (𝓡∂ (n + 1)) V₁) P.multiplier =ᶠ[𝓝 (b : M₁)]
        nativeBoundaryMultiplier (n := n) A.multiplier :=
      extendFromOpen_eventuallyEq _ P.multiplier _ (fun _ => rfl) z
    exact ⟨hpoint, hmul,
      (normalDerivative_eq_of_eventuallyEq D.normal₁ b hgerm).trans (hNormal b hb)⟩
  · exact nativeGaugePairOfPartial_metric_of_ambient V₁ V₂ E hs ht
      (nativeBoundaryMultiplier (n := n) A.multiplier) hc hpos A₁.smoothMetric A₂.smoothMetric hMetric
  · exact nativeGaugePair_potential_of_normalized_recovery hn A₁ A₂ V₁ V₂ D A hA hJ hinv G hG
      E hs ht hEmap hc hpos
  · intro f x
    change D.solver₁.solve f.val x = nativeBoundaryMultiplier (n := n) A.multiplier x *
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (E x)
    have hp : E (x : M₁) = nativeBoundaryExtension D.boundaryIdentification A.map x := congrFun hEmap x
    rw [hp]
    exact native_boundary_extension_solution_relation A₁ A₂ V₁ V₂ D A hA f x x.property
end ConformalPoisson

end ProofPart_NativeGaugePairRealization

/- Proof support: NativeSeedAgreement.lean, SHA256 896f001e89ec40fa8f7ec13aefee64e24e84ee84e953ac1d3d98a2135b1aaf12 -/
noncomputable section ProofPart_NativeSeedAgreement



/- A global pair agrees with EVERY actual original local seed on its
whole open interior anchor. Containment alone is not witness equality. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

variable [T2Space M₁] [T2Space M₂]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem LocalGaugedSeed.agrees_global_candidate
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (R : LocalGaugedSeed P hn C) {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁) :
    ∀ z ∈ R.interiorDomain, A.map z = normalChartTransition C.chart₁ C.chart₂ z ∧
      A.multiplier z = R.multiplier z := by
  have hsep := D.separates_target_original_family hSchauder hRunge₂ hn hcompact₂ hconnected₂
  intro z hz
  have hzA : z ∈ A.domain := by
    change z ∈ (A.domain : Set M₁)
    rw [hA]
    exact hz.2
  have h := hsep ⟨A.map z, A.image hzA⟩
    ⟨normalChartTransition C.chart₁ C.chart₂ z, R.interiorCandidate.image hz⟩
    (A.multiplier z) (R.multiplier z) (A.positive z hzA).ne' (R.multiplier_positive z).ne'
    (fun f => (A.solutions f z hzA).symm.trans (R.original_solution_relation f z hz.1))
  exact ⟨congrArg Subtype.val h.1, h.2⟩
end ConformalPoisson

end ProofPart_NativeSeedAgreement

/- Proof support: NativeBoundarySeedAgreement.lean, SHA256 d21ab6ceb3794745394445262c8078af771098671cd7f105bfd61198f5964902 -/
noncomputable section ProofPart_NativeBoundarySeedAgreement



/- The boundary extension equals the actual local seed on its WHOLE
original open hood, including the observed face, for BOTH witnesses. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : (𝓡∂ (n + 1)).boundary M₁}
  {P : BoundaryGaugePair A₁ A₂ V₁ V₂ D x} {hn : 2 ≤ n} {C : P.CommonCharts}

variable [T2Space M₁] [T2Space M₂]

set_option maxHeartbeats 800000 in
without_proof_info in
theorem LocalGaugedSeed.agrees_boundary_extension
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (R : LocalGaugedSeed P hn C) {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    (hA : (A.domain : Set M₁) = (𝓡∂ (n + 1)).interior M₁) :
    ∀ z ∈ R.domain,
      nativeBoundaryExtension D.boundaryIdentification A.map z = normalChartTransition C.chart₁ C.chart₂ z ∧
      nativeBoundaryMultiplier (n := n) A.multiplier z = R.multiplier z := by
  have hagree := R.agrees_global_candidate hSchauder hRunge₂ hcompact₂ hconnected₂ A hA
  intro z hz
  rcases (𝓡∂ (n + 1)).isInteriorPoint_or_isBoundaryPoint z with hi | hb
  · rw [nativeBoundaryExtension_of_interior D.boundaryIdentification A.map hi,
      nativeBoundaryMultiplier_of_interior A.multiplier hi]
    exact hagree z ⟨hz, hi⟩
  · let b : (𝓡∂ (n + 1)).boundary M₁ := ⟨z, hb⟩
    have hmap : nativeBoundaryExtension D.boundaryIdentification A.map z =
        (D.boundaryIdentification b : M₂) := nativeBoundaryExtension_boundary D.boundaryIdentification A.map b
    have hc : nativeBoundaryMultiplier (n := n) A.multiplier z = 1 := nativeBoundaryMultiplier_boundary A.multiplier b
    exact ⟨hmap.trans (R.boundary b hz).symm, hc.trans (R.multiplier_boundary_one b hz).symm⟩
end ConformalPoisson

end ProofPart_NativeBoundarySeedAgreement

/- Proof support: NativeBoundarySeedRegularity.lean, SHA256 812b5654172903d73abd3f4c56d14bb8f221778fd116d269855c2dfd9dadf8eb -/
noncomputable section ProofPart_NativeBoundarySeedRegularity



/- Actual seed agreement gives boundary local diffeomorphism,
