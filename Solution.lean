noncomputable section ProofPart_GreenTrace_ContinuousColumnIntegral




/- A continuous Banach-valued column family on a compact cap closure
induces a bounded operator from the ACTUAL scalar L2 space by integration.
The canonical Holder pairing provides boundedness, without a new norm estimate.
Intended caller: native Green columns in the first local solution Hilbert space. -/
open Set MeasureTheory TopologicalSpace
open scoped ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E X : Type*} [TopologicalSpace E] [SecondCountableTopology E]
  [MeasurableSpace E] [BorelSpace E] {μ : Measure E} [μ.IsOpenPosMeasure] {Ω : Opens E}
  [CompactSpace (closure (Ω : Set E))] [IsFiniteMeasure (μ.restrict (Ω : Set E))]
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]

def continuousColumnIntegral (row : C(closure (Ω : Set E), X)) :
    Lp ℝ 2 (μ.restrict (Ω : Set E)) →L[ℝ] X :=
  ((ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] X →L[ℝ] X).lpPairing
    (μ.restrict (Ω : Set E)) 2 2).flip (continuousClosureToLp (μ := μ) (p := 2) row)

set_option maxHeartbeats 600000 in
without_proof_info in
theorem continuousColumnIntegral_eq_integral
    (row : C(closure (Ω : Set E), X)) (f : Lp ℝ 2 (μ.restrict (Ω : Set E)))
    (R : E → X) (hR : ∀ x (hx : x ∈ (Ω : Set E)), row ⟨x, subset_closure hx⟩ = R x) :
    continuousColumnIntegral (μ := μ) row f = ∫ x, f x • R x ∂μ.restrict (Ω : Set E) := by
  have hEq : continuousColumnIntegral (μ := μ) row f =
      ∫ x, f x • continuousClosureToLp (μ := μ) (p := 2) row x ∂μ.restrict (Ω : Set E) :=
    ContinuousLinearMap.lpPairing_eq_integral _ f _
  rw [hEq]
  apply integral_congr_ae
  filter_upwards [continuousClosureToLp_readback (μ := μ) (p := 2) row,
    ae_restrict_mem Ω.isOpen.measurableSet] with x hx hxΩ
  rw [hx hxΩ, hR x hxΩ]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem continuousColumnIntegral_integrable
    (row : C(closure (Ω : Set E), X)) (f : Lp ℝ 2 (μ.restrict (Ω : Set E)))
    (R : E → X) (hR : ∀ x (hx : x ∈ (Ω : Set E)), row ⟨x, subset_closure hx⟩ = R x) :
    Integrable (fun x => f x • R x) (μ.restrict (Ω : Set E)) := by
  let L := continuousClosureToLp (μ := μ) (p := 2) row
  have hmem := (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] X →L[ℝ] X).memLp_of_bilin
    1 (Lp.memLp f) (Lp.memLp L)
  have hint : Integrable (fun x => f x • L x) (μ.restrict (Ω : Set E)) :=
    memLp_one_iff_integrable.mp hmem
  apply hint.congr
  filter_upwards [continuousClosureToLp_readback (μ := μ) (p := 2) row,
    ae_restrict_mem Ω.isOpen.measurableSet] with x hx hxΩ
  rw [show L x = R x from (hx hxΩ).trans (hR x hxΩ)]

set_option maxHeartbeats 600000 in
without_proof_info in
theorem continuousColumnIntegral_apply_functional
    (row : C(closure (Ω : Set E), X)) (f : Lp ℝ 2 (μ.restrict (Ω : Set E)))
    (R : E → X) (hR : ∀ x (hx : x ∈ (Ω : Set E)), row ⟨x, subset_closure hx⟩ = R x)
    (ell : X →L[ℝ] ℝ) :
    ell (continuousColumnIntegral (μ := μ) row f) =
      ∫ x, f x * ell (R x) ∂μ.restrict (Ω : Set E) := by
  rw [continuousColumnIntegral_eq_integral row f R hR]
  rw [← ell.integral_comp_comm (continuousColumnIntegral_integrable row f R hR)]
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (fun x => by simp only [map_smul, smul_eq_mul])

set_option maxHeartbeats 700000 in
without_proof_info in
theorem continuousColumnIntegral_apply_of_readback
    (row : C(closure (Ω : Set E), X)) (f : Lp ℝ 2 (μ.restrict (Ω : Set E)))
    (ell : X →L[ℝ] ℝ) (k : E → ℝ)
    (hrow : ∀ x (hx : x ∈ (Ω : Set E)), ell (row ⟨x, subset_closure hx⟩) = k x) :
    ell (continuousColumnIntegral (μ := μ) row f) = ∫ x, f x * k x ∂μ.restrict (Ω : Set E) := by
  let R : E → X := Function.extend ((↑) : closure (Ω : Set E) → E) row 0
  have hR : ∀ x (hx : x ∈ (Ω : Set E)), row ⟨x, subset_closure hx⟩ = R x :=
    fun x hx => (Subtype.coe_injective.extend_apply row 0 ⟨x, subset_closure hx⟩).symm
  rw [continuousColumnIntegral_apply_functional row f R hR ell]
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem Ω.isOpen.measurableSet] with x hx
  rw [← hR x hx, hrow x hx]

end ConformalPoisson

end ProofPart_GreenTrace_ContinuousColumnIntegral

/- Green/trace proof support: NativeGreenColumnIntegral.lean, SHA256 e7d4e57762d5287d17b110d675f43d1ddcd3eed9dae2e3e77f01debde6ed856d -/
noncomputable section ProofPart_GreenTrace_NativeGreenColumnIntegral



/- ONE bounded native Green column-integral operator is fixed before ALL
small-cap evaluations and L2 inputs. Its moment identity uses the SAME kernel,
actual symmetry, actual L2 row membership, and bounded-evaluation/Bochner
commutation. Intended caller: local Hilbert joint-smoothness factorization. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 1600000 in
without_proof_info in
theorem NativeClassicalValueKernel.exists_bounded_column_integral_moments
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p : ℝ≥0∞} [Fact (1 ≤ p)]
    {K : NativeInverseLpRowFamily g q p} (G : NativeClassicalValueKernel K)
    (hG : ContinuousOn (fun t : M × M => G.kernel t.1 t.2) {t | t.1 ≠ t.2})
    (hSym : ∀ x z, x ≠ z → G.kernel x z = G.kernel z x)
    (c d : M) {r s t : ℝ} (hsr : s ≤ r)
    (htarget : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    (U : Opens M) (hKU : nativeClosedChartCap (n := n) c r ⊆ U)
    (htargetZ : closedBall (extChartAt Ihalf d d) t ∩ range Ihalf ⊆ (extChartAt Ihalf d).target)
    (hZout : ∀ z ∈ nativeClosedChartCap (n := n) d t, z ∉ (U : Set M))
    (ev : V → nativeLocalL2SolutionSpace (g := g) (q := q) htarget →L[ℝ] ℝ)
    (hev : ContinuousOn ev (closure (boundaryChartCap (I := Ihalf) c s : Set V)))
    (hevAE : ∀ u, (fun z => ev z u) =ᵐ[(Module.finBasis ℝ V).addHaar.restrict
      (boundaryChartCap (I := Ihalf) c s : Set V)]
      ((u : nativeLocalL2SolutionSpace (g := g) (q := q) htarget) :
        Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c r : Set V)))) :
    ∃ S : Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) d t : Set V)) →L[ℝ]
      nativeLocalL2SolutionSpace (g := g) (q := q) htarget,
      ∀ a ∈ closure (boundaryChartCap (I := Ihalf) c s : Set V), ∀ f,
        ev a (S f) = ∫ z, f z * G.kernel ((extChartAt Ihalf c).symm a)
          ((extChartAt Ihalf d).symm z) ∂(Module.finBasis ℝ V).addHaar.restrict
            (boundaryChartCap (I := Ihalf) d t : Set V) := by
  let X := nativeLocalL2SolutionSpace (g := g) (q := q) htarget
  letI : CompleteSpace X := inferInstanceAs
    (CompleteSpace (LinearMap.range (nativeLocalSmoothToL2 (g := g) (q := q) htarget)).topologicalClosure)
  let D := boundaryChartCap (I := Ihalf) d t
  have hchartZ : closure (D : Set V) ⊆ (extChartAt Ihalf d).target :=
    (closure_boundaryChartCap_subset (I := Ihalf) d t).trans htargetZ
  let pole : C(closure (D : Set V), M) :=
    ⟨fun z => (extChartAt Ihalf d).symm z,
      continuousOn_iff_continuous_restrict.mp ((continuousOn_extChartAt_symm d).mono hchartZ)⟩
  have hPole : ∀ z : closure (D : Set V), pole z ∉ (U : Set M) :=
    fun z => hZout _ ⟨z, closure_boundaryChartCap_subset (I := Ihalf) d t z.property, rfl⟩
  obtain ⟨R, hR⟩ := G.exists_continuous_localL2_rows hG c htarget U hKU pole hPole
  let S := continuousColumnIntegral (μ := (Module.finBasis ℝ V).addHaar) R
  refine ⟨S, fun a ha f => ?_⟩
  apply continuousColumnIntegral_apply_of_readback R f (ev a)
  intro z hz
  let zK : closure (D : Set V) := ⟨z, subset_closure hz⟩
  obtain ⟨w, hw, hread⟩ := G.exists_row_evaluation_readback c hsr htarget U hKU ev hev hevAE (pole zK) (hPole zK)
  have heq : R zK = w := by
    apply Subtype.ext
    exact Lp.ext ((hR zK).trans hw.symm)
  have haSmall := closure_boundaryChartCap_subset (I := Ihalf) c s ha
  have haLarge : a ∈ closedBall (extChartAt Ihalf c c) r ∩ range Ihalf :=
    ⟨closedBall_subset_closedBall hsr haSmall.1, haSmall.2⟩
  have haU : (extChartAt Ihalf c).symm a ∈ (U : Set M) := hKU ⟨a, haLarge, rfl⟩
  have hneq : pole zK ≠ (extChartAt Ihalf c).symm a := fun h => hPole zK (h.symm ▸ haU)
  change ev a (R zK) = G.kernel ((extChartAt Ihalf c).symm a) (pole zK)
  rw [heq, hread a ha]
  exact hSym _ _ hneq

end ConformalPoisson

end ProofPart_GreenTrace_NativeGreenColumnIntegral

/- Green/trace proof support: HilbertKernelFactorization.lean, SHA256 956d1ef240cc07ccb5e2d9ba9a7a8ab8437422fc853e2353d968963e03d3eb61 -/
noncomputable section ProofPart_GreenTrace_HilbertKernelFactorization




/- Local Hilbert factorization of a kernel through smooth evaluations.
The operator/moment hypothesis is EXPLICITLY OPEN for the native caller;
it will come from the actual continuous column family and its L2 integral.
The same row and kernel are identified by the real Hilbert Riesz theorem. -/
open Set InnerProductSpace
open scoped ContDiff InnerProductSpace
namespace ConformalPoisson
variable {X Y E F : Type*}
  [NormedAddCommGroup X] [InnerProductSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Y] [InnerProductSpace ℝ Y] [CompleteSpace Y]
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

set_option maxHeartbeats 500000 in
without_proof_info in
theorem hilbert_row_eq_adjoint_riesz
    (S : Y →L[ℝ] X) (ev : X →L[ℝ] ℝ) (row : Y)
    (hmoment : ∀ h : Y, ⟪row, h⟫_ℝ = ev (S h)) :
    row = S.adjoint ((InnerProductSpace.toDual ℝ X).symm ev) := by
  apply ext_inner_right ℝ
  intro h
  rw [S.adjoint_inner_left, InnerProductSpace.toDual_symm_apply]
  exact hmoment h

set_option maxHeartbeats 800000 in
without_proof_info in
theorem contDiffOn_kernel_of_hilbert_moments
    {A : Set E} {B : Set F} (S : Y →L[ℝ] X)
    (evX : E → X →L[ℝ] ℝ) (evY : F → Y →L[ℝ] ℝ)
    (hX : ContDiffOn ℝ ∞ evX A) (hY : ContDiffOn ℝ ∞ evY B)
    (row : E → Y) (kernel : E → F → ℝ)
    (hmoment : ∀ x ∈ A, ∀ h : Y, ⟪row x, h⟫_ℝ = evX x (S h))
    (hkernel : ∀ x ∈ A, ∀ z ∈ B, kernel x z = evY z (row x)) :
    ContDiffOn ℝ ∞ (fun p : E × F => kernel p.1 p.2) (A ×ˢ B) := by
  let R : (X →L[ℝ] ℝ) →L[ℝ] X :=
    (InnerProductSpace.toDual ℝ X).symm.toLinearIsometry.toContinuousLinearMap
  have hR : ∀ ev, R ev = (InnerProductSpace.toDual ℝ X).symm ev := fun _ => rfl
  have hXF : ContDiffOn ℝ ∞ (fun p : E × F => evX p.1) (A ×ˢ B) :=
    hX.comp contDiffOn_fst (fun _ hp => hp.1)
  have hYF : ContDiffOn ℝ ∞ (fun p : E × F => evY p.2) (A ×ˢ B) :=
    hY.comp contDiffOn_snd (fun _ hp => hp.2)
  have hrow : ContDiffOn ℝ ∞ (fun p : E × F => S.adjoint (R (evX p.1))) (A ×ˢ B) :=
    S.adjoint.contDiff.comp_contDiffOn (R.contDiff.comp_contDiffOn hXF)
  refine (hYF.clm_apply hrow).congr ?_
  intro p hp
  rw [hR]
  rw [← hilbert_row_eq_adjoint_riesz S (evX p.1) (row p.1) (hmoment p.1 hp.1)]
  exact hkernel p.1 hp.1 p.2 hp.2

end ConformalPoisson

end ProofPart_GreenTrace_HilbertKernelFactorization

/- Green/trace proof support: NativeGreenJointChartSmooth.lean, SHA256 dfe408029787dfb7a1fa54427adb300c507c993bb9463731da934d1cc1d98797 -/
noncomputable section ProofPart_GreenTrace_NativeGreenJointChartSmooth



/- Joint C-infinity of the SAME Green kernel on a product of closed
native coordinate caps, including BOTH physical faces. The smooth evaluation
families are supplied by NativeLocalL2SmoothEvaluation; the actual bounded
column operator and its moments are proved, not replacement kernel premises. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module InnerProductSpace
open scoped Manifold ContDiff ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 2200000 in
without_proof_info in
theorem NativeClassicalValueKernel.contDiffOn_chart_product_of_smooth_evaluations
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {p : ℝ≥0∞} [Fact (1 ≤ p)]
    {K : NativeInverseLpRowFamily g q p} (G : NativeClassicalValueKernel K)
    (hG : ContinuousOn (fun t : M × M => G.kernel t.1 t.2) {t | t.1 ≠ t.2})
    (hSym : ∀ x z, x ≠ z → G.kernel x z = G.kernel z x)
    (c d : M) {r s t v : ℝ} (hsr : s ≤ r) (hvt : v ≤ t)
    (htargetX : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target)
    (htargetZ : closedBall (extChartAt Ihalf d d) t ∩ range Ihalf ⊆ (extChartAt Ihalf d).target)
    (U W : Opens M) (hUW : Disjoint (U : Set M) (W : Set M))
    (hKX : nativeClosedChartCap (n := n) c r ⊆ U) (hKZ : nativeClosedChartCap (n := n) d t ⊆ W)
    (evX : V → nativeLocalL2SolutionSpace (g := g) (q := q) htargetX →L[ℝ] ℝ)
    (evZ : V → nativeLocalL2SolutionSpace (g := g) (q := q) htargetZ →L[ℝ] ℝ)
    (hevX : ContDiffOn ℝ ∞ evX (closure (boundaryChartCap (I := Ihalf) c s : Set V)))
    (hevZ : ContDiffOn ℝ ∞ evZ (closure (boundaryChartCap (I := Ihalf) d v : Set V)))
    (hXAE : ∀ u, (fun z => evX z u) =ᵐ[(Module.finBasis ℝ V).addHaar.restrict
      (boundaryChartCap (I := Ihalf) c s : Set V)]
      ((u : nativeLocalL2SolutionSpace (g := g) (q := q) htargetX) :
        Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) c r : Set V))))
    (hZAE : ∀ u, (fun z => evZ z u) =ᵐ[(Module.finBasis ℝ V).addHaar.restrict
      (boundaryChartCap (I := Ihalf) d v : Set V)]
      ((u : nativeLocalL2SolutionSpace (g := g) (q := q) htargetZ) :
        Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) d t : Set V)))) :
    ContDiffOn ℝ ∞
      (fun a : V × V => G.kernel ((extChartAt Ihalf c).symm a.1) ((extChartAt Ihalf d).symm a.2))
      ((closure (boundaryChartCap (I := Ihalf) c s : Set V)) ×ˢ
        (closure (boundaryChartCap (I := Ihalf) d v : Set V))) := by
  classical
  let X := nativeLocalL2SolutionSpace (g := g) (q := q) htargetX
  let Y := nativeLocalL2SolutionSpace (g := g) (q := q) htargetZ
  letI : CompleteSpace X := inferInstanceAs
    (CompleteSpace (LinearMap.range (nativeLocalSmoothToL2 (g := g) (q := q) htargetX)).topologicalClosure)
  letI : CompleteSpace Y := inferInstanceAs
    (CompleteSpace (LinearMap.range (nativeLocalSmoothToL2 (g := g) (q := q) htargetZ)).topologicalClosure)
  let A := closure (boundaryChartCap (I := Ihalf) c s : Set V)
  let B := closure (boundaryChartCap (I := Ihalf) d v : Set V)
  have hZout : ∀ z ∈ nativeClosedChartCap (n := n) d t, z ∉ (U : Set M) :=
    fun z hz hzu => Set.disjoint_left.mp hUW hzu (hKZ hz)
  obtain ⟨S₀, hS₀⟩ := G.exists_bounded_column_integral_moments hG hSym c d hsr
    htargetX U hKX htargetZ hZout evX hevX.continuousOn hXAE
  let S : Y →L[ℝ] X := S₀.comp Y.subtypeL
  have hXout : ∀ a : A, (extChartAt Ihalf c).symm a ∉ (W : Set M) := by
    intro a haw
    have haSmall := closure_boundaryChartCap_subset (I := Ihalf) c s a.property
    have haU := hKX ⟨a, ⟨closedBall_subset_closedBall hsr haSmall.1, haSmall.2⟩, rfl⟩
    exact Set.disjoint_left.mp hUW haU haw
  choose row hrowAE hrowEval using fun a : A =>
    G.exists_row_evaluation_readback d hvt htargetZ W hKZ evZ hevZ.continuousOn hZAE
      ((extChartAt Ihalf c).symm a) (hXout a)
  let rows : V → Y := Function.extend ((↑) : A → V) row 0
  have hrows : ∀ a (ha : a ∈ A), rows a = row ⟨a, ha⟩ :=
    fun a ha => Subtype.coe_injective.extend_apply row 0 ⟨a, ha⟩
  apply contDiffOn_kernel_of_hilbert_moments S evX evZ hevX hevZ rows
    (fun a z => G.kernel ((extChartAt Ihalf c).symm a) ((extChartAt Ihalf d).symm z))
  · intro a ha h
    have hS : evX a (S h) = ∫ z,
        (h : Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) d t : Set V))) z *
          G.kernel ((extChartAt Ihalf c).symm a) ((extChartAt Ihalf d).symm z)
          ∂(Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) d t : Set V) :=
      hS₀ a ha (h : Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict (boundaryChartCap (I := Ihalf) d t : Set V)))
    rw [hrows a ha]
    refine Eq.trans ?_ hS.symm
    change ⟪(row ⟨a, ha⟩ : Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict
      (boundaryChartCap (I := Ihalf) d t : Set V))),
      (h : Lp ℝ 2 ((Module.finBasis ℝ V).addHaar.restrict
        (boundaryChartCap (I := Ihalf) d t : Set V)))⟫_ℝ = _
    rw [L2.inner_def]
    apply integral_congr_ae
    filter_upwards [hrowAE ⟨a, ha⟩] with z hz
    rw [Real.inner_apply, hz, mul_comm]
  · intro a ha z hz
    rw [hrows a ha]
    exact (hrowEval ⟨a, ha⟩ z hz).symm

end ConformalPoisson

end ProofPart_GreenTrace_NativeGreenJointChartSmooth

/- Green/trace proof support: NativeGreenJointClosedCaps.lean, SHA256 9d4f914186c5f6ecf9bf7b54bbd1c15dde5a3cb300913c9e0063f5e76c63b38c -/
noncomputable section ProofPart_GreenTrace_NativeGreenJointClosedCaps


/- Actual joint boundary-coordinate regularity for the SAME native Green
kernel near EVERY off-diagonal pair, including two physical boundary points.
All Hilbert spaces, smooth evaluations and moment operators are now supplied
from their proved native producers under the ORIGINAL hypotheses. -/
open Set Metric MeasureTheory TauCeti TopologicalSpace Module
open scoped Manifold ContDiff ENNReal NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option synthInstance.maxHeartbeats 100000 in
set_option maxHeartbeats 1700000 in
without_proof_info in
theorem NativeClassicalValueKernel.exists_joint_smooth_closed_chart_caps
    {g : Metric (n := n) (M := M)} {q : M → ℝ}
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    {a : ℝ≥0} (ha : 1 < a) [Fact (1 ≤ (a : ℝ≥0∞))]
    {p : ℝ≥0∞} [Fact (1 ≤ p)] [(a : ℝ≥0∞).HolderConjugate p] (hp : p ≠ ⊤)
    {K : NativeInverseLpRowFamily g q (a : ℝ≥0∞)} (G : NativeClassicalValueKernel K)
    (c d : M) (hcd : c ≠ d) :
    ∃ r > 0, ∃ t > 0,
      (closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      (closedBall (extChartAt Ihalf d d) t ∩ range Ihalf ⊆ (extChartAt Ihalf d).target) ∧
      ContDiffOn ℝ ∞
        (fun z : V × V => G.kernel ((extChartAt Ihalf c).symm z.1) ((extChartAt Ihalf d).symm z.2))
        ((closure (boundaryChartCap (I := Ihalf) c (r / 16) : Set V)) ×ˢ
          (closure (boundaryChartCap (I := Ihalf) d (t / 16) : Set V))) := by
  obtain ⟨Uset, Wset, hUopen, hWopen, hcU, hdW, hUW⟩ := t2_separation hcd
  let U : Opens M := ⟨Uset, hUopen⟩
  let W : Opens M := ⟨Wset, hWopen⟩
  obtain ⟨rMax, hMax, _, hKMax⟩ := exists_native_closed_chart_cap_within (n := n) c U hcU
  obtain ⟨tMax, htMax, _, hLMax⟩ := exists_native_closed_chart_cap_within (n := n) d W hdW
  obtain ⟨r, hr, hrMax, htargetX, evX, hevX, hXAE⟩ :=
    exists_native_localL2_smooth_evaluation_below g q hq c rMax hMax
  obtain ⟨t, ht, htMax', htargetZ, evZ, hevZ, hZAE⟩ :=
