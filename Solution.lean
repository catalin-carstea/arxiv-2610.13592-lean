noncomputable section ProofPart_GreenTrace_NativeSplitErrorAbsorption





/- The actual nonresonant native inverse removes local lower-order errors.
One compatible radius is fixed BEFORE the absorption parameter and all data. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti Module
open scoped Manifold ContDiff Topology Gradient ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
  {r : ℝ≥0} [Fact (1 ≤ (r : ℝ≥0∞))]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_native_split_error_absorption
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (hp : 2 < (r : ℝ≥0∞)) (c : M) :
    ∃ R₀ > 0, ∃ A ≥ 0,
      (closedBall (extChartAt Ihalf c c) R₀ ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) ∧
      (∀ R, R ≤ R₀ → ∀ F : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F →
        lpNorm (fun t : P => F ((extChartAt Ihalf c).symm (euclideanNormalSplit n t)))
          (r : ℝ≥0∞) (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤
            A * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal) ∧
      ∀ ε : ℝ, 0 < ε → ∃ D ≥ 0, ∀ R, R ≤ R₀ →
        ∀ F u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) ∞ F → ∀ hu : IsZeroDirichletSolution g q F u,
          lpNorm (∇ (fun t : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))))
              (r : ℝ≥0∞) (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) +
            lpNorm (fun t : P => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t)))
              (r : ℝ≥0∞) (volume.restrict (splitBoundaryChartCap (n := n) c R : Set P)) ≤
            ε * ‖nativeC1Function g u (hu.1.of_le (by simp))‖ +
              D * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal := by
  have hr2 : (2 : ℝ≥0) < r := by exact_mod_cast hp
  have hr0 : 0 < r := lt_trans (by norm_num) hr2
  obtain ⟨R, hR, G, hG, A, hA, htarget, hsup, hforcing⟩ := exists_native_split_reading_bounds g c hr0
  obtain ⟨ρ, hρ, D₂, hD₂, htargetρ, hl2⟩ := native_zero_dirichlet_split_chart_l2_bounds g q hq hNR c
  let R₀ := min R ρ
  have hR₀ : 0 < R₀ := lt_min hR hρ
  have htargetSmall {s : ℝ} (hs : s ≤ R₀) :
      closedBall (extChartAt Ihalf c c) s ∩ range Ihalf ⊆ (extChartAt Ihalf c).target :=
    fun z hz => htarget ⟨closedBall_subset_closedBall (hs.trans (min_le_left _ _)) hz.1, hz.2⟩
  let : IsFiniteMeasure (nativeVolume g) := nativeVolume_isFiniteMeasure g
  obtain ⟨CF, hCF, hF2⟩ := exists_l2_lpNorm_bound (μ := nativeVolume g) (E := ℝ) hp (by finiteness)
  refine ⟨R₀, hR₀, A, hA, htargetSmall le_rfl, ?_, ?_⟩
  · intro s hs F hF
    have hm := (split_boundary_chart_value_gradient_memLp (p := (r : ℝ≥0∞)) c htarget hF).1
    exact (lpNorm_restrict_le_of_subset
      (splitBoundaryChartCap_mono c (hs.trans (min_le_left _ _))) hm).trans (hforcing F hF)
  · intro ε hε
    let δ := ε / (1 + G)
    have hden : 0 < 1 + G := by linarith
    have hδ : 0 < δ := div_pos hε hden
    have hδeq : δ * (1 + G) = ε := by
      dsimp only [δ]
      exact div_mul_cancel₀ ε (ne_of_gt hden)
    obtain ⟨CV, hCV, hval⟩ := exists_lpNorm_le_epsilon_linfty_add_l2_uniform (α := P) (E := ℝ) hp (by finiteness) hδ
    obtain ⟨CG, hCG, hgrad⟩ := exists_lpNorm_le_epsilon_linfty_add_l2_uniform (α := P) (E := P) hp (by finiteness) hδ
    let C := max CV CG
    have hC : 0 ≤ C := hCV.trans (le_max_left _ _)
    refine ⟨C * D₂ * CF, mul_nonneg (mul_nonneg hC hD₂) hCF, fun s hs F u hF hu => ?_⟩
    let w : P → ℝ := fun t => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))
    let μ : Measure P := volume.restrict (splitBoundaryChartCap (n := n) c s : Set P)
    let S := ‖nativeC1Function g u (hu.1.of_le (by simp))‖
    have hS : 0 ≤ S := norm_nonneg _
    obtain ⟨hv2, hg2⟩ := split_boundary_chart_value_gradient_memLp (p := 2) c (htargetSmall hs) hu.1
    obtain ⟨hvt, hgt⟩ := split_boundary_chart_value_gradient_memLp (p := ⊤) c (htargetSmall hs) hu.1
    have hvBound : ∀ᵐ z ∂μ, ‖w z‖ ≤ S := by
      filter_upwards [ae_restrict_mem (splitBoundaryChartCap (n := n) c s).isOpen.measurableSet] with z hz
      simpa only [Real.norm_eq_abs] using
        (hsup u (hu.1.of_le (by simp)) z
          (splitBoundaryChartCap_mono c (hs.trans (min_le_left _ _)) hz)).1
    have hgBound : ∀ᵐ z ∂μ, ‖∇ w z‖ ≤ G * S := by
      filter_upwards [ae_restrict_mem (splitBoundaryChartCap (n := n) c s).isOpen.measurableSet] with z hz
      exact (hsup u (hu.1.of_le (by simp)) z
        (splitBoundaryChartCap_mono c (hs.trans (min_le_left _ _)) hz)).2
    have hvTop := memLp_top_and_lpNorm_le_of_ae_bound hvt.aestronglyMeasurable hS hvBound
    have hgTop := memLp_top_and_lpNorm_le_of_ae_bound hgt.aestronglyMeasurable (mul_nonneg hG hS) hgBound
    have hvLp : lpNorm w (r : ℝ≥0∞) μ ≤ δ * S + CV * lpNorm w 2 μ :=
      (hval μ w hv2 hvTop.1).trans
        (add_le_add (mul_le_mul_of_nonneg_left hvTop.2 hδ.le) (le_refl _))
    have hgLp : lpNorm (∇ w) (r : ℝ≥0∞) μ ≤ δ * (G * S) + CG * lpNorm (∇ w) 2 μ :=
      (hgrad μ (∇ w) hg2 hgTop.1).trans
        (add_le_add (mul_le_mul_of_nonneg_left hgTop.2 hδ.le) (le_refl _))
    obtain ⟨hvρ, hgρ⟩ := split_boundary_chart_value_gradient_memLp (p := 2) c htargetρ hu.1
    have hvMono := lpNorm_restrict_le_of_subset
      (splitBoundaryChartCap_mono c (hs.trans (min_le_right _ _))) hvρ
    have hgMono := lpNorm_restrict_le_of_subset
      (splitBoundaryChartCap_mono c (hs.trans (min_le_right _ _))) hgρ
    have hlow : lpNorm (∇ w) 2 μ + lpNorm w 2 μ ≤ D₂ * (eLpNorm F 2 (nativeVolume g)).toReal := by
      calc
        lpNorm (∇ w) 2 μ + lpNorm w 2 μ ≤
            lpNorm (∇ w) 2 (volume.restrict (splitBoundaryChartCap (n := n) c ρ : Set P)) +
              lpNorm w 2 (volume.restrict (splitBoundaryChartCap (n := n) c ρ : Set P)) :=
          add_le_add hgMono hvMono
        _ = _ := add_comm _ _
        _ ≤ _ := hl2 F u hF hu
    have hforce := hF2 F (contMDiff_memLp_nativeVolume g F hF (r : ℝ≥0∞))
    have hweighted : CG * lpNorm (∇ w) 2 μ + CV * lpNorm w 2 μ ≤
        C * D₂ * CF * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal := by
      calc
        CG * lpNorm (∇ w) 2 μ + CV * lpNorm w 2 μ ≤
            C * lpNorm (∇ w) 2 μ + C * lpNorm w 2 μ :=
          add_le_add (mul_le_mul_of_nonneg_right (le_max_right _ _) lpNorm_nonneg)
            (mul_le_mul_of_nonneg_right (le_max_left _ _) lpNorm_nonneg)
        _ = C * (lpNorm (∇ w) 2 μ + lpNorm w 2 μ) := by ring
        _ ≤ C * (D₂ * (eLpNorm F 2 (nativeVolume g)).toReal) := mul_le_mul_of_nonneg_left hlow hC
        _ = (C * D₂) * (eLpNorm F 2 (nativeVolume g)).toReal := by ring
        _ ≤ (C * D₂) * (CF * lpNorm F (r : ℝ≥0∞) (nativeVolume g)) :=
          mul_le_mul_of_nonneg_left hforce (mul_nonneg hC hD₂)
        _ = _ := by
          change (C * D₂) * (CF * (eLpNorm F (r : ℝ≥0∞) (nativeVolume g)).toReal) = _
          ring
    calc
      lpNorm (∇ w) (r : ℝ≥0∞) μ + lpNorm w (r : ℝ≥0∞) μ ≤
          (δ * (G * S) + CG * lpNorm (∇ w) 2 μ) +
            (δ * S + CV * lpNorm w 2 μ) := add_le_add hgLp hvLp
      _ = (δ * (1 + G)) * S + (CG * lpNorm (∇ w) 2 μ + CV * lpNorm w 2 μ) := by ring
      _ = ε * S + (CG * lpNorm (∇ w) 2 μ + CV * lpNorm w 2 μ) := by rw [hδeq]
      _ ≤ _ := add_le_add (le_refl _) hweighted

end ConformalPoisson

end ProofPart_GreenTrace_NativeSplitErrorAbsorption

/- Green/trace proof support: NativeBoundaryPrincipalBounds.lean, SHA256 470e0ca2bc78bc6d36237a4145666539ecc0c91772859648c31afc744147986c -/
noncomputable section ProofPart_GreenTrace_NativeBoundaryPrincipalBounds




/- Coefficient localization from the same native metric. All constants
and the chart radius are chosen before any forcing or solution. -/
open Bundle Set Metric Filter TauCeti
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
without_proof_info in
/-- A relative neighborhood and within-continuity supply one closed cap
with a prescribed oscillation. This is independent of manifold coordinates. -/
theorem exists_closed_relative_ball_oscillation
    {E F : Type*} [MetricSpace E] [PseudoMetricSpace F]
    {S T : Set E} {x : E} {A : E → F}
    (hT : T ∈ 𝓝[S] x) (hA : ContinuousWithinAt A T x) {ε : ℝ} (hε : 0 < ε) :
    ∃ R > 0, closedBall x R ∩ S ⊆ T ∧
      ∀ z ∈ closedBall x R ∩ S, dist (A z) (A x) ≤ ε := by
  obtain ⟨r₁, hr₁, hosc⟩ := Metric.continuousWithinAt_iff.mp hA ε hε
  obtain ⟨r₂, hr₂, htarget⟩ := Metric.mem_nhdsWithin_iff.mp hT
  let R := min r₁ r₂ / 2
  have hR : 0 < R := by dsimp [R]; positivity
  have hR₁ : R < r₁ := by dsimp [R]; linarith [min_le_left r₁ r₂, lt_min hr₁ hr₂]
  have hR₂ : R < r₂ := by dsimp [R]; linarith [min_le_right r₁ r₂, lt_min hr₁ hr₂]
  have hsub : closedBall x R ∩ S ⊆ T := fun z hz =>
    htarget ⟨mem_ball.mpr ((mem_closedBall.mp hz.1).trans_lt hR₂), hz.2⟩
  exact ⟨R, hR, hsub, fun z hz =>
    (hosc (hsub hz) ((mem_closedBall.mp hz.1).trans_lt hR₁)).le⟩

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem continuousOn_nativeChartPrincipal_target
    (g : Metric (n := n) (M := M)) (c : M) :
    ContinuousOn (nativeChartPrincipal g c) (extChartAt Ihalf c).target := by
  letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  letI : IsContMDiffRiemannianBundle Ihalf 1 V (fun x : M => TangentSpace Ihalf x) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  letI : ContMDiffVectorBundle 1 V (TangentSpace Ihalf : M → Type _) Ihalf :=
    TangentBundle.contMDiffVectorBundle
  exact continuousOn_chartPrincipal_target c

without_proof_info in
theorem nativeChartPrincipal_center_coercive
    (g : Metric (n := n) (M := M)) (c : M) :
    ∃ lam > 0, ∀ ξ : V, lam * ‖ξ‖ ^ 2 ≤
      ⟪nativeChartPrincipal g c (extChartAt Ihalf c c) ξ, ξ⟫_ℝ := by
  let A := nativeChartPrincipal g c (extChartAt Ihalf c c)
  let B : V →L[ℝ] V →L[ℝ] ℝ := (innerSL ℝ).comp A
  have hpos := (nativeChartPrincipal_symmetric_positive g c
    (mem_chart_source (EuclideanHalfSpace (n + 1)) c)).2
  obtain ⟨lam, hlam, hbound⟩ := (isCompact_singleton (x := ())).exists_pos_forall_mul_norm_sq_le
    (b := fun _ : Unit => B) continuousOn_const (fun _ _ ξ hξ => by
      simpa only [B, ContinuousLinearMap.comp_apply, innerSL_apply_apply, real_inner_comm]
        using hpos ξ hξ)
  exact ⟨lam, hlam, fun ξ => hbound () (mem_singleton ()) ξ⟩

set_option backward.isDefEq.respectTransparency true in
without_proof_info in
/-- A closed relative cap with the small oscillation required by the
Calderon-Zygmund estimate. The principal coefficient is the unweighted
inverse metric appearing in the native non-divergence operator. -/
theorem exists_native_boundary_principal_localization
    (g : Metric (n := n) (M := M)) (c : M) {δ : ℝ} (hδ : 0 < δ) :
    ∃ lam > 0, ∃ R > 0, ∃ Λ ≥ 0,
      (∀ ξ : V, lam * ‖ξ‖ ^ 2 ≤
        ⟪nativeChartPrincipal g c (extChartAt Ihalf c c) ξ, ξ⟫_ℝ) ∧
      closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target ∧
      ∀ z ∈ closedBall (extChartAt Ihalf c c) R ∩ range Ihalf,
        ‖nativeChartPrincipal g c z - nativeChartPrincipal g c (extChartAt Ihalf c c)‖ ≤ δ * lam ∧
        ‖nativeChartPrincipal g c z‖ ≤ Λ := by
  obtain ⟨lam, hlam, hcoercive⟩ := nativeChartPrincipal_center_coercive g c
  have hcenter : extChartAt Ihalf c c ∈ (extChartAt Ihalf c).target := (extChartAt Ihalf c).map_source (mem_extChartAt_source c)
  obtain ⟨R, hR, hsub, hosc⟩ := exists_closed_relative_ball_oscillation
    (extChartAt_target_mem_nhdsWithin (I := Ihalf) c)
    (continuousOn_nativeChartPrincipal_target g c _ hcenter) (mul_pos hδ hlam)
  refine ⟨lam, hlam, R, hR, ‖nativeChartPrincipal g c (extChartAt Ihalf c c)‖ + δ * lam,
    by positivity, hcoercive, hsub, ?_⟩
  intro z hz
  have he : ‖nativeChartPrincipal g c z - nativeChartPrincipal g c (extChartAt Ihalf c c)‖ ≤ δ * lam := by
    rw [← dist_eq_norm]
    exact hosc z hz
  refine ⟨he, ?_⟩
  have htri := norm_sub_norm_le (nativeChartPrincipal g c z)
    (nativeChartPrincipal g c (extChartAt Ihalf c c))
  linarith only [htri, he]

without_proof_info in
/-- The quantitative cap can be chosen below any prior positive chart radius. -/
theorem exists_native_boundary_principal_localization_below
    (g : Metric (n := n) (M := M)) (c : M) {δ : ℝ} (hδ : 0 < δ)
    (rMax : ℝ) (hMax : 0 < rMax) :
    ∃ lam > 0, ∃ R > 0, R ≤ rMax ∧ ∃ Λ ≥ 0,
      (∀ ξ : V, lam * ‖ξ‖ ^ 2 ≤
        ⟪nativeChartPrincipal g c (extChartAt Ihalf c c) ξ, ξ⟫_ℝ) ∧
      closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target ∧
      ∀ z ∈ closedBall (extChartAt Ihalf c c) R ∩ range Ihalf,
        ‖nativeChartPrincipal g c z - nativeChartPrincipal g c (extChartAt Ihalf c c)‖ ≤ δ * lam ∧
        ‖nativeChartPrincipal g c z‖ ≤ Λ := by
  obtain ⟨lam, hlam, R, hR, Λ, hΛ, hcoercive, htarget, hbounds⟩ :=
    exists_native_boundary_principal_localization g c hδ
  have hsub : closedBall (extChartAt Ihalf c c) (min R rMax) ∩ range Ihalf ⊆
      closedBall (extChartAt Ihalf c c) R ∩ range Ihalf := fun z hz =>
    ⟨closedBall_subset_closedBall (min_le_left _ _) hz.1, hz.2⟩
  exact ⟨lam, hlam, min R rMax, lt_min hR hMax, min_le_right _ _, Λ, hΛ,
    hcoercive, hsub.trans htarget, fun z hz => hbounds z (hsub hz)⟩

end ConformalPoisson

end ProofPart_GreenTrace_NativeBoundaryPrincipalBounds

/- Green/trace proof support: NativeGradientChartComparison.lean, SHA256 6afcb001d2e89f624bcfb791e2e147be9a26fe02da135b370de4a7afa0c98789 -/
noncomputable section ProofPart_GreenTrace_NativeGradientChartComparison




/- Reverse native/coordinate gradient comparison on the actual interior chart
cap. This follows from the SAME unweighted inverse metric coefficient and
native energy identity; no boundaryless theorem or ambient extension is used. -/
open Bundle Set Metric Riemannian.Tensor MeasureTheory TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem norm_native_gradient_le_coordinate_gradient
    (g : Metric (n := n) (M := M)) (c : M) {z : V}
    (hz : z ∈ interior (extChartAt Ihalf c).target) {Λ : ℝ} (hΛ0 : 0 ≤ Λ)
    (hΛ : ‖nativeChartPrincipal g c z‖ ≤ Λ) {u : M → ℝ}
    (hu : ContMDiff Ihalf 𝓘(ℝ) 1 u) :
    letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
    ‖mgradient Ihalf u ((extChartAt Ihalf c).symm z)‖ ≤
      (1 + Λ) * ‖∇ (u ∘ (extChartAt Ihalf c).symm) z‖ := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let x := (extChartAt Ihalf c).symm z
  let f : V → ℝ := u ∘ (extChartAt Ihalf c).symm
  have hround : extChartAt Ihalf c x = z := (extChartAt Ihalf c).right_inv (interior_subset hz)
  have hx : x ∈ (chartAt (EuclideanHalfSpace (n + 1)) c).source := by
    simpa only [extChartAt_source] using (extChartAt Ihalf c).map_target (interior_subset hz)
  have hxi : extChartAt Ihalf c x ∈ interior (extChartAt Ihalf c).target := by rw [hround]; exact hz
  have he := inner_mgradient_eq_chart_energy c hx hxi
    (hu.mdifferentiable one_ne_zero x) (hu.mdifferentiable one_ne_zero x)
  rw [hround, real_inner_self_eq_norm_sq] at he
  have hAeq : nativeChartPrincipal g c z =
      inverseMetricOperator (Module.finBasis ℝ V) (chartInvGramMatrix (I := Ihalf) c x) := by
    rfl
  rw [← hAeq] at he
  have henergy : ‖mgradient Ihalf u x‖ ^ 2 ≤ Λ * ‖∇ f z‖ ^ 2 := by
    calc
      ‖mgradient Ihalf u x‖ ^ 2 = ⟪∇ f z, nativeChartPrincipal g c z (∇ f z)⟫_ℝ := by
        rw [he, inner_gradient_left]
      _ ≤ |⟪∇ f z, nativeChartPrincipal g c z (∇ f z)⟫_ℝ| := le_abs_self _
      _ ≤ ‖∇ f z‖ * ‖nativeChartPrincipal g c z (∇ f z)‖ := abs_real_inner_le_norm _ _
      _ ≤ ‖∇ f z‖ * (Λ * ‖∇ f z‖) := by
        apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
        exact ((nativeChartPrincipal g c z).le_opNorm _).trans
          (mul_le_mul_of_nonneg_right hΛ (norm_nonneg _))
      _ = _ := by ring
  apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (by linarith : 0 ≤ 1 + Λ) (norm_nonneg _))).mp
  calc
    ‖mgradient Ihalf u x‖ ^ 2 ≤ Λ * ‖∇ f z‖ ^ 2 := henergy
    _ ≤ (1 + Λ) ^ 2 * ‖∇ f z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right (by nlinarith [sq_nonneg Λ]) (sq_nonneg _)
    _ = _ := by ring

without_proof_info in
theorem exists_native_gradient_chart_bound
    (g : Metric (n := n) (M := M)) (c : M) {R : ℝ}
    (htarget : closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) :
    ∃ K ≥ 0,
      letI : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
      ∀ u : M → ℝ, ContMDiff Ihalf 𝓘(ℝ) 1 u → ∀ z ∈ boundaryChartCap (I := Ihalf) c R,
        ‖mgradient Ihalf u ((extChartAt Ihalf c).symm z)‖ ≤
          K * ‖∇ (u ∘ (extChartAt Ihalf c).symm) z‖ := by
  have hcompact : IsCompact (closedBall (extChartAt Ihalf c c) R ∩ range Ihalf) :=
    (isCompact_closedBall _ _).inter_right (Ihalf).isClosed_range
  obtain ⟨Λ, hΛ⟩ := hcompact.exists_bound_of_continuousOn
    ((continuousOn_nativeChartPrincipal_target g c).mono htarget)
  refine ⟨1 + max Λ 0, by positivity, fun u hu z hz => ?_⟩
  apply norm_native_gradient_le_coordinate_gradient g c
    (boundaryChartCap_subset_interior_target c htarget hz) (le_max_right _ _)
  exact (hΛ z ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩).trans (le_max_left _ _)
  exact hu

end ConformalPoisson

end ProofPart_GreenTrace_NativeGradientChartComparison

/- Green/trace proof support: NativeInteriorDensity.lean, SHA256 006ff955a061295f91ea487e99554991dc9059e481b1d649a7fef0588e4eb6fc -/
noncomputable section ProofPart_GreenTrace_NativeInteriorDensity



/- The native interior is dense also at the physical boundary. This uses
positive native volume on nonempty opens and the proved boundary nullity. -/
open Bundle Set Filter MeasureTheory TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson

without_proof_info in
/-- A dense set remains dense relative to every open neighborhood. -/
theorem subset_closure_inter_of_open_dense {X : Type*} [TopologicalSpace X]
    {S U : Set X} (hS : Dense S) (hU : IsOpen U) : U ⊆ closure (U ∩ S) := by
  intro x hx
  rw [mem_closure_iff]
  intro V hV hxV
  obtain ⟨y, hyS, hyV, hyU⟩ := hS.exists_mem_open (hV.inter hU) ⟨x, hxV, hx⟩
  exact ⟨y, hyV, hyU, hyS⟩

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M] [LindelofSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
