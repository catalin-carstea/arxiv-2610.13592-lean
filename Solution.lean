noncomputable section ProofPart_AnalyticSolutions



/- Interior analyticity of the same actual solution family under the approved regularity input. -/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem DirichletSolver.analyticOn_nativeInterior
    (hRegularity : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (g : Metric (n := n) (M := M) ω) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ω q) (S : DirichletSolver (g.ofLE (by decide)) q)
    (f : ((𝓡∂ (n + 1)).boundary M) → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f) :
    ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω (S.solve f) ((𝓡∂ (n + 1)).interior M) := by
  let U : TopologicalSpace.Opens M :=
    ⟨(𝓡∂ (n + 1)).interior M, (𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)⟩
  exact hRegularity g q hq U Subset.rfl (S.solve f)
    (S.correct f hf).1.contMDiffOn (S.correct f hf).2.1

without_proof_info in
theorem DirichletSolver.analyticAt_interior
    (hRegularity : InteriorAnalyticRegularityAssumption (n := n) (M := M))
    (g : Metric (n := n) (M := M) ω) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ω q) (S : DirichletSolver (g.ofLE (by decide)) q)
    (f : ((𝓡∂ (n + 1)).boundary M) → ℝ) (hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ f)
    (x : M) (hx : x ∈ (𝓡∂ (n + 1)).interior M) :
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (S.solve f) x :=
  (S.analyticOn_nativeInterior hRegularity g q hq f hf x hx).contMDiffAt
    ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide) |>.mem_nhds hx)

end ConformalPoisson

