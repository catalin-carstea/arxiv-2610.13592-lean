  let de := fun i => W1p0.extendByZeroL hsub (d i)
  have huge : W1p.gradient ue.val =ᵐ[μ.restrict U]
      (Ω : Set E).indicator (W1p.gradient u.val : E → E) := by
    rw [W1p0.gradient_extendByZeroL]
    exact coeFn_extendByZeroLpₗᵢ ℝ Ω.isOpen.measurableSet hsub _
  have hude (i : ι) : W1p.value (de i).val =ᵐ[μ.restrict U]
      fun x => ⟪W1p.gradient ue.val x, b i⟫_ℝ := by
    have hde : W1p.value (de i).val =ᵐ[μ.restrict U]
        (Ω : Set E).indicator (W1p.value (d i).val : E → ℝ) := by
      rw [W1p0.value_extendByZeroL]
      exact coeFn_extendByZeroLpₗᵢ ℝ Ω.isOpen.measurableSet hsub _
    have hdi := (ae_restrict_iff' Ω.isOpen.measurableSet).1 (hd i)
    filter_upwards [hde, huge, ae_restrict_of_ae hdi] with x hdx hux hx
    rw [hdx, hux]
    by_cases hxΩ : x ∈ (Ω : Set E)
    · rw [indicator_of_mem hxΩ, indicator_of_mem hxΩ, hx hxΩ]
    · rw [indicator_of_notMem hxΩ, indicator_of_notMem hxΩ, inner_zero_left]
