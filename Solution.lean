theorem boundaryNormalFactorBundle_drift (b : V → V) (B : V → ℝ) (x : V)
    (hfactor : b x 0 = x 0 * B x) :
    b x = boundaryNormalDrift (boundaryNormalFactorBundle b B) x := by
  have he : boundaryTangentialProjection e = (0 : V) := by
    simpa using boundaryTangentialProjection_normal_vector (n := n) (1 : ℝ)
  rw [boundaryTangentialProjection_normal_decomposition (b x)]
  simp [boundaryNormalDrift, boundaryNormalFactorBundle, he, ← hfactor]

