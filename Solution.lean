/- Boundary H2 regularity for the actual reading of a native weak
Dirichlet solution. The geometric domain, coefficients, forcing and
localized zero trace are all supplied by their constructed native data. -/
open Bundle Set Metric MeasureTheory TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology Gradient InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.BoundaryChartLocalization
variable {n : ℕ} {M : Type*}
  [TopologicalSpace M] [T2Space M] [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [CompactSpace M] [IsManifold (𝓡∂ (n + 1)) 2 M] [IsManifold (𝓡∂ (n + 1)) ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x)]
  [IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : M => TangentSpace (𝓡∂ (n + 1)) x)]
  [IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) ∞ (EuclideanSpace ℝ (Fin (n + 1)))
    (fun x : M => TangentSpace (𝓡∂ (n + 1)) x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin (n + 1)))
    (TangentSpace (𝓡∂ (n + 1)) : M → Type _) (𝓡∂ (n + 1))]
  [MeasurableSpace M] [BorelSpace M]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "Ihalf" => 𝓡∂ (n + 1)
local instance boundaryH2ContinuousMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := Ihalf) (n := 1)
open DirichletSobolev
variable {c : M} (L : BoundaryChartLocalization (I := 𝓡∂ (n + 1)) c)
include L

without_proof_info in
/-- The inner reading of a native weak Dirichlet solution has actual
square-integrable second weak derivatives on every smaller chart cap,
up to the physical boundary. The potential is allowed to have either sign. -/
theorem innerReadingL_exists_H2 {q F : M → ℝ}
    (hq : Continuous q) (hF : Continuous F)
    (u : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x})
    (hu : ∀ v : zeroTraceSubmodule (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x},
      schrodingerForm (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x}
          (ContinuousMap.toLp ⊤ (riemannianVolume Ihalf M) ℝ ⟨q, hq⟩) u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume Ihalf M) ℝ ⟨F, hF⟩,
          valueL (I := Ihalf) {x : M | (Ihalf).IsBoundaryPoint x} v⟫_ℝ)
    (D : TopologicalSpace.Opens V) (hD : IsCompact (closure (D : Set V)))
    (hDU : closure (D : Set V) ⊆ ball (extChartAt Ihalf c c) L.bump.rIn) :
    ∃ W : Wkp (Module.finBasis ℝ V).addHaar (L.innerCap ⊓ D) 2 2,
      Wkp.lowerOrder 1 W = W1p.restrictL (inf_le_left : L.innerCap ⊓ D ≤ L.innerCap)
        (L.innerReadingL u) := by
  let μ := (Module.finBasis ℝ V).addHaar
  let U : TopologicalSpace.Opens V := ⟨ball (extChartAt Ihalf c c) L.bump.rIn, isOpen_ball⟩
  let H : TopologicalSpace.Opens V :=
    ⟨{z | 0 < z 0}, isOpen_lt continuous_const
      ((PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous)⟩
  let ν : V := EuclideanSpace.single 0 1
  have hν : ν ≠ 0 := by
    intro h
    have h0 := congrArg (fun z : V => z 0) h
    simp [ν, EuclideanSpace.single, PiLp.single_apply] at h0
  have hH : ∀ z : V, z ∈ H ↔ (0 : ℝ) < ⟪z, ν⟫_ℝ := by
    intro z
    simp [H, ν, EuclideanSpace.inner_eq_star_dotProduct, dotProduct,
      EuclideanSpace.single, PiLp.single_apply]
  have hΩU : (L.innerCap : Set V) ∩ U = (H : Set V) ∩ U := by
    ext z
    change (z ∈ ball (extChartAt Ihalf c c) L.bump.rIn ∧
      z ∈ interior (range Ihalf)) ∧ z ∈ ball (extChartAt Ihalf c c) L.bump.rIn ↔
        0 < z 0 ∧ z ∈ ball (extChartAt Ihalf c c) L.bump.rIn
    rw [interior_range_modelWithCornersEuclideanHalfSpace]
    tauto
  obtain ⟨lam, Lam, ha⟩ := L.innerCap_uniformlyElliptic
  obtain ⟨K, hK⟩ := L.innerCap_lipschitzOnWith
  have hb : MemLp (0 : V → V) ⊤ (μ.restrict (L.innerCap : Set V)) := MemLp.zero
  have hc : MemLp (chartWeightedPotential (I := Ihalf) c q) ⊤ (μ.restrict (L.innerCap : Set V)) :=
    ((continuousOn_chartWeightedPotential_target (I := Ihalf) c hq).mono
      L.closure_innerCap_subset_target).memLp_top_restrict_of_subset_isCompact
        (isBounded_ball.subset (inter_subset_left : (L.innerCap : Set V) ⊆ _)).isCompact_closure
        L.innerCap.isOpen.measurableSet subset_closure
  let f := fun z => chartVolumeDensity (I := Ihalf) c ((extChartAt Ihalf c).symm z) *
    F ((extChartAt Ihalf c).symm z)
  have hf : MemLp f 2 (μ.restrict (L.innerCap : Set V)) := L.memLp_weightedForcing_innerCap hF
  have hweak : ∀ v : W1p0 μ L.innerCap 2,
      energyFormH1 (chartWeightedPrincipal (I := Ihalf) c) 0 (chartWeightedPotential (I := Ihalf) c q)
        (L.innerReadingL u) v.val =
      ∫ z in (L.innerCap : Set V), (hf.toLp f) z * W1p.value v.val z ∂μ := by
    intro v
    refine (L.innerReadingL_weak_equation hq hF u hu v).trans (integral_congr_ae ?_)
    filter_upwards [hf.coeFn_toLp] with z hz
    rw [hz]
  exact (ha.mono_set inter_subset_left).exists_lowerOrder_eq_restrictL_of_halfSpace
    (U := U) (H := H) hν hH hΩU (hK.mono inter_subset_left) hb hc hweak
    (fun ψ hψ hψc hψs => L.innerReadingL_zeroBoundary_cutoff u ψ hψ hψc hψs) hD hDU
end ConformalPoisson.BoundaryChartLocalization

end ProofPart_NativeBoundaryH2

/- Proof support: RelativeCoefficientMultiplication.lean, SHA256 95d0a221fd625106ee3b82f0ac85cace9a5ad23f176be1adeb357a8f45a59358 -/
noncomputable section ProofPart_RelativeCoefficientMultiplication




/-
Multiplication by coefficients smooth within the relative chart target.
The induction is adapted from the pinned Tau Ceti theorem
`Wkp.exists_value_ae_eq_mul_of_contDiffOn` in `Wkp/Leibniz.lean`.
Original copyright (c)2026 The Tau Ceti contributors; Apache2.0,
see External/LICENSE.tauceti. The change here uses derivatives within
the relative target at the induction step, read as ordinary derivatives
only on the open cap. No ambient smooth extension is assumed.
-/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E} {S K : Set E}

without_proof_info in
/-- A coefficient smooth on the relative chart target multiplies
every Hk representative on the smaller cap into another Hk representative. -/
theorem exists_wkp_mul_of_relative_smooth
    (hS : UniqueDiffOn ℝ S) (hK : IsCompact K) (hKS : K ⊆ S)
    (hΩK : (Ω : Set E) ⊆ K) (hΩS : (Ω : Set E) ⊆ interior S) (k : ℕ)
    {ψ : E → ℝ} (hψ : ContDiffOn ℝ ∞ ψ S) (u : Wkp μ Ω 2 k) :
    ∃ w : Wkp μ Ω 2 k, Wkp.value k w =ᵐ[μ.restrict Ω]
      fun x => ψ x * Wkp.value k u x := by
  have hLp : ∀ {ϕ : E → ℝ}, ContinuousOn ϕ S → ∀ f : Lp ℝ 2 (μ.restrict Ω),
      ∃ g : Lp ℝ 2 (μ.restrict Ω), g =ᵐ[μ.restrict Ω] fun x => ϕ x * f x := by
    intro ϕ hϕ f
    have hbounded := (hϕ.mono hKS).memLp_top_restrict_of_subset_isCompact
      (μ := μ) hK Ω.isOpen.measurableSet hΩK
    have hm : MemLp (fun x => ϕ x * f x) 2 (μ.restrict Ω) := hbounded.fun_mul (Lp.memLp f)
    exact ⟨hm.toLp _, hm.coeFn_toLp⟩
  induction k generalizing ψ with
  | zero => simpa only [Wkp.value_zero] using hLp hψ.continuousOn (Wkp.value 0 u)
  | succ k ih =>
    obtain ⟨g, hg⟩ := hLp hψ.continuousOn (Wkp.value (k + 1) u)
    let b := stdOrthonormalBasis ℝ E
    refine (Wkp.exists_value_eq_of_forall_hasWeakLineDerivOn b g k fun i => ?_).imp
      fun w (hw : Wkp.value (k + 1) w = g) => hw ▸ hg
    obtain ⟨d, hd⟩ := Wkp.exists_hasWeakLineDerivOn_value k u (b i)
    obtain ⟨w₁, hw₁⟩ := ih hψ d
    obtain ⟨w₂, hw₂⟩ := ih (relative_smooth_directional_derivative hS hψ (b i))
      (Wkp.lowerOrder k u)
    refine ⟨w₁ + w₂, (((hd.contDiffOn_smul
      (hψ.mono (hΩS.trans interior_subset))).congr_ae ?_).congr_ae_deriv ?_)⟩
    · filter_upwards [hg] with x hx
      rw [hx, smul_eq_mul]
    · filter_upwards [Wkp.value_add k w₁ w₂ ▸ Lp.coeFn_add (Wkp.value k w₁) (Wkp.value k w₂),
        hw₁, hw₂, ae_restrict_mem Ω.isOpen.measurableSet] with x hx h₁ h₂ hxΩ
      rw [hx, Pi.add_apply, h₁, h₂, ← Wkp.value_succ,
        fderivWithin_of_mem_nhds (mem_interior_iff_mem_nhds.mp (hΩS hxΩ)), smul_eq_mul, smul_eq_mul]
end ConformalPoisson

end ProofPart_RelativeCoefficientMultiplication

/- Proof support: NativeCoefficientSobolev.lean, SHA256 7fc578939be1cc2e10d8fd0aba61966c9a8e00fe2f5710f0aec0c78f47d11e00 -/
noncomputable section ProofPart_NativeCoefficientSobolev



/- Higher Sobolev control of the actual chart coefficients and
weighted forcing, using their smoothness on the relative chart target.
The physical boundary is included in the compact set controlling them. -/
open Bundle Set Metric MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold TauCeti.PDE
open scoped Manifold ContDiff Topology ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {d : ℕ} {H : Type*} [TopologicalSpace H]
  {I : ModelWithCorners ℝ (EuclideanSpace ℝ (Fin d)) H} {M : Type*}
  [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 2 M] [IsManifold I ∞ M]
  [RiemannianBundle (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I 1 (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [IsContMDiffRiemannianBundle I ∞ (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x)]
  [ContMDiffVectorBundle 1 (EuclideanSpace ℝ (Fin d)) (TangentSpace I : M → Type _) I]
local notation "V" => EuclideanSpace ℝ (Fin d)
local instance coefficientSobolevContinuousMetric :
    IsContinuousRiemannianBundle (EuclideanSpace ℝ (Fin d)) (fun x : M => TangentSpace I x) :=
  IsContMDiffRiemannianBundle.toIsContinuousRiemannianBundle (IB := I) (n := 1)

without_proof_info in
theorem contDiffOn_chartWeightedPotential_target (c : M) {q : M → ℝ}
    (hq : ContMDiff I 𝓘(ℝ) ∞ q) :
    ContDiffOn ℝ ∞ (chartWeightedPotential (I := I) c q) (extChartAt I c).target :=
  (contDiffOn_chartDensity_target (I := I) c).mul
    (contDiffOn_read_relativeChart (I := I) c hq.contMDiffOn)

namespace BoundaryChartLocalization
variable [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
variable {c : M} (L : BoundaryChartLocalization (I := I) c)

without_proof_info in
theorem memLp_chartPrincipalEnergy :
    MemLp (fun z => energyIntegrand (chartWeightedPrincipal (I := I) c z) 0 0) ⊤
      ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) :=
  memLp_energyIntegrand_on_compact
    (((continuousOn_chartWeightedPrincipal_target (I := I) c).energyIntegrand
      continuousOn_const continuousOn_const).mono L.closedInnerCap_subset_target)
    L.closedInnerCap_compact L.innerCap.isOpen.measurableSet L.innerCap_subset_closedInnerCap

without_proof_info in
theorem memLp_iteratedFDeriv_chartWeightedPrincipal (i j : Fin d) (k : ℕ) (p : ℝ≥0∞) :
    MemLp (iteratedFDeriv ℝ k (fun z => chartWeightedPrincipal (I := I) c z i j)) p
      ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) :=
  memLp_iteratedFDeriv_of_relative_smooth (uniqueDiffOn_extChartAt_target c)
    L.closedInnerCap_compact L.closedInnerCap_subset_target L.innerCap_subset_closedInnerCap
    L.innerCap_subset_interior_target (contDiffOn_chartWeightedPrincipal_entries_target c i j) k p

without_proof_info in
theorem exists_wkp_mul_chartWeightedPrincipal (i j : Fin d) (k : ℕ)
    (u : Wkp (Module.finBasis ℝ V).addHaar L.innerCap 2 k) :
    ∃ w : Wkp (Module.finBasis ℝ V).addHaar L.innerCap 2 k,
      Wkp.value k w =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)]
        fun z => chartWeightedPrincipal (I := I) c z i j * Wkp.value k u z :=
  exists_wkp_mul_of_relative_smooth (uniqueDiffOn_extChartAt_target c)
    L.closedInnerCap_compact L.closedInnerCap_subset_target L.innerCap_subset_closedInnerCap
    L.innerCap_subset_interior_target k (contDiffOn_chartWeightedPrincipal_entries_target c i j) u

without_proof_info in
theorem exists_wkp_weightedForcing {F : M → ℝ} (hF : ContMDiff I 𝓘(ℝ) ∞ F) (k : ℕ) :
    ∃ f : Wkp (Module.finBasis ℝ V).addHaar L.innerCap 2 k,
      Wkp.value k f =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)]
        fun z => chartVolumeDensity (I := I) c ((extChartAt I c).symm z) * F ((extChartAt I c).symm z) :=
  exists_wkp_of_relative_smooth (uniqueDiffOn_extChartAt_target c)
    L.closedInnerCap_compact L.closedInnerCap_subset_target L.innerCap_subset_closedInnerCap
    L.innerCap_subset_interior_target (contDiffOn_chartWeightedPotential_target c hF) k

without_proof_info in
theorem exists_wkp_mul_chartWeightedPotential {q : M → ℝ} (hq : ContMDiff I 𝓘(ℝ) ∞ q) (k : ℕ)
    (u : Wkp (Module.finBasis ℝ V).addHaar L.innerCap 2 k) :
    ∃ w : Wkp (Module.finBasis ℝ V).addHaar L.innerCap 2 k,
      Wkp.value k w =ᵐ[(Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)]
        fun z => chartWeightedPotential (I := I) c q z * Wkp.value k u z :=
  exists_wkp_mul_of_relative_smooth (uniqueDiffOn_extChartAt_target c)
    L.closedInnerCap_compact L.closedInnerCap_subset_target L.innerCap_subset_closedInnerCap
    L.innerCap_subset_interior_target k (contDiffOn_chartWeightedPotential_target c hq) u
end BoundaryChartLocalization
end ConformalPoisson

end ProofPart_NativeCoefficientSobolev

/- Proof support: EuclideanNormalSplit.lean, SHA256 f4ef6dcd285146eb160f80f2482da960f9baf0c2444666731d3b58a8cad21152 -/
noncomputable section ProofPart_EuclideanNormalSplit





/- The actual first-coordinate splitting of Euclidean half-space,
as a linear isometry, with the source Haar measure derived from the
given target measure rather than a chosen normalization. -/
open Set MeasureTheory TauCeti
open scoped ContDiff ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

def euclideanNormalSplit (n : ℕ) :
    WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n)) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin (n + 1)) where
  toLinearEquiv := (WithLp.linearEquiv 2 ℝ (ℝ × EuclideanSpace ℝ (Fin n))).trans
    (EuclideanSpace.consEquivL ℝ n).toLinearEquiv
  norm_map' z := by
    change ‖EuclideanSpace.consEquivL ℝ n (WithLp.ofLp z)‖ = ‖z‖
    rw [EuclideanSpace.norm_eq, WithLp.prod_norm_eq_of_L2]
    congr 1
    rw [Fin.sum_univ_succ]
    simp only [EuclideanSpace.consEquivL_apply_zero, EuclideanSpace.consEquivL_apply_succ,
      EuclideanSpace.norm_sq_eq]
    rfl

without_proof_info in
@[simp] theorem euclideanNormalSplit_zero {n : ℕ}
    (z : WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))) : euclideanNormalSplit n z 0 = z.fst :=
  EuclideanSpace.consEquivL_apply_zero (WithLp.ofLp z)

without_proof_info in
@[simp] theorem euclideanNormalSplit_succ {n : ℕ}
    (z : WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))) (j : Fin n) :
    euclideanNormalSplit n z j.succ = z.snd j :=
  EuclideanSpace.consEquivL_apply_succ (WithLp.ofLp z) j

without_proof_info in
@[simp] theorem euclideanNormalSplit_symm_fst {n : ℕ} (z : EuclideanSpace ℝ (Fin (n + 1))) :
    ((euclideanNormalSplit n).symm z).fst = z 0 := by
  rw [← euclideanNormalSplit_zero, LinearIsometryEquiv.apply_symm_apply]

def euclideanOpenHalfSpace (n : ℕ) (a : ℝ) : TopologicalSpace.Opens (EuclideanSpace ℝ (Fin (n + 1))) :=
  ⟨{z | a < z 0}, isOpen_lt continuous_const
    ((PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin (n + 1) => ℝ) 0).continuous)⟩

without_proof_info in
theorem normalSplit_preimage_halfSpace (n : ℕ) (a : ℝ) :
    (normalHalfSpace (E := EuclideanSpace ℝ (Fin n)) a : Set _) =
      euclideanNormalSplit n ⁻¹' (euclideanOpenHalfSpace n a : Set _) := by
  ext z
  rw [SetLike.mem_coe, mem_normalHalfSpace]
  change a < z.fst ↔ a < euclideanNormalSplit n z 0
  rw [euclideanNormalSplit_zero]

without_proof_info in
theorem normalSplit_measurePreserving {n : ℕ}
    (μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))) :
    MeasurePreserving (euclideanNormalSplit n) (μ.map (euclideanNormalSplit n).symm) μ := by
  refine ⟨(euclideanNormalSplit n).continuous.measurable, ?_⟩
  rw [Measure.map_map (euclideanNormalSplit n).continuous.measurable
    (euclideanNormalSplit n).symm.continuous.measurable]
  simp only [Function.comp_def, LinearIsometryEquiv.apply_symm_apply]
  exact Measure.map_id

end ConformalPoisson

end ProofPart_EuclideanNormalSplit

/- Proof support: HalfSpaceTangentialTrace.lean, SHA256 c3b29c28ed88d97f63110c49ad6ec1e0c933671a29b241c0f711c963a3e27299 -/
noncomputable section ProofPart_HalfSpaceTangentialTrace






/- Tangential derivatives of zero-Dirichlet H2 functions have zero
Dirichlet trace. The proof extends the first-order jet of the original
function by zero, extends tangential derivatives of its gradient, and
commutes weak derivatives. It uses the actual W1p0 closure interface. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff Topology InnerProductSpace ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
without_proof_info in
/-- An H2 representative gives square-integrable directional weak
derivatives of every scalar component of its H1 gradient. -/
theorem exists_Lp_derivative_H2_gradient {X : Type*}
    [NormedAddCommGroup X] [InnerProductSpace ℝ X] [FiniteDimensional ℝ X]
    [MeasurableSpace X] [BorelSpace X] {μ : Measure X} [μ.IsAddHaarMeasure]
    {Ω : Opens X} (u : Wkp μ Ω 2 2) (y τ : X) :
    ∃ g : Lp ℝ 2 (μ.restrict Ω), HasWeakLineDerivOn μ Ω
      (fun x => ⟪W1p.gradient (Wkp.firstOrder 1 u) x, y⟫_ℝ) g τ := by
  obtain ⟨v, hv, _⟩ := Wkp.exists_hasWeakLineDerivOn_value_and_inner_gradient_ae_eq u y
  have hvg : (fun x => ⟪W1p.gradient (Wkp.firstOrder 1 u) x, y⟫_ℝ) =ᵐ[μ.restrict Ω]
      W1p.value v := by
    apply ((W1p.hasWeakFDerivOn (Wkp.firstOrder 1 u)).hasWeakLineDerivOn y).ae_eq
    rwa [Wkp.value_firstOrder]
  refine ⟨(innerSL ℝ τ).compLp (W1p.gradient v),
    (((W1p.hasWeakFDerivOn v).hasWeakLineDerivOn τ).congr_ae hvg.symm).congr_ae_deriv ?_⟩
  filter_upwards [(innerSL ℝ τ).coeFn_compLp (W1p.gradient v)] with x hx
  simpa only [innerSL_apply_apply, real_inner_comm] using hx.symm

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
local notation "P" => WithLp 2 (ℝ × E)

without_proof_info in
/-- A tangential weak derivative has zero trace whenever the
corresponding derivatives of the original gradient are square integrable. -/
theorem mem_w1p0_tangential_derivative {a : ℝ}
    (u : W1p0 (volume : Measure (WithLp 2 (ℝ × E))) (normalHalfSpace a) 2)
    (d : W1p (volume : Measure (WithLp 2 (ℝ × E))) (normalHalfSpace a) 2)
    (τ : P) (hτ : τ.fst = 0)
    (hd : HasWeakLineDerivOn volume (normalHalfSpace a) (W1p.value u.val) (W1p.value d) τ)
    (hgrad : ∀ y : P, ∃ g : Lp ℝ 2 (volume.restrict (normalHalfSpace (E := E) a : Set P)),
      HasWeakLineDerivOn volume (normalHalfSpace a)
        (fun x => ⟪W1p.gradient u.val x, y⟫_ℝ) g τ) :
    d ∈ w1p0Submodule volume (normalHalfSpace a) 2 := by
  let H := (normalHalfSpace (E := E) a : Set P)
  have hH : MeasurableSet H := (normalHalfSpace (E := E) a).isOpen.measurableSet
  let f : P → ℝ := H.indicator (W1p.value u.val)
  let G : P → P := H.indicator (W1p.gradient u.val)
  have hfG := W1p0.hasWeakFDerivOn_indicator (le_top : normalHalfSpace (E := E) a ≤ ⊤) u
  have hfirst (y : P) : HasWeakLineDerivOn volume ⊤ f (fun x => ⟪G x, y⟫_ℝ) y := by
    simpa only [innerSL_apply_apply] using hfG.hasWeakLineDerivOn y
  have hdg : (fun x => ⟪W1p.gradient u.val x, τ⟫_ℝ) =ᵐ[volume.restrict H] W1p.value d :=
    ((W1p.hasWeakFDerivOn u.val).hasWeakLineDerivOn τ).ae_eq hd
  have hdG : (fun x => ⟪G x, τ⟫_ℝ) =ᵐ[volume] H.indicator (W1p.value d) := by
    have h := (ae_restrict_iff' hH).1 hdg
    filter_upwards [h] with x hx
    by_cases hxH : x ∈ H
    · simp only [G, indicator_of_mem hxH]
      exact hx hxH
    · simp [G, indicator_of_notMem hxH]
  have hD : ∀ y : P, ∃ g : P → ℝ, MemLp g 2 volume ∧
      HasWeakLineDerivOn volume ⊤ (H.indicator (W1p.value d)) g y := by
    intro y
    obtain ⟨g, hg⟩ := hgrad y
    let g0 : P → ℝ := H.indicator g
    let gy : P → ℝ := H.indicator (fun x => ⟪W1p.gradient u.val x, y⟫_ℝ)
    have hg0 : MemLp g0 2 volume :=
      (memLp_indicator_iff_restrict hH.nullMeasurableSet).2 (Lp.memLp g)
    have hgy : MemLp gy 2 volume :=
      (memLp_indicator_iff_restrict hH.nullMeasurableSet).2
        ((Lp.memLp (W1p.gradient u.val)).inner_const y)
    have hgyG : gy = fun x => ⟪G x, y⟫_ℝ := by
      funext x
      by_cases hx : x ∈ H <;> simp [gy, G, hx]
    have hgH : HasWeakLineDerivOn volume (normalHalfSpace a) gy g0 τ := by
      refine (hg.congr_ae ?_).congr_ae_deriv ?_
      · filter_upwards [ae_restrict_mem hH] with x hx
        change _ = H.indicator (fun z => ⟪W1p.gradient u.val z, y⟫_ℝ) x
        rw [indicator_of_mem hx]
      · filter_upwards [ae_restrict_mem hH] with x hx
        change _ = H.indicator (g : P → ℝ) x
        rw [indicator_of_mem hx]
    have hgTop := hgH.top_of_normalHalfSpace hτ
      (hgy.locallyIntegrable (by norm_num)) (hg0.locallyIntegrable (by norm_num))
      (fun x hx => indicator_of_notMem hx _) (fun x hx => indicator_of_notMem hx _)
    rw [hgyG] at hgTop
    exact ⟨g0, hg0, ((hfirst y).comm hgTop (hfirst τ)).congr_ae
      (by simpa only [Opens.coe_top, Measure.restrict_univ] using hdG)⟩
  choose D hDM hDW using hD
  have hval : MemLp (H.indicator (W1p.value d)) 2 (volume.restrict (⊤ : Opens P)) := by
    simpa only [Opens.coe_top, Measure.restrict_univ] using
      ((memLp_indicator_iff_restrict hH.nullMeasurableSet).2 (Lp.memLp (W1p.value d)))
  obtain ⟨w, hw⟩ := Wkp.exists_value_one_ae_eq_of_forall_hasWeakLineDerivOn hval D
    (fun y => by simpa only [Opens.coe_top, Measure.restrict_univ] using hDM y) hDW
  have hw' : W1p.value w =ᵐ[volume] H.indicator (W1p.value d) := by
    simpa only [Wkp.value_one, Opens.coe_top, Measure.restrict_univ] using hw
  have hw0 : ∀ᵐ x ∂volume, x ∉ normalHalfSpace (E := E) a → W1p.value w x = 0 := by
    filter_upwards [hw'] with x hx hxH
    rw [hx, indicator_of_notMem hxH]
  have hmem := W1p.restrictL_mem_w1p0Submodule_normalHalfSpace
    (by norm_num : (2 : ℝ≥0∞) ≠ (⊤ : ℝ≥0∞)) a w hw0
  have hwd : W1p.restrictL (le_top : normalHalfSpace (E := E) a ≤ ⊤) w = d := by
    apply W1p.ext_value
    apply Lp.ext
    filter_upwards [W1p.value_restrictL_ae (le_top : normalHalfSpace (E := E) a ≤ ⊤) w,
      ae_restrict_of_ae hw', ae_restrict_mem hH] with x hr hx hxH
    rw [hr, hx, indicator_of_mem hxH]
  rwa [hwd] at hmem

without_proof_info in
/-- Every tangential first derivative of an H2 function whose first
order part has zero trace is itself an H1 function of zero trace. -/
theorem exists_w1p0_tangential_derivative {a : ℝ}
    (u : Wkp (volume : Measure (WithLp 2 (ℝ × E))) (normalHalfSpace a) 2 2)
    (hu : Wkp.firstOrder 1 u ∈ w1p0Submodule volume (normalHalfSpace a) 2)
    (τ : P) (hτ : τ.fst = 0) :
    ∃ d : W1p0 (volume : Measure P) (normalHalfSpace a) 2,
      HasWeakLineDerivOn volume (normalHalfSpace a) (Wkp.value 2 u) (W1p.value d.val) τ := by
  obtain ⟨d, hd, _⟩ := Wkp.exists_hasWeakLineDerivOn_value_and_inner_gradient_ae_eq u τ
  have hdu : HasWeakLineDerivOn volume (normalHalfSpace a)
      (W1p.value (Wkp.firstOrder 1 u)) (W1p.value d) τ := by
    rwa [Wkp.value_firstOrder]
  have hg : ∀ y : P, ∃ g : Lp ℝ 2 (volume.restrict (normalHalfSpace (E := E) a : Set P)),
      HasWeakLineDerivOn volume (normalHalfSpace a)
        (fun x => ⟪W1p.gradient (Wkp.firstOrder 1 u) x, y⟫_ℝ) g τ :=
    fun y => exists_Lp_derivative_H2_gradient u y τ
  exact ⟨⟨d, mem_w1p0_tangential_derivative ⟨Wkp.firstOrder 1 u, hu⟩ d τ hτ hdu hg⟩, hd⟩
end ConformalPoisson

end ProofPart_HalfSpaceTangentialTrace

/- Proof support: HaarWeakDerivative.lean, SHA256 497dde8aea18b77d1cc1aec27dc8fa04c44e41512904c1d7358156033ae108b1 -/
noncomputable section ProofPart_HaarWeakDerivative





/- Changing between additive Haar normalizations preserves the actual
weak derivatives. This bridges native chart Haar readings with the
canonical volume used by the half-space trace API. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ContDiff ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ ν : Measure E} [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure]

without_proof_info in
/-- The choice of additive Haar normalization does not change a weak
directional derivative or its actual representing functions. -/
theorem weakLineDeriv_changeHaar {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {Ω : Opens E} {u u' : E → F} {v : E}
    (h : HasWeakLineDerivOn μ Ω u u' v) : HasWeakLineDerivOn ν Ω u u' v := by
  have : CompleteSpace F := h.completeSpace
  rw [Measure.isAddLeftInvariant_eq_smul ν μ]
  refine hasWeakLineDerivOn_iff_testFunction.mpr
    ⟨inferInstance, h.locallyIntegrableOn.smul_measure ENNReal.coe_ne_top,
      h.locallyIntegrableOn_deriv.smul_measure ENNReal.coe_ne_top, fun φ => ?_⟩
  simp only [integral_smul_nnreal_measure,
    h.integral_lineDeriv_smul_eq_neg_integral_smul φ, smul_neg]

without_proof_info in
theorem weakFDeriv_changeHaar {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {Ω : Opens E} {u : E → F} {D : E → E →L[ℝ] F}
    (h : HasWeakFDerivOn μ Ω u D) : HasWeakFDerivOn ν Ω u D := by
  apply hasWeakFDerivOn_iff.mpr
  intro v
  exact weakLineDeriv_changeHaar (h.hasWeakLineDerivOn v)

without_proof_info in
/-- A function on an open set belongs to the same Lp class under any
additive Haar normalization. -/
theorem memLp_changeHaar {F : Type*} [TopologicalSpace F] [ESeminormedAddMonoid F]
    {Ω : Opens E} {p : ℝ≥0∞} {f : E → F} (hf : MemLp f p (μ.restrict Ω)) :
    MemLp f p (ν.restrict Ω) := by
  rw [Measure.isAddLeftInvariant_eq_smul ν μ, Measure.restrict_smul]
  exact hf.smul_measure ENNReal.coe_ne_top

variable {p : ℝ≥0∞} [Fact (1 ≤ p)]

/-- The canonical bounded identity reading between the two Lp spaces,
with the Haar scalar factor carried explicitly by the existing Lp API. -/
def haarChangeLp (μ ν : Measure E) [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure]
    (Ω : Opens E) (F : Type*) [NormedAddCommGroup F] [NormedSpace ℝ F] :
    Lp F p (μ.restrict Ω) →L[ℝ] Lp F p (ν.restrict Ω) :=
  Lp.LpToLpOfMeasureLeSMul
    (c := (Measure.addHaarScalarFactor ν μ : ℝ≥0∞)) ENNReal.coe_ne_top (by
      have h := Measure.isAddLeftInvariant_eq_smul ν μ
      change ν = (Measure.addHaarScalarFactor ν μ : ℝ≥0∞) • μ at h
      rw [← Measure.restrict_smul, ← h])

without_proof_info in
theorem haarChangeLp_ae (Ω : Opens E) {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (f : Lp F p (μ.restrict Ω)) :
    haarChangeLp μ ν Ω F f =ᵐ[ν.restrict Ω] f :=
  Lp.coeFn_LpToLpOfMeasureLeSMul _ _ f

without_proof_info in
/-- The target Haar measure has exactly the same null sets as the
source; this direction transports the source representatives. -/
theorem haar_restrict_absolutelyContinuous (Ω : Opens E) : ν.restrict Ω ≪ μ.restrict Ω := by
  rw [Measure.isAddLeftInvariant_eq_smul ν μ, Measure.restrict_smul]
  exact Measure.smul_absolutelyContinuous
end ConformalPoisson

end ProofPart_HaarWeakDerivative

/- Proof support: HaarSobolevReading.lean, SHA256 dd55cbc37329179c19e5a96e231dc84b6c43532c8c8dbad878a4f8a374765b25 -/
noncomputable section ProofPart_HaarSobolevReading



/- Canonical bounded transport of the H1 reading between additive
Haar normalizations, preserving the value, gradient and zero trace.
This supplies the measure bridge for the half-space trace producers. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal Distributions
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ ν : Measure E} [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure] {Ω : Opens E} {p : ℝ≥0∞} [Fact (1 ≤ p)]

without_proof_info in
theorem haarChangeJet_readings_ae (J : Sobolev1JetLp μ Ω p) :
    (Sobolev1JetLp.value (haarChangeLp μ ν Ω (Sobolev1Jet E) J) =ᵐ[ν.restrict Ω]
      Sobolev1JetLp.value J) ∧
    (Sobolev1JetLp.gradient (haarChangeLp μ ν Ω (Sobolev1Jet E) J) =ᵐ[ν.restrict Ω]
      Sobolev1JetLp.gradient J) := by
  have hac := haar_restrict_absolutelyContinuous (μ := μ) (ν := ν) Ω
  constructor
  · filter_upwards [haarChangeLp_ae (ν := ν) Ω J,
      hac.ae_eq (Sobolev1JetLp.value_apply_ae J),
      Sobolev1JetLp.value_apply_ae (haarChangeLp μ ν Ω (Sobolev1Jet E) J)] with x hJ hv hT
    rw [hT, hJ, hv]
  · filter_upwards [haarChangeLp_ae (ν := ν) Ω J,
      hac.ae_eq (Sobolev1JetLp.gradient_apply_ae J),
      Sobolev1JetLp.gradient_apply_ae (haarChangeLp μ ν Ω (Sobolev1Jet E) J)] with x hJ hg hT
    rw [hT, hJ, hg]

without_proof_info in
theorem haarChangeJet_mem (u : W1p μ Ω p) :
    haarChangeLp μ ν Ω (Sobolev1Jet E) u.val ∈ w1pSubmodule ν Ω p := by
  rw [mem_w1pSubmodule_iff_hasWeakFDerivOn]
  obtain ⟨hv, hg⟩ := haarChangeJet_readings_ae (ν := ν) u.val
  rw [← W1p.value_coe] at hv
  rw [← W1p.gradient_coe] at hg
  have h := weakFDeriv_changeHaar (ν := ν) (W1p.hasWeakFDerivOn u)
  refine (h.congr_ae hv.symm).congr_ae_deriv ?_
  filter_upwards [hg] with x hx
  rw [Sobolev1JetLp.candidateWeakFDeriv_def, hx]

def haarChangeW1pL (μ ν : Measure E) [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure]
    (Ω : Opens E) : W1p μ Ω p →L[ℝ] W1p ν Ω p :=
  ContinuousLinearMap.codRestrict
    ((haarChangeLp μ ν Ω (Sobolev1Jet E)).comp (w1pSubmodule μ Ω p).toSubmodule.subtypeL)
    (w1pSubmodule ν Ω p).toSubmodule (fun u => haarChangeJet_mem u)

without_proof_info in
theorem haarChangeW1pL_value_ae (u : W1p μ Ω p) :
    W1p.value (haarChangeW1pL μ ν Ω u) =ᵐ[ν.restrict Ω] W1p.value u := by
  rw [W1p.value_coe, W1p.value_coe]
  exact (haarChangeJet_readings_ae (ν := ν) u.val).1

without_proof_info in
theorem haarChangeW1pL_gradient_ae (u : W1p μ Ω p) :
    W1p.gradient (haarChangeW1pL μ ν Ω u) =ᵐ[ν.restrict Ω] W1p.gradient u := by
  rw [W1p.gradient_coe, W1p.gradient_coe]
  exact (haarChangeJet_readings_ae (ν := ν) u.val).2

without_proof_info in
theorem haarChangeW1pL_ofTestFunction (φ : 𝓓(Ω, ℝ)) :
    haarChangeW1pL μ ν Ω (W1p.ofTestFunctionₗ μ Ω p φ) = W1p.ofTestFunctionₗ ν Ω p φ := by
  apply W1p.ext_value
  apply Lp.ext
  filter_upwards [haarChangeW1pL_value_ae (ν := ν) (W1p.ofTestFunctionₗ μ Ω p φ),
    (haar_restrict_absolutelyContinuous (μ := μ) (ν := ν) Ω).ae_eq
      (W1p.value_ofTestFunctionₗ_ae (mu := μ) (p := p) φ),
    W1p.value_ofTestFunctionₗ_ae (mu := ν) (p := p) φ] with x hT hμ hν
  rw [hT, hμ, hν]

without_proof_info in
/-- The canonical identity reading preserves the actual closure of
compactly supported smooth tests that defines the zero Dirichlet trace. -/
theorem haarChangeW1pL_zeroTrace {u : W1p μ Ω p} (hu : u ∈ w1p0Submodule μ Ω p) :
    haarChangeW1pL μ ν Ω u ∈ w1p0Submodule ν Ω p := by
  refine w1p0Submodule_subset_of_isClosed
    ((w1p0Submodule ν Ω p).isClosed.preimage (haarChangeW1pL μ ν Ω).continuous)
    (fun φ => ?_) hu
  change haarChangeW1pL μ ν Ω (W1p.ofTestFunctionₗ μ Ω p φ) ∈ w1p0Submodule ν Ω p
  rw [haarChangeW1pL_ofTestFunction]
  exact W1p.ofTestFunctionₗ_mem_w1p0Submodule φ
end ConformalPoisson

end ProofPart_HaarSobolevReading

/- Proof support: HalfSpaceTangentialHaar.lean, SHA256 347ee489ffb04c1af21b3d584e791def5142a3f8dec779dc5e2a1578e42401ba -/
noncomputable section ProofPart_HalfSpaceTangentialHaar



/- Tangential zero trace for any additive Haar normalization on the
flat model. This is compatible with basis-defined native chart readings. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure (WithLp 2 (ℝ × E))} [μ.IsAddHaarMeasure]
local notation "P" => WithLp 2 (ℝ × E)

without_proof_info in
theorem mem_w1p0_tangential_derivative_haar {a : ℝ}
    (u : W1p0 μ (normalHalfSpace a) 2) (d : W1p μ (normalHalfSpace a) 2)
    (τ : P) (hτ : τ.fst = 0)
    (hd : HasWeakLineDerivOn μ (normalHalfSpace a) (W1p.value u.val) (W1p.value d) τ)
    (hgrad : ∀ y : P, ∃ g : Lp ℝ 2 (μ.restrict (normalHalfSpace (E := E) a : Set P)),
      HasWeakLineDerivOn μ (normalHalfSpace a)
        (fun x => ⟪W1p.gradient u.val x, y⟫_ℝ) g τ) :
    d ∈ w1p0Submodule μ (normalHalfSpace a) 2 := by
  let H := normalHalfSpace (E := E) a
  let U : W1p0 (volume : Measure P) H 2 :=
    ⟨haarChangeW1pL μ volume H u.val, haarChangeW1pL_zeroTrace u.property⟩
  let D := haarChangeW1pL μ volume H d
  have hUv := haarChangeW1pL_value_ae (ν := volume) u.val
  have hUg := haarChangeW1pL_gradient_ae (ν := volume) u.val
  have hDv := haarChangeW1pL_value_ae (ν := volume) d
  have hDU : HasWeakLineDerivOn volume H (W1p.value U.val) (W1p.value D) τ :=
    ((weakLineDeriv_changeHaar (ν := volume) hd).congr_ae hUv.symm).congr_ae_deriv hDv.symm
  have hG : ∀ y : P, ∃ g : Lp ℝ 2 (volume.restrict (H : Set P)),
      HasWeakLineDerivOn volume H (fun x => ⟪W1p.gradient U.val x, y⟫_ℝ) g τ := by
    intro y
    obtain ⟨g, hg⟩ := hgrad y
    refine ⟨haarChangeLp μ volume H ℝ g, ?_⟩
    refine ((weakLineDeriv_changeHaar (ν := volume) hg).congr_ae ?_).congr_ae_deriv ?_
    · filter_upwards [hUg] with x hx
      change _ = ⟪W1p.gradient (haarChangeW1pL μ volume H u.val) x, y⟫_ℝ
      rw [hx]
    · exact (haarChangeLp_ae (ν := volume) H g).symm
  have hD0 := mem_w1p0_tangential_derivative U D τ hτ hDU hG
  have hback := haarChangeW1pL_zeroTrace (ν := μ) hD0
  have hDd : haarChangeW1pL volume μ H D = d := by
    apply W1p.ext_value
    apply Lp.ext
    filter_upwards [haarChangeW1pL_value_ae (ν := μ) D,
      (haar_restrict_absolutelyContinuous (μ := volume) (ν := μ) H).ae_eq hDv] with x hb hd
    rw [hb, hd]
  rwa [hDd] at hback

without_proof_info in
theorem exists_w1p0_tangential_derivative_haar {a : ℝ}
    (u : Wkp μ (normalHalfSpace a) 2 2)
    (hu : Wkp.firstOrder 1 u ∈ w1p0Submodule μ (normalHalfSpace a) 2)
    (τ : P) (hτ : τ.fst = 0) :
    ∃ d : W1p0 μ (normalHalfSpace a) 2,
      HasWeakLineDerivOn μ (normalHalfSpace a) (Wkp.value 2 u) (W1p.value d.val) τ := by
  obtain ⟨d, hd, _⟩ := Wkp.exists_hasWeakLineDerivOn_value_and_inner_gradient_ae_eq u τ
  have hdu : HasWeakLineDerivOn μ (normalHalfSpace a)
      (W1p.value (Wkp.firstOrder 1 u)) (W1p.value d) τ := by
    rwa [Wkp.value_firstOrder]
  exact ⟨⟨d, mem_w1p0_tangential_derivative_haar ⟨Wkp.firstOrder 1 u, hu⟩ d τ hτ hdu
    (fun y => exists_Lp_derivative_H2_gradient u y τ)⟩, hd⟩
end ConformalPoisson

end ProofPart_HalfSpaceTangentialHaar

/- Proof support: TangentialTraceIsometry.lean, SHA256 827890754bb9c1a485fa498e2f3395918d773634719939bdd8da0020b9cd7c0e -/
noncomputable section ProofPart_TangentialTraceIsometry




/- Transport of the actual zero-trace tangential derivative along
a measure-preserving linear isometry. This avoids fixing a Haar
normalization when the native chart domain is read in Euclidean coordinates. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E T : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  [NormedAddCommGroup T] [InnerProductSpace ℝ T]
  [FiniteDimensional ℝ T] [MeasurableSpace T] [BorelSpace T]
  {μ : Measure (WithLp 2 (ℝ × E))} [μ.IsAddHaarMeasure] {ν : Measure T} [ν.IsAddHaarMeasure]

without_proof_info in
theorem mem_w1p0_tangential_derivative_isometry {a : ℝ} {Ω : Opens T}
    (e : WithLp 2 (ℝ × E) ≃ₗᵢ[ℝ] T) (he : MeasurePreserving e μ ν)
    (hH : (normalHalfSpace (E := E) a : Set _) = e ⁻¹' Ω)
    (u : Wkp ν Ω 2 2) (hu : Wkp.firstOrder 1 u ∈ w1p0Submodule ν Ω 2)
    (τ : WithLp 2 (ℝ × E)) (hτ : τ.fst = 0)
    (d : W1p ν Ω 2)
    (hd : HasWeakLineDerivOn ν Ω (Wkp.value 2 u) (W1p.value d) (e τ)) :
    d ∈ w1p0Submodule ν Ω 2 := by
  let H := normalHalfSpace (E := E) a
  let R₁ := Wkp.compLinearIsometryEquiv (p := 2) he hH 1
  let R₂ := Wkp.compLinearIsometryEquiv (p := 2) he hH 2
  let w := R₂ u
  have hfirst : Wkp.firstOrder 1 w = R₁ (Wkp.firstOrder 1 u) := by
    simp only [Wkp.firstOrder_one]
    exact Wkp.lowerOrder_compLinearIsometryEquiv he hH 1 u
  have hu1 : R₁ (Wkp.firstOrder 1 u) ∈ w1p0Submodule μ H 2 := by
    have h := Wkp.compLinearIsometryEquiv_mem_wkp0Submodule he hH 1
      (show Wkp.firstOrder 1 u ∈ wkp0Submodule ν Ω 2 1 by rwa [wkp0Submodule_one])
    rwa [wkp0Submodule_one] at h
  obtain ⟨q, hq⟩ := exists_w1p0_tangential_derivative_haar w (hfirst ▸ hu1) τ hτ
  have heH := hH ▸ he.restrict_preimage Ω.isOpen.measurableSet
  have hval : Wkp.value 2 w =ᵐ[μ.restrict (H : Set _)]
      fun z => Wkp.value 2 u (e z) := Wkp.value_compLinearIsometryEquiv_ae he hH 2 u
  have hdval : W1p.value (R₁ d) =ᵐ[μ.restrict (H : Set _)]
      fun z => W1p.value d (e z) := by
    simpa only [Wkp.value_one] using Wkp.value_compLinearIsometryEquiv_ae he hH 1 d
  have hgrad : (fun x => ⟪W1p.gradient (Wkp.firstOrder 1 u) x, e τ⟫_ℝ) =ᵐ[ν.restrict Ω]
      W1p.value d := by
    apply ((W1p.hasWeakFDerivOn (Wkp.firstOrder 1 u)).hasWeakLineDerivOn (e τ)).ae_eq
    rwa [Wkp.value_firstOrder]
  have hcomp := ((W1p.hasWeakFDerivOn (Wkp.firstOrder 1 u)).comp_continuousLinearEquiv
    e.toContinuousLinearEquiv he (hH ▸ mapsTo_preimage e Ω)).hasWeakLineDerivOn τ
  simp only [ContinuousLinearMap.comp_apply, innerSL_apply_apply, Wkp.value_firstOrder] at hcomp
  have hD : HasWeakLineDerivOn μ H (Wkp.value 2 w) (W1p.value (R₁ d)) τ := by
    refine (hcomp.congr_ae hval.symm).congr_ae_deriv ?_
    filter_upwards [heH.quasiMeasurePreserving.ae hgrad, hdval] with z hg hv
    exact hg.trans hv.symm
  have hDq : R₁ d = q.val := W1p.ext_value (Lp.ext (hD.ae_eq hq))
  have hDz : R₁ d ∈ w1p0Submodule μ H 2 := hDq ▸ q.property
  have hiff := Wkp.compLinearIsometryEquiv_mem_wkp0Submodule_iff he hH 1 (u := d)
  rw [wkp0Submodule_one, wkp0Submodule_one] at hiff
  exact hiff.mp hDz
end ConformalPoisson

end ProofPart_TangentialTraceIsometry

/- Proof support: EuclideanTangentialTrace.lean, SHA256 34f1bb560e56fe1e5257ae8245232d401d3cac29a72346ec943c7e1f0efff9cb -/
noncomputable section ProofPart_EuclideanTangentialTrace



/- Zero Dirichlet trace for tangential derivatives in the exact
Euclidean first-coordinate half-space used by native chart readings.
The Haar normalization is arbitrary. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ContDiff ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {μ : Measure (EuclideanSpace ℝ (Fin (n + 1)))} [μ.IsAddHaarMeasure]
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

without_proof_info in
theorem mem_w1p0_euclidean_tangential_derivative {a : ℝ}
    (u : Wkp μ (euclideanOpenHalfSpace n a) 2 2)
    (hu : Wkp.firstOrder 1 u ∈ w1p0Submodule μ (euclideanOpenHalfSpace n a) 2)
    (τ : V) (hτ : τ 0 = 0) (d : W1p μ (euclideanOpenHalfSpace n a) 2)
    (hd : HasWeakLineDerivOn μ (euclideanOpenHalfSpace n a) (Wkp.value 2 u) (W1p.value d) τ) :
    d ∈ w1p0Submodule μ (euclideanOpenHalfSpace n a) 2 := by
  let e := euclideanNormalSplit n
  let σ : Measure P := μ.map e.symm
  letI : σ.IsAddHaarMeasure := e.symm.toContinuousLinearEquiv.isAddHaarMeasure_map μ
  have he : MeasurePreserving e σ μ := normalSplit_measurePreserving μ
  have ht : (e.symm τ).fst = 0 := (euclideanNormalSplit_symm_fst τ).trans hτ
  apply mem_w1p0_tangential_derivative_isometry e he (normalSplit_preimage_halfSpace n a)
    u hu (e.symm τ) ht d
  simpa only [LinearIsometryEquiv.apply_symm_apply] using hd

without_proof_info in
theorem exists_w1p0_euclidean_tangential_derivative {a : ℝ}
    (u : Wkp μ (euclideanOpenHalfSpace n a) 2 2)
    (hu : Wkp.firstOrder 1 u ∈ w1p0Submodule μ (euclideanOpenHalfSpace n a) 2)
    (τ : V) (hτ : τ 0 = 0) :
    ∃ d : W1p0 μ (euclideanOpenHalfSpace n a) 2,
      HasWeakLineDerivOn μ (euclideanOpenHalfSpace n a) (Wkp.value 2 u) (W1p.value d.val) τ := by
  obtain ⟨d, hd, _⟩ := Wkp.exists_hasWeakLineDerivOn_value_and_inner_gradient_ae_eq u τ
  exact ⟨⟨d, mem_w1p0_euclidean_tangential_derivative u hu τ hτ d hd⟩, hd⟩
end ConformalPoisson

