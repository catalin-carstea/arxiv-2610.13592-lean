noncomputable section ProofPart_RemoteCauchyData







/- Zero remote DN functional gives actual pointwise zero Cauchy data of the Poisson section. -/

open Set Filter MeasureTheory
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M] [CompactSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  [MeasurableSpace M] [BorelSpace M]
  [MeasurableSpace ((𝓡∂ (n + 1)).boundary M)] [BorelSpace ((𝓡∂ (n + 1)).boundary M)]

local instance boundaryCompactSpace : CompactSpace ((𝓡∂ (n + 1)).boundary M) :=
  compactSpace_nativeBoundary

local instance remoteBoundaryAnalyticManifold : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M) :=
  TauCeti.isManifold_boundary (n := n) (k := ω) M (by decide)

without_proof_info in
theorem DirichletGreenKernel.cauchy_zero_of_remote_normal_zero
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (y : (𝓡∂ (n + 1)).boundary M)
    (Γ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M)) (hy : y ∉ Γ)
    (hzero : ∀ f : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)),
      normalDerivative ν (S.solve f.val) y = 0) :
    ∀ z ∈ Γ, boundaryPoissonSection ν G.kernel y z = 0 ∧
      normalDerivative ν (boundaryPoissonSection ν G.kernel y) z = 0 := by
  let := nativeSurfaceMeasure_isLocallyFiniteMeasure g
  let := nativeSurfaceMeasure_isOpenPosMeasure g
  let K := boundaryPoissonSection ν G.kernel y
  have hneq (z : (𝓡∂ (n + 1)).boundary M) (hz : z ∈ Γ) : z ≠ y := by
    rintro rfl
    exact hy hz
  have hK (z : (𝓡∂ (n + 1)).boundary M) (hz : z ∈ Γ) :
      ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ K (z : M) := by
    have hmem : (z : M) ∈ ({(y : M)}ᶜ : Set M) := by
      intro h
      exact hneq z hz (Subtype.ext h)
    exact (G.poisson_section_smooth y z hmem).contMDiffAt
      (isClosed_singleton.isOpen_compl.mem_nhds hmem)
  have hcont : ContinuousOn (normalDerivative ν K) (Γ : Set _) :=
    fun z hz => (continuousAt_normalDerivative g ν hν K z (hK z hz)).continuousWithinAt
  have hae : ∀ᵐ z ∂nativeSurfaceMeasure g, z ∈ Γ → normalDerivative ν K z = 0 := by
    apply Γ.isOpen.ae_eq_zero_of_integral_contMDiff_smul_eq_zero (𝓡 n)
      (hcont.locallyIntegrableOn Γ.isOpen.measurableSet)
    intro f hf hsupp hsub
    let datum : BoundaryDatum (Γ : Set ((𝓡∂ (n + 1)).boundary M)) := ⟨f, hf, hsupp, hsub⟩
    have hyf : y ∉ tsupport f := fun h => hy (hsub h)
    have hrep := (G.mixed_normal_representation f hf y hyf).2
    have h := hrep.symm.trans (hzero datum)
    simpa only [K, smul_eq_mul, mul_comm] using h
  have hpoint : EqOn (normalDerivative ν K) 0 (Γ : Set _) :=
    Measure.eqOn_open_of_ae_eq ((ae_restrict_iff' Γ.isOpen.measurableSet).mpr hae)
      Γ.isOpen hcont continuousOn_const
  exact fun z hz => ⟨G.poisson_section_zero_boundary y z (hneq z hz), hpoint hz⟩

end ConformalPoisson

end ProofPart_RemoteCauchyData

