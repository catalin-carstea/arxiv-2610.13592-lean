  filter_upwards [hv, hur, ae_restrict_of_ae_restrict_of_subset (Set.subset_univ (U : Set E)) hu]
    with x hx hux hzero
  rw [hx, hux]
  by_cases hxK : x ∈ K
  · rw [interior_subset (hχ1 hxK), one_mul]
  · rw [hzero hxK, mul_zero]
