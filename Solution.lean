/- Proof support: HalfSpaceInteriorBalls.lean, SHA256 54807200437bbdd06960b0652656c0a60dd0ce64ef0b32670ccff16069da0cb4 -/
noncomputable section ProofPart_HalfSpaceInteriorBalls



/- Actual relative half-space balls have connected, nonempty manifold
interior. This is a project topology fact, not a PDE premise. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}

def halfSpaceBall (z : EuclideanHalfSpace (n + 1)) (ε : ℝ) : Set (EuclideanHalfSpace (n + 1)) :=
  Subtype.val ⁻¹' Metric.ball z.1 ε

without_proof_info in
theorem halfSpaceBall_isOpen (z : EuclideanHalfSpace (n + 1)) (ε : ℝ) : IsOpen (halfSpaceBall z ε) :=
  Metric.isOpen_ball.preimage continuous_subtype_val

without_proof_info in
theorem exists_halfSpaceBall_subset {z : EuclideanHalfSpace (n + 1)}
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : S ∈ 𝓝 z) :
    ∃ ε : ℝ, 0 < ε ∧ halfSpaceBall z ε ⊆ S := by
  have hnhds : 𝓝 z = Filter.comap (Subtype.val : EuclideanHalfSpace (n + 1) →
      EuclideanSpace ℝ (Fin (n + 1))) (𝓝 z.1) := nhds_subtype_eq_comap
  rw [hnhds] at hS
  obtain ⟨A, hA, hAS⟩ := Filter.mem_comap.mp hS
  obtain ⟨ε, hε, hεA⟩ := Metric.mem_nhds_iff.mp hA
  exact ⟨ε, hε, fun y hy => hAS (hεA hy)⟩

without_proof_info in
theorem halfSpace_mem_interior_iff (z : EuclideanHalfSpace (n + 1)) :
    z ∈ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1)) ↔ 0 < z.1 0 := by
  rw [← (𝓡∂ (n + 1)).compl_boundary, boundary_euclideanHalfSpace]
  change (z.1 0 ≠ 0) ↔ 0 < z.1 0
  exact ⟨fun h => lt_of_le_of_ne z.property h.symm, fun h => h.ne'⟩

without_proof_info in
theorem halfSpace_ball_interior_connected (z : EuclideanHalfSpace (n + 1))
    {ε : ℝ} (hε : 0 < ε) :
    IsConnected (halfSpaceBall z ε ∩ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1))) := by
  have hlin : IsLinearMap ℝ (fun v : EuclideanSpace ℝ (Fin (n + 1)) => v 0) := by
    constructor <;> intros <;> rfl
  have hconv : Convex ℝ (Metric.ball z.1 ε ∩ {v : EuclideanSpace ℝ (Fin (n + 1)) | 0 < v 0}) :=
    (convex_ball z.1 ε).inter (convex_halfSpace_gt hlin 0)
  have himage : (Subtype.val : EuclideanHalfSpace (n + 1) → EuclideanSpace ℝ (Fin (n + 1))) ''
      (halfSpaceBall z ε ∩ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1))) =
      Metric.ball z.1 ε ∩ {v : EuclideanSpace ℝ (Fin (n + 1)) | 0 < v 0} := by
    ext v
    constructor
    · rintro ⟨y, ⟨hyball, hyint⟩, rfl⟩
      exact ⟨hyball, (halfSpace_mem_interior_iff y).mp hyint⟩
    · rintro ⟨hvball, hvint⟩
      refine ⟨⟨v, hvint.le⟩, ⟨hvball, (halfSpace_mem_interior_iff ⟨v, hvint.le⟩).mpr hvint⟩, rfl⟩
  have hnonempty : (halfSpaceBall z ε ∩ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1))).Nonempty :=
    (dense_nativeInterior (n := n) (M := EuclideanHalfSpace (n + 1))).inter_open_nonempty
      (halfSpaceBall z ε) (Metric.isOpen_ball.preimage continuous_subtype_val) ⟨z, Metric.mem_ball_self hε⟩
  refine ⟨hnonempty, ?_⟩
  apply (Topology.IsInducing.isPreconnected_image
    (f := (Subtype.val : EuclideanHalfSpace (n + 1) → EuclideanSpace ℝ (Fin (n + 1))))
    (s := halfSpaceBall z ε ∩ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1)))
    (Topology.IsInducing.subtypeVal (t := {v : EuclideanSpace ℝ (Fin (n + 1)) | 0 ≤ v 0}))).mp
  rw [himage]
  exact hconv.isPreconnected
end ConformalPoisson

end ProofPart_HalfSpaceInteriorBalls

/- Proof support: AmbientDirectionalJets.lean, SHA256 d2c6413422f78e4a13deebcd86f8977b46085846b7adb3d4b4dfe0d80f7c9b74 -/
noncomputable section ProofPart_AmbientDirectionalJets




/- Iterated ambient directional derivatives and actual analytic line
slices. Native normal jets are identified with ordinary line derivatives,
including at boundary time zero. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

def ambientDirectionalJet (v : E) : ℕ → (E → F) → E → F
  | 0, G => G
  | k + 1, G => fun x => fderiv ℝ (ambientDirectionalJet v k G) x v

without_proof_info in
theorem ambientDirectionalJet_analyticAt (v : E) {G : E → F} {x : E}
    (hG : AnalyticAt ℝ G x) (k : ℕ) : AnalyticAt ℝ (ambientDirectionalJet v k G) x := by
  induction k with
  | zero => exact hG
  | succ k ih =>
    exact ((ContinuousLinearMap.apply ℝ F v).analyticAt _).comp ih.fderiv

without_proof_info in
theorem ambientDirectionalJet_line (v : E) {G : E → F} (x : E) {t : ℝ}
    (hG : AnalyticAt ℝ G (x + t • v)) (k : ℕ) :
    iteratedDeriv k (fun s : ℝ => G (x + s • v)) t =
      ambientDirectionalJet v k G (x + t • v) := by
  induction k generalizing t with
  | zero => rfl
  | succ k ih =>
    have hcont : Continuous (fun s : ℝ => x + s • v) := continuous_const.add (continuous_id.smul continuous_const)
    have he : iteratedDeriv k (fun s : ℝ => G (x + s • v)) =ᶠ[𝓝 t]
        (fun s : ℝ => ambientDirectionalJet v k G (x + s • v)) := by
      filter_upwards [hcont.continuousAt.eventually hG.eventually_analyticAt] with s hs
      exact ih hs
    have hcurve : HasDerivAt (fun s : ℝ => x + s • v) v t := by
      simpa only [zero_add, one_smul, Pi.add_def, id_eq] using (hasDerivAt_const t x).add ((hasDerivAt_id t).smul_const v)
    rw [iteratedDeriv_succ, he.deriv_eq]
    exact ((ambientDirectionalJet_analyticAt v hG k).differentiableAt.hasFDerivAt.comp_hasDerivAt t hcurve).deriv

without_proof_info in
theorem normalJet_ambient {n : ℕ}
    {G : EuclideanSpace ℝ (Fin (n + 1)) → F} {z : EuclideanHalfSpace (n + 1)}
    (hG : AnalyticAt ℝ G ((𝓡∂ (n + 1)) z)) (k : ℕ) :
    normalJet k (G ∘ (𝓡∂ (n + 1))) z =
      ambientDirectionalJet (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) k G ((𝓡∂ (n + 1)) z) := by
  induction k generalizing z with
  | zero => rfl
  | succ k ih =>
    have he : normalJet k (G ∘ (𝓡∂ (n + 1))) =ᶠ[𝓝 z]
        (ambientDirectionalJet (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) k G ∘ (𝓡∂ (n + 1))) := by
      filter_upwards [(𝓡∂ (n + 1)).continuous.continuousAt.eventually hG.eventually_analyticAt] with y hy
      exact ih hy
    exact (normalDeriv_eq_of_eventuallyEq he).trans
      (modelDirectionalDeriv_ambient (𝓡∂ (n + 1)) _
        (ambientDirectionalJet_analyticAt _ hG k).differentiableAt)

without_proof_info in
theorem normalJet_ambient_line {n : ℕ}
    {G : EuclideanSpace ℝ (Fin (n + 1)) → F} {z : EuclideanHalfSpace (n + 1)}
    (hG : AnalyticAt ℝ G ((𝓡∂ (n + 1)) z)) (k : ℕ) :
    normalJet k (G ∘ (𝓡∂ (n + 1))) z = iteratedDeriv k
      (fun t : ℝ => G ((𝓡∂ (n + 1)) z + t • euclideanHalfSpaceBoundaryNormalEquiv n (0, 1))) 0 := by
  rw [normalJet_ambient hG k]
  simpa only [zero_smul, add_zero] using (ambientDirectionalJet_line
    (euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)) ((𝓡∂ (n + 1)) z)
    (t := 0) (by simpa only [zero_smul, add_zero] using hG) k).symm
end ConformalPoisson

end ProofPart_AmbientDirectionalJets

/- Proof support: AnalyticVerticalUniqueness.lean, SHA256 cb0606c69cca6522e753b57e290221723ec64d9d5075fc5b46840850e88fa1d2 -/
noncomputable section ProofPart_AnalyticVerticalUniqueness



/- Banach-valued one-dimensional analytic uniqueness on a fixed interval.
Pointwise zero Taylor germs need not have one uniform initial radius: the
identity principle extends each to the SAME connected interval. -/
open Set Filter Topology
namespace ConformalPoisson
variable {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

without_proof_info in
theorem analytic_eventually_zero_of_all_derivatives {f : ℝ → F} {t : ℝ}
    (hf : AnalyticAt ℝ f t) (hj : ∀ k : ℕ, iteratedDeriv k f t = 0) :
    f =ᶠ[𝓝 t] 0 := by
  apply analyticOrderAt_eq_top.mp
  apply ENat.eq_top_iff_forall_ge.mpr
  intro k
  exact (natCast_le_analyticOrderAt_iff_iteratedDeriv_eq_zero hf).mpr (fun i _ => hj i)

without_proof_info in
theorem analytic_eqOn_zero_of_all_derivatives {f : ℝ → F} {I : Set ℝ}
    (hf : AnalyticOnNhd ℝ f I) (hI : IsPreconnected I) {t : ℝ} (ht : t ∈ I)
    (hj : ∀ k : ℕ, iteratedDeriv k f t = 0) : EqOn f 0 I :=
  hf.eqOn_zero_of_preconnected_of_eventuallyEq_zero hI ht
    (analytic_eventually_zero_of_all_derivatives (hf t ht) hj)

without_proof_info in
theorem analytic_vertical_zero {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : E × ℝ → F} {U : Set E} {I : Set ℝ}
    (hH : AnalyticOnNhd ℝ H (U ×ˢ I)) (hI : IsPreconnected I) (h0 : (0 : ℝ) ∈ I)
    (hj : ∀ x ∈ U, ∀ k : ℕ, iteratedDeriv k (fun t => H (x, t)) 0 = 0) :
    EqOn H 0 (U ×ˢ I) := by
  rintro ⟨x, t⟩ ⟨hx, ht⟩
  have hs : AnalyticOnNhd ℝ (fun s => H (x, s)) I := fun s hs =>
    (hH (x, s) ⟨hx, hs⟩).comp (analyticAt_const.prod analyticAt_id)
  exact analytic_eqOn_zero_of_all_derivatives hs hI h0 (hj x hx) ht

without_proof_info in
theorem analytic_product_eventually_zero {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : E × ℝ → F} {x : E} (hH : AnalyticAt ℝ H (x, 0))
    {U : Set E} (hU : U ∈ 𝓝 x)
    (hj : ∀ y ∈ U, ∀ k : ℕ, iteratedDeriv k (fun t => H (y, t)) 0 = 0) :
    H =ᶠ[𝓝 (x, 0)] 0 := by
  obtain ⟨A, hA, B, hB, hAB⟩ := mem_nhds_prod_iff.mp hH.eventually_analyticAt
  obtain ⟨ε, hε, hεB⟩ := Metric.mem_nhds_iff.mp hB
  have hzero : EqOn H 0 ((A ∩ U) ×ˢ Metric.ball (0 : ℝ) ε) :=
    analytic_vertical_zero (fun p hp => hAB ⟨hp.1.1, hεB hp.2⟩)
      (convex_ball (0 : ℝ) ε).isPreconnected (Metric.mem_ball_self hε)
      (fun y hy => hj y hy.2)
  exact Filter.eventuallyEq_of_mem
    (prod_mem_nhds (inter_mem hA hU) (Metric.ball_mem_nhds (0 : ℝ) hε)) hzero
end ConformalPoisson

end ProofPart_AnalyticVerticalUniqueness

/- Proof support: NormalAnalyticGerm.lean, SHA256 d36739324858a58cd9ed9dab32584b2fee6f713414c421d8113c656a5395391b -/
noncomputable section ProofPart_NormalAnalyticGerm




/- All native normal-jet FUNCTIONS on a boundary neighborhood determine
the analytic germ. Proof: one genuine ambient representative, one signed
product rectangle and the one-dimensional identity principle on each
vertical interval. No infinite neighborhood intersection is used. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

without_proof_info in
theorem boundaryNormalEquiv_split (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) :
    euclideanHalfSpaceBoundaryNormalEquiv n (x, t) = euclideanHalfSpaceBoundaryParam n x +
      t • euclideanHalfSpaceBoundaryNormalEquiv n (0, 1) := by
  ext i
  refine Fin.cases ?_ (fun j => ?_) i <;> simp

without_proof_info in
theorem native_analytic_eventually_zero_of_normalJets
    {f : EuclideanHalfSpace (n + 1) → F} {x : EuclideanSpace ℝ (Fin n)}
    (hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f (EuclideanHalfSpace.boundaryParam n x))
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W) (hx : x ∈ W)
    (hj : ∀ k : ℕ, ∀ y ∈ W, normalJet k f (EuclideanHalfSpace.boundaryParam n y) = 0) :
    f =ᶠ[𝓝 (EuclideanHalfSpace.boundaryParam n x)] 0 := by
  obtain ⟨G, hG, he⟩ := model_exists_analytic_extension (𝓡∂ (n + 1)) hf
  have hpoint (y : EuclideanSpace ℝ (Fin n)) :
      (𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n y) = euclideanHalfSpaceBoundaryParam n y := by
    simp only [modelWithCornersEuclideanHalfSpace_toFun, EuclideanHalfSpace.boundaryParam_coe]
  have hGx : AnalyticAt ℝ G (euclideanHalfSpaceBoundaryParam n x) := hpoint x ▸ hG
  let H := G ∘ euclideanHalfSpaceBoundaryNormalEquiv n
  have hbase : euclideanHalfSpaceBoundaryNormalEquiv n (x, 0) =
      (𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n x) := by
    rw [euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam, hpoint]
  have hH : AnalyticAt ℝ H (x, 0) := by
    have hG' : AnalyticAt ℝ G (euclideanHalfSpaceBoundaryNormalEquiv n (x, 0)) := hbase.symm ▸ hG
    exact hG'.comp ((euclideanHalfSpaceBoundaryNormalEquiv n).analyticAt _)
  let U := W ∩ {y | AnalyticAt ℝ G (euclideanHalfSpaceBoundaryParam n y)}
  have hU : U ∈ 𝓝 x := inter_mem (hW.mem_nhds hx)
    ((euclideanHalfSpaceBoundaryParam n).continuous.continuousAt.eventually hGx.eventually_analyticAt)
  have hzero : H =ᶠ[𝓝 (x, 0)] 0 := by
    apply analytic_product_eventually_zero hH hU
    intro y hy k
    have hGy : AnalyticAt ℝ G ((𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n y)) :=
      (hpoint y).symm ▸ hy.2
    have hfun : (fun t : ℝ => H (y, t)) =
        (fun t : ℝ => G ((𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n y) +
          t • euclideanHalfSpaceBoundaryNormalEquiv n (0, 1))) := by
      funext t
      change G (euclideanHalfSpaceBoundaryNormalEquiv n (y, t)) = _
      rw [boundaryNormalEquiv_split y t, hpoint]
    rw [hfun, ← normalJet_ambient_line hGy k, ← he]
    exact hj k y hy.1
  have hval : (euclideanHalfSpaceBoundaryNormalEquiv n).symm
      ((𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n x)) = (x, 0) := by
    rw [← hbase, ContinuousLinearEquiv.symm_apply_apply]
  have hT : Tendsto ((euclideanHalfSpaceBoundaryNormalEquiv n).symm ∘ (𝓡∂ (n + 1)))
      (𝓝 (EuclideanHalfSpace.boundaryParam n x)) (𝓝 (x, 0)) := by
    have hc : ContinuousAt ((euclideanHalfSpaceBoundaryNormalEquiv n).symm ∘ (𝓡∂ (n + 1)))
        (EuclideanHalfSpace.boundaryParam n x) :=
      ((euclideanHalfSpaceBoundaryNormalEquiv n).symm.continuous.comp (𝓡∂ (n + 1)).continuous).continuousAt
    change Tendsto _ _ (𝓝 ((euclideanHalfSpaceBoundaryNormalEquiv n).symm
      ((𝓡∂ (n + 1)) (EuclideanHalfSpace.boundaryParam n x)))) at hc
    simpa only [hval] using hc
  filter_upwards [hzero.comp_tendsto hT] with z hz
  rw [he]
  simpa only [H, Function.comp_apply, ContinuousLinearEquiv.apply_symm_apply, Pi.zero_apply] using hz

without_proof_info in
theorem native_analytic_eventuallyEq_of_normalJets
    {f g : EuclideanHalfSpace (n + 1) → F}
    {S : Set (EuclideanHalfSpace (n + 1))} (hS : IsOpen S)
    (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f S)
    (hg : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω g S)
    {W : Set (EuclideanSpace ℝ (Fin n))} (hW : IsOpen W)
    (hWS : MapsTo (EuclideanHalfSpace.boundaryParam n) W S)
    {x : EuclideanSpace ℝ (Fin n)} (hx : x ∈ W)
    (hj : ∀ k : ℕ, EqOn (normalJet k f ∘ EuclideanHalfSpace.boundaryParam n)
      (normalJet k g ∘ EuclideanHalfSpace.boundaryParam n) W) :
    f =ᶠ[𝓝 (EuclideanHalfSpace.boundaryParam n x)] g := by
  have hfAt := (hf _ (hWS hx)).contMDiffAt (hS.mem_nhds (hWS hx))
  have hgAt := (hg _ (hWS hx)).contMDiffAt (hS.mem_nhds (hWS hx))
  have hzero := native_analytic_eventually_zero_of_normalJets (hfAt.sub hgAt) hW hx
    (fun k y hy => by
      have h := normalJet_sub_eqOn hS (hf.of_le le_top) (hg.of_le le_top) k (hWS hy)
      exact h.trans (sub_eq_zero.mpr (hj k hy)))
  filter_upwards [hzero] with z hz
  exact sub_eq_zero.mp hz
end ConformalPoisson

end ProofPart_NormalAnalyticGerm

/- Proof support: NormalChartMetricComparison.lean, SHA256 a8bb057b290b6741bd87ebd93d5dd77ae28a420adf4e07f91a5151846543bc3d -/
noncomputable section ProofPart_NormalChartMetricComparison



/- Equality of the actual tangential Gram matrices plus the actual Gauss
identities gives equality of the full native pullback bilinear tensors. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]
  {g : Metric (n := n) (M := M)}
  {χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω}

without_proof_info in
theorem NormalChartGeometry.inner_pair (G : NormalChartGeometry g χ)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ χ.source)
    (v w : EuclideanSpace ℝ (Fin n)) (r s : ℝ) :
    g.inner (χ z)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z (euclideanHalfSpaceBoundaryNormalEquiv n (v, r)))
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z (euclideanHalfSpaceBoundaryNormalEquiv n (w, s))) =
      normalTangentialForm g χ z v w + r * s := by
  let D := mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z
  let T := euclideanHalfSpaceBoundaryNormalEquiv n (0, 1)
  have hT : g.inner (χ z) (D T) (D T) = 1 := G.time_inner z hz
  have hv : g.inner (χ z) (D (euclideanHalfSpaceBoundaryParam n v)) (D T) = 0 := by
    simpa only [euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam] using G.spatial_time_inner z hz v
  have hw : g.inner (χ z) (D T) (D (euclideanHalfSpaceBoundaryParam n w)) = 0 := by
    rw [g.symm]
    simpa only [euclideanHalfSpaceBoundaryNormalEquiv_apply_zero_eq_boundaryParam] using G.spatial_time_inner z hz w
  change g.inner (χ z) (D _) (D _) =
    g.inner (χ z) (D (euclideanHalfSpaceBoundaryParam n v)) (D (euclideanHalfSpaceBoundaryParam n w)) + r * s
  rw [boundaryNormalEquiv_split v r, boundaryNormalEquiv_split w s]
  simp only [map_add, map_smul, add_apply, smul_apply, smul_eq_mul]
  rw [hv, hw, hT]
  ring

without_proof_info in
theorem normalChart_inner_eq_of_gram_eq
    {M₂ : Type*} [TopologicalSpace M₂]
    [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂] [IsManifold (𝓡∂ (n + 1)) ω M₂]
    {g₂ : Metric (n := n) (M := M₂)}
    {χ₂ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω}
    (G₁ : NormalChartGeometry g χ) (G₂ : NormalChartGeometry g₂ χ₂)
    {z : EuclideanHalfSpace (n + 1)} (hz₁ : z ∈ χ.source) (hz₂ : z ∈ χ₂.source)
    (hgram : normalTangentialGram g χ z = normalTangentialGram g₂ χ₂ z)
    (u v : EuclideanSpace ℝ (Fin (n + 1))) :
    g.inner (χ z) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z u)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ z v) =
    g₂.inner (χ₂ z) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ₂ z u)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ₂ z v) := by
  have hform : normalTangentialForm g χ z = normalTangentialForm g₂ χ₂ z :=
    (LinearMap.BilinForm.toMatrix (EuclideanSpace.basisFun (Fin n) ℝ).toBasis).injective hgram
  obtain ⟨a, b⟩ := (euclideanHalfSpaceBoundaryNormalEquiv n).surjective u
  obtain ⟨c, d⟩ := (euclideanHalfSpaceBoundaryNormalEquiv n).surjective v
  rcases a with ⟨a, r⟩
  rcases c with ⟨c, s⟩
  rw [← b, ← d, G₁.inner_pair hz₁, G₂.inner_pair hz₂, hform]
end ConformalPoisson

end ProofPart_NormalChartMetricComparison

/- Proof support: NativeRestrictionOperator.lean, SHA256 d6bd14f25223b0084896d50b541fd58a11c140e5c1e92fd88d6398e9c7aef30b -/
noncomputable section ProofPart_NativeRestrictionOperator






/- Restriction of the actual signed-potential operator to an open submanifold. -/

open Bundle
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem schrodinger_restrictOpen (g : Metric (n := n) (M := M)) (U : TopologicalSpace.Opens M)
    (q u : M → ℝ) (x : U) (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u (x : M)) :
    schrodinger (g.restrictOpenTangentSpace U) (fun y : U => q y) (fun y : U => u y) x =
      schrodinger g q u (x : M) := by
  let : RiemannianBundle (fun y : U => TangentSpace (𝓡∂ (n + 1)) y) :=
    ⟨(g.restrictOpenTangentSpace U).toRiemannianMetric⟩
  let : RiemannianBundle (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : U => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 V
      (fun y : M => TangentSpace (𝓡∂ (n + 1)) y) :=
    IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  have hiso := g.isLocalRiemannianIsometry_restrictOpenTangentSpace U
  change -TauCeti.Manifold.laplaceBeltrami (𝓡∂ (n + 1)) (u ∘ (Subtype.val : U → M)) x +
      q x * u x = -TauCeti.Manifold.laplaceBeltrami (𝓡∂ (n + 1)) u (x : M) + q x * u x
  rw [hiso.laplaceBeltrami_comp hu]

end ConformalPoisson

end ProofPart_NativeRestrictionOperator

/- Proof support: NativeIsometryOperator.lean, SHA256 005ee06ca253cbbc604141ea9617c095512e3c57d559a0e55337a40866eb2d5e -/
noncomputable section ProofPart_NativeIsometryOperator




/- Naturality of the actual signed-potential operator under an actual
local isometry, including a partial diffeomorphism on an open source. -/
open Bundle Set TauCeti TauCeti.Manifold Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem schrodinger_comp_of_native_isometry
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂)) (J : M₁ → M₂)
    (hJ : letI : RiemannianBundle (fun x : M₁ => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g₁.toRiemannianMetric⟩;
      let : RiemannianBundle (fun x : M₂ => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g₂.toRiemannianMetric⟩;
      IsLocalRiemannianIsometry (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J)
    (q u : M₂ → ℝ) (x : M₁) (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u (J x)) :
    schrodinger g₁ (q ∘ J) (u ∘ J) x = schrodinger g₂ q u (J x) := by
  let : RiemannianBundle (fun x : M₁ => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g₁.toRiemannianMetric⟩
  let : RiemannianBundle (fun x : M₂ => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g₂.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M₁ => TangentSpace (𝓡∂ (n + 1)) x) := IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  let : IsContMDiffRiemannianBundle (𝓡∂ (n + 1)) 1 (EuclideanSpace ℝ (Fin (n + 1)))
      (fun x : M₂ => TangentSpace (𝓡∂ (n + 1)) x) := IsContMDiffRiemannianBundle.of_le (n := ∞) (by decide)
  change -TauCeti.Manifold.laplaceBeltrami (𝓡∂ (n + 1)) (u ∘ J) x + q (J x) * u (J x) =
    -TauCeti.Manifold.laplaceBeltrami (𝓡∂ (n + 1)) u (J x) + q (J x) * u (J x)
  rw [hJ.laplaceBeltrami_comp hu]

without_proof_info in
theorem partialDiffeomorph_restrict_isometry
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ J.source)
    (hmetric : ∀ x ∈ U, ∀ v w : TangentSpace (𝓡∂ (n + 1)) x,
      g₂.inner (J x) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x w) = g₁.inner x v w) :
    let : RiemannianBundle (fun x : U => TangentSpace (𝓡∂ (n + 1)) x) :=
      ⟨(g₁.restrictOpenTangentSpace U).toRiemannianMetric⟩;
    let : RiemannianBundle (fun x : M₂ => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g₂.toRiemannianMetric⟩;
    IsLocalRiemannianIsometry (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun x : U => J x) := by
  let : RiemannianBundle (fun x : U => TangentSpace (𝓡∂ (n + 1)) x) :=
    ⟨(g₁.restrictOpenTangentSpace U).toRiemannianMetric⟩
  let : RiemannianBundle (fun x : M₂ => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g₂.toRiemannianMetric⟩
  have hJat (x : U) : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J (x : M₁) :=
    (J.contMDiffOn_toFun _ (hU x.property)).contMDiffAt (J.open_source.mem_nhds (hU x.property))
  have hd (x : U) : mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun x : U => J x) x =
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J (x : M₁)).comp
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (Subtype.val : U → M₁) x) :=
    mfderiv_comp x ((hJat x).mdifferentiableAt (by decide))
      ((contMDiff_subtype_val (I := 𝓡∂ (n + 1)) (n := ω)).mdifferentiable (by decide : (ω : ℕ∞ω) ≠ 0) x)
  refine ⟨(fun x => ((hJat x).comp x contMDiff_subtype_val.contMDiffAt).of_le le_top), ?_, ?_⟩
  · intro x
    rw [hd]
    exact ContinuousLinearMap.IsInvertible.comp
      ((PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω J
        (hU x.property)).isInvertible_mfderiv (by decide))
      ⟨tangentSpaceOpenEquiv x, (mfderiv_subtype_val x).symm⟩
  · intro x v w
    rw [Bundle.ContMDiffRiemannianMetric.inner_riemannianBundle g₂,
      Bundle.ContMDiffRiemannianMetric.inner_riemannianBundle (g₁.restrictOpenTangentSpace U), hd]
    simp only [ContinuousLinearMap.comp_apply]
    have h := g₁.toRiemannianMetric.restrictOpenTangentSpace_inner_mfderiv_subtype_val U x v w
    rw [← Bundle.ContMDiffRiemannianMetric.restrictOpenTangentSpace_toRiemannianMetric] at h
    exact (hmetric x x.property _ _).trans h.symm

without_proof_info in
theorem schrodinger_comp_of_partial_native_isometry
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (J : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω)
    (U : TopologicalSpace.Opens M₁) (hU : (U : Set M₁) ⊆ J.source)
    (hmetric : ∀ x ∈ U, ∀ v w : TangentSpace (𝓡∂ (n + 1)) x,
      g₂.inner (J x) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x w) = g₁.inner x v w)
    (q u : M₂ → ℝ) {x : M₁} (hx : x ∈ U)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u (J x)) :
    schrodinger g₁ (q ∘ J) (u ∘ J) x = schrodinger g₂ q u (J x) := by
  let xU : U := ⟨x, hx⟩
  have hJat := (J.contMDiffOn_toFun x (hU hx)).contMDiffAt (J.open_source.mem_nhds (hU hx))
  have hres := schrodinger_restrictOpen g₁ U (q ∘ J) (u ∘ J) xU
    (hu.comp x (hJat.of_le (by decide)))
  exact hres.symm.trans (schrodinger_comp_of_native_isometry (g₁.restrictOpenTangentSpace U) g₂
    (fun x : U => J x) (partialDiffeomorph_restrict_isometry g₁ g₂ J U hU hmetric) q u xU hu)
end ConformalPoisson

end ProofPart_NativeIsometryOperator

/- Proof support: NormalChartTransition.lean, SHA256 8fa00fa596e1717f3e56eecd90862211f1eadad64d107d009713783e9e77393b -/
noncomputable section ProofPart_NormalChartTransition




/- The actual analytic transition chi2 o chi1^-1, its native derivative
and full metric preservation where the actual normal-chart Grams agree. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  (χ₁ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₁ ω)
  (χ₂ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M₂ ω)

omit [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂] in
without_proof_info in
theorem partialDiffeomorph_halfSpace_zero_of_boundary
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ χ₁.source)
    (hyB : χ₁ z ∈ (𝓡∂ (n + 1)).boundary M₁) : z.1 0 = 0 := by
  have hzB := (PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω
    χ₁ hz).isBoundaryPoint_iff (by decide : (ω : ℕ∞ω) ≠ 0) |>.mpr hyB
  change z ∈ (𝓡∂ (n + 1)).boundary (EuclideanHalfSpace (n + 1)) at hzB
  rwa [boundary_euclideanHalfSpace] at hzB

def normalChartTransition : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) M₁ M₂ ω := χ₁.symm.trans χ₂

omit [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂] in
without_proof_info in
theorem normalChartTransition_apply {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ χ₁.source) :
    normalChartTransition χ₁ χ₂ (χ₁ z) = χ₂ z := by
  change χ₂ (χ₁.symm (χ₁ z)) = χ₂ z
  exact congrArg (fun y => χ₂ y) (χ₁.left_inv hz)

omit [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂] in
without_proof_info in
theorem normalChartTransition_mem_source {z : EuclideanHalfSpace (n + 1)}
    (hz₁ : z ∈ χ₁.source) (hz₂ : z ∈ χ₂.source) :
    χ₁ z ∈ (normalChartTransition χ₁ χ₂).source := by
  change χ₁ z ∈ χ₁.target ∧ χ₁.symm (χ₁ z) ∈ χ₂.source
  exact ⟨χ₁.map_source hz₁, (χ₁.left_inv hz₁).symm ▸ hz₂⟩

omit [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂] in
without_proof_info in
theorem normalChartTransition_differential {z : EuclideanHalfSpace (n + 1)}
    (hz₁ : z ∈ χ₁.source) (hz₂ : z ∈ χ₂.source)
    (v : EuclideanSpace ℝ (Fin (n + 1))) :
    mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition χ₁ χ₂) (χ₁ z)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ₁ z v) =
    mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) χ₂ z v := by
  change mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (χ₂ ∘ χ₁.symm) (χ₁ z) _ = _
  rw [mfderiv_comp_apply_of_eq (χ₁ z)
    (χ₂.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) hz₂)
    (χ₁.symm.mdifferentiableAt (by decide : (ω : ℕ∞ω) ≠ 0) (χ₁.map_source hz₁)) (χ₁.left_inv hz₁)]
  rw [χ₁.mfderiv_symm_apply_mfderiv_apply (by decide : (ω : ℕ∞ω) ≠ 0) hz₁]

without_proof_info in
theorem normalChartTransition_inner
    (g₁ : Metric (n := n) (M := M₁)) (g₂ : Metric (n := n) (M := M₂))
    (G₁ : NormalChartGeometry g₁ χ₁) (G₂ : NormalChartGeometry g₂ χ₂)
    {z : EuclideanHalfSpace (n + 1)} (hz₁ : z ∈ χ₁.source) (hz₂ : z ∈ χ₂.source)
    (hgram : normalTangentialGram g₁ χ₁ z = normalTangentialGram g₂ χ₂ z)
    (u v : TangentSpace (𝓡∂ (n + 1)) (χ₁ z)) :
    g₂.inner (normalChartTransition χ₁ χ₂ (χ₁ z))
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition χ₁ χ₂) (χ₁ z) u)
      (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (normalChartTransition χ₁ χ₂) (χ₁ z) v) =
      g₁.inner (χ₁ z) u v := by
  have hInv := (PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω χ₁ hz₁).isInvertible_mfderiv
    (by decide : (ω : ℕ∞ω) ≠ 0)
  have hsurj := hInv.surjective
  obtain ⟨a, rfl⟩ := hsurj u
  obtain ⟨b, rfl⟩ := hsurj v
  rw [normalChartTransition_differential χ₁ χ₂ hz₁ hz₂,
    normalChartTransition_differential χ₁ χ₂ hz₁ hz₂, normalChartTransition_apply χ₁ χ₂ hz₁]
  exact (normalChart_inner_eq_of_gram_eq G₁ G₂ hz₁ hz₂ hgram a b).symm
end ConformalPoisson

end ProofPart_NormalChartTransition

/- Proof support: ConnectedInteriorNeighborhood.lean, SHA256 7980add37b63fbb53119c620fc4b41ce28edc62009168b42d2e5fceaeab8cab1 -/
noncomputable section ProofPart_ConnectedInteriorNeighborhood



/- An actual chart produces a smaller original-manifold neighborhood
whose native interior is connected, inside any prescribed open hood. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

omit [IsManifold (𝓡∂ (n + 1)) ω M] in
without_proof_info in
theorem exists_chart_neighborhood_connected_interior
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ χ.source)
    (U : TopologicalSpace.Opens M) (hU : χ z ∈ U) :
    ∃ V : TopologicalSpace.Opens M, χ z ∈ V ∧ V ≤ U ∧ (V : Set M) ⊆ χ.target ∧
      IsConnected ((V : Set M) ∩ (𝓡∂ (n + 1)).interior M) := by
  have hO : IsOpen (χ.source ∩ χ ⁻¹' (U : Set M)) :=
    χ.contMDiffOn_toFun.continuousOn.isOpen_inter_preimage χ.open_source U.isOpen
  obtain ⟨ε, hε, hεsub⟩ := exists_halfSpaceBall_subset (hO.mem_nhds ⟨hz, hU⟩)
  have hBsub : halfSpaceBall z ε ⊆ χ.source := fun y hy => (hεsub hy).1
  have hVopen : IsOpen (χ '' halfSpaceBall z ε) :=
    χ.toOpenPartialHomeomorph.isOpen_image_of_subset_source (halfSpaceBall_isOpen z ε) hBsub
  let V : TopologicalSpace.Opens M := ⟨χ '' halfSpaceBall z ε, hVopen⟩
  have himage : χ '' (halfSpaceBall z ε ∩ (𝓡∂ (n + 1)).interior (EuclideanHalfSpace (n + 1))) =
      (V : Set M) ∩ (𝓡∂ (n + 1)).interior M := by
    ext y
    constructor
    · rintro ⟨a, ⟨ha, haI⟩, rfl⟩
      refine ⟨⟨a, ha, rfl⟩, ?_⟩
      exact (PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω χ
        (hBsub ha)).isInteriorPoint_iff (by decide : (ω : ℕ∞ω) ≠ 0) |>.mp haI
    · rintro ⟨⟨a, ha, rfl⟩, hyI⟩
      refine ⟨a, ⟨ha, ?_⟩, rfl⟩
      exact (PartialDiffeomorph.isLocalDiffeomorphAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω χ
        (hBsub ha)).isInteriorPoint_iff (by decide : (ω : ℕ∞ω) ≠ 0) |>.mpr hyI
  refine ⟨V, ⟨z, Metric.mem_ball_self hε, rfl⟩, ?_, ?_, ?_⟩
  · rintro y ⟨a, ha, rfl⟩
    exact (hεsub ha).2
  · rintro y ⟨a, ha, rfl⟩
    exact χ.map_source (hBsub ha)
  · rw [← himage]
    exact (halfSpace_ball_interior_connected z hε).image χ
      (χ.contMDiffOn_toFun.continuousOn.mono (fun a ha => hBsub ha.1))
end ConformalPoisson

end ProofPart_ConnectedInteriorNeighborhood

/- Proof support: NativeInteriorConnected.lean, SHA256 6b9dbf695328b222b6957efc3cafd31268f84594eb21a42b8d4e65260a244e0f -/
noncomputable section ProofPart_NativeInteriorConnected



/- Connectedness of the actual manifold interior follows from the
paper's connectedness hypothesis. Local connected-interior neighborhoods
prevent distinct interior regions meeting only along the boundary. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson

without_proof_info in
theorem dense_preconnected_of_local_intersections {X : Type*} [TopologicalSpace X]
    {S : Set X} (hX : IsPreconnected (univ : Set X)) (hS : Dense S)
    (hloc : ∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ IsPreconnected (U ∩ S)) :
    IsPreconnected S := by
  intro u v hu hv hcover hSu hSv
  by_contra hno
  let A := S ∩ u
  let B := S ∩ v
  have hAB : S ⊆ A ∪ B := by
    intro x hx
    rcases hcover hx with h | h
    · exact Or.inl ⟨hx, h⟩
    · exact Or.inr ⟨hx, h⟩
  have hclosure : (univ : Set X) ⊆ closure A ∪ closure B := by
    rw [← closure_union, ← hS.closure_eq]
    exact closure_mono hAB
  have hAne : ((univ : Set X) ∩ closure A).Nonempty := by
    obtain ⟨a, ha⟩ := hSu
    exact ⟨a, trivial, subset_closure ha⟩
  have hBne : ((univ : Set X) ∩ closure B).Nonempty := by
    obtain ⟨b, hb⟩ := hSv
    exact ⟨b, trivial, subset_closure hb⟩
  obtain ⟨x, _, hxA, hxB⟩ := isPreconnected_closed_iff.mp hX (closure A) (closure B)
    isClosed_closure isClosed_closure hclosure hAne hBne
  obtain ⟨U, hU, hxU, hUS⟩ := hloc x
  obtain ⟨a, haU, haS, hau⟩ := mem_closure_iff.mp hxA U hU hxU
  obtain ⟨b, hbU, hbS, hbv⟩ := mem_closure_iff.mp hxB U hU hxU
  obtain ⟨z, ⟨hzU, hzS⟩, hzu, hzv⟩ := hUS u v hu hv (fun _ hz => hcover hz.2)
    ⟨a, ⟨haU, haS⟩, hau⟩ ⟨b, ⟨hbU, hbS⟩, hbv⟩
  exact hno ⟨z, hzS, hzu, hzv⟩

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem exists_native_neighborhood_connected_interior (x : M) :
    ∃ U : TopologicalSpace.Opens M, x ∈ U ∧ IsConnected ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M) := by
  let χ := (nativeChartPartialDiffeomorph (n := n) x).symm
  let z := nativeChartPartialDiffeomorph (n := n) x x
  have hx : x ∈ (nativeChartPartialDiffeomorph (n := n) x).source := mem_chart_source _ _
  have hz : z ∈ χ.source := (nativeChartPartialDiffeomorph (n := n) x).map_source hx
  have hpoint : χ z = x := (nativeChartPartialDiffeomorph (n := n) x).left_inv hx
  obtain ⟨U, hxU, _, _, hconnected⟩ := exists_chart_neighborhood_connected_interior χ hz ⊤ (mem_univ _)
  exact ⟨U, hpoint ▸ hxU, hconnected⟩

without_proof_info in
theorem nativeInterior_connected (hM : IsConnected (univ : Set M)) :
    IsConnected ((𝓡∂ (n + 1)).interior M) := by
  have hD := dense_nativeInterior (n := n) (M := M)
  have hnonempty : ((𝓡∂ (n + 1)).interior M).Nonempty := by
    obtain ⟨x, hx, _⟩ := hD.exists_mem_open isOpen_univ hM.nonempty
    exact ⟨x, hx⟩
  refine ⟨hnonempty, dense_preconnected_of_local_intersections hM.isPreconnected hD ?_⟩
  intro x
  obtain ⟨U, hxU, hconnected⟩ := exists_native_neighborhood_connected_interior (n := n) x
  exact ⟨U, U.isOpen, hxU, hconnected.isPreconnected⟩
end ConformalPoisson

end ProofPart_NativeInteriorConnected

/- Proof support: NativeInteriorNeighborhood.lean, SHA256 d2ae1f59a4f7dfe0875e96c7d0c9a58a26786ba27f53f104f39bda8c1014fff4 -/
noncomputable section ProofPart_NativeInteriorNeighborhood


/- ONE connected original interior neighborhood inside any finite
germ of conditions; no boundaryless instance on the original manifold. -/
open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

without_proof_info in
theorem exists_native_interior_neighborhood {x : M}
    (hx : x ∈ (𝓡∂ (n + 1)).interior M) {S : Set M} (hS : S ∈ 𝓝 x) :
    ∃ U : TopologicalSpace.Opens M, x ∈ U ∧ (U : Set M) ⊆ S ∧
      (U : Set M) ⊆ (𝓡∂ (n + 1)).interior M ∧ IsConnected (U : Set M) := by
  have hi := ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).mem_nhds hx
  obtain ⟨O, hOsub, hOopen, hxO⟩ := mem_nhds_iff.mp (inter_mem hS hi)
  let χ := (nativeChartPartialDiffeomorph (n := n) x).symm
  let z := nativeChartPartialDiffeomorph (n := n) x x
  have hxc : x ∈ (nativeChartPartialDiffeomorph (n := n) x).source := mem_chart_source _ _
  have hz : z ∈ χ.source := (nativeChartPartialDiffeomorph (n := n) x).map_source hxc
  have hpoint : χ z = x := (nativeChartPartialDiffeomorph (n := n) x).left_inv hxc
  obtain ⟨U, hxU, hUO, _, hconn⟩ := exists_chart_neighborhood_connected_interior χ hz
    ⟨O, hOopen⟩ (hpoint.symm ▸ hxO)
  have hUI : (U : Set M) ⊆ (𝓡∂ (n + 1)).interior M := fun y hy => (hOsub (hUO hy)).2
  refine ⟨U, hpoint ▸ hxU, (fun y hy => (hOsub (hUO hy)).1), hUI, ?_⟩
  simpa only [inter_eq_left.mpr hUI] using hconn
end ConformalPoisson

end ProofPart_NativeInteriorNeighborhood

/- Proof support: InteriorContinuationNeighborhood.lean, SHA256 a4314e04b1eabab78c3aa537c796bfd1595b26e679d24941ce37a21c70b4be2b -/
noncomputable section ProofPart_InteriorContinuationNeighborhood



/- One connected interior neighborhood for the explicit continued map
and multiplier. ONLY the two denominator solutions are positive. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

structure InteriorContinuationNeighborhood (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) where
  domain : TopologicalSpace.Opens M₁
  base_mem : x ∈ domain
  connected : IsConnected (domain : Set M₁)
  inside : (domain : Set M₁) ⊆ (𝓡∂ (n + 1)).interior M₁
  image : MapsTo R.continuedMap domain ((𝓡∂ (n + 1)).interior M₂)
  map_analytic : ContMDiffOn (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω R.continuedMap domain
  multiplier_analytic : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω R.continuedMultiplier domain
  positive : ∀ z ∈ domain, 0 < R.continuedMultiplier z
  source_positive : ∀ z ∈ domain, 0 < D.solver₁.solve R.denominator.val z
  target_positive : ∀ z ∈ domain,
    0 < D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.continuedMap z)

set_option maxHeartbeats 800000 in
without_proof_info in
theorem exists_interiorContinuationNeighborhood (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y)
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hx : x ∈ (𝓡∂ (n + 1)).interior M₁) (hy : y ∈ (𝓡∂ (n + 1)).interior M₂) :
    Nonempty (InteriorContinuationNeighborhood R) := by
  let F := R.continuedMap
  let a := D.solver₁.solve R.denominator.val
  let b := D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) ∘ F
  have hF := R.continuedMap_analyticAt hReg₁ hx
  have ha : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω a x :=
    D.solver₁.analyticAt_interior hReg₁ A₁.metric A₁.potential A₁.analytic_potential
      R.denominator.val R.denominator.property.1 x hx
  let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match R.denominator
  have hbtarget := D.solver₂.analyticAt_interior hReg₂ A₂.metric A₂.potential A₂.analytic_potential
    f₂.val f₂.property.1 y hy
  have hb : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω b x := by
    apply ContMDiffAt.comp x _ hF
    change ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω (D.solver₂.solve f₂.val) (R.continuedMap x)
    rw [R.continuedMap_base]
    exact hbtarget
  have hb₀ : b x = 1 := by
    change D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.continuedMap x) = 1
    rw [R.continuedMap_base, R.target_one]
  have hc : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω R.continuedMultiplier x :=
    ha.div₀ hb (by change b x ≠ 0; rw [hb₀]; exact one_ne_zero)
  have hapos := ha.continuousAt.eventually (eventually_gt_nhds R.source_positive)
  have hbpos := hb.continuousAt.eventually (eventually_gt_nhds (show 0 < b x by rw [hb₀]; exact zero_lt_one))
  have himage : F ⁻¹' ((𝓡∂ (n + 1)).interior M₂) ∈ 𝓝 x := by
    apply hF.continuousAt.preimage_mem_nhds
    rw [R.continuedMap_base]
    exact ((𝓡∂ (n + 1)).isOpen_interior (n := ω) (by decide)).mem_nhds hy
  let S := {z : M₁ | F z ∈ (𝓡∂ (n + 1)).interior M₂ ∧ 0 < a z ∧ 0 < b z ∧
    ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) ω F z ∧
    ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω R.continuedMultiplier z}
  have hS : S ∈ 𝓝 x := by
    have hFe := (contMDiffAt_iff_contMDiffAt_nhds (by decide : (ω : ℕ∞ω) ≠ ∞)).mp hF
    have hce := (contMDiffAt_iff_contMDiffAt_nhds (by decide : (ω : ℕ∞ω) ≠ ∞)).mp hc
    filter_upwards [himage, hapos, hbpos, hFe, hce] with z hi hap hbp hf hcc
    exact ⟨hi, hap, hbp, hf, hcc⟩
  obtain ⟨U, hxU, hUS, hUI, hconn⟩ := exists_native_interior_neighborhood hx hS
  refine ⟨{ domain := U
            base_mem := hxU
            connected := hconn
            inside := hUI
            image := fun z hz => (hUS hz).1
            map_analytic := fun z hz => (hUS hz).2.2.2.1.contMDiffWithinAt
            multiplier_analytic := fun z hz => (hUS hz).2.2.2.2.contMDiffWithinAt
            positive := fun z hz => div_pos (hUS hz).2.1 (hUS hz).2.2.1
            source_positive := fun z hz => (hUS hz).2.1
            target_positive := fun z hz => (hUS hz).2.2.1 }⟩
end ConformalPoisson

end ProofPart_InteriorContinuationNeighborhood

/- Proof support: OpenInverseMatch.lean, SHA256 8c334b0a565d860732eb3511165c88aa0ba4a10f2b8c749c2bdcdfb8b0701e8c -/
noncomputable section ProofPart_OpenInverseMatch



/- Quotient identities match a continued inverse on a NONEMPTY OPEN
set. A converging sequence supplies a point, while actual continuity
on the old open domain supplies the open matching set. -/
open Set Filter Topology
namespace ConformalPoisson
variable {X Y Z : Type*} [TopologicalSpace X] [TopologicalSpace Y]

without_proof_info in
theorem exists_open_inverse_match
    (B U : TopologicalSpace.Opens X) (V : TopologicalSpace.Opens Y)
    (K : X → Y) (hK : ContinuousOn K B) (Q₁ : Y → Z) (Q₂ : X → Z) (E : Z → Y)
    (hinv : ∀ y ∈ V, E (Q₁ y) = y)
    (hrel : ∀ z ∈ (B : Set X) ∩ (U : Set X), Q₁ (K z) = Q₂ z)
    (hne : ((B : Set X) ∩ (U : Set X) ∩ K ⁻¹' (V : Set Y)).Nonempty) :
    ∃ W : TopologicalSpace.Opens X, (W : Set X).Nonempty ∧
      W ≤ B ⊓ U ∧ EqOn (fun z => E (Q₂ z)) K W := by
  have hopen : IsOpen ((B : Set X) ∩ (U : Set X) ∩ K ⁻¹' (V : Set Y)) := by
    apply isOpen_iff_mem_nhds.mpr
    intro z hz
    exact inter_mem ((B.isOpen.inter U.isOpen).mem_nhds hz.1)
      (((hK z hz.1.1).continuousAt (B.isOpen.mem_nhds hz.1.1)).preimage_mem_nhds
        (V.isOpen.mem_nhds hz.2))
  refine ⟨⟨_, hopen⟩, hne, (fun z hz => hz.1), ?_⟩
  intro z hz
  change E (Q₂ z) = K z
  rw [← hrel z hz.1]
  exact hinv (K z) hz.2

without_proof_info in
theorem exists_open_inverse_match_of_sequence
    (B U : TopologicalSpace.Opens X) (V : TopologicalSpace.Opens Y)
    (K : X → Y) (hK : ContinuousOn K B) (Q₁ : Y → Z) (Q₂ : X → Z) (E : Z → Y)
    (hinv : ∀ y ∈ V, E (Q₁ y) = y)
    (hrel : ∀ z ∈ (B : Set X) ∩ (U : Set X), Q₁ (K z) = Q₂ z)
    {xs : ℕ → X} {x : X} {y : Y} (hxs : Tendsto xs atTop (𝓝 x))
    (hKxs : Tendsto (K ∘ xs) atTop (𝓝 y)) (hxB : ∀ k, xs k ∈ B)
    (hxU : x ∈ U) (hyV : y ∈ V) :
    ∃ W : TopologicalSpace.Opens X, (W : Set X).Nonempty ∧
      W ≤ B ⊓ U ∧ EqOn (fun z => E (Q₂ z)) K W := by
  apply exists_open_inverse_match B U V K hK Q₁ Q₂ E hinv hrel
  have hU := hxs.eventually (U.isOpen.mem_nhds hxU)
  have hV := hKxs.eventually (V.isOpen.mem_nhds hyV)
  obtain ⟨k, hkU, hkV⟩ := (hU.and hV).exists
  exact ⟨xs k, ⟨hxB k, hkU⟩, hkV⟩
end ConformalPoisson

end ProofPart_OpenInverseMatch

/- Proof support: InteriorContinuationMatch.lean, SHA256 a60ccc68a3b9997adcc10c9342e06e1c97458e34d1422e8cfffb654c38ed3476 -/
noncomputable section ProofPart_InteriorContinuationMatch



/- The actual target inverse agrees on a NONEMPTY OPEN old region.
The SAME denominator also identifies the continued multiplier there. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

set_option maxHeartbeats 800000 in
without_proof_info in
theorem InteriorContinuationNeighborhood.exists_open_match
    (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) (N : InteriorContinuationNeighborhood R)
    (B : TopologicalSpace.Opens M₁) (J : M₁ → M₂) (c : M₁ → ℝ) (hJ : ContinuousOn J B)
    (hc : ∀ z ∈ B, c z ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ B,
      D.solver₁.solve f.val z = c z * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J z))
    {xs : ℕ → M₁} (hxs : Tendsto xs atTop (𝓝 x)) (hs : ∀ k, xs k ∈ B)
    (hys : Tendsto (J ∘ xs) atTop (𝓝 y)) :
    ∃ W : TopologicalSpace.Opens M₁, (W : Set M₁).Nonempty ∧ W ≤ B ⊓ N.domain ∧
      EqOn R.continuedMap J W := by
  let V : TopologicalSpace.Opens M₂ :=
    ⟨R.quotient_diffeo.localInverse.target, R.quotient_diffeo.localInverse.open_target⟩
  have hquot : ∀ z ∈ (B : Set M₁) ∩ (N.domain : Set M₁),
      R.targetCoordinates (J z) = R.sourceCoordinates z := by
    intro z hz
    exact (quotientCoordinates_eq_of_scaled_evaluations
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)) R.denominator R.numerators
      z (J z) (c z) (hc z hz.1) (fun f => hrel f z hz.1)).symm
  exact exists_open_inverse_match_of_sequence B N.domain V J hJ R.targetCoordinates R.sourceCoordinates
    R.quotient_diffeo.localInverse (fun z hz => R.quotient_diffeo.localInverse_left_inv hz)
    hquot hxs hys hs N.base_mem R.quotient_diffeo.localInverse_mem_target

without_proof_info in
theorem InteriorContinuationNeighborhood.multiplier_eq_on_match
    (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) (N : InteriorContinuationNeighborhood R)
    {B W : Set M₁} (J : M₁ → M₂) (c : M₁ → ℝ)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ B,
      D.solver₁.solve f.val z = c z * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J z))
    (hW : W ⊆ B ∩ (N.domain : Set M₁)) (heq : EqOn R.continuedMap J W) :
    EqOn R.continuedMultiplier c W := by
  intro z hz
  have hden : D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (J z) ≠ 0 := by
    simpa only [heq hz] using (N.target_positive z (hW hz).2).ne'
  change D.solver₁.solve R.denominator.val z /
    D.solver₂.solve (R.denominator.val ∘ D.boundaryIdentification.symm) (R.continuedMap z) = c z
  rw [heq hz, hrel R.denominator z (hW hz).1]
  exact mul_div_cancel_right₀ (c z) hden
end ConformalPoisson

end ProofPart_InteriorContinuationMatch

/- Proof support: InteriorAnalyticIdentity.lean, SHA256 224a89d35690f94b664e6a072dac1c2da99fa2228108f87dd3890338c63d1237 -/
noncomputable section ProofPart_InteriorAnalyticIdentity



/- Analytic identity on an intrinsic interior domain. Adapted from
TauCeti.eqOn_of_preconnected_of_eventuallyEq_of_contMDiffAt in the pinned
TauCeti/Geometry/Manifold/ContMDiff/Analytic.lean (Tau Ceti contributors,
Apache 2.0; External/LICENSE.tauceti). The model may have boundary: the
chart-neighborhood and coordinate analyticity steps explicitly use
intrinsic interior points. -/
open Filter Function IsManifold Set Topology TauCeti
open scoped ContDiff Manifold
namespace ConformalPoisson
variable {𝕜 : Type*} [NontriviallyNormedField 𝕜]
  {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners 𝕜 E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ω M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace 𝕜 F]

omit [IsManifold I ω M] in
without_proof_info in
theorem analyticAt_comp_extend_symm_of_interior {f : M → F} {x : M}
    {e : OpenPartialHomeomorph M H} (hf : ContMDiffAt I 𝓘(𝕜, F) ω f x)
    (he : e ∈ maximalAtlas I ω M) (hx : x ∈ e.source) (hi : I.IsInteriorPoint x) :
    AnalyticAt 𝕜 (f ∘ (e.extend I).symm) (I (e x)) := by
  have hwithin := (contMDiffWithinAt_iff_source_of_mem_maximalAtlas (s := univ) he hx).mp
    hf.contMDiffWithinAt
  simp only [preimage_univ, univ_inter] at hwithin
  have hI := (I.isInteriorPoint_iff_mem_interior_range (by decide) he hx).mp hi
  exact (contMDiffAt_iff_contDiffAt.mp
    (hwithin.contMDiffAt (mem_interior_iff_mem_nhds.mp hI))).analyticAt

without_proof_info in
theorem eqOn_of_preconnected_interior_of_eventuallyEq [LocallyConnectedSpace E]
    {f g : M → F} {U : Set M} (hinterior : U ⊆ I.interior M)
    (hf : ∀ x ∈ U, ContMDiffAt I 𝓘(𝕜, F) ω f x)
    (hg : ∀ x ∈ U, ContMDiffAt I 𝓘(𝕜, F) ω g x)
    (hU : IsPreconnected U) {x₀ : M} (h₀ : x₀ ∈ U) (hfg : f =ᶠ[𝓝 x₀] g) :
    EqOn f g U := by
  set S := {x | f =ᶠ[𝓝 x] g}
  suffices main : closure S ∩ U ⊆ S from fun x hx ↦
    (hU.subset_of_closure_inter_subset isOpen_setOfPred_eventually_nhds
      ⟨x₀, h₀, hfg⟩ main hx).self_of_nhds
  rintro y ⟨hyS, hyU⟩
  set c := extChartAt I y
  set O := ({x | ContMDiffAt I 𝓘(𝕜, F) ω f x} ∩
    {x | ContMDiffAt I 𝓘(𝕜, F) ω g x}) ∩ I.interior M
  have hO : IsOpen O := ((isOpen_setOfPred_contMDiffAt (by simp)).inter
    (isOpen_setOfPred_contMDiffAt (by simp))).inter (I.isOpen_interior (n := ω) (by decide))
  have hcy : c.symm ⁻¹' O ∩ c.target ∈ 𝓝 (c y) :=
    inter_mem (extChartAt_preimage_mem_nhds
      (hO.mem_nhds ⟨⟨hf y hyU, hg y hyU⟩, hinterior hyU⟩))
      (I.extChartAt_target_mem_nhds_of_isInteriorPoint (k := ω) (by decide) y
        (mem_extChartAt_source y) (hinterior hyU))
  obtain ⟨W, ⟨hWo, hcW, hWc⟩, hWO⟩ :=
    (LocallyConnectedSpace.open_connected_basis (c y)).mem_iff.1 hcy
  have han {h : M → F} (hh : ∀ w ∈ W, ContMDiffAt I 𝓘(𝕜, F) ω h (c.symm w)) :
      AnalyticOnNhd 𝕜 (h ∘ c.symm) W := fun w hw ↦ by
    have hw' : c.symm w ∈ (chartAt H y).source := by
      rw [← extChartAt_source I]; exact c.map_target (hWO hw).2
    have h₁ : AnalyticAt 𝕜 (h ∘ c.symm) (c (c.symm w)) :=
      analyticAt_comp_extend_symm_of_interior (hh w hw) (chart_mem_maximalAtlas y)
        hw' (hWO hw).1.2
    rwa [c.right_inv (hWO hw).2] at h₁
  have hF := han fun w hw ↦ (hWO hw).1.1.1
  have hG := han fun w hw ↦ (hWO hw).1.1.2
  have hyW : c.source ∩ c ⁻¹' W ∈ 𝓝 y :=
    inter_mem (extChartAt_source_mem_nhds y) ((continuousAt_extChartAt y).preimage_mem_nhds
      (hWo.mem_nhds hcW))
  obtain ⟨z, ⟨hzc, hzW⟩, hzS⟩ := mem_closure_iff_nhds.1 hyS _ hyW
  have hlim : Tendsto c.symm (𝓝 (c z)) (𝓝 z) := by
    have h₁ : Tendsto c.symm (𝓝 (c z)) (𝓝 (c.symm (c z))) :=
      (continuousAt_extChartAt_symm'' (c.map_source hzc)).tendsto
    rwa [c.left_inv hzc] at h₁
  have hFG : f ∘ c.symm =ᶠ[𝓝 (c z)] g ∘ c.symm := EventuallyEq.comp_tendsto hzS hlim
  have hW := hF.eqOn_of_preconnected_of_eventuallyEq hG hWc.isPreconnected hzW hFG
  filter_upwards [hyW] with w ⟨hwc, hwW⟩
  simpa [c.left_inv hwc] using hW hwW
end ConformalPoisson

end ProofPart_InteriorAnalyticIdentity

/- Proof support: NativeAnalyticContinuation.lean, SHA256 956169f79bdc01e42d7df0832e899aaa1c71087728076b59ccc0c572b778e33d -/
noncomputable section ProofPart_NativeAnalyticContinuation



/- Continue an actual analytic equality from a nonempty OPEN matching
set through a connected interior, then to its boundary by continuity.
The same fixed domain works for each scalar or finite tensor component. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]

without_proof_info in
theorem native_analytic_eqOn_of_open_match
    (U : TopologicalSpace.Opens M)
    (hconn : IsPreconnected ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M))
    {f g : M → F} (hf : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω f U)
    (hg : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω g U)
    (W : TopologicalSpace.Opens M) (hne : (W : Set M).Nonempty)
    (hWU : (W : Set M) ⊆ (U : Set M) ∩ (𝓡∂ (n + 1)).interior M)
    (heq : EqOn f g W) : EqOn f g U := by
  obtain ⟨x, hx⟩ := hne
  have hI : EqOn f g ((U : Set M) ∩ (𝓡∂ (n + 1)).interior M) :=
    eqOn_of_preconnected_interior_of_eventuallyEq inter_subset_right
      (fun y hy => (hf y hy.1).contMDiffAt (U.isOpen.mem_nhds hy.1))
      (fun y hy => (hg y hy.1).contMDiffAt (U.isOpen.mem_nhds hy.1)) hconn (hWU hx)
      (Filter.eventuallyEq_of_mem (W.isOpen.mem_nhds hx) heq)
  have hfc : Continuous (fun y : U => f y) :=
    (show ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω (fun y : U => f y) from fun y =>
      ((hf y y.property).contMDiffAt (U.isOpen.mem_nhds y.property)).comp y
        contMDiff_subtype_val.contMDiffAt).continuous
  have hgc : Continuous (fun y : U => g y) :=
    (show ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, F) ω (fun y : U => g y) from fun y =>
      ((hg y y.property).contMDiffAt (U.isOpen.mem_nhds y.property)).comp y
        contMDiff_subtype_val.contMDiffAt).continuous
  have hres := Continuous.ext_on (dense_nativeInterior (n := n) (M := U)) hfc hgc
    (fun y hy => hI ⟨y.property,
      (𝓡∂ (n + 1)).isInteriorPoint_iff_isInteriorPoint_val.mp hy⟩)
  intro y hy
  exact congrFun hres ⟨y, hy⟩
end ConformalPoisson

end ProofPart_NativeAnalyticContinuation

/- Proof support: InteriorContinuationSolutions.lean, SHA256 86c484440cb19398b28f72e5c17a84c8567730b4d68fc06a7f0771c36394c75a -/
noncomputable section ProofPart_InteriorContinuationSolutions



/- Continue EVERY original solution identity on the SAME previously
chosen connected domain. No intersection over infinitely many data. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

set_option maxHeartbeats 800000 in
without_proof_info in
theorem InteriorContinuationNeighborhood.solutions_of_open_match
    (R : InteriorLimitData A₁ A₂ V₁ V₂ D x y) (N : InteriorContinuationNeighborhood R)
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (B : Set M₁) (J : M₁ → M₂) (c : M₁ → ℝ)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ B,
      D.solver₁.solve f.val z = c z * D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J z))
    (W : TopologicalSpace.Opens M₁) (hne : (W : Set M₁).Nonempty)
    (hW : (W : Set M₁) ⊆ B ∩ (N.domain : Set M₁))
    (heq : EqOn R.continuedMap J W) :
    ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ z ∈ N.domain,
      D.solver₁.solve f.val z = R.continuedMultiplier z *
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (R.continuedMap z) := by
  have hcmatch := N.multiplier_eq_on_match R J c hrel hW heq
  have hconn : IsPreconnected ((N.domain : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁) := by
    simpa only [inter_eq_left.mpr N.inside] using N.connected.isPreconnected
  have hWI : (W : Set M₁) ⊆ (N.domain : Set M₁) ∩ (𝓡∂ (n + 1)).interior M₁ :=
    fun z hz => ⟨(hW hz).2, N.inside (hW hz).2⟩
  intro f z hz
  let f₂ : BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatum D.boundaryIdentification D.patches_match f
  have hu := (D.solver₁.analyticOn_nativeInterior hReg₁ A₁.metric A₁.potential A₁.analytic_potential
    f.val f.property.1).mono N.inside
  have hv := (D.solver₂.analyticOn_nativeInterior hReg₂ A₂.metric A₂.potential A₂.analytic_potential
    f₂.val f₂.property.1).comp N.map_analytic N.image
  have hg : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ω
      (fun w => R.continuedMultiplier w *
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (R.continuedMap w)) N.domain :=
    N.multiplier_analytic.mul hv
  have hmatch : EqOn (D.solver₁.solve f.val)
      (fun w => R.continuedMultiplier w *
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (R.continuedMap w)) W := by
    intro w hw
    change D.solver₁.solve f.val w = R.continuedMultiplier w *
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (R.continuedMap w)
    rw [hcmatch hw, heq hw]
    exact hrel f w (hW hw).1
  exact native_analytic_eqOn_of_open_match N.domain hconn hu hg W hne hWI hmatch hz
end ConformalPoisson

end ProofPart_InteriorContinuationSolutions

/- Proof support: OpenScaledExtension.lean, SHA256 ea83242980d32d48155f0f19c4dfdfb50255026f2c347c9270f6ed8060a66903 -/
noncomputable section ProofPart_OpenScaledExtension




/- Compatible all-data extensions glue to an actual largest connected
open source. This project construction uses point-and-scale separation;
no maximal-extension or global-continuation premise is imported. -/
open Set Filter Topology
namespace ConformalPoisson
variable {D X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

structure OpenScaledExtension (u : D → X → ℝ) (v : D → Y → ℝ)
    (I : Set X) (T : Set Y) (B₀ : Set X) where
  domain : TopologicalSpace.Opens X
  inside : (domain : Set X) ⊆ I
  connected : IsConnected (domain : Set X)
  contains : B₀ ⊆ domain
  map : X → Y
  multiplier : X → ℝ
  continuous : ContinuousOn map domain
  image : MapsTo map domain T
  positive : ∀ x ∈ domain, 0 < multiplier x
  solutions : ∀ f x, x ∈ domain → u f x = multiplier x * v f (map x)

variable {u : D → X → ℝ} {v : D → Y → ℝ} {I : Set X} {T : Set Y} {B₀ : Set X}

without_proof_info in
theorem OpenScaledExtension.overlap
    (hsep : SeparatesPointAndScale (fun f (y : T) => v f y))
    (A B : OpenScaledExtension u v I T B₀) {x : X} (ha : x ∈ A.domain) (hb : x ∈ B.domain) :
    A.map x = B.map x ∧ A.multiplier x = B.multiplier x := by
  have h := hsep ⟨A.map x, A.image ha⟩ ⟨B.map x, B.image hb⟩
    (A.multiplier x) (B.multiplier x) (A.positive x ha).ne' (B.positive x hb).ne'
    (fun f => (A.solutions f x ha).symm.trans (B.solutions f x hb))
  exact ⟨congrArg Subtype.val h.1, h.2⟩

without_proof_info in
theorem exists_largest_openScaledExtension
    (hsep : SeparatesPointAndScale (fun f (y : T) => v f y)) (hB₀ : B₀.Nonempty)
    (A₀ : OpenScaledExtension u v I T B₀) :
    ∃ A : OpenScaledExtension u v I T B₀,
      ∀ B : OpenScaledExtension u v I T B₀, B.domain ≤ A.domain := by
  classical
  let C := OpenScaledExtension u v I T B₀
  let U : TopologicalSpace.Opens X :=
    ⟨⋃ B : C, (B.domain : Set X), isOpen_iUnion (fun B : C => B.domain.isOpen)⟩
  have hmem {x : X} : x ∈ U ↔ ∃ B : C, x ∈ B.domain := mem_iUnion
  let pick (x : X) (hx : x ∈ U) : C := Classical.choose (hmem.mp hx)
  have hpick (x : X) (hx : x ∈ U) : x ∈ (pick x hx).domain := Classical.choose_spec (hmem.mp hx)
  let J : X → Y := fun x => if hx : x ∈ U then (pick x hx).map x else A₀.map x
  let c : X → ℝ := fun x => if hx : x ∈ U then (pick x hx).multiplier x else A₀.multiplier x
  have hagree (B : C) {x : X} (hx : x ∈ B.domain) : J x = B.map x ∧ c x = B.multiplier x := by
    have hxU : x ∈ U := hmem.mpr ⟨B, hx⟩
    simp only [J, c, dif_pos hxU]
    exact (pick x hxU).overlap hsep B (hpick x hxU) hx
  obtain ⟨x₀, hx₀⟩ := hB₀
  have hbase (B : C) : x₀ ∈ B.domain := B.contains hx₀
  have hconnected : IsConnected (U : Set X) := by
    refine ⟨⟨x₀, hmem.mpr ⟨A₀, hbase A₀⟩⟩, ?_⟩
    exact isPreconnected_iUnion ⟨x₀, mem_iInter.mpr hbase⟩ (fun B : C => B.connected.isPreconnected)
  have hcontinuous : ContinuousOn J U := by
    intro x hx
    obtain ⟨B, hxB⟩ := hmem.mp hx
    have he : J =ᶠ[𝓝 x] B.map := Filter.eventuallyEq_of_mem
      (B.domain.isOpen.mem_nhds hxB) (fun y hy => (hagree B hy).1)
    exact (((B.continuous x hxB).continuousAt (B.domain.isOpen.mem_nhds hxB)).congr he.symm).continuousWithinAt
  let A : C := {
    domain := U
    inside := by
      intro x hx
      obtain ⟨B, hxB⟩ := hmem.mp hx
      exact B.inside hxB
    connected := hconnected
    contains := fun x hx => hmem.mpr ⟨A₀, A₀.contains hx⟩
    map := J
    multiplier := c
    continuous := hcontinuous
    image := by
      intro x hx
      obtain ⟨B, hxB⟩ := hmem.mp hx
      rw [(hagree B hxB).1]
      exact B.image hxB
    positive := by
      intro x hx
      obtain ⟨B, hxB⟩ := hmem.mp hx
      rw [(hagree B hxB).2]
      exact B.positive x hxB
    solutions := by
      intro f x hx
      obtain ⟨B, hxB⟩ := hmem.mp hx
      rw [(hagree B hxB).1, (hagree B hxB).2]
      exact B.solutions f x hxB }
  exact ⟨A, fun B x hx => hmem.mpr ⟨B, hx⟩⟩
end ConformalPoisson

end ProofPart_OpenScaledExtension

/- Proof support: OpenScaledGluing.lean, SHA256 46e8bb19dda954499a075e2bc2677ee87e7d00b7b9b3af0b91b8396da4b9e0d9 -/
noncomputable section ProofPart_OpenScaledGluing


/- Glue a local scaled relation to the entire old candidate. Point and
scale separation ensures agreement on EVERY overlap component. -/
open Set Filter Topology
namespace ConformalPoisson
variable {D X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
  {u : D → X → ℝ} {v : D → Y → ℝ} {I : Set X} {T : Set Y} {B₀ : Set X}

set_option maxHeartbeats 600000 in
without_proof_info in
theorem OpenScaledExtension.exists_gluing
    (A : OpenScaledExtension u v I T B₀)
    (hsep : SeparatesPointAndScale (fun f (y : T) => v f y))
    (U : TopologicalSpace.Opens X) (hUI : (U : Set X) ⊆ I) (hconn : IsConnected (U : Set X))
    (J : X → Y) (c : X → ℝ) (hJ : ContinuousOn J U) (himage : MapsTo J U T)
    (hc : ∀ x ∈ U, 0 < c x) (hrel : ∀ f x, x ∈ U → u f x = c x * v f (J x))
    (hne : ((A.domain : Set X) ∩ (U : Set X)).Nonempty) :
    ∃ B : OpenScaledExtension u v I T B₀, B.domain = A.domain ⊔ U := by
  classical
  have hagree {x : X} (ha : x ∈ A.domain) (hb : x ∈ U) :
      A.map x = J x ∧ A.multiplier x = c x := by
    have h := hsep ⟨A.map x, A.image ha⟩ ⟨J x, himage hb⟩
      (A.multiplier x) (c x) (A.positive x ha).ne' (hc x hb).ne'
      (fun f => (A.solutions f x ha).symm.trans (hrel f x hb))
    exact ⟨congrArg Subtype.val h.1, h.2⟩
  let F : X → Y := fun x => if x ∈ A.domain then A.map x else J x
  let a : X → ℝ := fun x => if x ∈ A.domain then A.multiplier x else c x
  have hFA {x : X} (hx : x ∈ A.domain) : F x = A.map x := if_pos hx
  have haA {x : X} (hx : x ∈ A.domain) : a x = A.multiplier x := if_pos hx
  have hFU {x : X} (hx : x ∈ U) : F x = J x := by
    by_cases h : x ∈ A.domain
    · exact (hFA h).trans (hagree h hx).1
    · exact if_neg h
  have haU {x : X} (hx : x ∈ U) : a x = c x := by
    by_cases h : x ∈ A.domain
    · exact (haA h).trans (hagree h hx).2
    · exact if_neg h
  have hcont : ContinuousOn F (A.domain ⊔ U) := by
    intro x hx
    rcases hx with ha | hu
    · have he : F =ᶠ[𝓝 x] A.map := eventuallyEq_of_mem (A.domain.isOpen.mem_nhds ha)
        (fun z hz => hFA hz)
      exact (((A.continuous x ha).continuousAt (A.domain.isOpen.mem_nhds ha)).congr he.symm).continuousWithinAt
    · have he : F =ᶠ[𝓝 x] J := eventuallyEq_of_mem (U.isOpen.mem_nhds hu) (fun z hz => hFU hz)
      exact (((hJ x hu).continuousAt (U.isOpen.mem_nhds hu)).congr he.symm).continuousWithinAt
  refine ⟨{ domain := A.domain ⊔ U
            inside := ?_
            connected := IsConnected.union hne A.connected hconn
            contains := fun x hx => Or.inl (A.contains hx)
            map := F
            multiplier := a
            continuous := hcont
            image := ?_
            positive := ?_
            solutions := ?_ }, rfl⟩
  · intro x hx
    exact hx.elim (fun ha => A.inside ha) (fun hu => hUI hu)
  · intro x hx
    rcases hx with ha | hu
    · rw [hFA ha]
      exact A.image ha
    · rw [hFU hu]
      exact himage hu
  · intro x hx
    rcases hx with ha | hu
    · rw [haA ha]
      exact A.positive x ha
    · rw [haU hu]
      exact hc x hu
  · intro f x hx
    rcases hx with ha | hu
    · rw [hFA ha, haA ha]
      exact A.solutions f x ha
    · rw [hFU hu, haU hu]
      exact hrel f x hu
end ConformalPoisson

end ProofPart_OpenScaledGluing

/- Proof support: NativeOriginalSeparation.lean, SHA256 d41ec121514cdb8e589bc038aa61683a277bc0b9d2d8ff40c4ff4c7c0d72d6f1 -/
noncomputable section ProofPart_NativeOriginalSeparation




/- Separation for the actual transported ORIGINAL family follows by
surjectivity of the supported-datum transport, with attribution intact. -/
open Set TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

without_proof_info in
theorem MatchingMeasurements.separates_target_original_family
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) :
    SeparatesPointAndScale (fun (f : BoundaryDatum (observedPatch (n := n) V₁))
      (y : (𝓡∂ (n + 1)).interior M₂) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) y) := by
  let Γ₂ : TopologicalSpace.Opens ((𝓡∂ (n + 1)).boundary M₂) :=
    ⟨observedPatch (n := n) V₂, V₂.isOpen.preimage continuous_subtype_val⟩
  have hΓ₂ : (Γ₂ : Set ((𝓡∂ (n + 1)).boundary M₂)).Nonempty := by
    obtain ⟨a, ha⟩ := D.patch_nonempty
    exact ⟨D.boundaryIdentification a, (D.patches_match a).mp ha⟩
  have hsep := separatesPointAndScale_interior hSchauder (hRunge₂ A₂) hn hcompact₂ hconnected₂ (A₂.analytic_potential.of_le (by decide)) A₂.nonresonant D.solver₂ Γ₂ hΓ₂
  let e : BoundaryDatum (observedPatch (n := n) V₁) ≃ₗ[ℝ]
      BoundaryDatum (observedPatch (n := n) V₂) :=
    transportBoundaryDatumLinearEquiv D.boundaryIdentification D.patches_match
  exact hsep.precomp_surjective e e.surjective
end ConformalPoisson

end ProofPart_NativeOriginalSeparation

/- Proof support: NativeLocalContinuation.lean, SHA256 31dbc8ec02b22e708610df6022d76269e5a9d74292b1fe6bb1ad028bd04a4710 -/
noncomputable section ProofPart_NativeLocalContinuation




/- Actual local extension of the WHOLE old candidate over a specified
interior limit, from the same original image sequence and all data. -/
open Set Filter TauCeti
open scoped Manifold ContDiff Topology
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [T2Space M₁] [T2Space M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]
  {A₁ : AnalyticProblem (n := n) (M := M₁)} {A₂ : AnalyticProblem (n := n) (M := M₂)}
  {V₁ : TopologicalSpace.Opens M₁} {V₂ : TopologicalSpace.Opens M₂}
  {D : MatchingMeasurements A₁ A₂ V₁ V₂} {x : M₁} {y : M₂}

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem native_local_extension_of_interior_limit
    (hSchauder : LocalSchauderDirichletAssumption (n + 1))
    (hRunge₁ : AnalyticRungeJetApproximation (n := n) (M := M₁))
    (hRunge₂ : AnalyticRungeJetApproximation (n := n) (M := M₂))
    (hReg₁ : InteriorAnalyticRegularityAssumption (n := n) (M := M₁))
    (hReg₂ : InteriorAnalyticRegularityAssumption (n := n) (M := M₂))
    (hn : 2 ≤ n) (hcompact₁ : IsCompact (univ : Set M₁)) (hcompact₂ : IsCompact (univ : Set M₂))
    (hconnected₁ : IsConnected ((𝓡∂ (n + 1)).interior M₁))
    (hconnected₂ : IsConnected ((𝓡∂ (n + 1)).interior M₂))
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (x : M₁) (hx : x ∈ (𝓡∂ (n + 1)).interior M₁)
    (y : M₂) (hy : y ∈ (𝓡∂ (n + 1)).interior M₂)
    {B₀ : Set M₁}
    (A : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀)
    {xs : ℕ → M₁} (hxs : Tendsto xs atTop (𝓝 x)) (hs : ∀ k, xs k ∈ A.domain)
    (hys : Tendsto (A.map ∘ xs) atTop (𝓝 y)) :
    ∃ B : OpenScaledExtension
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) => D.solver₁.solve f.val)
      (fun f : BoundaryDatum (observedPatch (n := n) V₁) =>
        D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm))
      ((𝓡∂ (n + 1)).interior M₁) ((𝓡∂ (n + 1)).interior M₂) B₀, x ∈ B.domain := by
  obtain ⟨R⟩ := exists_interiorLimitData hSchauder hRunge₁ hRunge₂ hReg₂ hn hcompact₁ hcompact₂
    hconnected₁ hconnected₂ A₁ A₂ V₁ V₂ D x hx y hy hxs hys
    (fun k => A.positive (xs k) (hs k)) (fun f k => A.solutions f (xs k) (hs k))
  obtain ⟨N⟩ := exists_interiorContinuationNeighborhood R hReg₁ hReg₂ hx hy
  obtain ⟨W, hWne, hWsub, heq⟩ := N.exists_open_match R A.domain A.map A.multiplier A.continuous
    (fun z hz => (A.positive z hz).ne') A.solutions hxs hs hys
  have hsol := N.solutions_of_open_match R hReg₁ hReg₂ A.domain A.map A.multiplier A.solutions
    W hWne hWsub heq
  have hinter : ((A.domain : Set M₁) ∩ (N.domain : Set M₁)).Nonempty := by
    obtain ⟨z, hz⟩ := hWne
    exact ⟨z, hWsub hz⟩
  obtain ⟨B, hB⟩ := A.exists_gluing
    (D.separates_target_original_family hSchauder hRunge₂ hn hcompact₂ hconnected₂)
    N.domain N.inside N.connected R.continuedMap R.continuedMultiplier N.map_analytic.continuousOn
    N.image N.positive hsol hinter
  refine ⟨B, ?_⟩
  rw [hB]
  exact Or.inr N.base_mem
end ConformalPoisson

end ProofPart_NativeLocalContinuation

/- Proof support: CommonNonvanishingDatum.lean, SHA256 8475c734fb41eed0a857b08aa57204b9e6bba8508f075ef9f1b2165e33d6dbe9 -/
noncomputable section ProofPart_CommonNonvanishingDatum





/- One original datum can avoid two nonzero real linear functionals.
The application retains the actual source evaluation and transported
actual target normal derivative, with the same supported-data space. -/
open Set TauCeti
open scoped Manifold ContDiff
namespace ConformalPoisson

without_proof_info in
theorem exists_common_nonzero_linear {V : Type*} [AddCommGroup V] [Module ℝ V]
    (L K : V →ₗ[ℝ] ℝ) (hL : ∃ v, L v ≠ 0) (hK : ∃ v, K v ≠ 0) :
    ∃ v, L v ≠ 0 ∧ K v ≠ 0 := by
  obtain ⟨a, ha⟩ := hL
  obtain ⟨b, hb⟩ := hK
  by_cases hKa : K a = 0
  · by_cases hLb : L b = 0
    · exact ⟨a + b, by simpa only [map_add, hLb, add_zero] using ha,
        by simpa only [map_add, hKa, zero_add] using hb⟩
    · exact ⟨b, hLb, hb⟩
  · exact ⟨a, ha, hKa⟩

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

def DirichletSolver.normalLinearMap
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (S : DirichletSolver g q) (hNR : Nonresonant g q)
    (Γ : Set ((𝓡∂ (n + 1)).boundary M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (y : (𝓡∂ (n + 1)).boundary M) : BoundaryDatum Γ →ₗ[ℝ] ℝ where
  toFun f := normalDerivative ν (S.solve f.val) y
  map_add' f h := by
    rw [show (f + h).val = f.val + h.val from rfl,
      S.solve_add g q hNR f.property.1 h.property.1]
    unfold normalDerivative
    have hf := ((S.correct f.val f.property.1).1.of_le (by decide : 1 ≤ ∞)).mdifferentiable (by decide) (y : M)
    have hh := ((S.correct h.val h.property.1).1.of_le (by decide : 1 ≤ ∞)).mdifferentiable (by decide) (y : M)
    rw [show S.solve f.val + S.solve h.val = (fun z => S.solve f.val z + S.solve h.val z) from rfl,
      mvfderiv_fun_add hf hh]
    rfl
  map_smul' a f := by
    rw [show (a • f).val = a • f.val from rfl, S.solve_smul g q hNR a f.property.1]
    unfold normalDerivative
    rw [mvfderiv_const_smul_field]
    rfl

variable {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem exists_common_value_normal_datum
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (S₁ : DirichletSolver A₁.smoothMetric A₁.potential)
    (S₂ : DirichletSolver A₂.smoothMetric A₂.potential)
    (β : Diffeomorph (𝓡 n) (𝓡 n)
      ((𝓡∂ (n + 1)).boundary M₁) ((𝓡∂ (n + 1)).boundary M₂) ω)
    {Γ₁ : Set ((𝓡∂ (n + 1)).boundary M₁)} {Γ₂ : Set ((𝓡∂ (n + 1)).boundary M₂)}
    (hΓ : ∀ z, z ∈ Γ₁ ↔ β z ∈ Γ₂)
    (ν₂ : (y : (𝓡∂ (n + 1)).boundary M₂) → TangentSpace (𝓡∂ (n + 1)) (y : M₂))
    (x : M₁) (y : (𝓡∂ (n + 1)).boundary M₂)
    (hvalue : ∃ f : BoundaryDatum Γ₁, S₁.solve f.val x ≠ 0)
    (hnormal : ∃ f : BoundaryDatum Γ₂, normalDerivative ν₂ (S₂.solve f.val) y ≠ 0) :
    ∃ f : BoundaryDatum Γ₁, S₁.solve f.val x ≠ 0 ∧
      normalDerivative ν₂ (S₂.solve (transportBoundaryDatum β hΓ f).val) y ≠ 0 := by
  let L : BoundaryDatum Γ₁ →ₗ[ℝ] ℝ :=
    (LinearMap.proj x).comp (S₁.linearMap _ _ A₁.nonresonant Γ₁)
  let K : BoundaryDatum Γ₁ →ₗ[ℝ] ℝ :=
    (S₂.normalLinearMap _ _ A₂.nonresonant Γ₂ ν₂ y).comp
      (transportBoundaryDatumLinearMap β hΓ)
  apply exists_common_nonzero_linear L K hvalue
  obtain ⟨f₂, hf₂⟩ := hnormal
  let e := transportBoundaryDatumLinearEquiv β hΓ
  refine ⟨e.symm f₂, ?_⟩
  change normalDerivative ν₂ (S₂.solve (transportBoundaryDatum β hΓ (e.symm f₂)).val) y ≠ 0
  have he : transportBoundaryDatum β hΓ (e.symm f₂) = f₂ := e.apply_symm_apply f₂
  rw [he]
  exact hf₂
end ConformalPoisson

end ProofPart_CommonNonvanishingDatum

/- Proof support: NormalTraceContinuity.lean, SHA256 0a406a2a58c121f524d73223f311eff956fbd537106ef179df2079db39ea4478 -/
noncomputable section ProofPart_NormalTraceContinuity




/- Continuity of actual unit-normal traces, derived from the pointwise normal specification. -/

open Bundle Set Filter
open scoped Manifold ContDiff Topology

namespace ConformalPoisson

variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M]
  [IsManifold (𝓡∂ (n + 1)) ω M]

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
/-- The supplied pointwise unit normal needs no separate regularity premise. -/
theorem continuousAt_normalDerivative
    (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (u : M → ℝ) (x : (𝓡∂ (n + 1)).boundary M)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ u (x : M)) :
    ContinuousAt (normalDerivative ν u) x := by
  let : RiemannianBundle (fun x : M => TangentSpace (𝓡∂ (n + 1)) x) := ⟨g.toRiemannianMetric⟩
  let : IsManifold (𝓡∂ (n + 1)) (∞ + 1) M := by
    simpa using (inferInstance : IsManifold (𝓡∂ (n + 1)) ∞ M)
  let f := chartBoundaryFunction (n := n) (x : M)
  have hf : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ f (x : M) :=
    (contMDiffOn_chartBoundaryFunction (x : M) (x : M) (mem_chart_source _ _)).contMDiffAt
      ((chartAt (EuclideanHalfSpace (n + 1)) (x : M)).open_source.mem_nhds (mem_chart_source _ _))
  have hEq := (hν x).eq_nativeNegativeUnitGradient_chart g (x : M) x
    (mem_chart_source _ _) (ν x)
  have hG : TauCeti.Manifold.mgradient (𝓡∂ (n + 1)) f (x : M) ≠ 0 := by
    intro hzero
    have hνzero : ν x = 0 := by
      simpa only [nativeNegativeUnitGradient, f, hzero, NormedSpace.normalize_zero_eq_zero,
        neg_zero] using hEq
    have hunit := (hν x).2.1
    rw [hνzero] at hunit
    simp only [map_zero, zero_ne_one] at hunit
  have hN : ContMDiffAt (𝓡∂ (n + 1)) (𝓡∂ (n + 1)).tangent ∞
      (fun z => (⟨z, nativeNegativeUnitGradient g f z⟩ : TangentBundle (𝓡∂ (n + 1)) M))
      (x : M) := by
    have hn := TauCeti.Manifold.contMDiffAt_normalize_mgradient (n := ∞)
      (by simpa using hf) hG
    simpa only [nativeNegativeUnitGradient, Pi.neg_apply] using hn.neg_section
  have hD : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ∞
      (fun z => mvfderiv (𝓡∂ (n + 1)) u z (nativeNegativeUnitGradient g f z)) (x : M) :=
    (hu.contMDiffAt_mvfderiv_apply (m := ∞) (by simp)).comp (x : M) hN
  have hcont := hD.continuousAt.comp (continuous_subtype_val.continuousAt (x := x))
  apply hcont.congr_of_eventuallyEq
  have hsource : ∀ᶠ y : (𝓡∂ (n + 1)).boundary M in 𝓝 x,
      (y : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) (x : M)).source :=
    continuous_subtype_val.continuousAt.preimage_mem_nhds
      ((chartAt (EuclideanHalfSpace (n + 1)) (x : M)).open_source.mem_nhds (mem_chart_source _ _))
  filter_upwards [hsource] with y hy
  change normalDerivative ν u y = mvfderiv (𝓡∂ (n + 1)) u y (nativeNegativeUnitGradient g f y)
  unfold normalDerivative
  rw [(hν y).eq_nativeNegativeUnitGradient_chart g (x : M) y hy (ν y)]

end ConformalPoisson

end ProofPart_NormalTraceContinuity

