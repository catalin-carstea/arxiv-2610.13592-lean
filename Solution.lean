open Bundle Set TauCeti Filter Topology
open scoped Manifold ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" => EuclideanHalfSpace (n + 1)

without_proof_info in
theorem halfSpace_extChartAt_target (p : H) :
    (extChartAt (𝓡∂ (n + 1)) p).target = {x : V | 0 ≤ x 0} := by
  have h : (extChartAt (𝓡∂ (n + 1)) p).target = range (𝓡∂ (n + 1)) := by
    simp [extChartAt]
  rw [h, range_modelWithCornersEuclideanHalfSpace]

without_proof_info in
theorem halfSpace_extChartAt_symm_val (p : H) {x : V} (hx : 0 ≤ x 0) :
    ((extChartAt (𝓡∂ (n + 1)) p).symm x).val = x := by
  have ht : x ∈ (extChartAt (𝓡∂ (n + 1)) p).target := by rwa [halfSpace_extChartAt_target]
  have h := (extChartAt (𝓡∂ (n + 1)) p).right_inv ht
  simpa only [extChartAt_self_apply, modelWithCornersEuclideanHalfSpace_toFun] using h

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem contDiffOn_halfSpace_ambient_reading
    (p : EuclideanHalfSpace (n + 1)) (W : Set V) (hW : IsOpen W)
    (F : EuclideanHalfSpace (n + 1) → ℝ) (f : V → ℝ)
    (hF : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F ((Subtype.val : H → V) ⁻¹' W))
    (hread : ∀ y : EuclideanHalfSpace (n + 1), y.val ∈ W → f y.val = F y) :
    ContDiffOn ℝ ∞ f (W ∩ {x : V | 0 ≤ x 0}) := by
  let U : TopologicalSpace.Opens H := ⟨Subtype.val ⁻¹' W, hW.preimage continuous_subtype_val⟩
  have hs := contDiffOn_nativeCauchyChartTarget p U hF
  have hsub : W ∩ {x : V | 0 ≤ x 0} ⊆ nativeCauchyChartTarget p U := by
    intro x hx
    refine ⟨?_, ?_⟩
    · rw [halfSpace_extChartAt_target]
      exact hx.2
    · change ((extChartAt (𝓡∂ (n + 1)) p).symm x).val ∈ W
      rw [halfSpace_extChartAt_symm_val p hx.2]
      exact hx.1
  apply (hs.mono hsub).congr
  intro x hx
  have hv := halfSpace_extChartAt_symm_val p hx.2
  have hr := hread ((extChartAt (𝓡∂ (n + 1)) p).symm x) (hv.symm ▸ hx.1)
  simpa only [Function.comp_apply, hv] using hr

without_proof_info in
theorem contMDiffAt_halfSpace_of_ambient_analyticWithinAt
    (p : EuclideanHalfSpace (n + 1)) (F : EuclideanHalfSpace (n + 1) → ℝ) (f : V → ℝ)
    (hf : AnalyticWithinAt ℝ f {x : V | 0 ≤ x 0} p.val)
    (hread : (F ∘ (extChartAt (𝓡∂ (n + 1)) p).symm) =ᶠ[𝓝[{x : V | 0 ≤ x 0}] p.val] f)
    (hbase : F p = f p.val) : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) ω F p := by
  have hp : (extChartAt (𝓡∂ (n + 1)) p).symm p.val = p := by
    have h := extChartAt_to_inv (I := 𝓡∂ (n + 1)) p
    rw [show extChartAt (𝓡∂ (n + 1)) p p = p.val from rfl] at h
    exact h
  have ha := hf.congr_of_eventuallyEq hread (by simpa only [Function.comp_apply, hp] using hbase)
  rw [contMDiffAt_iff_source, contMDiffWithinAt_iff_contDiffWithinAt]
  change ContDiffWithinAt ℝ ω (F ∘ (extChartAt (𝓡∂ (n + 1)) p).symm)
    (range (Subtype.val : H → V)) p.val
  rw [range_euclideanHalfSpace]
  exact ha.contDiffWithinAt

end ConformalPoisson

