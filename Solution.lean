noncomputable section ProofPart_LocalContinuousZeroTrace



/- A continuous representative vanishing on the physical portion
of the frontier gives local Sobolev zero trace. Compact test cutoffs
remove every artificial part of the frontier. -/
open Set MeasureTheory TopologicalSpace TauCeti
open scoped ContDiff Gradient ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω A : Opens E}

without_proof_info in
theorem exists_local_zeroTrace_of_continuous_frontier
    (hb : Bornology.IsBounded (Ω : Set E))
    {g : E → ℝ} (hg : ContinuousOn g (closure (Ω : Set E)))
    (hg0 : ∀ x ∈ frontier (Ω : Set E), x ∈ A → g x = 0)
    (u : W1p μ Ω 2) (hu : W1p.value u =ᵐ[μ.restrict Ω] g)
    {ψ : E → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hψs : tsupport ψ ⊆ A) :
    ∃ v : W1p0 μ Ω 2, W1p.value v.val =ᵐ[μ.restrict Ω]
      fun x => ψ x * W1p.value u x := by
  obtain ⟨N, hN, hψN, hdN⟩ := exists_compact_smooth_multiplier_bound hψ hψc
  let v := W1p.contDiffSMul ψ hψ hN (fun y _ => hψN y) (fun y _ => hdN y) u
  have hv : W1p.value v =ᵐ[μ.restrict Ω] fun x => ψ x * W1p.value u x := by
    filter_upwards [W1p.value_contDiffSMul_ae hψ hN
      (fun y _ => hψN y) (fun y _ => hdN y) u] with x hx
    exact hx
  have hvg : W1p.value v =ᵐ[μ.restrict Ω] fun x => ψ x * g x := by
    filter_upwards [hv, hu] with x hx hux
    rw [hx, hux]
  have hzero : ∀ x ∈ frontier (Ω : Set E), ψ x * g x = 0 := by
    intro x hx
    by_cases hxA : x ∈ A
    · rw [hg0 x hx hxA, mul_zero]
    · rw [image_eq_zero_of_notMem_tsupport (fun ht => hxA (hψs ht)), zero_mul]
  have hv0 : v ∈ w1p0Submodule μ Ω 2 :=
    W1p.mem_w1p0Submodule_of_continuousOn_closure (by norm_num) hb
      (hψ.continuous.continuousOn.mul hg) hzero hvg
  exact ⟨⟨v, hv0⟩, hv⟩
end ConformalPoisson

end ProofPart_LocalContinuousZeroTrace

