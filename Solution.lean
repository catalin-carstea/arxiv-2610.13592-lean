noncomputable section ProofPart_LocalSobolevEmbedding



/- A first-order value embedding into a smaller domain upgrades
arbitrary Sobolev orders there. Directional weak derivatives are
restricted and assembled on the smaller domain. No boundary geometry
or extension theorem is assumed by this purely Sobolev step. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω D : Opens E}
  {p q : ℝ≥0∞} [Fact (1 ≤ p)] [Fact (1 ≤ q)]

without_proof_info in
theorem exists_wkp_of_local_firstOrder_embedding (hD : D ≤ Ω)
    (hvalue : ∀ u : W1p μ Ω p, MemLp (W1p.value u) q (μ.restrict D)) :
    ∀ (k : ℕ) (u : Wkp μ Ω p (k + 1)), ∃ v : Wkp μ D q k,
      Wkp.value k v =ᵐ[μ.restrict D] Wkp.value (k + 1) u := by
  intro k
  induction k with
  | zero =>
    intro u
    have hm := hvalue u
    refine ⟨hm.toLp _, ?_⟩
    change Wkp.value 0 (hm.toLp _) =ᵐ[μ.restrict D] Wkp.value 1 u
    rw [Wkp.value_zero, Wkp.value_one]
    exact hm.coeFn_toLp
  | succ k ih =>
    intro u
    have hm : MemLp (Wkp.value (k + 2) u) q (μ.restrict D) := by
      rw [← Wkp.value_firstOrder (k + 1) u]
      exact hvalue _
    let f := hm.toLp (Wkp.value (k + 2) u)
    let b := stdOrthonormalBasis ℝ E
    obtain ⟨v, hv⟩ := Wkp.exists_value_eq_of_forall_hasWeakLineDerivOn b f k (by
      intro i
      obtain ⟨d, hd⟩ := Wkp.exists_hasWeakLineDerivOn_value (k + 1) u (b i)
      obtain ⟨g, hg⟩ := ih d
      refine ⟨g, ((hd.mono hD).congr_ae hm.coeFn_toLp.symm).congr_ae_deriv hg.symm⟩)
    exact ⟨v, hv ▸ hm.coeFn_toLp⟩
end ConformalPoisson

