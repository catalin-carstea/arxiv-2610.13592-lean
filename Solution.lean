noncomputable section ProofPart_GreenTrace_AllOrderSobolevReading



/- One coherent bounded reading at every Sobolev order, and its actual weak
directional derivative. Intended caller: continuous readings of ALL derivative
words on one fixed cap, for smooth operator-valued point evaluations. -/
open Set MeasureTheory TauCeti TopologicalSpace
open scoped ENNReal NNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E H : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  [NormedAddCommGroup H] [NormedSpace ℝ H]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω : Opens E}

structure AllOrderSobolevReading (μ : Measure E) [μ.IsAddHaarMeasure] (Ω : Opens E) (H : Type*)
    [NormedAddCommGroup H] [NormedSpace ℝ H] where
  value : H →L[ℝ] Lp ℝ 2 (μ.restrict (Ω : Set E))
  reading : ∀ k : ℕ, H →L[ℝ] Wkp μ Ω 2 (k + 2)
  reading_value : ∀ k u, Wkp.value (k + 2) (reading k u) =ᵐ[μ.restrict (Ω : Set E)] value u

namespace AllOrderSobolevReading

def ofExistence (A : H →L[ℝ] Lp ℝ 2 (μ.restrict (Ω : Set E)))
    (hall : ∀ k : ℕ, ∃ T : H →L[ℝ] Wkp μ Ω 2 (k + 2),
      ∀ u, Wkp.value (k + 2) (T u) =ᵐ[μ.restrict (Ω : Set E)] A u) :
    AllOrderSobolevReading μ Ω H where
  value := A
  reading k := Classical.choose (hall k)
  reading_value k := Classical.choose_spec (hall k)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem exists_directional (S : AllOrderSobolevReading μ Ω H) (v : E) :
    ∃ D : AllOrderSobolevReading μ Ω H,
      ∀ u, HasWeakLineDerivOn μ Ω (S.value u) (D.value u) v := by
  classical
  obtain ⟨D₀, hD₀⟩ := exists_bounded_wkp_directional_reading (μ := μ) (Ω := Ω) (p := 2) v 1
  let A : H →L[ℝ] Lp ℝ 2 (μ.restrict (Ω : Set E)) :=
    (Wkp.valueL 1).comp (D₀.comp (S.reading 0))
  have hA : ∀ u, A u = Wkp.value 1 (D₀ (S.reading 0 u)) := by
    intro u
    exact (ContinuousLinearMap.comp_apply (Wkp.valueL 1) (D₀.comp (S.reading 0)) u).trans
      (congrArg (Wkp.valueL 1) (ContinuousLinearMap.comp_apply D₀ (S.reading 0) u) |>.trans
        (Wkp.valueL_apply 1 _))
  have hweak : ∀ u, HasWeakLineDerivOn μ Ω (S.value u) (A u) v := by
    intro u
    rw [hA]
    exact (hD₀ (S.reading 0 u)).congr_ae (S.reading_value 0 u)
  choose D hD using fun k : ℕ =>
    exists_bounded_wkp_directional_reading (μ := μ) (Ω := Ω) (p := 2) v (k + 2)
  let R : AllOrderSobolevReading μ Ω H :=
    { value := A
      reading k := (D k).comp (S.reading (k + 1))
      reading_value k u := by
        have hw := (hD k (S.reading (k + 1) u)).congr_ae (S.reading_value (k + 1) u)
        exact hw.ae_eq (hweak u) }
  exact ⟨R, hweak⟩

def directional (S : AllOrderSobolevReading μ Ω H) (v : E) : AllOrderSobolevReading μ Ω H :=
  Classical.choose (S.exists_directional v)

without_proof_info in
theorem directional_spec (S : AllOrderSobolevReading μ Ω H) (v : E) (u : H) :
    HasWeakLineDerivOn μ Ω (S.value u) ((S.directional v).value u) v :=
  Classical.choose_spec (S.exists_directional v) u

end AllOrderSobolevReading
end ConformalPoisson

end ProofPart_GreenTrace_AllOrderSobolevReading

