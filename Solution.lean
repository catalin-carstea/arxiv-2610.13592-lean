noncomputable section ProofPart_BoundaryAnalytic_AmbientPrincipalNormal




/- The actual native coordinate principal coefficient has unit normal
column and row when the ambient metric has the proved Gauss column. -/
open Bundle Set
open scoped Manifold ContDiff InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "e0" => (EuclideanSpace.single 0 1 : V)
set_option maxHeartbeats 1000000 in
without_proof_info in
theorem ambient_chartPrincipal_normal
    (D : TopologicalSpace.Opens (EuclideanSpace ℝ (Fin (n + 1))))
    [RiemannianBundle (fun x : D => TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin (n + 1))) x)]
    (p x : D)
    (hnormal : ∀ v : TangentSpace 𝓘(ℝ, V) x,
      inner ℝ (show TangentSpace 𝓘(ℝ, V) x from e0) v = (show V from v) 0) :
    chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p (x : V) e0 = e0 ∧
      ∀ v : V, chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p (x : V) v 0 = v 0 := by
  have hx : x ∈ (chartAt V p).source := by
    rw [← extChartAt_source (I := 𝓘(ℝ, V)), ambient_extChartAt_source]
    trivial
  let e := trivializationAt V (TangentSpace 𝓘(ℝ, V)) p
  have hbase : x ∈ e.baseSet := by simpa [e] using hx
  let C := e.continuousLinearEquivAt ℝ x hbase
  have hC (v : TangentSpace 𝓘(ℝ, V) x) : C v = (show V from v) := by
    rw [show (C : TangentSpace 𝓘(ℝ, V) x → V) = e.continuousLinearMapAt ℝ x from
      e.coe_continuousLinearEquivAt_eq hbase]
    rw [ambient_tangent_continuousLinearMapAt D p x]
    rfl
  have hfactor : chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p (x : V) =
      C.toContinuousLinearMap.comp C.toContinuousLinearMap.adjoint := by
    have h := chartPrincipalCoefficient_actualFrame_factor (I := 𝓘(ℝ, V)) p hx
    rw [ambient_extChartAt_apply] at h
    exact h
  have hadj : C.toContinuousLinearMap.adjoint e0 = (show TangentSpace 𝓘(ℝ, V) x from e0) := by
    apply ext_inner_right ℝ
    intro v
    rw [ContinuousLinearMap.adjoint_inner_left, hnormal]
    change inner ℝ e0 (C v) = (show V from v) 0
    rw [hC]
    simp [EuclideanSpace.inner_single_left]
  have hAn : chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p (x : V) e0 = e0 := by
    rw [hfactor, ContinuousLinearMap.comp_apply, hadj]
    exact hC _
  refine ⟨hAn, ?_⟩
  intro v
  have hs := factor_comp_adjoint_symmetric C.toContinuousLinearMap e0 v
  rw [← hfactor] at hs
  change inner ℝ (chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p (x : V) e0) v =
    inner ℝ e0 (chartPrincipalCoefficient (I := 𝓘(ℝ, V)) p (x : V) v) at hs
  rw [hAn] at hs
  simpa [EuclideanSpace.inner_single_left] using hs.symm

end ConformalPoisson

end ProofPart_BoundaryAnalytic_AmbientPrincipalNormal

