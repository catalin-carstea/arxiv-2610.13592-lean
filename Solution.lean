theorem boundaryReflection_eq_sub_normal (v : V) :
    boundaryReflection n v = v - (2 * v 0) • e := by
  ext i
  by_cases hi : i = 0
  · subst i
    simp
    ring
  · simp [hi, Ne.symm hi]

without_proof_info in
theorem boundaryReflection_conjugate_normal_form
    (A : V →L[ℝ] V) (hAn : A e = e) (hA0 : ∀ v : V, A v 0 = v 0)
    (v : V) : boundaryReflection n (A (boundaryReflection n v)) = A v := by
  rw [boundaryReflection_eq_sub_normal v, map_sub, map_smul, hAn]
  ext i
  by_cases hi : i = 0
