/- The actual normal-factor drift is read at tangentially translated
points by an analytic Holder family built from the ORIGINAL analytic germ. -/
open Set Metric
open scoped NNReal ContDiff
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_tangential_reflectedDrift_holder_family (hα : α ≤ 1)
    (T : H ℝ) (hT : ∀ x : closedBall (0 : V) 1, T x = (x : V) 0)
    (β : V → V) (χ : V → ℝ) (hχ : ContDiff ℝ 1 χ)
    (hχfold : ∀ x : V, χ (boundaryFold x) = χ x)
    {W : Set V} (hW : IsOpen W) (hKW : closedBall (0 : V) 1 ⊆ W)
    (hβ : AnalyticOnNhd ℝ β W) :
    ∃ (U : Set V) (G : V → H V), IsOpen U ∧ (0 : V) ∈ U ∧
      AnalyticOnNhd ℝ G U ∧ ∀ a ∈ U, ∀ x : closedBall (0 : V) 1,
        G a x = normalFactorReflectedDrift β
          (localizedTranslation χ (boundaryTangentialProjection a) x) := by
  obtain ⟨U, Hβ, hU, h0, hHβ, hHeq⟩ :=
    exists_finite_analytic_localized_holder_family hα
      (interiorFiniteCoordinates V) (interiorFiniteCoordinates V) β χ hχ hW hKW hβ
  let P : V →L[ℝ] V := boundaryTangentialProjection
  refine ⟨P ⁻¹' U, fun a => scaledDriftFoldHolderL 1 T (Hβ (P a)),
    hU.preimage P.continuous, ?_, ?_, ?_⟩
  · simpa using h0
  · intro a ha
    exact analyticAt_scaledDriftFoldHolderFamily 1 T ((hHβ (P a) ha).comp (P.analyticAt a))
  · intro a ha x
    have hread := evenFoldHolderL_translated_read χ (P a)
      (boundaryTangentialProjection_normal a) hχfold β (Hβ (P a))
      (fun y => hHeq (P a) ha y) x
    rw [evenFoldHolderL_apply] at hread
    rw [scaledDriftFoldHolderL_apply, hread, hT x]
    simp [normalFactorReflectedDrift, localizedTranslation, P]

end ConformalPoisson

end ProofPart_BoundaryAnalytic_TangentialReflectedDriftFamily

/- Boundary analytic support: FiniteBallJetFamilies.lean, SHA256 49f7169c339e1dcbcb2889a5cc7b3dd611bbc6792dc491c815587f2d60536e0d -/
noncomputable section ProofPart_BoundaryAnalytic_FiniteBallJetFamilies


/- The continuous actual zero-boundary jet family needs only joint C3.
The third spatial derivative controls the Holder Hessian; no fourth derivative
or smooth reflected extension is assumed. -/
open Set Metric Filter Topology
open scoped NNReal ContDiff BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson.DirichletHolder
variable {E F P : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]

variable [ProperSpace E] [NormedAddCommGroup P] [NormedSpace ℝ P]

local instance : NormedAddCommGroup (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedAddCommGroup (𝕜 := ℝ) (𝕜₂ := ℝ) (σ₁₂ := RingHom.id ℝ)
    (E := E) (F := E →L[ℝ] E →L[ℝ] F)
local instance : NormedSpace ℝ (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) :=
  ContinuousLinearMap.toNormedSpace (𝕜 := ℝ) (𝕜₂ := ℝ) (𝕜' := ℝ)
    (σ₁₂ := RingHom.id ℝ) (E := E) (F := E →L[ℝ] E →L[ℝ] F)

without_proof_info in
theorem exists_ballJets_of_c3_joint_family {α : ℝ≥0} (hα : α ≤ 1)
    {U : Set P} {W : Set E} (hW : IsOpen W) (hKW : closedBall (0 : E) 1 ⊆ W)
    (f : P → E → F) (hf : ContDiffOn ℝ 3 (Function.uncurry f) (U ×ˢ W))
    (hboundary : ∀ p ∈ U, ∀ x : E, x ∈ sphere 0 1 → f p x = 0) :
    ∃ J : P → BallSpace α E F, ContinuousOn J U ∧
      ∀ p ∈ U, ∀ x : closedBall (0 : E) 1,
        (J p).val.1 x = f p x ∧
        (J p).val.2.1 x = fderiv ℝ (f p) x ∧
        (J p).val.2.2 x = fderiv ℝ (fderiv ℝ (f p)) x := by
  let D1 : P → E → (E →L[ℝ] F) := fun p => fderiv ℝ (f p)
  let D2 : P → E → (E →L[ℝ] E →L[ℝ] F) := fun p => fderiv ℝ (D1 p)
  let D3 : P → E → (E →L[ℝ] E →L[ℝ] E →L[ℝ] F) := fun p => fderiv ℝ (D2 p)
  have hf1 : ContDiffOn ℝ 2 (Function.uncurry D1) (U ×ˢ W) :=
    ContDiffOn.fderiv_right (𝕜 := ℝ) (f := f) (n := 2) hW hf
  have hf2 : ContDiffOn ℝ 1 (Function.uncurry D2) (U ×ˢ W) :=
    ContDiffOn.fderiv_right (𝕜 := ℝ) (f := D1) (n := 1) hW hf1
  have hf3 : ContDiffOn ℝ 0 (Function.uncurry D3) (U ×ˢ W) :=
    ContDiffOn.fderiv_right (𝕜 := ℝ) (f := D2) (n := 0) hW hf2
  obtain ⟨v, hv, hveq⟩ := exists_continuous_compact_field f
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf.continuousOn
  obtain ⟨v1, hv1, hv1eq⟩ := exists_continuous_compact_field D1
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf1.continuousOn
  obtain ⟨v2, hv2, hv2eq⟩ := exists_continuous_compact_field D2
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf2.continuousOn
  obtain ⟨v3, hv3, hv3eq⟩ := exists_continuous_compact_field D3
    (fun x : closedBall (0 : E) 1 => (x : E)) continuous_subtype_val
    (fun x => hKW x.property) hf3.continuousOn
  have hslice {G : P → E → F} {m : ℕ∞ω} (hG : ContDiffOn ℝ m (Function.uncurry G) (U ×ˢ W))
      (p : P) (hp : p ∈ U) {x : E} (hx : x ∈ W) : ContDiffAt ℝ m (G p) x :=
    (hG.comp (contDiffOn_const.prodMk contDiffOn_id)
      (fun y hy => ⟨hp, hy⟩) x hx).contDiffAt (hW.mem_nhds hx)
  obtain ⟨J, hJ, hJeq⟩ := exists_continuous_ballJet_family hα v v1 v2 v3 hv hv1 hv2 hv3
    (by
      intro p hp x hx
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx), hv1eq p hp]
      exact hasFDerivAt_domainRead_of_ball_values (v p) (f p) (hveq p hp) hx
        ((hslice hf p hp (hKW (ball_subset_closedBall hx))).differentiableAt (by simp)))
    (by
      intro p hp x hx
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx), hv2eq p hp]
      have hG : ContDiffAt ℝ 2 (D1 p) x :=
        (hf1.comp (contDiffOn_const.prodMk contDiffOn_id)
          (fun y hy => ⟨hp, hy⟩) x (hKW (ball_subset_closedBall hx))).contDiffAt
            (hW.mem_nhds (hKW (ball_subset_closedBall hx)))
      exact hasFDerivAt_domainRead_of_ball_values (v1 p) (D1 p) (hv1eq p hp) hx
        (hG.differentiableAt (by simp)))
    (by
      intro p hp x hx
      rw [domainRead_of_mem _ _ (ball_subset_closedBall hx), hv3eq p hp]
      have hG : ContDiffAt ℝ 1 (D2 p) x :=
        (hf2.comp (contDiffOn_const.prodMk contDiffOn_id)
          (fun y hy => ⟨hp, hy⟩) x (hKW (ball_subset_closedBall hx))).contDiffAt
            (hW.mem_nhds (hKW (ball_subset_closedBall hx)))
      exact hasFDerivAt_domainRead_of_ball_values (v2 p) (D2 p) (hv2eq p hp) hx
        (hG.differentiableAt (by simp)))
    (by intro p hp x hx; rw [hveq p hp]; exact hboundary p hp x hx)
  refine ⟨J, hJ, fun p hp x => ?_⟩
  rw [(hJeq p hp).1, (hJeq p hp).2.1, (hJeq p hp).2.2, hveq p hp, hv1eq p hp, hv2eq p hp]
  exact ⟨rfl, rfl, rfl⟩

end ConformalPoisson.DirichletHolder

end ProofPart_BoundaryAnalytic_FiniteBallJetFamilies

/- Boundary analytic support: FiniteLocalizedSolutionFamily.lean, SHA256 84da51a78ad2345d73ef1a7af7f4f734164b811ea7b26a8e370e999d82161cea -/
