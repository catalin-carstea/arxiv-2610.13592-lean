open scoped Manifold ContDiff
namespace ConformalPoisson

without_proof_info in
theorem conformalGaugeExponent_eq_four_div_pred {n : ℕ} (hn : 2 ≤ n) :
    conformalGaugeExponent n = 4 / ((n - 1 : ℕ) : ℝ) := by
  unfold conformalGaugeExponent
  simp only [Nat.cast_sub (by omega : 1 ≤ n), Nat.cast_one]
  congr 1
  ring

variable {n : ℕ} {M₁ M₂ : Type*} [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁] [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁] [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem inverse_original_solution_relation_at
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂) (U : Set M₁)
    (J : M₁ → M₂) (c : M₁ → ℝ)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x ∈ U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x))
    (f : BoundaryDatum (observedPatch (n := n) V₁)) {x : M₁} (hx : x ∈ U)
    (hc : c x ≠ 0) (y : M₂) (hpoint : J x = y) :
