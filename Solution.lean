noncomputable section ProofPart_NativePullbackOperator





/-
Naturality of the actual signed-potential operator for the actual pullback metric.
The globally smooth map here can be the restriction of a partial diffeomorphism
to its open source; no regularity outside that source is needed in that use.
-/

open Bundle
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁]
  [IsManifold (𝓡∂ (n + 1)) ω M₂]

local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def nativePullbackMetric (g : Metric (n := n) (M := M₂)) (J : M₁ → M₂)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) J)
    (hinv : ∀ x, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x).IsInvertible) :
    Metric (n := n) (M := M₁) :=
  g.pullback J hJ (fun x => (hinv x).injective)

without_proof_info in
@[simp] theorem nativePullbackMetric_inner
    (g : Metric (n := n) (M := M₂)) (J : M₁ → M₂)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) J)
    (hinv : ∀ x, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x).IsInvertible)
    (x : M₁) (v w : TangentSpace (𝓡∂ (n + 1)) x) :
    (nativePullbackMetric g J hJ hinv).inner x v w =
      g.inner (J x) (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x v)
        (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x w) :=
  g.pullback_inner J hJ _ x v w

set_option backward.isDefEq.respectTransparency false in
without_proof_info in
theorem schrodinger_nativePullbackMetric
    (g : Metric (n := n) (M := M₂)) (q : M₂ → ℝ) (J : M₁ → M₂)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) J)
    (hinv : ∀ x, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) J x).IsInvertible)
    (u : M₂ → ℝ) (x : M₁)
    (hu : ContMDiffAt (𝓡∂ (n + 1)) 𝓘(ℝ) 2 u (J x)) :
    schrodinger (nativePullbackMetric g J hJ hinv) (q ∘ J) (u ∘ J) x =
      schrodinger g q u (J x) := by
  exact schrodinger_comp_of_native_isometry (nativePullbackMetric g J hJ hinv) g J
    (g.isLocalRiemannianIsometry_pullback_of_isInvertible hJ hinv) q u x hu

end ConformalPoisson

end ProofPart_NativePullbackOperator

/- Proof support: NativeScaledPullback.lean, SHA256 2894929f0802ce19811848c00a48a8b6f08651ea7326b3e7131bddbec9a8f44b -/
noncomputable section ProofPart_NativeScaledPullback





/-
The original all-data scaling identity gives genuine homogeneous solutions for
the actual pulled-back second problem on the open source. The quotient used here
is the actual first solution divided by the same nonzero multiplier.
-/

open Set
open scoped Manifold ContDiff

namespace ConformalPoisson

variable {n : ℕ} {M₁ M₂ : Type*}
  [TopologicalSpace M₁] [TopologicalSpace M₂]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₁]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M₂]
  [IsManifold (𝓡∂ (n + 1)) ω M₁]
  [IsManifold (𝓡∂ (n + 1)) ω M₂]

without_proof_info in
theorem native_scaled_relation_pullback_homogeneous
    (A₁ : AnalyticProblem (n := n) (M := M₁)) (A₂ : AnalyticProblem (n := n) (M := M₂))
    (V₁ : TopologicalSpace.Opens M₁) (V₂ : TopologicalSpace.Opens M₂)
    (D : MatchingMeasurements A₁ A₂ V₁ V₂)
    (U : TopologicalSpace.Opens M₁) (J : M₁ → M₂) (c : M₁ → ℝ)
    (hJ : ContMDiff (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (∞ + 1) (fun x : U => J x))
    (hinv : ∀ x : U, (mfderiv (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (fun x : U => J x) x).IsInvertible)
    (hJinterior : ∀ x : U, J x ∈ (𝓡∂ (n + 1)).interior M₂)
    (hc : ∀ x : U, c x ≠ 0)
    (hrel : ∀ f : BoundaryDatum (observedPatch (n := n) V₁), ∀ x : U,
      D.solver₁.solve f.val x = c x * D.solver₂.solve
        (f.val ∘ D.boundaryIdentification.symm) (J x))
    (f : BoundaryDatum (observedPatch (n := n) V₁)) (x : U) :
    schrodinger (nativePullbackMetric A₂.smoothMetric (fun x : U => J x) hJ hinv)
      (fun y : U => A₂.potential (J y)) (fun y : U => D.solver₁.solve f.val y / c y) x = 0 := by
  let v := D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm)
  have hf : ContMDiff (𝓡 n) 𝓘(ℝ) ∞ (f.val ∘ D.boundaryIdentification.symm) :=
    f.property.1.comp (D.boundaryIdentification.symm.contMDiff.of_le (by decide))
  have hv := D.solver₂.correct (f.val ∘ D.boundaryIdentification.symm) hf
  have hquot : (fun y : U => D.solver₁.solve f.val y / c y) = v ∘ (fun y : U => J y) := by
    funext y
    change D.solver₁.solve f.val y / c y =
      D.solver₂.solve (f.val ∘ D.boundaryIdentification.symm) (J y)
    rw [hrel f y]
    exact mul_div_cancel_left₀ _ (hc y)
  rw [hquot]
  exact (schrodinger_nativePullbackMetric A₂.smoothMetric A₂.potential _ hJ hinv v x
    (hv.1.contMDiffAt.of_le (by decide))).trans (hv.2.1 (J x) (hJinterior x))

end ConformalPoisson

end ProofPart_NativeScaledPullback

