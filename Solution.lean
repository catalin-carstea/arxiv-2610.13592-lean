    {b : V → V} (hb : AnalyticAt ℝ b 0)
    (hface : ∀ᶠ x in 𝓝 (0 : V), b (boundaryTangentialProjection x) 0 = 0) :
    ∃ β : V → V, AnalyticAt ℝ β 0 ∧ ∀ᶠ x in 𝓝 (0 : V), b x = boundaryNormalDrift β x := by
  let N : V →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0
  obtain ⟨B, hB, hfactor⟩ := exists_analytic_boundary_coordinate_factor ((N.analyticAt _).comp hb) hface
  refine ⟨boundaryNormalFactorBundle b B, boundaryNormalFactorBundle_analyticAt hb hB, ?_⟩
