          traceCLM ℝ P (splitChartPrincipal g c z ∘L Wkp.iteratedGradient 1 U z) = f z := by
  obtain ⟨U, hU, hZ⟩ := exists_split_boundary_chart_readings (p := p) hp c b hbr hrt hu.1
    (fun x hx => hu.2.2 ⟨x, hx⟩)
