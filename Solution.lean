noncomputable section ProofPart_TangentialJumpReference




/- A tangential jump across a flat hyperplane has zero distributional
divergence. This is the reference field needed when a tangential
Dirichlet derivative is reflected across the boundary. -/
open Set Metric MeasureTheory TopologicalSpace TauCeti TauCeti.PDE InnerProductSpace
open scoped Distributions Gradient InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem weakLineDeriv_halfspaceIndicator_tangent (ν v : V) (a : ℝ)
    (hv : ⟪ν, v⟫_ℝ = 0) (Ω : Opens V) :
    HasWeakLineDerivOn volume Ω ({x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => (1 : ℝ))
      (fun _ => 0) v := by
  let g : V → ℝ := {x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => (1 : ℝ)
  have hs : MeasurableSet {x : V | a < ⟪ν, x⟫_ℝ} :=
    (isOpen_lt continuous_const (continuous_const.inner continuous_id)).measurableSet
  apply hasWeakLineDerivOn_of_hasLineDerivAt
    (locallyIntegrableOn_indicator_const hs.nullMeasurableSet 1) locallyIntegrableOn_zero
  intro x hx
  change HasDerivAt (fun t : ℝ => g (x + t • v)) 0 0
  have hconst : (fun t : ℝ => g (x + t • v)) = fun _ => g x := by
    funext t
    change (if a < ⟪ν, x + t • v⟫_ℝ then 1 else 0) = (if a < ⟪ν, x⟫_ℝ then 1 else 0)
    simp only [inner_add_right, inner_smul_right, hv, mul_zero, add_zero]
  rw [hconst]
  exact hasDerivAt_const _ _

without_proof_info in
theorem setIntegral_inner_halfspaceIndicator_gradient_eq_zero (ν v : V) (a : ℝ)
    (hv : ⟪ν, v⟫_ℝ = 0) {Ω : Opens V} (φ : 𝓓(Ω, ℝ)) :
    (∫ x in (Ω : Set V), ⟪({x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => v) x,
      ∇ (φ : V → ℝ) x⟫_ℝ) = 0 := by
  let g : V → ℝ := {x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => (1 : ℝ)
  have hweak := weakLineDeriv_halfspaceIndicator_tangent ν v a hv Ω
  have hzero := hweak.integral_lineDeriv_smul_eq_neg_integral_smul φ
  simp only [smul_eq_mul, mul_zero, integral_zero, neg_zero] at hzero
  rw [φ.setIntegral_inner_gradient_eq_integral_inner_gradient _ φ.tsupport_subset]
  calc
    _ = ∫ x, lineDeriv ℝ (φ : V → ℝ) x v * g x := by
      apply integral_congr_ae
      exact ae_of_all _ fun x => by
        change ⟪({x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => v) x, ∇ (φ : V → ℝ) x⟫_ℝ =
          lineDeriv ℝ (φ : V → ℝ) x v * g x
        have hφ := φ.contDiff.differentiable (by simp) x
        rw [hφ.lineDeriv_eq_fderiv]
        by_cases hx : a < ⟪ν, x⟫_ℝ
        · simp only [g, indicator_of_mem (show x ∈ {x : V | a < ⟪ν, x⟫_ℝ} from hx), mul_one, inner_gradient_right, conj_trivial]
        · simp only [g, indicator_of_notMem (show x ∉ {x : V | a < ⟪ν, x⟫_ℝ} from hx), inner_zero_left, mul_zero]
    _ = 0 := hzero

without_proof_info in
theorem sobolevDivergenceFree_halfspaceIndicator_tangent (ν v : V) (a : ℝ)
    (hv : ⟪ν, v⟫_ℝ = 0) {Ω : Opens V}
    (hLp : MemLp ({x : V | a < ⟪ν, x⟫_ℝ}.indicator fun _ => v) 2
      (volume.restrict (Ω : Set V))) :
    SobolevDivergenceFree Ω hLp.toLp := by
  apply sobolevDivergenceFree_of_testFunction
  intro φ
  rw [L2.inner_def]
  rw [W1p.gradient_ofTestFunctionₗ]
  have hφ := gradientTestFunctionLp_apply_ae (mu := volume) 2 φ
  refine (integral_congr_ae ?_).trans (setIntegral_inner_halfspaceIndicator_gradient_eq_zero ν v a hv φ)
  filter_upwards [hLp.coeFn_toLp, hφ] with x hCx hφx
  rw [hCx, hφx]
end ConformalPoisson

end ProofPart_TangentialJumpReference

