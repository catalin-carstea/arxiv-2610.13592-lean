      (fderiv ℝ (fun a => G a z) x) (fderiv ℝ (fderiv ℝ (fun a => G a z)) x)) s y v =
    ordinaryJet (fderivWithin ℝ (G x) s y v)
      (fderivWithin ℝ (fun z => fderiv ℝ (fun a => G a z) x) s y v)
      (fderivWithin ℝ (fun z => fderiv ℝ (fderiv ℝ (fun a => G a z)) x) s y v) at hvalue
  exact hvalue.trans (congrArg₂ (ordinaryJet (fderivWithin ℝ (G x) s y v))
    (fderiv_fderivWithin_slice_eq (hG.of_le (by simp)) hs hy hycl v).symm
    (secondFDeriv_fderivWithin_slice_eq (hG.of_le (by simp)) hs hy hycl v).symm)

end ConformalPoisson

