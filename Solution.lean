/- Finite-dimensional coefficient targets are assembled from the proved
scalar family on one common parameter neighborhood. This applies to both
the drift vector and principal coefficient operator. -/
open Set Metric
open scoped NNReal ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {V F : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [ProperSpace V]
  [NormedAddCommGroup F] [NormedSpace ℝ F] {d m : ℕ}

without_proof_info in
theorem exists_finite_analytic_localized_holder_family {α : ℝ≥0} (hα : α ≤ 1)
    (T : V ≃L[ℝ] (Fin d → ℝ)) (S : F ≃L[ℝ] (Fin m → ℝ))
    (f : V → F) (χ : V → ℝ) (hχ : ContDiff ℝ 1 χ)
    {W : Set V} (hW : IsOpen W) (hKW : closedBall (0 : V) 1 ⊆ W)
    (hf : AnalyticOnNhd ℝ f W) :
    ∃ (U : Set V) (H : V → TauCeti.HolderSpace α (closedBall (0 : V) 1) F),
      IsOpen U ∧ (0 : V) ∈ U ∧ AnalyticOnNhd ℝ H U ∧
        ∀ a ∈ U, ∀ x : closedBall (0 : V) 1, H a x = f (x + χ x • a) := by
  classical
