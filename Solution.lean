  apply Lp.ext
  filter_upwards [L.innerReadingL_smooth_value_ae v,
    W1p.value_ofTestFunctionₗ_ae (mu := (Module.finBasis ℝ V).addHaar) (p := 2) φ,
    ae_restrict_mem L.innerCap.isOpen.measurableSet] with z hv hφ hz
  rw [hv, Function.comp_apply, hread z hz, hφ]

without_proof_info in
/-- The native forcing read in a chart, multiplied by chart density,
is square integrable on the inner cap. -/
theorem memLp_weightedForcing_innerCap {F : M → ℝ} (hF : Continuous F) :
    MemLp (fun z => chartVolumeDensity (I := I) c ((extChartAt I c).symm z) *
      F ((extChartAt I c).symm z)) 2 ((Module.finBasis ℝ V).addHaar.restrict (L.innerCap : Set V)) :=
  ((continuousOn_chartWeightedPotential_target (I := I) c hF).mono L.closure_innerCap_subset_target).memLp_restrict_of_subset_isCompact
    (μ := (Module.finBasis ℝ V).addHaar) (E := ℝ)
    (isBounded_ball.subset (inter_subset_left : (L.innerCap : Set V) ⊆ _)).isCompact_closure
    L.innerCap.isOpen.measurableSet subset_closure 2

without_proof_info in
/-- A genuine Euclidean weak equation for the actual reading of a
native weak solution, against every canonical zero-trace Sobolev test. -/
theorem innerReadingL_weak_equation {q F : M → ℝ}
    (hq : Continuous q) (hF : Continuous F)
    (u : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x})
    (hu : ∀ v : zeroTraceSubmodule (I := I) {x : M | I.IsBoundaryPoint x},
      schrodingerForm (I := I) {x : M | I.IsBoundaryPoint x}
          (ContinuousMap.toLp ⊤ (riemannianVolume I M) ℝ ⟨q, hq⟩) u v =
        ⟪ContinuousMap.toLp 2 (riemannianVolume I M) ℝ ⟨F, hF⟩,
          valueL (I := I) {x : M | I.IsBoundaryPoint x} v⟫_ℝ)
    (v : W1p0 (Module.finBasis ℝ V).addHaar L.innerCap 2) :
    energyFormH1 (mu := (Module.finBasis ℝ V).addHaar) (Omega := L.innerCap)
        (chartWeightedPrincipal (I := I) c) 0 (chartWeightedPotential (I := I) c q)
        (L.innerReadingL u) (v : W1p (Module.finBasis ℝ V).addHaar L.innerCap 2) =
      ∫ z in (L.innerCap : Set V),
        (chartVolumeDensity (I := I) c ((extChartAt I c).symm z) * F ((extChartAt I c).symm z)) *
          W1p.value (v : W1p (Module.finBasis ℝ V).addHaar L.innerCap 2) z ∂(Module.finBasis ℝ V).addHaar := by
  let f := fun z => chartVolumeDensity (I := I) c ((extChartAt I c).symm z) * F ((extChartAt I c).symm z)
  have hcoeff := L.memLp_chartWeightedEnergy_innerCap hq
  have hFLp := L.memLp_weightedForcing_innerCap hF
  have htest : ∀ φ : 𝓓(L.innerCap, ℝ),
      energyFormH1 (mu := (Module.finBasis ℝ V).addHaar) (Omega := L.innerCap)
          (chartWeightedPrincipal (I := I) c) 0 (chartWeightedPotential (I := I) c q)
          (L.innerReadingL u) (W1p.ofTestFunctionₗ (Module.finBasis ℝ V).addHaar L.innerCap 2 φ) =
        ∫ z in (L.innerCap : Set V), (hFLp.toLp f) z * φ z ∂(Module.finBasis ℝ V).addHaar := by
    intro φ
    obtain ⟨v, hsupp, hread⟩ := L.exists_native_test_reading φ
    have h := L.innerReadingL_weak_equation_native_tests hq hF u hu v hsupp
    rw [hread] at h
    refine h.trans (integral_congr_ae ?_)
    filter_upwards [hFLp.coeFn_toLp,
      W1p.value_ofTestFunctionₗ_ae (mu := (Module.finBasis ℝ V).addHaar) (p := 2) φ] with z hf hφ
    rw [hf, hφ]
  have h := (forall_energyFormH1_eq_setIntegral_iff_forall_testFunction
    (mu := (Module.finBasis ℝ V).addHaar) (Omega := L.innerCap) hcoeff (hFLp.toLp f) (L.innerReadingL u)).2 htest v
  refine h.trans (integral_congr_ae ?_)
  filter_upwards [hFLp.coeFn_toLp] with z hz
  rw [hz]
end ConformalPoisson.BoundaryChartLocalization

