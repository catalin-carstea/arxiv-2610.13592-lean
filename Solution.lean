/- Boundary analytic support: ReflectedDriftHolder.lean, SHA256 4c119ec22c8f386e8dcdc497f1543125e0a33e6ec22718dd707a4d96da67b253 -/
noncomputable section ProofPart_BoundaryAnalytic_ReflectedDriftHolder


/- One bounded Holder map reflects a bundled analytic drift. The normal
factor is multiplied by epsilon only after the ordinary smallness scaling.
All operator constants are fixed before the coefficients and the solution. -/
open Set Metric
open scoped NNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {α : ℝ≥0}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "H" F => TauCeti.HolderSpace α (closedBall (0 : V) 1) F

def tangentFoldHolderL : (H V) →L[ℝ] (H V) :=
  (TauCeti.HolderSpace.compLeftL boundaryTangentialProjection).comp evenFoldHolderL

def normalDriftFoldHolderL (T : H ℝ) : (H V) →L[ℝ] (H V) :=
  (TauCeti.HolderSpace.compLeftL
      ((ContinuousLinearMap.id ℝ ℝ).smulRight (EuclideanSpace.single 0 1 : V))).comp
    ((normalFactorFoldHolderL T).comp
      (TauCeti.HolderSpace.compLeftL (PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0)))

def scaledDriftFoldHolderL (ε : ℝ) (T : H ℝ) : (H V) →L[ℝ] (H V) :=
  tangentFoldHolderL + ε • normalDriftFoldHolderL T

without_proof_info in
@[simp] theorem scaledDriftFoldHolderL_apply (ε : ℝ) (T : H ℝ) (f : H V)
    (x : closedBall (0 : V) 1) :
    scaledDriftFoldHolderL ε T f x =
      boundaryTangentialProjection (f (boundaryFoldClosed x)) +
        (ε * T x * (f (boundaryFoldClosed x)) 0) • EuclideanSpace.single 0 1 := by
  simp [scaledDriftFoldHolderL, tangentFoldHolderL, normalDriftFoldHolderL,
    smul_smul, mul_assoc]

without_proof_info in
theorem norm_scaledDriftFoldHolderL_le (ε : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1)
    (T : H ℝ) :
    ‖scaledDriftFoldHolderL ε T‖ ≤
      ‖(tangentFoldHolderL : (H V) →L[ℝ] (H V))‖ + ‖normalDriftFoldHolderL T‖ := by
  calc
    _ ≤ ‖(tangentFoldHolderL : (H V) →L[ℝ] (H V))‖ +
        ‖ε • normalDriftFoldHolderL T‖ := norm_add_le _ _
    _ ≤ _ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hε0]
      have hn := norm_nonneg (normalDriftFoldHolderL T)
      nlinarith

without_proof_info in
theorem analyticAt_scaledDriftFoldHolderFamily
    {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P] {a : P}
    (ε : ℝ) (T : H ℝ) {f : P → H V} (hf : AnalyticAt ℝ f a) :
    AnalyticAt ℝ (fun p => scaledDriftFoldHolderL ε T (f p)) a :=
  ((scaledDriftFoldHolderL ε T).analyticAt _).comp hf

end ConformalPoisson

end ProofPart_BoundaryAnalytic_ReflectedDriftHolder

