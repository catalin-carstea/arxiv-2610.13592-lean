without_proof_info in
theorem ae_eq_smooth_of_localized_lp_one
    {d : ℕ} (u : Lp ℂ 1 (volume : Measure (CoordinateSpace d)))
    (φ : 𝓢(CoordinateSpace d, ℂ)) (hφ : ∀ x, ‖φ x‖ ≤ 1)
    (f : CoordinateSpace d → ℂ) (hf : ContDiff ℝ ∞ f)
    (hrep : ∀ ψ : 𝓢(CoordinateSpace d, ℂ),
      TemperedDistribution.smulLeftCLM ℂ (φ : CoordinateSpace d → ℂ) (u : 𝓢'(CoordinateSpace d, ℂ)) ψ =
