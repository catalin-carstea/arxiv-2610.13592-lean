noncomputable section ProofPart_GreenTrace_NativeWeakGreenReciprocity



/- Weak symmetry and homogeneous test identities for the actual inverse rows.
No joint measurability or smooth pointwise kernel is assumed. -/
open Bundle Set MeasureTheory TauCeti Filter
open scoped Manifold ContDiff ENNReal NNReal Topology
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)

without_proof_info in
theorem NativeInverseLpRowFamily.weak_reciprocity
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseLpRowFamily g q s)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (F H : C^∞⟮Ihalf, M; ℝ⟯) :
    (∫ x, H x * (∫ z, K.row x z * F z ∂nativeVolume g) ∂nativeVolume g) =
      ∫ x, F x * (∫ z, K.row x z * H z ∂nativeVolume g) ∂nativeVolume g := by
  obtain ⟨u, hu⟩ := exists_zeroDirichletSolution g q hq hNR F F.contMDiff
  obtain ⟨v, hv⟩ := exists_zeroDirichletSolution g q hq hNR H H.contMDiff
  have hFrep : (fun x => ∫ z, K.row x z * F z ∂nativeVolume g) = u :=
    funext fun x => (K.representation x F u hu).2.symm
  have hHrep : (fun x => ∫ z, K.row x z * H z ∂nativeVolume g) = v :=
    funext fun x => (K.representation x H v hv).2.symm
  change (∫ x, H x * (fun x => ∫ z, K.row x z * F z ∂nativeVolume g) x ∂nativeVolume g) =
    ∫ x, F x * (fun x => ∫ z, K.row x z * H z ∂nativeVolume g) x ∂nativeVolume g
  rw [hFrep, hHrep]
  exact (nativeInverseReciprocity g q hq hNR F H u v F.contMDiff H.contMDiff hu hv).symm

without_proof_info in
theorem normalDerivative_eq_zero_of_notMem_tsupport
    (ν : (y : (Ihalf).boundary M) → TangentSpace Ihalf (y : M))
    (u : M → ℝ) (y : (Ihalf).boundary M) (hy : (y : M) ∉ tsupport u) :
    normalDerivative ν u y = 0 := by
  rw [normalDerivative_eq_of_eventuallyEq ν y (notMem_tsupport_iff_eventuallyEq.mp hy)]
  simp [normalDerivative]

without_proof_info in
theorem NativeInverseNormalLpRowFamily.homogeneous_test_identity
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseNormalLpRowFamily g q ν s)
    (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q) (y : (Ihalf).boundary M)
    (u : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hsupp : tsupport u ⊆ (Ihalf).interior M) :
    Integrable (fun z => K.row y z * schrodinger g q u z) (nativeVolume g) ∧
      (∫ z, K.row y z * schrodinger g q u z ∂nativeVolume g) = 0 := by
  have hnot (z : (Ihalf).boundary M) : (z : M) ∉ tsupport u := by
    intro hz
    have hzc : (z : M) ∈ ((Ihalf).interior M)ᶜ := by
      rw [(Ihalf).compl_interior]
      exact z.property
    exact hzc (hsupp hz)
