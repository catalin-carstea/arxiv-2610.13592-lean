without_proof_info in
theorem ae_restrict_haar_iff
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [LocallyCompactSpace E] [SecondCountableTopology E]
    (μ ν : Measure E) [μ.IsAddHaarMeasure] [ν.IsAddHaarMeasure]
    (S : Set E) (P : E → Prop) :
    (∀ᵐ x ∂μ.restrict S, P x) ↔ ∀ᵐ x ∂ν.restrict S, P x := by
  exact ⟨fun h => ((Measure.absolutelyContinuous_isAddHaarMeasure ν μ).restrict S).ae_le h,
    fun h => ((Measure.absolutelyContinuous_isAddHaarMeasure μ ν).restrict S).ae_le h⟩

variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem native_chart_representative_ae_of_volume
    (g : Metric (n := n) (M := M)) (c : M) (Ω : TopologicalSpace.Opens V)
    (hΩt : (Ω : Set V) ⊆ (extChartAt Ihalf c).target) (k : M → ℝ) (v : V → ℝ)
    (hread : (fun z => k ((extChartAt Ihalf c).symm z)) =ᵐ[volume.restrict Ω] v) :
    (v ∘ extChartAt Ihalf c) =ᵐ[(nativeVolume g).restrict
      ((extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (Ω : Set V))] k := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  have hμ : (fun z => k ((extChartAt Ihalf c).symm z)) =ᵐ[(Module.finBasis ℝ V).addHaar.restrict Ω] v :=
    (ae_restrict_haar_iff (Module.finBasis ℝ V).addHaar volume Ω _).mpr hread
  apply ae_native_chart_preimage c hΩt
  filter_upwards [hμ, ae_restrict_mem Ω.isOpen.measurableSet] with z hz hzΩ
  rw [Function.comp_apply, (extChartAt Ihalf c).right_inv (hΩt hzΩ)]
  exact hz.symm

without_proof_info in
theorem contMDiffOn_native_coordinate_representative
    (c : M) (Ω : TopologicalSpace.Opens V) (v : V → ℝ) (hv : ContDiffOn ℝ ∞ v Ω) :
    ContMDiffOn Ihalf 𝓘(ℝ) ∞ (v ∘ extChartAt Ihalf c)
      ((extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (Ω : Set V)) := by
  have hc : ContMDiffOn Ihalf 𝓘(ℝ, V) ∞ (extChartAt Ihalf c)
      ((extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (Ω : Set V)) :=
    (contMDiffOn_extChartAt (I := Ihalf) (x := c)).mono
      (fun x hx => by simpa only [extChartAt_source] using hx.1)
  exact hv.contMDiffOn.comp hc (fun _ hx => hx.2)

without_proof_info in
theorem native_coordinate_representative_classical_equation
    (g : Metric (n := n) (M := M)) (q : M → ℝ) (c : M) (Ω : TopologicalSpace.Opens V)
    (hΩt : (Ω : Set V) ⊆ (extChartAt Ihalf c).target)
    (v : V → ℝ) (hv : ContDiffOn ℝ ∞ v Ω)
    (hPv : ∀ z ∈ Ω, coordinateSchrodinger (nativeChartPrincipal g c) (nativeChartDrift g c)
      (nativeChartPotential c q) v z = 0) :
    ∀ x ∈ (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' (Ω : Set V),
      schrodinger g q (v ∘ extChartAt Ihalf c) x = 0 := by
  let O : TopologicalSpace.Opens M := ⟨(extChartAt Ihalf c).source ∩
    extChartAt Ihalf c ⁻¹' (Ω : Set V), isOpen_extChartAt_preimage' c Ω.isOpen⟩
  have hu := contMDiffOn_native_coordinate_representative c Ω v hv
  intro x hx
  have hzi : extChartAt Ihalf c x ∈ interior (extChartAt Ihalf c).target := by
    apply interior_mono hΩt
    rw [Ω.isOpen.interior_eq]
    exact hx.2
