/- The finite normal-form coefficients are actual scalar readings of
the original analytic principal, drift and signed potential germs. -/
open Set
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ}
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

without_proof_info in
theorem scalarNormalTermCoefficient_analyticOnNhd
    (A : V → V →L[ℝ] V) (b : V → V) (q : V → ℝ) {W : Set V}
    (hA : AnalyticOnNhd ℝ A W) (hb : AnalyticOnNhd ℝ b W) (hq : AnalyticOnNhd ℝ q W)
    (i : ScalarNormalTermIndex n) : AnalyticOnNhd ℝ (scalarNormalTermCoefficient A b q i) W := by
  cases i with
  | inl ij =>
    rcases ij with ⟨i, j⟩
    intro x hx
    let L : (V →L[ℝ] V) →L[ℝ] ℝ :=
      (PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) j.succ).comp
        (ContinuousLinearMap.apply ℝ V (EuclideanSpace.single i.succ 1))
    have h := ((L.analyticAt _).comp (hA x hx)).neg
    simpa [L, scalarNormalTermCoefficient, Function.comp_def, Pi.neg_def] using h
  | inr i => cases i with
    | inl i =>
      intro x hx
      simpa [scalarNormalTermCoefficient, Function.comp_def] using
        ((PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) i.succ).analyticAt _).comp (hb x hx)
    | inr b' => cases b' with
      | false => exact hq
      | true =>
        intro x hx
        simpa [scalarNormalTermCoefficient, Function.comp_def] using
          ((PiLp.proj 2 (fun _ : Fin (n + 1) => ℝ) 0).analyticAt _).comp (hb x hx)

end ConformalPoisson

