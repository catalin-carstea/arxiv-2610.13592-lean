noncomputable section ProofPart_GreenTrace_ClosedGraphValueLift


/- Lift a bounded value transformation through a Banach function space
when a representative exists uniquely. Intended caller: the pinned odd
W2p extension, whose boundedness is enough for boundary Morrey estimates. -/
namespace ConformalPoisson
variable {X Y Z : Type*}
  [NormedAddCommGroup X] [NormedSpace ℝ X] [CompleteSpace X]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z]

without_proof_info in
theorem exists_continuous_lift_of_injective_value
    (A : X →L[ℝ] Z) (B : Y →L[ℝ] Z) (hB : Function.Injective B)
    (hex : ∀ x, ∃ y, B y = A x) :
    ∃ T : X →L[ℝ] Y, ∀ x, B (T x) = A x := by
  classical
  let s : X → Y := fun x => Classical.choose (hex x)
  have hs : ∀ x, B (s x) = A x := fun x => Classical.choose_spec (hex x)
  let L : X →ₗ[ℝ] Y :=
    { toFun := s
      map_add' x y := hB (by rw [map_add, hs, hs, hs, map_add])
      map_smul' c x := hB (by simpa only [RingHom.id_apply] using
        (show B (s (c • x)) = B (c • s x) by rw [map_smul, hs, hs, map_smul])) }
  have hgraph : IsClosed (L.graph : Set (X × Y)) := by
    have hc : IsClosed {p : X × Y | B p.2 = A p.1} :=
      isClosed_eq (B.continuous.comp continuous_snd) (A.continuous.comp continuous_fst)
    convert hc using 1
    ext ⟨x, y⟩
    simp only [SetLike.mem_coe, LinearMap.mem_graph_iff, Set.mem_ofPred_eq]
    constructor
    · intro hy
      rw [hy]
      exact hs x
    · intro hy
      exact hB (hy.trans (hs x).symm)
  exact ⟨ContinuousLinearMap.ofIsClosedGraph hgraph, hs⟩

end ConformalPoisson

end ProofPart_GreenTrace_ClosedGraphValueLift

