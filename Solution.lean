  constant : ℝ
  constant_positive : 0 < constant
  metric_eq : h = (conformalGaugeMetric g c multiplier_smooth multiplier_positive).rescale
    (fun _ => constant) contMDiff_const (fun _ => constant_positive)
  potential_eq : ∀ x, p x = constant⁻¹ * conformalGaugePotential g q c x

