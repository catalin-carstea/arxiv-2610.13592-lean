    ∃ C ≥ 0, ∀ u : Wkp (volume : Measure P) Ω (q : ℝ≥0∞) 2,
      (∀ ζ : P → ℝ, ContDiff ℝ ∞ ζ → HasCompactSupport ζ → tsupport ζ ⊆ ball x₀ R →
        ∀ w : Wkp (volume : Measure P) Ω (q : ℝ≥0∞) 2,
          Wkp.value 2 w =ᵐ[(volume : Measure P).restrict Ω] (fun x => ζ x * Wkp.value 2 u x) →
          Wkp.firstOrder 1 w ∈ w1p0Submodule volume Ω (q : ℝ≥0∞)) →
      (∀ r > 0, r < R → (R - r) ^ 2 * lpNorm (Wkp.iteratedGradient 1 u) (q : ℝ≥0∞)
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ r)) ≤
        D * lpNorm (Wkp.value 2 u) (q : ℝ≥0∞) ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R))) →
      MemLp (Wkp.value 2 u) (s : ℝ≥0∞)
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ (R / 4))) ∧
      lpNorm (Wkp.value 2 u) (s : ℝ≥0∞)
        ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ (R / 4))) ≤
        C * lpNorm (Wkp.value 2 u) (q : ℝ≥0∞) ((volume : Measure P).restrict ((Ω : Set P) ∩ ball x₀ R)) := by
  let : Fact (1 ≤ (s : ℝ≥0∞)) :=
    ⟨(Fact.out : 1 ≤ (q : ℝ≥0∞)).trans (ENNReal.coe_le_coe.mpr hqs)⟩
  obtain ⟨c₀, hc₀, hcut⟩ := exists_forall_contDiff_cutoff_closedBall (E := P)
  obtain ⟨η, hη, hηrange, hηone, hηts, hηg, hηh⟩ :=
    hcut x₀ (show 0 ≤ R / 4 by positivity) (show R / 4 < 3 * R / 8 by linarith)
  have hηc : HasCompactSupport η := (isCompact_closedBall x₀ (3 * R / 8)).of_isClosed_subset
    (isClosed_tsupport η) hηts
  have hηs : tsupport η ⊆ ball x₀ (R / 2) := hηts.trans (closedBall_subset_ball (by linarith))
  have hηabs : ∀ x, |η x| ≤ 1 := fun x => abs_le.mpr
    ⟨by linarith [(hηrange ⟨x, rfl⟩).1], (hηrange ⟨x, rfl⟩).2⟩
  have hηinner : EqOn η 1 ((Ω : Set P) ∩ ball x₀ (R / 4)) :=
    fun x hx => hηone (ball_subset_closedBall hx.2)
  obtain ⟨B, hB, hreading⟩ := exists_bounded_halfBall_w2p_reading (p := (q : ℝ≥0∞))
    ENNReal.coe_ne_top a Ω x₀ R hR hmatch D hD η hη hηc hηs hηabs hηinner _ _ hηg hηh
  have hVc : IsCompact (closure (ball x₀ (R / 4))) :=
