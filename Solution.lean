  [LindelofSpace ((𝓡∂ (n + 1)).boundary M)]

without_proof_info in
/-- The nonvanishing assertion is derived, not included in the literature hypotheses. -/
theorem DirichletGreenKernel.poisson_section_not_zero
    (hInverse : ForwardInhomogeneousAssumption (n := n) (M := M))
    (hEstimate : NormalTraceInverseEstimateAssumption (n := n) (M := M))
    (g : Metric (n := n) (M := M)) (q : M → ℝ)
    (hq : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ q) (hNR : Nonresonant g q)
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace (𝓡∂ (n + 1)) (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (S : DirichletSolver g q) (G : DirichletGreenKernel g q ν S)
    (y : (𝓡∂ (n + 1)).boundary M) :
    ¬ ∀ x ∈ (𝓡∂ (n + 1)).interior M, boundaryPoissonSection ν G.kernel y x = 0 := by
  obtain ⟨Z⟩ := hInverse isCompact_univ g q hq hNR
  obtain ⟨w, hw, htrace, hnormal⟩ := exists_zero_boundary_normal_ne_zero ν y (hν y).1
  let F := schrodinger g q w
  have hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F := contMDiff_schrodinger g q w hq hw
  have hsol : IsZeroDirichletSolution g q F w := ⟨hw, fun _ _ => rfl, htrace⟩
  let r : ℝ := n + 2
  have hr : (n + 1 : ℝ) < r := by dsimp only [r]; linarith
  have hr0 : 0 < r := by dsimp only [r]; positivity
  obtain ⟨C, hC⟩ := hEstimate isCompact_univ g q hq hNR ν hν r hr
  obtain ⟨Fm, hFm, hsupp, hinterior, _, _, ht⟩ :=
    exists_native_interior_forcing_approximation g (ENNReal.ofReal r)
      (ne_of_gt (ENNReal.ofReal_pos.mpr hr0)) ENNReal.ofReal_ne_top F hF
  exact G.poisson_section_not_zero_of_approximation Z y (ENNReal.ofReal r) C
    (fun H u hH hu => hC H u hH hu y) F w hF hsol hnormal Fm hFm hsupp hinterior ht

end ConformalPoisson

