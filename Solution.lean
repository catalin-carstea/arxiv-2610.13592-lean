/-- With a test supported in the inner native chart region, its native
energy is exactly the weighted coordinate energy of the actual readings. -/
theorem schrodingerForm_smooth_eq_innerEnergy {q : M → ℝ} (hq : Continuous q)
    (u v : smoothZeroOn (I := I) {x : M | I.IsBoundaryPoint x})
    (hv : tsupport v.val ⊆ (extChartAt I c).source ∩ extChartAt I c ⁻¹' (L.innerCap : Set V)) :
    schrodingerForm (I := I) {x : M | I.IsBoundaryPoint x}
