noncomputable section ProofPart_GreenTrace_GreenBoundaryExponentLadder


/- A finite subcritical ladder starting at ANY exponent greater than one,
as needed for the actual conjugate-Lp Green rows. The arithmetic extends
the earlier BoundaryExponentLadder (which starts at two); that file's
reciprocal-difference helper is private, so its elementary calculation is
stated publicly here for the new low-exponent consumer. -/
open Set Module MeasureTheory TopologicalSpace Filter TauCeti
open scoped ENNReal NNReal
namespace ConformalPoisson

without_proof_info in
theorem inverse_sub_inverse_le_sub_of_one_le {a b : ℝ} (ha : 1 ≤ a) (hab : a ≤ b) :
    1 / a - 1 / b ≤ b - a := by
  have ha0 : 0 < a := lt_of_lt_of_le zero_lt_one ha
  have hb0 : 0 < b := ha0.trans_le hab
  have heq : 1 / a - 1 / b = (b - a) / (a * b) := by field_simp
  rw [heq]
  exact div_le_self (sub_nonneg.mpr hab) (one_le_mul_of_one_le_of_one_le ha (ha.trans hab))

set_option maxHeartbeats 500000 in
without_proof_info in
theorem exists_subcritical_exponent_ladder (a b d : ℝ≥0) (ha : 1 < a) (hd : 0 < d) :
    ∃ N : ℕ, ∃ s : ℕ → ℝ≥0, s 0 = a ∧ b ≤ s N ∧
      (∀ i, 1 < (s i : ℝ≥0∞)) ∧
      (∀ i, s i ≤ s (i + 1)) ∧
      ∀ i, 1 / (s i : ℝ) - 1 / (s (i + 1) : ℝ) < 1 / (d : ℝ) := by
  let s : ℕ → ℝ≥0 := fun i => a + i / (d + 1)
  have hden : (0 : ℝ) < (d : ℝ) + 1 := by positivity
  obtain ⟨N, hN⟩ := exists_nat_gt ((b : ℝ) * ((d : ℝ) + 1))
  have hNdiv : (b : ℝ) < (N : ℝ) / ((d : ℝ) + 1) := (lt_div_iff₀ hden).mpr hN
  have hsa : ∀ i, a ≤ s i := fun i => le_add_of_nonneg_right (by positivity)
  have hmono : ∀ i, s i ≤ s (i + 1) := by
    intro i
    dsimp [s]
    gcongr
    exact_mod_cast Nat.le_succ i
  refine ⟨N, s, by simp [s], ?_, ?_, hmono, ?_⟩
  · have ha0 : (0 : ℝ) ≤ a := a.property
    have hN' : (b : ℝ) ≤ (s N : ℝ) := by
      dsimp [s]
      push_cast
      linarith
    exact_mod_cast hN'
  · intro i
    have h : (1 : ℝ≥0) < s i := ha.trans_le (hsa i)
    exact_mod_cast h
  · intro i
    have hp : (1 : ℝ) ≤ s i := by exact_mod_cast (ha.le.trans (hsa i))
    have hpq : (s i : ℝ) ≤ s (i + 1) := by exact_mod_cast hmono i
    have hdiff : (s (i + 1) : ℝ) - s i = 1 / ((d : ℝ) + 1) := by
      dsimp [s]
      push_cast
      ring
    refine (inverse_sub_inverse_le_sub_of_one_le hp hpq).trans_lt ?_
    rw [hdiff]
    exact one_div_lt_one_div_of_lt (by exact_mod_cast hd) (by linarith)

end ConformalPoisson

end ProofPart_GreenTrace_GreenBoundaryExponentLadder

