  normalCutoffWave η (scaledPlaneWave ξ h (B.profile a j))

without_proof_info in
theorem singleCutoffWave_eq {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (a : Y → ℂ) (η : ℝ → ℝ) (j : ℕ) (h : ℝ) :
    B.singleCutoffWave a η j h = fun x => tangentialWave ξ h x.1 *
      cutoffProfileFamily η B.kappa (B.layerPolynomial a j) h x := by
  funext x
  unfold singleCutoffWave normalCutoffWave scaledPlaneWave profile cutoffProfileFamily polynomialProfileFamily polynomialProfile
  simp only [Complex.real_smul]
  ring

without_proof_info in
theorem singleCutoffWave_contDiff {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) {K : Set Y} (hK : IsClosed K) (hKU : K ⊆ U) (a : Y → ℂ)
    (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (η : ℝ → ℝ) (hη : ContDiff ℝ ∞ η) (j : ℕ) (h : ℝ) :
    ContDiff ℝ ∞ (B.singleCutoffWave a η j h) :=
  contDiff_normalCutoffWave hη (contDiff_scaledPlaneWave ξ h (B.profile_contDiff hU hK hKU a ha ha0 j))

without_proof_info in
theorem singleCutoffWave_tsupport_subset {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) {K : Set Y} (hK : IsClosed K) (a : Y → ℂ)
    (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0) (η : ℝ → ℝ) (j : ℕ) (h : ℝ) :
    tsupport (B.singleCutoffWave a η j h) ⊆ K ×ˢ tsupport η := by
  rw [B.singleCutoffWave_eq]
  exact (tsupport_mul_subset_right).trans (cutoffProfileFamily_tsupport_subset η B.kappa _ h hK
    (B.layerPolynomial_properties hU hK a ha ha0 j).2.2)

without_proof_info in
theorem singleCutoffWave_hasCompactSupport {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (hU : IsOpen U) {K : Set Y} (hK : IsCompact K) (a : Y → ℂ)
    (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (η : ℝ → ℝ) (hcη : HasCompactSupport η) (j : ℕ) (h : ℝ) :
    HasCompactSupport (B.singleCutoffWave a η j h) :=
  (hK.prod hcη).of_isClosed_subset (isClosed_tsupport _)
    (B.singleCutoffWave_tsupport_subset hU hK.isClosed a ha ha0 η j h)

without_proof_info in
theorem finiteWave_eq_singleLayers {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (a : Y → ℂ) (η : ℝ → ℝ) (M : ℕ) (h : ℝ) :
    B.finiteWave a η M h = fun x => ∑ j ∈ range (M + 1), (h ^ j) • B.singleCutoffWave a η j h x := by
  funext x
  unfold finiteWave
  rw [mul_sum]
  apply sum_congr rfl
  intro j hj
  rw [B.singleCutoffWave_eq]
  simp only [Complex.real_smul, Complex.ofReal_pow]
  ring

variable {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]

def nativeSingleLayer {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (a : Y → ℂ) (η : ℝ → ℝ) (j : ℕ) (h : ℝ) : M → ℂ :=
  coordinatePushforward χ (fun z => B.singleCutoffWave a η j h (nativeNormalCoordinates z))

without_proof_info in
theorem nativeSingleLayer_contMDiff {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (hU : IsOpen U) {K : Set Y} (hK : IsCompact K) (hKU : K ⊆ U) (a : Y → ℂ)
    (ha : ContDiffOn ℝ ∞ a U) (ha0 : ∀ y ∉ K, a y = 0)
    (η : ℝ → ℝ) (hη : ContDiff ℝ ∞ η) (hcη : HasCompactSupport η)
    (hcap : (nativeNormalCoordinates (n := n)) ⁻¹' (K ×ˢ tsupport η) ⊆ χ.source)
    (j : ℕ) (h : ℝ) : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, ℂ) ∞ (B.nativeSingleLayer χ a η j h) := by
  apply coordinatePushforward_contMDiff
  · exact ((B.singleCutoffWave_contDiff hU hK.isClosed hKU a ha ha0 η hη j h).contMDiff.comp
      contMDiff_nativeNormalCoordinates).contMDiffOn
  · exact (B.singleCutoffWave_hasCompactSupport hU hK a ha ha0 η hcη j h).comp_isClosedEmbedding
      isClosedEmbedding_nativeNormalCoordinates
  · exact (tsupport_comp_subset_preimage _ continuous_nativeNormalCoordinates).trans
      ((preimage_mono (B.singleCutoffWave_tsupport_subset hU hK.isClosed a ha ha0 η j h)).trans hcap)

without_proof_info in
theorem nativeWave_eq_singleLayers {ξ : Fin n → ℝ} {U : Set Y} (B : BoundaryLayerCoefficients ξ U)
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) H M ω)
    (a : Y → ℂ) (η : ℝ → ℝ) (N : ℕ) (h : ℝ) :
    B.nativeWave χ a η N h = fun x => ∑ j ∈ range (N + 1), (h ^ j) • B.nativeSingleLayer χ a η j h x := by
  unfold nativeWave nativeSingleLayer
  rw [B.finiteWave_eq_singleLayers]
  exact coordinatePushforward_finset_linear χ (range (N + 1)) (fun j => h ^ j) _

end ConformalPoisson.LocalDN.BoundaryLayerCoefficients

