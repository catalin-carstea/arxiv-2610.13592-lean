    (V := euclideanOpenHalfSpace n 0) 1 hψ hψc
    (fun x hx => hHU ⟨hx.1, hψU hx.2⟩) u
  have hwv : W1p.value w =ᵐ[μ.restrict (euclideanOpenHalfSpace n 0 : Set X)]
