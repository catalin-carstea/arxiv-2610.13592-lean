    intro i l
    exact congrArg Complex.ofReal ((F.inverse_posDef z (hS z hz ht)).isHermitian.isSymm.apply i l).symm
  have heq : (∑ j ∈ range (M + 1), (h ^ j : ℂ) * ((h : ℂ) ^ 2 *
      complexSplitOperator A (F.tau z) c (normalCutoffWave η (scaledPlaneWave ξ h (B.profile a j))) y t)) =
      tangentialWave ξ h y * ((η t : ℂ) * (∑ j ∈ range (M + 1), (h ^ j : ℂ) * V j) +
        ∑ j ∈ range (M + 1), (h ^ j : ℂ) * E j) := by
    simp only [mul_add, mul_sum, sum_add_distrib]
    rw [← sum_add_distrib]
    apply sum_congr rfl
    intro j hj
    rw [complexSplitOperator_scaledCutoff A hsymm (F.tau z) c ξ η.contDiff hh.ne'
      (B.profile_contDiff hU hK.isClosed hKU a ha ha0 j)]
