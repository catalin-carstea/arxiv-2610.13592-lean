noncomputable section ProofPart_RelativeCutoffExtension



/- A smooth cutoff avoids an artificial domain edge. Its relative
extension requires no boundary condition on the physical face, at any
Sobolev exponent or order. -/
open Set MeasureTheory TopologicalSpace Filter TauCeti
open scoped ContDiff ENNReal
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
  {μ : Measure E} [μ.IsAddHaarMeasure] {Ω V : Opens E}
  {p : ℝ≥0∞} [Fact (1 ≤ p)]

without_proof_info in
theorem exists_wkp_relative_cutoff_extension (k : ℕ)
    {ψ : E → ℝ} (hψ : ContDiff ℝ ∞ ψ) (hψc : HasCompactSupport ψ)
    (hs : (V : Set E) ∩ tsupport ψ ⊆ Ω) (u : Wkp μ Ω p k) :
    ∃ w : Wkp μ V p k, Wkp.value k w =ᵐ[μ.restrict V]
      (Ω : Set E).indicator (fun x => ψ x * Wkp.value k u x) := by
  obtain ⟨z, hz⟩ := Wkp.exists_value_ae_eq_mul_of_hasCompactSupport k hψ hψc u
  have hz0 : ∀ᵐ x ∂μ.restrict Ω, x ∉ tsupport ψ → Wkp.value k z x = 0 := by
    filter_upwards [hz] with x hx hxs
    rw [hx, image_eq_zero_of_notMem_tsupport hxs, zero_mul]
  obtain ⟨w, hw⟩ := Wkp.exists_value_ae_eq_indicator_of_isClosed (isClosed_tsupport ψ) hs k z hz0
  refine ⟨w, ?_⟩
  have hz' := (ae_restrict_iff' Ω.isOpen.measurableSet).1 hz
  filter_upwards [hw, ae_restrict_of_ae hz'] with x hx hzx
  rw [hx]
  by_cases hxΩ : x ∈ (Ω : Set E)
  · rw [indicator_of_mem hxΩ, indicator_of_mem hxΩ, hzx hxΩ]
  · rw [indicator_of_notMem hxΩ, indicator_of_notMem hxΩ]
end ConformalPoisson

end ProofPart_RelativeCutoffExtension

