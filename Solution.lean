noncomputable section ProofPart_GreenTrace_NativeCutoffC1Readback






/- Actual native C1 readback on the neighborhood where the same chart bump
is one. Interior coordinate estimates extend to the physical boundary by
continuity and the proved dense native interior. -/
open Bundle Set Metric Filter MeasureTheory TopologicalSpace TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology Gradient ENNReal InnerProductSpace
set_option backward.isDefEq.respectTransparency true
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M] [T2Space M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
  [CompactSpace M] [MeasurableSpace M] [BorelSpace M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local notation "P" => WithLp 2 (ℝ × EuclideanSpace ℝ (Fin n))

set_option maxHeartbeats 600000 in
without_proof_info in
theorem exists_native_cutoff_c1_readback
    (g : Metric (n := n) (M := M)) (c : M)
    (b : ContDiffBump (extChartAt Ihalf c c)) {R : ℝ} (hbR : b.rOut < R)
    (htarget : closedBall (extChartAt Ihalf c c) R ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) :
    ∃ K ≥ 0, ∃ N : Opens M, c ∈ N ∧
      ∀ u : M → ℝ, ∀ hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u, ∀ T : ℝ,
        (∀ z ∈ splitBoundaryChartCap (n := n) c R,
          |b (euclideanNormalSplit n z) * u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))| +
            ‖∇ (fun t : P => b (euclideanNormalSplit n t) *
              u ((extChartAt Ihalf c).symm (euclideanNormalSplit n t))) z‖ ≤ T) →
        ∀ x ∈ N, nativeC1Function g u (hu.of_le (by simp)) x ≤ K * T := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  obtain ⟨KG, hKG, hgradNative⟩ := exists_native_gradient_chart_bound g c htarget
  let K := max 1 KG
  have hK : 0 ≤ K := zero_le_one.trans (le_max_left _ _)
  let N : Opens M := ⟨(extChartAt Ihalf c).source ∩
    extChartAt Ihalf c ⁻¹' ball (extChartAt Ihalf c c) b.rIn,
      isOpen_extChartAt_preimage' c isOpen_ball⟩
  have hcN : c ∈ N := ⟨mem_extChartAt_source c, mem_ball_self b.rIn_pos⟩
  refine ⟨K, hK, N, hcN, fun u hu T hbound x hx => ?_⟩
  have hInterior : ∀ y ∈ (N : Set M) ∩ (Ihalf).interior M,
      nativeC1Function g u (hu.of_le (by simp)) y ≤ K * T := by
    intro y hy
    have hySource : y ∈ (chartAt (EuclideanHalfSpace (n + 1)) c).source := by
      simpa only [extChartAt_source] using hy.1.1
    have hyi : (Ihalf).IsInteriorPoint y := hy.2
    have hzTarget : extChartAt Ihalf c y ∈ interior (extChartAt Ihalf c).target :=
      ((Ihalf).isInteriorPoint_iff_of_mem_atlas (n := 1) one_ne_zero
        (chart_mem_atlas (EuclideanHalfSpace (n + 1)) c) hySource).mp hyi
    have hzV : extChartAt Ihalf c y ∈ boundaryChartCap (I := Ihalf) c R :=
      ⟨ball_subset_ball (b.rIn_lt_rOut.trans hbR).le hy.1.2,
        interior_mono (extChartAt_target_subset_range c) hzTarget⟩
    let e := euclideanNormalSplit n
    let z : P := e.symm (extChartAt Ihalf c y)
    let w : P → ℝ := fun t => u ((extChartAt Ihalf c).symm (e t))
    have hez : e z = extChartAt Ihalf c y := e.apply_symm_apply _
    have hzP : z ∈ splitBoundaryChartCap (n := n) c R := by
      change e z ∈ boundaryChartCap (I := Ihalf) c R
      rw [hez]
      exact hzV
    have hround : (extChartAt Ihalf c).symm (extChartAt Ihalf c y) = y :=
      (extChartAt Ihalf c).left_inv hy.1.1
    have hwz : w z = u y := by dsimp only [w]; rw [hez, hround]
    have hbz : e z ∈ ball (extChartAt Ihalf c c) b.rIn := by rw [hez]; exact hy.1.2
    have hbone := (b.eventuallyEq_one_of_mem_ball hbz).comp_tendsto e.continuous.continuousAt
    have hprod : (fun t : P => b (e t) * w t) =ᶠ[𝓝 z] w := by
      filter_upwards [hbone] with t ht
      change b (e t) = 1 at ht
      rw [ht, one_mul]
    have hbval : b (e z) = 1 := b.one_of_mem_closedBall (ball_subset_closedBall hbz)
    have hcoor := hbound z hzP
    change |b (e z) * w z| + ‖∇ (fun t : P => b (e t) * w t) z‖ ≤ T at hcoor
    rw [hbval, one_mul, hprod.gradient_eq] at hcoor
    have hgrad := hgradNative u (hu.of_le (by simp)) (extChartAt Ihalf c y) hzV
    rw [hround] at hgrad
    have hnorm : ‖∇ w z‖ = ‖∇ (u ∘ (extChartAt Ihalf c).symm) (extChartAt Ihalf c y)‖ := by
      change ‖∇ ((u ∘ (extChartAt Ihalf c).symm) ∘ e) z‖ = _
      rw [gradient_comp_linearIsometryEquiv_right, e.symm.norm_map, hez]
    rw [← hnorm] at hgrad
    have hvalK : |w z| ≤ K * |w z| := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_right (le_max_left 1 KG) (abs_nonneg (w z))
    have hgradK : KG * ‖∇ w z‖ ≤ K * ‖∇ w z‖ :=
      mul_le_mul_of_nonneg_right (le_max_right 1 KG) (norm_nonneg _)
    rw [nativeC1Function_apply]
    calc
      |u y| + ‖mgradient Ihalf u y‖ ≤ |u y| + KG * ‖∇ w z‖ :=
        add_le_add (le_refl _) hgrad
      _ = |w z| + KG * ‖∇ w z‖ := by rw [hwz]
      _ ≤ K * |w z| + K * ‖∇ w z‖ := add_le_add hvalK hgradK
      _ = K * (|w z| + ‖∇ w z‖) := by ring
      _ ≤ K * T := mul_le_mul_of_nonneg_left hcoor hK
  exact native_bound_on_open_of_interior_bound g N.isOpen
    (nativeC1Function g u (hu.of_le (by simp))).continuous hInterior x hx

end ConformalPoisson

