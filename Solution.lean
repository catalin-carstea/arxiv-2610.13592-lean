def coordinatePushforward
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    (f : EuclideanHalfSpace (n + 1) → F) : M → F :=
  (Subtype.val : (⟨χ.target, χ.open_target⟩ : TopologicalSpace.Opens M) → M).extend
    (fun x => f (χ.symm x)) 0

without_proof_info in
theorem coordinatePushforward_contMDiff
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    (f : EuclideanHalfSpace (n + 1) → F)
    (hF : ContMDiffOn (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ f χ.source)
    (hf : HasCompactSupport f) (hs : tsupport f ⊆ χ.source) :
    ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ (coordinatePushforward χ f) := by
  let S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1)) := ⟨χ.source, χ.open_source⟩
  let T : TopologicalSpace.Opens M := ⟨χ.target, χ.open_target⟩
  have hsub : tsupport f ⊆ range (Subtype.val : S → EuclideanHalfSpace (n + 1)) :=
    fun z hz => ⟨⟨z, hs hz⟩, rfl⟩
  have hpre : IsCompact ((Subtype.val : S → EuclideanHalfSpace (n + 1)) ⁻¹' tsupport f) :=
    Topology.IsEmbedding.subtypeVal.isInducing.isCompact_preimage' hf hsub
  have hfr : HasCompactSupport (fun x : S => f x) :=
    hpre.of_isClosed_subset (isClosed_tsupport _) (tsupport_comp_subset_preimage f continuous_subtype_val)
  have hfrSmooth : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ (fun x : S => f x) := by
    intro x
    apply contMDiffAt_subtype_iff.mpr
    exact (hF x x.property).contMDiffAt (χ.open_source.mem_nhds x.property)
  have hg : HasCompactSupport (fun x : T => f (χ.symm x)) := by
    change HasCompactSupport ((fun x : S => f x) ∘ χ.toDiffeomorphSourceTarget.symm.toHomeomorph)
    exact hfr.comp_homeomorph χ.toDiffeomorphSourceTarget.symm.toHomeomorph
  have hgSmooth : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ (fun x : T => f (χ.symm x)) := by
    change ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ, F) ∞ ((fun x : S => f x) ∘ χ.toDiffeomorphSourceTarget.symm)
    exact hfrSmooth.comp (χ.toDiffeomorphSourceTarget.symm.contMDiff.of_le le_top)
  exact ContMDiff.extend_zero hg hgSmooth

without_proof_info in
theorem coordinatePushforward_chart
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    (f : EuclideanHalfSpace (n + 1) → F) {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ χ.source) :
    coordinatePushforward χ f (χ z) = f z := by
  have he := congrFun (Function.extend_comp
    (Subtype.val_injective : Function.Injective
      (Subtype.val : (⟨χ.target, χ.open_target⟩ : TopologicalSpace.Opens M) → M))
    (fun x => f (χ.symm x)) 0) ⟨χ z, χ.map_source hz⟩
  have hi : χ.symm.toPartialEquiv (χ.toPartialEquiv z) = z := χ.left_inv hz
  simpa only [coordinatePushforward, Function.comp_apply, hi] using he

without_proof_info in
theorem coordinatePushforward_eq_zero_outside
    (χ : PartialDiffeomorph (𝓡∂ (n + 1)) (𝓡∂ (n + 1)) (EuclideanHalfSpace (n + 1)) M ω)
    (f : EuclideanHalfSpace (n + 1) → F) {x : M} (hx : x ∉ χ.target) :
    coordinatePushforward χ f x = 0 := by
  apply Function.extend_apply'
  rintro ⟨y, hy⟩
  exact hx (hy ▸ y.property)

end ConformalPoisson.LocalDN

