    ℓ (fun i => secondJet g w (points i)) =
      ∫ y, greenJetSection g points ℓ G.kernel y * schrodinger g q w y ∂nativeVolume g := by
  have hsub := tsupport_schrodinger_subset g q w hw
  have hwb (y : (𝓡∂ (n + 1)).boundary M) : w y = 0 :=
    image_eq_zero_of_notMem_tsupport fun h =>
