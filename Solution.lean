    unfold contractedChristoffel
    simp only [Finset.mul_sum]
    have hc (i j l : Fin n) : A i j * ((1 / 2 : ℝ) *
        (A k l * (DG i j l + DG j i l - DG l i j))) =
        (A i j * A k l * DG i j l + A i j * A k l * DG j i l -
          A i j * A k l * DG l i j) / 2 := by ring
    trans ∑ i, ∑ j, ∑ l, (A i j * A k l * DG i j l +
      A i j * A k l * DG j i l - A i j * A k l * DG l i j) / 2
    · apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      apply Finset.sum_congr rfl
      intro l hl
      exact hc i j l
    · dsimp only [T1, T2, T3]
      change Fin n → Fin n → ℝ at A
      change Fin n → Fin n → Fin n → ℝ at DG
      rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl
      intro i hi
      rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl
      intro j hj
      rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib, Finset.sum_div]
  have hT2 : T2 = T1 := by
    dsimp [T1, T2]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i hi
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
