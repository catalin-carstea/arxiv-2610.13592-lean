/- Every supplied native outward unit normal is smooth along the boundary.
Pointwise uniqueness identifies it locally with the negative unit gradient
of a genuine chart defining function. This is proved, not a new premise. -/
open Bundle Set Filter TauCeti TauCeti.Manifold
open scoped Manifold ContDiff Topology InnerProductSpace
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {n : ℕ} {M : Type*} [TopologicalSpace M]
  [ChartedSpace (EuclideanHalfSpace (n + 1)) M] [IsManifold (𝓡∂ (n + 1)) ω M]
local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))
local instance normalField_manifold : IsManifold (𝓡 n) ω ((𝓡∂ (n + 1)).boundary M) :=
  TauCeti.isManifold_boundary (n := n) (k := ω) M (by decide)

set_option maxHeartbeats 1000000 in
without_proof_info in
theorem contMDiff_native_unitNormal (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y)) :
    ContMDiff (𝓡 n) ((𝓡∂ (n + 1)).tangent) ∞
      (fun y : (𝓡∂ (n + 1)).boundary M => (TotalSpace.mk' V (y : M) (ν y) : TangentBundle Ihalf M)) := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContMDiffRiemannianBundle Ihalf ∞ V (fun x : M => TangentSpace Ihalf x) :=
    inferInstance
  let : ContMDiffVectorBundle ∞ V (TangentSpace Ihalf : M → Type _) Ihalf :=
    TangentBundle.contMDiffVectorBundle
  have hι : ContMDiff (𝓡 n) Ihalf ∞ (Subtype.val : (𝓡∂ (n + 1)).boundary M → M) :=
    (TauCeti.isImmersion_subtypeVal_boundary (n := n) (k := ω) M (by decide)).contMDiff.of_le (by decide)
  intro x
  let f := chartBoundaryFunction (n := n) (x : M)
  have hx : (x : M) ∈ (chartAt (EuclideanHalfSpace (n + 1)) (x : M)).source := mem_chart_source _ _
  have hf : ContMDiffAt Ihalf 𝓘(ℝ) ∞ f (x : M) :=
    ((contMDiffOn_chartBoundaryFunction (x : M)) x hx).contMDiffAt
      ((chartAt (EuclideanHalfSpace (n + 1)) (x : M)).open_source.mem_nhds hx)
  have hνx := (hν x).eq_nativeNegativeUnitGradient_chart g (x : M) x hx (ν x)
  have hgrad : mgradient Ihalf f (x : M) ≠ 0 := by
    intro hz
    have hv : ν x = 0 := by
      rw [hνx]
      change -NormedSpace.normalize (mgradient Ihalf f (x : M)) = 0
      simp [hz, NormedSpace.normalize]
    have hu := (hν x).2.1
    rw [hv, map_zero] at hu
    norm_num at hu
  have hNorm := contMDiffAt_normalize_mgradient (n := ∞)
    (by simpa using hf) hgrad
  have hNeg : ContMDiffAt Ihalf ((𝓡∂ (n + 1)).tangent) ∞
      (fun z : M => (TotalSpace.mk' V z (nativeNegativeUnitGradient g f z) : TangentBundle Ihalf M)) (x : M) := by
    simpa only [nativeNegativeUnitGradient, Pi.neg_apply] using hNorm.neg_section
  have hComp := hNeg.comp x (hι x)
  have heq : (fun y : (𝓡∂ (n + 1)).boundary M =>
      (TotalSpace.mk' V (y : M) (ν y) : TangentBundle Ihalf M)) =ᶠ[𝓝 x]
      (fun y => (TotalSpace.mk' V (y : M) (nativeNegativeUnitGradient g f y) : TangentBundle Ihalf M)) := by
    filter_upwards [continuous_subtype_val.continuousAt.preimage_mem_nhds
      ((chartAt (EuclideanHalfSpace (n + 1)) (x : M)).open_source.mem_nhds hx)] with y hy
    have h := (hν y).eq_nativeNegativeUnitGradient_chart g (x : M) y hy (ν y)
    exact congrArg (fun v => (TotalSpace.mk' V (y : M) v : TangentBundle Ihalf M)) h
  exact hComp.congr_of_eventuallyEq heq

without_proof_info in
/-- The scalar outward flux of an actual continuous native field is
continuous on the intrinsic boundary. -/
theorem continuous_native_unitNormal_inner (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    (X : (x : M) → TangentSpace Ihalf x)
    (hX : Continuous (fun x => (TotalSpace.mk' V x (X x) : TangentBundle Ihalf M))) :
    Continuous (fun y : (𝓡∂ (n + 1)).boundary M => g.inner y (ν y) (X y)) := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  exact ((contMDiff_native_unitNormal g ν hν).continuous).inner_bundle
    (hX.comp continuous_subtype_val)

without_proof_info in
/-- Normal differentiation of a globally smooth native function is smooth
along the actual boundary, because the supplied normal has just been proved smooth. -/
theorem contMDiff_native_normalDerivative (g : Metric (n := n) (M := M))
    (ν : (y : (𝓡∂ (n + 1)).boundary M) → TangentSpace Ihalf (y : M))
    (hν : ∀ y, IsOutwardUnitNormal g y (ν y))
    {u : M → ℝ} (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u) :
    ContMDiff (𝓡 n) 𝓘(ℝ) ∞ (normalDerivative ν u) := by
