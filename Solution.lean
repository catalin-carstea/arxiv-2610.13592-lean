theorem memLp_energyIntegrand_on_compact {d : ℕ}
    {μ : MeasureTheory.Measure (EuclideanSpace ℝ (Fin d))}
    {K S : Set (EuclideanSpace ℝ (Fin d))}
    {a : EuclideanSpace ℝ (Fin d) → Matrix (Fin d) (Fin d) ℝ}
