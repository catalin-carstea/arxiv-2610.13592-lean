noncomputable section ProofPart_BoundaryAnalytic_MixedEquationRecurrence




/- An actual scalar normal-form equation gives the mixed derivative
recurrence used by the numerical majorant. The source and every lower-order
term remain explicit. -/
open Set
open scoped ContDiff BigOperators
set_option backward.isDefEq.respectTransparency false
namespace ConformalPoisson
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

set_option maxHeartbeats 1800000 in
without_proof_info in
theorem norm_mixedDerivativeWithin_of_normal_equation
    {ι : Type*} [Fintype ι]
    {S : Set E} (hS : IsOpen S) (u source : E → ℝ) (c : ι → E → ℝ)
    (hu : ContDiffOn ℝ ∞ u S) (hsource : ContDiffOn ℝ ∞ source S)
    (hc : ∀ i, ContDiffOn ℝ ∞ (c i) S)
    (P : E →L[ℝ] E) (e : E) (vs : ι → List E) (ell : ι → ℕ)
    (hvs : ∀ i v, v ∈ vs i → P v = v)
    (hPDE : ∀ y ∈ S, normalDerivativeWithin S e 2 u y = source y +
      ∑ i, c i y * iteratedFDerivWithinAlong S (vs i)
        (normalDerivativeWithin S e (ell i) u) y)
    {x : E} (hx : x ∈ S) (p q : ℕ) :
    ‖mixedDerivativeWithin S P e p (q + 2) u x‖ ≤
      ‖mixedDerivativeWithin S P e p q source x‖ +
      ∑ i, ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
        (p.choose a : ℝ) * (q.choose b : ℝ) *
          ‖mixedDerivativeWithin S P e a b (c i) x‖ *
          ‖mixedDerivativeWithin S P e (p - a + (vs i).length) (q - b + ell i) u x‖ *
          ((vs i).map norm).prod := by
  classical
  let W : ι → E → ℝ := fun i =>
    iteratedFDerivWithinAlong S (vs i) (normalDerivativeWithin S e (ell i) u)
  let T : ι → E → ℝ := fun i => c i * W i
  have hW (i : ι) : ContDiffOn ℝ ∞ (W i) S :=
    contDiffOn_iteratedFDerivWithinAlong hS.uniqueDiffOn
      (contDiffOn_normalDerivativeWithin hS.uniqueDiffOn hu e (ell i)) (vs i)
  have hT (i : ι) : ContDiffOn ℝ ∞ (T i) S := (hc i).mul (hW i)
  let F : Option ι → E → ℝ := fun i => match i with
    | none => source
    | some i => T i
  have hF (i : Option ι) : ContDiffOn ℝ ∞ (F i) S := by
    cases i with
    | none => exact hsource
    | some i => exact hT i
  have heq : EqOn (normalDerivativeWithin S e 2 u) (fun y => ∑ i : Option ι, F i y) S := by
    intro y hy
    simpa [F, T, W] using hPDE y hy
  have hclosure : ∀ y ∈ S, y ∈ closure (interior S) := by
    intro y hy
    apply subset_closure
    rwa [hS.interior_eq]
  have hterm (i : ι) : ‖mixedDerivativeWithin S P e p q (T i) x‖ ≤
      ∑ a ∈ Finset.range (p + 1), ∑ b ∈ Finset.range (q + 1),
        (p.choose a : ℝ) * (q.choose b : ℝ) *
          ‖mixedDerivativeWithin S P e a b (c i) x‖ *
          ‖mixedDerivativeWithin S P e (p - a + (vs i).length) (q - b + ell i) u x‖ *
          ((vs i).map norm).prod := by
    apply (norm_mixedDerivativeWithin_mul_le hS (hc i) (hW i) hx P e p q).trans
    apply Finset.sum_le_sum
    intro a ha
    apply Finset.sum_le_sum
    intro b hb
    have hw := norm_mixedDerivativeWithin_differential_word_le hS.uniqueDiffOn hclosure
      hu hx P e (vs i) (hvs i) (ell i) (p - a) (q - b)
    have hweight : 0 ≤ (p.choose a : ℝ) * (q.choose b : ℝ) *
        ‖mixedDerivativeWithin S P e a b (c i) x‖ := by positivity
    calc
      _ ≤ ((p.choose a : ℝ) * (q.choose b : ℝ) *
          ‖mixedDerivativeWithin S P e a b (c i) x‖) *
          (‖mixedDerivativeWithin S P e (p - a + (vs i).length) (q - b + ell i) u x‖ *
            ((vs i).map norm).prod) := mul_le_mul_of_nonneg_left hw hweight
      _ = _ := by ring
  calc
    _ = ‖mixedDerivativeWithin S P e p q (normalDerivativeWithin S e 2 u) x‖ := by
      rw [mixedDerivativeWithin_normalDerivativeWithin]
    _ = ‖∑ i : Option ι, mixedDerivativeWithin S P e p q (F i) x‖ := by
      rw [mixedDerivativeWithin_congr heq hx P e p q,
        mixedDerivativeWithin_sum hS.uniqueDiffOn Finset.univ F (fun i _ => hF i) hx P e p q]
    _ ≤ ∑ i : Option ι, ‖mixedDerivativeWithin S P e p q (F i) x‖ := norm_sum_le _ _
    _ = ‖mixedDerivativeWithin S P e p q source x‖ +
        ∑ i, ‖mixedDerivativeWithin S P e p q (T i) x‖ := by simp [F]
    _ ≤ _ := add_le_add le_rfl (Finset.sum_le_sum (fun i _ => hterm i))

end ConformalPoisson

end ProofPart_BoundaryAnalytic_MixedEquationRecurrence

