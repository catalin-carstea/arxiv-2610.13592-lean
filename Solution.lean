    (y : (𝓡∂ (n + 1)).boundary M) (p : ℝ≥0∞) (C : ℝ≥0)
    (hbound : ∀ F w : M → ℝ, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F →
      IsZeroDirichletSolution g q F w →
      |normalDerivative ν w y| ≤ (C : ℝ) * (eLpNorm F p (nativeVolume g)).toReal)
    (F w : M → ℝ) (hF : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ F)
    (hw : IsZeroDirichletSolution g q F w) (hνw : normalDerivative ν w y ≠ 0)
    (Fm : ℕ → M → ℝ)
    (hFm : ∀ m, ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (Fm m))
    (hsupp : ∀ m, HasCompactSupport (Fm m))
    (hinterior : ∀ m, tsupport (Fm m) ⊆ (𝓡∂ (n + 1)).interior M)
    (hconv : Tendsto (fun m => (eLpNorm (Fm m - F) p (nativeVolume g)).toReal) atTop (𝓝 0)) :
    ¬ ∀ x ∈ (𝓡∂ (n + 1)).interior M, boundaryPoissonSection ν G.kernel y x = 0 := by
  intro hzero
  have hnormal (m : ℕ) : normalDerivative ν (Z.solve (Fm m)) y = 0 := by
    have hm := Z.correct (Fm m) (hFm m)
    have hrep := (G.forcing_normal_representation (Fm m) (hFm m) (hsupp m) (hinterior m)
      (Z.solve (Fm m)) hm.1 hm.2.2 hm.2.1 y).2
    have hprod : (fun z => boundaryPoissonSection ν G.kernel y z * Fm m z) = 0 := by
      funext z
      by_cases hz : z ∈ (𝓡∂ (n + 1)).interior M
      · simp only [hzero z hz, zero_mul, Pi.zero_apply]
      · have hFz : Fm m z = 0 := by
          by_contra hne
          exact hz (hinterior m (subset_tsupport (Fm m) hne))
        simp only [hFz, mul_zero, Pi.zero_apply]
    simpa [hprod] using hrep
  have ht := normalTrace_tendsto_of_forcing_tendsto
    ν y p C hbound Fm (fun m => Z.solve (Fm m)) hFm hF
    (fun m => Z.correct (Fm m) (hFm m)) hw hconv
  have ht0 : Tendsto (fun m => normalDerivative ν (Z.solve (Fm m)) y) atTop (𝓝 0) := by
    simpa only [hnormal] using (tendsto_const_nhds : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 0))
