    (hue _ ⟨z, ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩, rfl⟩).eq_of_nhds
  have huS : ContMDiffOn Ihalf 𝓘(ℝ) ∞ u (extChartAt Ihalf c).source := hu.contMDiffOn
  have hs : ContDiffOn ℝ ∞ v (Ω : Set V) :=
