    have hsmooth : ContDiffOn ℝ ∞ (all i) S := (hall i |>.contDiffOn hW.uniqueDiffOn).mono hSW
    have hb := norm_mixedDerivativeWithin_boundary_le_full hS.uniqueDiffOn hsmooth (hKS hx) p q
    rw [iteratedFDerivWithin_of_isOpen (p + q) hS (hKS hx)] at hb
