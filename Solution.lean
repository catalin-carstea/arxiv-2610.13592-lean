      Filter.eventually_of_mem (hS.mem_nhds hxS) fun y hy => hη1 hy
    rw [hxG, indicator_of_mem (hSΩ hxS), hxprod, hη1 hxS,
      hev.gradient_eq, gradient_fun_const]
    simp
  have hfirst := lpNorm_le_norm_of_ae_eq_of_le (Measure.restrict_mono hSH le_rfl) hGS
  have hinterp := halfSpace_gradient_interpolation_scaled hp a ε hε v
  have hhess := Wkp.norm_iteratedGradient_one_le_of_value_ae_eq_mul hη habs hg hh hw
  calc
    _ ≤ ‖Wkp.iteratedGradient 0 (Wkp.lowerOrder 1 v₀)‖ := hfirst
    _ ≤ ε * ‖Wkp.iteratedGradient 1 v₀‖ +
        (4 * (finrank ℝ P : ℝ) ^ 2 / ε) * ‖Wkp.value 2 v₀‖ := hinterp
    _ ≤ _ := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left (hDw.trans hhess) hε.le
      · exact mul_le_mul_of_nonneg_left (hvw.trans hwu) (by positivity)

end ConformalPoisson

end ProofPart_GreenTrace_BoundaryCutoffInterpolation

