/- Assignment268, /root. Exact metric K-jet quadratic readback from the
top inverse/tau jets after all lower original inverse metric jets agree. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set TauCeti Finset
open scoped Manifold ContDiff Matrix.Norms.Elementwise
namespace ConformalPoisson.LocalDN
variable {n : ℕ} {S : TopologicalSpace.Opens (EuclideanHalfSpace (n + 1))}

without_proof_info in
theorem normalJet_K_split (F : NormalMetricField S) (L : ℕ)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S) :
    normalJet L F.K z = normalJet (L + 1) F.inverse z -
      (F.KJetRemainder L z + normalJet L F.tau z • F.inverse z) := by
  rw [F.normalJet_K L hz, sum_range_succ]
  simp only [Nat.choose_self, one_smul, Nat.sub_self, normalJet_zero]
  rfl

without_proof_info in
theorem normalJet_K_quadratic_difference (F₁ F₂ : NormalMetricField S) (L : ℕ)
    {z : EuclideanHalfSpace (n + 1)} (hz : z ∈ S)
    (hA : ∀ r ≤ L, normalJet r F₁.inverse z = normalJet r F₂.inverse z)
    (ξ : Fin n → ℝ) (hξ : ξ ≠ 0) :
    normalMatrixQuadratic (normalJet L F₁.K z) ξ - normalMatrixQuadratic (normalJet L F₂.K z) ξ =
      normalMatrixQuadratic (normalJet (L + 1) F₁.inverse z) ξ -
        normalMatrixQuadratic (normalJet (L + 1) F₂.inverse z) ξ -
        F₁.principal ξ z ^ 2 * (normalJet L F₁.tau z - normalJet L F₂.tau z) := by
  have h0 : F₁.inverse z = F₂.inverse z := hA 0 (Nat.zero_le L)
  have hm : normalJet L F₁.K z - normalJet L F₂.K z =
      (normalJet (L + 1) F₁.inverse z - normalJet (L + 1) F₂.inverse z) -
      (normalJet L F₁.tau z - normalJet L F₂.tau z) • F₁.inverse z := by
    rw [normalJet_K_split F₁ L hz, normalJet_K_split F₂ L hz,
      F₁.KJetRemainder_eq_of_inverse_jets F₂ hz L hA, ← h0, sub_smul]
    abel
  rw [← normalMatrixQuadratic_sub, hm, normalMatrixQuadratic_sub,
    normalMatrixQuadratic_sub, normalMatrixQuadratic_smul_matrix]
  have hp : F₁.principal ξ z ^ 2 = normalMatrixQuadratic (F₁.inverse z) ξ :=
    normalPrincipal_sq _ (F₁.inverse_posDef z hz) ξ hξ
  rw [hp]
  ring

end ConformalPoisson.LocalDN

end ProofPart_DNSymbol_DNMetricJetQuadraticDifference

