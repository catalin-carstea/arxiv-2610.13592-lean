  refine ⟨Λ, fun z hz => ?_⟩
  rw [splitChartPrincipal, norm_conjugate_principal_isometry]
  exact hΛ _ ⟨ball_subset_closedBall hz.1, interior_subset hz.2⟩

set_option maxHeartbeats 600000 in
set_option backward.isDefEq.respectTransparency true in
without_proof_info in
/-- Exact Lp data for an actual smooth zero-Dirichlet solution. The right
side is the native forcing with its required drift and potential terms;
it is not an independent RHS or PDE assumption. -/
theorem exists_native_boundary_lp_equation (hp : p ≠ ⊤)
    (g : Metric (n := n) (M := M)) (q F u : M → ℝ)
    (hu : IsZeroDirichletSolution g q F u) (c : M)
    (b : ContDiffBump (extChartAt Ihalf c c)) {r : ℝ} (hbr : b.rOut < r)
    (hrt : closedBall (extChartAt Ihalf c c) r ∩ range Ihalf ⊆ (extChartAt Ihalf c).target) :
    ∃ U : Wkp (volume : Measure P) (splitBoundaryChartCap (n := n) c r) p 2,
      Wkp.value 2 U =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)]
        (fun z => u ((extChartAt Ihalf c).symm (euclideanNormalSplit n z))) ∧
      (∃ Z : W1p0 (volume : Measure P) (splitBoundaryChartCap (n := n) c r) p,
        W1p.value (Z : W1p volume (splitBoundaryChartCap (n := n) c r) p) =ᵐ[volume.restrict
          (splitBoundaryChartCap (n := n) c r : Set P)]
          (fun z => b (euclideanNormalSplit n z) * Wkp.value 2 U z)) ∧
      ∃ f : Lp ℝ p (volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)),
        f =ᵐ[volume.restrict (splitBoundaryChartCap (n := n) c r : Set P)]
          splitChartTraceForcing g c q F u ∧
