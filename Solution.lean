      schrodinger g q (c * v) x := by
  conv_lhs => rw [R.metric_eq]
  rw [schrodinger_const_rescale _ R.constant R.constant_positive p
    (conformalGaugePotential g q c) v hv x, R.potential_eq x, sub_self, zero_mul, add_zero,
    schrodinger_conformalGauge hdim g q c v R.multiplier_smooth R.multiplier_positive hv x]
  ring

end ConformalPoisson

