local notation "Ihalf" => 𝓡∂ (n + 1)
local notation "V" => EuclideanSpace ℝ (Fin (n + 1))

def nativeChartDensity (g : Metric (n := n) (M := M)) (c : M) (z : V) : ℝ := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  exact chartVolumeDensity (I := Ihalf) c ((extChartAt Ihalf c).symm z)

without_proof_info in
theorem integral_native_row_mul_eq_chart
    (g : Metric (n := n) (M := M)) (c : M) {Ω : Set V} (hΩ : IsOpen Ω)
    (hΩt : Ω ⊆ (extChartAt Ihalf c).target) (k F : M → ℝ)
    (hF : Function.support F ⊆ (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' Ω) :
    (∫ x, k x * F x ∂nativeVolume g) =
      ∫ z in Ω, nativeChartDensity g c z * k ((extChartAt Ihalf c).symm z) *
        F ((extChartAt Ihalf c).symm z) ∂(Module.finBasis ℝ V).addHaar := by
  let : RiemannianBundle (fun x : M => TangentSpace Ihalf x) := ⟨g.toRiemannianMetric⟩
  let : IsContinuousRiemannianBundle V (fun x : M => TangentSpace Ihalf x) :=
    ⟨⟨g.inner, g.contMDiff.continuous, fun _ _ _ => rfl⟩⟩
  have hvol : nativeVolume g = riemannianVolume Ihalf M := rfl
  rw [hvol]
  have hzero : ∀ x, x ∉ (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' Ω → k x * F x = 0 := by
    intro x hx
    have hFx : F x = 0 := by
      by_contra hne
      exact hx (hF hne)
    rw [hFx, mul_zero]
  rw [← setIntegral_eq_integral_of_forall_compl_eq_zero hzero,
    setIntegral_native_chart_preimage c hΩ hΩt]
  apply setIntegral_congr_fun hΩ.measurableSet
  intro z _
  change chartVolumeDensity (I := Ihalf) c ((extChartAt Ihalf c).symm z) *
    (k ((extChartAt Ihalf c).symm z) * F ((extChartAt Ihalf c).symm z)) = _
  change _ = chartVolumeDensity (I := Ihalf) c ((extChartAt Ihalf c).symm z) *
    k ((extChartAt Ihalf c).symm z) * F ((extChartAt Ihalf c).symm z)
  ring

without_proof_info in
theorem NativeInverseLpRowFamily.chart_test_identity
    {g : Metric (n := n) (M := M)} {q : M → ℝ} {s : ℝ≥0∞}
    (K : NativeInverseLpRowFamily g q s) (hq : ContMDiff Ihalf 𝓘(ℝ) ∞ q)
    (c x : M) {Ω : Set V} (hΩ : IsOpen Ω) (hΩt : Ω ⊆ (extChartAt Ihalf c).target)
    (u : M → ℝ) (hu : ContMDiff Ihalf 𝓘(ℝ) ∞ u)
    (hu0 : ∀ y : (Ihalf).boundary M, u y = 0)
    (hsupp : tsupport u ⊆ (extChartAt Ihalf c).source ∩ extChartAt Ihalf c ⁻¹' Ω) :
