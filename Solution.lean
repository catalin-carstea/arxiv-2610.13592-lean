  have hUi : ContMDiff (𝓡∂ (n + 1)) 𝓘(ℝ) ∞ (Ui h) := Complex.imCLM.contDiff.contMDiff.comp hV
  have he := hLp (V h) hV (C * h ^ N) (mul_nonneg hC (pow_nonneg hh.le N)) (hresN h hh hh1.le)
  refine ⟨hUr, hUi, hfr h (N + 2), hfi h (N + 2), ?_, ?_, ?_⟩
  · exact he.1.trans_eq (by ring)
  · exact he.2.trans_eq (by ring)
  · have htrace := B.nativeWave_scaled_pair_trace χ hU hK hKU a ha ha0 η hη hdη hcap (N + 2) hh.ne' y hy
    change ‖scaledChartTrace χ (fun x => (B.nativeWave χ a η (N + 2) h x).re)
      (fun x => (B.nativeWave χ a η (N + 2) h x).im) ξ (EuclideanHalfSpace.boundaryParam n y) h - _‖ ≤ _
    rw [htrace]
